<!--
    strictBinaryOperands: Psalm 6 flipped this default to true, which flags
    every int/float mix ("$total / $bins") as InvalidOperand - 53 findings at
    once, all in the elevation/geometry math, none of them a bug: int+float
    arithmetic is well-defined PHP and PHPStan (level max) accepts it. Casting
    each site would be noise that hides the real findings. Deliberately off.
-->
<psalm
    errorLevel="4"
    strictBinaryOperands="false"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
            <file name="src/Kernel.php" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!--
            Doctrine ServiceEntityRepository constructors forward $registry to the parent
            via parent::__construct() — Psalm's dead-param analysis does not follow
            super-constructor calls, so it incorrectly flags $registry and other params.
        -->
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Repository" />
            </errorLevel>
        </PossiblyUnusedParam>
    </issueHandlers>
</psalm>
