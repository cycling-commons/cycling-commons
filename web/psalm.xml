<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
            <file name="src/Kernel.php" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!--
            Doctrine ServiceEntityRepository constructors forward $registry to the parent
            via parent::__construct() — Psalm's dead-param analysis does not follow
            super-constructor calls, so it incorrectly flags $registry and other params.
        -->
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Repository" />
            </errorLevel>
        </PossiblyUnusedParam>
    </issueHandlers>
</psalm>
