# Defaults for running the Symfony API. In the dev container these are
# overridden by docker compose (see developers/docker/compose.yaml).
# This file is committed and must NOT contain real secrets.
APP_ENV=staging
APP_DEBUG=0

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://stagaing.cyclinccommons.org
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Points at the `db` service on the compose network by default.
# Shared state for the cluster: sessions, every rate limiter, the media
# auto-withhold circuit breaker and the proof-of-work store. All of these have
# to agree across frontends, so none of them may live on a node's disk.
# The dev stack ships its own `redis` service on the internal network. Already
# running a shared Redis? Point this at it instead in developers/docker/.env:
#   REDIS_URL=redis://host.docker.internal:6379
REDIS_URL=replace-me
DATABASE_URL=replace-me
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Local default = a Mailpit on 127.0.0.1:1025. In the dev container docker
# compose overrides this to the host's shared Mailpit (host.docker.internal:1025).
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

###> app ###
APP_SITE_URL=https://staging.cyclingcommons.org
# Where operational security alerts go — currently the auto-withhold circuit
# breaker opening (docs/specs/photo-uploads.md §6c). Empty disables the mail;
# the CRITICAL log line is written either way.
SECURITY_ALERT_EMAIL=development@cyclingcommons.org
###< app ###

###> app runtime config ###
# Mapillary access token — set the real value ONLY in .env.dev.local
MAPILLARY_TOKEN=replace-me
# ArcGIS Location Platform key for the satellite base layer. Set the real value
# ONLY in .env.*.local. Public by design (it ships to the browser) and
# referrer-restricted at Esri; empty simply means no satellite layer. Expires
# 2027-08-10 — see docs/specs/operations.md.
# Road-surface LINE tiles (Dated/2026-08-09-surface-line-tiles-design.md), a
# separate artifact from the point coverage tiles. Empty = the Surfaces toggle
# does not appear at all, which is the correct state until a region is built.
# Where the surface build publishes its manifest. Set this and the three URLs
# below can stay empty: a rebuild then goes live within the hour with no config
# change. The URLs pin a build and win over the manifest when set.
SURFACE_MANIFEST_URL=replace-me
SURFACE_TILES_URL=replace-me
# The 'needs recording' arm — roads with no surface value in the classes where
# the answer is genuinely unknown (tracks, paths, rural lanes). Its own artifact
# because a vector tile is fetched whole (see surface-tiles.js).
SURFACE_TODO_URL=replace-me
# The same question at planning zoom: one square per ~6 km carrying how many km
# of unrecorded network sit inside it. ~1% of the to-do arm's bytes.
SURFACE_GAPS_URL=replace-me
# Cycle-route network tiles (route=bicycle/mtb corridors + knooppunt numbers).
# Same manifest-or-pin contract as the surface set: set the manifest and a
# rebuild goes live with no config change; the URL pins a build and wins.
# Empty both = the Routes toggle does not appear, which is the correct state
# until an artifact is built.
ROUTES_MANIFEST_URL=replace-me
ROUTES_TILES_URL=replace-me

ESRI_API_KEY=replace-me
###< app runtime config ###

###> coverage tiles (coverage-provider.md §4/§8) ###
# 1 = serve OSM coverage from PMTiles + /map/coverage/* — the only OSM display
# path since the legacy catalog pools were removed (Task 14); 0 = curated only.
COVERAGE_TILES=1
# Stable manifest key on the CC bucket, fetched SERVER-side. Dev stack value
# (app container -> MinIO): http://minio:9000/cc-maps/coverage/manifest.json
COVERAGE_MANIFEST_URL=replace-me
# Browser-facing tile origin for CSP connect-src (dev MinIO: http://localhost:9100).
# Separate from the manifest URL because server-side and browser-side hosts
# differ in the dev stack. Empty = no coverage host added to the policy.
COVERAGE_CSP_HOST=replace-me
###< coverage tiles ###

###> media (photo-uploads.md §2) ###
# NO CREDENTIALS HERE. This file is committed; the S3 key and secret are
# supplied by developers/docker/.env (gitignored) through compose, exactly the
# way COVERAGE_S3_KEY/SECRET already are. Empty here means "unset unless the
# environment provides it" — the same shape as COVERAGE_MANIFEST_URL above.
MEDIA_S3_ENDPOINT=replace-me
MEDIA_S3_REGION=replace-me
MEDIA_S3_KEY=replace-me
MEDIA_S3_SECRET=replace-me
MEDIA_S3_BUCKET_EU=replace-me
# Browser-facing base URL. Prod points at the owner-run caching proxy, which
# routes on the continent segment; dev addresses MinIO path-style.
MEDIA_PUBLIC_BASE=replace-me

# The moderator rulebook as a PDF, kept on the SERVER rather than in this
# repository: the Twig page is readable by anyone once the repo is public, and a
# rulebook is a script for talking a curator into a removal. Owner-managed - the
# app only links to it. Empty means the rulebook page shows no download link at
# all, which is the right default for an environment that has no such file.
CC_RULEBOOK_PDF_URL=replace-me
# Browser-facing origin added to the CSP img-src.
MEDIA_CSP_HOST=replace-me
# Fallback storage shard when an upload's location cannot be resolved.
MEDIA_DEFAULT_CONTINENT=EU
###< media ###

###> build stamp ###
# Footer build stamp fallback for environments where the repository's .git is
# unreachable (e.g. the dev container mounts web/ alone). When git IS
# reachable the stamp comes from `git describe --tags --match 'v*'` — cut a
# release tag like v0.2.0 and every footer follows it, no edit anywhere.
APP_BUILD_VERSION=replace-me
###< build stamp ###