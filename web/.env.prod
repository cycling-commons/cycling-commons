DEFAULT_URI=https://cyclingcommons.org
# The private CIDR of the LB + nginx frontends (framework.yaml when@prod,
# mirrored when@staging). Verify against the actual Hetzner private network
# before go-live: a wrong range silently ignores X-Forwarded-For.
TRUSTED_PROXIES=10.0.0.0/16

COVERAGE_CSP_HOST=https://tiles.cyclingcommons.org

###> active languages (docs/specs/dev-environment.md §7 i18n) ###
# Which of the BUILT languages this deployment actually serves. The build
# always carries all five catalogues (framework.enabled_locales, a
# compile-time list); this is the runtime subset a reader can reach.
#
# A language left out here is invisible: not in the language menu, not in the
# hreflang block, not in the sitemap, not offered on /translate, and its
# prefixed paths redirect to the same page in en. That is how a half-drafted catalogue stays
# translatable on dev while production serves only what is finished.
#
# en is always served whatever this says: it is every unprefixed route and
# the source every translation is made from. An empty or unrecognised value
# leaves ONLY en, so a typo is loud instead of quietly publishing a language
# that was meant to stay hidden.
CC_ACTIVE_LOCALES=en,nl
###< active languages ###

###> github ###
# The repository the bug desk files into and the daily contributor sync
# (app:community:sync-contributors) counts merged, approved PRs from. Staging
# reads the private incubation repo; production reads the public one.
GITHUB_REPO=cycling-commons/cycling-commons
###< github ###

###> build stamp ###
# The release name the footer and /humans.txt show (see .env.staging). Bump it
# in the same commit that gets the tag; the commit link always names the build.
APP_BUILD_VERSION=v0.9.0-beta
###< build stamp ###
