# Defaults for running the Symfony API. In the dev container these are
# overridden by docker compose (see developers/docker/compose.yaml).
# This file is committed and must NOT contain real secrets.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=dev-not-secret-change-me

# At-rest encryption key for TOTP secrets (account-and-auth.md §4). Optional:
# unset, it falls back to APP_SECRET, which is what every deployment did before
# 2026-08-25. Set it to the CURRENT value of APP_SECRET and only then is
# APP_SECRET free to rotate: they used to be the same value with no way to
# separate them, so rotating APP_SECRET silently made every stored TOTP secret
# undecryptable and locked every curator out of 2FA with nothing in the logs.
# `app:security:encryption-audit` is the before-and-after check.
ENCRYPTION_SECRET=

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share

###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Points at the `db` service on the compose network by default.
# Shared state for the cluster: sessions, every rate limiter, the media
# auto-withhold circuit breaker and the proof-of-work store. All of these have
# to agree across frontends, so none of them may live on a node's disk.
# The dev stack ships its own `redis` service on the internal network. Already
# running a shared Redis? Point this at it instead in developers/docker/.env:
#   REDIS_URL=redis://host.docker.internal:6379
REDIS_URL=redis://redis:6379
DATABASE_URL="postgresql://cc:cc@db:5432/cyclingcommons?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Local default = a Mailpit on 127.0.0.1:1025. In the dev container docker
# compose overrides this to the host's shared Mailpit (host.docker.internal:1025).
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

###> app ###
APP_SITE_URL=https://cyclingcommons.org
# Where operational security alerts go — currently the auto-withhold circuit
# breaker opening (docs/specs/photo-uploads.md §6c). Empty disables the mail;
# the CRITICAL log line is written either way.
SECURITY_ALERT_EMAIL=
###< app ###

###> contact and support (docs/specs/contact-and-support.md) ###
# WHO IS ON DUTY. Comma-separated. Where the contact form and bug reports are
# announced. Empty falls back to SECURITY_ALERT_EMAIL, so the first message a
# fresh deployment receives is never swallowed. Editable at runtime from
# /admin/system-config once the app is up; this is only the starting value.
CC_SUPPORT_EMAILS=
# The envelope sender for acknowledgements and desk notifications. Must be a
# domain this deployment is allowed to send as, or SPF marks every
# acknowledgement as spam and the form silently stops working for the sender.
# Unset falls back to noreply@cyclingcommons.org.
CC_SUPPORT_FROM_EMAIL=

# WHO WE LEGALLY ARE. Published on /contact as the identity block that
# art. 3:15d BW (from Art. 5 of the EU e-Commerce Directive 2000/31/EC)
# requires of every information-society service, and that GDPR Art. 13(1)(a)
# wants for the data controller. Deliberately EMPTY here: the page renders a
# visible gap and names what is missing rather than showing a plausible
# placeholder, because a made-up KvK number is a false statement about a real
# register. Set the real values per deployed environment.
#
# NOT editable from the admin UI, on purpose: a web form that rewrites who
# legally operates the site would be a misrepresentation surface. This changes
# by deploy, like the CSP hosts do.
CC_ORG_NAME=BikeCoders
CC_ORG_LEGAL_FORM=
CC_ORG_STREET=
CC_ORG_POSTCODE=
CC_ORG_CITY=
CC_ORG_COUNTRY=
# Chamber of Commerce (Kamer van Koophandel) number.
CC_ORG_KVK=
# The BTW-ID, never the old btw-nummer: for a sole trader that one contains
# the owner's citizen service number (BSN).
CC_ORG_VAT=
CC_ORG_CONTACT_EMAIL=
CC_ORG_PHONE=

# Where to find us, for the footer's icon row. Handles, not URLs, except
# Mastodon, whose instance is part of the address. An empty one does not
# render: a fresh deployment shows the channels it actually has.
#
# GitHub is filled because the repository is already public and linked from a
# dozen tracked files. The rest wait for real accounts.
CC_SOCIAL_GITHUB=cycling-commons
CC_SOCIAL_YOUTUBE=cyclingcommons
CC_SOCIAL_INSTAGRAM=cyclingcommons
CC_SOCIAL_FACEBOOK=
CC_SOCIAL_BLUESKY=
# A full URL, e.g. https://mastodon.social/@cyclingcommons
CC_SOCIAL_MASTODON=
###< contact and support ###

###> app runtime config ###
# Mapillary access token — set the real value ONLY in .env.dev.local
MAPILLARY_TOKEN=
# The repository, owner/name, that the bug desk files issues into and that
# the daily contributor sync (app:community:sync-contributors) counts merged,
# approved PRs from — named per environment in .env.staging / .env.prod. The
# token needs issues:write (desk) and read access to the repo (sync); set it
# ONLY in .env.*.local. An empty desk token hides its button
# (contact-and-support.md 9); an empty sync token warns and skips.
GITHUB_REPO=
GITHUB_TOKEN=
# ArcGIS Location Platform key for the satellite base layer. Set the real value
# ONLY in .env.*.local. Public by design (it ships to the browser) and
# referrer-restricted at Esri; empty simply means no satellite layer. Expires
# 2027-08-10 — see docs/specs/operations.md.
# Road-surface LINE tiles (Dated/2026-08-09-surface-line-tiles-design.md), a
# separate artifact from the point coverage tiles. Empty = the Surfaces toggle
# does not appear at all, which is the correct state until a region is built.
# Where the surface build publishes its manifest. Set this and the three URLs
# below can stay empty: a rebuild then goes live within the hour with no config
# change. The URLs pin a build and win over the manifest when set.
ROAD_SURFACE_MANIFEST_URL=
ROAD_SURFACE_TILES_URL=
# The 'needs recording' arm — roads with no surface value in the classes where
# the answer is genuinely unknown (tracks, paths, rural lanes). Its own artifact
# because a vector tile is fetched whole (see surface-tiles.js).
ROAD_SURFACE_TODO_URL=
# The same question at planning zoom: one square per ~6 km carrying how many km
# of unrecorded network sit inside it. ~1% of the to-do arm's bytes.
ROAD_SURFACE_GAPS_URL=
# Cycle-route network tiles (route=bicycle/mtb corridors + knooppunt numbers).
# Same manifest-or-pin contract as the surface set: set the manifest and a
# rebuild goes live with no config change; the URL pins a build and wins.
# Empty both = the Routes toggle does not appear, which is the correct state
# until an artifact is built.
ROUTES_MANIFEST_URL=
ROUTES_TILES_URL=

# Google Safe Browsing (free Lookup API) for rider-submitted outbound links.
# EMPTY = the layer is OFF and says so at every call site, rather than quietly
# passing everything: a security control you cannot tell apart from an absent
# one is worse than admitting it is absent. Get a key from the Google Cloud
# console (Safe Browsing API); it needs no billing account for the free tier.
SAFE_BROWSING_KEY=
ESRI_API_KEY=

# DeepL for the dev-only translation drafting tool (translations.md §7.1).
# EMPTY = the feature is OFF, the same convention SAFE_BROWSING_KEY above
# uses. This is per developer: put your own key in your own gitignored
# web/.env.local, never here. The feature also requires the kernel
# environment to be "dev", so a key set on staging or production still
# would not turn it on.
DEEPL_API_KEY=

# The developer opt-in that lets the dev translation tool write straight into
# web/translations/messages.<locale>.yaml (translations.md §7.1). EMPTY = OFF,
# the same convention SAFE_BROWSING_KEY and DEEPL_API_KEY use above; set it to
# 1 in your own gitignored local override, never here.
#
# WHY IT EXISTS AND WHY IT IS SEPARATE FROM APP_ENV. This file commits
# APP_ENV=dev, and no deployed environment file in this repository overrides
# it: every release depends on a server-side override instead. If APP_ENV were
# the only gate, a box that lost that override would write every rider's
# translation into the shipped catalogue file rather than a proposal row, with
# no consent record and nothing for /moderate to show. Words a rider typed,
# shipped in a release nobody reviewed and nobody asked them about, and a
# rollback does not un-ship them. So the write requires BOTH: the kernel
# environment is dev, AND
# this is explicitly on. A release would have to lose its override and carry an
# opt-in nobody set.
#
# NOT the same as DEEPL_API_KEY: a developer typing a translation by hand has
# no DeepL key and must still be able to write (translations.md §7.3). And
# because env values are container-cached, a newly set value needs the app
# restarted before anything changes.
CC_CATALOGUE_WRITE=
###< app runtime config ###

###> coverage tiles (coverage-provider.md §4/§8) ###
# 1 = serve OSM coverage from PMTiles + /map/coverage/* — the only OSM display
# path since the legacy catalog pools were removed (Task 14); 0 = curated only.
COVERAGE_TILES=1
# Stable manifest key on the CC bucket, fetched SERVER-side. Dev stack value
# (app container -> MinIO): http://minio:9000/cc-maps/coverage/manifest.json
COVERAGE_MANIFEST_URL=
# Browser-facing tile origin for CSP connect-src (dev MinIO: http://localhost:9100).
# Separate from the manifest URL because server-side and browser-side hosts
# differ in the dev stack. Empty = no coverage host added to the policy.
COVERAGE_CSP_HOST=
###< coverage tiles ###

###> media (photo-uploads.md §2) ###
# NO CREDENTIALS HERE. This file is committed; the S3 key and secret are
# supplied by developers/docker/.env (gitignored) through compose, exactly the
# way COVERAGE_S3_KEY/SECRET already are. Empty here means "unset unless the
# environment provides it" — the same shape as COVERAGE_MANIFEST_URL above.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
# One var per continent (media-storage-architecture.md §2.1): the FULL
# bucket name new photos write to, used verbatim and stored verbatim on the
# row - the one key. Names MUST end in -<cc>-<nn> (never more than 99
# generations per continent): the last five characters are the public URL
# segment /img/eu-01/. Advancing a continent = bump its var + one new nginx
# location; every existing row keeps the full name it recorded.
MEDIA_S3_PUBLIC_BUCKET_AF=
MEDIA_S3_PUBLIC_BUCKET_AS=
MEDIA_S3_PUBLIC_BUCKET_EU=
MEDIA_S3_PUBLIC_BUCKET_NA=
MEDIA_S3_PUBLIC_BUCKET_OC=
MEDIA_S3_PUBLIC_BUCKET_SA=
# The QUARANTINE bucket (media-storage-architecture.md §2.2). One bucket per
# environment, no per-continent split and no numbering (it holds bytes only
# for the seconds between upload and scan verdict), and it must carry NO
# anonymous-read policy: a private bucket that is accidentally public
# defeats the whole quarantine while every test still passes.
MEDIA_S3_PRIVATE_BUCKET=
# Browser-facing base URL. Prod points at the owner-run caching proxy, which
# routes on the continent segment; dev addresses MinIO path-style.
MEDIA_PUBLIC_BASE=

# The moderator rulebook as a PDF, kept on the SERVER rather than in this
# repository: the Twig page is readable by anyone once the repo is public, and a
# rulebook is a script for talking a curator into a removal. A FILE PATH, not a
# URL: the app streams it to curators only (ModerateController::rulebookPdf),
# so it must NOT sit under public/, where anyone holding the link could read
# it. Relative paths are taken from the project root; var/ is git-ignored.
# Owner-managed - the app only reads it. When the file is absent the rulebook
# page shows no download link at all, which is the right default for an
# environment that has no such file.
CC_RULEBOOK_PDF_PATH=var/private/moderator-rulebook.pdf
# Browser-facing origin added to the CSP img-src.
MEDIA_CSP_HOST=
###< media ###

###> climb elevation ###
# Valhalla base URL for /height, the source of every published climb gradient
# (climb-elevation.md §2b-i). Empty disables profiles: no elevation, no
# gradients, and never a guessed one. In dev this is the SSH-tunnelled
# per-continent instance; from inside the app container that is
# host.docker.internal.
ELEVATION_URL=http://host.docker.internal:8002
# The other continents' instances, `key=url,key=url`. Keys are the boxes in
# App\Elevation\ElevationEndpoints; anything unlisted falls back to
# ELEVATION_URL above. Only continents whose .hgt tiles are actually loaded
# belong here — an instance without them answers null (or all-zeros), which the
# client rejects, so a climb there simply gets no profile.
#
# PORTS ARE NOT IN CONTINENT ORDER. The host publishes 8002 europe, 8003
# north-america, 8004 asia, **8005 south-america, 8006 africa**, 8007 oceania —
# the middle two read backwards from every alphabetical guess, and guessing
# them wrong makes an instance look empty when it is full (2026-08-14: africa
# and south-america were probed on each other's ports and both "failed").
#
# africa + south-america added 2026-08-14 with the Rwanda/South Africa/
# Colombia/Chile rollout: 733 GLO-30 tiles installed and the instances
# restarted, so they hold real ground for the first time.
ELEVATION_URLS="north-america=http://host.docker.internal:8003,asia=http://host.docker.internal:8004,oceania=http://host.docker.internal:8007,africa=http://host.docker.internal:8006,south-america=http://host.docker.internal:8005"
# Recorded on the item as provenance, and shown wherever a profile is. Must
# name what the Valhalla instance actually has loaded — this string is an
# attribution, so it is wrong to guess it.
ELEVATION_DEM_SOURCE="Copernicus DEM GLO-30"
###< climb elevation ###
###> build stamp ###
# Footer build stamp fallback for environments where the repository's .git is
# unreachable (e.g. the dev container mounts web/ alone). When git IS
# reachable the stamp comes from `git describe --tags --match 'v*'` — cut a
# release tag like v0.2.0 and every footer follows it, no edit anywhere.
APP_BUILD_VERSION=
###< build stamp ###

###> symfony/messenger ###
# The async tier (media scanning, and everything the worker host runs).
# Same env-driven single-path rule as the storage layer: no when@prod gating,
# the DSN decides. Redis is already required and provisioned (REDIS_URL above);
# stream + group name the consumer joins. The test env overrides to sync://
# in config/packages/messenger.yaml so the suite needs no consumer.
MESSENGER_TRANSPORT_DSN=redis://redis:6379/cc_messages
###< symfony/messenger ###

###> clamav ###
# The release gate's virus scanner (media-storage-architecture.md; plan task
# 3). CLAMAV_TCP_ADDR set -> INSTREAM to clamd (the dev sidecar publishes
# clamav:3310 on the compose network); empty -> the clamscan binary if one is
# on PATH. CLAMAV_REQUIRED decides what "no scanner" means: 1 throws (set it
# on EVERY real environment - unset silently disables the architecture, so it
# sits on the deploy checklist beside APP_SECRET), 0 logs a skipped verdict
# so contributor stacks without ClamAV still work.
CLAMAV_TCP_ADDR=
CLAMAV_REQUIRED=0
###< clamav ###

###> commons ###
# Wikimedia asks every client to identify itself. An anonymous batch is
# rate-limited to 429 within a request or two, so this is not decoration: the
# measurement run behind the photo cache failed exactly that way (2026-08-24).
# Put a real contact address in the deployed value.
APP_COMMONS_USER_AGENT="CyclingCommons/1.0 (+https://cyclingcommons.org)"
###< commons ###

###> active languages (docs/specs/dev-environment.md §7 i18n) ###
# Which of the BUILT languages this deployment actually serves. The build
# always carries all five catalogues (framework.enabled_locales, a
# compile-time list); this is the runtime subset a reader can reach.
#
# A language left out here is invisible: not in the language menu, not in the
# hreflang block, not in the sitemap, not offered on /translate, and its
# prefixed paths answer 404. That is how a half-drafted catalogue stays
# translatable on dev while production serves only what is finished.
#
# en is always served whatever this says: it is every unprefixed route and
# the source every translation is made from. An empty or unrecognised value
# leaves ONLY en, so a typo is loud instead of quietly publishing a language
# that was meant to stay hidden.
CC_ACTIVE_LOCALES=en,fr,nl,de,es
###< active languages ###
