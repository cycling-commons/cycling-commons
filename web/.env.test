# Test environment overrides. CI overrides DATABASE_URL via its own env vars.
# Local runs use .env.test.local (untracked) to override with host port 5433.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://cc:cc@127.0.0.1:5432/cyclingcommons_test?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> media (docs/specs/photo-uploads.md §2) ###
# Deterministic browser-facing base so URL assembly is assertable. The storage
# behind it is the in-memory adapter (config/packages/flysystem.yaml when@test),
# so nothing here reaches a bucket or a disk.
MEDIA_PUBLIC_BASE=https://media.test
MEDIA_CSP_HOST=https://media.test
###< media ###

# No elevation service in tests. The profiler is exercised directly with a mock
# HTTP client (ClimbProfilerTest); a suite that reached a live Valhalla would be
# slow, non-hermetic, and would fail wherever that tunnel is not open. With this
# empty, ClimbProfiler resolves null and the geometry a submission carries is
# stored as posted — which is what the contribution tests assert.
ELEVATION_URL=
ELEVATION_URLS=

# Operational alert recipient. Pinned HERE rather than inherited from .env,
# which is now empty: the real mailbox moved to the vault, and a test that
# silently follows a deployment value is a test that breaks on deploy config.
# The .test TLD is reserved (RFC 2606), so this can never reach a real inbox.
SECURITY_ALERT_EMAIL=alerts@cyclingcommons.test

###> active languages (docs/specs/dev-environment.md §7 i18n) ###
# Which of the BUILT languages this deployment actually serves. The build
# always carries all five catalogues (framework.enabled_locales, a
# compile-time list); this is the runtime subset a reader can reach.
#
# A language left out here is invisible: not in the language menu, not in the
# hreflang block, not in the sitemap, not offered on /translate, and its
# prefixed paths answer 404. That is how a half-drafted catalogue stays
# translatable on dev while production serves only what is finished.
#
# en is always served whatever this says: it is every unprefixed route and
# the source every translation is made from. An empty or unrecognised value
# leaves ONLY en, so a typo is loud instead of quietly publishing a language
# that was meant to stay hidden.
CC_ACTIVE_LOCALES=en,fr,nl,de,es
###< active languages ###
