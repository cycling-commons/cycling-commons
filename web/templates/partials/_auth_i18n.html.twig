{# Auth-form i18n strings (password toggle + client-side validation), merged
   into the site-wide CC_I18N from base.html.twig. Included from body_scripts
   BEFORE the deferred password-toggle.js / *-validate.js tags, so only pages
   with auth forms ship these strings. Register-only keys (err_name_*,
   err_terms) are merged by register.html.twig itself. #}
<script nonce="{{ csp_nonce() }}">Object.assign(window.CC_I18N, {{ {
  pw_show: 'js.pw_show'|trans, pw_hide: 'js.pw_hide'|trans,
  err_field: 'js.err_field'|trans, err_required: 'js.err_required'|trans,
  err_email_required: 'js.err_email_required'|trans, err_email_invalid: 'js.err_email_invalid'|trans,
  err_password_required: 'js.err_password_required'|trans, err_password_min: 'js.err_password_min'|trans,
  err_mismatch: 'js.err_mismatch'|trans, err_checkbox: 'js.err_checkbox'|trans
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }});</script>
