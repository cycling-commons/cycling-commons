{# Logged-in account chip + dropdown. Reused in the public topnav AND the
   account-shell dtop so the account menu is identical on every logged-in
   surface. Assumes app.user is set. Wired by assets/js/nav-menus.js. #}
{% set _words = app.user.displayName|trim|split(' ') %}
{% set _initials = (_words|length > 1 ? _words|first|first ~ _words|last|first : app.user.displayName|trim|slice(0, 2))|upper %}
{# A disclosure of plain links (button + aria-expanded), NOT an ARIA menu:
   role=menu/menuitem would promise arrow-key navigation we don't implement. #}
<div class="acct-menu" data-nav-menu>
  {# One read, used by the chip's bulb AND the Messages row below — the bulb
     says "something is waiting", the row says WHERE. Without the second, the
     count on the avatar points at nothing you can act on (owner asked twice
     what it referred to, 2026-08-03). #}
  {% set _unread = unread_message_count() %}
  <button type="button" class="acct-chip" data-nav-toggle aria-expanded="false" aria-controls="cc-acct-dd">
    <span class="av" aria-hidden="true">{{ _initials }}</span>
    {% if _unread > 0 %}<span class="acct-bulb" title="{{ 'account.unread_messages'|trans({'%count%': _unread}) }}" aria-label="{{ 'account.unread_messages'|trans({'%count%': _unread}) }}">{{ _unread > 9 ? '9+' : _unread }}</span>{% endif %}
    <span class="acct-name">{{ app.user.displayName }}</span>
    <svg class="acct-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="acct-dropdown" id="cc-acct-dd" data-nav-dd hidden>
    {# Personal — your own account. Labelled only when a work section follows,
       so a plain member still sees a clean, unheaded list. #}
    {% set _hasWork = is_granted('ROLE_CURATOR') or is_granted('ROLE_ADMIN') %}
    {% if _hasWork %}
      <div class="acct-group acct-group-personal">
        <div class="acct-sec acct-sec-personal">{{ 'account.menu_personal'|trans }}</div>
        <a href="{{ path('profile') }}">{{ 'account.tab_contributions'|trans }}</a>
        <a href="{{ path('scout_review') }}">{{ 'account.tab_scout'|trans }}</a>
        <a href="{{ path('messages') }}">{{ 'nav.messages'|trans }}{% if _unread > 0 %}<span class="acct-count">{{ _unread > 9 ? '9+' : _unread }}</span>{% endif %}</a>
        <a href="{{ path('settings') }}">{{ 'nav.settings'|trans }}</a>
      </div>
    {% else %}
      <a href="{{ path('profile') }}">{{ 'account.tab_contributions'|trans }}</a>
      <a href="{{ path('scout_review') }}">{{ 'account.tab_scout'|trans }}</a>
      <a href="{{ path('messages') }}">{{ 'nav.messages'|trans }}{% if _unread > 0 %}<span class="acct-count">{{ _unread > 9 ? '9+' : _unread }}</span>{% endif %}</a>
      <a href="{{ path('settings') }}">{{ 'nav.settings'|trans }}</a>
    {% endif %}
    {% if is_granted('ROLE_CURATOR') %}
      {# Two moderation queues: submissions (everything except routes) + routes. #}
      <div class="acct-group acct-group-mod">
        <div class="acct-sec acct-sec-mod">{{ 'account.menu_moderation'|trans }}</div>
        <a href="{{ path('moderate') }}">{{ 'nav.moderate'|trans }}</a>
        <a href="{{ path('moderate_routes') }}">{{ 'nav.routes'|trans }}</a>
        <a href="{{ path('moderate_history') }}">{{ 'nav.history'|trans }}</a>
        <a href="{{ path('moderate_takedowns') }}">{{ 'nav.takedowns'|trans }}</a>
        <a href="{{ path('moderate_translations') }}">{{ 'nav.translations'|trans }}</a>
        <a href="{{ path('moderate_rulebook') }}">{{ 'nav.rulebook'|trans }}</a>
      </div>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}<a class="acct-sep" href="{{ path('admin') }}">{{ 'nav.admin'|trans }}</a>{% endif %}
    <form method="post" action="{{ path('logout') }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
      <button type="submit">{{ 'nav.logout'|trans }}</button>
    </form>
  </div>
</div>
