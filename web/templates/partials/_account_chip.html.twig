{# Logged-in account chip + dropdown. Reused in the public topnav AND the
   account-shell dtop so the account menu is identical on every logged-in
   surface. Assumes app.user is set. Wired by assets/js/nav-menus.js. #}
{% set _words = app.user.displayName|trim|split(' ') %}
{% set _initials = (_words|length > 1 ? _words|first|first ~ _words|last|first : app.user.displayName|trim|slice(0, 2))|upper %}
{# A disclosure of plain links (button + aria-expanded), NOT an ARIA menu:
   role=menu/menuitem would promise arrow-key navigation we don't implement. #}
{# The translate-mode toggle (translations.md §4.1) is a <form>, like logout,
   but it is a menu row next to Translate, not a destructive action, so it
   must not pick up atlas.css's ".acct-dropdown form"/"form button" rules
   (the top border and the clay logout colour). Both overrides need the extra
   ".acct-inline-form" class in their selector to outrank those by specificity. #}
<style>
  .acct-dropdown .acct-inline-form{margin:0;padding-top:0;border-top:0}
  .acct-dropdown .acct-inline-form button{color:var(--ink)!important}
</style>
<div class="acct-menu" data-nav-menu>
  {# One set of reads: the chip bulb is the total of open work (unread
     messages + open submissions + open translations). Each contributing
     row below repeats its own count so the number on the avatar still
     says WHERE (owner 2026-08-03, 2026-08-26). Counts are the real
     numbers, not a 9+ cap. #}
  {% set _unread = unread_message_count() %}
  {% set _sub_open = pending_submission_count() %}
  {% set _tr_open = pending_translation_count() %}
  {% set _open = _unread + _sub_open + _tr_open %}
  {# Translate mode (translations.md §4.1): the toggle sits next to the
     Translate link itself, not merely wherever the mode is already on, so a
     rider can turn it on from any page. Shown only where turning it on would
     do something: a locale a rider may propose, or a curator on English (who
     may also edit it, §4.2). The answer comes from TranslateMode itself, via
     translate_can_page(), rather than from a locale list repeated here: the
     two used to disagree, and a sixth locale would have been markable with no
     toggle to switch marking on. #}
  {% set _can_translate_page = translate_can_page() %}
  <button type="button" class="acct-chip" data-nav-toggle aria-expanded="false" aria-controls="cc-acct-dd">
    <span class="av" aria-hidden="true">{{ _initials }}</span>
    {% if _open > 0 %}<span class="acct-bulb" title="{{ 'account.open_items'|trans({'%count%': _open}) }}" aria-label="{{ 'account.open_items'|trans({'%count%': _open}) }}">{{ _open }}</span>{% endif %}
    <span class="acct-name">{{ app.user.displayName }}</span>
    <svg class="acct-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="acct-dropdown" id="cc-acct-dd" data-nav-dd hidden>
    {# Personal — your own account. Labelled only when a work section follows,
       so a plain member still sees a clean, unheaded list. #}
    {% set _hasWork = is_granted('ROLE_CURATOR') or is_granted('ROLE_ADMIN') %}
    {% if _hasWork %}
      <div class="acct-group acct-group-personal">
        <div class="acct-sec acct-sec-personal">{{ 'account.menu_personal'|trans }}</div>
        <a href="{{ path('profile') }}">{{ 'account.tab_contributions'|trans }}</a>
        <a href="{{ path('scout_review') }}">{{ 'account.tab_scout'|trans }}</a>
        <a href="{{ path('translate') }}">{{ 'account.tab_translate'|trans }}
          {%- set _stale = translate_stale_count() %}
          {%- if _stale > 0 %}<span class="acct-count tr-stale-count" title="{{ 'translate.stale.badge_title'|trans }}">{{ _stale }}</span>{% endif %}</a>
        {% if _can_translate_page %}
          <form method="post" action="{{ path('translate_mode') }}" class="acct-inline-form">
            {# "_csrf_token", like the logout form below, not Symfony's
               default "_token": this chip renders in shared chrome, ahead
               of the page's own content, so its field must not shadow the
               page's own "_token" input for a test (or any scraper) that
               reads the first match in the raw HTML. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('translate_mode') }}">
            <input type="hidden" name="on" value="{{ translate_mode() ? 0 : 1 }}">
            <button type="submit">{{ (translate_mode() ? 'translate.mode.off_short' : 'translate.mode.on_short')|trans }}</button>
          </form>
        {% endif %}
        <a href="{{ path('messages') }}">{{ 'nav.messages'|trans }}{% if _unread > 0 %}<span class="acct-count">{{ _unread }}</span>{% endif %}</a>
        <a href="{{ path('settings') }}">{{ 'nav.settings'|trans }}</a>
      </div>
    {% else %}
      <a href="{{ path('profile') }}">{{ 'account.tab_contributions'|trans }}</a>
      <a href="{{ path('scout_review') }}">{{ 'account.tab_scout'|trans }}</a>
      <a href="{{ path('translate') }}">{{ 'account.tab_translate'|trans }}
        {%- set _stale = translate_stale_count() %}
        {%- if _stale > 0 %}<span class="acct-count tr-stale-count" title="{{ 'translate.stale.badge_title'|trans }}">{{ _stale }}</span>{% endif %}</a>
      {% if _can_translate_page %}
        <form method="post" action="{{ path('translate_mode') }}" class="acct-inline-form">
          {# "_csrf_token", like the logout form below, not Symfony's
             default "_token": this chip renders in shared chrome, ahead of
             the page's own content, so its field must not shadow the
             page's own "_token" input for a test (or any scraper) that
             reads the first match in the raw HTML. #}
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('translate_mode') }}">
          <input type="hidden" name="on" value="{{ translate_mode() ? 0 : 1 }}">
          <button type="submit">{{ (translate_mode() ? 'translate.mode.off_short' : 'translate.mode.on_short')|trans }}</button>
        </form>
      {% endif %}
      <a href="{{ path('messages') }}">{{ 'nav.messages'|trans }}{% if _unread > 0 %}<span class="acct-count">{{ _unread }}</span>{% endif %}</a>
      <a href="{{ path('settings') }}">{{ 'nav.settings'|trans }}</a>
    {% endif %}
    {% if is_granted('ROLE_CURATOR') %}
      {# Two moderation queues: submissions (everything except routes) + routes. #}
      <div class="acct-group acct-group-mod">
        <div class="acct-sec acct-sec-mod">{{ 'account.menu_moderation'|trans }}</div>
        <a href="{{ path('moderate') }}">{{ 'nav.moderate'|trans }}{% if _sub_open > 0 %}<span class="acct-count" title="{{ 'account.mod_open_in_area'|trans }}">{{ _sub_open }}</span>{% endif %}</a>
        <a href="{{ path('moderate_routes') }}">{{ 'nav.routes'|trans }}</a>
        <a href="{{ path('moderate_takedowns') }}">{{ 'nav.takedowns'|trans }}</a>
        <a href="{{ path('moderate_translations') }}">{{ 'nav.translations'|trans }}{% if _tr_open > 0 %}<span class="acct-count" title="{{ 'account.mod_translations_open'|trans }}">{{ _tr_open }}</span>{% endif %}</a>
        <a href="{{ path('moderate_rulebook') }}">{{ 'nav.rulebook'|trans }}</a>
      </div>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}<a class="acct-sep" href="{{ path('admin') }}">{{ 'nav.admin'|trans }}</a>{% endif %}
    <form method="post" action="{{ path('logout') }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
      <button type="submit">{{ 'nav.logout'|trans }}</button>
    </form>
  </div>
</div>
