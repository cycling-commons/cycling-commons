{% set a = nav_active|default('') %}
<nav class="topnav">
  <div class="brandblock" style="display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none">
    <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons" style="height:1.8rem;display:block"></a>
    <div class="brandsub" style="font-family:var(--mono,'Spline Sans Mono',monospace);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap"><span class="cc-coord">N 41.39° · E 2.16°</span><br>{{ 'nav.tagline'|trans }}</div>
  </div>
  {# The header is for doing (owner 2026-09-08, site-directory.md §5): the
     three buttons, and the pages a rider opens on a ride, plus the blog and
     About as the front door. Everything else lives in the footer, which is
     the whole site in the six groups of /pages. #}
  <div class="links">
    <a href="{{ path('regions') }}"{% if a == 'regions' %} class="on"{% endif %}>{{ 'nav.regions'|trans }}</a>
    <a href="{{ path('coverage') }}"{% if a == 'coverage' %} class="on"{% endif %}>{{ 'nav.coverage'|trans }}</a>
    <a href="{{ path('best_of') }}"{% if a == 'best_of' %} class="on"{% endif %}>{{ 'nav.best_of'|trans }}</a>
    <a href="{{ path('blog') }}"{% if a == 'blog' %} class="on"{% endif %}>{{ 'nav.blog'|trans }}</a>
    <a href="{{ path('about') }}"{% if a == 'about' %} class="on"{% endif %}>{{ 'nav.about'|trans }}</a>
    <a class="acct fill" href="{{ path('map') }}">{{ 'nav.explore_map'|trans }}</a>
    <a class="acct join" href="{{ path('contribute') }}">{{ 'nav.contribute'|trans }}</a>
    <a class="acct join" href="{{ path('join') }}">{{ 'nav.get_involved'|trans }}</a>
    {% if app.user %}
      {% include 'partials/_account_chip.html.twig' %}
    {% else %}
      <a class="acct" href="{{ path('login') }}">{{ 'nav.login'|trans }}</a>
    {% endif %}
    {# Language switcher last (far right): its pill shape sits apart from the
       square CTA/account controls. Shared with the map rail. #}
    {% include 'partials/_lang_menu.html.twig' %}
  </div>
</nav>
