{% set a = nav_active|default('') %}
<nav class="topnav">
  <div class="brandblock" style="display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none">
    <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons" style="height:1.8rem;display:block"></a>
    <div class="brandsub" style="font-family:var(--mono,'Spline Sans Mono',monospace);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap"><span class="cc-coord">N 48.87° · E 2.29°</span><br>{{ 'nav.tagline'|trans }}</div>
  </div>
  <div class="links">
    <a href="{{ path('regions') }}"{% if a == 'regions' %} class="on"{% endif %}>{{ 'nav.regions'|trans }}</a>
    <a href="{{ path('coverage') }}"{% if a == 'coverage' %} class="on"{% endif %}>{{ 'nav.coverage'|trans }}</a>
    <a href="{{ path('vote') }}"{% if a == 'vote' %} class="on"{% endif %}>{{ 'nav.vote'|trans }}</a>
    <a href="{{ path('developers') }}"{% if a == 'developers' %} class="on"{% endif %}>{{ 'nav.developers'|trans }}</a>
    <a href="{{ path('about') }}"{% if a == 'about' %} class="on"{% endif %}>{{ 'nav.about'|trans }}</a>
    <a href="{{ path('licenses') }}"{% if a == 'licenses' %} class="on"{% endif %}>{{ 'nav.licence'|trans }}</a>
    <a class="acct join" href="{{ path('join') }}">{{ 'nav.get_involved'|trans }}</a>
    <a class="acct fill" href="{{ path('map') }}">{{ 'nav.explore_map'|trans }}</a>
    {% if app.user %}
      {% include 'partials/_account_chip.html.twig' %}
    {% else %}
      <a class="acct" href="{{ path('login') }}">{{ 'nav.login'|trans }}</a>
    {% endif %}
    {# Language switcher last (far right): its pill shape sits apart from the square CTA/account controls. #}
    {% set _locales = {'en': 'English', 'fr': 'Français', 'nl': 'Nederlands', 'de': 'Deutsch'} %}
    {# `to` is the current page re-generated in the target locale, so localized routes
       land on their prefixed path; locale_switch still records the choice (session + user). #}
    {% set _alt = locale_alternates().urls %}
    {# A disclosure of plain links (button + aria-expanded), NOT an ARIA menu —
       same pattern as the account chip. #}
    <div class="lang-menu" data-nav-menu>
      <button type="button" class="lang-chip" data-nav-toggle aria-expanded="false" aria-controls="cc-lang-dd" aria-label="{{ 'nav.language'|trans }}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2z"/></svg>
        <span>{{ app.request.locale|upper }}</span>
        <svg class="lang-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="acct-dropdown lang-dropdown" id="cc-lang-dd" data-nav-dd hidden>
        {% for code, label in _locales %}
          <a href="{{ path('locale_switch', {_locale: code}|merge(_alt[code] is defined ? {to: _alt[code]} : {})) }}"{% if app.request.locale == code %} aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</nav>
