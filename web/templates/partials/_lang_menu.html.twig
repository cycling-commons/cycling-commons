{# Language switcher pill + dropdown — shared by the site nav (_nav.html.twig)
   and the map rail. `to` is the current page re-generated in the target locale,
   so localized routes land on their prefixed path while non-localized routes
   (e.g. the map) keep their clean path; locale_switch still records the choice
   (session + user). A disclosure of plain links (button + aria-expanded), NOT
   an ARIA menu — same pattern as the account chip; driven by js/nav-menus.js. #}
{# Names for every BUILT language, filtered to the ones this deployment
   serves (dev-environment.md §7 i18n): a language left out of CC_ACTIVE_LOCALES has no
   entry here, and its prefixed paths answer 404. #}
{% set _names = {'en': 'English', 'fr': 'Français', 'nl': 'Nederlands', 'de': 'Deutsch', 'es': 'Español'} %}
{% set _locales = {} %}
{% for code in active_locales() %}{% set _locales = _locales|merge({(code): _names[code]|default(code|upper)}) %}{% endfor %}
{% set _alt = locale_alternates().urls %}
<div class="lang-menu" data-nav-menu>
  <button type="button" class="lang-chip" data-nav-toggle aria-expanded="false" aria-controls="cc-lang-dd" aria-label="{{ 'nav.language'|trans }}">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2z"/></svg>
    <span>{{ app.request.locale|upper }}</span>
    <svg class="lang-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="acct-dropdown lang-dropdown" id="cc-lang-dd" data-nav-dd hidden>
    {% for code, label in _locales %}
      <a href="{{ path('locale_switch', {_locale: code}|merge(_alt[code] is defined ? {to: _alt[code]} : {})) }}"{% if app.request.locale == code %} aria-current="true"{% endif %}>{{ label }}</a>
    {% endfor %}
  </div>
</div>
