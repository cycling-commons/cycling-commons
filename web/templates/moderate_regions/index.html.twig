{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  /* Head, filter bar and container are the shell's (account/_shell_styles);
     the region card is the shared record card with its own insides. */
  .rg-list{margin:.9rem 0 3rem;display:flex;flex-direction:column;gap:.7rem}
  .rg-item{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:0}
  .rg-body{flex:1 1 240px;min-width:0}
  .rg-name{font-family:var(--serif);font-weight:600;font-size:1.05rem;display:flex;align-items:center;gap:.5rem}
  .rg-cc{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;color:#8a8d7d;border:1px solid rgba(20,22,14,.2);border-radius:3px;padding:.05rem .3rem}
  /* Continent → country → region. Two heading levels that have to be tellable
     apart at a glance while a curator scans, without either competing with the
     region names that are the actual content: the continent is a quiet
     small-caps rule, the country is the one that reads as a label. */
  .rg-continent{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;
    color:#8a8d7d;margin:1.9rem 0 .1rem;padding-bottom:.35rem;border-bottom:1px solid rgba(20,22,14,.14)}
  .rg-list > .rg-continent:first-child{margin-top:0}
  /* The country is the click target, so it has to look like one: a full-width
     row with a hover state and a marker that turns. Sized to be comfortably
     tappable (44px) — this is a list a curator works down. */
  .rg-country > summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:.5rem;
    min-height:44px;padding:.35rem .55rem;border-radius:7px;
    font-family:var(--serif);font-size:.95rem;font-weight:600;color:var(--ink)}
  .rg-country > summary::-webkit-details-marker{display:none}
  .rg-country > summary::marker{content:''}
  .rg-country > summary:hover{background:rgba(20,22,14,.05)}
  .rg-country > summary:focus-visible{outline:2px solid var(--trail);outline-offset:2px}
  /* The disclosure triangle, drawn rather than inherited so it can rotate. */
  .rg-country > summary::before{content:'\25B8';font-size:.7rem;color:#8a8d7d;
    transition:transform .12s ease;flex:0 0 auto}
  .rg-country[open] > summary::before{transform:rotate(90deg)}
  .rg-flag{border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08);flex:0 0 auto}
  .rg-country-name{flex:0 1 auto;min-width:0}
  /* Pushed right: it is the answer to "anything to do here", not a title. */
  .rg-tally{margin-left:auto;font-family:var(--mono);font-size:.62rem;letter-spacing:.04em;color:#595c4d}
  .rg-country[open] > summary{margin-bottom:.5rem}
  /* The cards indent under their country so the grouping survives scrolling
     past the heading. */
  .rg-country > .rg-item{margin-left:1.15rem}
  .rg-country > .rg-item + .rg-item{margin-top:.7rem}
  .rg-meter{margin-top:.45rem;display:flex;align-items:center;gap:.6rem}
  .rg-bar{flex:0 0 140px;height:6px;border-radius:3px;background:rgba(28,58,42,.16);overflow:hidden}
  .rg-bar i{display:block;height:100%;background:var(--spruce);border-radius:3px}
  .rg-bar.is-ready i{background:var(--trail)}
  .rg-count{font-family:var(--mono);font-size:.66rem;color:#595c4d}
  /* Per-block breakdown: which KIND of content the region is short of, not just
     that a number is too low. A block that already carries its share of the
     breadth requirement is marked. */
  .rg-blocks{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.55rem}
  .rg-block{display:inline-flex;align-items:baseline;gap:.35rem;font-family:var(--mono);
    font-size:.6rem;letter-spacing:.04em;padding:.22rem .5rem;border-radius:4px;
    background:rgba(20,22,14,.05);border:1px solid rgba(20,22,14,.12);color:#595c4d}
  .rg-block.is-met{background:rgba(28,58,42,.1);border-color:rgba(28,58,42,.35);color:var(--spruce)}
  .rg-block b{font-size:.72rem;font-weight:700}
  .rg-need{font-family:var(--mono);font-size:.6rem;color:var(--clay);margin-top:.45rem;line-height:1.6}
  .rg-state{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;
    padding:.22rem .55rem;border-radius:30px}
  .rg-state--on{background:var(--trail);color:var(--ink)}
  .rg-state--off{background:rgba(20,22,14,.08);color:#595c4d}
  .rg-act{display:flex;align-items:center;gap:.6rem}
  .rg-locked{font-family:var(--mono);font-size:.6rem;color:#8a8d7d;max-width:22ch;line-height:1.5}
  /* Three rungs, one row. The mode a region is IN reads as a filled chip, the
     ones it may move to as ordinary buttons, and the ones it has not earned as
     muted text carrying their own reason on hover — a curator working a young
     region should see what it is short of, not just that nothing is pressable
     (owner 2026-08-12). */
  .rg-modes{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}
  .rg-mode{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;
    padding:.35rem .6rem;border-radius:30px;white-space:nowrap}
  .rg-mode--is{background:var(--ink);color:var(--paper);border:1px solid var(--ink)}
  button.rg-mode{border:1px solid rgba(20,22,14,.3);background:transparent;color:var(--ink);cursor:pointer}
  button.rg-mode:hover{border-color:var(--trail);color:var(--trail)}
  .rg-mode--locked{border:1px dashed rgba(20,22,14,.22);color:#8a8d7d;cursor:help}
  @media(max-width:700px){.rg-item{align-items:flex-start}.rg-bar{flex-basis:100px}}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_regions', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate_regions.kicker'|trans }}</div>
    <h1>{{ 'moderate_regions.title'|trans }}</h1>
    <p class="lead">{{ 'moderate_regions.lead'|trans({'%threshold%': threshold, '%blocks%': min_blocks, '%per_block%': min_per_block}) }}</p>
  </div>
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# Country filter (owner request, 2026-08-03). Options come from the regions
     this curator can actually see, built before the filter narrows them — a
     list that shrank to the picked country would be a one-way door. #}
  {% if countries|length > 1 %}
    <div class="mod-bar">
      <form class="mod-filters" method="get" action="{{ path('moderate_regions') }}">
        <label>{{ 'moderate.filter.country'|trans }}
          <select name="country" data-autosubmit>
            <option value="">{{ 'moderate.filter.all'|trans }}</option>
            {% for c in countries %}<option value="{{ c }}"{{ country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
          </select>
        </label>
        <noscript><button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button></noscript>
      </form>
    </div>
  {% endif %}

  {% if regions is empty %}
    <div class="empty-state">
      <h3>{{ 'moderate_regions.empty_heading'|trans }}</h3>
      <p>{{ 'moderate_regions.empty_body'|trans }}</p>
    </div>
  {% else %}
  {# Grouped continent → country → region, each country collapsible (owner,
     2026-08-14). Native <details>, so it works with no JS and under the CSP —
     the same affordance the moderation desk's action panels already use.
     Closed by default: 19 countries of regions is several screens before a
     curator reaches anything. The summary carries the counts so a shut group
     still answers "is there anything to do here". #}
  <div class="rg-list">
    {% for cont in continents %}
      <h2 class="rg-continent">{{ cont.name ?: '—' }}</h2>
      {% for c in cont.countries %}
        <details class="rg-country"{{ c.open ? ' open' }}>
          <summary>
            {% if c.flag %}<img class="rg-flag" src="{{ asset(c.flag) }}" alt="" width="20" height="15" loading="lazy">{% endif %}
            <span class="rg-country-name">{{ c.name }}</span>
            <span class="rg-cc">{{ c.code }}</span>
            {# What a closed group still has to tell you: how many regions, and
               how many already clear the curated gate. #}
            <span class="rg-tally">{{ 'moderate_regions.country_tally'|trans({'%ready%': c.ready, '%total%': c.total}) }}</span>
          </summary>
          {% for r in c.regions %}
      <div class="q-item rg-item">
        <div class="rg-body">
          {# No country badge here any more: the country heading directly above
             carries it, and repeating it on every card was the same two letters
             three times down a screen. #}
          <div class="rg-name">{{ r.label }}</div>
          {# The count is shown whether or not the gate is open, so a curator can
             see how far a region still has to go — not just that it is locked. #}
          <div class="rg-meter">
            <span class="rg-bar {{ r.ready ? 'is-ready' : '' }}" role="img"
                  aria-label="{{ 'moderate_regions.readiness'|trans({'%count%': r.count, '%threshold%': threshold}) }}">
              <i style="width:{{ min(100, (r.count * 100 / threshold)|round) }}%"></i>
            </span>
            <span class="rg-count">{{ 'moderate_regions.readiness'|trans({'%count%': r.count, '%threshold%': threshold}) }}</span>
          </div>
          <div class="rg-blocks">
            {% for b in r.blocks %}
              <span class="rg-block {{ b.met ? 'is-met' : '' }}"
                    title="{{ b.label }}{{ b.met ? ' — ' ~ ('moderate_regions.block_met'|trans({'%n%': min_per_block})) : '' }}">
                {{ b.label }} <b>{{ b.count }}</b>
              </span>
            {% endfor %}
          </div>
          {# Say what is still MISSING, in words — a moderator should not have to
             subtract two numbers to find out what to work on. #}
          {% if not r.ready %}
            <div class="rg-need">
              {%- if r.shortTotal > 0 %}{{ 'moderate_regions.need_total'|trans({'%n%': r.shortTotal}) }}{% endif -%}
              {%- if r.shortTotal > 0 and r.shortBlocks > 0 %} · {% endif -%}
              {%- if r.shortBlocks > 0 %}{{ 'moderate_regions.need_blocks'|trans({'%n%': r.shortBlocks, '%per_block%': min_per_block}) }}{% endif -%}
            </div>
          {% endif %}
        </div>
        <span class="rg-state {{ r.defaultMode == 'everything' ? 'rg-state--off' : 'rg-state--on' }}">
          {{ ('moderate_regions.opens_' ~ r.defaultMode)|trans }}
        </span>
        {# Three rungs, three buttons, and each says what it costs. A locked one
           stays visible with its own reason under it: a curator working a young
           region should be able to see what it is short of, not just that they
           cannot press anything (owner 2026-08-12). #}
        {# Same order as the MAP's own view-mode toggle (map/index.html.twig:
           curated · confirmed · all), so a curator setting a region's default
           is choosing from the rungs in the order they will meet them on the
           map. They read narrowest-first, which is also the order the readiness
           gates unlock in. #}
        <div class="rg-act rg-modes">
          {% for m in ['curated', 'confirmed', 'everything'] %}
            {% set allowed = m == 'everything' or (m == 'confirmed' ? r.canConfirmed : r.canCurated) %}
            {% if m == r.defaultMode %}
              <span class="rg-mode rg-mode--is">{{ ('moderate_regions.mode_' ~ m)|trans }}</span>
            {% elseif allowed %}
              <form method="post" action="{{ path('moderate_regions_curated_default') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('region-curated-default') }}">
                <input type="hidden" name="region" value="{{ r.id }}">
                <input type="hidden" name="mode" value="{{ m }}">
                <button type="submit" class="btn-act btn-secondary rg-mode">{{ ('moderate_regions.mode_' ~ m)|trans }}</button>
              </form>
            {% else %}
              <span class="rg-mode rg-mode--locked"
                    title="{{ m == 'confirmed'
                      ? 'moderate_regions.locked_confirmed'|trans({'%threshold%': confirmed_threshold, '%count%': r.confirmed})
                      : 'moderate_regions.locked'|trans({'%threshold%': threshold, '%blocks%': min_blocks, '%per_block%': min_per_block}) }}">
                {{ ('moderate_regions.mode_' ~ m)|trans }}
              </span>
            {% endif %}
          {% endfor %}
        </div>
        {# The region's own lead text. Its own page rather than five textareas
           on a card that already carries a meter, six block counts and three
           mode buttons — and the harvested article needs somewhere to be READ
           before a curator decides to adapt or replace it. #}
        <div class="rg-act">
          <a class="btn-act btn-secondary rg-mode"
             href="{{ path('moderate_regions_about', {slug: r.slug}) }}">{{ 'moderate_regions.about.link'|trans }}</a>
        </div>
      </div>
          {% endfor %}
        </details>
      {% endfor %}
    {% endfor %}
  </div>
  {# No pager (owner, 2026-08-14). This is a settings desk, not a queue: the
     list is one collapsed row per onboarded country, and paging it turned
     "which regions open in Best of" into a question spanning three URLs. #}
  {% endif %}
</div>
{% endblock %}
