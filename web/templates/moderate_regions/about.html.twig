{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate_regions/about.css') }}">
{% endblock %}

{# The account/moderator shell. Without this block a desk page silently falls
   back to the PUBLIC header, so a curator editing one region loses every way
   back to the desks they came from. `active: 'moderate_regions'` on purpose:
   this is a sub-page of the Regions desk, not a desk of its own, so the tab
   the curator arrived through stays lit. #}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_regions'} %}{% endblock %}

{% block body %}
<div class="mh">
  <div class="wrap">
    {# Back BEFORE the title, not only at the foot of the form: a curator who
       opened the wrong region should not have to read to the bottom of five
       language boxes to leave. Carries the country so it returns to the
       filtered desk they came from, not to all nineteen. #}
    <a class="ab-back" href="{{ path('moderate_regions') }}?country={{ region.countryCode }}">&#8592; {{ 'moderate_regions.about.back'|trans }}</a>
    <div class="kicker">{{ 'moderate_regions.about.kicker'|trans }}</div>
    {# Country ahead of the region name: "Eastern Province" is ambiguous across
       nineteen countries, and the desk groups by country, so a curator arrives
       here already thinking in that order. #}
    <div class="ab-country">
      {% if region.flag %}<img class="ab-flag" src="{{ asset(region.flag) }}" alt="" width="20" height="15">{% endif %}
      <span>{{ region.countryName }}</span>
    </div>
    <h1>{{ region.label }}</h1>
    <p class="lead">{{ 'moderate_regions.about.lead'|trans }}</p>
  </div>
</div>

<div class="wrap" id="main">
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <form method="post" action="{{ path('moderate_regions_about_save', {slug: region.slug}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('region-about-text') }}">
    {# Endonyms, exactly as the language menu spells them: a curator picking the
       Dutch slot looks for "Nederlands", whatever language the desk is in. #}
    {% set _langs = {'en': 'English', 'fr': 'Français', 'nl': 'Nederlands', 'de': 'Deutsch', 'es': 'Español'} %}
    <div class="ab-list">
      {% for l in locales %}
        <div class="ab-slot">
          <div class="ab-lang">{{ _langs[l.code]|default(l.code) }}</div>
          {# What Wikipedia gave us for THIS language, verbatim and credited,
             so the curator decides against the real text rather than against a
             memory of it. A language with no article says so plainly: that is
             the case only a local curator can fill. #}
          {% if l.wiki %}
            <blockquote class="ab-wiki">{{ l.wiki.extract }}
              <br><a href="{{ l.wiki.url }}" target="_blank" rel="noopener noreferrer">{{ l.wiki.title }} &#8599;</a></blockquote>
          {% else %}
            <p class="ab-none">{{ 'moderate_regions.about.no_article'|trans }}</p>
          {% endif %}
          <label class="vh" for="text_{{ l.code }}">{{ region.label }} — {{ _langs[l.code]|default(l.code) }}</label>
          <textarea id="text_{{ l.code }}" name="text_{{ l.code }}" maxlength="{{ max_len }}"
                    placeholder="{{ 'moderate_regions.about.placeholder'|trans }}">{{ l.text }}</textarea>
          {# The licence question, asked in plain words rather than as the word
             "derivative". Only offered where there is an article to adapt —
             elsewhere the box would invite a citation we cannot honour. #}
          {% if l.canDerive %}
            <label class="ab-derived">
              <input type="checkbox" name="derived_{{ l.code }}" value="1"{{ l.derived ? ' checked' }}>
              <span>{{ 'moderate_regions.about.derived_label'|trans }}</span>
            </label>
          {% else %}
            <p class="ab-derived ab-derived--off">{{ 'moderate_regions.about.derived_unavailable'|trans }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="ab-acts">
      <button type="submit" class="btn-act">{{ 'moderate_regions.about.save'|trans }}</button>
      <a class="btn-act btn-secondary" href="{{ path('moderate_regions') }}?country={{ region.countryCode }}">{{ 'moderate_regions.about.back'|trans }}</a>
    </div>
  </form>
</div>
{% endblock %}
