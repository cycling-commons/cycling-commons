{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/join.css') }}">
{% endblock %}
{% block body %}
<div class="ahero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}join.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}join.title{% endtrans %}</h1>
  <p class="lead" style="margin-top:1rem">{% trans %}join.lead1{% endtrans %}</p>
  <p class="lead" style="margin-top:1rem">{% trans %}join.lead2{% endtrans %}</p>
</div></div>

{# The riders-and-local-knowledge block that stood here moved to its own page,
   /contributors-and-curators, on 2026-09-09 (owner: this page "should be
   really about all things needed beyond curators and contributors"). #}

<section class="pad" style="background:var(--paper-deep)"><div class="wrap">
  <div class="kicker">{% trans %}join.skills_kicker{% endtrans %}</div>
  <h2 class="disp">{% trans %}join.skills_h2{% endtrans %}</h2>
  <div class="roles">
    <div class="card">
      <span class="rk">{% trans %}join.role1_rk{% endtrans %}</span>
      <h3>{% trans %}join.role1_h{% endtrans %}</h3>
      <p>{{ 'join.role1_p'|trans|rich }}</p>
      <a class="rl" href="https://github.com/cycling-commons/cycling-commons">{% trans %}join.role1_link{% endtrans %}</a>
    </div>
    <div class="card">
      <span class="rk">{% trans %}join.role2_rk{% endtrans %}</span>
      <h3>{% trans %}join.role2_h{% endtrans %}</h3>
      <p>{% trans %}join.role2_p{% endtrans %}</p>
      <a class="rl" href="{{ path('contact') }}?topic=partnership">{% trans %}join.role2_link{% endtrans %}</a>
    </div>
    <div class="card">
      <span class="rk">{% trans %}join.role3_rk{% endtrans %}</span>
      <h3>{% trans %}join.role3_h{% endtrans %}</h3>
      <p>{% trans %}join.role3_p{% endtrans %}</p>
      <a class="rl" href="{{ path('contact') }}?topic=partnership">{% trans %}join.role3_link{% endtrans %}</a>
    </div>
    <div class="card">
      <span class="rk">{% trans %}join.role4_rk{% endtrans %}</span>
      <h3>{% trans %}join.role4_h{% endtrans %}</h3>
      <p>{{ 'join.role4_p'|trans|rich }}</p>
      <a class="rl" href="{{ path('contact') }}?topic=partnership">{% trans %}join.role4_link{% endtrans %}</a>
    </div>
  </div>
  <p class="lead" style="margin-top:1.8rem">{{ 'join.also_welcome'|trans|rich }} <a href="{{ path('contact') }}?topic=partnership">{% trans %}join.also_tell{% endtrans %}</a></p>
</div></section>

{# Left-aligned like every other block on the page, not a centred column
   (owner 2026-09-09). #}
<section class="pad" style="background:var(--ink);color:var(--paper)"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}join.start_kicker{% endtrans %}</div>
  <h2 class="disp">{% trans %}join.start_h2{% endtrans %}</h2>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:1rem">{% trans %}join.start_lead{% endtrans %}</p>
  <div style="display:flex;gap:.8rem;margin-top:1.8rem;flex-wrap:wrap">
    <a class="btn btn-p" href="https://github.com/cycling-commons/cycling-commons">{% trans %}join.start_cta_code{% endtrans %}</a>
    <a class="btn btn-g" style="border-color:rgba(239,230,212,.4);color:var(--paper)" href="{{ path('contact') }}?topic=partnership">{% trans %}join.start_cta_email{% endtrans %}</a>
  </div>
</div></section>
{% endblock %}
