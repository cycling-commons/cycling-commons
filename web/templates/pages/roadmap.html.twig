{#
  What is coming. A flat list on purpose (owner, 2026-08-28), read out of
  App\Content\ReleaseNotes with no database behind it: editing the roadmap is a
  pull request, which leaves a history for free.

  Only unfinished work appears here. What landed lives on /changelog, linked at
  the foot, so nothing is described in two places.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/roadmap.css') }}">
{% endblock %}

{% block body %}
<div class="rhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}roadmap.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}roadmap.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'roadmap.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="rwrap">
    {% for status in statuses %}
      {% set items = roadmap|filter(i => i.status == status) %}
      {% if items|length %}
        <div class="rgroup">
          <h2>{{ ('roadmap.group_' ~ status)|trans }}</h2>
          <p class="gsub">{{ ('roadmap.group_' ~ status ~ '_sub')|trans }}</p>
          {% for item in items %}
            <div class="ritem">
              <span class="rdot rdot--{{ status }}" aria-hidden="true"></span>
              <p>{{ item.key|trans|rich }}{% if item.issue is defined %}<a class="rissue" href="https://github.com/cycling-commons/cycling-commons/issues/{{ item.issue }}">#{{ item.issue }}</a>{% endif %}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

    <div class="rfoot">
      {% trans %}roadmap.foot_shipped_pre{% endtrans %}
      <a href="{{ path('changelog') }}">{% trans %}roadmap.foot_shipped_link{% endtrans %}</a>{% trans %}roadmap.foot_shipped_mid{% endtrans %}
      <a href="{{ path('contact') }}">{% trans %}roadmap.foot_contact_link{% endtrans %}</a>{% trans %}roadmap.foot_shipped_post{% endtrans %}
    </div>
  </div>
</div></section>
{% endblock %}
