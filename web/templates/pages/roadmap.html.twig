{#
  What is coming, and the rider's say in it (docs/specs/roadmap-and-changelog.md
  §8). The items come from the database, written on the roadmap desk; an item
  without a text in the page's language shows its English one, marked with
  its own `lang`.

  With the rider's say switched on (`say_live`), a second tab lists the
  riders' proposals open for votes, and every row gets a vote and a follow
  button (roadmap/_marks.html.twig). The tab is in the URL, never in script
  state, so both tabs stay shareable in the public cache.

  The list is unfinished work. An item the desk marks shipped moves to
  "Latest additions" in the right-hand column (the newest
  RoadmapController::LATEST_DONE), and to the Done page with all of them; on a
  narrow screen the column follows the list. How it landed, release by
  release, is /whats-new, linked at the foot.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/roadmap.css') }}">
{% endblock %}

{% block body %}
<div class="rhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}roadmap.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}roadmap.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'roadmap.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="rlayout{% if latest_done is not empty %} rlayout--done{% endif %}">
  <div class="rwrap">
    {% if app.user %}
      {% for msg in app.flashes('error') %}<div class="rflash" role="alert">{{ msg|trans }}</div>{% endfor %}
      {% for msg in app.flashes('success') %}<div class="rflash rflash--ok" role="status">{{ msg|trans }}</div>{% endfor %}
    {% endif %}

    {% if say_live %}
      <div class="rsay">
        <p>{% trans %}roadmap.say_lead{% endtrans %}</p>
        {% if app.user %}
          <a class="rsay-go" href="{{ path('roadmap_propose') }}">{% trans %}roadmap.say_propose{% endtrans %}</a>
        {% else %}
          <a class="rsay-go" href="{{ path('login', {_target_path: path('roadmap')}) }}">{% trans %}roadmap.say_signin{% endtrans %}</a>
        {% endif %}
      </div>
      <nav class="lfilter rtabs" aria-label="{{ 'roadmap.tabs_aria'|trans }}">
        <a class="lchip" href="{{ path('roadmap') }}"{% if tab == 'roadmap' %} aria-current="page"{% endif %}>{% trans %}roadmap.tab_roadmap{% endtrans %}</a>
        <a class="lchip" href="{{ path('roadmap', {tab: 'proposals'}) }}"{% if tab == 'proposals' %} aria-current="page"{% endif %}>{% trans %}roadmap.tab_proposals{% endtrans %}{% if proposal_count %} <b>{{ proposal_count }}</b>{% endif %}</a>
      </nav>
    {% endif %}

    {% if tab == 'proposals' %}
      <div class="rgroup">
        <p class="gsub">{% trans %}roadmap.proposals_sub{% endtrans %}</p>
        {% if proposals is empty %}
          <p class="rempty">{% trans %}roadmap.proposals_none{% endtrans %}</p>
        {% else %}
          <div class="rroute">
          {% for item in proposals %}
            <div class="ritem" id="{{ item.anchor }}">
              <span class="rdot rdot--idea" aria-hidden="true"></span>
              <div class="rbody">
                <p lang="{{ item.lang }}"><b>{{ item.title }}</b>{{ item.title matches '/[.!?]$/' ? '' : '.' }} {{ item.body|length > 420 ? item.body|slice(0, 420) ~ '…' : item.body }}</p>
                <span class="ridea">{% trans %}roadmap.idea_badge{% endtrans %}</span>
                {% include 'roadmap/_picture.html.twig' with {item: item} only %}
              </div>
              {% include 'roadmap/_marks.html.twig' with {item: item, back: path('roadmap', {tab: 'proposals'}), csrf_id: csrf_id} only %}
            </div>
          {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      {% for status in statuses %}
        {% set items = roadmap|filter(i => i.status == status) %}
        {% if items|length %}
          <div class="rgroup">
            <h2>{{ ('roadmap.group_' ~ status)|trans }}</h2>
            <p class="gsub">{{ ('roadmap.group_' ~ status ~ '_sub')|trans }}</p>
            <div class="rroute">
            {% for item in items %}
              <div class="ritem" id="{{ item.anchor }}">
                <span class="rdot rdot--{{ status }}" aria-hidden="true"></span>
                <div class="rbody">
                  <p{% if item.lang != app.request.locale %} lang="{{ item.lang }}"{% endif %}><b>{{ item.title }}</b>{{ item.title matches '/[.!?]$/' ? '' : '.' }} {{ item.body }}{% if item.issue %}<a class="rissue" href="https://github.com/cycling-commons/cycling-commons/issues/{{ item.issue }}">#{{ item.issue }}</a>{% endif %}</p>
                  {% if item.from_rider %}<span class="ridea">{% trans %}roadmap.idea_badge{% endtrans %}</span>{% endif %}
                  {% include 'roadmap/_picture.html.twig' with {item: item} only %}
                </div>
                {% if say_live %}{% include 'roadmap/_marks.html.twig' with {item: item, back: path('roadmap'), csrf_id: csrf_id} only %}{% endif %}
              </div>
            {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="rfoot">
      {% trans %}roadmap.foot_shipped_pre{% endtrans %}
      <a href="{{ path('changelog') }}">{% trans %}roadmap.foot_shipped_link{% endtrans %}</a>{% trans %}roadmap.foot_shipped_mid{% endtrans %}
      {%- if say_live %}
      <a href="{{ path('roadmap_propose') }}">{% trans %}roadmap.foot_propose_link{% endtrans %}</a>{% trans %}roadmap.foot_shipped_post{% endtrans %}
      {%- else %}
      <a href="{{ path('contact') }}">{% trans %}roadmap.foot_contact_link{% endtrans %}</a>{% trans %}roadmap.foot_shipped_post{% endtrans %}
      {%- endif %}
    </div>
  </div>

  {% if latest_done is not empty %}
  <aside class="rdone" aria-labelledby="rdone-h">
    <h2 id="rdone-h">{% trans %}roadmap.latest_h{% endtrans %}</h2>
    <p class="gsub">{% trans %}roadmap.latest_sub{% endtrans %}</p>
    <ol class="rdone-list">
      {% for item in latest_done %}
        <li>
          <span class="rdot rdot--done" aria-hidden="true"></span>
          <div>
            <a href="{{ path('roadmap_done') }}#{{ item.anchor }}"{% if item.lang != app.request.locale %} lang="{{ item.lang }}"{% endif %}><b>{{ item.title }}</b></a>
            <time class="rdone-d" datetime="{{ item.shipped|date('Y-m-d') }}">{{ item.shipped|cc_date }}</time>
          </div>
        </li>
      {% endfor %}
    </ol>
    <a class="rdone-all" href="{{ path('roadmap_done') }}">{% trans %}roadmap.latest_all{% endtrans %} &rarr;</a>
  </aside>
  {% endif %}
  </div>
</div></section>
{% endblock %}

{% block body_scripts %}
{{ parent() }}
{% if say_live and app.user %}<script src="{{ asset('roadmap/marks.js') }}" defer></script>{% endif %}
{% endblock %}
