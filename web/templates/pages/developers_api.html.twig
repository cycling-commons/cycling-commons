{# Standalone page (no base layout): the site chrome is locale-prefixed and
   this reference is English-only — a locale switcher would link to routes
   that don't exist. Redoc renders public/api/openapi.yaml client-side; the
   bundle is vendored under assets/lib/ like every other third-party lib
   (self-hosted 2026-08-09 — unpkg had no SLA and serialized first paint), and
   the tiny init block is nonced per the CSP (script-src 'self' 'nonce-…',
   worker-src blob: for Redoc's search worker). #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>API reference — Cycling Commons</title>
<meta name="description" content="Interactive reference for the Cycling Commons public API — the design-first OpenAPI contract we are building to." />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="{{ asset('brand/logo-favicon.svg') }}" />
<link rel="stylesheet" href="{{ asset('styles/fonts.css') }}" />
<link rel="stylesheet" href="{{ asset('styles/page/pages/developers_api.css') }}">
{# A public page like any other, so it is counted (partials/_head.html.twig). #}
{% if analytics_on_page() %}<script defer src="{{ asset('js/analytics.js') }}"></script>{% endif %}
</head>
<body>
<div class="apibar">
  <a href="{{ path('developers') }}">← Cycling Commons · Developers</a>
  <a href="https://wiki.cyclingcommons.org/developers/api/">Integration guide</a>
  {# What is true, counted from the document below rather than asserted: two
     of the twelve endpoints answer today (known issue, 2026-09-06). "Not live
     yet" stopped being true the day /v1/map-config shipped, and a contract
     page that is wrong about itself is the worst kind. #}
  <span class="draft">{{ 'api.live_count'|trans({'%live%': api_live, '%total%': api_total}) }}</span>
</div>
<div id="redoc"></div>
<script src="{{ asset('lib/redoc-standalone-2.5.3.js') }}"></script>
<script nonce="{{ csp_nonce() }}">
Redoc.init('/api/openapi.yaml', {
  hideDownloadButton: false,
  expandResponses: '200',
  theme: {
    spacing: { sectionVertical: 16 },
    colors: {
      primary: { main: '#1C3A2A' },
      text: { primary: '#101E16' },
      warning: { main: '#C8923A' },
      error: { main: '#964526' }
    },
    typography: {
      fontFamily: "'Spline Sans', system-ui, sans-serif",
      headings: { fontFamily: "'Bricolage Grotesque', system-ui, sans-serif", fontWeight: '600' },
      links: { color: '#964526', hover: '#FF5A1F' },
      code: { fontFamily: "'Spline Sans Mono', monospace", color: '#964526', backgroundColor: 'rgba(28,58,42,.08)' }
    },
    sidebar: {
      backgroundColor: '#E2D5BC',
      textColor: '#101E16',
      activeTextColor: '#1C3A2A'
    },
    rightPanel: {
      backgroundColor: '#101E16',
      textColor: '#EFE6D4'
    },
    codeBlock: { backgroundColor: '#0B140F' }
  }
}, document.getElementById('redoc'));
</script>
</body>
</html>
