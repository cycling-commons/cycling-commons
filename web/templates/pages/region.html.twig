{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .rhero{background:var(--ink);color:var(--paper);padding:3rem 0}
  .rhero .co{color:var(--glacier);margin-bottom:1rem}
  .rstats{display:flex;gap:2.4rem;flex-wrap:wrap;margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid rgba(239,230,212,.18)}
  .rstats .s b{font-family:var(--serif);font-size:1.8rem;display:block}.rstats .s span{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(239,230,212,.6)}
  .best{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
  @media(max-width:820px){.best{grid-template-columns:1fr}}
  .best h3{font-family:var(--serif);font-weight:600;font-size:1.3rem;margin-bottom:.8rem}
  .rk{display:flex;gap:.7rem;padding:.5rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.95rem}
  .rk .n{font-family:var(--mono);color:var(--trail);font-size:.8rem}.rk .c{margin-left:auto;font-family:var(--mono);font-size:.6rem;color:#595c4d}
  .cov{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.1rem;margin-top:1.6rem}
  .cov .row{display:flex;justify-content:space-between;font-size:.85rem;margin-bottom:.4rem}.cov .row span:last-child{font-family:var(--mono);font-size:.66rem;color:#595c4d}
  .contr{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem}
  .contr .c{font-family:var(--mono);font-size:.66rem;background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:30px;padding:.4rem .8rem}
</style>
{% endblock %}
{% block body %}
<div style="background:rgba(200,146,58,.16);border-bottom:1px solid rgba(200,146,58,.55);color:#6b5320;text-align:center;padding:.6rem 1rem;font-size:.82rem;line-height:1.4"><b style="color:#B5532E">{% trans %}region.demo_label{% endtrans %}</b> {% trans %}region.demo_body{% endtrans %}</div>

<div class="rhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}region.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}region.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.6rem">{% trans %}region.lead{% endtrans %}</p>
  <div class="rstats">
    <div class="s"><b>{% trans %}region.stat_climbs_n{% endtrans %}</b><span>{% trans %}region.stat_climbs_label{% endtrans %}</span></div>
    <div class="s"><b>{% trans %}region.stat_water_n{% endtrans %}</b><span>{% trans %}region.stat_water_label{% endtrans %}</span></div>
    <div class="s"><b>{% trans %}region.stat_rides_n{% endtrans %}</b><span>{% trans %}region.stat_rides_label{% endtrans %}</span></div>
    <div class="s"><b>{% trans %}region.stat_stays_n{% endtrans %}</b><span>{% trans %}region.stat_stays_label{% endtrans %}</span></div>
  </div>
  <div style="display:flex;gap:.8rem;margin-top:1.8rem;flex-wrap:wrap">
    <a class="btn btn-p" href="{{ path('map') }}">{% trans %}region.cta_map{% endtrans %}</a>
    <a class="btn btn-g" style="border-color:rgba(239,230,212,.4);color:var(--paper)" href="{{ path('vote') }}">{% trans %}region.cta_vote{% endtrans %}</a>
  </div>
</div></div>

<section class="pad"><div class="wrap">
  <div class="kicker">{% trans %}region.best_kicker{% endtrans %}</div>
  <div class="best">
    <div class="card"><h3>{% trans %}region.climbs_h{% endtrans %}</h3>
      <div class="rk"><span class="n">01</span>Côte de la Redoute<span class="c">8.4%</span></div>
      <div class="rk"><span class="n">02</span>Mur de Huy<span class="c">9.3%</span></div>
      <div class="rk"><span class="n">03</span>Côte de Stockeu<span class="c">9.0%</span></div>
      <div class="rk" style="border:none"><span class="n">04</span>Côte de la Roche-aux-Faucons<span class="c">9.0%</span></div>
    </div>
    <div class="card"><h3>{{ 'region.views_h'|trans|rich }}</h3>
      <div class="rk"><span class="n">01</span>Signal de Botrange<span class="c">694 m</span></div>
      <div class="rk" style="border:none"><span class="n">02</span>Stavelot Abbey<span class="c">heritage</span></div>
    </div>
    <div class="card"><h3>{% trans %}region.routes_h{% endtrans %}</h3>
      <div class="rk"><span class="n">01</span>Spa · Sankt Vith<span class="c">126 km</span></div>
      <div class="rk"><span class="n">02</span>Spa · Coo · Francorchamps<span class="c">51 km</span></div>
      <div class="rk" style="border:none"><span class="n">03</span>Spa · Côte des Hézalles<span class="c">51 km</span></div>
    </div>
  </div>
</div></section>

<section class="pad" style="background:var(--paper-deep)"><div class="wrap">
  <div class="kicker">{% trans %}region.cov_kicker{% endtrans %}</div>
  <div class="cov">
    <div><div class="row"><span>Climbs</span><span>complete</span></div><div class="bar"><span style="width:92%"></span></div></div>
    <div><div class="row"><span>Water &amp; food</span><span>good</span></div><div class="bar"><span style="width:78%"></span></div></div>
    <div><div class="row"><span>Stays</span><span>growing</span></div><div class="bar"><span class="o" style="width:46%"></span></div></div>
    <div><div class="row"><span>Hazards (fresh)</span><span>live</span></div><div class="bar"><span class="t" style="width:64%"></span></div></div>
  </div>
  <div class="kicker" style="margin-top:2.2rem">{% trans %}region.contrib_kicker{% endtrans %}</div>
  <div class="contr"><span class="c">rider#1ab8 · 312</span><span class="c">rider#4f2a · 271</span><span class="c">rider#9c01 · 188</span><span class="c">rider#2e55 · 140</span><span class="c">+ 86 more</span></div>
</div></section>
{% endblock %}
