{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .rhero .co{display:flex;align-items:center;gap:.5rem;color:var(--glacier);margin-bottom:1rem;font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase}
  .rstats{display:flex;gap:2.4rem;flex-wrap:wrap;margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid rgba(239,230,212,.18)}
  .rstats .s b{font-family:var(--serif);font-size:1.8rem;display:block}
  .rstats .s span{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(239,230,212,.6)}
  /* Label on its own line, figures under it. The two-number version outgrew a
     single row: "1 checked · 1483 on the map" beside a label in a 220px column
     wrapped "Water &/food" and ran the count into the next column. Stacking
     removes the collision for any string length, which matters across five
     locales where "on the map" is "sur la carte" and "auf der Karte". */
  {# -.65rem: each row wears .65rem top padding (the row separators need it),
     so the first row's TEXT sat 9px lower under its header than the About
     paragraph does under its own. A negative margin collapses additively
     with the kicker's 1rem (1rem - .65rem), cancelling exactly the first
     row's padding - the ink-to-ink gap under both headers measures equal. #}
  .kinds{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:0 2rem;margin-top:-.65rem}
  .kinds .k{display:flex;flex-direction:column;gap:.15rem;padding:.65rem 0;
    border-bottom:1px solid rgba(20,22,14,.1);font-size:.95rem}
  .kinds .k .c{font-family:var(--mono);font-size:.72rem;color:#8a8d7d;letter-spacing:.02em}
  /* Checked reads as the achievement, coverage as the backdrop it sits on. */
  .kinds .k .c b{color:var(--trail);font-weight:700}
  .kinds .k .c i{font-style:normal}
  .kinds-note{font-size:.90rem;color:#595c4d;margin:.9rem 0 0;line-height:1.6;max-width:64ch}
  .region-report{margin:1.4rem 0 0;padding-top:1rem;border-top:1px solid rgba(20,22,14,.12);font-size:.82rem}
  .region-report a{color:#595c4d}
  /* The two terms this sentence defines, set apart from the sentence that
     defines them. Padding rather than bare <code>: the mono glyphs sit tight
     against the surrounding prose and the word boundary disappears. */
  .kinds-note code{font-family:var(--mono);font-size:.78rem;padding:.08em .34em;border-radius:4px;
    background:rgba(89,92,77,.11);color:#3f4236;white-space:nowrap}
  /* The country in outline with this region filled. Inline SVG, no request and
     no JavaScript: a region page is read once, often on a phone, and the
     button beside it opens the real map for anyone who wants to pan. */
  .rshape{flex:0 0 auto;margin-left:auto}
  .rshape svg{display:block;width:132px;height:99px;overflow:visible}
  .rshape .co-out{fill:rgba(239,230,212,.10);stroke:rgba(239,230,212,.38);stroke-width:.8;
    stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .rshape .rg-in{fill:var(--clay);fill-opacity:.9;stroke:var(--paper);stroke-width:.8;
    stroke-linejoin:round;vector-effect:non-scaling-stroke}
  /* Who looks after this region. A quiet line, but a full sentence: the
     question it answers is one a rider asks before trusting anything else here. */
  .rsteward{margin-top:1.5rem;display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem;
    font-size:.88rem;color:rgba(239,230,212,.75);line-height:1.5}
  /* The heading owns its line; the chip and its sentence share the next one. */
  .rsteward-h{flex:0 0 100%;font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;
    text-transform:uppercase;color:rgba(239,230,212,.5)}
  .rsteward b{color:var(--paper);font-weight:600}
  .rsteward-chip{display:inline-block;margin-right:.45rem;padding:.16rem .5rem;border-radius:999px;
    border:1px solid rgba(239,230,212,.28);background:rgba(239,230,212,.07);
    font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
    color:var(--paper);white-space:nowrap;vertical-align:.06em}
  .rsteward-d{color:rgba(239,230,212,.62)}
  .rsteward-sep{color:rgba(239,230,212,.35);padding:0 .1rem}
  /* One person = one pair of chips, kept together on a line break. The name
     chip carries the emphasis; the reach chip is the quiet qualifier beside
     it, joined to it rather than spaced away. */
  .rsteward-people{display:inline-flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-right:.15rem}
  .rsteward-person{display:inline-flex;align-items:center;white-space:nowrap}
  .rsteward-name{border-radius:999px 0 0 999px;border-right:none;color:var(--paper);
    text-decoration:none;font-weight:600;letter-spacing:.06em}
  a.rsteward-name:hover{background:rgba(239,230,212,.16);border-color:rgba(239,230,212,.5)}
  .rsteward-name.is-anon{color:rgba(239,230,212,.72);font-weight:400}
  .rsteward-reach{border-radius:0 999px 999px 0;background:transparent;
    color:rgba(239,230,212,.6);letter-spacing:.08em}
  .rhero-top{display:flex;align-items:flex-start;gap:1.5rem;flex-wrap:wrap}
  .rhero-top > .rhero-head{flex:1 1 260px;min-width:0}
  @media(max-width:640px){.rshape{margin-left:0}.rshape svg{width:104px;height:78px}}
  /* The about block and the section under it are one reading flow, not two
     chapters (owner 2026-08-16: the gap read as dead space). Selector
     shapes are deliberate: atlas.css sets section.pad:has(+ section.pad)
     padding-bottom at (0,2,2) specificity, which silently beat both a lone
     class and section.rg-about when this was first written - the zero has
     to ride the same :has() shape to win the tie as the later sheet. */
  section.rg-about{padding-bottom:0}
  section.rg-about:has(+ section.pad){padding-bottom:0}
  /* The same clamp as .rhero+section.pad, so hero->About and About->next
     header breathe identically at every width (owner 2026-08-16). */
  section.rg-about+section.pad{padding-top:clamp(1.75rem,3.5vw,2.75rem)}
  .rg-about-text{max-width:46rem;font-size:1.02rem;line-height:1.65;margin:.4rem 0 .5rem}
  .rg-about-attrib{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em;color:#5a5d4d}
  .rg-about-attrib a{color:inherit}
</style>
{% endblock %}
{% block body %}

<div class="rhero"><div class="wrap">
  <div class="rhero-top">
    <div class="rhero-head">
  <div class="co">
    <img src="{{ asset(region.flag) }}" alt="" width="20" height="15">
    <span>{{ region.countryName }}</span>
    <span>· {{ ('regions.tier_' ~ region.tier)|trans }}</span>
    {% if region.stewardship != 'none' %}<span>· {{ ('regions.status_' ~ region.stewardship)|trans }}</span>{% endif %}
  </div>
  <h1 class="disp">{{ ('region.' ~ region.slug ~ '.label')|trans }}</h1>
    </div>
    {# Where this region sits in its country. Decorative: the shapes carry no
       information the text does not, so it is aria-hidden rather than given a
       label nobody needs read to them. #}
    {% if silhouette %}
      <figure class="rshape" aria-hidden="true">
        <svg viewBox="0 0 {{ silhouette.width }} {{ silhouette.height }}" role="presentation" focusable="false">
          {% if silhouette.country %}<path class="co-out" d="{{ silhouette.country }}" fill-rule="evenodd"/>{% endif %}
          {% if silhouette.region %}<path class="rg-in" d="{{ silhouette.region }}" fill-rule="evenodd"/>{% endif %}
        </svg>
      </figure>
    {% endif %}
  </div>
  {# THE SAME THREE FIGURES AS /coverage, in the same order (owner 2026-08-14).
     That page opens with reference items, catalog items and routes; a region
     page that opened with only the last two made the region look like it holds
     a handful of things when the map there draws thousands. Same labels too,
     so a reader moving between the two pages is not asked to learn the
     vocabulary twice. #}
  <div class="rstats">
    <div class="s"><b>{{ region.coveragePois|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_pois{% endtrans %}</span></div>
    <div class="s"><b>{{ region.itemsVerified }}</b><span>{% trans %}region.stat_items{% endtrans %}</span></div>
    <div class="s"><b>{{ region.routes }}</b><span>{% trans %}region.stat_routes{% endtrans %}</span></div>
    {# The label is the noun, not the unit: cc_km2 already appends the suffix,
       so "372,910 km²" sat above a second "KM²". The other three stats name
       what they count and this one now does too. #}
    {% if region.areaKm2 %}<div class="s"><b>{{ region.areaKm2|cc_km2 }}</b><span>{% trans %}region.stat_area{% endtrans %}</span></div>{% endif %}
  </div>
  {# WHO LOOKS AFTER IT, as a sentence (owner: "I do not see if there is a
     curator for the region yet"). The kicker above carries the same fact as a
     single word — CURATED, COUNTRY-WIDE — which does not read as an answer to
     that question, and the `none` case rendered NOTHING at all, so "nobody has
     taken this on" looked identical to a page that had not finished loading.
     Placed directly above the buttons, so "Volunteer as curator" reads as the
     reply to it. #}
  {# THE PEOPLE FIRST, THEN THEIR REACH (owner 2026-08-14). Restructured from a
     sentence into chips: a name is a thing you click, and a reach is a
     property of the person, so each curator carries their own reach chip
     rather than the region carrying one status word for all of them. A curator
     who has not made their profile public is still counted and still shown -
     as "A curator", unlinked - because the fact that somebody looks after this
     region is not theirs to withhold, only their name is. #}
  <div class="rsteward">
    <span class="rsteward-h">{% trans %}regions.steward_h{% endtrans %}</span>
    <span class="rsteward-body">
      {% if region.curators is not empty %}
        <span class="rsteward-people">
          {%- for c in region.curators -%}
            <span class="rsteward-person">
              {%- if c.uuid -%}
                <a class="rsteward-chip rsteward-name" href="{{ path('rider_profile', {uuid: c.uuid}) }}">{{ c.name }}</a>
              {%- else -%}
                <span class="rsteward-chip rsteward-name is-anon">{% trans %}regions.steward_unnamed{% endtrans %}</span>
              {%- endif -%}
              {# Their reach, in their own words: this region, or the country. #}
              <span class="rsteward-chip rsteward-reach">{{ c.scope == 'local'
                ? 'regions.reach_region'|trans
                : 'regions.reach_country'|trans }}</span>
            </span>
          {%- endfor -%}
        </span>
      {% endif %}
      {# The sentence that remains is the one about what is MISSING. A region
         with its own curator needs none; every other state ends in the way in,
         pointed at THIS region, not merely at its country. #}
      {% if region.stewardship != 'curated' %}
        <span class="rsteward-d">{{ ('regions.steward_line_' ~ region.stewardship)|trans }}</span>
        <a class="rsteward-cta" href="{{ path('join_country', {cc: region.countryCode}) }}?region={{ region.slug }}">{% trans %}regions.steward_join{% endtrans %}</a>
      {% endif %}
    </span>
  </div>
  <div style="display:flex;gap:.8rem;margin-top:1.8rem;flex-wrap:wrap">
    <a class="btn btn-p" href="{{ path('map') }}?scope=region:{{ region.slug }}">{% trans %}region.cta_map{% endtrans %}</a>
    <a class="btn btn-g" style="border-color:rgba(239,230,212,.4);color:var(--paper)" href="{{ path('join_country', {cc: region.countryCode}) }}?region={{ region.slug }}">{% trans %}region.cta_apply{% endtrans %}</a>
  </div>
</div></div>

{# A short encyclopedic lead, harvested at BUILD time (never fetched live) in
   the reader's locale with an English fallback. Verbatim, with its
   attribution rendered from the SAME stored entry as the text: the extract
   is CC BY-SA 4.0 and the credit line must never drift from what it credits.
   A region without an article simply has no section. #}
{% if region.context %}
  <section class="pad rg-about"><div class="wrap">
    <div class="kicker">{% trans %}region.about_h{% endtrans %}</div>
    <p class="rg-about-text">{{ region.context.text }}</p>
    {# Three credit lines, because three things can be true and only one of
       them at a time. A curator who ADAPTED the article keeps the CC BY-SA
       citation - the licence follows a derivative - but the line must say the
       text was changed, or a reader credits our edit to Wikipedia. A curator
       who WROTE the lead gets no Wikipedia credit at all: claiming a source
       for text that did not come from it is the worse error of the two. #}
    {% if region.context.url %}
      <p class="rg-about-attrib">
        {%- if region.context.adapted %}{% trans %}region.about_source_adapted{% endtrans %}
        {%- else %}{% trans %}region.about_source{% endtrans %}{% endif %}
        <a href="{{ region.context.url }}" rel="noopener noreferrer">{{ region.context.title }}</a>
        · <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener noreferrer">CC BY-SA 4.0</a></p>
    {% elseif region.context.curated %}
      <p class="rg-about-attrib">{% trans %}region.about_source_curator{% endtrans %}</p>
    {% endif %}
  </div></section>
{% endif %}

<section class="pad"><div class="wrap">
  {% if region.byKind is not empty %}
    <div class="kicker">{% trans %}region.by_kind_h{% endtrans %}</div>
    <div class="kinds">
      {# TWO numbers, not one. The first is what somebody has stood at and
         checked; the second is what OpenStreetMap knows is there and the map
         draws underneath. Showing only the first told a rider that Wallonia
         holds 2 water points when the map there draws 1,650. They are not
         summed: "checked" and "known about" are the distinction the whole
         Best of / Confirmed / Everything ladder is built on. #}
      {% for kind in region.byKind %}
        <div class="k">
          <span>{{ kind.labelKey|trans }}</span>
          <span class="c">
            {%- if kind.count > 0 %}<b>{{ kind.count }}</b> {{ 'region.kind_verified'|trans }}{% endif -%}
            {%- if kind.count > 0 and kind.coverage > 0 %} · {% endif -%}
            {%- if kind.coverage > 0 %}<i>{{ kind.coverage }} {{ 'region.kind_coverage'|trans }}</i>{% endif -%}
          </span>
        </div>
      {% endfor %}
    </div>
    {# The two terms are marked up as <code> so the sentence DEFINING them shows
       which words it is defining (owner 2026-08-14). The markup lives in the
       message, not here, because the terms are different words in every locale
       and a template-side replace would have to know all five; `rich` runs it
       through the sanitiser, which allow-lists <code> and nothing that could
       carry script. #}
    <p class="kinds-note">{{ 'region.by_kind_note'|trans|rich }}</p>
  {% else %}
    <div class="kicker">{% trans %}region.empty_h{% endtrans %}</div>
    <p style="max-width:62ch;line-height:1.6">{% trans %}region.empty_p{% endtrans %}</p>
  {% endif %}
  <p style="margin-top:2rem"><a href="{{ path('regions') }}">{% trans %}region.back{% endtrans %}</a></p>
  {# Notice and action, DSA Article 16. The description on this page is written
     text like any other and can be wrong, or about a person
     (docs/specs/content-reports.md §5). #}
  <p class="region-report"><a href="{{ path('content_report', {type: 'region', id: region.id, from: app.request.pathInfo}) }}">{{ 'report.link_page'|trans }}</a></p>
</div></section>
{% endblock %}
