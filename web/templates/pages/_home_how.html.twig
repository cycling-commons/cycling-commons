<!-- ===================== HOW IT WORKS ===================== -->
<section class="pad" style="background:var(--paper-deep)">
  <div class="wrap">
    <div class="kicker rv">{{ 'home.how_kicker'|trans }}</div>
    <h2 class="rv" data-d="1">{{ 'home.how_h2'|trans }}</h2>
    <div class="steps">
      <div class="step rv" data-d="1"><span class="no">{{ 'home.how_step1_no'|trans }}</span><h4>{{ 'home.how_step1_h'|trans }}</h4><p>{{ 'home.how_step1_p'|trans }}</p></div>
      <div class="step rv" data-d="2"><span class="no">{{ 'home.how_step2_no'|trans }}</span><h4>{{ 'home.how_step2_h'|trans }}</h4><p>{{ 'home.how_step2_p'|trans }}</p></div>
      <div class="step rv" data-d="3"><span class="no">{{ 'home.how_step3_no'|trans }}</span><h4>{{ 'home.how_step3_h'|trans }}</h4><p>{{ 'home.how_step3_p'|trans }}</p></div>
    </div>
  </div>
</section>
