<!-- ===================== FRAGMENTATION ===================== -->
<section class="pad">
  <div class="wrap split">
    <div>
      <div class="kicker rv">{{ 'home.frag_kicker'|trans }}</div>
      <h2 class="rv" data-d="1">{{ 'home.frag_h2'|trans }}</h2>
      <p class="lead rv" data-d="2">{{ 'home.frag_lead1'|trans }}</p>
      <p class="lead rv" data-d="2" style="margin-top:1.1rem">{{ 'home.frag_lead2'|trans|rich }}</p>
    </div>
    <div class="silo rv" data-d="2">
      {# REVIEW TOGGLE (owner 2026-09-04): three drafts of this box, side by
         side, so one can be picked. Pure CSS: the radios sit first so the
         `:checked ~` selectors below reach both the chips and the variants.
         Drop the radios, the chips and the two losing variants once chosen. #}
      <input type="radio" name="silo-pick" id="silo-v1" class="silo-pick">
      <input type="radio" name="silo-pick" id="silo-v2" class="silo-pick">
      <input type="radio" name="silo-pick" id="silo-v3" class="silo-pick" checked>
      <div class="silo-sw" aria-label="Draft"><label for="silo-v1">v1 list</label><label for="silo-v2">v2 tiles</label><label for="silo-v3">v3 phone</label></div>

      {# v1: the list #}
      <div class="silo-v silo-v1 panel">
      <h3>{{ 'home.frag_panel_h'|trans }}</h3>
      <div class="rank"><span class="n">→</span><span class="nm">{{ 'home.frag_climbs'|trans|rich }}</span><span class="co">{{ 'home.frag_climbs_tag'|trans }}</span></div>
      <div class="rank"><span class="n">→</span><span class="nm">{{ 'home.frag_rides'|trans|rich }}</span><span class="co">{{ 'home.frag_rides_tag'|trans }}</span></div>
      <div class="rank"><span class="n">→</span><span class="nm">{{ 'home.frag_scenic'|trans }}</span><span class="co">{{ 'home.frag_scenic_tag'|trans }}</span></div>
      <div class="rank"><span class="n">→</span><span class="nm">{{ 'home.frag_stays'|trans }}</span><span class="co">{{ 'home.frag_stays_tag'|trans }}</span></div>
      <div class="rank"><span class="n">→</span><span class="nm">{{ 'home.frag_road'|trans }}</span><span class="co">{{ 'home.frag_road_tag'|trans }}</span></div>
      <div class="rank" style="border:none"><span class="n">→</span><span class="nm">{{ 'home.frag_water'|trans }}</span><span class="co">{{ 'home.frag_water_tag'|trans }}</span></div>
      <div class="vs" style="font-size:1.1rem;text-align:left">{{ 'home.frag_vs'|trans }}</div>
      </div>

      {# v2: the tiles. The letters are the catalog's own (ItemType::letter()),
         so a tile here and a card further down the page carry the same icon. #}
      <div class="silo-v silo-v2 panel">
      <h3>{{ 'home.frag_panel_h'|trans }}</h3>
      <ul class="silo-grid">
        <li class="silo-tile shut" style="--i:0;--rot:-1.3deg;--dx:-10px">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}<span class="silo-nm">{{ 'home.frag_climbs'|trans|rich }}</span><span class="silo-tag">{{ 'home.frag_climbs_tag'|trans }}</span></li>
        <li class="silo-tile shut" style="--i:1;--rot:1.1deg;--dx:12px">{% include 'partials/_type_icon.html.twig' with {letter: 'R'} only %}<span class="silo-nm">{{ 'home.frag_rides'|trans|rich }}</span><span class="silo-tag">{{ 'home.frag_rides_tag'|trans }}</span></li>
        <li class="silo-tile scat" style="--i:2;--rot:1.4deg;--dx:14px">{% include 'partials/_type_icon.html.twig' with {letter: 'P'} only %}<span class="silo-nm">{{ 'home.frag_scenic'|trans }}</span><span class="silo-tag">{{ 'home.frag_scenic_tag'|trans }}</span></li>
        <li class="silo-tile shut" style="--i:3;--rot:-1.1deg;--dx:-12px">{% include 'partials/_type_icon.html.twig' with {letter: 'O'} only %}<span class="silo-nm">{{ 'home.frag_stays'|trans }}</span><span class="silo-tag">{{ 'home.frag_stays_tag'|trans }}</span></li>
        <li class="silo-tile scat" style="--i:4;--rot:-1.5deg;--dx:-8px">{% include 'partials/_type_icon.html.twig' with {letter: 'A'} only %}<span class="silo-nm">{{ 'home.frag_road'|trans }}</span><span class="silo-tag">{{ 'home.frag_road_tag'|trans }}</span></li>
        <li class="silo-tile scat" style="--i:5;--rot:1.2deg;--dx:10px">{% include 'partials/_type_icon.html.twig' with {letter: 'B'} only %}<span class="silo-nm">{{ 'home.frag_water'|trans }}</span><span class="silo-tag">{{ 'home.frag_water_tag'|trans }}</span></li>
      </ul>

      <svg class="silo-funnel" viewBox="0 0 300 46" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path pathLength="1" d="M18 0 C18 22 150 12 150 34"/>
        <path pathLength="1" d="M70 0 C70 24 150 16 150 34"/>
        <path pathLength="1" d="M122 0 C122 26 150 22 150 34"/>
        <path pathLength="1" d="M178 0 C178 26 150 22 150 34"/>
        <path pathLength="1" d="M230 0 C230 24 150 16 150 34"/>
        <path pathLength="1" d="M282 0 C282 22 150 12 150 34"/>
        <path class="out" pathLength="1" d="M150 34 L150 46"/>
      </svg>

      <div class="silo-atlas">{{ 'home.frag_vs'|trans }}</div>
      </div>

      {# v3: the phone. "A dozen apps" taken literally: a home screen where
         every layer is its own app, the closed ones padlocked, the scattered
         ones never really installed. Then they all fly into the one app that
         holds them, and that app grows. hero.js measures the flight paths. #}
      <div class="silo-v silo-v3">
      <h3>{{ 'home.frag_panel_h'|trans }}</h3>
      <div class="phone">
        <div class="ph-notch"></div>
        <ul class="ph-grid">
          <li class="ph-app shut" style="--i:0;--tint:#6b4f9e"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}</span><span class="ph-nm">{{ 'home.frag_climbs'|trans|rich }}</span><span class="ph-tag">{{ 'home.frag_climbs_tag'|trans }}</span></li>
          <li class="ph-app shut" style="--i:1;--tint:#c3402b"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'R'} only %}</span><span class="ph-nm">{{ 'home.frag_rides'|trans|rich }}</span><span class="ph-tag">{{ 'home.frag_rides_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:2;--tint:#2f7fa8"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'P'} only %}</span><span class="ph-nm">{{ 'home.frag_scenic'|trans }}</span><span class="ph-tag">{{ 'home.frag_scenic_tag'|trans }}</span></li>
          <li class="ph-app shut" style="--i:3;--tint:#c98a2e"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'O'} only %}</span><span class="ph-nm">{{ 'home.frag_stays'|trans }}</span><span class="ph-tag">{{ 'home.frag_stays_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:4;--tint:#5a6a72"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'A'} only %}</span><span class="ph-nm">{{ 'home.frag_road'|trans }}</span><span class="ph-tag">{{ 'home.frag_road_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:5;--tint:#2a8f8a"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'B'} only %}</span><span class="ph-nm">{{ 'home.frag_water'|trans }}</span><span class="ph-tag">{{ 'home.frag_water_tag'|trans }}</span></li>
        </ul>
        <div class="ph-dock">
          <img class="ph-cc" src="{{ asset('brand/logo-square-mark.svg') }}" alt="" width="64" height="64">
          <span class="ph-cc-nm">{{ 'home.frag_vs'|trans }}</span>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

