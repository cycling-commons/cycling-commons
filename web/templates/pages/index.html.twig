{# Idea first, then the tool: one tap at a time, Scout is how you do it. #}
{% include 'pages/_home_how.html.twig' %}
{% include 'pages/_home_scout.html.twig' %}

<!-- ===================== CTA ===================== -->
<div class="cta-band">
  <svg class="hero-contours" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="opacity:.3">
    <path d="M-50,300 C260,260 440,330 700,280 C980,230 1200,300 1500,250"/>
    <path d="M-50,220 C240,190 470,260 720,210 C1000,160 1200,220 1500,180"/>
    <path d="M-50,140 C260,120 440,180 700,140 C980,100 1200,150 1500,120"/>
  </svg>
  <div class="wrap" style="position:relative;z-index:2">
    <h2>{{ 'home.cta_band_h2'|trans }}</h2>
    <div class="btn-row">
      <a class="btn btn-primary" href="{{ path('map') }}">{{ 'home.cta_band_map'|trans }} <span class="arw">→</span></a>
      <a class="btn btn-ghost" href="{{ path('map', {panel: 'tools'}) }}">{{ 'home.cta_gpx'|trans }}</a>
      {% if not app.user %}
        <a class="btn btn-ghost" href="{{ path('register') }}">{{ 'home.cta_band_account'|trans }}</a>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
{% block body_scripts %}
{# Landing-page behaviour, as a file so this page needs no CSP nonce
   (docs/specs/page-caching.md §3.2). Deferred: it reads window.CC from
   races.js and expects the document parsed. #}
<script src="{{ asset('home/hero.js') }}" defer></script>
{% endblock %}
