    </div>
  </div>

  <!-- discipline strip — pinned to the bottom of the hero viewport -->
  <div class="disc">
    <div class="wrap">
      <span class="label">{{ 'home.disc_label'|trans }}</span>
      <div class="chips">
        <span class="chip">Road</span><span class="chip">Gravel</span><span class="chip">MTB</span><span class="chip">Handbike</span><span class="chip">Touring</span><span class="chip">Bikepacking</span><span class="chip">Tandem</span><span class="chip">E-bike</span><span class="chip">Urban</span><span class="chip">Recumbent</span><span class="chip">Trike</span>
      </div>
    </div>
  </div>
</header>

<!-- ===================== FRAGMENTATION ===================== -->
<section class="pad">
  <div class="wrap split">
    <div>
      <div class="kicker rv">{{ 'home.frag_kicker'|trans }}</div>
      <h2 class="rv" data-d="1">{{ 'home.frag_h2'|trans }}</h2>
      <p class="lead rv" data-d="2">{{ 'home.frag_lead1'|trans }}</p>
      <p class="lead rv" data-d="2" style="margin-top:1.1rem">{{ 'home.frag_lead2'|trans|rich }}</p>
    </div>
    <div class="silo rv" data-d="2">
      {# v3: the phone. "A dozen apps" taken literally: a home screen where
         every layer is its own app, the closed ones padlocked, the scattered
         ones never really installed. Then they all fly into the one app that
         holds them, and that app grows. hero.js measures the flight paths. #}
      <div class="silo-v3">
      <div class="phone">
        <div class="ph-notch"></div>
        <ul class="ph-grid">
          <li class="ph-app shut" style="--i:0;--tint:#6b4f9e"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}</span><span class="ph-nm">{{ 'home.frag_climbs'|trans|rich }}</span><span class="ph-tag">{{ 'home.frag_climbs_tag'|trans }}</span></li>
          <li class="ph-app shut" style="--i:1;--tint:#c3402b"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'R'} only %}</span><span class="ph-nm">{{ 'home.frag_rides'|trans|rich }}</span><span class="ph-tag">{{ 'home.frag_rides_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:2;--tint:#2f7fa8"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'P'} only %}</span><span class="ph-nm">{{ 'home.frag_scenic'|trans }}</span><span class="ph-tag">{{ 'home.frag_scenic_tag'|trans }}</span></li>
          <li class="ph-app shut" style="--i:3;--tint:#c98a2e"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'O'} only %}</span><span class="ph-nm">{{ 'home.frag_stays'|trans }}</span><span class="ph-tag">{{ 'home.frag_stays_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:4;--tint:#5a6a72"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'A'} only %}</span><span class="ph-nm">{{ 'home.frag_road'|trans }}</span><span class="ph-tag">{{ 'home.frag_road_tag'|trans }}</span></li>
          <li class="ph-app scat" style="--i:5;--tint:#2a8f8a"><span class="ph-ic">{% include 'partials/_type_icon.html.twig' with {letter: 'B'} only %}</span><span class="ph-nm">{{ 'home.frag_water'|trans }}</span><span class="ph-tag">{{ 'home.frag_water_tag'|trans }}</span></li>
        </ul>
        <div class="ph-dock">
          {# The brand mark is cropped INTO its tile rather than redrawn: the
             square's own ground is --ink, the same colour the screen is, so
             oversizing it inside an overflow-hidden tile only makes the pin
             bigger. The asset itself is nobody's to edit from here. #}
          <span class="ph-cc"><img src="{{ asset('brand/logo-square-mark.svg') }}" alt="" width="80" height="80"></span>
          <span class="ph-cc-nm">{{ 'home.frag_atlas'|trans|rich }}</span>
          <button type="button" class="ph-replay" data-silo-replay>{{ 'home.frag_replay'|trans }}</button>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

{# Fragmentation, then voting — principle does not sit between. #}
{% include 'pages/_home_curation.html.twig' %}
{% include 'pages/_home_principle.html.twig' %}

<!-- ===================== CATALOG ===================== -->
