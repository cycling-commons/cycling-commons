      <a class="card rv" data-d="3" href="{{ path('contribute') }}#type-quality-rides">{% include 'partials/_type_icon.html.twig' with {letter: 'R'} only %}<h4>{{ 'home.cat_card_quality_h'|trans }}</h4><p>{{ 'home.cat_card_quality_p'|trans|rich }}</p></a>
      <div class="card suggest rv" data-d="3"><span class="ic">✎</span><h4>{{ 'home.cat_suggest2_h'|trans }}</h4><p>{{ 'home.cat_suggest2_p'|trans }}</p><a href="https://github.com/cycling-commons/cycling-commons/issues/new/choose">{{ 'home.cat_suggest_link'|trans }}</a></div>
    </div>
