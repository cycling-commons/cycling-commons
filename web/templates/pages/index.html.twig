{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/scout-devices.css') }}" />
<link rel="stylesheet" href="{{ asset('styles/page/pages/index.css') }}">
{% endblock %}
{% block body %}
<!-- ===================== HERO ===================== -->
<header class="hero">
  {# The five surface types, in one group so the band can be moved as a band.
     The paths keep their own coordinates: `.s-band` lifts them by exactly
     their own height (owner 2026-09-10), which is what transform-box:fill-box
     makes translateY(-100%) mean. Move a path and the lift follows it. #}
  <svg class="hero-contours" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="s-band">
      <path class="s-road"   d="M-50,820 C260,774 420,826 700,790 C980,754 1180,810 1500,776"/>
      <path class="s-gravel" d="M-50,786 C260,740 420,792 700,756 C980,720 1180,776 1500,742"/>
      <path class="s-path"   d="M-50,752 C260,706 420,758 700,722 C980,686 1180,742 1500,708"/>
      <path class="s-track"  d="M-50,718 C260,672 420,724 700,688 C980,652 1180,708 1500,674"/>
      <path class="s-bridle" d="M-50,684 C260,638 420,690 700,654 C980,618 1180,674 1500,640"/>
    </g>
  </svg>
  <div class="hero-glow"></div>
  <div class="corner br">{{ 'home.corner_br'|trans }}</div>

  <div class="hero-inner">
    <div class="wrap">
    <div class="copy">
      <div class="eyebrow mono rv in">{{ 'home.eyebrow'|trans }}</div>
      <h1 class="rv in" data-d="1">{{ 'home.h1'|trans|rich }}</h1>
      <p class="lede rv in" data-d="2">{{ 'home.lede'|trans }}</p>
      {# The one thing most riders come for, one tap from the front door. #}
      <a class="btn btn-primary hero-gpx rv in" data-d="3" href="{{ path('map', {panel: 'tools'}) }}">{{ 'home.cta_gpx'|trans }} <span class="arw">→</span></a>
    </div>
    {# THE LOOP: five stops, arrows between them. Ride and Add are the big
       ones. Each stop is a kind of person and one verb phrase, nothing more
       (owner 2026-09-08: "only the subtitle, not the follow-up texts"), and
       each links to its page. The ring and arrows are decoration for a
       sighted reader; the stops read as a list to everyone else. #}
    <div class="loop-col">
    <div class="loop rv in" data-d="3">
      <svg viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <linearGradient id="offfade0" gradientUnits="userSpaceOnUse" x1="15.5" y1="32.0" x2="0.5" y2="10.0"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".85"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".25"/></linearGradient>
        <linearGradient id="offfade1" gradientUnits="userSpaceOnUse" x1="15.5" y1="32.0" x2="-11.5" y2="35.0"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".85"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".25"/></linearGradient>
        <linearGradient id="offfade2" gradientUnits="userSpaceOnUse" x1="15.5" y1="32.0" x2="0.5" y2="59.0"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".85"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".25"/></linearGradient>
        <linearGradient id="srcfade0" gradientUnits="userSpaceOnUse" x1="86" y1="-6" x2="76.3" y2="17.3"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".25"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".85"/></linearGradient>
        <linearGradient id="srcfade1" gradientUnits="userSpaceOnUse" x1="100" y1="4" x2="80.5" y2="21.1"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".25"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".85"/></linearGradient>
        <linearGradient id="srcfade2" gradientUnits="userSpaceOnUse" x1="110" y1="18" x2="84.2" y2="25.6"><stop offset="0" stop-color="#EFE6D4" stop-opacity=".25"/><stop offset="1" stop-color="#EFE6D4" stop-opacity=".85"/></linearGradient>
      </defs>
        {# The brand globe inside the lap (owner 2026-09-08: "use the
           earthGlobe.svg file in the brand folder"), the owner's drawing in
           paper on the green. #}
        {% include 'partials/_earth_globe.svg.twig' %}
        <path class="ring" d="M44.0,9.0 L45.2,8.8 L46.3,8.6 L47.5,8.4 L48.7,8.4 L49.9,8.3 L51.1,8.4 L52.3,8.4 L53.5,8.6 L54.6,8.8 L55.8,9.0 L57.0,9.2 L58.2,9.5 L59.3,9.9 L60.5,10.2 L61.6,10.6 L62.7,11.1 L63.8,11.5 L64.9,12.0 L66.0,12.5 L67.1,13.1 L68.1,13.6 L69.1,14.2 L70.1,14.8 L71.1,15.4 L72.0,16.0 L72.9,16.6 L73.8,17.3 L74.8,18.1 L75.7,18.8 L76.6,19.6 L77.5,20.5 L78.4,21.3 L79.3,22.2 L80.2,23.1 L81.1,24.1 L81.9,25.1 L82.7,26.1 L83.5,27.1 L84.3,28.1 L85.0,29.2 L85.7,30.2 L86.4,31.3 L87.0,32.4 L87.6,33.5 L88.1,34.5 L88.6,35.6 L89.0,36.7 L89.4,37.8 L89.7,38.9 L90.0,40.0 L90.2,41.1 L90.4,42.2 L90.5,43.4 L90.6,44.6 L90.6,45.8 L90.6,47.0 L90.5,48.3 L90.4,49.6 L90.3,50.9 L90.1,52.1 L89.9,53.4 L89.6,54.7 L89.4,56.0 L89.0,57.3 L88.7,58.6 L88.3,59.8 L87.9,61.1 L87.5,62.3 L87.1,63.5 L86.6,64.7 L86.1,65.8 L85.6,66.9 L85.1,68.0 L84.6,69.0 L84.0,70.0 L83.4,71.0 L82.8,71.9 L82.2,72.8 L81.5,73.8 L80.8,74.7 L80.0,75.6 L79.3,76.5 L78.5,77.3 L77.7,78.2 L76.8,79.0 L76.0,79.8 L75.1,80.6 L74.2,81.4 L73.2,82.1 L72.3,82.8 L71.3,83.5 L70.3,84.1 L69.3,84.8 L68.3,85.3 L67.3,85.9 L66.3,86.4 L65.2,86.8 L64.1,87.3 L63.1,87.7 L62.0,88.0 L60.9,88.3 L59.7,88.6 L58.6,88.8 L57.3,89.0 L56.1,89.2 L54.8,89.4 L53.5,89.5 L52.1,89.6 L50.8,89.7 L49.4,89.7 L48.0,89.7 L46.6,89.7 L45.2,89.6 L43.9,89.5 L42.5,89.3 L41.1,89.2 L39.8,89.0 L38.4,88.7 L37.1,88.4 L35.9,88.1 L34.6,87.8 L33.4,87.4 L32.2,87.0 L31.1,86.5 L30.0,86.0 L28.9,85.5 L27.9,84.8 L26.8,84.2 L25.7,83.5 L24.7,82.7 L23.6,81.9 L22.6,81.1 L21.6,80.2 L20.6,79.3 L19.6,78.4 L18.6,77.4 L17.6,76.4 L16.7,75.4 L15.8,74.3 L15.0,73.2 L14.2,72.1 L13.4,71.0 L12.7,69.9 L12.0,68.8 L11.4,67.7 L10.8,66.5 L10.2,65.4 L9.8,64.3 L9.4,63.1 L9.0,62.0 L8.7,60.9 L8.4,59.7 L8.2,58.5 L8.1,57.2 L7.9,55.9 L7.9,54.6 L7.8,53.3 L7.8,52.0 L7.8,50.6 L7.9,49.2 L8.1,47.9 L8.2,46.5 L8.4,45.1 L8.7,43.8 L9.0,42.4 L9.3,41.0 L9.6,39.7 L10.1,38.4 L10.5,37.1 L11.0,35.8 L11.5,34.6 L12.1,33.4 L12.7,32.2 L13.3,31.1 L14.0,30.0 L14.7,28.9 L15.6,27.9 L16.5,26.8 L17.4,25.7 L18.4,24.6 L19.5,23.6 L20.6,22.5 L21.8,21.5 L23.0,20.5 L24.3,19.5 L25.6,18.5 L26.9,17.5 L28.2,16.6 L29.6,15.7 L30.9,14.9 L32.3,14.0 L33.7,13.3 L35.0,12.5 L36.4,11.9 L37.7,11.2 L39.0,10.7 L40.3,10.1 L41.6,9.7 L42.8,9.3 Z"/>
        {# one arrow halfway along each stretch between two stops, turned to face the way round #}
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(73.3,16.9) rotate(38)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(86.3,65.4) rotate(114)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(45.3,89.6) rotate(-176)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(8.1,57.3) rotate(-94)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(23.5,20.1) rotate(-38)"/>
        {# REUSING: three fading lines out of the lap to what gets built on the data #}
        <line class="off" x1="15.5" y1="32.0" x2="0.5" y2="10.0" stroke="url(#offfade0)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(2.3,12.6) rotate(-124)"/>
        <circle class="offnode n0" cx="0.5" cy="10.0" r="1.7"/>
        <line class="off" x1="15.5" y1="32.0" x2="-11.5" y2="35.0" stroke="url(#offfade1)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(-8.3,34.6) rotate(174)"/>
        <circle class="offnode n1" cx="-11.5" cy="35.0" r="1.7"/>
        <line class="off" x1="15.5" y1="32.0" x2="0.5" y2="59.0" stroke="url(#offfade2)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(2.1,56.2) rotate(119)"/>
        <circle class="offnode n2" cx="0.5" cy="59.0" r="1.7"/>
        {# and one way back, from the lowest node round the outside to Adding: what
           gets built comes back as new finds (owner 2026-09-09). Wide enough to
           clear the two cards it passes. #}
        <path class="back" d="M0.5,59.0 C-9,118 130,112 91.0,54.5"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(91.0,54.5) rotate(-124)"/>
        {# SOURCES: open data from outside providers, three faint nodes top right,
           each line ending with its arrowhead on the stretch of the lap from
           Riding to Adding: open data joins the loop where riders put in finds. #}
        <line class="off" x1="86.0" y1="-6.0" x2="76.3" y2="17.3" stroke="url(#srcfade0)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(76.3,17.3) rotate(113)"/>
        <circle class="srcnode" cx="86.0" cy="-6.0" r="1.7"/>
        <line class="off" x1="100.0" y1="4.0" x2="80.5" y2="21.1" stroke="url(#srcfade1)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(80.5,21.1) rotate(139)"/>
        <circle class="srcnode" cx="100.0" cy="4.0" r="1.7"/>
        <line class="off" x1="110.0" y1="18.0" x2="84.2" y2="25.6" stroke="url(#srcfade2)"/>
        <polygon class="arrow" points="-1.8,-1.3 1.2,0 -1.8,1.3" transform="translate(84.2,25.6) rotate(163)"/>
        <circle class="srcnode" cx="110.0" cy="18.0" r="1.7"/>
        <text class="srclabel" x="103.5" y="3.0">{{ 'home.way_sources'|trans }}</text>
      </svg>
      <a class="stop big s1" href="{{ path('map') }}"><span class="k">{{ 'home.way_ride_k'|trans }}</span><b>{{ 'home.way_ride_h'|trans }}</b></a>
      <a class="stop big add s2" href="{{ path('contribute') }}"><span class="k">{{ 'home.way_add_k'|trans }}</span><b>{{ 'home.way_add_h'|trans }}</b></a>
      <a class="stop s3" href="{{ path('roles') }}"><span class="k">{{ 'home.way_curate_k'|trans }}</span><b>{{ 'home.way_curate_h'|trans }}</b></a>
      <a class="stop s4" href="{{ path('join') }}"><span class="k">{{ 'home.way_extend_k'|trans }}</span><b>{{ 'home.way_extend_h'|trans }}</b></a>
      <a class="stop s5" href="{{ path('developers_api') }}"><span class="k">{{ 'home.way_build_k'|trans }}</span><b>{{ 'home.way_build_h'|trans }}</b></a>
