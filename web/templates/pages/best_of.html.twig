{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/best_of.css') }}">
{% endblock %}
{# A filtered view is the same page for a search engine: the shared head's
   canonical already names the unfiltered page (pathInfo, no query), and this
   keeps the view itself out of the index while its links still count. #}
{% block head_extra %}
{% if app.request.query.all is not empty %}<meta name="robots" content="noindex, follow">{% endif %}
{% endblock %}
{% block body %}
{# One row, one way, wherever it appears, preview or real result. `podium`
   draws the top three with what the catalogue actually holds about them; the
   rest are one line each. A row with no place is a list that has no ranking
   yet (route-domain.md §8d). #}
{% macro row(r, podium) %}
  {% set href = r.ref
      ? path('map') ~ '?ref=' ~ r.ref|url_encode
      : (r.letter == 'R' ? path('map') ~ '?route=' ~ r.id : path('map') ~ '?item=' ~ r.id) %}
  {# "Rode it" is wrong for a castle. The second number is the same
     confirmation either way; only the verb changes with what the thing is. #}
  {% set verb = r.letter in ['N', 'R'] ? 'best.counts_rode' : (r.letter == 'O' ? 'best.counts_stayed' : 'best.counts_been') %}
  <li class="{{ podium ? 'pod' }}">
    <span class="n">{% if r.place %}{{ r.place }}{% if r.shared %}<abbr class="sh" title="{{ 'best.shared'|trans|e('html_attr') }}">=</abbr>{% endif %}{% else %}·{% endif %}</span>
    {% if podium %}
      {% if r.photo %}
        {% if r.onMap %}<a class="shot" href="{{ href }}">{% else %}<span class="shot">{% endif %}<img src="{{ r.photo.sm }}" alt="" loading="lazy" width="112" height="84">{% if r.onMap %}</a>{% else %}</span>{% endif %}
      {% else %}
        {# Nothing is drawn here that could be taken for a photograph of this
           place: a flat two-tone panel carrying the rank. It holds the shape
           and the weight a picture will have, and its own hue keeps three
           podium cards from reading as one block, but no arrangement of two
           colours claims to be a castle. #}
        {% if r.onMap %}
          <a class="shot shot--none" href="{{ href }}" style="--shot-h:{{ r.hue }}" aria-label="{{ 'best.no_photo'|trans|e('html_attr') }}"><span>{{ r.place }}</span></a>
        {% else %}
          <span class="shot shot--none" style="--shot-h:{{ r.hue }}" aria-hidden="true"><span>{{ r.place }}</span></span>
        {% endif %}
      {% endif %}
    {% endif %}
    <span class="nm">
      {# A place retired mid-round keeps its place and loses its link. #}
      {% if r.onMap %}<a href="{{ href }}">{{ r.name }}</a>{% else %}<span>{{ r.name }} <small class="gone">{{ 'best.gone'|trans }}</small></span>{% endif %}
      {% if r.note %}<em>{{ r.note }}</em>{% endif %}
      {# On the podium the stored fact is a tag, not a body: "castle" is two
         words under a picture. The filler paragraph is what a description
         will occupy, marked as filler so it is never read as one. Further
         down the list there is no room for a body, so filler only stands in
         where the fact itself is missing. A real result has no filler. #}
      {% if r.filler and (podium or not r.note) %}<em class="filler">{{ r.filler }}</em>{% endif %}
      {% if r.handicapped %}<small class="hc">{{ 'best.handicap'|trans }}</small>{% endif %}
      {% if podium and r.photo and r.photo.credit %}
        <small class="cred">{% if r.photo.creditUrl %}<a href="{{ r.photo.creditUrl }}" rel="noopener nofollow">{{ r.photo.credit }}</a>{% else %}{{ r.photo.credit }}{% endif %}{% if r.photo.license %} · {{ r.photo.license }}{% endif %}</small>
      {% endif %}
    </span>
    {# The points of a closed round's ranked list (owner 2026-10-03); a ballot
       still open never reaches this page. #}
    <span class="ct">{% if r.points is defined and r.points is not null %}<b class="pts">{{ (r.points == 1 ? 'vote.point' : 'vote.points')|trans({'%n%': r.points}) }}</b> · {% endif %}{{ verb|trans({'%votes%': r.votes, '%n%': r.rides}) }}</span>
    {# On the winners too (owner 2026-09-13). No vote or voter number is shown
       (owner 2026-10-02); the bar says how close to the winner a row is, and
       first place reading a full bar is what makes the shorter ones mean
       anything. #}
    {% if r.place %}<span class="bar" aria-hidden="true"><i style="width:{{ r.share }}%"></i></span>{% endif %}
  </li>
{% endmacro %}
{% macro round_label(r) %}{{ 'vote.round_label'|trans({'%season%': r.season.labelKey|trans, '%year%': r.yearLabel}) }}{% endmacro %}
{% macro region_links(list) %}{% for r in list %}<a href="{{ path('region_detail', {slug: r.slug}) }}">{{ r.name }}</a>{{ not loop.last ? ' · ' }}{% endfor %}{% endmacro %}
{% import _self as best %}
{# Each chip carries the CURRENT set with itself added or removed, so a link
   does what a checkbox would and the page still needs no script. #}
{% macro toggle(chosen, value) %}{{ (value in chosen ? chosen|filter(v => v != value) : chosen|merge([value]))|join(',') }}{% endmacro %}
{% set q = {season: season ? season.value : null, cc: country, bike: bike|join(','), diff: difficulty|join(','), len: length|join(',')} %}
{# The same dark band every other top-level page opens with (.chero, shared
   in atlas.css), so this one does not read as a different site. #}
<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'best.kicker'|trans({'%year%': shown_round.yearLabel}) }}</div>
  {# The season in the title, in italics, and beside it what is loaded: the
     country (or Everywhere) and the round (owner 2026-10-03). #}
  <div class="htitle">
    <h1 class="disp">{{ ('best.title_' ~ (season ?: current_season).value)|trans|rich }}</h1>
    {# The country with its flag, as on /regions; the year is in the kicker. #}
    <p class="hscope">{% if outline %}<svg class="hout" viewBox="0 0 {{ outline.width }} {{ outline.height }}" role="presentation" focusable="false" aria-hidden="true"><path d="{{ outline.country }}" fill-rule="evenodd"/></svg>{% endif %}{% if flag %}<img src="{{ asset(flag) }}" alt="" width="28" height="21">{% endif %}{{ country and countries[country] is defined ? countries[country] : 'best.everywhere'|trans }}</p>
  </div>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}best.lead{% endtrans %}</p>
</div></div>

<section class="pad"><div class="wrap">
  {# Said once, loudly, and never removed while the numbers are invented. #}
  {% if not live %}<p class="prev">{% trans %}best.preview{% endtrans %}</p>{% endif %}

  {# The filters, and beside them the ballot that is open now. #}
  <div class="best-top">
  <div class="filters">
    <div class="frow">
      <b>{% trans %}best.f_category{% endtrans %}</b>
      {% for c in categories %}
        <a class="{{ c == category ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: c.value})) }}">{{ c.labelKey|trans }}</a>
      {% endfor %}
    </div>
    <div class="frow">
      <b>{% trans %}best.f_season{% endtrans %}</b>
      {# No "Now" chip (owner 2026-10-03): the season riders are in is lit by
         default, and its chip is the bare URL, so one season has one URL.
         With no season chosen each region shows its own current round, which
         south of the equator is another season. #}
      {% for s in seasons %}
        {% set lit = season ? s == season : s == current_season %}
        <a class="{{ lit ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, season: s == current_season ? null : s.value})) }}">{{ ('map.season_' ~ s.value)|trans }}</a>
      {% endfor %}
    </div>
    {# A select, not chips. The country list is every onboarded country and
       grows with each one; nineteen already wrap to three rows of pills and
       there is no version of that which stays readable (owner 2026-09-12).
       A plain GET form, so the page still needs no script and every result is
       still its own URL. #}
    <form class="frow" method="get" action="{{ path('best_of') }}" data-scope>
      {# In the normal form's order (BestOfFilters), so a choice of country
         lands on its one URL without a redirect. #}
      {% if category != categories|first %}<input type="hidden" name="cat" value="{{ category.value }}">{% endif %}
      {% if season %}<input type="hidden" name="season" value="{{ season.value }}">{% endif %}
      {% if bike %}<input type="hidden" name="bike" value="{{ bike|join(',') }}">{% endif %}
      {% if difficulty %}<input type="hidden" name="diff" value="{{ difficulty|join(',') }}">{% endif %}
      {% if length %}<input type="hidden" name="len" value="{{ length|join(',') }}">{% endif %}
      <b><label for="f-cc">{% trans %}best.f_where{% endtrans %}</label></b>
      <select id="f-cc" name="cc" class="sel-chip">
        <option value="">{% trans %}best.everywhere{% endtrans %}</option>
        {% for cc, label in countries %}
          <option value="{{ cc }}"{{ cc == country ? ' selected' : '' }}>{{ label }}</option>
        {% endfor %}
      </select>
      {# Hidden by best-scope.js, which opens the country on pick; kept for a page without script. #}
      <button type="submit" class="chip" data-scope-show>{% trans %}best.show{% endtrans %}</button>
      {# Revealed by best-globe.js: without it the button would open nothing. #}
      <button type="button" class="chip" id="best-globe-toggle" aria-pressed="false" hidden>{% trans %}best.on_globe{% endtrans %}</button>
      <span hidden>{% for cc, label in countries %}<a data-cc="{{ cc }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, cc: cc})) }}">{{ label }}</a>{% endfor %}</span>
    </form>
    {% if category.value == 'quality-rides' %}
      {# Bike type belongs to the VOTE, not the route: the same roads ranked
         by different people, which is the whole reason a handbike rider's
         best is worth asking about separately. One bike at a time: a list
         narrowed by bike is the votes cast on that bike. #}
      <div class="frow">
        <b>{% trans %}best.f_bike{% endtrans %}</b>
        <a class="{{ bike is empty ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, bike: null})) }}">{% trans %}best.any_bike{% endtrans %}</a>
        {% for b in bikes %}
          <a class="{{ b in bike ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, bike: b in bike ? null : b})) }}">{{ b }}</a>
        {% endfor %}
      </div>
      <div class="frow">
        <b>{% trans %}best.f_length{% endtrans %}</b>
        <a class="{{ length is empty ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, len: null})) }}">{% trans %}best.any_length{% endtrans %}</a>
        {% for l in lengths %}
          <a class="{{ l in length ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, len: best.toggle(length, l)|trim})) }}">{{ ('best.len_' ~ l|lower)|trans }}</a>
        {% endfor %}
      </div>
      <div class="frow">
        <b>{% trans %}best.f_effort{% endtrans %}</b>
        <a class="{{ difficulty is empty ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, diff: null})) }}">{% trans %}best.any_effort{% endtrans %}</a>
        {% for d in difficulties %}
          <a class="{{ d in difficulty ? 'on' }}" rel="nofollow" href="{{ best_of_path(q|merge({cat: category.value, diff: best.toggle(difficulty, d)|trim})) }}">{{ d }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  {# The ballot open now, beside the filters (owner 2026-10-03): the title
     already names the season shown, so this says only when voting for the
     next one closes, with the way in (route-domain.md §8c). #}
  {% if rounds %}
    <aside class="season-now">
      <p class="vopen">{% include 'vote/_hemisphere.html.twig' with {hemisphere: rounds.next.hemisphere} only %}{{ 'best.voting_open'|trans({'%next%': best.round_label(rounds.next), '%date%': rounds.next.lastVotingDay|cc_date}) }}</p>
      {% include 'vote/_countdown.html.twig' with {countdown: rounds.countdown, deadline: rounds.next.votingClosesAt, class: 'vcount vcount--light'} only %}
      <a class="vote-cta" href="{{ path('vote', {cat: category.value}) }}">{{ 'best.vote_cta'|trans }}</a>
      {% if rounds.southNote %}<p class="south">{{ 'best.south_note'|trans }}</p>{% endif %}
    </aside>
  {% endif %}
  </div>

  {# The same globe /regions and /coverage use, loaded only when asked for, so
     a reader who never opens it does not carry MapLibre. #}
  <div id="best-globe" class="globe" hidden data-zoom="2.4"
       data-outlines="{{ path('regions_outlines') }}"
       data-maplibre-js="{{ asset('lib/maplibre-gl/6.8.0/maplibre-gl.mjs') }}"
       data-maplibre-css="{{ asset('lib/maplibre-gl/6.8.0/maplibre-gl.css') }}"
       data-style="https://tiles.openfreemap.org/styles/liberty" data-tiles="https://tiles.openfreemap.org/planet"></div>



  {# A country is read region by region: that is the unit a rider rides in,
     and one national list flattens the Alps into Brittany. Everywhere keeps
     the single list, because there the country IS the unit. #}
  {# Live, a country's view always lists its regions: even with no list to
     show, the foot says which regions the filters emptied and which have
     nothing on the map yet. #}
  {% if regions is not null and (regions.ranked is not empty or (live and country is not null)) %}
    {% if regions.ranked is not empty %}
    <div class="regions">
      {% for r in regions.ranked %}
        {% set mine = r.slug in home_regions %}
        <section class="rgroup{{ mine ? ' home' }}" id="r-{{ r.slug }}">
          <h2><a href="{{ path('region_detail', {slug: r.slug}) }}">{{ r.name }}</a>{% if mine %} <small class="home-chip">{{ 'best.your_region'|trans }}</small>{% endif %}
            {%- if r.result and not r.result.ranked %} <small class="nr-chip">{{ 'best.no_ranking'|trans }}</small>{% endif %}</h2>
          {# The title names the round; beside the name, "No ranking yet" for a
             list below the threshold, which has no places, so no podium
             (route-domain.md §8c, §8d). Never how many voted. The way to next
             season's ballot is the button beside the filters, once. #}
          {% if r.result is null or r.result.ranked %}
            {% if r.top|length > 0 %}
              <ol class="rank pod3">{% for item in r.top|slice(0, 3) %}{{ best.row(item, true) }}{% endfor %}</ol>
            {% endif %}
            {% if r.top|length > 3 %}
              <ol class="rank" start="4">{% for item in r.top|slice(3) %}{{ best.row(item, false) }}{% endfor %}</ol>
            {% endif %}
          {% else %}
            <p class="nr">{{ 'best.no_ranking_body'|trans({'%m%': threshold}) }}</p>
            <ol class="rank">{% for item in r.top %}{{ best.row(item, false) }}{% endfor %}</ol>
          {% endif %}
        </section>
      {% endfor %}
    </div>
    {% endif %}
    {% if live and country is null %}<p class="empty">{{ 'best.everywhere_hint'|trans }}</p>{% endif %}

    {# A region whose list the route filters emptied has places and votes:
       it is named apart, never as a region with nothing yet. #}
    {% if live and regions.filtered is not empty %}
      <section class="quiet">
        <p>{% trans %}best.filtered_out{% endtrans %}</p>
        <p class="qlist">{{ best.region_links(regions.filtered) }}</p>
      </section>
    {% endif %}
    {% if regions.quiet is not empty %}
      {# Not hidden: "nobody has voted here yet" is an invitation, and a silent
         omission is not. #}
      {% if live %}
        {# Live, these regions have nothing of the kind on the map, so there is
           nothing to vote for there yet: the way in is the map. #}
        <section class="quiet">
          {# The regions first, then what is missing in them and what to do
             (owner 2026-10-03: "Do you mean Brussels and Flanders?"). #}
          <h2>{% trans %}best.quiet_live_heading{% endtrans %}</h2>
          <p class="qlist">{{ best.region_links(regions.quiet) }}</p>
          <p>{{ 'best.quiet_live'|trans({'%what%': category.labelKey|trans}) }}</p>
          <p><a class="btn btn-p" href="{{ path('map') }}">{% trans %}best.quiet_live_cta{% endtrans %}</a></p>
        </section>
      {% else %}
      <section class="quiet">
        <h2>{% trans %}best.quiet_heading{% endtrans %}</h2>
        <p>{% trans %}best.quiet_body{% endtrans %}</p>
        <p class="qlist">{{ best.region_links(regions.quiet) }}</p>
        <p><a class="btn btn-p" href="{{ path('vote') }}">{% trans %}best.quiet_cta{% endtrans %}</a></p>
      </section>
      {% endif %}
    {% endif %}
  {% elseif live and country is null %}
    <p class="empty">{% trans %}best.everywhere_empty{% endtrans %}</p>
    <p class="empty">{% trans %}best.everywhere_hint{% endtrans %}</p>
  {% elseif ranking is empty %}
    <p class="empty">{% trans %}best.empty{% endtrans %}</p>
  {% else %}
    <ol class="rank pod3">{% for r in ranking|slice(0, 3) %}{{ best.row(r, true) }}{% endfor %}</ol>
    {% if ranking|length > 3 %}
      <ol class="rank" start="4">{% for r in ranking|slice(3) %}{{ best.row(r, false) }}{% endfor %}</ol>
    {% endif %}
  {% endif %}
</div></section>
{% endblock %}
{% block body_scripts %}
<script src="{{ asset('pages/country-globe.js') }}" defer></script>
<script src="{{ asset('pages/best-globe.js') }}" defer></script>
<script src="{{ asset('pages/best-scope.js') }}" defer></script>
<script src="{{ asset('js/countdown.js') }}" defer></script>
{% endblock %}
