{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .kpis{display:flex;gap:2.4rem;flex-wrap:wrap;margin-top:1.6rem}
  .kpis .k b{font-family:var(--serif);font-size:2.2rem;display:block}.kpis .k.t b{color:var(--trail)}
  .kpis .k span{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(239,230,212,.6)}
  table{width:100%;border-collapse:collapse;margin-top:1rem}
  th{text-align:left;font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:#595c4d;padding:.6rem .8rem;border-bottom:1px solid rgba(20,22,14,.15)}
  td{padding:.7rem .8rem;border-bottom:1px solid rgba(20,22,14,.08);font-size:.92rem;vertical-align:middle}
  /* Every mono figure in the table at ONE size. `.mono` sets a family and
     not a size, so these cells inherited the row's .92rem and rendered a
     step above the reference-places number beside them, which had been
     given .72rem inline to escape exactly that (owner, 2026-08-29). */
  td.mono,td .mono{font-size:.72rem}
  td .bar{width:120px}
  .dens{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;color:#7a7d6c;margin-top:.15rem}
  /* The two metric lines style by POSITION, not by metric: whichever line is
     first reads as the sorted-by figure, the other steps back to grey. The
     sort script only reorders DOM nodes and never touches classes. */
  td .mval{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em}
  td .mval + .mval{color:#7a7d6c;margin-top:.15rem}
  .sorttog{margin-left:.4rem;white-space:nowrap}
  /* Links, not buttons, since the order is a URL now (page-caching.md §3.2).
     Same look; text-decoration is the only thing an anchor adds. */
  .sorttog a{font:inherit;text-transform:none;letter-spacing:.04em;text-decoration:none;background:none;border:1px solid rgba(20,22,14,.25);border-radius:3px;padding:.05rem .4rem;cursor:pointer;color:#595c4d}
  .sorttog a.on{background:#595c4d;border-color:#595c4d;color:#efe6d4}
  td .flag{width:1.1rem;height:.8rem;vertical-align:-1px;margin-right:.45rem;border-radius:2px}
  .tnote{font-size:.90rem;color:#4a4d40;max-width:72ch;margin-top:1.4rem;line-height:1.55;padding-left:1.1rem}
  .tnote li{margin:.3rem 0}
  .gaps{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;margin-top:1.6rem}
</style>
{% endblock %}
{% block body %}

<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}coverage.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}coverage.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}coverage.lead{% endtrans %}</p>
  <div class="kpis">
    <div class="k"><b>{{ kpis.coveragePois|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_pois{% endtrans %}</span></div>
    <div class="k t"><b>{{ kpis.items|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_items{% endtrans %}</span></div>
    <div class="k"><b>{{ kpis.routes|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_routes{% endtrans %}</span></div>
    <div class="k"><b>{{ kpis.countries }}</b><span>{% trans %}coverage.kpi_countries{% endtrans %}</span></div>
  </div>
</div></div>

<section class="pad"><div class="wrap">
  <div class="kicker">{% trans %}coverage.table_kicker{% endtrans %}</div>
  <table>
    <tr>
      <th>{% trans %}coverage.th_country{% endtrans %}</th>
      <th>{% trans %}coverage.th_regions{% endtrans %}</th>
      <th aria-sort="descending">{% trans %}coverage.th_pois{% endtrans %}
        {# Two sort keys, one column: density (the default, matches the server
           order) and absolute total. The active metric is also the first line
           in every cell below. #}
        {# Two links, not two buttons. A client-side toggle needs an inline
           script, an inline script needs a CSP nonce, and a nonce is the one
           thing a shared cache cannot hold (docs/specs/page-caching.md §3.2).
           As two URLs both orders are cached, and both work with no
           JavaScript at all. aria-current marks which one you are reading. #}
        <span class="sorttog" id="cc-pois-sort">
          <a href="{{ path('coverage') }}"
             {% if sort == sort_density %}class="on" aria-current="true"{% endif %}>/ {{ cc_area_suffix() }}</a>
          <a href="{{ path('coverage', {sort: sort_total}) }}"
             {% if sort == sort_total %}class="on" aria-current="true"{% endif %}>{% trans %}coverage.sort_total{% endtrans %}</a>
        </span>
      </th>
      <th>{% trans %}coverage.th_items{% endtrans %}</th>
      <th>{% trans %}coverage.th_routes{% endtrans %}</th>
    </tr>
    {% for c in countries %}
    <tr data-code="{{ c.code }}">
      <td><img class="flag" src="{{ asset(c.flag) }}" alt=""> {{ c.name }}</td>
      <td class="mono">{{ c.regions }}</td>
      {# The bar has always meant density and never said so. Without the number
         the column could only claim "Germany is longer than Luxembourg". #}
      <td>
        <div class="bar"><span style="width:{{ c.share }}%"></span></div>
        {# The metric being sorted on reads first: it is styled by position, so
           the order of these two lines is the styling. The script used to move
           them; the server does it now. #}
        {% set _density %}<span class="mval" data-m="density">{{ 'coverage.per_km2'|trans({'%n%': c.poisPerKm2 < 0.01 and c.poisPerKm2 > 0 ? '<0.01' : c.poisPerKm2|cc_per_km2, '%u%': cc_area_suffix()}) }}</span>{% endset %}
        {% set _total %}<span class="mval" data-m="total">{{ c.coveragePois|number_format(0, '.', ',') }}</span>{% endset %}
        {{ (sort == sort_total ? _total ~ _density : _density ~ _total)|raw }}
      </td>
      {# Where the catalog rows came from. This is the column with a real mix:
         the reference layer is OSM top to bottom, but the catalog already holds
         imported partner data beside rider contributions, and a bare total
         hides that entirely. #}
      <td class="mono">
        {{ c.items|number_format(0, '.', ',') }} <span style="color:#595c4d">· {{ 'coverage.items_verified'|trans({'%count%': c.itemsVerified}) }}</span>
        {% if c.sources is not empty %}
          <span class="dens">
            {%- for s in c.sources -%}
              {{ s.count|number_format(0, '.', ',') }} {{ ('coverage.src_' ~ s.key)|trans }}{{ not loop.last ? ' · ' }}
            {%- endfor -%}
          </span>
        {% endif %}
      </td>
      <td class="mono">{{ c.routes }}</td>
    </tr>
    {% else %}
    <tr><td colspan="5">{% trans %}coverage.table_empty{% endtrans %}</td></tr>
    {% endfor %}
  </table>
  {# Below the table, not above it: the numbers are what the reader came for,
     and three paragraphs of vocabulary in front of them is a toll gate. They
     are here for whoever wants to know what a column means. #}
  <ul class="tnote">
    <li>{% trans %}coverage.terms_reference{% endtrans %}</li>
    <li>{{ 'coverage.terms_bars'|trans({'%u%': cc_area_suffix()})|rich }}</li>
    <li>{% trans %}coverage.terms_catalog{% endtrans %}</li>
  </ul>
</div></section>

<section class="pad" style="background:var(--paper-deep)"><div class="wrap">
  <div class="kicker">{% trans %}coverage.gaps_kicker{% endtrans %}</div>
  <div class="gaps">
    {% for gap in thinnest %}
    <div class="card"><b>{{ gap.labelKey|trans }}</b><p style="font-size:.90rem;color:#4a4d40">{{ 'coverage.gap_body'|trans({'%count%': gap.count}) }}</p></div>
    {% endfor %}
  </div>
  <p style="margin-top:1.6rem;font-size:.95rem;color:#4a4d40">{% trans %}coverage.gaps_cta_pre{% endtrans %} <a href="{{ path('contributors') }}">{% trans %}coverage.gaps_cta_link{% endtrans %}</a>{% trans %}coverage.gaps_cta_post{% endtrans %}</p>
</div></section>
{% endblock %}


