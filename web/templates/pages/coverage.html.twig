{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/coverage.css') }}">
{% endblock %}
{% block body %}

<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}coverage.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}coverage.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}coverage.lead{% endtrans %}</p>
  <div class="kpis">
    <div class="k"><b>{{ kpis.coveragePois|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_pois{% endtrans %}</span></div>
    <div class="k t"><b>{{ kpis.items|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_items{% endtrans %}</span></div>
    <div class="k"><b>{{ kpis.routes|number_format(0, '.', ',') }}</b><span>{% trans %}coverage.kpi_routes{% endtrans %}</span></div>
    <div class="k"><b>{{ kpis.countries }}</b><span>{% trans %}coverage.kpi_countries{% endtrans %}</span></div>
  </div>
</div></div>

{# Five steps of one green, pale to spruce, on the paper surface; validated
   light to dark and against the surface (dataviz ordinal check, 2026-09-08).
   The legend and the paint (data-ramp) read this one list. #}
{% set ramp = ['#84AC98', '#63937C', '#46785F', '#2D5A44', '#1C3A2A'] %}
{% set none_fill = 'rgba(20,22,14,0.10)' %}
<section class="pad"><div class="wrap">
  <div class="kicker">{% trans %}coverage.table_kicker{% endtrans %}</div>
  {# The chips are buttons: pressing one swaps the view in place and is not
     a navigation. They start hidden, so a reader with no JavaScript is never
     offered a switch that cannot move; the script that works them is the
     script that unhides them. Globe first, then the table, the same order as
     /regions (owner 2026-09-08). #}
  <nav class="viewrow" id="coverage-viewrow" aria-label="{{ 'coverage.table_kicker'|trans|e('html_attr') }}" hidden>
    <button type="button" class="chip" data-view="globe" aria-pressed="false">{% trans %}coverage.view_globe{% endtrans %}</button>
    <button type="button" class="chip" data-view="table" aria-pressed="true">{% trans %}coverage.view_table{% endtrans %}</button>
    <span class="vhint">{% trans %}coverage.globe_hint{% endtrans %}</span>
  </nav>
  <div id="cov-globe">
  <div class="cglobe">
    <div id="coverage-globe" class="globe loading"
         data-outlines="{{ path('regions_outlines') }}"
         data-maplibre-js="{{ asset('lib/maplibre-gl/6.8.0/maplibre-gl.mjs') }}"
         data-maplibre-css="{{ asset('lib/maplibre-gl/6.8.0/maplibre-gl.css') }}"
         data-style="https://tiles.openfreemap.org/styles/liberty" data-tiles="https://tiles.openfreemap.org/planet"
         data-ramp="{{ ramp|join(',') }}" data-none="{{ none_fill }}"></div>
    {# One card per country, rendered here so every word is Twig's; the
       script shows the one that was clicked. The card holds the same figures
       as the country's table row, so the two views never disagree. #}
    <aside class="ccard-slot" aria-live="polite">
      <p class="ccard-empty" id="ccard-empty">{% trans %}coverage.globe_pick{% endtrans %}</p>
      {% for c in countries %}
      {% set _dens = 'coverage.per_km2'|trans({'%n%': c.poisPerKm2 < 0.01 and c.poisPerKm2 > 0 ? '<0.01' : c.poisPerKm2|cc_per_km2, '%u%': cc_area_suffix()}) %}
      <div class="ccard" id="ccard-{{ c.code }}" data-code="{{ c.code }}" data-cls="{{ density_classes.byCode[c.code]|default(0) }}"
           data-tip="{{ (c.name ~ ' · ' ~ _dens)|e('html_attr') }}" hidden>
        <div class="ch"><img class="flag" src="{{ asset(c.flag) }}" alt=""><b>{{ c.name }}</b></div>
        <dl>
          <dt>{% trans %}coverage.th_regions{% endtrans %}</dt><dd class="mono">{{ c.regions }}</dd>
          <dt>{% trans %}coverage.th_pois{% endtrans %}</dt>
          <dd><span class="mono">{{ _dens }}</span><span class="dens">{{ c.coveragePois|number_format(0, '.', ',') }} {% trans %}coverage.sort_total{% endtrans %}</span></dd>
          <dt>{% trans %}coverage.th_items{% endtrans %}</dt>
          <dd><span class="mono">{{ c.items|number_format(0, '.', ',') }}</span> <span style="color:#595c4d">· {{ 'coverage.items_verified'|trans({'%count%': c.itemsVerified}) }}</span>
            {% if c.sources is not empty %}<span class="dens">
              {%- for s in c.sources -%}
                {{ s.count|number_format(0, '.', ',') }} {{ ('coverage.src_' ~ s.key)|trans }}{{ not loop.last ? ' · ' }}
              {%- endfor -%}
            </span>{% endif %}
          </dd>
          <dt>{% trans %}coverage.th_routes{% endtrans %}</dt><dd class="mono">{{ c.routes }}</dd>
        </dl>
        <a class="more" href="{{ path('regions') }}#country-{{ c.code }}">{% trans %}coverage.globe_regions_link{% endtrans %}</a>
      </div>
      {% endfor %}
    </aside>
  </div>
  <div class="clegend">
    <span class="lh">{{ 'coverage.legend_density'|trans({'%u%': cc_area_suffix()}) }}</span>
    {% for b in density_classes.bounds %}
    <span class="lstep"><i style="background:{{ ramp[loop.index0] }}"></i>{{ 'coverage.legend_range'|trans({'%a%': b.min|cc_per_km2, '%b%': b.max|cc_per_km2}) }}</span>
    {% endfor %}
    <span class="lstep"><i style="background:{{ none_fill }}"></i>{% trans %}coverage.legend_none{% endtrans %}</span>
  </div>
  </div>
  <div id="cov-table">
  <table>
    <tr>
      <th>{% trans %}coverage.th_country{% endtrans %}</th>
      <th>{% trans %}coverage.th_regions{% endtrans %}</th>
      <th aria-sort="descending">{% trans %}coverage.th_pois{% endtrans %}
        {# Two sort keys, one column: density (the default, matches the server
           order) and absolute total. The active metric is also the first line
           in every cell below. #}
        {# Two links, not two buttons. A client-side toggle needs an inline
           script, an inline script needs a CSP nonce, and a nonce is the one
           thing a shared cache cannot hold (docs/specs/page-caching.md §3.2).
           As two URLs both orders are cached, and both work with no
           JavaScript at all. aria-current marks which one you are reading. #}
        <span class="sorttog" id="cc-pois-sort">
          <a href="{{ path('coverage') }}"
             {% if sort == sort_density %}class="on" aria-current="true"{% endif %}>/ {{ cc_area_suffix() }}</a>
          <a href="{{ path('coverage', {sort: sort_total}) }}"
             {% if sort == sort_total %}class="on" aria-current="true"{% endif %}>{% trans %}coverage.sort_total{% endtrans %}</a>
        </span>
      </th>
      <th>{% trans %}coverage.th_items{% endtrans %}</th>
      <th>{% trans %}coverage.th_routes{% endtrans %}</th>
    </tr>
    {% for c in countries %}
    <tr data-code="{{ c.code }}">
      <td><img class="flag" src="{{ asset(c.flag) }}" alt=""> {{ c.name }}</td>
      <td class="mono">{{ c.regions }}</td>
      {# The bar has always meant density and never said so. Without the number
         the column could only claim "Germany is longer than Luxembourg". #}
      {# Two lines (owner 2026-09-08: "put the amount behind the bar so we
         get 1 line"): the bar with the total at its end, and the density
         under it. The metric being sorted on is ink, the other grey. #}
      <td>
        <div class="barrow"><div class="bar"><span style="width:{{ c.share }}%"></span></div>
          <span class="mval{{ sort == sort_total ? ' on' }}" data-m="total">{{ c.coveragePois|number_format(0, '.', ',') }}</span></div>
        <span class="mval{{ sort == sort_density ? ' on' }}" data-m="density">{{ 'coverage.per_km2'|trans({'%n%': c.poisPerKm2 < 0.01 and c.poisPerKm2 > 0 ? '<0.01' : c.poisPerKm2|cc_per_km2, '%u%': cc_area_suffix()}) }}</span>
      </td>
      {# Where the catalog rows came from. This is the column with a real mix:
         the reference layer is OSM top to bottom, but the catalog already holds
         imported partner data beside rider contributions, and a bare total
         hides that entirely. #}
      <td class="mono">
        {{ c.items|number_format(0, '.', ',') }} <span style="color:#595c4d">· {{ 'coverage.items_verified'|trans({'%count%': c.itemsVerified}) }}</span>
        {% if c.sources is not empty %}
          <span class="dens">
            {%- for s in c.sources -%}
              {{ s.count|number_format(0, '.', ',') }} {{ ('coverage.src_' ~ s.key)|trans }}{{ not loop.last ? ' · ' }}
            {%- endfor -%}
          </span>
        {% endif %}
      </td>
      <td class="mono">{{ c.routes }}</td>
    </tr>
    {% else %}
    <tr><td colspan="5">{% trans %}coverage.table_empty{% endtrans %}</td></tr>
    {% endfor %}
  </table>
  {# Below the table, not above it: the numbers are what the reader came for,
     and three paragraphs of vocabulary in front of them is a toll gate. They
     are here for whoever wants to know what a column means. #}
  <ul class="tnote">
    <li>{% trans %}coverage.terms_reference{% endtrans %}</li>
    <li>{{ 'coverage.terms_bars'|trans({'%u%': cc_area_suffix()})|rich }}</li>
    <li>{% trans %}coverage.terms_catalog{% endtrans %}</li>
  </ul>
  </div>
</div></section>

<section class="pad" style="background:var(--paper-deep)"><div class="wrap">
  <div class="kicker">{% trans %}coverage.gaps_kicker{% endtrans %}</div>
  <div class="gaps">
    {% for gap in thinnest %}
    <div class="card"><b>{{ gap.labelKey|trans }}</b><p style="font-size:.90rem;color:#4a4d40">{{ 'coverage.gap_body'|trans({'%count%': gap.count}) }}</p></div>
    {% endfor %}
  </div>
  <p style="margin-top:1.6rem;font-size:.95rem;color:#4a4d40">{% trans %}coverage.gaps_cta_pre{% endtrans %} <a href="{{ path('contributors') }}">{% trans %}coverage.gaps_cta_link{% endtrans %}</a>{% trans %}coverage.gaps_cta_post{% endtrans %}</p>
</div></section>
{% endblock %}
{% block head_extra %}
{# Picks the opening view before paint by setting a class on <html>. A file,
   not inline, so the page needs no CSP nonce. #}
<script src="{{ asset('pages/coverage-view.js') }}"></script>
{% endblock %}
{% block body_scripts %}
{# Files, not inline, so the page needs no CSP nonce (page-caching.md §3.2).
   MapLibre itself is fetched by coverage-globe.js only once the globe is on
   screen, so a phone that stays on the table never pays for it. #}
<script src="{{ asset('pages/country-globe.js') }}" defer></script>
<script src="{{ asset('pages/coverage-globe.js') }}" defer></script>
{% endblock %}


