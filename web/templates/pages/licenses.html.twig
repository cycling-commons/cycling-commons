{# SPDX-License-Identifier: AGPL-3.0-only #}
{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/licenses.css') }}">
{% endblock %}
{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}licenses.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}licenses.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'licenses.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="lic">
    <div class="card">
      <h3>{% trans %}licenses.data_h{% endtrans %}</h3>
      <div class="sub">{% trans %}licenses.data_sub{% endtrans %}</div>
      <div class="tldr">{% trans %}licenses.data_tldr{% endtrans %}</div>
      <h5>{% trans %}licenses.can_h{% endtrans %}</h5>
      <ul class="can">
        <li><span class="m">✓</span> {% trans %}licenses.data_can1{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.data_can2{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.data_can3{% endtrans %}</li>
      </ul>
      <h5>{% trans %}licenses.must_h{% endtrans %}</h5>
      <ul class="must">
        {# The upstream list is not OSM alone — imported partner datasets (the
           Walloon PIVOT accommodation registry today, more later) carry their
           own attribution requirement, and naming only OSM here would tell a
           reuser they had discharged an obligation they had not. The credits
           page is the live list, so this points there rather than trying to
           stay in sync with it. #}
        <li><span class="m">⚑</span> <b>{% trans %}licenses.data_must1_b{% endtrans %}</b>
          {{ 'licenses.data_must1_body'|trans({'%url%': path('credits')})|rich }}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.data_must2_b{% endtrans %}</b> {% trans %}licenses.data_must2_body{% endtrans %}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.data_must3_b{% endtrans %}</b> {% trans %}licenses.data_must3_body{% endtrans %}</li>
      </ul>
    </div>

    <div class="card">
      <h3>{% trans %}licenses.media_h{% endtrans %}</h3>
      <div class="sub">{% trans %}licenses.media_sub{% endtrans %}</div>
      <div class="tldr">{% trans %}licenses.media_tldr{% endtrans %}</div>
      <h5>{% trans %}licenses.can_h{% endtrans %}</h5>
      <ul class="can">
        <li><span class="m">✓</span> {% trans %}licenses.media_can1{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.media_can2{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.media_can3{% endtrans %}</li>
      </ul>
      <h5>{% trans %}licenses.must_h{% endtrans %}</h5>
      <ul class="must">
        <li><span class="m">⚑</span> <b>{% trans %}licenses.media_must1_b{% endtrans %}</b> {% trans %}licenses.media_must1_body{% endtrans %}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.media_must2_b{% endtrans %}</b> {% trans %}licenses.media_must2_body{% endtrans %}</li>
      </ul>
    </div>

    <div class="card">
      <h3>{% trans %}licenses.ui_h{% endtrans %}</h3>
      <div class="sub">{% trans %}licenses.ui_sub{% endtrans %}</div>
      <div class="tldr">{% trans %}licenses.ui_tldr{% endtrans %}</div>
      <h5>{% trans %}licenses.can_h{% endtrans %}</h5>
      <ul class="can">
        <li><span class="m">✓</span> {% trans %}licenses.ui_can1{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.ui_can2{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.ui_can3{% endtrans %}</li>
      </ul>
      <h5>{% trans %}licenses.must_h{% endtrans %}</h5>
      <ul class="must">
        <li><span class="m">⚑</span> <b>{% trans %}licenses.ui_must1_b{% endtrans %}</b> {% trans %}licenses.ui_must1_body{% endtrans %}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.ui_must2_b{% endtrans %}</b> {% trans %}licenses.ui_must2_body{% endtrans %}</li>
      </ul>
    </div>

    <div class="card">
      <h3>{% trans %}licenses.code_h{% endtrans %}</h3>
      <div class="sub">{% trans %}licenses.code_sub{% endtrans %}</div>
      <div class="tldr">{% trans %}licenses.code_tldr{% endtrans %}</div>
      <h5>{% trans %}licenses.can_h{% endtrans %}</h5>
      <ul class="can">
        <li><span class="m">✓</span> {% trans %}licenses.code_can1{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.code_can2{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.code_can3{% endtrans %}</li>
      </ul>
      <h5>{% trans %}licenses.must_h{% endtrans %}</h5>
      <ul class="must">
        <li><span class="m">⚑</span> <b>{% trans %}licenses.code_must1_b{% endtrans %}</b> {% trans %}licenses.code_must1_body{% endtrans %}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.code_must2_b{% endtrans %}</b> {% trans %}licenses.code_must2_body{% endtrans %}</li>
      </ul>
    </div>

    {# LAST on purpose: every card above this one grants something. This one
       withholds, and a reader who stops early should have read the grants
       first. AGPL v3 §7(e) is what lets a free-software project keep its
       mark. #}
    <div class="card">
      <h3>{% trans %}licenses.brand_h{% endtrans %}</h3>
      <div class="sub">{% trans %}licenses.brand_sub{% endtrans %}</div>
      <div class="tldr">{% trans %}licenses.brand_tldr{% endtrans %}</div>
      <h5>{% trans %}licenses.can_h{% endtrans %}</h5>
      <ul class="can">
        <li><span class="m">✓</span> {% trans %}licenses.brand_can1{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.brand_can2{% endtrans %}</li>
        <li><span class="m">✓</span> {% trans %}licenses.brand_can3{% endtrans %}</li>
      </ul>
      <h5>{% trans %}licenses.must_h{% endtrans %}</h5>
      <ul class="must">
        <li><span class="m">⚑</span> <b>{% trans %}licenses.brand_must1_b{% endtrans %}</b> {% trans %}licenses.brand_must1_body{% endtrans %}</li>
        <li><span class="m">⚑</span> <b>{% trans %}licenses.brand_must2_b{% endtrans %}</b> {% trans %}licenses.brand_must2_body{% endtrans %}</li>
      </ul>
    </div>
  </div>

  <h5 style="font-family:var(--mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--clay);margin-top:2.2rem">{% trans %}licenses.attribution_h{% endtrans %}</h5>
  <div class="snippet">{% trans %}licenses.attribution_line1{% endtrans %} <span class="s">{% trans %}licenses.attribution_cc{% endtrans %}</span> {% trans %}licenses.attribution_line2{% endtrans %}<br/>{% trans %}licenses.attribution_line3{% endtrans %} <span class="s">{% trans %}licenses.attribution_osm{% endtrans %}</span> {% trans %}licenses.attribution_line4{% endtrans %}<br/>{% trans %}licenses.attribution_line5{% endtrans %}<br/>{% trans %}licenses.attribution_line6{% endtrans %}</div>

  <div class="disc"><b>{% trans %}licenses.disc_bold{% endtrans %}</b> {% trans %}licenses.disc_body_pre{% endtrans %}
    <a href="https://opendatacommons.org/licenses/odbl/1-0/">{% trans %}licenses.disc_odbl{% endtrans %}</a> /
    <a href="https://creativecommons.org/licenses/by-sa/4.0/legalcode">{% trans %}licenses.disc_ccbysa{% endtrans %}</a> /
    <a href="https://www.gnu.org/licenses/agpl-3.0.html">{% trans %}licenses.disc_agpl{% endtrans %}</a> {% trans %}licenses.disc_body_mid{% endtrans %}
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/licenses/COMMONS-DATA-LICENSE.md">{% trans %}licenses.disc_data{% endtrans %}</a> ·
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/licenses/COMMONS-MEDIA-LICENSE.md">{% trans %}licenses.disc_media{% endtrans %}</a> ·
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/licenses/COMMONS-TRANSLATIONS-LICENSE.md">{% trans %}licenses.disc_translations{% endtrans %}</a> ·
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/LICENSE">{% trans %}licenses.disc_code{% endtrans %}</a> ·
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/licenses/COMMONS-TERMS-CLAUSE.md">{% trans %}licenses.disc_terms{% endtrans %}</a> ·
    <a href="https://github.com/cycling-commons/cycling-commons/blob/main/TRADEMARK.md">{% trans %}licenses.disc_brand{% endtrans %}</a>{% trans %}licenses.disc_post{% endtrans %}</div>
</div></section>
{% endblock %}
