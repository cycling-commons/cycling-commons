{#
  The map key (docs/specs/map-and-search.md §4.7).

  One page that explains every mark the map draws. Two rules shaped it.

  **Only THE icon set.** Every category mark comes from ItemType::iconSet()
  via cc_type_icons(), the same set the map's pins and layer list use. The
  colours are the catalog.js layer colours; if a colour changes there it must
  change here in the same commit (both carry the same spec reference).

  **A planned mark never looks live.** Marks that are designed but not drawn
  yet (the provider tier) stay on the page so the design is public, but each
  carries the planned tag and the section says plainly that the map does not
  draw them yet.

  **Kinds come from the registry.** The pin grammar
  (docs/specs/data-provider-hierarchy.md §6.3): kind lives in the glyph, state
  is two shared badges, everything else is drawer content. The kinds section
  is generated from KindIcons::set() through cc_kind_icons(), the same paths
  the map mints its tile icons from, so it cannot drift.
#}
{% extends 'base.html.twig' %}

{# The one category-colour table on the website, mirroring catalog.js. #}
{% set mkc = {
  'A': '#4E8C84', 'B': '#8FB6A8', 'C': '#4E6E8C', 'D': '#6b6f5e',
  'E': '#C8923A', 'F': '#3E7D8C', 'G': '#9A8FB6', 'N': '#6A2C8F',
  'O': '#B5532E', 'P': '#2C5440', 'Q': '#6E5849', 'R': '#FF5A1F',
} %}
{# Light fills whose glyph flattens dark instead of white (txtOn in util.js). #}
{% set mklt = ['B', 'E', 'G'] %}

{% macro glyph(letter, size) %}
{%- set ic = cc_type_icons()[letter] ?? null -%}
{%- if ic and ic.svg -%}
<span class="drawn"><svg viewBox="0 0 24 24" width="{{ size|default(15) }}" height="{{ size|default(15) }}" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="{{ ic.svg }}"/></svg></span>
{%- elseif ic -%}
<span class="g">{{ ic.glyph }}</span>
{%- endif -%}
{% endmacro %}

{% import _self as mk %}
{# A letter-B pin draws its kind glyph (KindIcons), as pinEl does on the map. #}
{% set bTap %}<span class="drawn">{% include 'partials/_kind_icon.html.twig' with {letter: 'B', kind: 'tap', size: 16} %}</span>{% endset %}

{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/pins.css') }}">
<link rel="stylesheet" href="{{ asset('styles/page/pages/map_key.css') }}">
{% endblock %}

{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'legend.kicker'|trans }}</div>
  <h1 class="disp">{{ 'legend.title'|trans }}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'legend.lead'|trans }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="mkwrap">

  <div class="mk-axes">
    <div class="mk-axis"><b>{{ 'legend.axis_shape_h'|trans }}</b><span>{{ 'legend.axis_shape_t'|trans }}</span></div>
    <div class="mk-axis"><b>{{ 'legend.axis_fill_h'|trans }}</b><span>{{ 'legend.axis_fill_t'|trans }}</span></div>
    <div class="mk-axis"><b>{{ 'legend.axis_border_h'|trans }}</b><span>{{ 'legend.axis_border_t'|trans }}</span></div>
    <div class="mk-axis"><b>{{ 'legend.axis_badge_h'|trans }}</b><span>{{ 'legend.axis_badge_t'|trans }}</span></div>
  </div>

  <h2>{{ 'legend.tiers_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.tiers_note'|trans }}</p>
  <div class="mk-rows">
    {# Each border with and without the badge: the whole grid is on the key. #}
    <div class="mk-row mk-pair">
      <div class="mk-sw"><span class="cc-pin disc q lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span><span class="cc-pin disc lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span></div>
      <div class="mk-t"><strong>{{ 'legend.tier_baseline_h'|trans }}</strong><span>{{ 'legend.tier_baseline_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row mk-pair">
      <div class="mk-sw"><span class="cc-pin dashed q lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span><span class="cc-pin dashed lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span></div>
      <div class="mk-t"><strong>{{ 'legend.tier_external_h'|trans }}</strong><span>{{ 'legend.tier_external_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row mk-pair">
      <div class="mk-sw"><span class="cc-pin q lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span><span class="cc-pin lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span></div>
      <div class="mk-t"><strong>{{ 'legend.tier_ours_h'|trans }}</strong><span>{{ 'legend.tier_ours_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-q" aria-hidden="true">?</span></div>
      <div class="mk-t"><strong>{{ 'legend.tier_unconfirmed_h'|trans }}</strong><span>{{ 'legend.tier_unconfirmed_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
  </div>

  <h2>{{ 'legend.kinds_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.kinds_note'|trans }}</p>
  {% for kLetter, kinds in cc_kind_icons() %}
  <p class="mk-grp">{{ ('item_type.' ~ {'B':'water-food','D':'bike-services'}[kLetter] ~ '.label')|trans }}</p>
  <div class="mk-rows">
    {% for kind, kd in kinds %}
    <div class="mk-row mk-kind" data-kind="{{ kLetter }}:{{ kind }}">
      <div class="mk-sw mk-kind-sw" aria-hidden="true">{% if kd.paths is defined %}{% include 'partials/_kind_icon.html.twig' with {letter: kLetter, kind: kind, size: 28, color: mkc[kLetter], ink: kLetter in mklt ? '#14160e' : '#fff'} %}{% else %}<span class="mk-disc{{ kLetter in mklt ? ' lt' }}" style="--c:{{ mkc[kLetter] }}"><span class="g">{{ kd.glyph }}</span></span>{% endif %}</div>
      <div class="mk-t"><strong>{{ ('legend.kind_' ~ kLetter|lower ~ '_' ~ kind ~ '_h')|trans }}</strong><span>{{ ('legend.kind_' ~ kLetter|lower ~ '_' ~ kind ~ '_t')|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <h2>{{ 'legend.basemap_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.basemap_note'|trans }}</p>
  <div class="mk-rows">
    {% for bId, bd in cc_basemap_icons() %}
    <div class="mk-row mk-basemap" data-basemap="{{ bId }}">
      <div class="mk-sw" aria-hidden="true">{% include 'partials/_basemap_icon.html.twig' with {id: bId, size: 28} %}</div>
      <div class="mk-t"><strong>{{ ('legend.basemap_' ~ bId ~ '_h')|trans }}</strong><span>{{ ('legend.basemap_' ~ bId ~ '_t')|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    {% endfor %}
  </div>

  <h2>{{ 'legend.state_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.state_note'|trans }}</p>
  <div class="mk-rows">
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-pin stale lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}</span></div>
      <div class="mk-t"><strong>{{ 'legend.state_stale_h'|trans }}</strong><span>{{ 'legend.state_stale_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-pin pending" style="--c:{{ mkc.C }}" aria-hidden="true">{{ mk.glyph('C') }}</span></div>
      <div class="mk-t"><strong>{{ 'legend.state_pending_h'|trans }}</strong><span>{{ 'legend.state_pending_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="mk-cluster" style="--c:{{ mkc.N }}" aria-hidden="true">24</span></div>
      <div class="mk-t"><strong>{{ 'legend.state_cluster_h'|trans }}</strong><span>{{ 'legend.state_cluster_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="mk-ring" aria-hidden="true"></span></div>
      <div class="mk-t"><strong>{{ 'legend.state_look_h'|trans }}</strong><span>{{ 'legend.state_look_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-pin" style="--c:#05CB63" aria-hidden="true"><span class="g">📷</span></span></div>
      <div class="mk-t"><strong>{{ 'legend.state_camera_h'|trans }}</strong><span>{{ 'legend.state_camera_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
  </div>

  <h2>{{ 'legend.fact_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.fact_note'|trans }}</p>
  <div class="mk-rows">
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-pin lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}<b class="cc-st warn">!</b></span></div>
      <div class="mk-t"><strong>{{ 'legend.fact_broken_h'|trans }}</strong><span>{{ 'legend.fact_broken_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
    <div class="mk-row">
      <div class="mk-sw"><span class="cc-pin lt" style="--c:{{ mkc.B }}" aria-hidden="true">{{ bTap }}<b class="cc-st hours"><svg viewBox="0 0 24 24" width="9" height="9" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="3"/><path d="M12 7v5.5l3.5 2.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></b></span></div>
      <div class="mk-t"><strong>{{ 'legend.fact_hours_h'|trans }}</strong><span>{{ 'legend.fact_hours_t'|trans }}</span></div>
      <span class="mk-tag">{{ 'legend.tag_live'|trans }}</span>
    </div>
  </div>

  <h2>{{ 'legend.cats_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.cats_note'|trans }}</p>
  <p class="mk-grp">{{ 'legend.cats_practical'|trans }}</p>
  <div class="mk-cats">
    {% for letter, key in {'B':'water-food','C':'public-toilets','D':'bike-services','E':'hazards','F':'getting-there','G':'shelter'} %}
    <div class="mk-cat"><span class="mk-tile{{ letter in mklt ? ' lt' }}" style="--c:{{ mkc[letter] }}" aria-hidden="true">{{ mk.glyph(letter, 16) }}</span><div><b>{{ ('item_type.' ~ key ~ '.label')|trans }}</b><i>{{ letter }} · {{ mkc[letter] }}</i></div></div>
    {% endfor %}
  </div>
  <p class="mk-grp">{{ 'legend.cats_voted'|trans }}</p>
  <div class="mk-cats">
    {% for letter, key in {'N':'climbs','O':'where-to-sleep','P':'scenic-views','Q':'history-culture','R':'quality-rides'} %}
    <div class="mk-cat"><span class="mk-tile{{ letter in mklt ? ' lt' }}" style="--c:{{ mkc[letter] }}" aria-hidden="true">{{ mk.glyph(letter, 16) }}</span><div><b>{{ ('item_type.' ~ key ~ '.label')|trans }}</b><i>{{ letter }} · {{ mkc[letter] }}</i></div></div>
    {% endfor %}
  </div>
  <p class="mk-grp">{{ 'legend.cats_overlays'|trans }}</p>
  <div class="mk-cats">
    <div class="mk-cat"><span class="mk-tile lt" style="--c:#C8923A" aria-hidden="true"><span class="g">▰</span></span><div><b>{{ 'legend.overlay_surface_h'|trans }}</b><i>{{ 'legend.overlay_switch'|trans }}</i></div></div>
    <div class="mk-cat"><span class="mk-tile" style="--c:#7A4FCF" aria-hidden="true"><span class="g">⤳</span></span><div><b>{{ 'legend.overlay_routes_h'|trans }}</b><i>{{ 'legend.overlay_switch'|trans }}</i></div></div>
  </div>
  <p class="mk-note" style="margin-top:.9rem">{{ 'legend.overlay_note'|trans }}</p>

  <h2>{{ 'legend.lines_h'|trans }}</h2>
  <p class="mk-note">{{ 'legend.lines_note'|trans }}</p>
  <p class="mk-grp">{{ 'legend.lines_surfaces'|trans }}</p>
  {% set mksc = cc_surface_colours() %}
  <div class="mk-rows">
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:{{ mksc.paved }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_paved'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:{{ mksc.gravel }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_gravel'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:{{ mksc.pave }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_cobbles'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:{{ mksc.dirt }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_dirt'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:{{ mksc.rock }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_rock'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line dash" style="border-top-color:{{ mksc.unverified }}" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_unverified'|trans }}</strong><span>{{ 'legend.line_unverified_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-ticks" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'legend.line_ticks_h'|trans }}</strong><span>{{ 'legend.line_ticks_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
  </div>
  <p class="mk-grp">{{ 'legend.lines_climbs'|trans }}</p>
  <div class="mk-rows">
    <div class="mk-row"><div class="mk-sw"><span class="mk-grad" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'legend.line_climb_up_h'|trans }}</strong><span>{{ 'legend.line_climb_up_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-grad down" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'legend.line_climb_down_h'|trans }}</strong><span>{{ 'legend.line_climb_down_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-chip summit" aria-hidden="true">{{ 'map.d_climb_finish'|trans }}</span></div><div class="mk-t"><strong>{{ 'legend.line_summit_h'|trans }}</strong><span>{{ 'legend.line_summit_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-chip steep" aria-hidden="true">12%</span></div><div class="mk-t"><strong>{{ 'legend.line_steep_h'|trans }}</strong><span>{{ 'legend.line_steep_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-chip rider" aria-hidden="true">14%</span></div><div class="mk-t"><strong>{{ 'legend.line_rider_h'|trans }}</strong><span>{{ 'legend.line_rider_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
  </div>
  <p class="mk-grp">{{ 'legend.lines_routes'|trans }}</p>
  <div class="mk-rows">
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:#FD986E" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'legend.line_route_rest_h'|trans }}</strong><span>{{ 'legend.line_route_rest_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:#FF5A1F;border-top-width:6px" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'legend.line_route_sel_h'|trans }}</strong><span>{{ 'legend.line_route_sel_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:#C84E64" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_route_national'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:#7A4FCF" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_route_regional'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-line" style="border-top-color:#8A5A32" aria-hidden="true"></span></div><div class="mk-t"><strong>{{ 'map.legend_route_mtb'|trans }}</strong></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
    <div class="mk-row"><div class="mk-sw"><span class="mk-knoop" aria-hidden="true">42</span></div><div class="mk-t"><strong>{{ 'legend.line_knoop_h'|trans }}</strong><span>{{ 'legend.line_knoop_t'|trans }}</span></div><span class="mk-tag">{{ 'legend.tag_live'|trans }}</span></div>
  </div>

  <a class="mk-back" href="{{ path('map') }}">{{ 'legend.back_to_map'|trans }}</a>
  </div>
</div></section>
{% endblock %}
