<!-- ===================== CURATION ===================== -->
<section class="pad" id="curation" style="background:var(--paper-deep)">
  <div class="wrap split">
    <div>
      <div class="kicker rv">{{ 'home.cur_kicker'|trans }}</div>
      <h2 class="rv" data-d="1">{{ 'home.cur_h2'|trans }}</h2>
      <p class="lead rv" data-d="2">{{ 'home.cur_lead'|trans }}</p>
      {# What riders vote on: the five votable kinds, drawn icons from THE
         icon set with their catalogue labels (owner 2026-09-09: "add icons
         for what is voteable"). The list mirrors ItemType::isVotable(). #}
      <div class="votable rv" data-d="3">
        <span class="vk">{{ 'home.cur_votable_k'|trans }}</span>
        <ul>
          {% for t in [{l: 'N', k: 'climbs'}, {l: 'R', k: 'quality-rides'}, {l: 'P', k: 'scenic-views'}, {l: 'Q', k: 'history-culture'}, {l: 'O', k: 'where-to-sleep'}] %}
            <li>{% include 'partials/_type_icon.html.twig' with {letter: t.l} only %}<span>{{ ('item_type.' ~ t.k ~ '.label')|trans }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# The best-of card, on the phone frame the fragmentation box uses at the
       top of the page (owner 2026-09-10, picked from three drafts).

       The climbs are DRAWN, not described: a climb is a shape, and
       "180 m · 9.0%" is a shape nobody can see. Every profile is the climb's
       measured one (the item's 25 m gradients, `lineGrad`, from Copernicus
       GLO-30, one point per 100 m) and its numbers are the item's length,
       gain, average and 250 m maximum. Saint-Roch has no row yet: it was
       measured the same way (Rue Saint-Roch from the Ourthe, the elevation
       service's /height every 25 m): 1.23 km, 125 m, 10.1%, 16% max.
       The four rows share one scale, 2.67 km across and 232 m tall (Thier
       Antoine's size), so a longer climb really is drawn wider, a taller one
       taller and a steeper one steeper, comparable to each other rather than
       each to itself. The winner is drawn on its own, at size; its lit
       stretch is the steepest 250 m. #}
    <div class="cur rv" data-d="2">
      {# The winning climb is drawn at size; the other four are one ridge each.

         Before the ranking, a map tour (owner 2026-09-26): Wallonia with the
         five climbs as pins at their real positions, the view glides pin to
         pin while stars count up, then zooms out and each pin flies into its
         row, landing on the climb icon before its number. The stars are illustrative (the seasonal vote is not built yet);
         the counts only have to agree with the order below. The map is
         decorative and aria-hidden: the list is the content, in the DOM from
         the start. hero.js measures the flights (--tx/--ty per pin). #}
      <div class="cur-v3">
        <div class="phone">
          <div class="ph-notch"></div>
          <div class="cur-screen">
            <span class="pin">{{ 'home.cur_panel_pin'|trans|rich }}</span>
            <div class="cur-board">
            <div class="cur-map" aria-hidden="true">
              <div class="cur-cam">
                <div class="cur-draw">
                  {% include 'pages/_home_wallonia.svg.twig' %}
                  {# Positions in percent of the drawing, from the same projection. #}
                  {% for t in [
                    {k: 'liege', x: 76.48, y: 13.67}, {k: 'namur', x: 56.72, y: 26.60},
                    {k: 'charleroi', x: 44.74, y: 30.95}, {k: 'mons', x: 30.91, y: 27.62},
                    {k: 'arlon', x: 83.91, y: 85.31}
                  ] %}
                  <span class="ct" style="left:{{ t.x }}%;top:{{ t.y }}%"><i></i><span>{{ ('home.cur_town_' ~ t.k)|trans }}</span></span>
                  {% endfor %}
                </div>
                {# In tour order: west to east, then south to Houffalize. `to` is the rank the pin flies
                   to, `s` the second the view arrives, `v` its stars. Thier
                   Antoine and Stockeu are 3.6 km apart, so their counts sit
                   on the outer sides. #}
                {% for c in [
                  {to: 3, x: 67.27, y: 22.86, s: '3.8s', v: 317, side: ''},
                  {to: 1, x: 79.92, y: 24.22, s: '5.0s', v: 486, side: ''},
                  {to: 2, x: 85.14, y: 31.70, s: '6.1s', v: 402, side: ' l'},
                  {to: 5, x: 86.56, y: 31.63, s: '6.9s', v: 221, side: ' r'},
                  {to: 4, x: 82.78, y: 51.43, s: '8.1s', v: 268, side: ''}
                ] %}
                <span class="cp{{ c.side }}" data-to="{{ c.to }}" style="left:{{ c.x }}%;top:{{ c.y }}%;--k:{{ loop.index0 }};--r:{{ c.to - 1 }};--s:{{ c.s }};--v:{{ c.v }}">
                  <span class="cp-m">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}</span>
                  <span class="cp-st"><i style="--j:0;--sx:-11px">★</i><i style="--j:1;--sx:1px">★</i><i style="--j:2;--sx:12px">★</i></span>
                  <span class="cp-ct"></span>
                </span>
                {% endfor %}
              </div>
            </div>
            <div class="cur-hero">
              <svg class="cur-big" viewBox="0 0 100 52" preserveAspectRatio="none" aria-hidden="true">
                <clipPath id="cpbig"><rect x="48.1" y="0" width="13.6" height="52"/></clipPath>
                <path class="fil" d="M0,52 L4.9,50 L9.9,47.7 L14.8,45.3 L19.8,42.6 L24.7,40.3 L29.6,38.3 L34.6,36.1 L39.5,33.5 L44.4,30.8 L49.4,27.6 L54.3,23.8 L59.3,20.2 L64.2,17.2 L69.1,14.2 L74.1,10.5 L79,7.6 L84,5.7 L88.9,4.4 L93.8,2.6 L98.8,0.9 L100,0.5 L100,52 Z"/>
                <path class="ramp" d="M0,52 L4.9,50 L9.9,47.7 L14.8,45.3 L19.8,42.6 L24.7,40.3 L29.6,38.3 L34.6,36.1 L39.5,33.5 L44.4,30.8 L49.4,27.6 L54.3,23.8 L59.3,20.2 L64.2,17.2 L69.1,14.2 L74.1,10.5 L79,7.6 L84,5.7 L88.9,4.4 L93.8,2.6 L98.8,0.9 L100,0.5 L100,52 Z" clip-path="url(#cpbig)"/>
                <path class="rdg" d="M0,52 L4.9,50 L9.9,47.7 L14.8,45.3 L19.8,42.6 L24.7,40.3 L29.6,38.3 L34.6,36.1 L39.5,33.5 L44.4,30.8 L49.4,27.6 L54.3,23.8 L59.3,20.2 L64.2,17.2 L69.1,14.2 L74.1,10.5 L79,7.6 L84,5.7 L88.9,4.4 L93.8,2.6 L98.8,0.9 L100,0.5"/>
                <path class="stp" d="M0,52 L4.9,50 L9.9,47.7 L14.8,45.3 L19.8,42.6 L24.7,40.3 L29.6,38.3 L34.6,36.1 L39.5,33.5 L44.4,30.8 L49.4,27.6 L54.3,23.8 L59.3,20.2 L64.2,17.2 L69.1,14.2 L74.1,10.5 L79,7.6 L84,5.7 L88.9,4.4 L93.8,2.6 L98.8,0.9 L100,0.5" clip-path="url(#cpbig)"/>
                <line class="base" x1="0" y1="52" x2="100" y2="52"/>
              </svg>
              <span class="cur-summit" aria-hidden="true"></span>
              <div class="cur-hero-t">
                <span class="ci" data-rank="1">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}</span>
                <span class="n">01</span>
                <strong>La Redoute</strong>
                <span class="co">2.0 km · △ 180 m · 9.0% · 14% max</span>
              </div>
            </div>
            <ol class="cur-rest">
              {% for c in [
                {n: '02', nm: 'Thier Antoine', co: '8.7% · 17% max', d: 'M0,14 L3.7,13.4 L7.5,12.9 L11.2,12.2 L15,11.4 L18.7,10.6 L22.4,9.7 L26.2,8.5 L29.9,7.7 L33.6,7.1 L37.4,6.3 L41.1,5.5 L44.9,4.9 L48.6,4.6 L52.3,4.2 L56.1,3.8 L59.8,3.3 L63.6,3.1 L67.3,2.8 L71,2.7 L74.8,2.4 L78.5,2.1 L82.2,1.8 L86,1.6 L89.7,1.4 L93.5,1 L97.2,0.5 L100,0'},
                {n: '03', nm: 'Mur de Huy',    co: '9.7% · 17% max', d: 'M0,14 L3.7,13.7 L7.5,13.4 L11.2,13.1 L14.9,12.8 L18.7,12.4 L22.4,11.9 L26.1,11.2 L29.8,10.6 L33.6,9.8 L37.3,8.8 L41,7.9 L44.8,7.1 L48.5,6.5 L52.2,5.9'},
                {n: '04', nm: 'Saint-Roch',    co: '10.1% · 16% max', d: 'M0,14 L3.3,13.3 L7,13 L10.7,12.9 L14.5,12 L18.2,11.2 L21.9,10.4 L25.6,9.5 L29.4,8.6 L33.1,8 L36.9,7.5 L40.6,7 L44.4,6.6 L46.2,6.5'},
                {n: '05', nm: 'Stockeu',       co: '10.0% · 16% max', d: 'M0,14 L3.7,13.2 L7.4,12.5 L11.1,11.8 L14.8,11.1 L18.5,10.3 L22.2,9.4 L25.9,8.5 L29.7,7.7 L33.4,6.6 L37.1,6 L40.8,5.7 L44.5,5.4 L48.2,4.8 L51.9,4.3 L55.6,3.9 L59.3,3.5 L63,3.1 L66.7,2.7 L70.4,2.1 L74.1,1.4 L77.8,0.9 L81.6,0.7 L85.3,0.4 L86.2,0.4'}
              ] %}
              <li style="--i:{{ loop.index0 }}">
                <span class="ci" data-rank="{{ loop.index + 1 }}">{% include 'partials/_type_icon.html.twig' with {letter: 'N'} only %}</span>
                <span class="n">{{ c.n }}</span>
                <span class="nm">{{ c.nm }}</span>
                <svg class="cur-spark" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true">
                  <path class="rdg" d="{{ c.d }}"/>
                </svg>
                <span class="co">{{ c.co }}</span>
              </li>
              {% endfor %}
            </ol>
            <div class="vs">{{ 'home.cur_voted'|trans }}</div>
            </div>
            <button type="button" class="ph-replay" data-cur-replay>{{ 'home.frag_replay'|trans }}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
