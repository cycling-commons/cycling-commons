<!-- ===================== CURATION ===================== -->
<section class="pad" id="curation" style="background:var(--paper-deep)">
  <div class="wrap split">
    <div>
      <div class="kicker rv">{{ 'home.cur_kicker'|trans }}</div>
      <h2 class="rv" data-d="1">{{ 'home.cur_h2'|trans }}</h2>
      <p class="lead rv" data-d="2">{{ 'home.cur_lead'|trans }}</p>
      {# What riders vote on: the five votable kinds, drawn icons from THE
         icon set with their catalogue labels (owner 2026-09-09: "add icons
         for what is voteable"). The list mirrors ItemType::isVotable(). #}
      <div class="votable rv" data-d="3">
        <span class="vk">{{ 'home.cur_votable_k'|trans }}</span>
        <ul>
          {% for t in [{l: 'N', k: 'climbs'}, {l: 'R', k: 'quality-rides'}, {l: 'P', k: 'scenic-views'}, {l: 'Q', k: 'history-culture'}, {l: 'O', k: 'where-to-sleep'}] %}
            <li>{% include 'partials/_type_icon.html.twig' with {letter: t.l} only %}<span>{{ ('item_type.' ~ t.k ~ '.label')|trans }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# The best-of card, on the phone frame the fragmentation box uses at the
       top of the page (owner 2026-09-10, picked from three drafts).

       The climbs are DRAWN, not described: a climb is a shape, and
       "161 m · 9.7%" is a shape nobody can see. Every profile is generated
       from the numbers printed beside it, rise from the gain and run from
       gain over the average gradient, on one scale 2.67 km across and 232 m
       tall, so a longer climb really is drawn wider, a taller one taller and
       a steeper one steeper, and the four are comparable to each other rather
       than each to itself. The vertical exaggeration is 5.3x and uniform,
       which is what keeps the slopes comparable. #}
    <div class="cur rv" data-d="2">
      {# The winning climb is drawn at size; the other three are one ridge each. #}
      <div class="cur-v3">
        <h3>{{ 'home.cur_panel_h'|trans }}</h3>
        <div class="phone">
          <div class="ph-notch"></div>
          <div class="cur-screen">
            <span class="pin">{{ 'home.cur_panel_pin'|trans }}</span>
            <div class="cur-hero">
              <svg class="cur-big" viewBox="0 0 100 52" preserveAspectRatio="none" aria-hidden="true">
                <clipPath id="cpbig"><rect x="34.1" y="0" width="23.9" height="52"/></clipPath>
                <path class="fil" d="M0,52 L18,46.5 L34.1,39 L58,20.4 L76,8.6 L90,3.3 L100,0.5 L100,52 Z"/>
                <path class="ramp" d="M0,52 L18,46.5 L34.1,39 L58,20.4 L76,8.6 L90,3.3 L100,0.5 L100,52 Z" clip-path="url(#cpbig)"/>
                <path class="rdg" d="M0,52 L18,46.5 L34.1,39 L58,20.4 L76,8.6 L90,3.3 L100,0.5"/>
                <path class="stp" d="M0,52 L18,46.5 L34.1,39 L58,20.4 L76,8.6 L90,3.3 L100,0.5" clip-path="url(#cpbig)"/>
                <line class="base" x1="0" y1="52" x2="100" y2="52"/>
              </svg>
              <span class="cur-summit" aria-hidden="true"></span>
              <div class="cur-hero-t">
                <span class="n">01</span>
                <strong>La Redoute</strong>
                <span class="co">1.7 km · △ 161 m · 9.7% · 15% max</span>
              </div>
            </div>
            <ol class="cur-rest">
              {% for c in [
                {n: '02', nm: 'Tier Antoine',    co: '△ 232 m · 8.7%', d: 'M0,14 L22,11.8 L42,8.9 L64,4.9 L82,2.1 L100,0'},
                {n: '03', nm: 'Mur de Huy',      co: '△ 128 m · 9.3%', d: 'M0,14 L24,13 L44,11.7 L60,10.3 L76,7.7 L90,6.3 L100,5.8'},
                {n: '04', nm: 'Côte de Stockeu', co: '△ 100 m · 9.0%', d: 'M0,14 L20,12.2 L42,10.1 L62,8.7 L82,7.6 L100,6.9'}
              ] %}
              <li style="--i:{{ loop.index0 }}">
                <span class="n">{{ c.n }}</span>
                <span class="nm">{{ c.nm }}</span>
                <svg class="cur-spark" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true">
                  <path class="rdg" d="{{ c.d }}"/>
                </svg>
                <span class="co">{{ c.co }}</span>
              </li>
              {% endfor %}
            </ol>
            <div class="vs">{{ 'home.cur_voted'|trans }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
