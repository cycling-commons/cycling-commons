{#
  What shipped. Same source as the roadmap (App\Content\ReleaseNotes), and the
  version string is the git tag without the `v`, so this page and the footer
  stamp cannot disagree: BuildVersion runs `git describe --tags --match 'v*'`.

  The Atom link in the head is the point of the page as much as the list is: it
  is the only update channel that needs no account and no email address.
#}
{% extends 'base.html.twig' %}

{% block head_extra %}
<link rel="alternate" type="application/atom+xml" title="{{ 'changelog.feed_title'|trans }}" href="{{ path('changelog_atom', {_locale: 'en'}) }}" />
{% endblock %}

{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/changelog.css') }}">
{% endblock %}

{% block body %}
<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}changelog.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}changelog.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'changelog.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="cwrap">
    {% for release in releases %}
      {# Anchored by git tag (`#v0.9.0`), so a fixed bug on /known-issues can
         link to the release it shipped in. #}
      <div class="crel" id="v{{ release.version }}">
        <div class="crel-head">
          <span class="crel-v">{{ release.version }}</span>
          <span class="crel-d">{{ release.date|cc_date }}</span>
        </div>
        {% for key in release.keys %}
          <div class="cline"><p>{{ key|trans|rich }}</p></div>
        {% endfor %}
      </div>
    {% endfor %}

    <div class="cfeed">
      {% trans %}changelog.feed_pre{% endtrans %}
      <a href="{{ path('changelog_atom', {_locale: 'en'}) }}">{% trans %}changelog.feed_link{% endtrans %}</a>{% trans %}changelog.feed_mid{% endtrans %}
      <a href="{{ path('roadmap') }}">{% trans %}changelog.feed_roadmap{% endtrans %}</a>{% trans %}changelog.feed_post{% endtrans %}
    </div>
  </div>
</div></section>
{% endblock %}
