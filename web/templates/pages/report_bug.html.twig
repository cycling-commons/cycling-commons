{#
  The bug form as a plain page (docs/specs/contact-and-support.md §5).

  The floating panel is how almost everybody will report a bug. This page is
  for the three cases the panel cannot serve: JavaScript off or blocked, a
  browser without WebCrypto, and a link somebody was sent ("report it here").
  It posts to the same route and the same validator, which is what stops the
  fallback quietly falling behind the main path.

  It takes ONE screenshot as a file rather than several by paste, because
  pasting is a JavaScript trick and this page is the version that works without
  one.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<style>
  .bugpage{max-width:640px}
  .bugpage h2{font-family:var(--serif);font-weight:600;font-size:1.25rem;margin:1.8rem 0 .5rem}
  .bugpage p{font-size:.95rem;color:#3a3d30;line-height:1.65;margin:.55rem 0}
  .bugpage a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
  .cfield{margin:1.15rem 0}
  .cfield label,.cfield .leg{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;
    text-transform:uppercase;color:var(--clay);margin-bottom:.4rem}
  .cfield input[type="text"],.cfield input[type="email"],.cfield input[type="file"],.cfield select,.cfield textarea{
    width:100%;font-family:inherit;font-size:.95rem;padding:.6rem .7rem;color:var(--ink);
    border:1px solid rgba(20,22,14,.24);border-radius:5px;background:var(--paper)}
  .cfield textarea{min-height:8rem;line-height:1.6;resize:vertical}
  .req{color:var(--clay);font-weight:700}
  .reqlegend{font-size:.82rem;color:#595c4d;margin:0 0 1rem}
  #b-shot-hint{margin:0 0 .45rem}
  .reattach{color:var(--clay);font-weight:600}
  /* What has been picked so far, which the native control cannot show and
     which is the whole reason a second selection used to lose the first. */
  .shotlist{list-style:none;margin:.5rem 0 0;padding:0;display:flex;flex-direction:column;gap:.3rem}
  .shotlist li{display:flex;align-items:center;gap:.5rem;background:var(--paper-deep);
    border-radius:5px;padding:.35rem .5rem .35rem .7rem;font-size:.90rem;color:#3a3d30}
  .shotname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .shotdrop{flex:none;width:26px;height:26px;line-height:1;font-size:1rem;cursor:pointer;
    border:1px solid rgba(20,22,14,.2);border-radius:4px;background:var(--paper);color:#595c4d}
  .shotdrop:hover{border-color:var(--clay);color:var(--clay)}
  .shotdrop:focus-visible{outline:2px solid var(--clay);outline-offset:2px}
  .shotnote{color:var(--clay)}
  /* Context values: the mono FACE at the size of the surrounding text. The
     site-wide `.mono` utility uppercases, and `/regions` shown as `/REGIONS`
     is a different path. */
  .ctxval{font-family:var(--mono);font-size:.86rem;letter-spacing:0;text-transform:none;
    word-break:break-word}
  .chint{font-size:.90rem;color:#595c4d;margin:.35rem 0 0;line-height:1.55}
  .opt{color:#8c8f7d;letter-spacing:.09em}
  .ctxblock{margin:1.4rem 0;font-size:.88rem;color:#4a4d40}
  .ctxblock summary{cursor:pointer;color:var(--clay)}
  .ctxblock dt{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;
    color:var(--clay);margin-top:.6rem}
  .ctxblock dd{margin:.1rem 0 0;font-size:.8rem;word-break:break-all}
  .hp-field{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
  .cnote{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1rem 1.2rem;
    border-radius:0 8px 8px 0;font-size:.90rem;color:#4a4d40;line-height:1.6;margin:1.4rem 0}
  .cerr{background:#fff1ec;border-left:2px solid var(--trail);padding:1rem 1.2rem;
    border-radius:0 8px 8px 0;font-size:.9rem;color:#5a2716;line-height:1.6;margin:0 0 1.4rem}
  {# Same ochre note as the contact page, for the same readability reason. #}
  .csent{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1.2rem 1.4rem;
    border-radius:0 8px 8px 0;line-height:1.65}
  .csent h2{margin-top:0}
  .pow-status{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;color:#595c4d;margin:.6rem 0 0}
  {# Segmented chips, not bare radios. The input stays a real radio (keyboard,
     no JavaScript, screen readers); only its box is hidden, and the label text
     next to it carries the look. Never `display:none` on the input: that takes
     it out of the tab order. #}
  .sevrow{display:flex;gap:.4rem;flex-wrap:wrap;margin:0}
  .sevrow label{margin:0}
  .sevrow input{position:absolute;opacity:0;width:1px;height:1px}
  .sevrow span{display:inline-block;font-family:var(--mono);font-size:.72rem;letter-spacing:.09em;
    text-transform:uppercase;padding:.5rem .8rem;border:1px solid rgba(20,22,14,.2);border-radius:5px;
    background:var(--paper);color:#4a4d40;cursor:pointer;transition:all .15s}
  .sevrow label:hover span{border-color:var(--clay);color:var(--ink)}
  .sevrow input:checked + span{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .sevrow input:focus-visible + span{outline:2px solid var(--clay);outline-offset:2px}
</style>
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('support/form-challenge.js') }}" defer></script>
<script src="{{ asset('support/bug-context.js') }}" defer></script>
{# The picker, and the labels it builds its list from. Enhancement only: the
   native input still works without it, one dialog at a time. #}
<script src="{{ asset('support/shot-picker.js') }}" defer></script>
{% endblock %}

{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'support.bug.kicker'|trans }}</div>
  <h1 class="disp">{{ 'support.bug.title'|trans }}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'support.bug.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="bugpage">
    {% if sent %}
      <div class="csent">
        <h2>{{ 'support.bug.sent_title'|trans }}</h2>
        <p>{{ 'support.bug.sent_body'|trans }}</p>
        <p><a href="{{ path('known_issues') }}">{{ 'support.bug.known_link'|trans }}</a></p>
      </div>
    {% else %}
      {% if error %}
        <div class="cerr" role="alert">{{ error|trans }}</div>
      {% endif %}

      <p>{{ 'support.bug.check_known'|trans }} <a href="{{ path('known_issues') }}">{{ 'support.bug.known_link'|trans }}</a>.</p>

      <form method="post" action="{{ path('bug_report_submit') }}" enctype="multipart/form-data"
            id="cc-guarded-form"
            data-challenge-url="{{ path('form_challenge') }}"
            data-pow-difficulty="{{ pow_difficulty }}">
        <input type="hidden" name="_token" value="{{ csrf_token('bug_report') }}">
        <input type="hidden" name="{{ stamp_field }}" value="{{ form_stamp }}">
        {# Filled by form-challenge.js from data-challenge-url above; empty
           here because a challenge is single use (page-caching.md §3.1). #}
        <input type="hidden" name="pow_challenge" id="pow_challenge" value="">
        <input type="hidden" name="pow_nonce" id="pow_nonce" value="">
        {# Only when we KNOW the page. When we do not, the reporter gets a
           visible box further down with the same name, and two fields sharing
           a name would leave PHP picking one by document order. #}
        {% if prefill_url %}<input type="hidden" name="page_url" value="{{ prefill_url }}">{% endif %}
        {# Filled by support/bug-context.js, so this form sends the same context
           the floating panel does. Empty with JavaScript off. #}
        <input type="hidden" name="browser" value="">
        <input type="hidden" name="viewport" value="">
        <input type="hidden" name="app_version" value="">

        <div class="hp-field" aria-hidden="true">
          <label for="{{ honeypot_a }}">{{ 'support.honeypot_label'|trans }}</label>
          <input type="text" id="{{ honeypot_a }}" name="{{ honeypot_a }}" tabindex="-1" autocomplete="off">
          <label for="{{ honeypot_b }}">{{ 'support.honeypot_label'|trans }}</label>
          <input type="text" id="{{ honeypot_b }}" name="{{ honeypot_b }}" tabindex="-1" autocomplete="off">
        </div>


        <div class="cfield">
          <label for="b-title">{{ 'support.bug.field_title'|trans }} <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="b-title" name="title" maxlength="160" required
                 value="{{ kept.title }}"
                 placeholder="{{ 'support.bug.placeholder_title'|trans }}">
        </div>

        {% if not prefill_url %}
          {# Nobody arrived from the page they are reporting, so there is no
             path to record and until now no way for them to say. A QUESTION,
             so it sits with the other questions rather than inside the block
             that lists what we captured on our own. Optional: a report with no
             page is still a report, and off-site URLs are dropped server side
             (BugReportController::cleanPageUrl). #}
          <div class="cfield">
            <label for="b-url">{{ 'support.bug.field_page'|trans }}
</label>
            <input type="text" id="b-url" name="page_url" maxlength="500"
                   inputmode="url" autocomplete="off" value="{{ prefill_url }}"
                   placeholder="{{ 'support.bug.field_page_ph'|trans }}">
            <p class="chint">{{ 'support.bug.field_page_hint_short'|trans }}</p>
          </div>
        {% endif %}

        <div class="cfield">
          <span class="leg">{{ 'support.bug.field_severity'|trans }}</span>
          <div class="sevrow">
            {% for sev in severities %}
              <label>
                <input type="radio" name="severity" value="{{ sev.value }}"{{ sev.value == selected_severity ? ' checked' : '' }}>
                <span>{{ ('support.bug.severity.' ~ sev.value)|trans }}</span>
              </label>
            {% endfor %}
          </div>
        </div>

        <div class="cfield">
          <label for="b-area">{{ 'support.bug.field_area'|trans }}</label>
          <select id="b-area" name="area">
            {% for area in areas %}
              <option value="{{ area.value }}"{{ area.value == selected_area ? ' selected' : '' }}>{{ ('support.bug.area.' ~ area.value)|trans }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="cfield">
          <label for="b-body">{{ 'support.bug.field_body'|trans }} <span class="req" aria-hidden="true">*</span></label>
          <textarea id="b-body" name="body" maxlength="8000" required
                    placeholder="{{ 'support.bug.placeholder_body'|trans }}">{{ kept.body }}</textarea>
        </div>

        <div class="cfield">
          <label for="b-steps">{{ 'support.bug.field_steps'|trans }}</label>
          <textarea id="b-steps" name="steps" maxlength="4000"
                    placeholder="{{ 'support.bug.placeholder_steps'|trans }}">{{ kept.steps }}</textarea>
        </div>

        <div class="cfield">
          <label for="b-shot">{{ 'support.bug.field_screenshot'|trans }}</label>
          <p class="chint" id="b-shot-hint">{{ 'support.bug.hint_screenshot'|trans({
            '%max%': max_screenshots,
            '%size%': max_shot_mb,
            '%formats%': 'PNG, JPEG, GIF, WebP',
          }) }}</p>
          <input type="file" id="b-shot" name="screenshot[]" multiple
                 accept="image/png,image/jpeg,image/gif,image/webp"
                 aria-describedby="b-shot-hint"
                 data-max="{{ max_screenshots }}" data-max-bytes="{{ max_shot_bytes }}"
                 {# The picker's three strings, here rather than in an inline
                    script: an inline block needs a CSP nonce, and a nonce
                    cannot sit in a page a cache may hold (page-caching.md
                    §3.2). shot-picker.js already reads this element. #}
                 data-label-remove="{{ 'support.bug.shot_remove'|trans }}"
                 data-label-too-big="{{ 'support.bug.shot_too_big'|trans }}"
                 data-label-full="{{ 'support.bug.shot_full'|trans }}">
          {% if lost_screenshots|default(false) %}
            {# A browser will not let a server refill a file input, so this is
               the honest thing to say rather than letting somebody send a
               report believing the image went with it. #}
            <p class="chint reattach">{{ 'support.bug.reattach'|trans }}</p>
          {% endif %}
        </div>

        {# Signed in: no address field at all. Showing somebody their own
           address so they can read it and not change it is a question with one
           answer. The reply goes to their account either way
           (docs/specs/contact-and-support.md §5). #}
        {% if not prefill_email %}
          <div class="cfield">
            <label for="b-email">{{ 'support.bug.field_email'|trans }} <span class="req" aria-hidden="true">*</span></label>
            <input type="email" id="b-email" name="email" maxlength="320" required
                   value="{{ kept.email }}" autocomplete="email">
            <p class="chint">{{ 'support.bug.hint_email_anon'|trans }}</p>
          </div>
        {% endif %}

        <details class="ctxblock">
          <summary>{{ 'support.bug.context_summary'|trans }}</summary>
          <dl>
            <dt>{{ 'support.bug.context_page'|trans }}</dt>
            <dd class="ctxval">{{ prefill_url ?? '–' }}</dd>
            <dt class="ctx-jsonly" hidden>{{ 'support.bug.context_browser'|trans }}</dt>
            <dd class="ctxval bf-ctx-browser ctx-jsonly" hidden></dd>
            <dt class="ctx-jsonly" hidden>{{ 'support.bug.context_screen'|trans }}</dt>
            <dd class="ctxval bf-ctx-viewport ctx-jsonly" hidden></dd>
          </dl>

        </details>

        <p id="pow-status" class="pow-status" hidden
           data-working="{{ 'support.challenge_working'|trans }}"
           data-ready="{{ 'support.challenge_ready'|trans }}"
           data-failed="{{ 'support.challenge_failed'|trans }}"></p>

        <p class="reqlegend">{{ 'support.required_legend'|trans|rich }}</p>

        <p><button type="submit" class="btn btn-p">{{ 'support.bug.submit'|trans }}</button></p>
      </form>

      <noscript>
        <div class="cnote">
          <p>{{ 'support.bug.no_js_note'|trans }}</p>
        </div>
      </noscript>
    {% endif %}
  </div>
</div></section>
{% endblock %}
