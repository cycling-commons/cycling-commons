{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .chero{background:var(--ink);color:var(--paper);padding:3rem 0}
  .rec-note{font-size:.9rem;color:#595c4d;margin-top:-.4rem;max-width:62ch}
  .ack{margin-top:1.2rem}
  .ack .row{display:flex;align-items:center;gap:.85rem;padding:.6rem .2rem;border-bottom:1px solid rgba(20,22,14,.08)}
  .ack .row[hidden]{display:none}
  .ack .av{width:32px;height:32px;border-radius:50%;background:var(--spruce);color:var(--paper);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.62rem;flex:none}
  .ack .nm{font-family:var(--mono);font-size:.9rem;color:var(--ink);text-decoration:none}
  .ack a.nm:hover{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
  .ack .rg{color:#7a7d6c;font-family:var(--mono);font-size:.58rem;letter-spacing:.06em;text-transform:uppercase;background:var(--paper-deep);border:1px solid rgba(20,22,14,.1);border-radius:30px;padding:.18rem .5rem}
  .ack .st{margin-left:auto;font-family:var(--mono);font-size:.7rem;color:#595c4d;text-align:right;white-space:nowrap}
  .ack .st b{font-family:var(--serif);font-size:1.05rem;color:var(--ink);margin-right:.35rem}
  @media(max-width:520px){.ack .rg{display:none}.ack .st{font-size:.64rem}}
  .ack-bar{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
  .ack-q,.ack-rg{font-family:var(--mono);font-size:.85rem;padding:.5rem .8rem;border:1px solid rgba(20,22,14,.2);border-radius:6px;background:var(--paper);color:var(--ink)}
  .ack-q{flex:1;min-width:200px}
  .ack-q:focus,.ack-rg:focus{outline:none;border-color:var(--trail)}
  .ack-empty{font-size:.9rem;color:#7a7d6c;margin-top:1.2rem}
</style>
{% endblock %}
{% block body %}

<div class="chero"><div class="wrap" style="max-width:820px">
  <div class="kicker" style="color:var(--trail)">{% trans %}contributors.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}contributors.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'contributors.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap" style="max-width:820px">

  <div class="kicker">{% trans %}contributors.active_kicker{% endtrans %}</div>
  <p class="rec-note">{% trans %}contributors.search_note{% endtrans %}</p>
  {% if wall is not empty %}
  <div class="ack-bar">
    <input class="ack-q" type="search" placeholder="{{ 'contributors.search_placeholder'|trans }}" aria-label="{{ 'contributors.search_aria'|trans }}" />
    <select class="ack-rg" aria-label="{{ 'contributors.region_aria'|trans }}">
      <option value="">{% trans %}contributors.region_all{% endtrans %}</option>
      {% for c in wall_countries %}<option>{{ c }}</option>{% endfor %}
    </select>
  </div>
  <div class="ack" id="ack">
    {% for c in wall %}
    <div class="row" data-name="{{ c.name }}" data-region="{{ c.country ?? '' }}">
      <span class="av">{{ c.initials }}</span>
      <a class="nm" href="{{ path('rider_profile', {uuid: c.uuid}) }}">{{ c.name }}</a>
      {% if c.country %}<span class="rg">{{ c.country }}</span>{% endif %}
      <span class="st">{{ 'contributors.row_stats'|trans({'%facts%': c.facts|number_format(0, '.', ','), '%routes%': c.routes}) }}</span>
    </div>
    {% endfor %}
  </div>
  <p class="ack-empty" id="ack-empty" hidden>{% trans %}contributors.no_match{% endtrans %}</p>
  {% else %}
  <p class="ack-empty">{% trans %}contributors.wall_empty{% endtrans %}</p>
  {% endif %}

  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));margin-top:2.4rem">
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.facts|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_facts{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.contributors|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_contributors{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.routes|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_routes{% endtrans %}</div></div>
  </div>
</div></section>
{% endblock %}
{% block body_scripts %}
{% if wall is not empty %}
<script nonce="{{ csp_nonce() }}">
/* Filter for the server-rendered acknowledgment wall — non-ranked,
   alphabetical; rows are real opt-in public profiles. */
(function(){
  const wall=document.getElementById('ack');
  const q=document.querySelector('.ack-q');
  const rg=document.querySelector('.ack-rg');
  const empty=document.getElementById('ack-empty');
  const chips=[...wall.children];
  function apply(){
    const t=q.value.trim().toLowerCase(), reg=rg.value; let n=0;
    chips.forEach(el=>{
      const ok=(!t||el.dataset.name.toLowerCase().includes(t))&&(!reg||el.dataset.region===reg);
      el.hidden=!ok; if(ok)n++;
    });
    empty.hidden=n>0;
  }
  q.addEventListener('input',apply); rg.addEventListener('change',apply);
})();
</script>
{% endif %}
{% endblock %}
