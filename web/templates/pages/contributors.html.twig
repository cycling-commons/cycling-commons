{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/contributors.css') }}">
{% endblock %}
{% block body %}

<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}contributors.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}contributors.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'contributors.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">

  <div class="kicker">{% trans %}contributors.active_kicker{% endtrans %}</div>
  <p class="rec-note">{% trans %}contributors.search_note{% endtrans %}</p>
  {# A real GET form, not JS over the rendered rows: the wall is paged, so a
     filter that only saw the current page would tell a rider on page 4 that
     they are not on the wall at all. Both controls submit the form — the
     select on change, the search box on Enter — and the button covers
     everything else. #}
  <form class="ack-bar" method="get" action="{{ path('contributors') }}">
    <input class="ack-q" type="search" name="q" value="{{ wall_q }}"
           placeholder="{{ 'contributors.search_placeholder'|trans }}" aria-label="{{ 'contributors.search_aria'|trans }}" />
    <select class="ack-rg sel-chip" name="country" aria-label="{{ 'contributors.region_aria'|trans }}" data-autosubmit>
      <option value="">{% trans %}contributors.region_all{% endtrans %}</option>
      {% for c in wall_countries %}<option{{ wall_country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
    </select>
    <button type="submit" class="ack-go">{% trans %}contributors.search_submit{% endtrans %}</button>
  </form>
  {% if wall is not empty %}
  <div class="ack" id="ack">
    {% for c in wall %}
    <div class="row">
      <span class="av">{{ c.initials }}</span>
      <a class="nm" href="{{ path('rider_profile', {uuid: c.uuid}) }}">{{ c.name }}</a>
      {% if c.curator %}<span class="role">{% trans %}contributors.badge_curator{% endtrans %}</span>{% endif %}
      {% if c.country %}<span class="rg">{{ c.country }}</span>{% endif %}
      <span class="st">{{ 'contributors.row_stats'|trans({'%facts%': c.facts|number_format(0, '.', ','), '%climbs%': c.climbs, '%photos%': c.photos, '%checks%': c.checks, '%routes%': c.routes}) }}</span>
    </div>
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'contributors', params: pager_params} %}
  {% elseif wall_q or wall_country %}
  <p class="ack-empty">{% trans %}contributors.no_match{% endtrans %}</p>
  {% else %}
  <p class="ack-empty">{% trans %}contributors.wall_empty{% endtrans %}</p>
  {% endif %}

  <div class="ack-stats">
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.facts|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_facts{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.contributors|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_contributors{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.routes|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_routes{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.climbs|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_climbs{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.photos|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_photos{% endtrans %}</div></div>
    <div class="card"><b style="font-family:var(--serif);font-size:1.6rem">{{ stats.checks|number_format(0, '.', ',') }}</b><div class="co" style="margin-top:.3rem">{% trans %}contributors.stat_checks{% endtrans %}</div></div>
  </div>
</div></section>
{% endblock %}
{# The wall's filter used to be a script over the rendered rows. It is a GET
   form now that the wall is paged, so there is nothing left to script. #}
