<!-- ===================== SCOUT ===================== -->
<section class="pad" id="scout">
  <div class="wrap">
    <div class="scout-cta rv" data-d="1">
      <div class="scout-cta-lead">
      {{ include('partials/_scout_logo.html.twig', {size: 64}) }}
      <div>
        <div class="kicker" style="color:var(--trail)">{{ 'home.scout_kicker'|trans }}</div>
        <h3 style="margin:.4rem 0 .5rem">{{ 'home.scout_h'|trans }}</h3>
        <p style="max-width:48ch;line-height:1.6;color:#4a4d40">{{ 'home.scout_p'|trans }}</p>
        <a class="btn btn-primary btn-sm" href="{{ path('scout') }}">{{ 'home.scout_cta'|trans }} <span class="arw">→</span></a>
      </div>
      </div>
      {{ include('partials/_scout_devices.html.twig', {compact: true}) }}
    </div>
  </div>
</section>
