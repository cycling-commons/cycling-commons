{#
  Known issues (docs/specs/contact-and-support.md §5).

  What a curator has confirmed and published, and nothing else. A bug report is
  never on this page because its author wrote it: the list is only worth reading
  because somebody has checked every line, and a report written in anger or
  naming a person must never become a public page by accident.

  Declined reports are excluded by the query. "We are not fixing this" is a
  conversation with the reporter, not a public notice.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<style>
  .issues{max-width:820px}
  .issue{border-bottom:1px solid rgba(20,22,14,.12);padding:1rem 0}
  .issue:last-child{border-bottom:0}
  .issue{scroll-margin-top:5rem}
  .issue summary{cursor:pointer;list-style:none;position:relative;padding-right:1.6rem}
  .issue summary::-webkit-details-marker{display:none}
  .issue summary::after{content:'▾';position:absolute;right:.2rem;top:0;color:var(--clay);font-size:.9rem}
  .issue[open] summary::after{content:'▴'}
  .issue h2{font-family:var(--serif);font-size:1.02rem;font-weight:600;margin:0 0 .35rem;color:var(--ink)}
  .issue summary:hover h2{color:var(--clay)}
  .issue .body{margin-top:.5rem}
  .issue .body .tagrow:empty{display:none}
  .issue:target{background:rgba(200,146,58,.12);margin:0 -.8rem;padding-left:.8rem;padding-right:.8rem;border-radius:6px}
  .issue p{font-size:.9rem;color:#4a4d40;line-height:1.6;margin:.3rem 0}
  .tagrow{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;margin-top:.4rem}
  .tag{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;
    padding:.2rem .45rem;border-radius:3px;background:var(--paper-deep);color:#4a4d40}
  .tag.sev-critical{background:#5a2716;color:#FFD9C8}
  .tag.sev-major{background:#FFE0D2;color:#5a2716}
  .tag.st-resolved{background:var(--spruce);color:var(--paper)}
  .tag.st-in_progress,.tag.st-needs_testing{background:var(--ochre);color:var(--ink)}
  .when{font-family:var(--mono);font-size:.7rem;letter-spacing:.06em;color:#6d7060}
  .tabs{display:flex;gap:.4rem;margin:0 0 1.4rem;flex-wrap:wrap}
  .tabs a{display:inline-flex;align-items:baseline;gap:.45rem;padding:.45rem .85rem;border-radius:999px;
    border:1px solid rgba(20,22,14,.2);color:#4a4d40;text-decoration:none;font-size:.9rem;background:var(--paper)}
  .tabs a:hover{border-color:var(--clay);color:var(--ink)}
  .tabs a[aria-current="page"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .tabs .n{font-family:var(--mono);font-size:.76rem;opacity:.75}
  .tabnote{font-size:.9rem;color:#6d7060;margin:0 0 1.1rem;line-height:1.6}
  .empty{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1.1rem 1.3rem;
    border-radius:0 8px 8px 0;font-size:.92rem;color:#4a4d40;line-height:1.6}
  .cta{margin-top:2rem;font-size:.94rem}
  .cta a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
</style>
{% endblock %}

{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'support.known.kicker'|trans }}</div>
  <h1 class="disp">{{ 'support.known.title'|trans }}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'support.known.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  {# Links, never a script toggle: this page is shared-cached, and a filter a
     shared cache cannot see in the URL serves one visitor's choice to the next
     (docs/specs/page-caching.md §3.2). Each tab carries its own count, because
     a tab that cannot say what is behind it is a tab nobody opens. #}
  <nav class="tabs" aria-label="{{ 'support.known.tabs_label'|trans|e('html_attr') }}">
    <a href="{{ path('known_issues') }}"{{ fixed ? '' : ' aria-current="page"' }}>
      {{ 'support.known.tab_open'|trans }} <span class="n">{{ open_count }}</span>
    </a>
    <a href="{{ path('known_issues', {show: 'fixed'}) }}"{{ fixed ? ' aria-current="page"' : '' }}>
      {{ 'support.known.tab_fixed'|trans }} <span class="n">{{ fixed_count }}</span>
    </a>
  </nav>

  {% if fixed %}<p class="tabnote">{{ 'support.known.fixed_note'|trans }}</p>{% endif %}

  <div class="issues cc-zebra">
    {% if issues is empty %}
      <div class="empty">{{ (fixed ? 'support.known.empty_fixed' : 'support.known.empty')|trans }}</div>
    {% else %}
      {% for issue in issues %}
        {# Each issue folds (owner 2026-09-09: "do not show description by
           default; not logged in users get the public description when
           clicked on"): the title is the summary, the tags stay visible, the
           description opens on a click. A curator also gets a link to the
           desk page inside. #}
        <details class="issue" id="issue-{{ issue.id }}">
          <summary>
            <h2>{{ issue.publicTitle }}</h2>
            <div class="tagrow">
              <span class="tag st-{{ issue.status.value }}">{{ ('support.bug.status.' ~ issue.status.value)|trans }}</span>
              <span class="tag sev-{{ issue.severity.value }}">{{ ('support.bug.severity.' ~ issue.severity.value)|trans }}</span>
              <span class="tag">{{ ('support.bug.area.' ~ issue.area.value)|trans }}</span>
              <span class="when">{{ issue.updatedAt|cc_date }}</span>
            </div>
          </summary>
          {# The public DESCRIPTION, not the reply. The outcome note is written
             to one person and reads like it; a stranger opening this list cold
             needs a description (contact-and-support.md §10). #}
          <div class="body">
            {% if issue.publicBody %}<div class="inote">{{ issue.publicBody|bug_markdown }}</div>{% endif %}
            <div class="tagrow">
              {% if issue.githubIssue and github_repo %}<a class="tag" href="https://github.com/{{ github_repo }}/issues/{{ issue.githubIssue }}" target="_blank" rel="noopener">GitHub #{{ issue.githubIssue }} ↗</a>{% endif %}
              {% if is_granted('ROLE_CURATOR') %}<a class="tag" href="{{ path('moderate_bugs_detail', {id: issue.id}) }}">{{ 'support.known.desk_link'|trans }}</a>{% endif %}
            </div>
          </div>
        </details>
      {% endfor %}
      {# The tab travels with the page number, or page 2 of the fixed list is
         page 2 of the open one. #}
      {% include 'partials/_pager.html.twig' with {pager: pager, route: 'known_issues', params: fixed ? {show: 'fixed'} : {}} %}
    {% endif %}

    <p class="cta">
      {{ 'support.known.not_here'|trans }}
      <a href="{{ path('bug_report') }}">{{ 'support.known.report_link'|trans }}</a>.
    </p>
  </div>
</div></section>
{% endblock %}
