{# SPDX-License-Identifier: AGPL-3.0-only #}
{% extends 'base.html.twig' %}
{# The terms' text is translations/terms.<locale>.yaml, its own domain,
   outside the in-site translation system (docs/specs/translations.md §6). #}
{% trans_default_domain text_domain %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/terms.css') }}">
{% endblock %}
{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}terms.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}terms.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}terms.lead{% endtrans %}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="legal">
    <p class="upd" data-terms-version="{{ terms_current.number }}">{{ 'terms.version_line'|trans({'%n%': terms_current.number, '%date%': terms_current.effective|cc_date}) }}</p>
    {% include 'pages/_legal_upcoming.html.twig' with {page: 'terms'} %}

    <h2><span class="n">1</span>{% trans %}terms.h1_accepting{% endtrans %}</h2>
    <p>{% trans %}terms.accepting_p1_pre{% endtrans %} <a href="{{ path('privacy') }}">{% trans %}terms.accepting_p1_privacy{% endtrans %}</a>{% trans %}terms.accepting_p1_mid{% endtrans %} <b>{% trans %}terms.accepting_p1_bikecoders{% endtrans %}</b> (<a href="https://bikecoders.life">bikecoders.life</a>){% trans %}terms.accepting_p1_mid2{% endtrans %} <a href="https://wiki.cyclingcommons.org/governance/">{% trans %}terms.accepting_p1_governance{% endtrans %}</a>{% trans %}terms.accepting_p1_post{% endtrans %}</p>

    <h2><span class="n">2</span>{% trans %}terms.h2_who{% endtrans %}</h2>
    <p>{{ 'terms.who_body'|trans|rich }}</p>

    <h2><span class="n">3</span>{% trans %}terms.h3_account{% endtrans %}</h2>
    <ul>
      <li>{% trans %}terms.account_password{% endtrans %}</li>
      <li>{% trans %}terms.account_unauthorised{% endtrans %}</li>
      <li>{% trans %}terms.account_suspend{% endtrans %}</li>
    </ul>

    <h2><span class="n">4</span>{% trans %}terms.h4_using{% endtrans %}</h2>
    <p>{% trans %}terms.using_intro{% endtrans %}</p>
    <ul>
      <li>{% trans %}terms.using_no_illegal{% endtrans %}</li>
      <li>{{ 'terms.using_no_personal'|trans|rich }}</li>
      <li>{% trans %}terms.using_no_reidentify_pre{% endtrans %} <a href="https://wiki.cyclingcommons.org/governance/#the-sensing-boundary-how-activity-becomes-a-place-fact">{% trans %}terms.using_no_reidentify_link{% endtrans %}</a>{% trans %}terms.using_no_reidentify_post{% endtrans %}</li>
      <li>{% trans %}terms.using_no_scrape_pre{% endtrans %} <a href="{{ path('developers') }}">{% trans %}terms.using_no_scrape_link{% endtrans %}</a>{% trans %}terms.using_no_scrape_post{% endtrans %} <a href="{{ path('data_export') }}">{% trans %}terms.using_no_scrape_export_link{% endtrans %}</a>{% trans %}terms.using_no_scrape_mid{% endtrans %} <a href="{{ path('contact') }}">{% trans %}terms.using_no_scrape_contact_link{% endtrans %}</a>{% trans %}terms.using_no_scrape_end{% endtrans %}</li>
      {# Kept as its own rule: disruption was bundled into the scraping line, and
         the blunter scraping wording must not quietly drop a separate prohibition. #}
      <li>{% trans %}terms.using_no_disrupt{% endtrans %}</li>
    </ul>

    <h2><span class="n">5</span>{% trans %}terms.h5_contributions{% endtrans %}</h2>
    <p>{% trans %}terms.contributions_p1_pre{% endtrans %} <a href="{{ path('licenses') }}#full-texts">{% trans %}terms.contributions_p1_link{% endtrans %}</a>{{ 'terms.contributions_p1_mid'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_odbl{% endtrans %}</a>{{ 'terms.contributions_p1_mid2'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_ccbysa{% endtrans %}</a>{{ 'terms.contributions_p1_mid3'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_agpl{% endtrans %}</a>{% trans %}terms.contributions_p1_post{% endtrans %}</p>
    <p>{% trans %}terms.contributions_p2{% endtrans %}</p>

    <h2><span class="n">6</span>{% trans %}terms.h6_opendata{% endtrans %}</h2>
    <p>{% trans %}terms.opendata_pre{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}terms.opendata_link{% endtrans %}</a>{% trans %}terms.opendata_mid{% endtrans %} <a href="{{ path('developers') }}">{% trans %}terms.opendata_dev_link{% endtrans %}</a>{% trans %}terms.opendata_post{% endtrans %}</p>
    {# The bulk export (api-strategy.md §3.1, BulkExportBuilder): ODbL 1.0 with
       DbCL 1.0 contents, a source per record, nothing personal, unmoderated or
       photographic. No download limit is ever stated here. #}
    <p>{% trans %}terms.opendata_export_pre{% endtrans %} <a href="{{ path('data_export') }}">{% trans %}terms.opendata_export_link{% endtrans %}</a>{% trans %}terms.opendata_export_post{% endtrans %}</p>

    <h2><span class="n">7</span>{% trans %}terms.h7_code{% endtrans %}</h2>
    <p>{{ 'terms.code_pre'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.code_link{% endtrans %}</a>{{ 'terms.code_post'|trans|rich }} <a href="https://github.com/cycling-commons/cycling-commons/blob/main/TRADEMARK.md">{% trans %}terms.code_brand_link{% endtrans %}</a>{% trans %}terms.code_brand_post{% endtrans %}</p>

    <h2><span class="n">8</span>{% trans %}terms.h8_preview{% endtrans %}</h2>
    <div class="banner">{{ 'terms.preview_body'|trans|rich }}</div>

    <h2><span class="n">9</span>{% trans %}terms.h9_warranty{% endtrans %}</h2>
    <p>{{ 'terms.warranty_body'|trans|rich }}</p>

    <h2><span class="n">10</span>{% trans %}terms.h10_liability{% endtrans %}</h2>
    <p>{% trans %}terms.liability_body{% endtrans %}</p>

    <h2><span class="n">11</span>{% trans %}terms.h11_suspension{% endtrans %}</h2>
    <p>{% trans %}terms.suspension_pre{% endtrans %} <a href="{{ path('settings') }}">{% trans %}terms.suspension_link{% endtrans %}</a>{% trans %}terms.suspension_post{% endtrans %}</p>
    <p>{{ 'terms.suspension_p2'|trans|rich }}</p>
    <p>{{ 'terms.suspension_dormant'|trans|rich }}</p>
    {# Suspension and removal for a breach (account-and-auth.md §6.8): the
       grounds are StatementGround::forAccounts(), the days
       UserAdminService::SUSPENSION_MAX_DAYS, and the statement of reasons
       goes by email (StatementOfReasonsMailer). #}
    <p>{{ 'terms.suspension_admin'|trans|rich }}</p>
    <p>{% trans %}terms.suspension_told{% endtrans %}</p>

    {# DSA Article 14: the terms state the content-moderation policies,
       procedures and tools in clear and plain language, including what
       software does without a person (the mod_auto_* list) and human review,
       and the rules of complaint handling. The grounds are every
       App\Support\ReportGround the report form offers, and what a rider is
       told is App\Moderation\StatementOfReasons (content-reports.md §7). #}
    <h2><span class="n">12</span>{% trans %}terms.h12_moderation{% endtrans %}</h2>
    <p>{% trans %}terms.mod_intro{% endtrans %}</p>

    <h3>{% trans %}terms.mod_standard_h{% endtrans %}</h3>
    <ul>
      <li>{{ 'terms.mod_std1'|trans|rich }}</li>
      <li>{{ 'terms.mod_std2'|trans|rich }}</li>
      <li>{{ 'terms.mod_std3'|trans|rich }}</li>
      <li>{{ 'terms.mod_std4'|trans|rich }}</li>
      <li>{{ 'terms.mod_std5'|trans|rich }}</li>
      {# Generated images sit under "not true" in spirit, but a rider will not
         infer it from there, and a generated photograph of a place that does
         not look like that is the easiest false thing to add to a map. #}
      <li>{{ 'terms.mod_std6'|trans|rich }}</li>
      <li>{{ 'terms.mod_std7'|trans|rich }}</li>
      <li>{{ 'terms.mod_std8'|trans|rich }}</li>
      <li>{{ 'terms.mod_std9'|trans|rich }}</li>
    </ul>
    {# StatementGround::NotAccepted, the ground every rejection names, and
       StatementGround::Duplicate for a place retired in favour of another. #}
    <p>{{ 'terms.mod_accept'|trans|rich }}</p>

    <h3>{% trans %}terms.mod_who_h{% endtrans %}</h3>
    <p>{{ 'terms.mod_who'|trans|rich }}</p>
    {# DSA Article 18: escalation holds a photo or a submission (photo-uploads.md
       §6d); an administrator informs the authority and records it
       (AuthorityNotifications, operations.md §7). #}
    <p>{{ 'terms.mod_escalate'|trans|rich }}</p>
    <p>{{ 'terms.mod_automated'|trans|rich }}</p>
    <ul>
      <li>{{ 'terms.mod_auto_files'|trans|rich }}</li>
      <li>{{ 'terms.mod_auto_scenic'|trans|rich }}</li>
      <li>{{ 'terms.mod_auto_urgent'|trans|rich }}</li>
      <li>{{ 'terms.mod_auto_accounts'|trans|rich }}</li>
    </ul>

    <h3>{% trans %}terms.mod_told_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_told_pre{% endtrans %} <a href="{{ path('messages') }}">{% trans %}terms.mod_told_link{% endtrans %}</a>{% trans %}terms.mod_told_post{% endtrans %}</p>
    <p>{% trans %}terms.mod_told_p2{% endtrans %}</p>

    <h3>{% trans %}terms.mod_appeal_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_appeal_pre{% endtrans %} <a href="{{ path('contact') }}">{% trans %}terms.mod_appeal_link{% endtrans %}</a>{% trans %}terms.mod_appeal_post{% endtrans %}</p>

    <h3>{% trans %}terms.mod_report_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_report_pre{% endtrans %} <a href="{{ path('contact') }}?topic=report">{% trans %}terms.mod_report_link{% endtrans %}</a>{% trans %}terms.mod_report_post{% endtrans %}</p>
    <p>{% trans %}terms.mod_report_p2{% endtrans %}</p>

    {# Article 50 of the EU AI Act is about telling people when they are
       reading something a machine produced. Whether it reaches a description
       of a water tap is arguable, and the human-review carve-out in 50(4) may
       well cover us. This section is written the way the accessibility
       statement is: say what is true, do not claim a duty that may not apply,
       and do not claim compliance with anything. It names no translation tool
       or source language, so it stays true when either changes; what software
       does without a person is listed once, in section 12. #}
    <h2><span class="n">13</span>{% trans %}terms.h13_ai{% endtrans %}</h2>
    <p>{% trans %}terms.ai_intro{% endtrans %}</p>
    <ul>
      <li>{{ 'terms.ai_translation'|trans|rich }}</li>
      <li>{{ 'terms.ai_checks'|trans|rich }}</li>
      <li>{{ 'terms.ai_none'|trans|rich }}</li>
    </ul>
    <p>{{ 'terms.ai_uploads'|trans|rich }}</p>
    <p>{{ 'terms.ai_stance'|trans|rich }}</p>

    <h2><span class="n">14</span>{% trans %}terms.h14_governing{% endtrans %}</h2>
    <p>{{ 'terms.governing_body'|trans|rich }}</p>

    <h2><span class="n">15</span>{% trans %}terms.h15_changes{% endtrans %}</h2>
    <p>{% trans %}terms.changes_body{% endtrans %}</p>
    {# The texts pinned in App\Legal\TermsIncludedTexts. #}
    <p>{% trans %}terms.changes_included{% endtrans %}</p>
    {# Every version, newest first, with what changed (App\Legal\TermsVersions). #}
    <div id="changes">
      <ol class="pversions">
        {% for v in terms_versions %}
          <li data-version="{{ v.number }}">
            <b>{{ 'terms.version_line'|trans({'%n%': v.number, '%date%': v.effective|cc_date}) }}</b>
            <ul>{% for c in v.changes %}<li>{{ c|trans|rich }}</li>{% endfor %}</ul>
          </li>
        {% endfor %}
      </ol>
    </div>
    <p>{% trans %}terms.changes_versions_pre{% endtrans %} <a href="https://github.com/cycling-commons/cycling-commons/commits/main/web/translations/{{ text_domain }}.{{ app.request.locale }}.yaml">{% trans %}terms.changes_versions_link{% endtrans %}</a>{% trans %}terms.changes_versions_post{% endtrans %}</p>

    <h2><span class="n">16</span>{% trans %}terms.h16_contact{% endtrans %}</h2>
    <p>{% trans %}terms.contact_pre{% endtrans %} <a href="mailto:info@cyclingcommons.org">info@cyclingcommons.org</a> ({{ 'support.legal.or_form'|trans({}, 'messages') }} <a href="{{ path('contact') }}">{{ 'support.contact.title_short'|trans({}, 'messages') }}</a>){% trans %}terms.contact_post{% endtrans %}</p>
    {# DSA Articles 11 and 12: one point of contact for authorities and for
       recipients, and the languages it accepts. #}
    <p>{% trans %}terms.contact_poc_pre{% endtrans %} <a href="{{ path('contact') }}">{% trans %}terms.contact_poc_link{% endtrans %}</a>{% trans %}terms.contact_poc_post{% endtrans %}</p>

    <div class="disc" style="margin:2rem 0 0">{% trans %}terms.footer_disc_pre{% endtrans %} <a href="{{ path('privacy') }}">{% trans %}terms.footer_disc_privacy{% endtrans %}</a> {% trans %}terms.footer_disc_mid{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}terms.footer_disc_licences{% endtrans %}</a>{% trans %}terms.footer_disc_post{% endtrans %}</div>
  </div>
</div></section>
{% endblock %}
