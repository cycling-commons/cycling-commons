{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .legal{max-width:760px}
  .legal h2{font-family:var(--serif);font-weight:600;font-size:1.45rem;letter-spacing:-.01em;margin:2.4rem 0 .5rem}
  .legal h2:first-of-type{margin-top:0}
  .legal h2 .n{font-family:var(--mono);font-size:.8rem;color:var(--clay);margin-right:.5rem;vertical-align:.12em}
  .legal p{font-size:1rem;color:#3a3d30;margin:.55rem 0;line-height:1.65}
  .legal ul{list-style:none;margin:.5rem 0}
  .legal li{font-size:.96rem;color:#3a3d30;line-height:1.6;padding:.28rem 0 .28rem 1.4rem;position:relative}
  .legal li::before{content:"–";position:absolute;left:0;color:var(--clay);font-weight:700}
  .legal b{color:var(--ink)}
  .legal a{color:var(--clay);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px}
  .legal a:hover{color:var(--trail)}
  .banner{background:var(--spruce);color:var(--paper);border-radius:8px;padding:1rem 1.2rem;margin:1.4rem 0;font-size:.96rem;line-height:1.6}
  {# `.banner` sets a light colour, but `.legal p` is MORE SPECIFIC (0,0,1,1
     against 0,0,1,0), so any paragraph inside a banner is repainted the page's
     dark ink and lands at 1.12:1 on the spruce: invisible. It happened first on
     the accessibility statement, of all pages. These two lines make the banner
     own its own text whatever is nested inside it. #}
  .banner p,.banner li,.banner b{color:inherit}
  .banner p{margin:0}
  /* --trail on spruce is 3.99:1 — under the 4.5:1 AA floor for text this size,
     and in a safety notice the emphasised word is the one that must not be the
     hardest to read. A lifted trail keeps the warning colour at 5.35:1, and the
     emphasis carries in <b>'s weight as well, so it never rests on hue alone. */
  .banner b{color:#FF8A5B}
  .disc{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1rem 1.2rem;border-radius:0 8px 8px 0;font-size:.86rem;color:#4a4d40;margin:0 0 1.4rem}
  .upd{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#595c4d;margin:0 0 2rem}
</style>
{% endblock %}
{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}terms.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}terms.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}terms.lead{% endtrans %}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="legal">
    <p class="upd">{% trans %}terms.last_updated{% endtrans %}</p>

    <h2><span class="n">1</span>{% trans %}terms.h1_accepting{% endtrans %}</h2>
    <p>{% trans %}terms.accepting_p1_pre{% endtrans %} <a href="{{ path('privacy') }}">{% trans %}terms.accepting_p1_privacy{% endtrans %}</a>{% trans %}terms.accepting_p1_mid{% endtrans %} <b>{% trans %}terms.accepting_p1_bikecoders{% endtrans %}</b> (<a href="https://bikecoders.life">bikecoders.life</a>){% trans %}terms.accepting_p1_mid2{% endtrans %} <a href="https://wiki.cyclingcommons.org/governance/">{% trans %}terms.accepting_p1_governance{% endtrans %}</a>{% trans %}terms.accepting_p1_post{% endtrans %}</p>

    <h2><span class="n">2</span>{% trans %}terms.h2_who{% endtrans %}</h2>
    <p>{{ 'terms.who_body'|trans|rich }}</p>

    <h2><span class="n">3</span>{% trans %}terms.h3_account{% endtrans %}</h2>
    <ul>
      <li>{% trans %}terms.account_password{% endtrans %}</li>
      <li>{% trans %}terms.account_unauthorised{% endtrans %}</li>
      <li>{% trans %}terms.account_suspend{% endtrans %}</li>
    </ul>

    <h2><span class="n">4</span>{% trans %}terms.h4_using{% endtrans %}</h2>
    <p>{% trans %}terms.using_intro{% endtrans %}</p>
    <ul>
      <li>{% trans %}terms.using_no_illegal{% endtrans %}</li>
      <li>{{ 'terms.using_no_personal'|trans|rich }}</li>
      <li>{% trans %}terms.using_no_reidentify_pre{% endtrans %} <a href="https://wiki.cyclingcommons.org/governance/">{% trans %}terms.using_no_reidentify_link{% endtrans %}</a>{% trans %}terms.using_no_reidentify_post{% endtrans %}</li>
      <li>{% trans %}terms.using_no_scrape_pre{% endtrans %} <a href="{{ path('developers') }}">{% trans %}terms.using_no_scrape_link{% endtrans %}</a>{% trans %}terms.using_no_scrape_post{% endtrans %}</li>
      {# Kept as its own rule: disruption was bundled into the scraping line, and
         the blunter scraping wording must not quietly drop a separate prohibition. #}
      <li>{% trans %}terms.using_no_disrupt{% endtrans %}</li>
    </ul>

    <h2><span class="n">5</span>{% trans %}terms.h5_contributions{% endtrans %}</h2>
    <p>{% trans %}terms.contributions_p1_pre{% endtrans %} <a href="https://github.com/cycling-commons/cycling-commons/blob/main/licenses/COMMONS-TERMS-CLAUSE.md">{% trans %}terms.contributions_p1_link{% endtrans %}</a>{{ 'terms.contributions_p1_mid'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_odbl{% endtrans %}</a>{{ 'terms.contributions_p1_mid2'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_ccbysa{% endtrans %}</a>{{ 'terms.contributions_p1_mid3'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.contributions_p1_agpl{% endtrans %}</a>{% trans %}terms.contributions_p1_post{% endtrans %}</p>
    <p>{% trans %}terms.contributions_p2{% endtrans %}</p>

    <h2><span class="n">6</span>{% trans %}terms.h6_opendata{% endtrans %}</h2>
    <p>{% trans %}terms.opendata_pre{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}terms.opendata_link{% endtrans %}</a>{% trans %}terms.opendata_mid{% endtrans %} <a href="{{ path('developers') }}">{% trans %}terms.opendata_dev_link{% endtrans %}</a>{% trans %}terms.opendata_post{% endtrans %}</p>

    <h2><span class="n">7</span>{% trans %}terms.h7_code{% endtrans %}</h2>
    <p>{{ 'terms.code_pre'|trans|rich }} <a href="{{ path('licenses') }}">{% trans %}terms.code_link{% endtrans %}</a>{{ 'terms.code_post'|trans|rich }} <a href="https://github.com/cycling-commons/cycling-commons/blob/main/TRADEMARK.md">{% trans %}terms.code_brand_link{% endtrans %}</a>{% trans %}terms.code_brand_post{% endtrans %}</p>

    <h2><span class="n">8</span>{% trans %}terms.h8_preview{% endtrans %}</h2>
    <div class="banner">{{ 'terms.preview_body'|trans|rich }}</div>

    <h2><span class="n">9</span>{% trans %}terms.h9_warranty{% endtrans %}</h2>
    <p>{{ 'terms.warranty_body'|trans|rich }}</p>

    <h2><span class="n">10</span>{% trans %}terms.h10_liability{% endtrans %}</h2>
    <p>{% trans %}terms.liability_body{% endtrans %}</p>

    <h2><span class="n">11</span>{% trans %}terms.h11_suspension{% endtrans %}</h2>
    <p>{% trans %}terms.suspension_pre{% endtrans %} <a href="{{ path('settings') }}">{% trans %}terms.suspension_link{% endtrans %}</a>{% trans %}terms.suspension_post{% endtrans %}</p>
    <p>{{ 'terms.suspension_p2'|trans|rich }}</p>

    {# DSA Article 14: the terms must state the content-moderation policies,
       procedures and tools in clear and plain language, including any
       algorithmic decision-making and human review, and the rules of any
       internal complaint handling. Before this the terms said "we may suspend
       or end access" and stopped, and the standard curators actually work to
       lived in a rulebook behind a login, where nobody affected by it could
       read it (docs/TODO.md item 4). #}
    <h2><span class="n">12</span>{% trans %}terms.h12_moderation{% endtrans %}</h2>
    <p>{% trans %}terms.mod_intro{% endtrans %}</p>

    <h3>{% trans %}terms.mod_standard_h{% endtrans %}</h3>
    <ul>
      <li>{{ 'terms.mod_std1'|trans|rich }}</li>
      <li>{{ 'terms.mod_std2'|trans|rich }}</li>
      <li>{{ 'terms.mod_std3'|trans|rich }}</li>
      <li>{{ 'terms.mod_std4'|trans|rich }}</li>
      <li>{{ 'terms.mod_std5'|trans|rich }}</li>
      {# Sixth ground, added 2026-08-28. It sits under "not true" in spirit, but
         a rider will not infer it from there, and a generated photograph of a
         place that does not look like that is now the easiest false thing to
         add to a map. #}
      <li>{{ 'terms.mod_std6'|trans|rich }}</li>
    </ul>

    <h3>{% trans %}terms.mod_who_h{% endtrans %}</h3>
    <p>{{ 'terms.mod_who'|trans|rich }}</p>
    <p>{{ 'terms.mod_automated'|trans|rich }}</p>

    <h3>{% trans %}terms.mod_told_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_told_pre{% endtrans %} <a href="{{ path('messages') }}">{% trans %}terms.mod_told_link{% endtrans %}</a>{% trans %}terms.mod_told_post{% endtrans %}</p>

    <h3>{% trans %}terms.mod_appeal_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_appeal_pre{% endtrans %} <a href="{{ path('contact') }}">{% trans %}terms.mod_appeal_link{% endtrans %}</a>{% trans %}terms.mod_appeal_post{% endtrans %}</p>

    <h3>{% trans %}terms.mod_report_h{% endtrans %}</h3>
    <p>{% trans %}terms.mod_report_pre{% endtrans %} <a href="{{ path('contact') }}?topic=report">{% trans %}terms.mod_report_link{% endtrans %}</a>{% trans %}terms.mod_report_post{% endtrans %}</p>

    {# Article 50 of the EU AI Act starts applying on 2 August 2026 and is about
       telling people when they are reading something a machine produced. Whether
       it reaches a description of a water tap is arguable, and the human-review
       carve-out in 50(4) may well cover us. This section is written the way the
       accessibility statement is: say what is true, do not claim a duty that may
       not apply, and do not claim compliance with anything.

       Kept short and kept honest, because the list is short: one machine
       translator, and a scanner that flags but never decides. If that changes,
       this section changes with it. #}
    <h2><span class="n">13</span>{% trans %}terms.h13_ai{% endtrans %}</h2>
    <p>{% trans %}terms.ai_intro{% endtrans %}</p>
    <ul>
      <li>{{ 'terms.ai_translation'|trans|rich }}</li>
      <li>{{ 'terms.ai_checks'|trans|rich }}</li>
      <li>{{ 'terms.ai_none'|trans|rich }}</li>
    </ul>
    <p>{{ 'terms.ai_uploads'|trans|rich }}</p>
    <p>{{ 'terms.ai_stance'|trans|rich }}</p>

    <h2><span class="n">14</span>{% trans %}terms.h12_governing{% endtrans %}</h2>
    <p>{{ 'terms.governing_body'|trans|rich }}</p>

    <h2><span class="n">15</span>{% trans %}terms.h13_changes{% endtrans %}</h2>
    <p>{% trans %}terms.changes_body{% endtrans %}</p>

    <h2><span class="n">15</span>{% trans %}terms.h14_contact{% endtrans %}</h2>
    <p>{% trans %}terms.contact_pre{% endtrans %} <a href="mailto:info@cyclingcommons.org">info@cyclingcommons.org</a> ({{ 'support.legal.or_form'|trans }} <a href="{{ path('contact') }}">{{ 'support.contact.title_short'|trans }}</a>){% trans %}terms.contact_post{% endtrans %}</p>

    <div class="disc" style="margin:2rem 0 0">{% trans %}terms.footer_disc_pre{% endtrans %} <a href="{{ path('privacy') }}">{% trans %}terms.footer_disc_privacy{% endtrans %}</a> {% trans %}terms.footer_disc_mid{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}terms.footer_disc_licences{% endtrans %}</a>{% trans %}terms.footer_disc_post{% endtrans %}</div>
  </div>
</div></section>
{% endblock %}
