{# SPDX-License-Identifier: AGPL-3.0-only #}
{% extends 'base.html.twig' %}
{# The notice's text is translations/privacy.<locale>.yaml, its own domain,
   outside the in-site translation system (docs/specs/privacy-notice.md). #}
{% trans_default_domain 'privacy' %}
{#
  `/settings` is behind the firewall, so linking it to a signed-out reader sends
  them to a login form for a page they were only being told about (owner,
  2026-08-27: "links to nowhere/login form when not logged in"). Signed in it is
  useful, so the link stays for them and the same words are plain text for
  everyone else.
#}
{% macro settings_link(key) %}
  {%- if app.user -%}
    <a href="{{ path('settings') }}">{{ key|trans({}, 'privacy') }}</a>
  {%- else -%}
    {{ key|trans({}, 'privacy') }}
  {%- endif -%}
{% endmacro %}
{% import _self as priv %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/privacy.css') }}">
{% endblock %}
{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}privacy.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}privacy.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'privacy.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="legal">
    <p class="upd" data-privacy-version="{{ privacy_current.number }}">{{ 'privacy.version_line'|trans({'%n%': privacy_current.number, '%date%': privacy_current.date|cc_date}) }}</p>

    <h2>{% trans %}privacy.h_responsible{% endtrans %}</h2>
    <p>{% trans %}privacy.responsible_p1_pre{% endtrans %} <b>{% trans %}privacy.responsible_p1_bikecoders{% endtrans %}</b> (<a href="https://bikecoders.life">bikecoders.life</a>){% trans %}privacy.responsible_p1_mid{% endtrans %} <a href="https://wiki.cyclingcommons.org/governance/">{% trans %}privacy.responsible_p1_governance{% endtrans %}</a>{{ 'privacy.responsible_p1_post'|trans|rich }}</p>
    <p>{% trans %}privacy.responsible_p2_pre{% endtrans %} <a href="mailto:info@cyclingcommons.org">info@cyclingcommons.org</a> ({{ 'support.legal.or_form'|trans({}, 'messages') }} <a href="{{ path('contact') }}?topic=privacy">{{ 'support.contact.title_short'|trans({}, 'messages') }}</a>){% trans %}privacy.responsible_p2_mid{% endtrans %} <a href="https://autoriteitpersoonsgegevens.nl/">{% trans %}privacy.responsible_p2_ap{% endtrans %}</a>{% trans %}privacy.responsible_p2_post{% endtrans %}</p>
    {# GDPR Art. 37 does not oblige us to appoint a DPO, but a notice that says
       nothing leaves the reader guessing. Saying "no, and here is the address
       instead" is the convention and answers the question outright. #}
    <p>{{ 'privacy.dpo_pre'|trans|rich }} <a href="mailto:info@cyclingcommons.org">info@cyclingcommons.org</a> ({{ 'support.legal.or_form'|trans({}, 'messages') }} <a href="{{ path('contact') }}?topic=privacy">{{ 'support.contact.title_short'|trans({}, 'messages') }}</a>){% trans %}privacy.dpo_post{% endtrans %}</p>

    <h2>{% trans %}privacy.h_collect{% endtrans %}</h2>
    <p>{% trans %}privacy.collect_intro{% endtrans %}</p>
    <h3>{% trans %}privacy.h3_account{% endtrans %}</h3>
    <ul>
      <li>{{ 'privacy.collect_account_email'|trans|rich }}</li>
      <li>{{ 'privacy.collect_account_password'|trans|rich }}</li>
      <li>{{ 'privacy.collect_account_displayname'|trans|rich }}</li>
      <li>{{ 'privacy.collect_account_2fa'|trans|rich }}</li>
      <li>{{ 'privacy.collect_account_base'|trans|rich }}</li>
      <li>{{ 'privacy.collect_account_timezone'|trans|rich }}</li>
    </ul>
    <h3>{% trans %}privacy.h3_contribute{% endtrans %}</h3>
    <ul>
      <li>{{ 'privacy.collect_contribute_items'|trans|rich }}</li>
      <li>{{ 'privacy.collect_contribute_media'|trans|rich }}</li>
      {# docs/specs/traffic-measurements.md: only what the rider sends from Scout's review. #}
      <li>{{ 'privacy.collect_contribute_traffic'|trans|rich }}</li>
      <li>{% trans %}privacy.collect_contribute_profile{% endtrans %} {{ priv.settings_link('privacy.collect_contribute_profile_link') }}{% trans %}privacy.collect_contribute_profile_post{% endtrans %}</li>
    </ul>
    <h3>{% trans %}privacy.h3_auto{% endtrans %}</h3>
    <ul data-collect-auto>
      <li>{{ 'privacy.collect_auto_technical'|trans|rich }}</li>
      {# Hashing the address is pseudonymisation, not anonymisation: the counter
         is still personal data, so it is disclosed like everything else. #}
      <li>{{ 'privacy.collect_auto_ratelimit'|trans|rich }}</li>
      {# Server-side only; config/packages/sentry.yaml keeps the IP address,
         the user and every request body out (ErrorReportPrivacyTest). #}
      <li>{{ 'privacy.collect_auto_errors'|trans|rich }}</li>
    </ul>
    <div class="banner">
      <p><b>{% trans %}privacy.banner_bold{% endtrans %}</b> {{ 'privacy.banner_body'|trans|rich }}</p>
      <p>{{ 'privacy.banner_locate'|trans|rich }}</p>
    </div>

    <h2>{% trans %}privacy.h_why{% endtrans %}</h2>
    <ul>
      <li>{{ 'privacy.why_contract'|trans|rich }}</li>
      <li>{{ 'privacy.why_consent'|trans|rich }} {{ priv.settings_link('privacy.why_consent_link') }}{% trans %}privacy.why_consent_post{% endtrans %}</li>
      {# These were one bullet, and that was wrong: it read as though the photo
         could be withdrawn along with the name. CC BY-SA 4.0 is irrevocable by
         its own terms (photo-uploads.md 6b), so the two promises are different
         and are now made separately. #}
      <li>{{ 'privacy.why_licence'|trans|rich }}</li>
      {# The release list is the only mail a rider chooses rather than needs, so
         it is the only one that runs on consent and has to say so. #}
      <li>{{ 'privacy.why_updates'|trans|rich }}</li>
      <li>{{ 'privacy.why_legitimate'|trans|rich }}</li>
      <li>{{ 'privacy.why_legal'|trans|rich }}</li>
    </ul>

    <h2>{% trans %}privacy.h_cookies{% endtrans %}</h2>
    <p>{{ 'privacy.cookies_body'|trans|rich }}</p>
    {# Claiming "a single essential cookie" without naming it is unverifiable.
       Both names were read off a live response, not off the config: the session
       cookie has no `framework.session.name`, so it is PHP's default, and the
       remember-me lifetime is `security.yaml`'s 604800 s. `main_auth_profile_token`
       and `sf_redirect` also appear in dev - they are the Symfony profiler's and
       do not exist in production, so they are deliberately absent here. #}
    <h3>{% trans %}privacy.h3_cookie_table{% endtrans %}</h3>
    <div class="ptw"><table class="ptab">
      <thead><tr>
        <th scope="col">{% trans %}privacy.ck_h_name{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.ck_h_purpose{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.ck_h_life{% endtrans %}</th>
      </tr></thead>
      <tbody>
        <tr>
          <td><code>PHPSESSID</code></td>
          <td>{{ 'privacy.ck_session_purpose'|trans|rich }}</td>
          <td>{% trans %}privacy.ck_session_life{% endtrans %}</td>
        </tr>
        <tr>
          <td><code>REMEMBERME</code></td>
          <td>{{ 'privacy.ck_remember_purpose'|trans|rich }}</td>
          <td>{% trans %}privacy.ck_remember_life{% endtrans %}</td>
        </tr>
      </tbody>
    </table></div>
    <p>{{ 'privacy.cookies_none_body'|trans|rich }}</p>
    <p>{{ 'privacy.cookies_local_body'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_share{% endtrans %}</h2>
    {# The lists below are short because of work that is otherwise invisible:
       routing and elevation came back in-house in 2026 (security-architecture.md
       2.3 records the two hosts that left the policy with them), the analytics
       are self-hosted, the photos are ours. Saying so is not boasting, it is the
       reason a rider's browser talks to five outside services instead of twenty. #}
    <p>{{ 'privacy.share_selfhosted'|trans|rich }}</p>
    <ul>
      <li>{{ 'privacy.share_infra'|trans|rich }}</li>
      <li>{% trans %}privacy.share_osm_pre{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}privacy.share_osm_link{% endtrans %}</a>{% trans %}privacy.share_osm_post{% endtrans %}</li>
      <li>{{ 'privacy.share_noone'|trans|rich }}</li>
    </ul>

    {# "such as the map library CDN and Mapillary" is what an access request
       will not accept. Both tables are the CSP host table (security-architecture.md
       2.3) and the infrastructure spec (media-storage-architecture.md 2) written
       out for a rider: nothing may be fetched that is not enumerated there, so
       these two lists are complete by construction. Adding a third-party host
       means adding a row here in the same change. #}
    <h3>{% trans %}privacy.h3_processors{% endtrans %}</h3>
    <p>{{ 'privacy.processors_intro'|trans|rich }}</p>
    <div class="ptw"><table class="ptab ptab--proc">
      <thead><tr>
        <th scope="col">{% trans %}privacy.pr_h_who{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.pr_h_where{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.pr_h_what{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.pr_h_sees{% endtrans %}</th>
      </tr></thead>
      <tbody>
        <tr>
          <td><a href="https://www.hetzner.com/legal/privacy-policy/">Hetzner Online GmbH</a></td>
          <td>{% trans %}privacy.pr_hetzner_where{% endtrans %}</td>
          <td>{{ 'privacy.pr_hetzner_what'|trans|rich }}</td>
          <td>{{ 'privacy.pr_hetzner_sees'|trans|rich }}</td>
        </tr>
        <tr>
          <td><a href="https://www.scaleway.com/en/privacy-policy/">Scaleway SAS</a></td>
          <td>{% trans %}privacy.pr_scaleway_where{% endtrans %}</td>
          <td>{{ 'privacy.pr_scaleway_what'|trans|rich }}</td>
          <td>{{ 'privacy.pr_scaleway_sees'|trans|rich }}</td>
        </tr>
        {# The mailbox is a processor too, and the easiest one to forget: no
           code touches it, so it never shows up in a grep of the repo. Anyone
           who writes to the address on this page has their message sitting
           there (owner, 2026-08-27). #}
        <tr>
          <td><a href="https://proton.me/legal/privacy">Proton AG</a></td>
          <td>{% trans %}privacy.pr_proton_where{% endtrans %}</td>
          <td>{{ 'privacy.pr_proton_what'|trans|rich }}</td>
          <td>{{ 'privacy.pr_proton_sees'|trans|rich }}</td>
        </tr>
      </tbody>
    </table></div>

    <h3>{% trans %}privacy.h3_browser_services{% endtrans %}</h3>
    <p>{{ 'privacy.browser_services_intro'|trans|rich }}</p>
    <div class="ptw"><table class="ptab">
      <thead><tr>
        <th scope="col">{% trans %}privacy.bs_h_service{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.bs_h_what{% endtrans %}</th>
        <th scope="col">{% trans %}privacy.bs_h_sees{% endtrans %}</th>
      </tr></thead>
      <tbody>
        <tr>
          <td><a href="https://openfreemap.org/">OpenFreeMap</a></td>
          <td>{{ 'privacy.bs_openfreemap_what'|trans|rich }}</td>
          <td>{{ 'privacy.bs_sees_ip'|trans|rich }}</td>
        </tr>
        <tr>
          <td><a href="https://www.esri.com/en-us/privacy/overview">Esri</a></td>
          <td>{{ 'privacy.bs_esri_what'|trans|rich }}</td>
          <td>{{ 'privacy.bs_esri_sees'|trans|rich }}</td>
        </tr>
        <tr>
          <td><a href="https://www.mapillary.com/">Mapillary</a></td>
          <td>{{ 'privacy.bs_mapillary_what'|trans|rich }}</td>
          <td>{{ 'privacy.bs_mapillary_sees'|trans|rich }}</td>
        </tr>
        <tr>
          <td><a href="https://photon.komoot.io/">Photon</a></td>
          <td>{{ 'privacy.bs_photon_what'|trans|rich }}</td>
          <td>{{ 'privacy.bs_photon_sees'|trans|rich }}</td>
        </tr>
      </tbody>
    </table></div>
    <p>{{ 'privacy.browser_services_post'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_transfers{% endtrans %}</h2>
    <p>{{ 'privacy.transfers_body'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_retention{% endtrans %}</h2>
    <ul>
      <li>{{ 'privacy.retention_account'|trans|rich }}</li>
      <li>{{ 'privacy.retention_unconfirmed'|trans|rich }}</li>
      <li>{{ 'privacy.retention_logs'|trans|rich }}</li>
      <li>{{ 'privacy.retention_ratelimit'|trans|rich }}</li>
      <li>{{ 'privacy.retention_contributions'|trans|rich }}</li>
      <li>{{ 'privacy.retention_traffic'|trans|rich }}</li>
      {# Threads live as long as the account (owner 2026-10-01,
         ContributionDeletionHook); Trash keeps a row 30 days, then the purge
         (TrashBin::TRASH_DAYS, moderation-and-contribution.md §6, §8). #}
      <li>{{ 'privacy.retention_messages'|trans|rich }}</li>
      {# GDPR Art. 13(2)(a) requires the retention period to be STATED, and the
         consent ledger is the one store the app keeps indefinitely on purpose
         (docs/specs/photo-uploads.md §4). Leaving it undisclosed while the
         erasure bullet promised "permanent" was the actual gap. #}
      <li>{{ 'privacy.retention_consent'|trans|rich }}</li>
      {# Art. 13(2)(a) wants a period or the criteria for one. A mailbox thread
         has no fixed length, but it does have an end, so the criteria are
         "while it is open" and the period runs from there (owner, 2026-08-27:
         24 months). #}
      <li>{{ 'privacy.retention_mail'|trans|rich }}</li>
      {# The bug report address takes the mail period, counted from the outcome
         (contact-and-support.md §5, BugReporterEmailRetention). #}
      <li>{{ 'privacy.retention_bugs'|trans|rich }}</li>
      {# A content report's or photo request's reply address: 90 days after the
         decision, never under legal hold (content-reports.md §10,
         ReportContactRetention, MediaTakedownService). #}
      <li>{{ 'privacy.retention_reports'|trans|rich }}</li>
      <li>{{ 'privacy.retention_updates'|trans|rich }}</li>
    </ul>

    {# Art. 32 is not in Art. 13's mandatory list, but a notice that describes
       what it holds and never says how it is guarded reads as if nothing is.
       Every claim below is a built thing with a file behind it, not an
       aspiration: account-and-auth.md 4 (secret material at rest),
       security-architecture.md 2 (CSP and headers), media-storage-architecture.md
       6 (scanning and quarantine). #}
    <h2>{% trans %}privacy.h_security{% endtrans %}</h2>
    <p>{{ 'privacy.security_intro'|trans|rich }}</p>
    <ul>
      <li>{{ 'privacy.security_passwords'|trans|rich }}</li>
      <li>{{ 'privacy.security_secrets'|trans|rich }}</li>
      <li>{{ 'privacy.security_transport'|trans|rich }}</li>
      <li>{{ 'privacy.security_access'|trans|rich }}</li>
    </ul>
    {# Owner's call 2026-08-27: four plain sentences here, the full Art. 32 list
       in security-architecture.md 8. Naming AES-256-GCM and HSTS on a page
       written for riders helped nobody who reads it and gave four more lines to
       keep true; the people who want that detail can read the source, and this
       paragraph tells them where. #}
    <p>{% trans %}privacy.security_source_pre{% endtrans %} <a href="https://github.com/cycling-commons/cycling-commons">{% trans %}privacy.security_source_link{% endtrans %}</a>{% trans %}privacy.security_source_post{% endtrans %}</p>
    <p>{{ 'privacy.security_honest'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_breach{% endtrans %}</h2>
    <p>{% trans %}privacy.breach_pre{% endtrans %} <a href="https://autoriteitpersoonsgegevens.nl/">{% trans %}privacy.breach_ap{% endtrans %}</a>{{ 'privacy.breach_post'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_rights{% endtrans %}</h2>
    <p>{{ 'privacy.rights_intro'|trans|rich }}</p>
    <ul>
      <li>{{ 'privacy.rights_access'|trans|rich }}</li>
      <li>{{ 'privacy.rights_correct'|trans|rich }}</li>
      <li>{{ 'privacy.rights_erase'|trans|rich }}</li>
      <li>{{ 'privacy.rights_portability'|trans|rich }}</li>
      <li>{{ 'privacy.rights_restrict'|trans|rich }}</li>
      <li>{{ 'privacy.rights_withdraw'|trans|rich }}</li>
      {# The non-user route (docs/specs/photo-uploads.md §6c): Art. 17 does not
         depend on having an account, and this page must not imply it does. #}
      <li>{{ 'privacy.rights_third_party_photo'|trans|rich }}</li>
    </ul>
    <p>{% trans %}privacy.rights_contact_pre{% endtrans %} <a href="mailto:info@cyclingcommons.org">info@cyclingcommons.org</a> ({{ 'support.legal.or_form'|trans({}, 'messages') }} <a href="{{ path('contact') }}?topic=privacy">{{ 'support.contact.title_short'|trans({}, 'messages') }}</a>){% trans %}privacy.rights_contact_mid{% endtrans %} <a href="https://autoriteitpersoonsgegevens.nl/">{% trans %}privacy.rights_contact_ap{% endtrans %}</a>{% trans %}privacy.rights_contact_post{% endtrans %}</p>

    <h2>{% trans %}privacy.h_children{% endtrans %}</h2>
    <p>{{ 'privacy.children_body'|trans|rich }}</p>

    <h2>{% trans %}privacy.h_automated{% endtrans %}</h2>
    <p>{% trans %}privacy.automated_body{% endtrans %}</p>

    <h2>{% trans %}privacy.h_changes{% endtrans %}</h2>
    <p>{% trans %}privacy.changes_body{% endtrans %}</p>
    {# Every version, newest first, with what changed (App\Legal\PrivacyNoticeVersions). #}
    <div id="changes">
      <ol class="pversions">
        {% for v in privacy_versions %}
          <li data-version="{{ v.number }}">
            <b>{{ 'privacy.version_line'|trans({'%n%': v.number, '%date%': v.date|cc_date}) }}</b>
            <ul>{% for c in v.changes %}<li>{{ c|trans|rich }}</li>{% endfor %}</ul>
          </li>
        {% endfor %}
      </ol>
    </div>
    {# The history of this language's text file: every change to the notice
       in this language, line by line, with its date and commit message. #}
    <p>{% trans %}privacy.changes_versions_pre{% endtrans %} <a href="https://github.com/cycling-commons/cycling-commons/commits/main/web/translations/privacy.{{ app.request.locale }}.yaml">{% trans %}privacy.changes_versions_link{% endtrans %}</a>{% trans %}privacy.changes_versions_post{% endtrans %}</p>

    <div class="disc" style="margin:2rem 0 0">{% trans %}privacy.footer_disc_pre{% endtrans %} <a href="{{ path('terms') }}">{% trans %}privacy.footer_disc_terms{% endtrans %}</a> {% trans %}privacy.footer_disc_mid{% endtrans %} <a href="{{ path('licenses') }}">{% trans %}privacy.footer_disc_licences{% endtrans %}</a>{% trans %}privacy.footer_disc_post{% endtrans %}</div>
  </div>
</div></section>
{% endblock %}
