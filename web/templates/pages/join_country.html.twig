{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  /* h1.disp (atlas.css) carries no bottom margin, so whatever follows sits
     flush against it — the success flash under "Your application is in" read as
     part of the heading. Scoped here rather than changed globally: every other
     page's spacing is somebody else's decision. */
  main h1.disp{margin-bottom:1.5rem}
  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  /* Decorative required marker — the input's `required` attribute is what
     assistive tech announces, so the star is aria-hidden. */
  .field label .req{color:var(--trail);font-size:.95em;margin-left:.1rem}
  .field input[type=text],.field input[type=password],.field input:not([type]),.field textarea{width:100%;background:transparent;border:1.5px solid rgba(20,22,14,.25);border-radius:6px;font-family:var(--sans);font-size:1rem;padding:.55rem .7rem;outline:none;color:var(--ink)}
  .field textarea{min-height:100px;resize:vertical}
  .field select{width:100%;max-width:22rem;padding:.5rem .6rem}
  .field input:focus,.field textarea:focus,.field select:focus{border-color:var(--trail)}
  .field.check label{display:flex;align-items:center;gap:.5rem;font-family:var(--sans);font-size:.95rem;letter-spacing:normal;text-transform:none;color:var(--ink)}
  .hint{font-family:var(--sans);font-size:1rem;color:#6b6e5c;margin:.8rem 0 1.4rem;line-height:1.6}
  .intro{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem 2rem;align-items:center;margin:0 0 1.4rem}
  .intro .hint{margin:0}
  .intro .btn{white-space:nowrap;text-decoration:none}
  @media(max-width:640px){.intro{grid-template-columns:1fr}.intro .btn{justify-self:start}}
  /* Its own panel, so the two things this page offers do not read as one long
     form. The lighter ground says "this one asks less of you" without a second
     heading level having to say it. */
  .askregion{background:var(--paper-deep);border-radius:8px;padding:1.3rem 1.4rem;margin:0 0 2.2rem}
  .askregion h2{font-family:var(--serif);font-size:1.12rem;font-weight:600;margin:0 0 .4rem;color:var(--ink)}
  .askregion .hint{margin:0 0 1.1rem}
  .askregion .field:last-of-type{margin-bottom:1rem}
  .curate-h{font-family:var(--serif);font-size:1.12rem;font-weight:600;margin:0 0 1rem;color:var(--ink)}
  .hint a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
  .form-error,.flash-error{background:rgba(179,38,30,.1);border-left:3px solid var(--danger);color:var(--danger-ink);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--trail);color:#1f3a2c;padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
</style>
{% endblock %}
{% block body %}
{# The dark hero every page of this kind has. Without it the heading sat
   straight under the nav, and the green band above it was the nav ending
   rather than a header (owner, 2026-08-28). #}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'join.kicker'|trans }}</div>
  {% if onboarded %}
    {# Say the region's name back when they arrived from its page. The
       country-level headline ("Nobody is curating Netherlands yet") is both
       wrong and discouraging for someone who came from North Holland to
       volunteer for North Holland: the country may well have a curator
       already, and it is the region that is short of one. #}
    <h1 class="disp">{{ pending_app
      ? 'join.pending_h'|trans
      : (wanted
        ? 'join.headline_curate_region'|trans({'%region%': wanted.name})
        : 'join.headline_curate'|trans({'%country%': country.name})) }}</h1>
  {% else %}
    <h1 class="disp">{{ 'join.headline_request'|trans({'%country%': country.name}) }}</h1>
  {% endif %}
</div></div>

{# The wrap keeps the page's width; only the text column is capped, from the
   left, like the report page (owner 2026-09-08: "smaller, center aligned?"). #}
<main class="wrap" style="padding-top:2.5rem;padding-bottom:3.5rem"><div style="max-width:760px">
  {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}

  {# Not beside the pending block: that block already thanks them and says what
     happens next, so the flash would be the third telling on one screen. Still
     drained either way, so it cannot reappear on the next page. #}
  {% for msg in app.flashes('success') %}{% if not pending_app %}<p class="flash-success" role="alert">{{ msg }}</p>{% endif %}{% endfor %}
  {% for msg in app.flashes('error') %}<p class="flash-error" role="alert">{{ msg }}</p>{% endfor %}

  {% if not onboarded %}
    <form method="post" data-form="country-interest">
      {# The form names itself, so the controller does not have to guess from
         which fields arrived which of the two this is. #}
      <input type="hidden" name="form" value="country-interest">
      <input type="hidden" name="_token" value="{{ csrf_token('country-interest') }}">
      <div class="field">
        <label for="note">{{ 'join.note_label'|trans }}</label>
        <textarea id="note" name="note" maxlength="280"></textarea>
      </div>
      <div class="field check">
        <label><input type="checkbox" name="willing" value="1"> {{ 'join.willing_label'|trans }}</label>
      </div>
      <button type="submit" class="btn btn-p">{{ 'join.submit_request'|trans }}</button>
    </form>
  {% elseif pending_app %}
    {# Already with the curators: their application back, not the form again. #}
    {# The SAME words the email carries (join.message.received), not a second
       telling of the same thing: two wordings for one fact is how a page and
       an inbox start disagreeing, and it read as doubled copy under a heading
       that had already said it. #}
    {% set asked = regions|filter(r => r.id == pending_app.requested_region_id)|first %}
    <p class="hint" style="margin-top:0">
      {{ 'join.message.received'|trans({'%scope%': asked ? asked.name : country.name}) }}
    </p>
  {% else %}
    {# An onboarded country still has parts nobody covers, and until now the
       page had nothing for a rider who lives in one: the only form on offer
       asked them to run the place (owner 2026-09-13, "USA we have states at
       the region level"). It is first because it asks least. #}
    <section class="askregion">
      <h2>{{ 'join.region_ask_h'|trans({'%country%': country.name}) }}</h2>
      <p class="hint">{{ 'join.region_ask_p'|trans }}</p>
      <form method="post" data-form="country-interest">
        <input type="hidden" name="form" value="country-interest">
        <input type="hidden" name="_token" value="{{ csrf_token('country-interest') }}">
        <div class="field">
          <label for="region_name">{{ 'join.region_name_label'|trans }} <span class="req" aria-hidden="true">*</span></label>
          {# Free text, not the picker below: the area being asked for has no
             region row yet, which is the reason somebody is asking. #}
          <input id="region_name" name="region_name" maxlength="120" required
                 placeholder="{{ 'join.region_name_placeholder'|trans|e('html_attr') }}"
                 value="{{ sent.region_name|default(area_prefill|default('')) }}">
        </div>
        <div class="field">
          <label for="region_note">{{ 'join.note_label'|trans }}</label>
          <textarea id="region_note" name="note" maxlength="280">{{ sent.note|default('') }}</textarea>
        </div>
        <div class="field check">
          <label><input type="checkbox" name="willing" value="1"> {{ 'join.willing_label'|trans }}</label>
        </div>
        <button type="submit" class="btn btn-g">{{ 'join.submit_region'|trans }}</button>
      </form>
    </section>

    <h2 class="curate-h">{{ 'join.curate_h'|trans }}</h2>
    {# Under the curator heading, not at the top of the page (owner 2026-09-14):
       it speaks to somebody putting themselves forward, and above the area
       request it read as a condition for asking about a place. Two columns
       (owner 2026-09-08): the words on the left, and on the right one outlined
       button to the page that explains the roles. This branch already means
       onboarded with no application pending, so it needs no condition of its
       own. #}
    <div class="intro">
      <p class="hint">{{ 'join.evidence_hint'|trans }}</p>
      <a class="btn btn-g" href="{{ path('roles') }}">{{ 'join.roles_link'|trans }}</a>
    </div>
    <form method="post" data-form="curator-application">
      <input type="hidden" name="form" value="curator-application">
      <input type="hidden" name="_token" value="{{ csrf_token('curator-application') }}">
      <div class="field">
        <label for="region">{{ 'join.scope_label'|trans }}</label>
        <select id="region" name="region">
          {# A rejected submit re-renders with what they chose, not with the
             query-string default: losing the selection would be a second
             punishment for one typo. #}
          {% set picked = sent.region is defined and sent.region is not empty ? sent.region : (wanted ? wanted.id : null) %}
          <option value=""{{ picked ? '' : ' selected' }}>{{ 'join.scope_whole_country'|trans }}</option>
          {% for r in regions %}<option value="{{ r.id }}"{{ picked == r.id ? ' selected' : '' }}>{{ r.name }}</option>{% endfor %}
          {# Areas the Commons has no region for. Somebody willing to run one
             is the strongest argument for adding it, and without these the
             only thing they could volunteer for was the whole country. The
             `new:` prefix is what tells the controller this is a name and not
             an id. #}
          {% if unmapped_areas is not empty %}
            <optgroup label="{{ 'join.scope_not_yet'|trans|e('html_attr') }}">
              {% for name in unmapped_areas %}
                <option value="new:{{ name }}"{{ picked == 'new:' ~ name ? ' selected' : '' }}>{{ name }}</option>
              {% endfor %}
            </optgroup>
          {% endif %}
        </select>
      </div>
      <div class="field">
        <label for="osm">{{ 'join.osm_label'|trans }}</label>
        <input id="osm" name="osm" maxlength="64" value="{{ sent.osm|default('') }}">
      </div>
      <div class="field">
        <label for="social">{{ 'join.social_label'|trans }}</label>
        <input id="social" name="social" maxlength="255" inputmode="url" value="{{ sent.social|default('') }}">
      </div>
      <div class="field">
        <label for="about">{{ 'join.about_label'|trans }} <span class="req" aria-hidden="true">*</span></label>
        <textarea id="about" name="about" maxlength="1200" required>{{ sent.about|default('') }}</textarea>
      </div>
      {# Confirm the password only when the session is merely remembered, and
         only HERE, at the moment of commitment. Asking at the door is what made
         no sense: this is a form somebody thinks about and fills in. By the
         time they press the button they have decided, and putting a name
         forward as a curator should not be possible from an unattended
         browser. #}
      {% if needs_reauth %}
        <div class="field">
          <label for="password">{{ 'join.password_label'|trans }} <span class="req" aria-hidden="true">*</span></label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
          <p class="hint" style="margin:.4rem 0 0;font-size:.90rem">{{ 'join.password_hint'|trans }}</p>
        </div>
      {% endif %}
      <button type="submit" class="btn btn-p">{{ 'join.submit_application'|trans }}</button>
    </form>
  {% endif %}
</div></main>
{% endblock %}
