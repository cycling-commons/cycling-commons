{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .cgroup{margin-top:2.6rem}
  .cgroup:first-child{margin-top:0}
  .cgroup h3{font-family:var(--serif);font-weight:600;font-size:1.45rem}
  .cgroup .gsub{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);margin:.2rem 0 .4rem}
  .crow{display:grid;grid-template-columns:minmax(190px,250px) 1fr;gap:.4rem 1.4rem;padding:1rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .crow:last-child{border-bottom:0}
  .crow .who a{font-weight:600;text-decoration:none;border-bottom:1px solid var(--trail)}
  .crow .who .lic{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d;margin-top:.3rem}
  .crow p{font-size:.92rem;color:#3a3d30;margin:0}
  /* Rows whose text is a LEGALLY REQUIRED notice, not a thank-you. The mark
     exists for the next editor: twice in one week a mandated text was nearly
     revised as if it were courtesy copy (the Copernicus notice both times).
     Everything else on this page can be reworded; these rows cannot.
     It is a quiet asterisk, not a badge: the owner's call (2026-08-27) is that
     a loud pill on half the rows shouts a reminder nobody outside the project
     needs. The asterisk links down to .legend at the foot of the page, and the
     .vh span carries the wording for screen readers, which get nothing from a
     bare "*". */
  .crow .who a.req{font-weight:400;font-size:.95rem;line-height:1;color:var(--clay);vertical-align:super;margin-left:.15rem;border-bottom:0;text-decoration:none}
  .crow .who a.req:hover{color:var(--ochre)}
  .vh{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  /* The full dependency list. It is one long comma-separated run on purpose:
     forty more .crow rows would out-shout the named credits above it, and the
     point here is completeness, not prominence. */
  .pkglist{margin-top:.7rem;font-size:.86rem;line-height:1.85;color:#4a4d40}
  .pkglist a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(20,22,14,.22)}
  .pkglist a:hover{border-bottom-color:var(--trail)}
  .legend{font-size:.82rem;color:#595c4d;margin:2.4rem 0 0;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.1)}
  .legend .reqkey{color:var(--clay);margin-right:.35rem}
  @media(max-width:640px){.crow{grid-template-columns:1fr;gap:.3rem}}
  .cnote{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1rem 1.2rem;border-radius:0 8px 8px 0;font-size:.90rem;color:#4a4d40;margin-top:2.4rem}
</style>
{% endblock %}
{% block body %}
<div class="chero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}credits.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}credits.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}credits.lead{% endtrans %}</p>
</div></div>

<section class="pad"><div class="wrap">

  {# EVERY ROW IN THIS GROUP IS TEMPORARY.
     When App\Provider lands, these hand-written dataset rows are replaced by
     one loop over credited_providers() (App\Twig\ProviderCreditsExtension),
     so a provider admitted at /moderate/providers reaches this page with
     nobody editing a template. A hand-written row for a dataset the registry
     also carries is then a duplicate and must go in the same change, the
     parked rows included: the owner's call is that those are deleted by hand
     at the switchover, not restored.
     The wording is NOT lost: the registry carries a blurb_key pointing at the
     message key each row already uses, so credits.osm_p and the rest keep all
     five translations. Do not delete a translation key during that sweep.
     Do not add a dataset row here without reading
     docs/specs/credits-page.md §8 and data-provider-hierarchy.md §9 first.
     The groups BELOW this one (map, software, type) are not affected. The line
     is HOW A SOURCE REACHES US, not what kind of thing it is: a dataset we
     import on a schedule is a provider, anything fetched on demand per request
     is not. So Mapillary, Esri, OpenFreeMap and Photon stay hand-written with
     their hand-placed markers, and the #credits-req footnote is still needed
     after the migration. credits-page.md §8.8 has the row-by-row table. #}
  <div class="cgroup">
    <h3>{% trans %}credits.data_h{% endtrans %}</h3>
    <div class="gsub">{% trans %}credits.data_sub{% endtrans %}</div>
    <div class="crow">
      <div class="who"><a href="https://www.openstreetmap.org/copyright" data-pkg="manual:openstreetmap-data">OpenStreetMap</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">ODbL 1.0 · © OpenStreetMap contributors</span></div>
      <p>{% trans %}credits.osm_p{% endtrans %}</p>
    </div>
    {# Every region boundary on the site is an Overture `divisions` polygon:
       271 of 271 region rows carry source='overture'. The theme is ODbL
       (it conflates OSM with geoBoundaries), so this credit is required, not
       courtesy. Release pinned in tools/divisions/config.py:OVERTURE_RELEASE;
       bumping it is a versioned re-import, and the year below moves with it. #}
    <div class="crow">
      <div class="who"><a href="https://overturemaps.org/" data-pkg="manual:overture-divisions">Overture Maps Foundation</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">ODbL 1.0 · © Overture Maps Foundation · © OpenStreetMap contributors</span></div>
      <p>{% trans %}credits.overture_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://geoportail.wallonie.be/" data-pkg="manual:wallonia-pivot">Géoportail de la Wallonie · PIVOT</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">{% trans %}credits.lic_open_data{% endtrans %}</span></div>
      <p>{% trans %}credits.wallonia_p{% endtrans %}</p>
    </div>
    {# Hidden with the Drinkwaterkaart row above (owner, 2026-08-27): nothing in
       the code reads the Georegister yet, so crediting it as a source was a
       claim about the future on a page whose job is to be true. The text is
       already corrected in the catalogs and names the creator, so this comes
       back with the tap ingest (data-provider-hierarchy.md, phase 5) rather
       than being re-decided. See "Drinkwaterkaart.nl" in docs/TODO.md.
    <div class="crow">
      <div class="who"><a href="https://www.nationaalgeoregister.nl/" data-pkg="manual:nl-georegister">Nationaal Georegister (NL)</a><span class="lic">Public Domain Mark 1.0</span></div>
      <p>{% trans %}credits.georegister_p{% endtrans %}</p>
    </div>
    #}
    <div class="crow">
      <div class="who"><a href="https://www.geofabrik.de/" data-pkg="manual:geofabrik-extracts">Geofabrik</a><span class="lic">{% trans %}credits.lic_osm_extracts{% endtrans %}</span></div>
      <p>{% trans %}credits.geofabrik_p{% endtrans %}</p>
    </div>
    {# Drinkwaterkaart.nl is hidden until its developer has been asked (owner,
       2026-08-26). We link riders to it and credit it here, but nobody has
       spoken to them yet, and the owner wants that conversation to happen
       before the site keeps sending them traffic. Its map link in
       assets/map/drawer.js is commented out with it, and credits.lic_linked
       and credits.drinkwater_p stay in the catalogs so both come back
       together. See "Drinkwaterkaart.nl" in docs/TODO.md.
    <div class="crow">
      <div class="who"><a href="https://www.drinkwaterkaart.nl/" data-pkg="manual:drinkwaterkaart-link">Drinkwaterkaart.nl</a><span class="lic">{% trans %}credits.lic_linked{% endtrans %}</span></div>
      <p>{% trans %}credits.drinkwater_p{% endtrans %}</p>
    </div>
    #}
    <div class="crow">
      <div class="who"><a href="https://commons.wikimedia.org/" data-pkg="manual:wikimedia-commons">Wikimedia Commons</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">{% trans %}credits.lic_per_photo{% endtrans %}</span></div>
      <p>{% trans %}credits.wikimedia_p{% endtrans %}</p>
    </div>
    {# CC BY-SA requires attribution wherever the text is reused; each region
       page carries its own per-article line, and this row is the site-wide
       half of that credit. #}
    <div class="crow">
      <div class="who"><a href="https://www.wikipedia.org/" data-pkg="manual:wikipedia">Wikipedia</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">CC BY-SA 4.0</span></div>
      <p>{% trans %}credits.wikipedia_p{% endtrans %}</p>
    </div>
    {# The Copernicus programme's licence conditions require this credit on
       derived products, and the climb gradients are exactly that. The product
       is WorldDEM-30, not "DEM GLO-30" as this row said until 2026-08-27, and
       Airbus's years run to 2018: the paragraph below had the required notice
       right all along, the summary line beside it did not, and the summary is
       what most people read. #}
    <div class="crow">
      <div class="who"><a href="https://dataspace.copernicus.eu/explore-data/data-collections/copernicus-contributing-missions/collections-description/COP-DEM" data-pkg="manual:copernicus-dem">Copernicus WorldDEM-30</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">© DLR e.V. 2010-2014 · © Airbus Defence and Space GmbH 2014-2018</span></div>
      <p>{% trans %}credits.copernicus_p{% endtrans %}</p>
    </div>
  </div>

  <div class="cgroup">
    <h3>{% trans %}credits.map_h{% endtrans %}</h3>
    <div class="gsub">{% trans %}credits.map_sub{% endtrans %}</div>
    <div class="crow">
      <div class="who"><a href="https://maplibre.org/" data-pkg="maplibre-gl">MapLibre GL JS</a><span class="lic">BSD-3-Clause</span></div>
      <p>{% trans %}credits.maplibre_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://openfreemap.org/" data-pkg="manual:openfreemap-tiles">OpenFreeMap</a><span class="lic">{% trans %}credits.lic_free_tiles{% endtrans %}</span></div>
      <p>{% trans %}credits.openfreemap_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://protomaps.com/" data-pkg="pmtiles">Protomaps · PMTiles</a><span class="lic">BSD-3-Clause</span></div>
      <p>{% trans %}credits.protomaps_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://valhalla.github.io/valhalla/" data-pkg="valhalla">Valhalla</a><span class="lic">MIT</span></div>
      <p>{% trans %}credits.valhalla_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://github.com/Redocly/redoc" data-pkg="redoc-standalone">Redoc</a><span class="lic">MIT</span></div>
      <p>{% trans %}credits.redoc_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://www.mapillary.com/" data-pkg="mapillary-js manual:mapillary-service">Mapillary</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">CC BY-SA 4.0 · © Mapillary contributors</span></div>
      <p>{% trans %}credits.mapillary_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://www.esri.com/" data-pkg="manual:esri-imagery">Esri World Imagery</a><a class="req" href="#credits-req"><span class="vh">{% trans %}credits.req_badge{% endtrans %}</span><span aria-hidden="true">*</span></a><span class="lic">© Esri, Maxar, Earthstar Geographics</span></div>
      <p>{% trans %}credits.esri_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://github.com/komoot/photon" data-pkg="manual:photon-geocoder">Photon</a><span class="lic">Apache-2.0</span></div>
      <p>{% trans %}credits.photon_p{% endtrans %}</p>
    </div>
    {# Named because /terms now says where machines are involved, and a
       disclosure that does not name the machine is half a disclosure. Called by
       the harvest pipeline, never by a browser, which is why it is here and not
       in the privacy page's browser-services table. #}
    <div class="crow">
      <div class="who"><a href="https://mymemory.translated.net/" data-pkg="manual:mymemory">MyMemory</a><span class="lic">{% trans %}credits.lic_api{% endtrans %}</span></div>
      <p>{% trans %}credits.mymemory_p{% endtrans %}</p>
    </div>
  </div>

  <div class="cgroup">
    <h3>{% trans %}credits.software_h{% endtrans %}</h3>
    <div class="gsub">{% trans %}credits.software_sub{% endtrans %}</div>
    <div class="crow">
      <div class="who"><a href="https://symfony.com/" data-pkg="symfony/*">Symfony</a><span class="lic">MIT</span></div>
      <p>{% trans %}credits.symfony_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://postgis.net/" data-pkg="postgis">PostgreSQL + PostGIS</a><span class="lic">PostgreSQL License · GPL-2.0</span></div>
      <p>{% trans %}credits.postgis_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://github.com/sokil/php-isocodes" data-pkg="sokil/*">sokil/php-isocodes</a><span class="lic">MIT</span></div>
      <p>{% trans %}credits.isocodes_p{% endtrans %}</p>
    </div>
    {# The full run of direct dependencies. Named rows above get a sentence
       each; everything else gets a link here. Keep the list alphabetical
       (case-insensitive) and keep it matching composer.json's require and
       require-dev, pipeline/requirements.txt, tools/divisions/requirements.txt,
       developers/docker/wiki/requirements.txt, the base images and services in
       the compose stack, and the two language runtimes themselves (PHP and
       Python) plus Node, which runs the JS test suite. Ubuntu is here because
       the production hosts run it; Alpine and Debian because the container
       images do. WSL is deliberately NOT here, and it is the only OS in that
       position: it is a developer's local shim, nothing the Commons runs on.
       Packages that already have
       their own row above (Symfony, PostgreSQL + PostGIS, sokil/php-isocodes)
       are deliberately not repeated here. #}
    <div class="crow">
      <div class="who"><a href="https://github.com/cycling-commons/cycling-commons">{% trans %}credits.oss_more_who{% endtrans %}</a><span class="lic">{% trans %}credits.lic_various{% endtrans %}</span></div>
      <div>
        <p>{% trans %}credits.oss_more_p{% endtrans %}</p>
        <p class="pkglist"><a href="https://alpinelinux.org/" data-pkg="manual:container-base-alpine">Alpine Linux</a>,
        <a href="https://github.com/boto/boto3" data-pkg="boto3">boto3</a>,
        <a href="https://www.clamav.net/" data-pkg="clamav">ClamAV</a>,
        <a href="https://www.debian.org/" data-pkg="manual:container-base-debian">Debian</a>,
        <a href="https://www.docker.com/" data-pkg="manual:container-runtime">Docker</a>,
        <a href="https://www.doctrine-project.org/projects/dbal.html" data-pkg="doctrine/dbal">Doctrine DBAL</a>,
        <a href="https://github.com/doctrine/DoctrineFixturesBundle" data-pkg="doctrine/doctrine-fixtures-bundle">Doctrine Fixtures</a>,
        <a href="https://www.doctrine-project.org/projects/migrations.html" data-pkg="doctrine/doctrine-migrations-bundle">Doctrine Migrations</a>,
        <a href="https://www.doctrine-project.org/projects/orm.html" data-pkg="doctrine/orm doctrine/doctrine-bundle">Doctrine ORM</a>,
        <a href="https://github.com/dmaicher/doctrine-test-bundle" data-pkg="dama/doctrine-test-bundle">doctrine-test-bundle</a>,
        <a href="https://duckdb.org/" data-pkg="duckdb">DuckDB</a>,
        <a href="https://github.com/EasyCorp/EasyAdminBundle" data-pkg="easycorp/easyadmin-bundle">EasyAdmin</a>,
        <a href="https://github.com/endroid/qr-code" data-pkg="endroid/qr-code">endroid/qr-code</a>,
        <a href="https://fastapi.tiangolo.com/" data-pkg="fastapi">FastAPI</a>,
        <a href="https://flysystem.thephpleague.com/" data-pkg="league/flysystem-*">Flysystem</a>,
        <a href="https://imagemagick.org/" data-pkg="ext-imagick">ImageMagick</a>,
        <a href="https://mailpit.axllent.org/" data-pkg="mailpit">Mailpit</a>,
        <a href="https://squidfunk.github.io/mkdocs-material/" data-pkg="mkdocs-material">Material for MkDocs</a>,
        <a href="https://min.io/" data-pkg="minio mc">MinIO</a>,
        <a href="https://www.mkdocs.org/" data-pkg="mkdocs">MkDocs</a>,
