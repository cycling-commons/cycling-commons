        <a href="https://www.starlette.io/" data-pkg="starlette">Starlette</a>,
        <a href="https://github.com/SymfonyCasts/reset-password-bundle" data-pkg="symfonycasts/reset-password-bundle">SymfonyCasts Reset Password</a>,
        <a href="https://github.com/SymfonyCasts/verify-email-bundle" data-pkg="symfonycasts/verify-email-bundle">SymfonyCasts Verify Email</a>,
        <a href="https://twig.symfony.com/" data-pkg="twig/*">Twig</a>,
        <a href="https://ubuntu.com/" data-pkg="manual:production-host-os">Ubuntu</a>,
        <a href="https://uvicorn.dev/" data-pkg="uvicorn">Uvicorn</a>.</p>
      </div>
    </div>
  </div>

  <div class="cgroup">
    <h3>{% trans %}credits.design_h{% endtrans %}</h3>
    <div class="gsub">{% trans %}credits.design_sub{% endtrans %}</div>
    <div class="crow">
      <div class="who"><a href="https://fonts.google.com/specimen/Bricolage+Grotesque" data-pkg="manual:font-bricolage">Bricolage Grotesque</a><span class="lic">SIL OFL 1.1</span></div>
      <p>{% trans %}credits.bricolage_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://fonts.google.com/specimen/Spline+Sans" data-pkg="manual:font-spline-sans">Spline Sans &amp; Spline Sans Mono</a><span class="lic">SIL OFL 1.1</span></div>
      <p>{% trans %}credits.splinesans_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://github.com/lipis/flag-icons" data-pkg="manual:flag-icons">flag-icons</a><span class="lic">MIT · {% trans %}credits.lic_flags_pd{% endtrans %}</span></div>
      <p>{% trans %}credits.flags_p{% endtrans %}</p>
    </div>
  </div>

  <div class="cgroup">
    <h3>{% trans %}credits.people_h{% endtrans %}</h3>
    <div class="gsub">{% trans %}credits.people_sub{% endtrans %}</div>
    <div class="crow">
      <div class="who"><a href="{{ path('contributors') }}">{% trans %}credits.people_contributors_who{% endtrans %}</a></div>
      <p>{% trans %}credits.people_contributors_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://www.openstreetmap.org/">{% trans %}credits.people_osm_who{% endtrans %}</a></div>
      <p>{% trans %}credits.people_osm_p{% endtrans %}</p>
    </div>
    <div class="crow">
      <div class="who"><a href="https://bikecoders.life">BikeCoders</a></div>
      <p>{% trans %}credits.people_steward_p{% endtrans %}</p>
    </div>
