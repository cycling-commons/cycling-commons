  {# The target of every asterisk above. It sits at the foot rather than in the
     hero so the page opens on the credits themselves, not on a housekeeping
     note. Moving it means moving #credits-req with it. #}
  <p class="legend" id="credits-req"><span class="reqkey" aria-hidden="true">*</span>{% trans %}credits.req_legend{% endtrans %}</p>

  <div class="cnote"><b>{% trans %}credits.note_b{% endtrans %}</b> {% trans %}credits.note_pre{% endtrans %} <a href="https://github.com/cycling-commons/cycling-commons/issues">{% trans %}credits.note_link{% endtrans %}</a>{% trans %}credits.note_post{% endtrans %}</div>

</div></section>
{% endblock %}
