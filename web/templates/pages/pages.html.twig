{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/pages/pages.css') }}">
{% endblock %}
{% block body %}
{#
  One directory, two drawings. Every page is listed exactly once below; the
  map and the list both read from it, so a page cannot be on one and off the
  other. Coordinates are map units in a 1000 x 660 viewBox.

  Groups are countries: pages that belong together share a border (the
  quality country holds what is known to be wrong, how to report more, and
  how usable the site is). Roads say
  how the pages relate: a main road is the usual way through the site, a
  trail is a contributor's route, a track leads into a rider's own account,
  a footpath joins reference pages. Capitals are the hubs a first visit
  reaches first. A road may carry `via` points to bend around a label, and a
  hub may set `lp` (above, left, right) when a road would otherwise run
  through the label below it.
#}
{% set account_href = app.user ? path('profile') : path('login') %}
{% set groups = [
  {id: 'atlas', name: 'pages.group_atlas'|trans, box: {x: 20, y: 20, w: 440, h: 250}, t: {x: 22, y: 20, w: 308, h: 240}, pages: [
    {id: 'home',     href: path('home'),     x: 90,  y: 100, t: {x: 150, y: 90, lp: 'above'}, capital: true,  h: 'pages.card_landing_h'|trans, p: 'pages.card_landing_p'|trans},
    {id: 'map',      href: path('map'),      x: 240, y: 90, t: {x: 205, y: 120, lp: 'right'},  capital: true,  h: 'pages.card_map_h'|trans,     p: 'pages.card_map_p'|trans},
    {id: 'mapkey',   href: path('map_key'),  x: 410, y: 145, t: {x: 150, y: 205, lp: 'left'}, capital: false, h: 'pages.card_mapkey_h'|trans,  p: 'pages.card_mapkey_p'|trans},
    {id: 'regions',  href: path('regions'),  x: 130, y: 200, t: {x: 140, y: 160, lp: 'left'}, capital: false, h: 'pages.card_region_h'|trans,  p: 'pages.card_region_p'|trans},
    {id: 'scout',    href: path('scout'),    x: 320, y: 195, t: {x: 250, y: 165, lp: 'right'}, capital: false, h: 'pages.card_scout_h'|trans,   p: 'pages.card_scout_p'|trans},
    {id: 'coverage', href: path('coverage'), x: 400, y: 235, t: {x: 225, y: 225, lp: 'right'}, capital: false, h: 'nav.coverage'|trans, p: 'pages.card_coverage_p'|trans},
  ]},
  {id: 'part', name: 'pages.group_part'|trans, box: {x: 500, y: 20, w: 480, h: 250}, t: {x: 22, y: 280, w: 308, h: 280}, pages: [
    {id: 'contribute',   href: path('contribute'),    x: 590, y: 100, t: {x: 185, y: 335, lp: 'right'}, capital: true, lp: 'above',  h: 'pages.card_contribute_h'|trans,   p: 'pages.card_contribute_p'|trans},
    {id: 'improve',      href: path('improve'),       x: 790, y: 95, t: {x: 225, y: 390, lp: 'right'},  capital: false, lp: 'above', h: 'pages.card_improve_h'|trans,      p: 'pages.card_improve_p'|trans},
    {id: 'addclimb',     href: path('improve', {type: 'climbs', mode: 'add'}), x: 730, y: 140, t: {x: 185, y: 430}, capital: false, h: 'pages.card_addclimb_h'|trans, p: 'pages.card_addclimb_p'|trans},
    {id: 'route',        href: path('propose_route'), x: 620, y: 200, t: {x: 135, y: 380, lp: 'left'}, capital: false, h: 'pages.card_route_h'|trans,        p: 'pages.card_route_p'|trans},
    {id: 'vote',         href: path('vote'),          x: 790, y: 210, t: {x: 125, y: 430, lp: 'left'}, capital: false, note: true, h: 'pages.card_vote_h'|trans, p: 'pages.card_vote_p'|trans},
    {id: 'join',         href: path('join'),          x: 900, y: 80, t: {x: 240, y: 450, lp: 'right'},  capital: false, lp: 'above', h: 'pages.card_join_h'|trans,         p: 'pages.card_join_p'|trans},
    {id: 'contributors', href: path('contributors'),  x: 930, y: 190, t: {x: 200, y: 520, lp: 'left'}, capital: false, lp: 'left', h: 'pages.card_contributors_h'|trans, p: 'pages.card_contributors_p'|trans},
    {id: 'wiki',         href: 'https://wiki.cyclingcommons.org/', x: 860, y: 150, t: {x: 270, y: 500, lp: 'right'}, capital: false, h: 'pages.card_wiki_h'|trans, p: ''},
  ]},
  {id: 'data', name: 'pages.group_data'|trans, box: {x: 20, y: 300, w: 590, h: 150}, t: {x: 22, y: 770, w: 308, h: 260}, pages: [
    {id: 'developers', href: path('developers'), x: 90,  y: 370, t: {x: 150, y: 840, lp: 'left'}, capital: false, h: 'pages.card_developers_h'|trans, p: 'pages.card_developers_p'|trans},
    {id: 'api',        href: path('developers_api'), x: 150, y: 420, t: {x: 125, y: 890, lp: 'left'}, capital: false, h: 'pages.card_api_h'|trans, p: 'pages.card_api_p'|trans},
    {id: 'blog',       href: path('blog'),       x: 390, y: 410, t: {x: 150, y: 1000, lp: 'left'}, capital: false, h: 'nav.blog'|trans,              p: 'pages.card_blog_p'|trans},
    {id: 'licenses',   href: path('licenses'),   x: 220, y: 360, t: {x: 215, y: 860, lp: 'right'}, capital: false, lp: 'right', h: 'pages.card_licenses_h'|trans, p: 'pages.card_licenses_p'|trans},
    {id: 'credits',    href: path('credits'),    x: 270, y: 415, t: {x: 225, y: 905, lp: 'right'}, capital: false, h: 'pages.card_credits_h'|trans,    p: 'pages.card_credits_p'|trans},
    {id: 'changelog',  href: path('changelog'),  x: 420, y: 350, t: {x: 220, y: 955, lp: 'above'}, capital: false, h: 'footer.changelog'|trans,        p: 'changelog.lead'|trans|striptags},
    {id: 'roadmap',    href: path('roadmap'),    x: 545, y: 350, t: {x: 290, y: 975}, capital: false, h: 'roadmap.kicker'|trans,  p: 'roadmap.lead'|trans|striptags},
  ]},
  {id: 'account', name: 'pages.group_account'|trans, box: {x: 650, y: 300, w: 330, h: 150}, t: {x: 22, y: 580, w: 308, h: 170}, pages: [
    {id: 'account',  href: account_href,     x: 740, y: 405, t: {x: 135, y: 665, lp: 'left'}, capital: false, h: 'pages.card_login_h'|trans,    p: 'pages.card_login_p'|trans},
    {id: 'profile',  href: path('profile'),  x: 830, y: 350, t: {x: 200, y: 640, lp: 'right'}, capital: false, lp: 'left', h: 'pages.card_profile_h'|trans,  p: 'pages.card_profile_p'|trans},
    {id: 'messages', href: path('messages'), x: 930, y: 350, t: {x: 150, y: 715, lp: 'left'}, capital: false, h: 'pages.card_messages_h'|trans, p: 'pages.card_messages_p'|trans},
    {id: 'settings', href: path('settings'), x: 880, y: 415, t: {x: 225, y: 710, lp: 'right'}, capital: false, h: 'pages.card_settings_h'|trans, p: 'pages.card_settings_p'|trans},
  ]},
  {id: 'print', name: 'pages.group_print'|trans, box: {x: 20, y: 480, w: 450, h: 160}, t: {x: 22, y: 1290, w: 308, h: 170}, pages: [
    {id: 'about',   href: path('about'),   x: 90,  y: 565, t: {x: 90, y: 1370}, capital: false, h: 'pages.card_about_h'|trans,   p: 'pages.card_about_p'|trans},
    {id: 'privacy', href: path('privacy'), x: 220, y: 545, t: {x: 190, y: 1370, lp: 'above'}, capital: false, h: 'pages.card_privacy_h'|trans, p: 'pages.card_privacy_p'|trans},
    {id: 'terms',   href: path('terms'),   x: 330, y: 545, t: {x: 255, y: 1410}, capital: false, h: 'pages.card_terms_h'|trans,   p: 'pages.card_terms_p'|trans},
    {id: 'contact', href: path('contact'), x: 425, y: 565, t: {x: 292, y: 1360}, capital: false, h: 'support.contact.title_short'|trans, p: 'support.contact.lead'|trans|striptags},
  ]},
  {id: 'quality', name: 'pages.group_quality'|trans, box: {x: 500, y: 480, w: 480, h: 160}, t: {x: 22, y: 1050, w: 308, h: 220}, pages: [
    {id: 'known',  href: path('known_issues'),  x: 600, y: 560, t: {x: 232, y: 1110, lp: 'right'}, capital: false, h: 'support.known.kicker'|trans, p: 'support.known.lead'|trans|striptags},
    {id: 'bug',    href: path('bug_report'),    x: 745, y: 520, t: {x: 160, y: 1140, lp: 'left'}, capital: false, h: 'support.bug.kicker'|trans,   p: 'support.bug.lead'|trans|striptags},
    {id: 'report', href: path('report_guide'),  x: 830, y: 592, t: {x: 240, y: 1190}, capital: true,  h: 'support.guide.kicker'|trans, p: 'support.guide.lead'|trans},
    {id: 'a11y',   href: path('accessibility'), x: 930, y: 545, t: {x: 110, y: 1200}, capital: false, h: 'a11y.kicker'|trans,          p: 'a11y.lead'|trans|striptags},
  ]},
] %}
{% set roads = [
  {a: 'home', b: 'map', kind: 'main'}, {a: 'map', b: 'contribute', kind: 'main', t: {bend: 0.3}}, {a: 'home', b: 'about', kind: 'main', bend: 0, wobble: 0.3, via: [{x: 12, y: 100}, {x: 12, y: 565}], t: {via: [{x: 10, y: 90}, {x: 10, y: 1370}]}},
  {a: 'contribute', b: 'improve', kind: 'trail'}, {a: 'contribute', b: 'addclimb', kind: 'trail'}, {a: 'contribute', b: 'route', kind: 'trail'},
  {a: 'route', b: 'vote', kind: 'trail'}, {a: 'improve', b: 'join', kind: 'trail'}, {a: 'join', b: 'wiki', kind: 'trail'}, {a: 'join', b: 'contributors', kind: 'trail'}, {a: 'map', b: 'scout', kind: 'trail'},
  {a: 'account', b: 'profile', kind: 'track'}, {a: 'profile', b: 'messages', kind: 'track'}, {a: 'profile', b: 'settings', kind: 'track'}, {a: 'contributors', b: 'profile', kind: 'track'},
  {a: 'map', b: 'mapkey', kind: 'path'}, {a: 'map', b: 'regions', kind: 'path'}, {a: 'map', b: 'coverage', kind: 'path'},
  {a: 'developers', b: 'licenses', kind: 'path'}, {a: 'developers', b: 'api', kind: 'path'}, {a: 'changelog', b: 'blog', kind: 'path'}, {a: 'licenses', b: 'credits', kind: 'path'}, {a: 'changelog', b: 'roadmap', kind: 'path'}, {a: 'changelog', b: 'known', kind: 'path', bend: 0, wobble: 0.3, via: [{x: 485, y: 470}, {x: 485, y: 560}]},
  {a: 'known', b: 'bug', kind: 'path'}, {a: 'bug', b: 'report', kind: 'path'}, {a: 'report', b: 'a11y', kind: 'path'}, {a: 'contact', b: 'report', kind: 'path', via: [{x: 540, y: 622}], t: {via: [{x: 316, y: 1280}, {x: 300, y: 1195}]}}, {a: 'about', b: 'privacy', kind: 'path'}, {a: 'privacy', b: 'terms', kind: 'path'},
] %}
{#
  Two drawings of the map from the same groups, pages and roads. The wide
  one uses each entry's own coordinates (`box`, `x`, `y`, `lp`, `via`); the
  tall one, for a phone, uses the `t` set on the same entry, in a 340-unit
  wide viewBox whose height follows the lowest country. Its countries stack
  top to bottom (atlas, take part, account, open data, quality, small print),
  so every road but the coast road joins a country to its neighbour. The
  tall drawing wraps a label onto a second line past 14 characters, and a
  road may give its own `t.via` and `t.bend` there. A page without a `t`
  set breaks the page, so a new page cannot land on one drawing only.
#}
{% set at = {} %}{% set tat = {} %}{% set tall_h = 0 %}
{% for g in groups %}
  {% set tall_h = max(tall_h, g.t.y + g.t.h + 20) %}
  {% for p in g.pages %}
    {% set at = at|merge({(p.id): {x: p.x, y: p.y}}) %}
    {% set tat = tat|merge({(p.id): {x: p.t.x, y: p.t.y}}) %}
  {% endfor %}
{% endfor %}
{% set layouts = [
  {name: 'wide', w: 1000, h: 660, at: at, wrap: 0},
  {name: 'tall', w: 340, h: tall_h, at: tat, wrap: 14},
] %}

<div class="phero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{% trans %}pages.kicker{% endtrans %}</div>
  <h1 class="disp">{% trans %}pages.title{% endtrans %}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{% trans %}pages.lead{% endtrans %}</p>
</div></div>

<section class="pad"><div class="wrap" id="dir">
  <div class="dirbar">
    <nav class="lfilter dirtoggle" aria-label="{{ 'pages.view_aria'|trans }}">
      <a class="lchip" href="{{ path('pages', {view: 'map'}) }}" data-view="map" aria-pressed="{{ view == 'map' ? 'true' : 'false' }}">{% trans %}pages.view_map{% endtrans %}</a>
      <a class="lchip" href="{{ path('pages', {view: 'list'}) }}" data-view="list" aria-pressed="{{ view == 'list' ? 'true' : 'false' }}">{% trans %}pages.view_list{% endtrans %}</a>
    </nav>
  </div>

  <div id="dir-map"{{ view == 'map' ? '' : ' hidden' }}>
    <div class="pmap-wrap">
      {% for lay in layouts %}
      {% set tall = lay.name == 'tall' %}
      <svg class="pmap pmap-{{ lay.name }}" viewBox="0 0 {{ lay.w }} {{ lay.h }}" role="img" aria-label="{{ 'pages.map_aria'|trans }}">
        {% for g in groups %}
        {% set box = tall ? g.t : g.box %}
        <rect class="land" x="{{ box.x }}" y="{{ box.y }}" width="{{ box.w }}" height="{{ box.h }}" rx="26" />
        <text class="land-name" x="{{ box.x + 18 }}" y="{{ box.y + 30 }}">{{ g.name }}</text>
        {% endfor %}
        {#
          Roads bend. Each leg is cut into pieces of roughly 60 map units, and
          every cut point is pushed a little off the straight line: a wide lean
          that arcs the whole leg to one side, plus a small wobble that changes
          direction from piece to piece. The wobble comes from the coordinates
          themselves, so the same map draws the same way every time. The path
          then runs smoothly through those points (a quadratic curve per piece,
          joined at the midpoints). Roads alternate the side they lean to, and a
          road may set its own `bend` (0 for no lean, negative to lean the other
          way) and its own `wobble` strength (1 by default; the coast road along
          the western edge keeps a small one so it stays on the map).
        #}
        {% for r in roads %}
        {% set via = tall ? (r.t.via ?? []) : (r.via ?? []) %}
        {% set legs = [lay.at[r.a]]|merge(via)|merge([lay.at[r.b]]) %}
        {% set bend = r.bend ?? (loop.index is odd ? 1 : -1) %}{% if tall and r.t.bend is defined %}{% set bend = r.t.bend %}{% endif %}
        {% set seed = loop.index %}
        {% set wob = r.wobble|default(1) %}
        {% set d = 'M' ~ legs[0].x ~ ' ' ~ legs[0].y %}
        {% for i in 1..(legs|length - 1) %}
          {% set a = legs[i - 1] %}{% set b = legs[i] %}
          {% set dx = b.x - a.x %}{% set dy = b.y - a.y %}
          {% set len = (dx * dx + dy * dy) ** 0.5 %}
          {% set nx = len > 0 ? -dy / len : 0 %}{% set ny = len > 0 ? dx / len : 0 %}
          {% set n = max(2, (len / 60)|round) %}
          {% set pts = [a] %}
          {% for j in 1..(n - 1) %}
            {% set t = j / n %}
            {% set wobble = ((a.x * 7 + a.y * 13 + j * 31 + seed * 17) % 11 - 5) / 5 %}
            {% set off = bend * len * 0.10 * 4 * t * (1 - t) + wobble * wob * (len / n) * 0.22 %}
            {% set pts = pts|merge([{x: a.x + dx * t + nx * off, y: a.y + dy * t + ny * off}]) %}
          {% endfor %}
          {% set pts = pts|merge([b]) %}
          {% for j in 1..(n - 1) %}
            {% set c = pts[j] %}{% set e = j < n - 1 ? {x: (pts[j].x + pts[j + 1].x) / 2, y: (pts[j].y + pts[j + 1].y) / 2} : pts[n] %}
            {% set d = d ~ ' Q' ~ c.x|round(1) ~ ' ' ~ c.y|round(1) ~ ' ' ~ e.x|round(1) ~ ' ' ~ e.y|round(1) %}
          {% endfor %}
        {% endfor %}
        <path class="road road-{{ r.kind }}" d="{{ d }}" />
        {% endfor %}
        {% for g in groups %}{% for p in g.pages %}
        {% set pos = tall ? p.t : p %}{% set x = pos.x %}{% set y = pos.y %}{% set lp = pos.lp ?? 'below' %}
        {% set label = p.h ~ (p.note|default(false) ? '*' : '') %}
        {# Greedy word wrap: a line takes the next word while it stays within `wrap` characters. #}
        {% set lines = [label] %}
        {% if lay.wrap > 0 and label|length > lay.wrap %}
          {% set lines = [] %}{% set cur = '' %}
          {% for w in label|split(' ') %}
            {% if cur == '' %}{% set cur = w %}
            {% elseif (cur ~ ' ' ~ w)|length <= lay.wrap %}{% set cur = cur ~ ' ' ~ w %}
            {% else %}{% set lines = lines|merge([cur]) %}{% set cur = w %}{% endif %}
          {% endfor %}
          {% set lines = lines|merge([cur]) %}
        {% endif %}
        {% set extra = (lines|length - 1) * 15 %}
        {% if lp == 'above' %}{% set tx = x %}{% set ty = y - (p.capital ? 16 : 13) - extra %}{% set anchor = 'middle' %}
        {% elseif lp == 'left' %}{% set tx = x - 12 %}{% set ty = y + 4 - extra / 2 %}{% set anchor = 'end' %}
        {% elseif lp == 'right' %}{% set tx = x + 12 %}{% set ty = y + 4 - extra / 2 %}{% set anchor = 'start' %}
        {% else %}{% set tx = x %}{% set ty = y + (p.capital ? 26 : 22) %}{% set anchor = 'middle' %}{% endif %}
        <a class="hub{{ p.capital ? ' capital' }}" href="{{ p.href }}">
          <title>{{ p.h }}{% if p.p %}. {{ p.p }}{% endif %}</title>
          <circle cx="{{ x }}" cy="{{ y }}" r="{{ p.capital ? 9 : 6 }}" />{% if p.capital %}<circle class="cap" cx="{{ x }}" cy="{{ y }}" r="3" />{% endif %}
          <text x="{{ tx }}" y="{{ ty }}" text-anchor="{{ anchor }}">{% if lines|length == 1 %}{{ label }}{% else %}{% for l in lines %}<tspan x="{{ tx }}"{% if not loop.first %} dy="15"{% endif %}>{{ l }}</tspan>{% endfor %}{% endif %}</text>
        </a>
        {% endfor %}{% endfor %}
      </svg>
      {% endfor %}
    </div>
    <div class="pkey" aria-label="{{ 'pages.key_aria'|trans }}">
      <span><svg viewBox="0 0 44 12" aria-hidden="true"><line class="road road-main" x1="2" y1="6" x2="42" y2="6"/></svg>{% trans %}pages.key_main{% endtrans %}</span>
      <span><svg viewBox="0 0 44 12" aria-hidden="true"><line class="road road-trail" x1="2" y1="6" x2="42" y2="6"/></svg>{% trans %}pages.key_trail{% endtrans %}</span>
      <span><svg viewBox="0 0 44 12" aria-hidden="true"><line class="road road-track" x1="2" y1="6" x2="42" y2="6"/></svg>{% trans %}pages.key_track{% endtrans %}</span>
      <span><svg viewBox="0 0 44 12" aria-hidden="true"><line class="road road-path" x1="2" y1="6" x2="42" y2="6"/></svg>{% trans %}pages.key_path{% endtrans %}</span>
      <span><svg viewBox="0 0 44 12" aria-hidden="true"><rect class="land" x="2" y="1" width="40" height="10" rx="4"/></svg>{% trans %}pages.key_border{% endtrans %}</span>
    </div>
  </div>

  <div id="dir-list"{{ view == 'list' ? '' : ' hidden' }}>
    {# The same six countries as the map, in the same order, one heading each. #}
    {% for g in groups %}
    <section class="pgc" aria-labelledby="pgc-{{ g.id }}">
      <h2 id="pgc-{{ g.id }}">{{ g.name }}</h2>
      <div class="pg">
        {% for p in g.pages %}
        <a href="{{ p.href }}"><div class="card"><h4>{{ p.h }}{% if p.note|default(false) %}*{% endif %}</h4>{% if p.p %}<p>{{ p.p }}</p>{% endif %}</div></a>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>
  <p class="dirnote">* {% trans %}pages.footnote_vote{% endtrans %}</p>
</div></section>
{% endblock %}
{% block body_scripts %}
{{ parent() }}
<script src="{{ asset('pages/directory-view.js') }}" defer></script>
{% endblock %}
