{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .rhero .ey{font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--glacier);margin-bottom:1.3rem}
  .rhero h1{font-family:var(--serif);font-weight:500;font-size:clamp(2.4rem,5vw,4.2rem);line-height:1.03;letter-spacing:-.025em;margin-bottom:.9rem}
  .rhero p{max-width:62ch;color:rgba(239,230,212,.85);line-height:1.6;font-size:1.15rem}
  .rhero p b{color:var(--paper)}
  /* Two columns: the page on the left, the country CTA on the right. minmax(0,…)
     so the title column can shrink instead of forcing overflow; stacked below
     780px, where a side card would be two words wide. */
  .rhero-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(16rem,1fr);gap:2.5rem;align-items:center}
  .rhero-cta{border:1px solid rgba(239,230,212,.22);border-radius:10px;padding:1.4rem 1.5rem;
    background:rgba(239,230,212,.05)}
  .rhero-cta h2{font-family:var(--serif);font-weight:600;font-size:1.3rem;margin-bottom:.5rem}
  .rhero-cta p{font-size:.92rem;line-height:1.55;color:rgba(239,230,212,.8);margin-bottom:1rem}
  .rhero-cta-go{display:inline-block;font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;
    text-transform:uppercase;font-weight:700;background:var(--trail);color:var(--ink);
    padding:.55rem .9rem;border-radius:6px}
  .rhero-cta-go:hover{background:#ff703d}
  .country{scroll-margin-top:5rem}
  .cc-here{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;
    color:#2f6b52;background:rgba(143,182,168,.28);border-radius:3px;padding:.1rem .35rem;margin-left:.4rem}
  @media(max-width:780px){.rhero-grid{grid-template-columns:1fr;gap:1.6rem}}

  .rwrap{max-width:1120px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2.5rem) 3rem}

  .legend-lead{font-size:.90rem;color:#4a4d40;margin:0 0 .7rem;max-width:64ch;line-height:1.5}
  /* Two columns because they are two questions: what the region holds, and who
     looks after it. Stacked below 640px, where side-by-side would leave each
     description two words wide. */
  .legend{display:grid;grid-template-columns:repeat(auto-fit,minmax(20rem,1fr));gap:1.1rem 2.4rem;
    margin-bottom:1.6rem;font-size:.82rem;color:#4a4d40}
  .lcol{display:flex;flex-direction:column;gap:.45rem}
  .lcol .lh{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay)}
  .legend b{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}

  h2.cont{font-family:var(--serif);font-weight:600;font-size:1.5rem;margin:2.2rem 0 1rem;padding-bottom:.55rem;
    border-bottom:1px solid rgba(20,22,14,.16);display:flex;align-items:baseline;gap:.7rem}
  h2.cont span{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:#7a7d6c}

  .country{margin:0 0 1.2rem}
  {# A tab strip per continent (owner 2026-09-08: "regions must open full
     width as some sort of tab"): countries are the cells, three across from
     900px, and the open country's regions are one panel across the whole
     row, placed by the script on the row under that country. #}
  .cgrid{display:grid;grid-template-columns:minmax(0,1fr);column-gap:2rem;align-items:start}
  @media(min-width:900px){.cgrid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  {# flex-wrap: on a phone the name + count + Apply button overflowed the
     viewport by ~25px (found 2026-08-15 while checking the hero split); the
     button drops to its own line instead of pushing the page wider. #}
  .country .ch{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin-bottom:.55rem}
  {# A quiet link, not a button (owner 2026-09-08: "a bit too much"): nineteen
     of them on one page, so each is a small underlined offer at the row's end. #}
  .country .ch .join-cta{font-size:.82rem;color:var(--trail);text-decoration:underline;
    text-underline-offset:3px;text-decoration-color:rgba(184,90,53,.45);white-space:nowrap;flex:none;margin-left:auto}
  .country .ch .join-cta:hover{color:var(--clay);text-decoration-color:currentColor}
  .country .ch h3{font-family:var(--sans);font-weight:700;font-size:1.05rem}
  .country .ch .cc{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;color:#7a7d6c;text-transform:uppercase}
  .country .ch .n{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;color:#7a7d6c;margin-left:auto}
  .viewrow{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;margin:0 0 1rem}
  .viewrow .chip{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .7rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;background:transparent;color:#595c4d;cursor:pointer}
  .viewrow .chip.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .viewrow .vhint{font-size:.85rem;color:#6d7060;margin-left:.4rem}
  .regions-map{position:relative}
  .regions-tip{position:absolute;z-index:2;pointer-events:none;background:var(--ink);color:var(--paper);font-family:var(--mono);font-size:.7rem;letter-spacing:.06em;padding:.25rem .5rem;border-radius:4px}
  {# No frame and the page's own paper behind it (owner 2026-09-08), so the
     globe floats on the page instead of sitting in a box. #}
  .regions-map{height:min(70vh,560px);overflow:hidden;margin:0 0 1.4rem;background:var(--paper)}
  {# Nothing until the first full frame in the asked-for projection: the
     flat map used to show, then jump into a globe (owner 2026-09-08). #}
  .regions-map.loading>*{visibility:hidden}
  .regions-map.loading::after{content:'';position:absolute;top:50%;left:50%;width:28px;height:28px;margin:-14px 0 0 -14px;
    border:3px solid rgba(20,22,14,.15);border-top-color:var(--trail);border-radius:50%;animation:regs-spin .8s linear infinite}
  @keyframes regs-spin{to{transform:rotate(360deg)}}
  .regtab{display:inline-flex;align-items:center;gap:.4rem;cursor:pointer;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .7rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;color:#595c4d;background:transparent;margin:0 0 .55rem}
  .regtab::after{content:'▾'}
  .regtab[aria-expanded=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .regtab[aria-expanded=true]::after{content:'▴'}

  {# The panel says whose it is twice (owner 2026-09-08: "make more clear
     the region showing belong to which of the 3 items per row"): a notch
     on its top edge under the open chip (--tab-x, set by the script), and
     the country's flag and name as its first line. A short fade and slide
     on open and close; none for readers who asked for less motion. #}
  .regions{display:none;flex-wrap:wrap;gap:.5rem;grid-column:1/-1;position:relative;margin:.2rem 0 1.6rem;padding:1rem;
    background:rgba(20,22,14,.06);border-radius:8px}
  .regions::before{content:'';position:absolute;top:-9px;left:var(--tab-x,2rem);border:9px solid transparent;border-top:0;border-bottom-color:rgba(20,22,14,.06)}
  .regions.open{display:grid;animation:regs-in .18s ease-out}
  .regions.closing{animation:regs-in .15s ease-in reverse}
  @keyframes regs-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.regions.open,.regions.closing{animation:none}}
  .rhead{grid-column:1/-1;display:flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d;margin-bottom:.15rem}
  {# Equal cards in straight columns (owner 2026-09-08: "a bit messy with
     all different sizes and alignments"): the panel is a grid of cards, and
     every card is the same four columns, name, tier, stewardship, numbers,
     so the tags line up down the panel. #}
  .regions{grid-template-columns:repeat(auto-fill,minmax(min(100%,400px),1fr))}
  .reg{display:grid;grid-template-columns:minmax(0,1fr) 7.5em 9.5em minmax(5em,auto);align-items:center;gap:.5rem;
    background:var(--paper-deep);border:1px solid rgba(20,22,14,.1);border-radius:8px;padding:.45rem .7rem;font-size:.9rem}
  .reg .tag{justify-self:start;white-space:nowrap}
  .reg .stats{display:flex;flex-direction:column;align-items:flex-end;gap:.1rem;justify-self:end;text-align:right}
  .reg .km{font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;color:#7a7d6c;white-space:nowrap}
  a.reg{text-decoration:none;color:inherit}
  a.reg:hover{border-color:var(--spruce-lift)}
  .reg .tag{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;padding:.1rem .3rem;border-radius:3px;background:rgba(20,22,14,.08)}
  /* Two independent facts, two chips: how much the region holds, and who looks
     after it. A region can have either, both or neither. */
  .reg.has-curator{background:var(--spruce-lift);color:var(--paper);border-color:var(--spruce-lift)}
  .reg.has-curator .km{color:rgba(239,230,212,.7)}
  .reg.has-curator .tag{background:rgba(239,230,212,.22)}
  /* Solid, not a 22%-paper wash on spruce: the badge naming the thing the card
     is coloured for must not be the least readable thing on it. */
  .reg.has-curator .tag-curated{background:var(--paper);color:var(--spruce)}
  .reg.tier-growing .tag-tier{background:var(--trail);color:var(--ink)}
  .reg.tier-established .tag-tier{background:var(--ochre);color:#14160E}
  .reg .tag-countrywide{background:rgba(122,155,168,.28)}
  /* "No curator yet" is an opening, not an alarm: outlined rather than filled,
     so it reads as an empty slot beside the two filled badges that mean
     somebody is already there. It must be VISIBLE though, which is the whole
     point of drawing it at all. */
  .reg .tag-none{background:transparent;box-shadow:inset 0 0 0 1px rgba(184,89,58,.45);color:var(--clay)}
  .reg.has-curator .tag-none{box-shadow:inset 0 0 0 1px rgba(239,230,212,.4);color:rgba(239,230,212,.8)}

  .empty{color:#7a7d6c;font-size:.9rem;padding:2rem 0}

  .yourc{margin-top:2.6rem;padding:1.6rem clamp(1.1rem,3vw,1.8rem);border:1px solid rgba(20,22,14,.14);border-radius:12px;background:var(--paper-deep)}
  .yourc h2{font-family:var(--serif);font-weight:600;font-size:1.3rem;margin-bottom:.5rem}
  .yourc p{color:#4a4d40;font-size:.92rem;line-height:1.55;margin-bottom:1rem;max-width:60ch}
  #cc-country-q{width:100%;box-sizing:border-box;padding:.6rem .8rem;font-size:1rem;border:1px solid rgba(20,22,14,.18);border-radius:8px;background:var(--paper);color:inherit}
  #cc-country-hits a{display:flex;justify-content:space-between;padding:.45rem .7rem;border:1px solid rgba(20,22,14,.1);border-radius:8px;margin-top:.4rem;text-decoration:none;color:inherit}
  #cc-country-hits a:hover{border-color:var(--spruce-lift)}
  #cc-country-hits .cc{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;color:#7a7d6c;text-transform:uppercase}
</style>
<noscript><style>.regions{display:grid}</style></noscript>
{% endblock %}
{% block body %}

{# Two columns (owner 2026-08-15): left is the page, right is the one thing a
   reader from an uncovered country can act on. The CTA links down to the
   existing #your-country block, which keeps the typeahead - a pointer, not a
   second copy, so there is one input and one place the answer is given. #}
<div class="rhero"><div class="wrap rhero-grid">
  <div class="rhero-main">
    <div class="kicker" style="color:var(--trail)">{% trans %}regions.kicker{% endtrans %}</div>
    <h1>{% trans %}regions.title{% endtrans %}</h1>
    <p>{{ 'regions.lead'|trans|rich }}</p>
  </div>
  <aside class="rhero-cta">
    <h2>{% trans %}regions.your_country_h{% endtrans %}</h2>
    <p>{% trans %}regions.your_country_p{% endtrans %}</p>
    <a class="rhero-cta-go" href="#your-country">{% trans %}regions.your_country_cta{% endtrans %}</a>
  </aside>
</div></div>

<div class="rwrap">
  <div class="kicker" style="margin-bottom:.6rem">{% trans %}regions.legend_title{% endtrans %}</div>
  {# Two axes, and the legend says which is which — the single ladder this
     replaced described one flag ("the map opens in Curated view") with the
     other's words ("a curator maintains this region"). #}
  <p class="legend-lead">{% trans %}regions.legend_lead{% endtrans %}</p>
  <div class="legend">
    {# Left: the ladder a region climbs, and riders climb it — the top rung is
       gated on verified places and rider-backed routes, not declared. #}
    <div class="lcol">
      <div class="lh">{% trans %}regions.legend_col_maturity{% endtrans %}</div>
      <span><b>{% trans %}regions.tier_onboarded{% endtrans %}</b> {% trans %}regions.tier_onboarded_desc{% endtrans %}</span>
      <span><b>{% trans %}regions.tier_growing{% endtrans %}</b> {% trans %}regions.tier_growing_desc{% endtrans %}</span>
      <span><b>{% trans %}regions.tier_established{% endtrans %}</b> {% trans %}regions.tier_established_desc{% endtrans %}</span>
    </div>
    {# Right: who is looking after it. Independent of the left column. #}
    <div class="lcol">
      <div class="lh">{% trans %}regions.legend_col_stewardship{% endtrans %}</div>
      <span><b>{% trans %}regions.status_curated{% endtrans %}</b> {% trans %}regions.status_curated_desc{% endtrans %}</span>
      <span><b>{% trans %}regions.status_countrywide{% endtrans %}</b> {% trans %}regions.status_countrywide_desc{% endtrans %}</span>
      {# The third state was missing from the legend as well as from the cards,
         so COUNTRY-WIDE was a badge a reader could meet with nothing to
         compare it against (owner: "how can people know what country wide
         means"). All three are listed now, and the legend is the only place
         that says what any of them mean. #}
      <span><b>{% trans %}regions.status_none{% endtrans %}</b> {% trans %}regions.status_none_desc{% endtrans %}</span>
    </div>
  </div>

  {% if countries is empty %}
    <div class="empty">{% trans %}regions.no_regions{% endtrans %}</div>
  {% endif %}

  {# Two views of one list (owner 2026-09-08): a globe where a country is
     picked by clicking it, and the list; the flat map went the same day. The map is loaded only when asked for,
     so the page does not carry MapLibre for readers who never open it. #}
  <div class="viewrow" id="regions-viewrow" hidden>
    <button type="button" class="chip" data-view="globe" aria-pressed="false">{% trans %}regions.view_globe{% endtrans %}</button>
    <button type="button" class="chip on" data-view="list" aria-pressed="true">{% trans %}regions.view_list{% endtrans %}</button>
    <span class="vhint">{% trans %}regions.map_hint{% endtrans %}</span>
  </div>
  <div id="regions-map" class="regions-map" hidden
       data-outlines="{{ path('regions_outlines') }}"
       data-maplibre-js="{{ asset('lib/maplibre-gl-5.24.0.js') }}"
       data-maplibre-css="{{ asset('lib/maplibre-gl-5.24.0.css') }}"
       data-style="https://tiles.openfreemap.org/styles/liberty"{% if home %} data-home="{{ home[0] }},{{ home[1] }}"{% endif %}></div>

  {# One grid per continent: the countries, and after each one its regions
     panel, which the script shows one at a time across the full row (the
     noscript rule above shows them all, in place). #}
  {% set continent = '' %}
  {% for country in countries %}
    {% if country.continentCode != continent %}
      {% if continent != '' %}</div>{% endif %}
      {% set continent = country.continentCode %}
      <h2 class="cont">{{ ('continent.' ~ continent|lower)|trans }}</h2>
      <div class="cgrid">
    {% endif %}
    <div class="country" id="country-{{ country.code }}">
      <div class="ch">
        <img src="{{ asset(country.flag) }}" alt="" width="20" height="15">
        <h3>{{ country.name }}</h3><span class="cc">{{ country.code }}</span>
        <a class="join-cta" href="{{ path('join_country', {cc: country.code}) }}">{% trans %}regions.apply{% endtrans %}</a>
      </div>
      <button type="button" class="regtab" data-country="{{ country.code }}" aria-expanded="false" aria-controls="regions-{{ country.code }}">{{ (country.regions|length == 1 ? 'regions.count_region' : 'regions.count_regions')|trans({'%n%': country.regions|length}) }}</button>
    </div>
      <div class="regions" id="regions-{{ country.code }}">
        <div class="rhead"><img src="{{ asset(country.flag) }}" alt="" width="20" height="15">{{ country.name }}</div>
        {% for reg in country.regions %}
          <a class="reg tier-{{ reg.tier }}{{ reg.stewardship == 'curated' ? ' has-curator' }}"
             href="{{ path('region_detail', {slug: reg.slug}) }}">
            <span>{{ ('region.' ~ reg.slug ~ '.label')|trans }}</span>
            <span class="tag tag-tier">{{ ('regions.tier_' ~ reg.tier)|trans }}</span>
            {# The stewardship badge is shown for EVERY region, including the
               ones nobody looks after (owner, 2026-08-14). It used to be hidden
               when there was no curator, so "nobody has taken this on" was
               drawn as blank space next to regions that had a badge — which
               reads as an oversight, not as a fact. It is the one status a
               reader can act on, so it is the one that must not be silent. #}
            <span class="tag tag-{{ reg.stewardship }}">{{ ('regions.status_' ~ reg.stewardship)|trans }}</span>
            {# One number for what the community holds here, verified items
               and routes together (owner 2026-09-08: "just count different
               things into X community items"). #}
            {% set community = reg.itemsVerified + reg.routes %}
            <span class="stats">
            {% if community > 0 %}<span class="km">{{ (community == 1 ? 'regions.community_one' : 'regions.community_many')|trans({'%n%': community}) }}</span>{% endif %}
            {% if reg.areaKm2 %}<span class="km">{{ reg.areaKm2|cc_km2 }}</span>{% endif %}
            </span>
          </a>
        {% endfor %}
      </div>
  {% endfor %}
  {% if continent != '' %}</div>{% endif %}

  <div id="your-country" class="yourc">
    <h2>{% trans %}regions.your_country_h{% endtrans %}</h2>
    <p>{% trans %}regions.your_country_p{% endtrans %}</p>
    <input type="text" id="cc-country-q" autocomplete="off"
           placeholder="{{ 'regions.your_country_placeholder'|trans|e('html_attr') }}"
           aria-label="{{ 'regions.your_country_h'|trans|e('html_attr') }}">
    <div id="cc-country-hits" role="listbox"></div>
    <noscript><p><a href="{{ path('join') }}">{% trans %}regions.your_country_noscript{% endtrans %}</a></p></noscript>
  </div>
  {# No nonce: a JSON data block is not executed, so script-src never gates it,
     and a nonce here would tie the page to a per-request value (page-caching.md §3.2). #}
  <script type="application/json" id="cc-countries"
          data-join-href="{{ path('join_country', {cc: 'ZZ'}) }}"
          data-here-label="{{ 'regions.already_here'|trans }}">{{ all_countries|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
</div>
{% endblock %}
{% block body_scripts %}
{# Behaviour in a file, so this page needs no CSP nonce
   (docs/specs/page-caching.md §3.2). #}
<script src="{{ asset('pages/regions-typeahead.js') }}" defer></script>
<script src="{{ asset('pages/regions-map.js') }}" defer></script>
{% endblock %}
