{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('lib/maplibre-gl-5.24.0.css') }}" />
<style>
  .ey{font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.5rem}
  h1.disp{font-family:var(--serif);font-weight:600;font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.05;margin-bottom:.4rem}
  .sub{color:#4a4d40;margin-bottom:1.6rem}

  /* stepper */
  .stepper{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-bottom:2rem;border-bottom:1px solid rgba(20,22,14,.15);padding-bottom:1rem}
  .stepper li{font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;color:#9a9d8c;display:flex;align-items:center;gap:.45rem}
  .stepper li::before{content:counter(step);counter-increment:step;display:inline-flex;align-items:center;justify-content:center;width:1.4rem;height:1.4rem;border-radius:50%;border:1.5px solid rgba(20,22,14,.25);font-size:.72rem;color:#595c4d}
  .stepper{counter-reset:step}
  .stepper li.done{color:#5a5d4d}.stepper li.done::before{background:var(--spruce);border-color:var(--spruce);color:var(--paper);content:"✓"}
  .stepper li.on{color:var(--ink);font-weight:700}.stepper li.on::before{border-color:var(--trail);color:var(--ink)}

  /* panes */
  /* No entrance animation. A wizard step is a page you read, and fading each
     one in delays the thing the rider came to look at for no information. */
  .pane{display:none}.pane.on{display:block}
  .pane h2{font-family:var(--serif);font-weight:600;font-size:1.5rem;margin-bottom:.3rem}
  .pane .help{color:#595c4d;font-size:.9rem;margin-bottom:1.3rem}
  .subhead{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--clay);margin:1.6rem 0 1rem;padding-bottom:.4rem;border-bottom:1px solid rgba(20,22,14,.12)}
  .subhead:first-of-type{margin-top:.3rem}

  /* `hidden` must actually hide. An author rule that sets `display` beats the
     UA's [hidden]{display:none} — author styles win over UA styles regardless
     of specificity — so every element here that takes its display from a class
     silently ignored the attribute. #wzChange is the one that got away with it:
     improve.js kept it hidden for climbs and for non-confirm edits, the CSS
     showed it anyway, and a "Change location" button sat under an editor that
     was already directly editable (owner-reported 2026-08-03). This replaces
     three separate one-off patches that each fixed one element after it bit. */
  #wiz [hidden]{display:none}
  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#A0472A;margin-bottom:.4rem}  /* clay, darkened to 4.94:1; same as /add-climb (owner 2026-08-25) */
  /* Details step: two columns on wide screens — the stacked full-width fields
     wasted half the pane. Textareas and checkbox groups span both columns. */
  .fgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 2.4rem}
  @media(max-width:720px){.fgrid{grid-template-columns:1fr}}
  .fgrid .field:has(textarea),.fgrid .field:has(input[type=checkbox]){grid-column:1/-1}
  /* A · road surface: Note shares the closing row with Width instead of
     spanning (the wide-desktop grid; the one-column phone layout is untouched). */
  .fgrid-a .field[data-f="note"]:has(textarea){grid-column:auto}
  .fgrid-a .field[data-f="note"] textarea{min-height:52px}
  .field input,.field textarea{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none;color:var(--ink)}
  .field select{width:100%;max-width:22rem}  /* look is global (atlas.css) */
  /* Width's underline stops where the dropdown lines stop (owner 2026-08-14)
     — a lone full-width rule under a two-digit number read as a text field
     asking for prose. */
  .field[data-f="width"] input{max-width:22rem}
  .field textarea{border:1.5px solid rgba(20,22,14,.25);border-radius:6px;padding:.7rem;min-height:80px;resize:vertical}
  .field input:focus,.field textarea:focus{border-color:var(--trail)}
  .field .fhelp{font-family:var(--mono);font-size:.78rem;line-height:1.5;color:#5a5d4d;margin-top:.4rem;text-transform:none;letter-spacing:0}  /* same readable size and AA colour as add-climb (owner 2026-08-25) */

  /* Multi-select fields (stays' accessibility) render as the site's orange
     chips, the same look as the route form's bike types and the map rail's
     filters — one visual language for "pick any of these". Symfony's expanded
     ChoiceType emits a flat <input><label> pair per choice, so the input is
     visually hidden and its label IS the chip; :checked + label paints it.
     Without this the pairs inherit .field label's full-width uppercase rule
     and render as a stack of far-apart rows with the boxes off to the right. */
  .field:has(input[type=checkbox]) > div{display:flex;flex-wrap:wrap;gap:.5rem}
  .field input[type=checkbox]{position:absolute;opacity:0;width:1px;height:1px}
  .field input[type=checkbox] + label{display:inline-block;width:auto;margin:0;
    font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;
    padding:.4rem .8rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;
    color:#5a5d4d;cursor:pointer;transition:all .18s;user-select:none}
  .field input[type=checkbox] + label:hover{border-color:var(--ink);color:var(--ink)}
  .field input[type=checkbox]:checked + label{background:var(--trail);border-color:var(--trail);color:var(--ink)}
  .field input[type=checkbox]:focus-visible + label{outline:2px solid var(--trail);outline-offset:2px}

  /* Outbound-links editor: a nested repeatable, so it spans both grid columns
     and each destination is a bordered card. Without the span every url row
     wraps inside a half-width column and the editor reads as broken. */
  .fgrid .field-links{grid-column:1/-1}
  .lk-editor{display:flex;flex-direction:column;gap:.9rem;margin-top:.2rem}
  .lk-entry{border:1px solid rgba(20,22,14,.16);border-radius:8px;padding:.9rem 1rem;background:var(--paper)}
  .lk-label{font-weight:600}
  .lk-url{display:flex;align-items:center;gap:.6rem;margin-top:.5rem}
  .lk-url-input{flex:1 1 auto;min-width:0}
  .lk-locale{flex:0 0 auto;width:auto;min-width:9rem}
  .lk-x{flex:0 0 auto;border:none;background:transparent;color:var(--clay);font-size:1.1rem;line-height:1;cursor:pointer;padding:.2rem .35rem}
  .lk-x:hover{color:var(--danger, #8b1a1a)}
  .lk-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:.7rem}
  .lk-add,.lk-drop{border:none;background:transparent;cursor:pointer;padding:0;
    font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase}
  .lk-add{color:var(--clay)}
  .lk-drop{color:#9a9d8c}
  .lk-add:hover,.lk-drop:hover{text-decoration:underline}
  .lk-add-entry{align-self:flex-start}
  /* Say WHY the add button is gone. A control that vanishes at a threshold
     reads as a bug. */
  .lk-full{font-family:var(--mono);font-size:.72rem;color:#9a9d8c;margin:0}

  /* step 1 map */
  #wmap{height:clamp(420px,74vh,720px);border-radius:8px;overflow:hidden;border:1px solid rgba(20,22,14,.15);margin-bottom:.8rem;background:var(--paper-deep)}
  #wmap.confirm{height:clamp(280px,40vh,420px)}
  #wzChange{margin-bottom:.8rem}
  .cc-pin.glow{animation:pinpulse 1.8s ease-in-out infinite}
  @keyframes pinpulse{
    0%,100%{box-shadow:0 3px 8px rgba(20,22,14,.4),0 0 0 5px rgba(255,90,31,.22),0 0 12px 3px rgba(255,90,31,.40)}
    50%{box-shadow:0 3px 8px rgba(20,22,14,.4),0 0 0 8px rgba(255,90,31,.30),0 0 18px 6px rgba(255,90,31,.55)}
  }
  .maplibregl-canvas{filter:none}  /* no per-frame filter chain on the WebGL canvas (same call as map.css) */
  .readout{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;color:#4a4d40;flex-wrap:wrap}
  .readout #wzReset,.readout #wzUndo{color:var(--clay);cursor:pointer;text-transform:uppercase;letter-spacing:.1em;font-size:.72rem}
  .readout #wzUndo{margin-left:auto}
  /* How to place a climb — read before the map, not after a mistake. */
  .wmap-stage{position:relative}
  .map-hint{position:absolute;top:.8rem;left:50%;transform:translateX(-50%);z-index:5;pointer-events:none;max-width:calc(100% - 2rem);text-align:center;font-family:var(--mono);font-size:.76rem;letter-spacing:.04em;color:var(--ink);background:rgba(239,230,212,.96);border:1px solid rgba(20,22,14,.18);border-radius:999px;padding:.45rem .9rem;box-shadow:0 8px 20px -12px rgba(20,22,14,.6)}
  .map-hint[hidden]{display:none}
  .wz-measured{display:flex;flex-wrap:wrap;gap:.6rem 2rem;margin:.8rem 0 0}
  .wz-measured div{display:flex;flex-direction:column;gap:.15rem}
  .wz-measured dt{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#595c4d}
  .wz-measured dd{margin:0;font-size:1.05rem;color:var(--ink)}
  .climb-howto{margin:0 0 .9rem;padding:.75rem 1rem .75rem 2.1rem;background:var(--paper-deep);
    border-left:2px solid var(--trail);border-radius:0 6px 6px 0;font-size:.86rem;line-height:1.55;color:#4a4d40}
  .climb-howto li{margin:.18rem 0}
  .cc-pin{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50% 50% 50% 0;background:var(--ink);border:2px solid var(--paper);box-shadow:0 3px 8px rgba(20,22,14,.4)}
  /* known-places overlay (add mode): visual context only, taps pass through */
  .cc-cov-dot{display:flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--paper);border:1.5px solid rgba(20,22,14,.5);font-size:.72rem;opacity:.8;pointer-events:none;box-shadow:0 1px 4px rgba(20,22,14,.25)}
  .covnote{font-family:var(--mono);font-size:.74rem;color:#595c4d;margin-top:.5rem;line-height:1.5}
  /* Why a submission was refused — the wizard used to fail silently. */
  .wiz-errors{border:1.5px solid #8b1a1a;border-left-width:4px;border-radius:0 6px 6px 0;background:rgba(139,26,26,.06);
    padding:.8rem 1rem;margin:0 0 1.4rem;color:#6b1414;font-size:.9rem;line-height:1.5}
  .wiz-errors strong{display:block;margin-bottom:.3rem}
  .wiz-errors ul{margin:0;padding-left:1.1rem}
  .cc-pin span{font-size:.8rem}
  /* three-point climb editor markers (foot/summit/steepest), Task 5.
     No `position` on .cc-marker: MapLibre's .maplibregl-marker{position:absolute}
     must win — a relative marker stays in-flow, stretches to the map's width and
     breaks the anchor translate(-50%,-100%); absolute is still the label's
     containing block. line-height only kills the inline-SVG baseline gap, so the
     label restores its own. */
  .cc-marker{line-height:0;filter:drop-shadow(0 3px 6px rgba(20,22,14,.4))}
  .cc-mk-label{font-family:var(--mono);font-size:.68rem;line-height:1.35;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:var(--paper);border:1px solid rgba(20,22,14,.3);border-radius:3px;padding:.12rem .4rem;white-space:nowrap;position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:.3rem;box-shadow:0 2px 6px rgba(20,22,14,.3)}
  .cc-mk-label:empty{display:none}

  /* place search */
  .csearch{position:relative}
  .csearch input{background:#F8F2E4;border:1.5px solid rgba(20,22,14,.22);border-radius:8px;padding:.65rem .85rem}
  .csearch input::placeholder{color:#9a9d8c}
  .csearch input:focus{border-color:var(--trail);background:#FCF8EE}
  .csearch-results{position:absolute;left:0;right:0;top:100%;z-index:20;background:var(--paper);border:1px solid rgba(20,22,14,.2);border-radius:0 0 8px 8px;box-shadow:0 14px 28px -14px rgba(20,22,14,.45);max-height:250px;overflow-y:auto}
  .csearch-results .res{padding:.55rem .8rem;cursor:pointer;border-bottom:1px solid rgba(20,22,14,.08)}
  .csearch-results .res:hover{background:var(--paper-deep)}
  .csearch-results .res b{font-size:.92rem;font-weight:500}
  .csearch-results .res small{display:block;color:#595c4d;font-size:.74rem;font-family:var(--mono)}
  .csearch-results .res.empty{color:#595c4d;cursor:default}

  /* C5: read-only strip of the item's existing photo(s), step 3 */
  .cur-photos{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.6rem}
  .cur-photo{margin:0;width:200px}
  .cur-photo a{display:block;border-radius:6px;overflow:hidden}
  .cur-photo img{display:block;width:200px;height:150px;object-fit:cover;border-radius:6px;border:1px solid rgba(20,22,14,.18);background:var(--paper-deep);transition:transform .15s}
  .cur-photo a:hover img{transform:scale(1.02)}
  .cur-photo a:focus-visible{outline:2px solid var(--trail);outline-offset:2px}
  .cur-photo figcaption{font-family:var(--mono);font-size:.7rem;color:#9a9d8c;margin-top:.3rem;line-height:1.35}

  /* upload queue + consent */
  .ulq{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.8rem}
  /* The description field. Full width on its own line: a chip is a name and a
     progress bar, and an input squeezed beside them is unusable on a phone,
     which is where most photos are added. */
  .ulq .chip{flex-wrap:wrap}
  .ulq .chip-alt{flex:1 0 100%;margin-top:.3rem}
  .ulq .chip-alt input{width:100%;font-family:var(--sans);font-size:.72rem;padding:.32rem .45rem;border:1px solid rgba(20,22,14,.22);border-radius:4px;background:var(--paper)}
  .ulq .chip-alt.saved input{border-color:var(--glacier)}
  .ulq .chip{font-family:var(--mono);font-size:.7rem;letter-spacing:.04em;padding:.3rem .5rem;border-radius:5px;background:var(--paper-deep);border:1px solid rgba(20,22,14,.18);display:flex;align-items:center;gap:.35rem}
  .ulq .chip .dot{width:6px;height:6px;border-radius:50%;background:var(--ochre)}

  /* modal */
  .modal{position:fixed;inset:0;background:rgba(16,30,22,.55);z-index:2000;display:none;align-items:center;justify-content:center;padding:1.2rem}
  .modal.open{display:flex}
  .modal .box{background:var(--paper);border-radius:12px;max-width:460px;padding:1.6rem 1.7rem;box-shadow:0 24px 60px -18px rgba(0,0,0,.5)}
  .modal h3{font-family:var(--serif);font-weight:600;font-size:1.3rem;margin-bottom:.6rem}
  .modal p{font-size:.9rem;color:#4a4d40;line-height:1.55;margin-bottom:.8rem}
  .modal .rules{background:var(--paper-deep);border-radius:8px;padding:.8rem 1rem;font-size:.84rem;line-height:1.55;margin-bottom:1rem}
  .modal label.ok-check{display:flex;gap:.6rem;align-items:flex-start;font-size:.88rem;cursor:pointer;margin-bottom:.5rem}
  /* Outside the label, on its own line: reading the licence must not tick the box. */
  .modal .consent-licence{margin:0 0 1.1rem;padding-left:1.55rem;font-size:.84rem}
  .modal .consent-licence a{color:var(--clay);text-decoration:underline}
  .modal .mrow{display:flex;gap:.7rem;justify-content:flex-end}
  .modal .mrow button{font-family:var(--sans);font-weight:700;font-size:.92rem;padding:.6rem 1.2rem;border-radius:6px;cursor:pointer;border:1.5px solid transparent}
  .modal .b-ok{background:var(--trail);color:var(--ink)}.modal .b-ok[disabled]{opacity:.45;cursor:not-allowed}
  .modal .b-cancel{background:none;border-color:rgba(20,22,14,.25);color:var(--ink)}
  .modal .thanks-big{text-align:center}
  .modal .thanks-big .ic{font-size:2.6rem}.modal .thanks-big h3{font-size:1.6rem;margin-top:.4rem}
  .modal .demo-note{font-size:.90rem;color:#595c4d;margin-top:.4rem}

  /* drop zone */
  .drop{border:1.5px dashed rgba(20,22,14,.3);border-radius:10px;padding:2rem;text-align:center;color:#595c4d;cursor:pointer}
  .drop:hover{border-color:var(--trail);color:var(--ink)}
  .drop .ic{font-size:1.6rem;display:block;margin-bottom:.5rem}
  /* real uploads (docs/specs/photo-uploads.md §4) */
  .drop.over{border-color:var(--trail);background:var(--paper-deep)}
  /* Empty until consent exists — the contract is put to the rider when they
     drop a photo, not as a gate in front of the drop zone. */
  .consent-gate{margin:.6rem 0 1rem}
  .consent-gate:empty{margin:0}
  .consent-ok{font-size:.86rem;line-height:1.5;color:#3f6b3f}
  .consent-when{font-family:var(--mono);font-size:.68rem;color:#595c4d}
  .consent-more{display:inline-block;margin-left:.35rem}
  .consent-more summary{cursor:pointer;font-size:.78rem;color:var(--clay)}
  .consent-err{color:#a3342b;font-size:.85rem;margin:.5rem 0}
  .ulq .chip.up{display:inline-flex;align-items:center;gap:.45rem;max-width:100%}
  .chip-thumb img{width:34px;height:34px;object-fit:cover;border-radius:4px;display:block}
  .chip-name{max-width:12rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chip-bar{position:relative;width:78px;height:4px;border-radius:2px;background:rgba(20,22,14,.15);overflow:hidden}
  .chip-bar i{position:absolute;inset:0 auto 0 0;display:block;background:var(--trail);transition:width .15s linear}
  .chip.indeterminate .chip-bar i{width:40%!important;animation:chip-pulse 1.1s ease-in-out infinite}
  @keyframes chip-pulse{0%{transform:translateX(-100%)}100%{transform:translateX(250%)}}
  .chip.failed{border-color:#a3342b;color:#a3342b}
  .chip-err{font-size:.72rem}
  /* The wait between "received" and "on the map"
     (media-storage-architecture.md §3.3). Two states, deliberately different
     in weight: `checking` is live and breathes, `waiting` is settled and
     still, because the rider has been told they can move on. Neither is an
     error, so neither borrows the failed colour. */
  .chip-note{font-size:.72rem;color:#595c4d;white-space:nowrap}
  .chip.checking{border-color:var(--glacier)}
  .chip.checking .chip-thumb img{opacity:.62;animation:chip-breathe 1.6s ease-in-out infinite}
  .chip.waiting{border-color:rgba(20,22,14,.22)}
  .chip.waiting .chip-thumb img{opacity:.72}
  @keyframes chip-breathe{0%,100%{opacity:.62}50%{opacity:.95}}
  @media(prefers-reduced-motion:reduce){.chip.checking .chip-thumb img{animation:none}}
  .chip-x{border:0;background:none;cursor:pointer;font-size:1rem;line-height:1;color:#595c4d}
  @media(prefers-reduced-motion:reduce){.chip.indeterminate .chip-bar i{animation:none}}
  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.8rem 1rem;font-size:.82rem;color:#4a4d40;border-radius:0 6px 6px 0;margin-top:1rem;line-height:1.5}

  /* review card */
  /* A summary to read, not a control to press: the filled panel read as one
     large button. Same paper as the page, a hairline rule instead of a raised
     block, no shadow, no hover, no transition. Two columns once there is room —
     a submission is a dozen short answers, and one long ladder of them makes
     the rider scroll past the thing they wanted to check. */
  /* No hover state here: atlas.css now lifts only cards you can act on (a
     card inside a link, or the landing grid), and this one is a summary to
     read. `transition:none` stays as the belt to that braces — a review that
     slides under the pointer reads as a button. */
  .card{background:transparent;border:none;border-top:1px solid rgba(20,22,14,.14);border-radius:0;padding:.4rem 0 0;transition:none}
  .kv{display:flex;justify-content:space-between;gap:1rem;font-size:.9rem;padding:.45rem 0;border-bottom:1px solid rgba(20,22,14,.08)}
  .kv:last-child{border-bottom:none}
  .kv span:first-child{color:#595c4d}
  @media(min-width:720px){
    .card{display:grid;grid-template-columns:1fr 1fr;column-gap:2.2rem}
    /* Every row keeps its rule in two columns: "last child" is only the last
       of the whole list, which in a grid is not the bottom of both columns. */
    .kv:last-child{border-bottom:1px solid rgba(20,22,14,.08)}
  }
  .nochange{font-size:.85rem;color:var(--clay);background:var(--paper-deep);border-left:2px solid var(--clay);padding:.6rem .85rem;border-radius:0 6px 6px 0;margin-top:.9rem}
  .curator-decide{color:var(--ink);border-left-color:var(--spruce)}
  .curator-decide a{color:var(--clay);font-weight:600;text-decoration:underline;margin-left:.3rem}
  .rm-item.is-existing img{opacity:.85}
  .prov{font-size:.8rem;color:#595c4d;margin-top:1rem;line-height:1.5}

  /* the photos, on review — shown rather than listed as filenames */
  .review-media{margin-top:1.2rem}
  .rm-h{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#595c4d;margin-bottom:.5rem}
  .rm-list{display:flex;flex-wrap:wrap;gap:.7rem}
  .rm-item{margin:0;width:118px}
  .rm-item img{display:block;width:118px;height:88px;object-fit:cover;border-radius:5px;background:var(--paper-deep)}
  .rm-item figcaption{font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;color:#595c4d;margin-top:.25rem;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rm-item.is-link{width:auto}
  .rm-item.is-link figcaption{font-size:.90rem;letter-spacing:0;white-space:normal;color:#3f4234}

  /* what happens next */
  .lifecycle{background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-left:2px solid var(--spruce);border-radius:0 8px 8px 0;padding:1.1rem 1.3rem;margin-top:1.3rem}
  .lifecycle .lc-h{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--clay);margin-bottom:.7rem}
  .lifecycle .lc-funnel{font-size:.86rem;color:#3f4234;line-height:1.6;margin-bottom:.6rem}
  .lifecycle .lc-verdict{font-size:.9rem;line-height:1.6;color:var(--ink);margin:0}

  /* nav row */
  .navrow{position:sticky;bottom:0;display:flex;align-items:center;gap:1rem;margin-top:2rem;padding:1rem 0;border-top:1px solid rgba(20,22,14,.12);background:linear-gradient(to top,var(--paper) 70%,rgba(239,230,212,0))}
  .navrow .spacer{flex:1}

  /* submitted (client-side wizard) */
  .pane.submitted{text-align:center;padding:1rem}
  .pane.submitted h2{font-size:1.9rem;margin:.5rem 0}
  .pane.submitted p{color:#4a4d40;max-width:46ch;margin:0 auto 1.4rem}

  /* server-side receipt (POST stub state) */
  .receipt{text-align:center;padding:4rem 1rem}
  .receipt h2{font-family:var(--serif);font-size:1.8rem;margin:.5rem 0}
  .receipt .ref{font-family:var(--mono);font-size:.72rem;color:#595c4d;margin-top:.5rem}

  .btn-p{background:var(--trail);color:var(--ink)}.btn-p:hover{background:#ff703d}
  .btn-p:disabled,.btn-p[disabled]{background:var(--paper-deep);color:#9a9d8c;cursor:not-allowed}
  .btn-g:hover{background:var(--ink);color:var(--paper)}

  .cc-toast{position:fixed;left:50%;bottom:1.5rem;transform:translateX(-50%) translateY(1rem);background:var(--ink);color:var(--paper);padding:.7rem 1.1rem;border-radius:8px;font-size:.85rem;max-width:90vw;text-align:center;box-shadow:0 10px 28px -10px rgba(0,0,0,.55);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:3000}
  .cc-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  /* The top gap is atlas.css's `.wrap#main` rule now, shared with every other
     page that opens straight on a wrap. What is left here is the FLOOR: this
     explainer is three short lines, and without it the footer crowds them. */
  .improve-unbound{margin-bottom:clamp(2.5rem,8vw,4rem)}
  .improve-unbound h2{margin-top:0}

  .btn:focus-visible,#wzReset:focus-visible,.drop:focus-visible{outline:2px solid var(--trail);outline-offset:2px;border-radius:4px}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
{% endblock %}
{% block body %}
{% if unbound|default(false) %}
{# ── UNBOUND EXPLAINER (spec §6: no fake default editor) ── #}
<div class="wrap" id="main">
  <section class="improve-unbound" data-improve-unbound>
    <h2>{{ 'improve.unbound_title'|trans }}</h2>
    <p>{{ 'improve.unbound_body'|trans }}</p>
    {# New tab: the reader arrived here from a row they were working through. #}
    <a class="btn" href="{{ path('map') }}"
       target="_blank" rel="noopener">{{ 'improve.unbound_cta'|trans }} &#8599;</a>
  </section>
</div>
{% elseif receipt is not null %}
{# ── SERVER-SIDE RECEIPT (honest stub state after POST) ── #}
<div class="wrap" id="main">
  <div class="receipt">
    {{ include('contribute/_receipt_mark.html.twig') }}
    <h2>{{ 'improve.receipt.heading'|trans }}</h2>
    <p>{{ 'improve.receipt.body'|trans }}</p>
    {# One statement of what happens next, not two. The amber note under this
       repeated the line above it and also claimed suggestions were "not yet
       persisted", which stopped being true once the moderation queue went in —
       the reference above is a real submission id. #}
    <p class="ref">{{ 'improve.receipt.reference'|trans }} {{ receipt.reference }}</p>
    <div style="margin-top:2rem">
      <a class="btn btn-g" href="{{ path('map') }}">{{ 'improve.receipt.cta'|trans }}</a>
    </div>
  </div>
</div>
{% else %}
{# ── WIZARD ── #}
<div class="wrap" id="wiz"
     data-type="{{ item_type.value }}"
     data-location-mode="{{ item_type.locationMode.value }}"
     data-icon="{{ item_type.icon }}"
     data-track="{{ item_type.hasTrackUpload ? '1' : '0' }}">
  {# No catalog letter here: it is a storage identifier (it still rides in this
     page's own ?type= URL), and to the rider it read as a code they were
     supposed to know. The type's name says the same thing without one. #}
  <div class="ey">{{ item_type.eyebrowKey|trans }} · {{ item_type.labelKey|trans }}</div>
  {# Show the exact item being edited, persistently above every step, so it's always clear what you're editing. #}
  <h1 class="disp">{% if edit_name is defined and edit_name %}{{ edit_name }}{% elseif add_mode|default(false) %}{{ 'contribute.add.title'|trans({'%type%': item_type.labelKey|trans}) }}{% else %}{{ 'improve.title'|trans }}{% endif %}</h1>
  <p class="sub">{{ (add_mode|default(false) ? 'contribute.add.lead' : 'improve.lead')|trans }}</p>

  {# The bound item's letter + current climb shape (route/grad/steep), for
     improve.js step 1: a climb (letter N) mounts the shared three-point
     editor instead of the single-pin Locate (Task 5). Only emitted here —
     the unbound branch above never reaches this template region. #}
  <script nonce="{{ csp_nonce() }}">window.CC_ITEM = {{ {letter: item_type.letter, lat: item_lat|default(null), lng: item_lng|default(null), route: current.route|default(null), grad: current.grad|default(null), steep: current.steep|default(null), steepPoint: current.steepPoint|default(null), segment: current.segment|default(null)}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  <script nonce="{{ csp_nonce() }}">window.CC_MEDIA = {{ {
    tokenUrl: path('media_token'),
    uploadUrl: path('media_photos_upload'),
    stateUrl: path('media_photos_state', {id: '__ID__'}),
    consentUrl: path('media_consent'),
    consentCurrentUrl: path('media_consent_current'),
    termsUrl: path('terms'),
    licenceUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
    max: 6,
    i18n: {
      title: 'media.consent.title'|trans,
      intro: 'media.consent.intro'|trans,
      contract: 'media.consent.contract'|trans,
      keepOwnership: 'media.consent.keep_ownership'|trans,
      accept: 'media.consent.accept'|trans,
      cancel: 'media.consent.cancel'|trans,
      consentError: 'media.consent.error'|trans,
      standing: 'media.consent.standing'|trans,
      readContract: 'media.consent.read_contract'|trans,
      readLicence: 'media.consent.read_licence'|trans,
      siteTerms: 'media.consent.site_terms'|trans,
      altLabel: 'media.alt.label'|trans,
      altPlaceholder: 'media.alt.placeholder'|trans,
      remove: 'improve.step3.remove_photo'|trans,
      tooMany: 'improve.step3.too_many_photos'|trans,
      checking: 'media.pending.checking'|trans,
      stillChecking: 'media.pending.still_checking'|trans,
      errors: {
        consent_required: 'media.error.consent_required'|trans,
        missing_file: 'media.error.missing_file'|trans,
        missing_location: 'media.error.missing_location'|trans,
        storage_unavailable: 'media.error.storage_unavailable'|trans,
        location_unresolvable: 'media.error.location_unresolvable'|trans,
        photo_too_large: 'media.error.photo_too_large'|trans,
        photo_too_many_pixels: 'media.error.photo_too_many_pixels'|trans,
        photo_format: 'media.error.photo_format'|trans,
        photo_unreadable: 'media.error.photo_unreadable'|trans,
        photo_too_small: 'media.error.photo_too_small'|trans,
        photo_rejected: 'media.error.photo_rejected'|trans,
        rate_limited: 'media.error.rate_limited'|trans,
        unknown: 'media.error.unknown'|trans
      }
    }
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  {# Every string improve.js renders itself (docs/plans/2026-08-01-improve-js-i18n.md).
     Serialised with all four JSON_HEX_* flags like the bags above — JSON_HEX_TAG
     is the one that matters here, because it turns `<`/`>` into </> so
     a catalogue string containing `</script>` cannot close this block.

     Everything in this bag is TEXT. improve.js sets it with textContent and
     never with innerHTML; copy that needs markup stays in this template, where
     |rich sanitises it. #}
  <script nonce="{{ csp_nonce() }}">window.CC_IMPROVE_I18N = {{ {
    nav_next: 'improve.nav.next'|trans,
    nav_submit: 'improve.nav.submit'|trans,
    readout_initial: 'improve.step1.readout_initial'|trans,
    readout_point_set: 'improve.step1.readout_point_set'|trans,
    readout_confirm: 'improve.step1.readout_confirm'|trans,
    readout_expanded: 'improve.step1.readout_expanded'|trans,
    readout_segment_start: 'improve.step1.readout_segment_start'|trans,
    readout_segment_end: 'improve.step1.readout_segment_end'|trans,
    readout_segment_prefilled: 'improve.step1.readout_segment_prefilled'|trans,
    readout_climb_foot: 'improve.step1.readout_climb_foot'|trans,
    readout_climb_summit: 'improve.step1.readout_climb_summit'|trans,
    readout_climb_set: 'improve.step1.readout_climb_set'|trans,
    climb_length: 'improve.step1.climb_length'|trans,
    climb_measuring: 'improve.step1.climb_measuring'|trans,
    climb_route_error: 'improve.step1.climb_route_error'|trans,
    climb_profile_error: 'improve.step1.climb_profile_error'|trans,
    climb_drag_hint: 'improve.step1.climb_drag_hint'|trans,
    toast_pin_moved: 'improve.step1.toast_pin_moved'|trans,
    toast_segment_moved: 'improve.step1.toast_segment_moved'|trans,
    toast_segment_straight: 'improve.step1.toast_segment_straight'|trans,
    toast_ctrl_added: 'improve.step1.toast_ctrl_added'|trans,
    toast_ctrl_removed: 'improve.step1.toast_ctrl_removed'|trans,
    ctrl_remove_title: 'improve.step1.ctrl_remove_title'|trans,
    ctrl_point_help: 'improve.step1.ctrl_point_help'|trans,
    ctrl_point_armed: 'improve.step1.ctrl_point_armed'|trans,
    seg_hide: 'improve.step1.seg_hide'|trans,
    seg_show: 'improve.step1.seg_show'|trans,
    seg_hide_title: 'improve.step1.seg_hide_title'|trans,
    seg_show_title: 'improve.step1.seg_show_title'|trans,
    search_no_matches: 'improve.step1.search_no_matches'|trans,
    search_unavailable: 'improve.step1.search_unavailable'|trans,
    search_result: 'improve.step1.search_result'|trans,
    search_coords_place: 'improve.step1.search_coords_place'|trans,
    search_coords_go: 'improve.step1.search_coords_go'|trans,
    label_location: 'improve.review.label_location'|trans,
    loc_climb: 'improve.review.loc_climb'|trans,
    measured_avg: 'improve.review.measured_avg'|trans,
    measured_max: 'improve.review.measured_max'|trans,
    nothing_changed: 'contribute.error.nothing_changed'|trans
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  {# The outbound-links editor's own bag: its caps come from OutboundLinks so
     raising one is a single edit rather than three, and the language names are
     endonyms, matching the language menu. #}
  <script nonce="{{ csp_nonce() }}">window.CC_LINKS = {{ {
    maxEntries: constant('App\\Catalog\\Import\\OutboundLinks::MAX_ENTRIES'),
    maxUrls: constant('App\\Catalog\\Import\\OutboundLinks::MAX_URLS_PER_ENTRY'),
    maxLabel: constant('App\\Catalog\\Import\\OutboundLinks::MAX_LABEL_LENGTH'),
    locales: constant('App\\Catalog\\Import\\OutboundLinks::LOCALES'),
    localeNames: {'en': 'English', 'fr': 'Français', 'nl': 'Nederlands', 'de': 'Deutsch', 'es': 'Español'},
    i18n: {
      addEntry: 'improve.links.add_entry'|trans,
      addLanguage: 'improve.links.add_language'|trans,
      removeEntry: 'improve.links.remove_entry'|trans,
      removeUrl: 'improve.links.remove_url'|trans,
      labelPlaceholder: 'improve.links.label_placeholder'|trans,
      anyLanguage: 'improve.links.any_language'|trans,
      full: 'improve.links.full'|trans({'%n%': constant('App\\Catalog\\Import\\OutboundLinks::MAX_ENTRIES')})
    }
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  {# Translated marker labels for the shared climb editor (foot/summit/steepest) — read as a fallback by climb-editor.js when a mount call doesn't pass opts.labels explicitly. #}
  <script nonce="{{ csp_nonce() }}">window.CC_EDITOR_LABELS = {{ {foot: 'js.climb_marker_foot'|trans, summit: 'js.climb_marker_summit'|trans, steepest: 'js.climb_marker_steepest'|trans}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  {# The stateless 'elevation' CSRF token climb-elevation.js sends as
     X-CC-Token (config/packages/csrf.yaml stateless_token_ids). #}
  <script nonce="{{ csp_nonce() }}">window.CC_ELEV_TOKEN = {{ csrf_token('elevation')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
  {# Same contract for the road snap improve.js and climb-editor.js post to
     /contribute/route. #}
  <script nonce="{{ csp_nonce() }}">window.CC_ROUTE_TOKEN = {{ csrf_token('route-snap')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>

  {# Why the submission was refused.
     Without this the wizard was SILENT on failure: the controller adds the
     violations to the form and re-renders, the wizard reopens at step 1, and a
     rider who pressed "Submit for review" is dropped back on the map with no
     message of any kind — indistinguishable from the page having reloaded
     itself (owner-reported 2026-08-03). Several of the refusals are attached to
     HIDDEN fields (route, lat, segment), so field-level rendering would not
     have shown them either.

     The messages are catalogue keys (contribute.error.*), added at form level
     by the controller's violation loop, so they are translated here. #}
  {% if form.vars.errors|length %}
    <div class="wiz-errors" role="alert" tabindex="-1" id="wizErrors">
      <strong>{{ 'contribute.error.heading'|trans }}</strong>
      <ul>
        {% for e in form.vars.errors %}<li>{{ e.message|trans }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  {{ form_start(form, {attr: {id: 'improve-form', novalidate: 'novalidate'}}) }}

  {# Hidden fields filled by client JS #}
  {{ form_widget(form.lat) }}
  {{ form_widget(form.lng) }}
  {{ form_widget(form.place) }}
  {{ form_widget(form.mode) }}
  {{ form_widget(form.subject) }}
  {% if form.route is defined %}
    {# Climb shape drawn by the three-point editor (client JS), carried as JSON. #}
    {{ form_widget(form.route) }}
    {{ form_widget(form.grad) }}
    {{ form_widget(form.steep) }}
    {{ form_widget(form.avg) }}
    {{ form_widget(form.steepPoint) }}
  {% endif %}
  {% if form.segment is defined %}
    {# Segment endpoints drawn on the Locate map (client JS), carried as JSON. #}
    {{ form_widget(form.segment) }}
  {% endif %}

  <ol class="stepper" id="stepper">
    <li class="on" data-s="1" id="step-label-1">{{ 'improve.step1.label'|trans }}</li>
    <li data-s="2">{{ 'improve.step2.label'|trans }}</li>
    <li data-s="3">{{ 'improve.step3.label'|trans }}</li>
    <li data-s="4">{{ 'improve.step4.label'|trans }}</li>
  </ol>

  {# STEP 1 — LOCATE #}
  <section class="pane on" data-s="1" id="w-locate" data-confirm-help="{{ 'improve.locate.confirm.help'|trans }}">
    {# "Where is it?" only asks a question nobody has answered yet. An existing
       item's location was settled when it was created, so an edit's step 1 is
       about CHECKING it — and, for a climb, adjusting the three points
       (owner, 2026-08-03). improve.js's confirm-help swap now writes the same
       sentence the server already rendered, so it is a harmless no-op here. #}
    <h2>{{ (add_mode|default(false) ? 'improve.step1.heading' : 'improve.locate.confirm.heading')|trans }}</h2>
    <p class="help">{{ (add_mode|default(false) ? 'improve.step1.help' : 'improve.locate.confirm.help')|trans }}</p>
    <div class="field csearch">
      <label for="wz-search">{{ 'improve.step1.search_label'|trans }}</label>
      <input id="wz-search" type="search" autocomplete="off" placeholder="{{ 'improve.step1.search_placeholder'|trans }}" />
      <div class="csearch-results" id="wz-results" hidden></div>
    </div>
    {# Placing a climb is not dropping a pin: three points, in order, with the
       road between the first two snapped for you. The readout narrates the
       step you are on, but a rider needs to know the whole shape BEFORE they
       start — especially that a third tap marks the steepest ramp, which
       nothing else on screen would ever suggest (owner request 2026-08-03). #}
    {% if item_type.letter == 'N' %}
      <ol class="climb-howto">
        <li>{{ 'js.climb_how_1'|trans }}</li>
        <li>{{ 'js.climb_how_2'|trans }}</li>
        <li>{{ 'js.climb_how_3'|trans }}</li>
        <li>{{ 'js.climb_how_4'|trans }}</li>
      </ol>
    {% endif %}
    <div class="wmap-stage">
      <div id="wmap" role="application" aria-label="{{ 'improve.step1.map_aria'|trans }}"></div>
      {% if item_type.letter == 'N' %}
        {# The next tap, on the map itself; improve.js keeps it in step with the readout. #}
        <div id="wz-mapHint" class="map-hint" aria-hidden="true" hidden>{{ 'improve.step1.readout_climb_foot'|trans }}</div>
      {% endif %}
    </div>
    <button type="button" id="wzChange" class="btn btn-g" hidden>◎ {{ 'improve.locate.change'|trans }}</button>
    <div class="readout">
      <span id="wz-readout">{{ 'improve.step1.readout_initial'|trans }}</span>
      {# Undo before Reset: it is the one you want after a mis-drag, and Reset
         next to it is the bigger hammer. Revealed by improve.js only when there
         is something to undo — a permanently dead control teaches nothing. #}
      <span id="wzUndo" role="button" tabindex="0" hidden>{{ 'js.climb_undo'|trans }}</span>
      <span id="wzReset" role="button" tabindex="0">{{ 'improve.step1.reset'|trans }}</span>
    </div>
    {% if item_type.letter == 'N' %}
      {# What the elevation model measured along the line: shown, never typed
         (docs/specs/climb-elevation.md §4). Filled by improve.js. #}
      <dl class="wz-measured" id="wz-measured" hidden>
        <div><dt>{{ 'improve.step1.measured_length'|trans }}</dt><dd id="wzm-len">—</dd></div>
        <div><dt>{{ 'improve.step1.measured_gain'|trans }}</dt><dd id="wzm-gain">—</dd></div>
        <div><dt>{{ 'improve.step1.measured_avg'|trans }}</dt><dd id="wzm-avg">—</dd></div>
        <div><dt>{{ 'improve.step1.measured_max'|trans }}</dt><dd id="wzm-max">—</dd></div>
      </dl>
    {% endif %}
    {% if item_type.locationMode.value == 'segment' %}
      {# The one gesture nobody discovers on their own (owner 2026-08-14):
         control points exist, and the same gesture removes them. Static text,
         always visible in segment mode — a hint inside a toast is gone before
         it is needed. The "Add a point" mode button is the touch answer
         (owner 2026-08-14, built 2026-08-16): tap to arm, tap the line to pin
         a point, tap a point to remove it — no gesture to discover, works
         with any pointer, and it never fights MapLibre for a long-press. #}
      <div class="covnote wz-ctrlrow">
        <button type="button" id="wzAddPt" aria-pressed="false" disabled>{{ 'improve.step1.ctrl_point_btn'|trans }}</button>
        <span id="wzCtrlHelp">{{ 'improve.step1.ctrl_point_help'|trans }}</span>
      </div>
    {% endif %}
    {% if add_mode|default(false) %}
      {# Unhidden by improve.js when the known-places overlay has dots in view. #}
      <div class="covnote" id="wz-known" hidden>{{ 'contribute.add.known_note'|trans }}</div>
    {% endif %}
  </section>

  {# STEP 2 — DETAILS (type-aware: Fix-details + Add-missing panes) #}
  <section class="pane" data-s="2" id="w-details">
    {# No pane heading here: the stepper's active step already says DETAILS in
       bold, so an "The details" H2 directly under it was the same word twice,
       and its lead line said nothing the fields below do not. #}
    {# One list of fields, not two. The registry's fix-details / add-missing
       split is a fact about the DATA, not about the rider's task: on a default
       OSM spot everything is missing, so "Fix the current details" headed a
       group of empty fields and "Add missing details" headed the rest. The
       rider fills in what they know either way. #}
    {# fgrid-a: the road-surface form ends Width | Note on ONE row (owner
       2026-08-14) — the generic textarea-spans-both-columns rule is undone for
       A's note so it sits beside width instead of below it. #}
    <div class="fgrid{{ item_type.letter == 'A' ? ' fgrid-a' }}">
    {% for child in form.details %}
      {# A links editor is a nested repeatable, not a control: it spans both
         columns the way a textarea does, or every row inside it wraps. #}
      <div class="field{{ child.vars.attr['data-links-editor'] is defined ? ' field-links' }}" data-f="{{ child.vars.name }}">
        {{ form_label(child) }}
        {{ form_widget(child) }}
      </div>
    {% endfor %}
    {% for child in form.extras %}
      <div class="field{{ child.vars.attr['data-links-editor'] is defined ? ' field-links' }}" data-f="{{ child.vars.name }}">
        {{ form_label(child) }}
        {{ form_widget(child) }}
      </div>
    {% endfor %}
    </div>
  </section>

  {# STEP 3 — PHOTOS & VIDEO #}
  <section class="pane" data-s="3" id="w-media">
    {# No pane heading: the stepper's active step already reads PHOTOS, the
       field below already says "Add a photo — optional", and the licence
       notice at the foot of this step states the terms in full. Three of the
       same sentence is not emphasis, it is clutter. #}

    {# C5: show the item's EXISTING photo(s) — a rider editing an item should
       see what's already there, not just an empty "add a photo" prompt.
       `current.photos` (plural gallery) wins over the singular `current.photo`,
       mirroring map.js's own photoList(f) = f.photos || [f.photo]. Read-only
       display at thumbnail size: `sm` is already the right variant, so no
       srcset here — offering `lg` would only cost the rider bytes
       (docs/specs/photo-uploads.md §5).
       no delete/replace here, this is display only (see improve.js for the add flow). #}
    {% set currentPhotos = [] %}
    {% if current is defined and current.photos is defined and current.photos is iterable %}
      {% set currentPhotos = current.photos %}
    {% elseif current is defined and current.photo is defined and current.photo %}
      {% set currentPhotos = [current.photo] %}
    {% endif %}
    {% if currentPhotos|length > 0 %}
      <div class="field">
        <label>{{ 'improve.step3.current_label'|trans }}</label>
        <div class="cur-photos" id="cur-photos">
          {% for p in currentPhotos %}
            <figure class="cur-photo">
              {# A 110px crop cannot answer the question this step asks — is
                 this the right photo, is anyone identifiable in it, is it worth
                 keeping? So the thumbnail opens the full-size file in a new tab
                 (owner 2026-08-12). A plain link, not a lightbox: it works
                 without JavaScript, it can be zoomed and saved, and it needs no
                 new machinery on a page that has enough. #}
              <a href="{{ p.lg|default(p.sm|default('')) }}" target="_blank" rel="noopener"
                 title="{{ 'improve.step3.open_full'|trans }}">
                <img src="{{ p.sm|default(p.lg|default('')) }}" alt="{{ 'improve.step3.current_alt'|trans({'%name%': current.name|default('')}) }}" loading="lazy" />
              </a>
              {% if p.credit is defined and p.credit %}
                <figcaption>© {{ p.credit }}{% if p.license is defined and p.license %} · {{ p.license }}{% endif %}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="field">
      <label for="file-photo">{{ 'improve.step3.photo_label'|trans }}</label>
      {# Consent gate (docs/specs/photo-uploads.md §4): filled by
         media-upload.js — either the "agree" button, or the standing notice
         once a record exists. The upload controls below stay disabled until the
         SERVER acknowledges. #}
      <div class="consent-gate" id="media-consent"></div>
      <input type="file" id="file-photo" accept="image/jpeg,image/png,image/webp,image/heic" multiple hidden>
      <div class="drop" id="drop-photo" role="button" tabindex="0" aria-controls="file-photo">
        <span class="ic">◳</span>{{ 'improve.step3.photo_drop'|trans }}<br/>
        <small>{{ 'improve.step3.photo_types'|trans }}</small>
      </div>
      <div class="ulq" id="q-photo"></div>
      {# The "paste a photo URL" row is GONE (owner 2026-08-16), and removed
         rather than hidden: it promised three things the code never did. It
         said Commons links had their "author & licence read from the Commons
         file page and validated automatically" - nothing read that page. It
         offered Flickr and "your site" - hosts the CSP img-src cannot even
         display. And the pasted url was used for exactly one thing, deciding
         whether the rider had changed anything, before being discarded: no
         column, no diff, no moderation card, nothing on approve.
         The honest version is specced in docs/TODO.md, "Photo by Commons
         link": allowlisted to Wikimedia Commons, licence read from the API,
         and the image FETCHED into our own quarantine-scan-publish pipeline
         rather than hot-linked from somebody else's server. #}
      {{ form_widget(form.mediaIds) }}
    </div>
    <div class="notice"><b>{{ 'improve.step3.notice_b'|trans }}</b> {{ 'improve.step3.notice'|trans }}</div>
  </section>

  {# STEP 4 — REVIEW & SUBMIT #}
  <section class="pane" data-s="4" id="w-review">
    <h2>{{ 'improve.step4.heading'|trans }}</h2>
    <p class="help">{{ 'improve.step4.help'|trans }}</p>
    <div class="card" id="reviewBody"></div>
    {# Filled + revealed by improve.js when an edit carries no change at all
       (the Submit button is disabled in the same breath). #}
    <p class="nochange" id="wz-nochange" hidden></p>
    {% if pending_submission_id is defined and pending_submission_id %}
      {# A curator lands here from the queue's ✎ to correct a detail; the
         decision itself is made on the map, in place, with the change set. #}
      <p class="nochange curator-decide" id="wz-curator-decide">{{ 'improve.review.curator_decide'|trans }}
        <a href="{{ path('map') }}?pending={{ pending_submission_id }}" target="_blank" rel="noopener">{{ 'improve.review.curator_decide_link'|trans }} &#8599;</a></p>
    {% endif %}

    {# The photos themselves, not their filenames. The heading is rendered here
       rather than in improve.js so it stays translated — that file has no
       message bag of its own. #}
    <div class="review-media" id="reviewMedia" hidden>
      <div class="rm-h">{{ 'improve.step4.media_heading'|trans }}</div>
      <div class="rm-list" id="reviewMediaList"></div>
    </div>

    {# The photos already on this place. Server-rendered and read-only: they
       are not part of the submission, but leaving them out made the review
       read as "this place has no photos" to a rider looking at a place whose
       photos they had just been shown two steps earlier. #}
    {% if currentPhotos|default([])|length > 0 %}
      <div class="review-media">
        <div class="rm-h">{{ 'improve.step4.media_existing'|trans }}</div>
        <div class="rm-list">
          {% for p in currentPhotos %}
            <figure class="rm-item is-existing">
              <img src="{{ p.sm|default(p.lg|default('')) }}" alt="{{ 'improve.step3.current_alt'|trans({'%name%': current.name|default('')}) }}" loading="lazy" />
            </figure>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Where this suggestion goes next. The ONE place the wizard explains the
       review process: step4.help used to say it too, and the receipt says it
       again after submitting, which made three tellings of one fact.

       ONE paragraph, not two. The per-type verdict line underneath repeated
       the funnel above it in different words — "a curator reads it, riders
       confirm it" followed by "riders never vote on these, a few just need to
       confirm it" — which is the same sentence twice. The type-specific half
       (votable or confirmable) now rides in the funnel line itself. #}
    <div class="lifecycle">
      <h3 class="lc-h">{{ 'improve.lifecycle.heading'|trans }}</h3>
      <p class="lc-funnel">{{ (item_type.isVotable ? 'improve.lifecycle.funnel_votable' : 'improve.lifecycle.funnel_utility')|trans({'%type%': item_type.labelKey|trans})|rich }}</p>
    </div>

    <p class="prov">{{ 'improve.step4.prov'|trans|rich }}</p>
    {# The licence receipt sits UNDER the provenance line, not above the review
       card (where it opened the step). Both sentences say what happens to what
       you send — the ODbL/CC BY-SA terms, then "and you already agreed to the
       photo half, on this date" — so they read as one closing block instead of
       a legal note interrupting the rider on the way to their own answers
       (docs/specs/photo-uploads.md §4). Same id, so media-upload.js still
       fills it. #}
    <div class="consent-gate" id="media-consent-review"></div>
  </section>

  {# NAV ROW #}
  <div class="navrow" id="navrow">
    <button class="btn btn-g" id="backBtn" type="button" style="visibility:hidden">← {{ 'improve.nav.back'|trans }}</button>
    <span class="spacer"></span>
    <button class="btn btn-p" id="nextBtn" type="button">{{ 'improve.nav.next'|trans }} →</button>
  </div>

  {{ form_end(form) }}
</div>
<div class="modal" id="modal"><div class="box" id="modal-box"></div></div>
{% endif %}
{% endblock %}
{% block body_scripts %}
<script src="{{ asset('lib/maplibre-gl-5.24.0.js') }}"></script>
{# climb-elevation.js + climb-editor.js must load before improve.js (Task 5: the
   climb edit path calls window.Cc.mountClimbEditor / window.Cc.profileFromRoute).
   Harmless no-op include for non-climb items — the scripts only attach to window.Cc. #}
<script nonce="{{ csp_nonce() }}">
  window.MAPILLARY_TOKEN = {{ mapillary_token|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# Satellite, which this wizard was missing while add-climb had it: the base
     control hides its Satellite button when no key reaches the page, so the
     imagery a rider needs to check a stretch simply was not on offer here
     (owner-reported 2026-08-12). Street-level stays — they answer different
     questions, and one is not a substitute for the other. #}
  window.CC_ESRI_KEY = {{ esri_api_key|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  window.CC_BASE_LABELS = {
    map: {{ 'map.base_map'|trans|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
    satellite: {{ 'map.base_satellite'|trans|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }},
    street: {{ 'map.street_level'|trans|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
  };
</script>
<script src="{{ asset('contribute/editor-base.js') }}"></script>
<script src="{{ asset('contribute/climb-elevation.js') }}"></script>
<script src="{{ asset('contribute/climb-editor.js') }}"></script>
{# coords.js registers window.Cc.parseLatLng — the place-search box reads it at
   mount time so a coordinate copied off the map can be pasted straight in. #}
<script src="{{ asset('contribute/coords.js') }}"></script>
{# media-upload.js registers window.Cc.mountMediaUploads, which improve.js
   calls at mount time — so it has to be defined first. #}
<script src="{{ asset('contribute/media-upload.js') }}"></script>
{# review-card.js registers window.Cc.reviewCard — the review step's DOM
   builders, which improve.js requires (it has no innerHTML fallback and no
   escaper of its own), so it has to be defined first. #}
<script src="{{ asset('contribute/links-editor.js') }}"></script>
<script src="{{ asset('contribute/review-card.js') }}"></script>
<script src="{{ asset('contribute/improve.js') }}"></script>
{% endblock %}
