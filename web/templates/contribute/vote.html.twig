{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .vhead{background:var(--ink);color:var(--paper);padding:3rem 0 2.4rem}
  .vhead .co{color:var(--glacier);margin-bottom:1rem}
  .round{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--trail);margin-top:.8rem}
  .vtabs{display:flex;gap:1.4rem;margin:1.4rem 0 0}
  .vtabs button{background:none;border:none;font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(239,230,212,.55);padding:.4rem 0;cursor:pointer;border-bottom:2px solid transparent}
  .vtabs button.on{color:var(--paper);border-color:var(--trail)}
  .vgrid{display:grid;grid-template-columns:1fr 320px;gap:2rem;padding:2.2rem 0}
  @media(max-width:820px){.vgrid{grid-template-columns:1fr}}
  .cand{display:flex;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .cand .nm{flex:1}.cand .nm h4{font-family:var(--serif);font-weight:600;font-size:1.15rem}.cand .nm .m{font-family:var(--mono);font-size:.62rem;color:#595c4d}
  .cand .scwrap{width:120px}.cand .sc{font-family:var(--mono);font-size:.6rem;color:#595c4d;margin-bottom:.25rem}
  .add{font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;padding:.5rem .8rem;border:1.5px solid var(--ink);border-radius:5px;background:none;cursor:pointer;white-space:nowrap}
  .add.in{background:var(--trail);border-color:var(--trail)}
  .ballot{background:var(--paper-deep);border-radius:10px;padding:1.4rem;align-self:start;position:sticky;top:5rem}
  .ballot h3{font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:#595c4d;margin-bottom:1rem}
  .bitem{display:flex;align-items:center;gap:.7rem;padding:.55rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.92rem}
  .bitem .r{font-family:var(--mono);color:var(--trail);font-size:.8rem;width:1.3rem}
  .bitem .x{margin-left:auto;color:var(--clay);cursor:pointer;font-family:var(--mono);font-size:.7rem}
  .bempty{color:#595c4d;font-size:.88rem;padding:1rem 0}
  .vnote{font-size:.78rem;color:#595c4d;margin-top:1rem;line-height:1.5;border-left:2px solid var(--glacier);padding-left:.7rem}
  .receipt{text-align:center;padding:4rem 1rem}
  .receipt h2{font-family:var(--serif);font-size:1.8rem;margin:.5rem 0}
  .receipt .ref{font-family:var(--mono);font-size:.72rem;color:#595c4d;margin-top:.5rem}
  .receipt .stub-note{display:inline-block;margin-top:1.2rem;font-size:.82rem;color:#6b5320;background:rgba(200,146,58,.13);border:1px solid rgba(200,146,58,.4);border-radius:6px;padding:.5rem 1rem;max-width:520px;line-height:1.5}
</style>
{% endblock %}
{% block body %}
{% if receipt is not null %}
<div class="receipt">
  <div style="font-size:2.4rem">◬</div>
  <h2>{{ 'vote.receipt.heading'|trans }}</h2>
  <p>{{ 'vote.receipt.body'|trans }}</p>
  <p class="ref">{{ 'vote.receipt.reference'|trans }} {{ receipt.reference }}</p>
  <p class="stub-note">{{ 'vote.receipt.stub_note'|trans }}</p>
  <div style="margin-top:2rem">
    <a class="btn btn-g" href="{{ path('region') }}">{{ 'vote.receipt.cta'|trans }}</a>
  </div>
</div>
{% else %}
<div class="vhead"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'vote.kicker'|trans }}</div>
  <h1 class="disp">{{ 'vote.title'|trans }}</h1>
  <div class="round">{{ 'vote.round'|trans }}</div>
  <div class="vtabs">
    <button class="on" onclick="voteCat(this,'climbs')">{{ 'vote.tab_climbs'|trans }}</button>
    <button onclick="voteCat(this,'stays')">{{ 'vote.tab_stays'|trans }}</button>
    <button onclick="voteCat(this,'views')">{{ 'vote.tab_views'|trans }}</button>
    <button onclick="voteCat(this,'heritage')">{{ 'vote.tab_heritage'|trans }}</button>
  </div>
</div></div>

<div class="wrap" id="main">
  {{ form_start(form, {attr: {id: 'vote-form'}}) }}
  {{ form_widget(form.ballot) }}
  <div class="vgrid">
    <div id="cands"></div>
    <div class="ballot">
      <h3>{{ 'vote.ballot_heading'|trans }} · <span id="cat-l">{{ 'vote.tab_climbs'|trans }}</span></h3>
      <div id="ballot"></div>
      <button type="submit" class="btn btn-p" style="width:100%;justify-content:center;margin-top:1.2rem">{{ 'vote.submit'|trans }}</button>
      <div class="vnote">{{ 'vote.privacy_note'|trans }}</div>
    </div>
  </div>
  {{ form_end(form) }}
</div>
{% endif %}
{% endblock %}
{% block body_scripts %}
<script src="{{ asset('contribute/vote.js') }}"></script>
{% endblock %}
