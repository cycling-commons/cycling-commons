{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .vhead{background:var(--ink);color:var(--paper);padding:3rem 0 2.4rem}
  .vhead .co{color:var(--glacier);margin-bottom:1rem}
  .round{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--trail);margin-top:.8rem}
  /* Pills, not four words in a row with one underlined (owner, 2026-08-29:
     "the tabs are not really recognizable as different tabs"). An outline gives
     every tab a resting shape you can see and aim at, and the chosen one is
     filled in the same orange as the site's primary buttons, so "this is the
     one you are looking at" is a fill and not a two-pixel rule.

     They sit on the PAPER background, so the resting colours are dark on light:
     8.9:1 for a tab you have not chosen, 5.5:1 for --ink on the orange fill. */
  /* The shared `.wrap#main` top padding is sized for a page that opens with
     prose. A control strip belongs tighter under the header it acts on, so
     this page takes it down to 1.5rem and the tabs add nothing on top
     (owner, 2026-08-29: "space above the tabs until the header is way too
     much"). Header to tabs goes from 70px to 24px. */
  .wrap#main{padding-top:1.5rem}
  .vtabs{display:flex;gap:.5rem;margin:0 0 1.4rem;flex-wrap:wrap}
  .vtabs button{background:none;border:1px solid rgba(20,22,14,.28);border-radius:999px;
    font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;
    color:#3a3d30;padding:.45rem 1rem;cursor:pointer;
    transition:background .15s,color .15s,border-color .15s}
  .vtabs button:hover{border-color:var(--ink);background:rgba(20,22,14,.05)}
  .vtabs button:focus-visible{outline:2px solid var(--clay);outline-offset:2px}
  .vtabs button.on{background:var(--trail);border-color:var(--trail);color:var(--ink);font-weight:700}
  .vgrid{display:grid;grid-template-columns:1fr 320px;gap:2rem;padding:2.2rem 0}
  @media(max-width:820px){.vgrid{grid-template-columns:1fr}}
  .cand{display:flex;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .cand .nm{flex:1}.cand .nm h4{font-family:var(--serif);font-weight:600;font-size:1.15rem}.cand .nm .m{font-family:var(--mono);font-size:.72rem;color:#595c4d}
  .cand .scwrap{width:120px}.cand .sc{font-family:var(--mono);font-size:.7rem;color:#595c4d;margin-bottom:.25rem}
  .add{font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;padding:.5rem .8rem;border:1.5px solid var(--ink);border-radius:5px;background:none;cursor:pointer;white-space:nowrap}
  .add.in{background:var(--trail);border-color:var(--trail)}
  .ballot{background:var(--paper-deep);border-radius:10px;padding:1.4rem;align-self:start;position:sticky;top:5rem}
  .ballot h3{font-family:var(--mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:#595c4d;margin-bottom:1rem}
  .bitem{display:flex;align-items:center;gap:.7rem;padding:.55rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.92rem}
  .bitem.dragging{opacity:.4}
  .bitem.dropover{box-shadow:inset 0 2px 0 var(--trail)}
  /* touch-action:none ONLY on the grip: dragging it reorders, touching the
     rest of the row still scrolls the page. */
  .bitem .grip{color:#9a9d8c;font-size:.68rem;cursor:grab;flex:none;touch-action:none;padding:.3rem .15rem;margin:-.3rem 0}
  .bitem .ud{display:flex;flex-direction:column;gap:.1rem;margin-left:auto}
  .bitem .ud .mv{background:none;border:1px solid rgba(20,22,14,.2);border-radius:4px;font-size:.68rem;line-height:1;padding:.15rem .3rem;cursor:pointer;color:var(--ink)}
  .bitem .ud .mv:hover:not(:disabled){border-color:var(--trail);color:var(--trail)}
  .bitem .ud .mv:disabled{opacity:.3;cursor:default}
  .bitem .x{margin-left:.4rem}
  .bitem .r{font-family:var(--mono);color:var(--trail);font-size:.8rem;width:1.3rem}
  .bitem .x{margin-left:auto;color:var(--clay);cursor:pointer;font-family:var(--mono);font-size:.7rem}
  .bempty{color:#595c4d;font-size:.90rem;padding:1rem 0}
  .vnote{font-size:.90rem;color:#595c4d;margin-top:1rem;line-height:1.5;border-left:2px solid var(--glacier);padding-left:.7rem}
  .vdemo{font-size:.90rem;color:#6b5320;background:rgba(200,146,58,.13);border:1px solid rgba(200,146,58,.4);border-radius:6px;padding:.6rem 1rem;margin:1.6rem auto 0;max-width:900px;line-height:1.5}
  .receipt{text-align:center;padding:4rem 1rem}
  .receipt h2{font-family:var(--serif);font-size:1.8rem;margin:.5rem 0}
  .receipt .ref{font-family:var(--mono);font-size:.72rem;color:#595c4d;margin-top:.5rem}
  .receipt .stub-note{display:inline-block;margin-top:1.2rem;font-size:.90rem;color:#6b5320;background:rgba(200,146,58,.13);border:1px solid rgba(200,146,58,.4);border-radius:6px;padding:.5rem 1rem;max-width:520px;line-height:1.5}
</style>
{% endblock %}
{% block body %}
{% if receipt is not null %}
<div class="receipt">
  {{ include('contribute/_receipt_mark.html.twig') }}
  <h2>{{ 'vote.receipt.heading'|trans }}</h2>
  <p>{{ 'vote.receipt.body'|trans }}</p>
  <p class="ref">{{ 'vote.receipt.reference'|trans }} {{ receipt.reference }}</p>
  <p class="stub-note">{{ 'vote.receipt.stub_note'|trans }}</p>
  <div style="margin-top:2rem">
    <a class="btn btn-g" href="{{ path('regions') }}">{{ 'vote.receipt.cta'|trans }}</a>
  </div>
</div>
{% else %}
<div class="vhead"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'vote.kicker'|trans }}</div>
  <h1 class="disp">{{ 'vote.title'|trans }}</h1>
  <div class="round">{{ 'vote.round'|trans }}</div>
</div></div>

<div class="wrap" id="main">
  {# The tabs open the MAIN CONTENT and are not part of the header (owner,
     2026-08-29). They choose what you are ranking, so they belong to the thing
     they change, not to the title above it.
     data-votecat, not onclick: the CSP blocks inline handlers and says so only
     in the console, so an onclick tab is a tab that silently does nothing. #}
  <div class="vtabs" role="tablist" aria-label="{{ 'vote.ballot_heading'|trans }}">
    <button class="on" data-votecat="climbs">{{ 'vote.tab_climbs'|trans }}</button>
    <button data-votecat="stays">{{ 'vote.tab_stays'|trans }}</button>
    <button data-votecat="views">{{ 'vote.tab_views'|trans }}</button>
    <button data-votecat="heritage">{{ 'vote.tab_heritage'|trans }}</button>
  </div>
  <p class="vdemo">{{ 'vote.demo_notice'|trans }}</p>
  {{ form_start(form, {attr: {id: 'vote-form'}}) }}
  {% include 'partials/_form_errors.html.twig' with {form: form} %}
  {{ form_widget(form.ballot) }}
  <div class="vgrid">
    <div id="cands"></div>
    <div class="ballot">
      <h3>{{ 'vote.ballot_heading'|trans }} · <span id="cat-l">{{ 'vote.tab_climbs'|trans }}</span></h3>
      <div id="ballot"></div>
      <button type="submit" class="btn btn-p" style="width:100%;justify-content:center;margin-top:1.2rem">{{ 'vote.submit'|trans }}</button>
      <div class="vnote">{{ 'vote.privacy_note'|trans }}</div>
    </div>
  </div>
  {{ form_end(form) }}
</div>
{% endif %}
{% endblock %}
{% block body_scripts %}
{# Data, not executable script: type="application/json" is CSP-inert. Strings
   the client renders (candidate rows, ballot panel) — the real vote feature
   reuses these keys, so keep them in the vote.* catalog group. #}
<script type="application/json" id="vote-i18n">{{ {
  pct: 'vote.pct_this_round'|trans,
  add: 'vote.add'|trans,
  onBallot: 'vote.on_ballot'|trans,
  remove: 'vote.remove'|trans,
  empty: 'vote.empty_ballot'|trans,
  reorder: 'vote.reorder_hint'|trans,
  moveUp: 'vote.move_up'|trans,
  moveDown: 'vote.move_down'|trans,
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script src="{{ asset('contribute/vote.js') }}"></script>
{% endblock %}
