{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/catalog-cards.css') }}" />
<link rel="stylesheet" href="{{ asset('styles/page/contribute/index.css') }}">
{% endblock %}
{% block body %}
<div class="ahero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'contribute_hub.kicker'|trans }}</div>
  <h1 class="disp">{{ 'contribute_hub.title'|trans }}</h1>
  <p class="lead" style="margin-top:1rem">{{ 'contribute_hub.lead'|trans }}</p>
</div></div>

<section class="pad"><div class="wrap">
  {# The same cards as the home page's field guide (partials/_catalog_card.html.twig),
     each with what it lets a rider add at its foot. #}
  <p class="fresh-key">{{ 'home.cat_fresh_key'|trans|rich }}</p>

  <h3 class="cat-h"><b>{{ 'home.cat_practical_h'|trans }}:</b> <span>{{ 'home.cat_practical_sub'|trans|rich }}</span></h3>
  <div class="grid">
    {% include 'partials/_catalog_card.html.twig' with {letter: 'A', title: 'home.cat_card_surface_h', text: 'home.cat_card_surface_p', id: 'type-road-surface', href: path('improve', {type: 'road-surface', mode: 'add'}), go: 'contribute_hub.card_surface_go'} only %}
    {# Water and food, and public toilets (C): two forms behind one card, as on the home page. #}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'B', title: 'home.cat_card_water_h', text: 'home.cat_card_water_p', id: 'type-water-food', actions: [
      {href: path('improve', {type: 'water-food', mode: 'add'}), label: 'contribute_hub.card_water_go'},
      {href: path('improve', {type: 'public-toilets', mode: 'add'}), label: 'contribute_hub.card_toilets_go'},
    ]} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'D', title: 'home.cat_card_services_h', text: 'home.cat_card_services_p', id: 'type-bike-services', href: path('improve', {type: 'bike-services', mode: 'add'}), go: 'contribute_hub.card_services_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'E', title: 'home.cat_card_hazards_h', text: 'home.cat_card_hazards_p', id: 'type-hazards', href: path('improve', {type: 'hazards', mode: 'add'}), go: 'contribute_hub.card_hazards_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'F', title: 'home.cat_card_getting_h', text: 'home.cat_card_getting_p', id: 'type-getting-there', href: path('improve', {type: 'getting-there', mode: 'add'}), go: 'contribute_hub.card_transit_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'G', title: 'home.cat_card_shelter_h', text: 'home.cat_card_shelter_p', id: 'type-shelter', href: path('improve', {type: 'shelter', mode: 'add'}), go: 'contribute_hub.card_shelter_go'} only %}
    <div class="card suggest"><span class="ic">✎</span><h4>{{ 'home.cat_suggest_h'|trans }}</h4><p>{{ 'home.cat_suggest_p'|trans }}</p><a href="https://github.com/cycling-commons/cycling-commons/issues/new/choose">{{ 'home.cat_suggest_link'|trans }}</a></div>
  </div>

  <h3 class="cat-h"><b>{{ 'home.cat_emotional_h'|trans }}:</b> <span>{{ 'home.cat_emotional_sub'|trans|rich }}</span></h3>
  <div class="grid">
    {% include 'partials/_catalog_card.html.twig' with {letter: 'N', title: 'home.cat_card_climbs_h', text: 'home.cat_card_climbs_p', id: 'type-climbs', href: path('improve', {type: 'climbs', mode: 'add'}), go: 'contribute_hub.card_climbs_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'O', title: 'home.cat_card_sleep_h', text: 'home.cat_card_sleep_p', id: 'type-where-to-sleep', href: path('improve', {type: 'where-to-sleep', mode: 'add'}), go: 'contribute_hub.card_sleep_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'P', title: 'home.cat_card_scenic_h', text: 'home.cat_card_scenic_p', id: 'type-scenic-views', href: path('improve', {type: 'scenic-views', mode: 'add'}), go: 'contribute_hub.card_views_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'Q', title: 'home.cat_card_history_h', text: 'home.cat_card_history_p', id: 'type-history-culture', href: path('improve', {type: 'history-culture', mode: 'add'}), go: 'contribute_hub.card_history_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'R', title: 'home.cat_card_quality_h', text: 'home.cat_card_quality_p', id: 'type-quality-rides', href: path('propose_route'), go: 'contribute_hub.card_rides_go'} only %}
    {% include 'partials/_catalog_card.html.twig' with {letter: 'N', title: 'vote.tab_climbs', text: 'pages.card_vote_p', href: path('vote'), go: 'region.cta_vote'} only %}
    <div class="card suggest"><span class="ic">✎</span><h4>{{ 'home.cat_suggest2_h'|trans }}</h4><p>{{ 'home.cat_suggest2_p'|trans }}</p><a href="https://github.com/cycling-commons/cycling-commons/issues/new/choose">{{ 'home.cat_suggest_link'|trans }}</a></div>
  </div>

  {# HIDDEN UNTIL THERE ARE RIDES TO DRAW (docs/TODO.md, "Ride heatmap").
     The whole category goes, not just the card: the heatmap is the only thing
     in it, and a heading over an empty grid reads as something broken rather
     than something coming. Restore both together.
  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_derived_h'|trans }}:</b> <span>{{ 'contribute_hub.cat_derived_sub'|trans }}</span></h3>
  <div class="grid">
    <div class="card off">
      <span class="ic">◴</span>
      <h4>{{ 'contribute_hub.card_heatmap_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_heatmap_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_heatmap_go'|trans }}</span>
    </div>
  </div>
  #}

  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_atlas_h'|trans }}:</b> <span>{{ 'contribute_hub.cat_atlas_sub'|trans }}</span></h3>
  <div class="grid">
    {% include 'partials/_catalog_card.html.twig' with {glyph: '文', title: 'contribute_hub.card_translate_h', text: 'contribute_hub.card_translate_p', href: path('translate'), go: 'contribute_hub.card_translate_go'} only %}
  </div>

  <div class="notice">
    {{ 'contribute_hub.notice_pre'|trans }} <b>{{ 'contribute_hub.notice_odbl'|trans }}</b>{{ 'contribute_hub.notice_mid'|trans }} <b>{{ 'contribute_hub.notice_ccbysa'|trans }}</b>{{ 'contribute_hub.notice_post'|trans }}
  </div>
</div></section>
{% endblock %}
