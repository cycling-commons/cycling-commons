{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .ahero .lead{color:rgba(239,230,212,.85)}

  .cat-h{font-family:var(--mono);font-size:.92rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);margin-top:2.6rem;display:flex;align-items:baseline;gap:.8rem}
  .cat-h b{color:var(--clay)}
  .cat-h span{font-family:var(--sans);font-weight:400;font-size:1rem;letter-spacing:0;text-transform:none;color:#5a5d4d}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;margin-top:1rem}
  .card{position:relative;display:flex;flex-direction:column;background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:8px;padding:1.3rem;transition:all .22s;overflow:hidden}
  .card:hover{transform:translateY(-3px);box-shadow:0 14px 30px -16px rgba(20,22,14,.5);border-color:var(--trail)}
  .card .ic{font-size:1.5rem;margin-bottom:.7rem;display:block;filter:brightness(0)}
  .card h4{font-family:var(--serif);font-weight:600;font-size:1.2rem;margin-bottom:.3rem}
  .card p{font-size:.90rem;color:#4a4d40;line-height:1.55;margin-bottom:1rem}
  .card .go{margin-top:auto;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .card.off{opacity:.55;cursor:default}
  .card.off:hover{transform:none;box-shadow:none;border-color:rgba(20,22,14,.14)}
  .card.off .go{color:#7a7d6d}
  @media(max-width:560px){
    .grid{grid-template-columns:repeat(2,1fr);gap:.7rem}
    .card{padding:.85rem}
    .card .ic{font-size:1.25rem;margin-bottom:.35rem}
    .card h4{font-size:1rem;margin-bottom:.25rem}
    .card p{font-size:.90rem;line-height:1.45;margin-bottom:.7rem}
    .card .go{font-size:.68rem}
  }
  @media(max-width:380px){ .grid{grid-template-columns:1fr} }

  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.84rem;
    color:#4a4d40;border-radius:0 6px 6px 0;margin-top:2.2rem;line-height:1.55}
</style>
{% endblock %}
{% block body %}
<div class="ahero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'contribute_hub.kicker'|trans }}</div>
  <h1 class="disp">{{ 'contribute_hub.title'|trans }}</h1>
  <p class="lead" style="margin-top:1rem">{{ 'contribute_hub.lead'|trans }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_practical_h'|trans }}</b> <span>{{ 'contribute_hub.cat_practical_sub'|trans }}</span></h3>
  <div class="grid">
    <a class="card" href="{{ path('improve', {type: 'road-surface', mode: 'add'}) }}">
      <span class="ic">▰</span>
      <h4>{{ 'contribute_hub.card_surface_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_surface_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_surface_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'water-food', mode: 'add'}) }}">
      <span class="ic">💧</span>
      <h4>{{ 'contribute_hub.card_water_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_water_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_water_go'|trans }}</span>
    </a>
    {# Toilets (C) sit next to water, in catalogue order. #}
    <a class="card" href="{{ path('improve', {type: 'public-toilets', mode: 'add'}) }}">
      <span class="ic">🚻</span>
      <h4>{{ 'contribute_hub.card_toilets_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_toilets_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_toilets_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'bike-services', mode: 'add'}) }}">
      <span class="ic">⚙</span>
      <h4>{{ 'contribute_hub.card_services_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_services_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_services_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'hazards', mode: 'add'}) }}">
      <span class="ic">⚠</span>
      <h4>{{ 'contribute_hub.card_hazards_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_hazards_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_hazards_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'getting-there', mode: 'add'}) }}">
      <span class="ic">🚆</span>
      <h4>{{ 'contribute_hub.card_transit_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_transit_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_transit_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'shelter', mode: 'add'}) }}">
      <span class="ic">⛑</span>
      <h4>{{ 'contribute_hub.card_shelter_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_shelter_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_shelter_go'|trans }}</span>
    </a>
  </div>

  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_emotional_h'|trans }}</b> <span>{{ 'contribute_hub.cat_emotional_sub'|trans }}</span></h3>
  <div class="grid">
    <a class="card" href="{{ path('improve', {type: 'climbs', mode: 'add'}) }}">
      <span class="ic"><svg class="ic-mtn" viewBox="0 0 24 18" width="26" height="20" aria-hidden="true" focusable="false"><path d="M0 18 L7.5 4 L11 10 L14.5 5.5 L24 18 Z" fill="currentColor"/></svg></span>
      <h4>{{ 'contribute_hub.card_climbs_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_climbs_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_climbs_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'where-to-sleep', mode: 'add'}) }}">
      <span class="ic">⛺</span>
      <h4>{{ 'contribute_hub.card_sleep_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_sleep_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_sleep_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'scenic-views', mode: 'add'}) }}">
      <span class="ic">📷</span>
      <h4>{{ 'contribute_hub.card_views_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_views_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_views_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('improve', {type: 'history-culture', mode: 'add'}) }}">
      <span class="ic">🏛</span>
      <h4>{{ 'contribute_hub.card_history_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_history_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_history_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('propose_route') }}">
      <span class="ic">★</span>
      <h4>{{ 'contribute_hub.card_rides_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_rides_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_rides_go'|trans }}</span>
    </a>
    <a class="card" href="{{ path('vote') }}">
      <span class="ic">◬</span>
      <h4>{{ 'vote.tab_climbs'|trans }}</h4>
      <p>{{ 'pages.card_vote_p'|trans }}</p>
      <span class="go">{{ 'region.cta_vote'|trans }}</span>
    </a>
  </div>

  {# HIDDEN UNTIL THERE ARE RIDES TO DRAW (docs/TODO.md, "Ride heatmap").
     The whole category goes, not just the card: the heatmap is the only thing
     in it, and a heading over an empty grid reads as something broken rather
     than something coming. Restore both together.
  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_derived_h'|trans }}</b> <span>{{ 'contribute_hub.cat_derived_sub'|trans }}</span></h3>
  <div class="grid">
    <div class="card off">
      <span class="ic">◴</span>
      <h4>{{ 'contribute_hub.card_heatmap_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_heatmap_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_heatmap_go'|trans }}</span>
    </div>
  </div>
  #}

  <h3 class="cat-h"><b>{{ 'contribute_hub.cat_atlas_h'|trans }}</b> <span>{{ 'contribute_hub.cat_atlas_sub'|trans }}</span></h3>
  <div class="grid">
    <a class="card" href="{{ path('translate') }}">
      <span class="ic">文</span>
      <h4>{{ 'contribute_hub.card_translate_h'|trans }}</h4>
      <p>{{ 'contribute_hub.card_translate_p'|trans }}</p>
      <span class="go">{{ 'contribute_hub.card_translate_go'|trans }}</span>
    </a>
  </div>

  <div class="notice">
    {{ 'contribute_hub.notice_pre'|trans }} <b>{{ 'contribute_hub.notice_odbl'|trans }}</b>{{ 'contribute_hub.notice_mid'|trans }} <b>{{ 'contribute_hub.notice_ccbysa'|trans }}</b>{{ 'contribute_hub.notice_post'|trans }}
  </div>
</div></section>
{% endblock %}
