{#
  How a region text links its sources, and puts a local word in italics, as
  list items for a "How to write it" list (§3.1b, §3.1c). Each example shows
  the markup (the link in the box's own tints), then how the page reads it,
  so the markup is learned by sight; its words are messages, so it is in the
  page's own language.
#}
{% set ex_words = 'place_text.howto_ex_words'|trans %}
<li>{{ 'place_text.howto_cite'|trans }}
  <code class="pt-howto-ex"><mark class="w">[{{ ex_words }}]</mark><mark class="u">({{ 'place_text.howto_ex_url'|trans }})</mark></code>
  {{ 'place_text.howto_reads'|trans }} <span class="pt-howto-link">{{ ex_words }}</span></li>
<li>{{ 'place_text.howto_words'|trans }}</li>
<li>{{ 'place_text.howto_sites'|trans }}</li>
<li>{{ 'place_text.howto_italic'|trans }} <code class="pt-howto-ex">*{{ 'place_text.howto_italic_ex'|trans }}*</code>
  {{ 'place_text.howto_reads'|trans }} <em>{{ 'place_text.howto_italic_ex'|trans }}</em></li>
