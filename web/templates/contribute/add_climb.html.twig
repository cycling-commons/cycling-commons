{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('lib/maplibre-gl-5.24.0.css') }}" />
<style>
  .ey{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.5rem}
  h1.disp{font-family:var(--serif);font-weight:600;font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.05;margin-bottom:.4rem}
  .sub{color:#4a4d40;margin-bottom:1.6rem}

  /* stepper */
  .stepper{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-bottom:2rem;border-bottom:1px solid rgba(20,22,14,.15);padding-bottom:1rem}
  .stepper li{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:#9a9d8c;display:flex;align-items:center;gap:.45rem}
  .stepper li::before{content:counter(step);counter-increment:step;display:inline-flex;align-items:center;justify-content:center;width:1.4rem;height:1.4rem;border-radius:50%;border:1.5px solid rgba(20,22,14,.25);font-size:.62rem;color:#595c4d}
  .stepper{counter-reset:step}
  .stepper li.done{color:#5a5d4d}.stepper li.done::before{background:var(--spruce);border-color:var(--spruce);color:var(--paper);content:"✓"}
  .stepper li.on{color:var(--ink)}.stepper li.on::before{border-color:var(--trail);color:var(--ink)}

  /* panes */
  .pane{display:none}.pane.on{display:block;animation:fade .4s ease}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .pane h2{font-family:var(--serif);font-weight:600;font-size:1.5rem;margin-bottom:.3rem}
  .pane .help{color:#595c4d;font-size:.9rem;margin-bottom:1.3rem}

  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  .field input,.field textarea{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none;color:var(--ink)}
  .field select{width:100%;max-width:22rem}  /* look is global (atlas.css) */
  .field input[readonly]{color:#595c4d}
  .field textarea{border:1.5px solid rgba(20,22,14,.25);border-radius:6px;padding:.7rem;min-height:80px;resize:vertical}
  .field input:focus,.field textarea:focus{border-color:var(--trail)}
  .field .fhelp{font-family:var(--mono);font-size:.62rem;color:#9a9d8c;margin-top:.35rem;text-transform:none;letter-spacing:0}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  @media(max-width:520px){.two{grid-template-columns:1fr}}

  /* step 1 map */
  #cmap{height:clamp(400px,60vh,640px);border-radius:8px;overflow:hidden;border:1px solid rgba(20,22,14,.15);margin-bottom:.8rem;background:var(--paper-deep)}
  .maplibregl-canvas{filter:none}  /* no per-frame filter chain on the WebGL canvas (same call as map.css) */
  .readout{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;color:#4a4d40;flex-wrap:wrap}
  .readout #reset,.readout #undo{color:var(--clay);cursor:pointer;text-transform:uppercase;letter-spacing:.1em;font-size:.64rem}
  .readout #undo{margin-left:auto}
  /* How to place a climb — read before the map, not after a mistake.
     Same block, same rules as /improve's letter-B step (improve.html.twig). */
  .climb-howto{margin:0 0 .9rem;padding:.75rem 1rem .75rem 2.1rem;background:var(--paper-deep);
    border-left:2px solid var(--trail);border-radius:0 6px 6px 0;font-size:.86rem;line-height:1.55;color:#4a4d40}
  .climb-howto li{margin:.18rem 0}
  /* No `position` on .cc-marker: MapLibre's .maplibregl-marker{position:absolute}
     must win — a relative marker stays in-flow, stretches to the map's width and
     breaks the anchor translate(-50%,-100%); absolute is still the label's
     containing block. line-height only kills the inline-SVG baseline gap, so the
     label restores its own. */
  .cc-marker{line-height:0;filter:drop-shadow(0 3px 6px rgba(20,22,14,.4))}
  .cc-mk-label{font-family:var(--mono);font-size:.56rem;line-height:1.35;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:var(--paper);border:1px solid rgba(20,22,14,.3);border-radius:3px;padding:.12rem .4rem;white-space:nowrap;position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:.3rem;box-shadow:0 2px 6px rgba(20,22,14,.3)}
  .cc-mk-label:empty{display:none}

  /* place search */
  .csearch{position:relative}
  .csearch input{background:#F8F2E4;border:1.5px solid rgba(20,22,14,.22);border-radius:8px;padding:.65rem .85rem}
  .csearch input::placeholder{color:#9a9d8c}
  .csearch input:focus{border-color:var(--trail);background:#FCF8EE}
  .csearch-results{position:absolute;left:0;right:0;top:100%;z-index:20;background:var(--paper);border:1px solid rgba(20,22,14,.2);border-radius:0 0 8px 8px;box-shadow:0 14px 28px -14px rgba(20,22,14,.45);max-height:250px;overflow-y:auto}
  .csearch-results .res{padding:.55rem .8rem;cursor:pointer;border-bottom:1px solid rgba(20,22,14,.08)}
  .csearch-results .res:hover{background:var(--paper-deep)}
  .csearch-results .res b{font-size:.92rem;font-weight:500}
  .csearch-results .res small{display:block;color:#595c4d;font-size:.74rem;font-family:var(--mono)}
  .csearch-results .res.empty{color:#595c4d;cursor:default}

  /* name preview */
  .namepreview{font-family:var(--serif);font-weight:600;font-size:1.4rem;color:var(--ink);margin-bottom:1rem;padding-bottom:.6rem;border-bottom:1px dashed rgba(20,22,14,.2)}
  .namepreview.empty{color:#9a9d8c;font-style:italic}

  /* photo drop + notice */
  .drop{border:1.5px dashed rgba(20,22,14,.3);border-radius:10px;padding:2rem;text-align:center;color:#595c4d;cursor:pointer}
  .drop:hover{border-color:var(--trail);color:var(--ink)}
  .drop .ic{font-size:1.6rem;display:block;margin-bottom:.5rem}
  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.8rem 1rem;font-size:.82rem;color:#4a4d40;border-radius:0 6px 6px 0;margin-top:1rem;line-height:1.5}

  /* review card */
  .card{background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:8px;padding:1.4rem}
  .card .co{font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;color:#595c4d;text-transform:uppercase}
  .card h3{font-family:var(--serif);font-weight:600;font-size:1.35rem;margin:.2rem 0 .6rem}
  .card .rtags{display:flex;gap:.35rem;flex-wrap:wrap;margin-bottom:.8rem}
  .card .rtags span{font-family:var(--mono);font-size:.58rem;padding:.18rem .4rem;border:1px solid rgba(20,22,14,.2);border-radius:3px;color:#4a4d40}
  .kv{display:flex;justify-content:space-between;gap:1rem;font-size:.9rem;padding:.38rem 0;border-bottom:1px solid rgba(20,22,14,.08)}
  .kv span:first-child{color:#595c4d}
  .card .rnote{margin-top:.7rem;font-size:.9rem}
  .prov{font-size:.8rem;color:#595c4d;margin-top:1rem;line-height:1.5}

  /* nav row */
  .navrow{display:flex;align-items:center;gap:1rem;margin-top:2rem;padding-top:1.6rem;border-top:1px solid rgba(20,22,14,.12)}
  .navrow .spacer{flex:1}

  /* submitted (demo wizard client side) */
  .done-ic{font-size:2.4rem;text-align:center}
  .pane.submitted{text-align:center;padding:1rem}
  .pane.submitted h2{font-size:1.9rem;margin:.5rem 0}
  .pane.submitted p{color:#4a4d40;max-width:46ch;margin:0 auto 1.4rem}

  /* server-side receipt (POST stub state) */
  .receipt{text-align:center;padding:4rem 1rem}
  .receipt h2{font-family:var(--serif);font-size:1.8rem;margin:.5rem 0}
  .receipt .ref{font-family:var(--mono);font-size:.72rem;color:#595c4d;margin-top:.5rem}
  .receipt .stub-note{display:inline-block;margin-top:1.2rem;font-size:.82rem;color:#6b5320;background:rgba(200,146,58,.13);border:1px solid rgba(200,146,58,.4);border-radius:6px;padding:.5rem 1rem;max-width:520px;line-height:1.5}

  /* journey diagram */
  .journey{background:var(--ink);color:var(--paper);padding:clamp(2.4rem,5vw,4rem) 0;position:relative;overflow:hidden}
  .journey .jwrap{max-width:980px;margin:0 auto;padding:0 2rem;position:relative;z-index:1}
  .journey .ey{color:var(--ochre)}
  .journey h2{font-family:var(--serif);font-weight:600;font-size:clamp(1.5rem,3vw,2.1rem);margin-bottom:.5rem}
  .journey .jsub{color:rgba(239,230,212,.7);font-size:.92rem;margin-bottom:2rem;max-width:60ch}
  .spine{display:flex;flex-wrap:wrap;align-items:stretch;gap:.6rem}
  .jnode{flex:1;min-width:130px;background:var(--spruce);border:1px solid var(--spruce-lift);border-radius:8px;padding:.85rem .9rem;display:flex;flex-direction:column;gap:.4rem}
  .jnode .jdot{width:8px;height:8px;border-radius:50%;background:var(--glacier)}
  .jnode .jt{font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:var(--glacier)}
  .jnode .jl{font-size:.86rem;line-height:1.35}
  .jnode.goal{background:var(--spruce-lift)}.jnode.goal .jdot{background:var(--trail)}
  .jarrow{align-self:center;color:var(--ochre);font-family:var(--mono);font-size:1rem}
  .jnode.here{box-shadow:0 0 0 2px var(--trail);position:relative}
  .jnode.here::after{content:"you are here";position:absolute;top:-.6rem;right:.5rem;background:var(--trail);color:var(--ink);font-family:var(--mono);font-size:.5rem;letter-spacing:.08em;text-transform:uppercase;padding:.1rem .35rem;border-radius:3px}
  .branches{display:flex;gap:.6rem;margin-top:.9rem;flex-wrap:wrap}
  .jbranch{flex:1;min-width:180px;border:1px dashed rgba(239,230,212,.3);border-radius:8px;padding:.7rem .9rem;font-size:.82rem;color:rgba(239,230,212,.85)}
  .jbranch b{color:var(--clay);font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:.2rem}
  .branch-lead{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(239,230,212,.5);margin:1.2rem 0 .3rem}
  @media(max-width:680px){.spine{flex-direction:column}.jarrow{transform:rotate(90deg)}}

  #reset:focus-visible,#undo:focus-visible,.drop:focus-visible,.btn:focus-visible{outline:2px solid var(--trail);outline-offset:2px;border-radius:4px}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
{% endblock %}
{% block body %}
{% if receipt is not null %}
{# ── SERVER-SIDE RECEIPT (honest stub state after POST) ── #}
<div class="wrap" id="main">
  <div class="receipt">
    {{ include('contribute/_receipt_mark.html.twig') }}
    <h2>{{ 'add_climb.receipt.heading'|trans }}</h2>
    <p>{{ 'add_climb.receipt.body'|trans }}</p>
    <p class="ref">{{ 'add_climb.receipt.reference'|trans }} {{ receipt.reference }}</p>
    <p class="stub-note">{{ 'add_climb.receipt.stub_note'|trans }}</p>
    <div style="margin-top:2rem">
      <a class="btn btn-g" href="{{ path('map') }}">{{ 'add_climb.receipt.cta'|trans }}</a>
    </div>
  </div>
</div>
{% else %}
{# ── WIZARD ── #}
<div class="wrap" id="wiz">
  <div class="ey">{{ 'add_climb.eyebrow'|trans }}</div>
  <h1 class="disp">{{ 'add_climb.title'|trans }}</h1>
  <p class="sub">{{ 'add_climb.lead'|trans }}</p>

  {# Translated marker labels for the shared climb editor (foot/summit/steepest) — read as a fallback by climb-editor.js when a mount call doesn't pass opts.labels explicitly. #}
  <script nonce="{{ csp_nonce() }}">window.CC_EDITOR_LABELS = {{ {foot: 'js.climb_marker_foot'|trans, summit: 'js.climb_marker_summit'|trans, steepest: 'js.climb_marker_steepest'|trans}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>

  {# Every string add-climb.js renders itself, serialised the same way as the
     bag above and as improve.html.twig's (docs/plans/2026-08-01-improve-js-i18n.md).
     All four JSON_HEX_* flags: JSON_HEX_TAG is the one that matters, because
     it turns `<`/`>` into </> so a catalogue string containing
     `</script>` cannot close this block.

     Everything in this bag is TEXT. add-climb.js sets it with textContent and
     never with innerHTML; copy that needs markup stays in this template, where
     |rich sanitises it. #}
  <script nonce="{{ csp_nonce() }}">window.CC_ADD_CLIMB_I18N = {{ {
    nav_next: 'add_climb.nav.next'|trans,
    nav_submit: 'add_climb.nav.submit'|trans,
    readout_initial: 'add_climb.step1.readout_initial'|trans,
    readout_climb_summit: 'add_climb.step1.readout_climb_summit'|trans,
    readout_climb_set: 'add_climb.step1.readout_climb_set'|trans,
    climb_length: 'add_climb.step1.climb_length'|trans,
    climb_measuring: 'add_climb.step1.climb_measuring'|trans,
    climb_route_error: 'add_climb.step1.climb_route_error'|trans,
    climb_profile_error: 'add_climb.step1.climb_profile_error'|trans,
    search_no_matches: 'add_climb.step1.search_no_matches'|trans,
    search_unavailable: 'add_climb.step1.search_unavailable'|trans,
    search_result: 'add_climb.step1.search_result'|trans,
    search_coords_go: 'add_climb.step1.search_coords_go'|trans,
    name_placeholder: 'add_climb.step2.name_placeholder'|trans,
    review_loc: 'add_climb.step4.loc'|trans,
    label_length: 'add_climb.step4.label_length'|trans,
    label_gain: 'add_climb.step4.label_gain'|trans,
    label_avg: 'add_climb.step4.label_avg'|trans,
    label_max: 'add_climb.step4.label_max'|trans,
    label_surface: 'add_climb.step4.label_surface'|trans,
    label_traffic: 'add_climb.step4.label_traffic'|trans,
    label_osm: 'add_climb.step4.label_osm'|trans,
    your_climb: 'add_climb.step5.your_climb'|trans
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>

  {{ form_start(form, {attr: {id: 'add-climb-form', novalidate: 'novalidate'}}) }}

  {# Hidden geocoded location fields (filled by add-climb.js) #}
  {{ form_widget(form.lat) }}
  {{ form_widget(form.lng) }}
  {{ form_widget(form.place) }}

  {# Hidden climb geometry fields (filled by the shared three-point editor, climb-editor.js) #}
  {{ form_widget(form.route) }}
  {{ form_widget(form.grad) }}
  {{ form_widget(form.steep) }}
  {{ form_widget(form.avg) }}
  {{ form_widget(form.steepPoint) }}

  <ol class="stepper" id="stepper">
    <li class="on" data-s="1">{{ 'add_climb.step1.label'|trans }}</li>
    <li data-s="2">{{ 'add_climb.step2.label'|trans }}</li>
    <li data-s="3">{{ 'add_climb.step3.label'|trans }}</li>
    <li data-s="4">{{ 'add_climb.step4.label'|trans }}</li>
    <li data-s="5">{{ 'add_climb.step5.label'|trans }}</li>
  </ol>

  {# STEP 1 — WHERE #}
  <section class="pane on" data-s="1">
    <h2>{{ 'add_climb.step1.heading'|trans }}</h2>
    {# |rich: the key carries <b> emphasis — plain |trans escaped it to literal tags. #}
    <p class="help">{{ 'add_climb.step1.help'|trans|rich }}</p>
    <div class="field csearch">
      <label for="placeSearch">{{ 'add_climb.step1.search_label'|trans }}</label>
      <input id="placeSearch" type="search" autocomplete="off" placeholder="{{ 'add_climb.step1.search_placeholder'|trans }}" />
      <div class="csearch-results" id="searchResults" hidden></div>
    </div>
    {# Placing a climb is not dropping a pin: three points, in order, with the
       road between the first two snapped for you. The readout narrates the
       step you are on, but a rider needs the whole shape BEFORE they start —
       especially that a third tap marks the steepest ramp, which nothing else
       on screen would suggest. Same four lines /improve shows for letter B:
       one editor, one explanation (js.climb_how_*). #}
    <ol class="climb-howto">
      <li>{{ 'js.climb_how_1'|trans }}</li>
      <li>{{ 'js.climb_how_2'|trans }}</li>
      <li>{{ 'js.climb_how_3'|trans }}</li>
      <li>{{ 'js.climb_how_4'|trans }}</li>
    </ol>
    <div id="cmap" role="application" aria-label="{{ 'add_climb.step1.map_aria'|trans }}"></div>
    <div class="readout">
      <span id="readout">{{ 'add_climb.step1.readout_initial'|trans }}</span>
      {# Undo before Reset: it is the one you want after a mis-drag, and Reset
         next to it is the bigger hammer. Revealed by add-climb.js only when
         there is history to take back — a permanently dead control teaches
         nothing. #}
      <span id="undo" role="button" tabindex="0" hidden>{{ 'js.climb_undo'|trans }}</span>
      <span id="reset" role="button" tabindex="0">{{ 'add_climb.step1.reset'|trans }}</span>
    </div>
  </section>

  {# STEP 2 — PROFILE #}
  <section class="pane" data-s="2">
    <h2>{{ 'add_climb.step2.heading'|trans }}</h2>
    <p class="help">{{ 'add_climb.step2.help'|trans }}</p>
    <div class="namepreview empty" id="namePreview">{{ 'add_climb.step2.name_placeholder'|trans }}</div>
    <div class="field">
      <label for="{{ form.fName.vars.id }}">{{ 'add_climb.step2.name_label'|trans }}</label>
      {{ form_widget(form.fName, {attr: {placeholder: 'add_climb.step2.name_input_placeholder'|trans}}) }}
    </div>
    <div class="two">
      <div class="field">
        <label for="{{ form.fLen.vars.id }}">{{ 'add_climb.step2.len_label'|trans({'%u%': cc_distance_suffix()}) }}</label>
        {{ form_widget(form.fLen, {attr: {step: '0.1', min: '0'}}) }}
      </div>
      <div class="field">
        <label for="{{ form.fGain.vars.id }}">{{ 'add_climb.step2.gain_label'|trans({'%u%': cc_elevation_suffix()}) }}</label>
        {# The example follows the rider's unit too: "e.g. 161" beside a field
           labelled (ft) is an instruction to type the wrong number. #}
        {{ form_widget(form.fGain, {attr: {step: '1', min: '0', placeholder: 'e.g. ' ~ cc_elev_value(161)}}) }}
        <div class="fhelp">{{ 'add_climb.step2.gain_help'|trans }}</div>
      </div>
    </div>
    <div class="two">
      <div class="field">
        <label for="fAvgDisplay">{{ 'add_climb.step2.avg_label'|trans }}</label>
        <input id="fAvgDisplay" readonly value="—" />
        {{ form_widget(form.fAvg, {attr: {style: 'display:none'}}) }}
      </div>
      {# Read off the steepest-ramp marker placed in step 1, never typed: one
         fact, one source. A box beside that marker invites a rider to disagree
         with the profile, and free text is how a climb ends up publishing a
         timestamp as its max gradient. Filled by add-climb.js from the
         editor's own state. #}
      <div class="field">
        <label for="fMaxDisplay">{{ 'add_climb.step2.max_label'|trans }}</label>
        <input id="fMaxDisplay" readonly value="—" />
        <div class="fhelp">{{ 'add_climb.step2.max_help'|trans }}</div>
      </div>
    </div>
    <div class="two">
      <div class="field">
        <label for="{{ form.fSurface.vars.id }}">{{ 'add_climb.step2.surface_label'|trans }}</label>
        {{ form_widget(form.fSurface) }}
      </div>
      <div class="field">
        <label for="{{ form.fSurfaceQ.vars.id }}">{{ 'add_climb.step2.surface_q_label'|trans }}</label>
        {{ form_widget(form.fSurfaceQ) }}
      </div>
    </div>
    <div class="field">
      <label for="{{ form.fTraffic.vars.id }}">{{ 'add_climb.step2.traffic_label'|trans }}</label>
      {{ form_widget(form.fTraffic) }}
      <div class="fhelp">{{ 'add_climb.step2.traffic_help'|trans }}</div>
    </div>
  </section>

  {# STEP 3 — DETAILS #}
  <section class="pane" data-s="3">
    <h2>{{ 'add_climb.step3.heading'|trans }}</h2>
    <p class="help">{{ 'add_climb.step3.help'|trans }}</p>
    {# The "Targeted audience" chips were RETIRED on 2026-08-03, the same call
       that retired the map's Discipline chips (map-and-search.md §4.3). They
       were worse than the map's: not only did they filter nothing, nothing
       submitted them — AddClimbType has no audience field, and
       CatalogContributionService::CLIMB_FIELDS maps no such key — while the
       review step listed the ticked ones back as if they were part of what a
       curator would receive. Their labels were also the only untranslated
       strings left on this page.

       Bringing them back means giving climbs a real audience attribute in
       CatalogFormRegistry, which is a vocabulary decision (the chips mixed
       riding STYLES with bike TYPES, and the codebase keeps those apart:
       RidingStyle vs BikeType). That is the owner's to make.

       The gradient guidance stays, because it was never about the chips: it is
       advice for whoever is describing a climb, and it already names the
       handbike ceiling that the conditional version spelled out. #}
    <div class="field">
      <label>{{ 'add_climb.step3.gradient_help_label'|trans }}</label>
      <div class="fhelp" id="audienceHint">{{ 'add_climb.step3.hint_ceilings'|trans }}</div>
    </div>
    <div class="field">
      <label for="{{ form.fNote.vars.id }}">{{ 'add_climb.step3.note_label'|trans }}</label>
      {{ form_widget(form.fNote, {attr: {placeholder: 'add_climb.step3.note_placeholder'|trans}}) }}
    </div>
    {# This drop zone used to be decoration — onclick="return false", and
       add-climb.js has no media queue at all. Honest UI (docs/specs/photo-uploads.md
       §1.1) means removing it rather than faking it: climb photos arrive
       through /improve?item=…&add=photo once the climb exists. #}
    <div class="field">
      <label>{{ 'add_climb.step3.photo_label'|trans }}</label>
      <p class="fhelp">{{ 'add_climb.step3.photo_after'|trans }}</p>
    </div>
    <div class="field">
      <label for="{{ form.fOsm.vars.id }}">{{ 'add_climb.step3.osm_label'|trans }}</label>
      {{ form_widget(form.fOsm) }}
    </div>
  </section>

  {# STEP 4 — REVIEW #}
  <section class="pane" data-s="4">
    <h2>{{ 'add_climb.step4.heading'|trans }}</h2>
    <p class="help">{{ 'add_climb.step4.help'|trans }}</p>
    <div class="card" id="reviewBody"></div>
    <div class="prov">{{ 'add_climb.step4.prov'|trans|rich }}</div>
  </section>

  {# STEP 5 — SUBMITTED (client-side wizard only; real POST uses receipt above) #}
  <section class="pane submitted" data-s="5">
    {{ include('contribute/_receipt_mark.html.twig') }}
    <h2>{{ 'add_climb.step5.heading'|trans }}</h2>
    <p>{{ 'add_climb.step5.body_pre'|trans }} <b id="doneName">{{ 'add_climb.step5.your_climb'|trans }}</b>{{ 'add_climb.step5.body_post'|trans }}</p>
    <a class="btn btn-g" href="{{ path('map') }}">{{ 'add_climb.step5.cta'|trans }}</a>
  </section>

  {# NAV ROW #}
  <div class="navrow" id="navrow">
    <button class="btn btn-g" id="backBtn" type="button" style="visibility:hidden">← {{ 'add_climb.nav.back'|trans }}</button>
    <span class="spacer"></span>
    <button class="btn btn-p" id="nextBtn" type="button">{{ 'add_climb.nav.next'|trans }} →</button>
  </div>

  {{ form_end(form) }}
</div>
{% endif %}

{# GOVERNANCE JOURNEY — always visible #}
<section class="journey">
  <div class="jwrap">
    <div class="ey">{{ 'add_climb.journey.eyebrow'|trans }}</div>
    <h2>{{ 'add_climb.journey.title'|trans }}</h2>
    <p class="jsub">{{ 'add_climb.journey.lead'|trans }}</p>
    <div class="spine">
      <div class="jnode" id="youAreHere"><span class="jdot"></span><span class="jt">{{ 'add_climb.journey.node_you_t'|trans }}</span><span class="jl">{{ 'add_climb.journey.node_you_l'|trans }}</span></div>
      <span class="jarrow">→</span>
      <div class="jnode"><span class="jdot"></span><span class="jt">{{ 'add_climb.journey.node_curators_t'|trans }}</span><span class="jl">{{ 'add_climb.journey.node_curators_l'|trans }}</span></div>
      <span class="jarrow">→</span>
      <div class="jnode"><span class="jdot"></span><span class="jt">{{ 'add_climb.journey.node_approved_t'|trans }}</span><span class="jl">{{ 'add_climb.journey.node_approved_l'|trans }}</span></div>
      <span class="jarrow">→</span>
      <div class="jnode"><span class="jdot"></span><span class="jt">{{ 'add_climb.journey.node_eligible_t'|trans }}</span><span class="jl">{{ 'add_climb.journey.node_eligible_l'|trans }}</span></div>
      <span class="jarrow">→</span>
      <div class="jnode goal"><span class="jdot"></span><span class="jt">{{ 'add_climb.journey.node_curated_t'|trans }}</span><span class="jl">{{ 'add_climb.journey.node_curated_l'|trans }}</span></div>
    </div>
    <div class="branch-lead">{{ 'add_climb.journey.branch_lead'|trans }}</div>
    <div class="branches">
      <div class="jbranch"><b>{{ 'add_climb.journey.branch_needs_info_b'|trans }}</b>{{ 'add_climb.journey.branch_needs_info'|trans }}</div>
      <div class="jbranch"><b>{{ 'add_climb.journey.branch_rejected_b'|trans }}</b>{{ 'add_climb.journey.branch_rejected'|trans }}</div>
    </div>
  </div>
</section>
{% endblock %}
