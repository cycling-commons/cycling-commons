{# SPDX-License-Identifier: AGPL-3.0-only #}
{# The takedowns desk (docs/specs/photo-uploads.md §6b/§6c): open rights
   requests as record cards, then the answered ones as a log of the same cards
   in list density. Head, cards, pills and buttons come from
   account/_shell_styles.html.twig like every other shell page. #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/takedowns.css') }}">
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_takedowns'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.takedown.kicker'|trans }}</div>
    <h1>{{ 'moderate.takedown.heading'|trans }}</h1>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# No filters here: a rights request is never narrowed by area. The density
     switch still folds the answered log to one line per request. #}
  {% if takedowns is not empty or decided is not empty %}
    <div class="mod-bar">{% include 'account/_density.html.twig' %}</div>
  {% endif %}

  {% if takedowns is empty and not urgent_breaker_open|default(false) %}
    <div class="empty-state">
      <h3>{{ 'moderate.takedown.empty_heading'|trans }}</h3>
      <p>{{ 'moderate.takedown.empty_body'|trans }}</p>
    </div>
  {% else %}
  {# ── Photo takedown requests (docs/specs/photo-uploads.md §6b/§6c) ──
     Its own desk since 2026-08-03 (owner). Unfiltered and unscoped, shown to
     every curator: a rights request is not work to be shared out by
     jurisdiction. Two sources share the cards: the uploader (withheld the
     moment they asked) and a third party who says they are in the picture
     (photo still up unless the urgent category fired).

     The test for whether to remove is NOT restated here — it is one of the
     rules, so it lives in the rulebook and this page links to it. Copy that
     explains a judgement call has exactly one home, or the two drift. #}
  <h2 class="sec-band">{{ 'moderate.takedown.heading'|trans }} <span class="sec-count">{{ pager.total }}</span></h2>
  {% include 'moderate/_urgent_breaker_banner.html.twig' with {open: urgent_breaker_open|default(false)} only %}
  <p class="sec-lead">{{ 'moderate.takedown.lead_short'|trans }}
    <a href="{{ path('moderate_rulebook') }}#takedowns">{{ 'moderate.takedown.rulebook_link'|trans }}</a></p>
  <div class="q-list">
    {% for t in takedowns %}
      <article class="q-item">
        <div class="q-top">
          <img class="td-img" src="{{ t.sm }}" width="110" height="82" alt="{{ 'moderate.takedown.alt'|trans }}">
          <div class="q-headwrap">
            <div class="q-head">
              <span class="q-tag q-tag--photo">{{ (t.source == 'third_party' ? 'moderate.takedown.source_third_party' : 'moderate.takedown.source_uploader')|trans }}</span>
              <h3 class="q-title">{{ t.itemName ?: ('moderate.takedown.no_item'|trans) }}</h3>
              <span class="q-when">{{ 'moderate.takedown.asked'|trans({'%when%': t.requestedAt|cc_datetime}) }}</span>
            </div>
            <div class="q-submitter">
              {% if t.source == 'third_party' %}
                {% if t.categoryLabel %}{{ t.categoryLabel|trans }} · {% endif %}{{ (t.withheld ? 'moderate.takedown.state_withheld' : 'moderate.takedown.state_published')|trans }}
              {% endif %}
              {% if t.contact %}
                {# Curator-only: the address to answer within the month
                   (Art. 12(3)), through the project mailbox — never shown to,
                   or shared with, the uploader. #}
                {% if t.source == 'third_party' %} · {% endif %}{{ 'moderate.takedown.reply_to'|trans({'%email%': t.contact}) }}
              {% endif %}
            </div>
          </div>
          {# The third verb (docs/specs/photo-uploads.md §6d). Its own panel so
             it can never be a mis-click on the decision buttons, and folded
             away because it is the rare case, not the common one. #}
          <div class="q-acts">
            <details class="q-act q-act--escalate">
              <summary class="btn-act btn-secondary btn-alarm">{{ 'moderate.escalate.summary'|trans }}</summary>
              <div class="q-act-panel">
                <form method="post" action="{{ path('moderate_escalate') }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('moderate_escalate') }}">
                  <input type="hidden" name="media" value="{{ t.uuid }}">
                  <p>{{ 'moderate.escalate.help'|trans }}</p>
                  <input type="text" name="reason" maxlength="2000" required
                         placeholder="{{ 'moderate.escalate.reason_placeholder'|trans }}">
                  <div class="q-act-buttons">
                    <button type="submit" class="btn-act btn-secondary">{{ 'moderate.escalate.submit'|trans }}</button>
                    <button type="button" class="btn-act btn-quiet q-act-cancel">{{ 'moderate.action.cancel'|trans }}</button>
                  </div>
                </form>
              </div>
            </details>
          </div>
        </div>
        <p class="q-body td-reason">{{ t.reason }}</p>
        <form method="post" action="{{ path('moderate_takedown') }}" class="td-actions">
          <input type="hidden" name="_token" value="{{ csrf_token('moderate_takedown') }}">
          <input type="hidden" name="media" value="{{ t.uuid }}">
          <input type="text" name="note" maxlength="2000" placeholder="{{ 'moderate.takedown.note_placeholder'|trans }}">
          <button type="submit" name="decision" value="grant" class="btn-act btn-approve">{{ 'moderate.takedown.grant'|trans }}</button>
          <button type="submit" name="decision" value="decline" class="btn-act btn-reject">{{ 'moderate.takedown.decline'|trans }}</button>
        </form>
      </article>
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'moderate_takedowns', params: {}} %}
  {% endif %}

  {# ── Answered requests ──────────────────────────────────────────────────
     OUTSIDE the empty/else above, deliberately: this desk empties itself by
     design, so the history has to show on exactly the screen the empty state
     is on. Without it a decided request left no trace anywhere a curator
     looks (owner-reported 2026-08-14). #}
  {% if decided is not empty %}
    <h2 class="sec-band sec-band--quiet">{{ 'moderate.takedown.history_heading'|trans }} <span class="sec-count">{{ history_pager.total }}</span></h2>
    <p class="sec-lead">{{ 'moderate.takedown.history_lead'|trans }}</p>
    <div class="q-list">
      {% for d in decided %}
        <div class="q-item">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                {# Granted is the one that destroyed something; it reads differently. #}
                <span class="q-pill {{ d.action == 'takedown_granted' ? 'q-pill--rej' : 'q-pill--ret' }}">{{ ('moderate.takedown.action_' ~ d.action)|trans }}</span>
                <h3 class="q-title">{{ d.itemName ?: ('moderate.takedown.no_item'|trans) }}
                  {# A granted request destroys the photo, so there is nothing to
                     link to. Saying so beats a dead thumbnail. #}
                  {% if d.gone %}<span class="td-gone">{{ 'moderate.takedown.photo_gone'|trans }}</span>{% endif %}</h3>
                {# The whole handling record on one line, in the order it happened
                   (owner 2026-08-14): when it arrived, when it was answered, how
                   long that took, and by whom. #}
                <span class="q-when td-track">
                  {%- if d.requestedAt %}{{ 'moderate.takedown.log_in'|trans({'%when%': d.requestedAt|cc_datetime}) }} · {% endif -%}
                  {{ 'moderate.takedown.log_out'|trans({'%when%': d.decidedAt|cc_datetime}) }}
                  {%- if d.waitedHours is not null %} · {{ (d.waitedHours < 48
                      ? 'moderate.takedown.log_waited_h'|trans({'%n%': d.waitedHours})
                      : 'moderate.takedown.log_waited_d'|trans({'%n%': (d.waitedHours / 24)|round})) }}{% endif -%}
                  {%- if d.actor %} · {% include 'moderate/_rider_in_text.html.twig' with {text: 'moderate.takedown.log_by'|trans({'%who%': '@@rider@@'}), rider: d.actor} only %}{% endif -%}
                </span>
              </div>
            </div>
          </div>
          {% if d.note %}<p class="q-note">{{ d.note }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
    {# `key: 'hpage'` — its own query parameter, so paging the history cannot
       scroll the open requests out from under a curator mid-decision. #}
    {% include 'partials/_pager.html.twig' with {pager: history_pager, route: 'moderate_takedowns', params: {}, key: 'hpage', show_size: false} %}
  {% endif %}
</div>
{% include 'moderate/_card_script.html.twig' %}
{% endblock %}
