{#
  One message, in full (docs/specs/contact-and-support.md §8).

  Its own page for two reasons: a message can be long, and the reference number
  in the acknowledgement has to lead somewhere a curator can be sent by a link.

  The body is rendered as escaped text inside a <pre>, never through |rich or a
  markdown filter. It is a string a stranger typed, and the one thing it must
  never be is markup.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<style>
  .mdet{max-width:720px}
  .mdet dl{display:grid;grid-template-columns:auto 1fr;gap:.3rem .9rem;margin:1rem 0 1.4rem}
  .mdet dt{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .mdet dd{margin:0;font-size:.9rem;color:#3a3d30}
  .mbody{background:var(--paper-deep);border-radius:6px;padding:1rem 1.2rem;font-family:inherit;
    font-size:.95rem;line-height:1.65;color:#3a3d30;white-space:pre-wrap;word-wrap:break-word;margin:0 0 1.4rem}
  .late{background:#fff1ec;border-left:2px solid var(--trail);padding:.85rem 1.05rem;border-radius:0 6px 6px 0;
    font-size:.88rem;color:#5a2716;margin:0 0 1.2rem}
  .handle{margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.12)}
  .handle label{display:block;font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;
    text-transform:uppercase;color:var(--clay);margin:.9rem 0 .3rem}
  .handle select,.handle textarea{width:100%;font-family:inherit;font-size:.9rem;padding:.5rem .6rem;
    border:1px solid rgba(20,22,14,.22);border-radius:5px;background:var(--paper)}
  .handle textarea{min-height:5rem;line-height:1.55;resize:vertical}
  .reply-cta{font-size:.88rem;color:#4a4d40;margin:.8rem 0}
  .reply-cta a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_inbox'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }} · <a href="{{ path('moderate_inbox') }}">{{ 'support.inbox.title'|trans }}</a></div>
    <h1>{{ ('support.topic.' ~ message.topic.value)|trans }}</h1>
    <p class="lede mono">{{ reference }}</p>
  </div>

  <div class="mdet">
    {% if message.isOverdue(now) %}
      <p class="late" role="alert">{{ 'support.inbox.late_note'|trans({'%date%': message.dueAt|cc_date}) }}</p>
    {% endif %}

    <dl>
      <dt>{{ 'support.inbox.from'|trans }}</dt>
      <dd>{{ message.name ?? '–' }}</dd>
      <dt>{{ 'support.inbox.received'|trans }}</dt>
      <dd>{{ message.createdAt|cc_datetime }}</dd>
      {% if message.dueAt %}
        <dt>{{ 'support.inbox.due'|trans }}</dt>
        <dd>{{ message.dueAt|cc_date }}</dd>
      {% endif %}
      <dt>{{ 'support.inbox.status_label'|trans }}</dt>
      <dd>{{ ('support.contact.status.' ~ message.status.value)|trans }}</dd>
      {% if message.locale %}
        <dt>{{ 'support.inbox.language'|trans }}</dt>
        <dd>{{ message.locale }}</dd>
      {% endif %}
      {% if message.pageUrl %}
        <dt>{{ 'support.inbox.from_page'|trans }}</dt>
        <dd class="mono">{{ message.pageUrl }}</dd>
      {% endif %}
      {% if message.userId %}
        <dt>{{ 'support.inbox.account'|trans }}</dt>
        <dd>#{{ message.userId }}</dd>
      {% endif %}
    </dl>

    {# Escaped text in a pre-wrap block. Never |rich, never markdown: this is a
       string a stranger typed. #}
    <div class="mbody">{{ message.body }}</div>

    <p class="reply-cta">
      {{ 'support.inbox.reply_note'|trans }}
      {# No mailto: it would put the address in the markup and in the status
         bar. When this desk returns it replies through the system, which is
         the whole of TODO item 18. #}
      <span class="mono">{{ 'support.inbox.reply_via_system'|trans }}</span>
    </p>

    {% if message.handlingNote %}
      <dl>
        <dt>{{ 'support.inbox.note'|trans }}</dt>
        <dd>{{ message.handlingNote }}</dd>
      </dl>
    {% endif %}

    <form class="handle" method="post" action="{{ path('moderate_inbox_handle') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('inbox-handle') }}">
      <input type="hidden" name="id" value="{{ message.id }}">

      <label for="d-status">{{ 'support.inbox.set_status'|trans }}</label>
      <select id="d-status" name="status">
        {% for st in statuses %}
          <option value="{{ st.value }}"{{ st == message.status ? ' selected' : '' }}>{{ ('support.contact.status.' ~ st.value)|trans }}</option>
        {% endfor %}
      </select>

      <label for="d-note">{{ 'support.inbox.note'|trans }}</label>
      <textarea id="d-note" name="note" maxlength="500"
                placeholder="{{ 'support.inbox.note_placeholder'|trans }}"></textarea>

      <p><button type="submit" class="btn">{{ 'support.inbox.save'|trans }}</button></p>
    </form>
  </div>
</div>
{% endblock %}
