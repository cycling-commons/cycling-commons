{#
  Partial: one pending submission row in the moderation queue.

  Parameters:
    item   array  — queue item from SubmissionQueue::filtered()
    form   FormView — ModerationDecisionType for this item

  Layout (2026-08-02, owner). The desk is a queue worked dozens at a sitting,
  so the row is sized for that: heading and actions share the TOP block, and a
  submission with nothing extra to show is two lines tall — near enough the
  list view that the default card costs nothing to scan. A card only grows when
  it carries something a curator must actually look at: a photo, an edit diff,
  the rider's words, a reply.

  The three <details> triggers are buttons beside the primary action rather
  than link-ish text stacked below it; an opened panel takes the full width of
  the action group (`.q-act[open]` in index.html.twig) so the button row never
  ends up half-height. Spec: moderation-and-contribution.md §5.2.
#}
<div class="q-item" data-item-id="{{ item.id }}">
  <div class="q-top">
    {# The photo, in the row. A curator scanning a queue can tell a real place
       from a mis-tap or a joke by looking, and a 44px crop answers that faster
       than the title does (owner 2026-08-12). It opens the full size, because
       "is anyone identifiable in this" cannot be answered at 44px — the same
       reason the wizard's own thumbnails link out. #}
    {% if item.photos|length > 0 %}
      <a class="q-thumb" href="{{ item.photos[0].lg }}" target="_blank" rel="noopener"
         title="{{ 'improve.step3.open_full'|trans }}">
        <img src="{{ item.photos[0].sm }}" alt="" loading="lazy" width="44" height="44">
        {% if item.photos|length > 1 %}<span class="q-thumb-n">{{ item.photos|length }}</span>{% endif %}
      </a>
    {% endif %}
    <div class="q-headwrap">
      <div class="q-head">
        <span class="q-tag q-tag--{{ item.type }}">{{ ('moderate.type.' ~ item.type)|trans }}</span>
        {# The rider answered a needs-info question. It used to arrive as a
           message in the curator's PERSONAL inbox; moderation work belongs on
           the desk, so the signal has to be here where it can be scanned
           (owner, 2026-08-03). The answer itself is further down the card. #}
        {% if item.riderReply %}<span class="q-tag q-tag--answered">{{ 'moderate.answered'|trans }}</span>{% endif %}
        <h3 class="q-title">{{ item.title }}</h3>
        <span class="q-when">{{ item.when }}</span>
      </div>
      {# WHERE, in words. Three decimal places of latitude tell a curator
         nothing they can picture (owner 2026-08-12); the region and country do,
         and the row already carries both. The coordinates stay as the title,
         for the one case where the exact spot is the question - and the map
         itself is one click away in the row below. #}
      <div class="q-submitter" title="{{ item.lat|number_format(4) }}&deg;N {{ item.lng|number_format(4) }}&deg;E">
        {{ item.who }}
        {% if item.region %} &middot; {{ item.region }}{% endif %}
        {% if item.country %} &middot; {{ item.country }}{% endif %}
      </div>
    </div>

    {# Decisions are made ONLY on the map (so a curator always sees the item in
       place before approving) — the first button just routes there. The other
       three are the desk's own verbs, and they keep their order: Escalate sits
       BEFORE Trash on purpose (docs/specs/photo-uploads.md §6d), so a curator
       reaching for "destroy this" because it is illegal meets the right verb
       first. #}
    <div class="q-acts">
      <a class="btn-act btn-secondary q-review"
         href="{{ path('map') }}?pending={{ item.id }}"
         target="_blank" rel="noopener">{{ 'moderate.action.review_on_map'|trans }} &#8599;</a>
      {# Straight to the form. Review-on-the-map answers "is this right"; this
         answers "fix this typo", and routing a one-word correction through a
         map, a pin and a drawer is three steps too many (owner 2026-08-12).
         Only for an EDIT of an existing item — a brand-new place has no item to
         open, and a button that leads to "pick a place to improve" is a button
         that lies. #}
      {% if item.itemId %}
      <a class="btn-act btn-secondary q-edit"
         href="{{ path('improve') }}?item={{ item.itemId }}&type={{ item.letter }}"
         target="_blank" rel="noopener"
         title="{{ 'moderate.action.edit_form'|trans }}">✎ {{ 'moderate.action.edit_form'|trans }}</a>
      {% endif %}

      <details class="q-act q-act--message">
        <summary class="btn-act btn-secondary">{{ 'moderate.msg.summary'|trans }}</summary>
        <div class="q-act-panel">
          <form method="post" action="{{ path('moderate_message') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('moderate-message') }}">
            <input type="hidden" name="channel" value="submission">
            <input type="hidden" name="id" value="{{ item.id }}">
            {% if item.photos|length > 0 %}
              {# A message may be about one specific photo (docs/specs/photo-uploads.md §5b).
                 Same thread, same form — the reference is a detail of an ordinary
                 message, not a second messaging system. #}
              <label class="msg-photo-ref">{{ 'moderate.msg.about_photo'|trans }}
                <select name="mediaId">
                  <option value="">{{ 'moderate.msg.no_photo'|trans }}</option>
                  {% for p in item.photos %}
                    <option value="{{ p.id }}">{{ loop.index }}{% if p.takenAt %} &middot; {{ p.takenAt }}{% endif %}</option>
                  {% endfor %}
                </select>
              </label>
            {% endif %}
            <textarea name="body" maxlength="2000" placeholder="{{ 'moderate.msg.placeholder'|trans }}" required></textarea>
            <button type="submit" class="btn-act btn-secondary">{{ 'moderate.msg.send'|trans }}</button>
          </form>
        </div>
      </details>

      {# The third verb (docs/specs/photo-uploads.md §6d). Both destructive
         verbs open with WHEN to use them and close with a ticked
         acknowledgement, because the button label alone cannot carry the
         difference between "this edit is wrong" and "this content is
         criminal". The tick is a UI speed bump — native `required`, no POST
         until it is ticked; the server's own gates are unchanged and remain
         the real ones (a reason here, the typed DELETE for Trash). #}
      <details class="q-act q-act--trash trash-confirm">
        <summary class="btn-act btn-secondary btn-icon" title="{{ 'moderate.trash.button'|trans }}"
                 aria-label="{{ 'moderate.trash.button'|trans }}">🗑</summary>
        <div class="q-act-panel">
          <form method="post" action="{{ path('moderate_trash') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('moderate-trash') }}">
            <input type="hidden" name="kind" value="submission">
            <input type="hidden" name="id" value="{{ item.id }}">
            {# No link to the public wiki rulebook (2026-08-03, owner). A
               world-readable page describing how moderators decide what to
               destroy is a social-engineering aid: it tells anyone exactly
               which words get a submission trashed and which get it escalated.
               The rulebook becomes a moderators-only page reached from the
               moderation menu; until that page exists this panel carries no
               link at all rather than a public one. #}
            <p><strong class="trash-warn">{{ 'moderate.trash.confirm_head'|trans }}</strong></p>
            <p>{{ 'moderate.trash.confirm_rest'|trans }}</p>
            <p class="q-act-when">{{ 'moderate.trash.when'|trans }}</p>
            {# The typed DELETE and the tick-box are gone (owner 2026-08-12).
               Opening this panel and pressing Trash inside it is already two
               deliberate acts on a control that is one icon among five; a third
               and fourth were friction a curator learns to type through, which
               is the opposite of care. The warning above is what does the work.
               Closing the panel sends nothing — no record is written for an
               uncompleted Trash. #}
            <div class="q-act-buttons">
              <button type="submit" class="btn-act btn-secondary btn-danger">{{ 'moderate.trash.button'|trans }}</button>
              <button type="button" class="btn-act btn-quiet q-act-cancel">{{ 'moderate.action.cancel'|trans }}</button>
            </div>
          </form>
        </div>
      </details>
      <details class="q-act q-act--escalate">
        {# Icon, not a word. These two sit at the end of a row a curator reads
           dozens of times an hour; the verbs they carry are rare and heavy, and
           spelling them out gave them the same weight as Review. The label
           stays as the accessible name and the tooltip — shorter, not hidden. #}
        <summary class="btn-act btn-secondary btn-icon btn-alarm" title="{{ 'moderate.escalate.button'|trans }}"
                 aria-label="{{ 'moderate.escalate.button'|trans }}">⚑</summary>
        <div class="q-act-panel">
          <form method="post" action="{{ path('moderate_escalate_submission') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('moderate_escalate') }}">
            <input type="hidden" name="submission" value="{{ item.id }}">
            <p class="q-act-head">{{ 'moderate.escalate.summary'|trans }}</p>
            <p class="q-act-when">{{ 'moderate.escalate.when'|trans }}</p>
            <p>{{ 'moderate.escalate.help'|trans }}</p>
            <input type="text" name="reason" maxlength="2000" required
                   placeholder="{{ 'moderate.escalate.reason_placeholder'|trans }}">
            <label class="q-act-ack"><input type="checkbox" required>
              <span>{{ 'moderate.escalate.confirm_check'|trans }}</span></label>
            {# A way out. Pressing ⚑ again does close it, but only once you have
               worked out that the flag is a toggle — and a panel that announces
               "nothing can delete it afterwards" is not one to feel trapped in
               (owner 2026-08-12). The tick-box stays here: escalation alerts an
               administrator and cannot be undone by anyone. #}
            <div class="q-act-buttons">
              <button type="submit" class="btn-act btn-secondary">{{ 'moderate.escalate.submit'|trans }}</button>
              <button type="button" class="btn-act btn-quiet q-act-cancel">{{ 'moderate.action.cancel'|trans }}</button>
            </div>
          </form>
        </div>
      </details>

    </div>
  </div>

  {% if item.body %}
    <p class="q-body">{{ item.body }}</p>
  {% endif %}
  {# Gated on `now`, not on `was`. Gating on `was` hid the change completely
     whenever a field had no previous value — which is the ENTIRE "+ add a
     missing field" funnel, the commonest contribution there is. The card then
     showed a title and nothing else, and a curator was asked to approve a
     change the page never named (owner-reported 2026-08-03). The struck-out
     line only appears when there is something to strike out. #}
  {% if item.now %}
    <div class="q-diff">
      {% if item.was %}<div class="q-was">{{ item.was }}</div>{% endif %}
      <div class="q-now">{{ item.now }}</div>
    </div>
  {% endif %}
  {% if item.photos|length > 0 %}
    {# Pending photos with their harvested context (docs/specs/photo-uploads.md §5).
       The DECISION is still made on the map, where the curator sees the place;
       this is the same review context the rest of the row is. #}
    <div class="q-photos">
      {% for p in item.photos %}
        <figure class="q-photo">
          <img src="{{ p.sm }}" alt="{{ 'moderate.media.alt'|trans }}" loading="lazy" width="110" height="82">
          <figcaption>
            {%- if p.distanceM is not null %}{{ 'moderate.media.distance'|trans({'%v%': p.distanceM|cc_m}) }}{% else %}{{ 'moderate.media.no_gps'|trans }}{% endif -%}
            {%- if p.takenAt %} &middot; {{ p.takenAt }}{% endif -%}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  {% endif %}
  {% if item.riderReply %}
    <p class="q-rider-reply"><strong>{{ 'moderate.rider_reply'|trans }}:</strong> {{ item.riderReply }}</p>
  {% endif %}
</div>
