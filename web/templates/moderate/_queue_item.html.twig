{#
  Partial: one pending submission row in the moderation queue.

  Parameters:
    item   array  — queue item from SubmissionQueue::filtered()
    form   FormView — ModerationDecisionType for this item
#}
<div class="q-item" data-item-id="{{ item.id }}">
  <div class="q-meta">
    <span class="q-tag q-tag--{{ item.type }}">{{ ('moderate.type.' ~ item.type)|trans }}</span>
    <span class="q-when">{{ item.when }}</span>
  </div>
  <h3 class="q-title">{{ item.title }}</h3>
  <div class="q-submitter">
    {{ item.who }} &middot; {{ item.lat|number_format(3) }}&deg;N {{ item.lng|number_format(3) }}&deg;E
  </div>
  {% if item.body %}
    <p class="q-body">{{ item.body }}</p>
  {% endif %}
  {% if item.was %}
    <div class="q-diff">
      <div class="q-was">{{ item.was }}</div>
      <div class="q-now">{{ item.now }}</div>
    </div>
  {% endif %}
  {% if item.photos|length > 0 %}
    {# Pending photos with their harvested context (docs/specs/photo-uploads.md §5).
       The DECISION is still made on the map, where the curator sees the place;
       this is the same review context the rest of the row is. #}
    <div class="q-photos">
      {% for p in item.photos %}
        <figure class="q-photo">
          <img src="{{ p.sm }}" alt="{{ 'moderate.media.alt'|trans }}" loading="lazy" width="110" height="82">
          <figcaption>
            {%- if p.distanceM is not null %}{{ 'moderate.media.distance'|trans({'%m%': p.distanceM}) }}{% else %}{{ 'moderate.media.no_gps'|trans }}{% endif -%}
            {%- if p.takenAt %} &middot; {{ p.takenAt }}{% endif -%}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  {% endif %}
  {% if item.riderReply %}
    <p class="q-rider-reply"><strong>{{ 'moderate.rider_reply'|trans }}:</strong> {{ item.riderReply }}</p>
  {% endif %}

  {# Decisions are made ONLY on the map (so a curator always sees the item in
     place before approving). This list just routes there — open the pending
     item's drawer, review, edit if needed, then approve/reject in the drawer. #}
  <div class="q-actions">
    <a class="btn-act btn-secondary q-review"
       href="{{ path('map') }}?pending={{ item.id }}"
       target="_blank" rel="noopener">{{ 'moderate.action.review_on_map'|trans }} &#8599;</a>
  </div>

  {# message + trash side by side (rider feedback: no full-width stack) #}
  <div class="mod-2col">
    <details class="msg-rider">
      <summary>{{ 'moderate.msg.summary'|trans }}</summary>
      <form method="post" action="{{ path('moderate_message') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('moderate-message') }}">
        <input type="hidden" name="channel" value="submission">
        <input type="hidden" name="id" value="{{ item.id }}">
        <textarea name="body" maxlength="2000" placeholder="{{ 'moderate.msg.placeholder'|trans }}" required></textarea>
        <button type="submit" class="btn-act btn-secondary">{{ 'moderate.msg.send'|trans }}</button>
      </form>
    </details>

    <details class="msg-rider trash-confirm">
      <summary>{{ 'moderate.trash.button'|trans }}</summary>
      <form method="post" action="{{ path('moderate_trash') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('moderate-trash') }}">
        <input type="hidden" name="kind" value="submission">
        <input type="hidden" name="id" value="{{ item.id }}">
        <p><strong class="trash-warn">{{ 'moderate.trash.confirm_head'|trans }}</strong> {{ 'moderate.trash.confirm_rest'|trans }}
           <a href="https://wiki.cyclingcommons.org/moderator-rulebook/" target="_blank" rel="noopener">{{ 'moderate.trash.rulebook_link'|trans }}</a></p>
        {# Typed confirmation (moderator rulebook): native pattern validation
           blocks the POST unless the literal word is typed; the server
           re-checks. Closing the panel/cancelling sends nothing — no record
           is written for an uncompleted Trash. #}
        <label class="trash-type-label">{{ 'moderate.trash.type_label'|trans }}
          <input type="text" name="confirm" required pattern="DELETE" autocomplete="off" spellcheck="false" placeholder="DELETE" class="trash-type-input">
        </label>
        <button type="submit" class="btn-act btn-secondary">{{ 'moderate.trash.button'|trans }}</button>
      </form>
    </details>
  </div>
</div>
