{#
  Partial: one pending submission row in the moderation queue.

  Parameters:
    item   array  — queue item from SubmissionQueue::filtered()
    form   FormView — ModerationDecisionType for this item
#}
<div class="q-item" data-item-id="{{ item.id }}">
  <div class="q-meta">
    <span class="q-tag q-tag--{{ item.type }}">{{ ('moderate.type.' ~ item.type)|trans }}</span>
    <span class="q-when">{{ item.when }}</span>
  </div>
  <h3 class="q-title">{{ item.title }}</h3>
  <div class="q-submitter">
    {{ item.who }} &middot; {{ item.lat|number_format(3) }}&deg;N {{ item.lng|number_format(3) }}&deg;E
    &middot;
    <a class="q-view"
       href="{{ path('map') }}?pending={{ item.id }}"
       target="_blank" rel="noopener">{{ 'moderate.action.view'|trans }}</a>
  </div>
  {% if item.body %}
    <p class="q-body">{{ item.body }}</p>
  {% endif %}
  {% if item.was %}
    <div class="q-diff">
      <div class="q-was">{{ item.was }}</div>
      <div class="q-now">{{ item.now }}</div>
    </div>
  {% endif %}
  {% if item.riderReply %}
    <p class="q-rider-reply"><strong>{{ 'moderate.rider_reply'|trans }}:</strong> {{ item.riderReply }}</p>
  {% endif %}

  <div class="q-actions">
    {# §13: no hardcoded action — the form carries its own action (set in
       ModerateController with the curator's live country/region/type filters
       so a decision made from a filtered view redirects back to it). #}
    {{ form_start(form, {method: 'POST', attr: {class: 'q-act-form'}}) }}
      {{ form_widget(form.submission_id, {value: item.id}) }}
      <div class="q-decision-row">
        {{ form_label(form.decision, 'moderate.action.decision_label'|trans) }}
        {{ form_widget(form.decision) }}
      </div>
      {{ form_widget(form.note) }}
      <div class="q-act-btns">
        <button type="submit" class="btn-act btn-decide">{{ 'moderate.action.submit'|trans }}</button>
      </div>
    {{ form_end(form) }}
  </div>

  <details class="msg-rider">
    <summary>{{ 'moderate.msg.summary'|trans }}</summary>
    <form method="post" action="{{ path('moderate_message') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('moderate-message') }}">
      <input type="hidden" name="channel" value="submission">
      <input type="hidden" name="id" value="{{ item.id }}">
      <textarea name="body" maxlength="2000" placeholder="{{ 'moderate.msg.placeholder'|trans }}" required></textarea>
      <button type="submit" class="btn-act btn-secondary">{{ 'moderate.msg.send'|trans }}</button>
    </form>
  </details>
</div>
