{# Unscoped translation curator desk (translations.md §5). The queue is a
   scan: key, locale, status, Review. Decisions live on the detail page. #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .tr-status{display:inline-block;margin-left:.45rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);background:var(--clay);padding:.12rem .4rem;border-radius:30px;font-weight:400}
</style>
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_translations', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.translation.kicker'|trans }}</div>
    <h1>{{ 'moderate.translation.heading'|trans }}</h1>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# Site-wide overlays: never narrowed by area (translations.md §5). #}
  {% if cards is not empty %}
    <div class="mod-bar">{% include 'account/_density.html.twig' %}</div>
  {% endif %}

  {% if cards is empty %}
    <div class="empty-state">
      <h3>{{ 'moderate.translation.empty_heading'|trans }}</h3>
      <p>{{ 'moderate.translation.empty_body'|trans }}</p>
    </div>
  {% else %}
    <h2 class="sec-band">{{ 'moderate.translation.heading'|trans }} <span class="sec-count">{{ cards|length }}</span></h2>
    <p class="sec-lead">{{ 'moderate.translation.lead'|trans }}</p>
    <div class="q-list">
      {% for card in cards %}
        <article class="q-item">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                <h3 class="q-title">{{ card.message_key }} <span class="tr-status">{{ ('moderate.translation.status.' ~ card.status)|trans }}</span></h3>
                <span class="q-when">{{ 'moderate.translation.locale'|trans({'%locale%': card.locale}) }}
                  · {{ ('translate.locale.' ~ card.locale)|trans }}</span>
              </div>
            </div>
            <div class="q-acts">
              <a class="btn-act btn-secondary q-review" href="{{ path('moderate_translations_detail', {id: card.proposal.id}) }}">{{ 'moderate.translation.review'|trans }} &#8594;</a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% include 'moderate/_card_script.html.twig' %}
{% endblock %}
