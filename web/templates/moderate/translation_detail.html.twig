{# One open translation proposal. Approve / reject / needs-info live here,
   not on the queue (translations.md §5). #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .tr-status{display:inline-block;margin-left:.45rem;font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);background:var(--clay);padding:.12rem .4rem;border-radius:30px;font-weight:400}
  .tr-warn{font-size:.84rem;line-height:1.45;color:#7d2018;background:rgba(163,52,43,.09);border-left:2px solid #a3342b;padding:.45rem .8rem;border-radius:0 5px 5px 0;margin:.5rem 0 .7rem}
  .tr-back{display:inline-block;font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);text-decoration:none;margin-bottom:.9rem}
  .tr-back:hover{text-decoration:underline}
  .td-actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-start;margin:1.2rem 0 2.4rem}
  .td-actions textarea{flex:1 1 16rem;font-family:var(--sans);font-size:.9rem;padding:.45rem .55rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);min-height:4.5rem;resize:vertical}
  /* The shared .q-diff row gap is for one-line was/now. These four strings wrap,
     so the pairs need space between them (owner 2026-08-26). */
  .tr-diff{padding:.9rem 1.05rem}
  .tr-diff dl{row-gap:1.15rem}
</style>
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_translations', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.translation.kicker'|trans }}</div>
    <a class="tr-back" href="{{ path('moderate_translations') }}">{{ 'moderate.translation.back'|trans }}</a>
    <h1>{{ card.message_key }} <span class="tr-status">{{ ('moderate.translation.status.' ~ card.status)|trans }}</span></h1>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <p class="sec-lead">{{ 'moderate.translation.locale'|trans({'%locale%': card.locale}) }}
    · {{ ('translate.locale.' ~ card.locale)|trans }}</p>

  {% if card.english_changed %}
    <p class="tr-warn" role="status">{{ 'moderate.translation.english_changed'|trans }}</p>
  {% endif %}

  <div class="q-diff tr-diff">
    <dl>
      <dt>{{ 'moderate.translation.english_at_submit'|trans }}</dt>
      <dd>{{ card.english_at_submit }}</dd>
      <dt>{{ 'moderate.translation.english_now'|trans }}</dt>
      <dd>{{ card.english_now }}</dd>
      <dt>{{ 'moderate.translation.live'|trans }}</dt>
      <dd>{{ card.live }}</dd>
      <dt>{{ 'moderate.translation.proposed'|trans }}</dt>
      <dd>{{ card.proposed }}</dd>
    </dl>
  </div>

  <form method="post" action="{{ path('moderate_translations_detail', {id: card.proposal.id}) }}" class="td-actions">
    <input type="hidden" name="translation_decision[_token]" value="{{ csrf_token('moderate_translation') }}">
    <input type="hidden" name="translation_decision[proposal_id]" value="{{ card.proposal.id }}">
    <textarea name="translation_decision[note]" maxlength="2000" placeholder="{{ 'moderate.translation.note_placeholder'|trans }}"></textarea>
    <button type="submit" name="translation_decision[decision]" value="approve" class="btn-act btn-approve">{{ 'moderate.action.approve'|trans }}</button>
    <button type="submit" name="translation_decision[decision]" value="reject" class="btn-act btn-reject">{{ 'moderate.action.reject'|trans }}</button>
    <button type="submit" name="translation_decision[decision]" value="needs_info" class="btn-act">{{ 'moderate.action.needs_info'|trans }}</button>
  </form>
</div>
{% endblock %}
