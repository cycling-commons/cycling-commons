{# One translation proposal. Approve / reject / needs-info live here,
   not on the queue (translations.md §5). The page is a story: English,
   the YAML original, then each change oldest-first, newest at the bottom. #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .tr-status{display:inline-block;margin-left:.45rem;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);background:var(--clay);padding:.12rem .4rem;border-radius:30px;font-weight:400}
  .tr-back{display:inline-block;font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);text-decoration:none;margin-bottom:.9rem}
  .tr-back:hover{text-decoration:underline}
  .td-actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-start;margin:1.2rem 0 1.6rem}
  .td-actions textarea[name="translation_decision[note]"]{flex:1 1 16rem;font-family:var(--sans);font-size:.9rem;padding:.45rem .55rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);min-height:4.5rem;resize:vertical}
  .tr-story{margin:0 0 2.4rem}
  .tr-block{margin:0 0 1.1rem}
  .tr-block p{font-size:.95rem;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;margin:.15rem 0 0}
  .tr-change{margin:.35rem 0 0}
  .tr-change-k{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:#8a8d7d;margin-bottom:.35rem}
  .tr-hist-item,.tr-pending{margin:0 0 1.15rem}
  .tr-hist-meta{display:flex;flex-wrap:wrap;gap:.45rem 1rem;align-items:baseline;margin:0 0 .4rem;font-family:var(--mono);font-size:.72rem;color:#595c4d}
  .tr-hist-meta a{color:var(--clay)}
  .tr-hist-edit{margin:.45rem 0 0;font-size:.84rem}
  .tr-hist-edit .tr-hist-k{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:#8a8d7d;margin-bottom:.25rem}
  .tr-publish{margin:.7rem 0 0}
  .tr-publish label{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:#8a8d7d;margin-bottom:.4rem}
  .tr-publish textarea{width:100%;min-height:6rem;font-family:var(--sans);font-size:.92rem;line-height:1.45;padding:.55rem .7rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);resize:vertical}
  .tr-publish .fhelp{font-size:.82rem;color:#595c4d;margin:.35rem 0 0}
  .tr-settled{font-size:.95rem;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;margin:.15rem 0 0}
</style>
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_translations', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% macro who(w) %}{%- if w.anonymous -%}
    {{ 'moderate.translation.anonymous'|trans }}
  {%- else -%}
    {{ w.handle }}{% if w.name %} · {% if w.profile_url %}<a href="{{ w.profile_url }}">{{ w.name }}</a>{% else %}{{ w.name }}{% endif %}{% endif %}
  {%- endif -%}{% endmacro %}

{% macro worddiff(segments) %}{%- for s in segments -%}
  {%- if s.type == 'del' -%}<span class="q-was">{{ s.text }}</span>
  {%- elseif s.type == 'ins' -%}<span class="q-now">{{ s.text }}</span>
  {%- else -%}{{ s.text }}{%- endif -%}
  {%- if not loop.last %} {% endif -%}
{%- endfor -%}{% endmacro %}

{% macro change(event) %}
  <div class="tr-hist-meta">
    <span>{{ _self.who(event.who) }}</span>
    {% if event.when %}<time datetime="{{ event.when|date('c') }}">{{ event.when|cc_datetime }}</time>{% endif %}
    <span class="tr-status">{{ ('moderate.translation.status.' ~ event.status)|trans }}</span>
  </div>
  <div class="tr-change">
    <span class="tr-change-k">{{ 'moderate.translation.change'|trans }}</span>
    <div class="q-diff">{{ _self.worddiff(event.diff) }}</div>
  </div>
  {% if event.edit %}
    <div class="tr-hist-edit">
      <span class="tr-hist-k">{{ 'moderate.translation.edited_by'|trans({'%who%': event.edit.who.anonymous ? ('moderate.translation.anonymous'|trans) : event.edit.who.handle}) }}</span>
      <div class="q-diff">{{ _self.worddiff(event.edit.diff) }}</div>
    </div>
  {% endif %}
  {% if event.note and not event.open %}
    <span class="tr-change-k tr-more">{{ 'moderate.translation.note'|trans }}</span>
    <p class="tr-settled">{{ event.note }}</p>
  {% endif %}
{% endmacro %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.translation.kicker'|trans }}</div>
    <a class="tr-back" href="{{ card.open ? path('moderate_translations') : path('moderate_translations_history') }}">{{ (card.open ? 'moderate.translation.back' : 'moderate.translation.back_history')|trans }}</a>
    <h1>{{ card.message_key }} <span class="tr-status">{{ ('moderate.translation.status.' ~ card.status)|trans }}</span></h1>
    <p class="lead">{{ 'moderate.translation.locale'|trans({'%locale%': card.locale}) }}
      · {{ ('translate.locale.' ~ card.locale)|trans }}</p>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="tr-story tr-history">
    <div class="tr-block tr-english">
      <span class="tr-change-k">{{ 'moderate.translation.english'|trans }}</span>
      <p>{{ card.english }}</p>
    </div>
    <div class="tr-block tr-original">
      <span class="tr-change-k">{{ 'moderate.translation.original'|trans }}</span>
      <p>{{ card.original }}</p>
    </div>

    {% for event in card.past %}
      {% if event.kind == 'english' %}
        <div class="tr-block tr-english-update">
          <span class="tr-change-k">{{ 'moderate.translation.english_later'|trans }}</span>
          <p>{{ event.text }}</p>
        </div>
      {% else %}
        <article class="tr-hist-item">
          {{ _self.change(event) }}
        </article>
      {% endif %}
    {% endfor %}

    {% if card.pending %}
      {% if card.open %}
      <form method="post" action="{{ path('moderate_translations_detail', {id: card.proposal.id}) }}">
        <input type="hidden" name="translation_decision[_token]" value="{{ csrf_token('moderate_translation') }}">
        <input type="hidden" name="translation_decision[proposal_id]" value="{{ card.proposal.id }}">
      {% endif %}
        <article class="tr-pending{% if not card.open %} tr-hist-item{% endif %}">
          {{ _self.change(card.pending) }}
          {% if card.open %}
          <div class="tr-publish">
            <label for="tr-published">{{ 'moderate.translation.proposed'|trans }}</label>
            <textarea id="tr-published" name="translation_decision[published]" maxlength="{{ proposed_max }}">{{ card.proposed }}</textarea>
            <p class="fhelp">{{ 'moderate.translation.proposed_help'|trans }}</p>
          </div>
          {% endif %}
        </article>
      {% if card.open %}
        <div class="td-actions">
          <textarea name="translation_decision[note]" maxlength="2000" placeholder="{{ 'moderate.translation.note_placeholder'|trans }}"></textarea>
          <button type="submit" name="translation_decision[decision]" value="approve" class="btn-act btn-approve">{{ 'moderate.action.approve'|trans }}</button>
          <button type="submit" name="translation_decision[decision]" value="reject" class="btn-act btn-reject">{{ 'moderate.action.reject'|trans }}</button>
          <button type="submit" name="translation_decision[decision]" value="needs_info" class="btn-act">{{ 'moderate.action.needs_info'|trans }}</button>
        </div>
      </form>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endblock %}
