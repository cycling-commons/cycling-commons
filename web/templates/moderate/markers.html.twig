{#
  The marker grammar, every rung of it, drawn by the rules the map draws
  (data-provider-hierarchy.md §6.7 and §6.7.7).

  A unit test can prove rung 7 drops its badge. It cannot tell anyone whether
  eleven rungs are learnable at a glance, and that is the question this page
  answers. The pins are the real .cc-pin classes from styles/pins.css, the
  glyph is THE kind set, and the custody, badge and grade of every row come
  from EvidenceRung, so this page cannot drift from the map. Each pin is
  drawn twice, on a dark and on a light ground, because the map has both.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/pins.css') }}">
<link rel="stylesheet" href="{{ asset('styles/page/moderate/markers.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_markers'} %}{% endblock %}

{% block body %}
{# The letter-B tap on the water colour, the same swatch the map key uses. #}
{% set tap %}<span class="kd">{% include 'partials/_kind_icon.html.twig' with {letter: 'B', kind: 'tap', size: 17, color: '#8FB6A8'} %}</span>{% endset %}
{% macro pin(border, badge, tap) %}<span class="cc-pin{{ border != 'solid' ? ' ' ~ border : '' }}{{ badge ? ' q' : '' }}" style="--c:#8FB6A8" aria-hidden="true">{{ tap }}</span>{% endmacro %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }}</div>
    <h1>{{ 'markers.title'|trans }}</h1>
  </div>
  <p class="mg-lede">{{ 'markers.lede'|trans }}</p>

  <h2 class="mg-h">{{ 'markers.grid_h'|trans }}</h2>
  <p class="mg-note">{{ 'markers.grid_t'|trans }}</p>
  <div class="mg-grid" role="table" aria-label="{{ 'markers.grid_h'|trans }}">
    <span class="h">{{ 'markers.axis_border'|trans }}</span>
    <span class="h">{{ 'markers.badge_on'|trans }}</span>
    <span class="h">{{ 'markers.badge_off'|trans }}</span>
    {% for custody, border in {gross: 'disc', specialty: 'dashed', ours: 'solid'} %}
      <span class="rh">{{ ('markers.custody_' ~ custody)|trans }}</span>
      <span class="mg-cell mg-dark" data-grid="{{ custody }}:q">{{ _self.pin(border, true, tap) }}</span>
      <span class="mg-cell mg-light" data-grid="{{ custody }}:">{{ _self.pin(border, false, tap) }}</span>
    {% endfor %}
  </div>
  <p class="mg-sentence">{{ 'markers.sentence'|trans }}</p>

  <h2 class="mg-h">{{ 'markers.ladder_h'|trans }}</h2>
  <p class="mg-note">{{ 'markers.ladder_t'|trans }}</p>
  <table class="mg-ladder">
    <thead>
      <tr>
        <th>{{ 'markers.col_rung'|trans }}</th>
        <th>{{ 'markers.col_dark'|trans }}</th>
        <th>{{ 'markers.col_light'|trans }}</th>
        <th>{{ 'markers.col_evidence'|trans }}</th>
        <th>{{ 'markers.col_grade'|trans }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr data-rung="{{ row.rung }}" data-custody="{{ row.custody }}" data-badge="{{ row.badge ? '?' : '' }}" data-grade="{{ row.grade }}"{% if not row.produced %} class="np"{% endif %}>
        <td class="n">{{ row.rung }}</td>
        <td class="sw"><span class="mg-cell mg-dark">{{ _self.pin(row.border, row.badge, tap) }}</span></td>
        <td class="sw"><span class="mg-cell mg-light">{{ _self.pin(row.border, row.badge, tap) }}</span></td>
        <td>{{ ('markers.rung_' ~ row.rung)|trans }}{% if not row.produced %}<span class="mg-tag">{{ 'markers.not_produced'|trans }}</span>{% endif %}</td>
        <td class="g">{{ ('markers.grade_' ~ row.grade)|trans }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="mg-utility">{{ 'markers.utility'|trans }}</p>
</div>
{% endblock %}
