{# Reading list of stale keys per locale (translations.md §3.3, §5). A stale
   translation stays live; this list never hides or replaces it, and carries
   no approve/edit control of its own. A curator who wants to fix one goes
   to /translate/{id} in that locale like any rider, and a second curator
   approves. #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/translations_stale.css') }}">
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_translations'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.translation.kicker'|trans }}</div>
    <h1>{{ 'moderate.translation.stale_heading'|trans }}</h1>
    <p class="lead">{{ 'moderate.translation.stale_lead'|trans }}</p>
  </div>

  <nav class="lfilter" aria-label="{{ 'moderate.translation.section_aria'|trans }}">
    <a class="lchip" href="{{ path('moderate_translations') }}">{{ 'moderate.translation.desk_queue'|trans }}</a>
    <a class="lchip tr-desk-hist" href="{{ path('moderate_translations_history') }}">{{ 'moderate.translation.desk_history'|trans }}</a>
    <a class="lchip on" href="{{ path('moderate_translations_stale') }}">{{ 'moderate.translation.desk_stale'|trans }}</a>
  </nav>

  <nav class="lfilter" aria-label="{{ 'translate.section_aria'|trans }}">
    {% for loc in locales %}
      <a class="lchip{{ loc == locale ? ' on' }}" href="{{ path('moderate_translations_stale', {locale: loc}) }}">{{ ('translate.locale.' ~ loc)|trans }}</a>
    {% endfor %}
  </nav>

  {% if rows is empty %}
    <div class="empty-state"><p>{{ 'moderate.translation.stale_empty'|trans }}</p></div>
  {% else %}
    <h2 class="sec-band">{{ 'moderate.translation.stale_heading'|trans }} <span class="sec-count">{{ rows|length }}</span></h2>
    <ul class="q-list">
      {% for row in rows %}
        <li class="q-item stale-item">
          <h3 class="q-title"><a class="q-title-link" href="{{ path('translate_edit', {_locale: locale, id: row.id}) }}">{{ row.message_key }}</a></h3>
          <dl>
            <dt>{{ 'moderate.translation.english'|trans }} v{{ row.english_version }}</dt><dd>{{ row.english }}</dd>
            <dt>{{ 'moderate.translation.live'|trans }}</dt><dd>{{ row.live }}</dd>
          </dl>
          <div class="row-meta is-stale">{{ 'moderate.translation.made_against'|trans({'%v%': row.made_against}) }}</div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
{% endblock %}
