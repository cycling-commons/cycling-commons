{#
  The inbox desk (docs/specs/contact-and-support.md §8).

  Sorted by DEADLINE, not by arrival. A GDPR request that came in three weeks
  ago is more urgent than a general question that came in this morning, and a
  desk sorted by arrival hides exactly that. Anything past its promised date is
  marked in a way that cannot be scrolled past.

  The default view is New, not everything: a desk that opens on the full archive
  is a desk where this morning's message is on page four.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/inbox.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_inbox'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }}</div>
    <h1>{{ 'support.inbox.title'|trans }}</h1>
    <p class="lede">{{ 'support.inbox.lede'|trans }}</p>
  </div>

  {% if overdue > 0 %}
    <p class="overdue-banner" role="alert">{{ 'support.inbox.overdue_banner'|trans({'%count%': overdue}) }}</p>
  {% endif %}

  <div class="chips">
    {% for st in statuses %}
      <a class="chip {{ filter_status == st.value ? 'on' : '' }}"
         href="{{ path('moderate_inbox', {status: st.value}) }}">
        {{ ('support.contact.status.' ~ st.value)|trans }}<span class="n">{{ counts[st.value] ?? 0 }}</span>
      </a>
    {% endfor %}
    <a class="chip {{ filter_status is null and filter_topic is null ? 'on' : '' }}"
       href="{{ path('moderate_inbox', {topic: 'question'}) }}">{{ 'support.inbox.all'|trans }}</a>
  </div>

  {% if messages is empty %}
    <div class="empty">{{ 'support.inbox.empty'|trans }}</div>
  {% else %}
    {% for m in messages %}
      {% set late = m.isOverdue(now) %}
      <div class="msgrow {{ late ? 'is-overdue' : '' }}">
        <div class="msgtop">
          <a href="{{ path('moderate_inbox_detail', {id: m.id}) }}">{{ ('support.topic.' ~ m.topic.value)|trans }}</a>
          <span class="tag">{{ ('support.contact.status.' ~ m.status.value)|trans }}</span>
          {% if m.dueAt %}
            <span class="tag {{ late ? 'late' : 'clock' }}">
              {{ late ? 'support.inbox.late'|trans : 'support.inbox.due'|trans }} {{ m.dueAt|cc_date }}
            </span>
          {% endif %}
        </div>
        <p class="msgexcerpt">{{ m.body|length > 180 ? m.body|slice(0, 180) ~ '…' : m.body }}</p>
        <p class="msgmeta">
          {# The desk is off (ModerateInboxController::ENABLED); the address is
             gone from here so that turning it back on cannot quietly undo the
             rule that nobody sees anybody else's email. #}
          {{ m.createdAt|cc_datetime }}{% if m.locale %} · {{ m.locale }}{% endif %}
          {%- if m.pageUrl %} · {{ m.pageUrl }}{% endif %}
        </p>

        <form class="handle" method="post" action="{{ path('moderate_inbox_handle') }}">
          <input type="hidden" name="_token" value="{{ csrf_token('inbox-handle') }}">
          <input type="hidden" name="id" value="{{ m.id }}">
          <input type="hidden" name="return_to" value="{{ filter_status ?? '' }}">
          <label class="vh" for="st-{{ m.id }}">{{ 'support.inbox.set_status'|trans }}</label>
          <select id="st-{{ m.id }}" name="status">
            {% for st in statuses %}
              <option value="{{ st.value }}"{{ st == m.status ? ' selected' : '' }}>{{ ('support.contact.status.' ~ st.value)|trans }}</option>
            {% endfor %}
          </select>
          <label class="vh" for="nt-{{ m.id }}">{{ 'support.inbox.note'|trans }}</label>
          <input type="text" id="nt-{{ m.id }}" name="note" maxlength="500"
                 placeholder="{{ 'support.inbox.note_placeholder'|trans }}">
          <button type="submit" class="btn btn-p btn-sm">{{ 'support.inbox.save'|trans }}</button>
        </form>
      </div>
    {% endfor %}

    {% include 'partials/_pager.html.twig' with {
      pager: pager,
      route: 'moderate_inbox',
      params: {status: filter_status, topic: filter_topic}
    } %}
  {% endif %}
</div>
{% endblock %}
