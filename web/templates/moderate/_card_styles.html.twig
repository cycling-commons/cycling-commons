{#
  The moderation card system, shared by every desk that shows one.

  It started as the submissions queue's own <style> block and was copied
  nowhere — which is why the Routes desk was still on the older stacked
  `.msg-rider` layout months later (2026-08-03 handoff item 2). One desk
  learning something the others do not is the failure mode this partial
  removes: a curator moves between /moderate, /moderate/routes and
  /moderate/takedowns in one sitting and the card must not change shape
  under them.

  Included ONCE, by account/_shell_styles.html.twig, so every shell page
  (a rider's contributions and messages included, 2026-08-25) draws the same
  card. Include `moderate/_card_script.html.twig` at the end of `body` for the
  disclosure + density enhancements. Spec: moderation-and-contribution.md §5.2.
#}
  .q-list{margin:.9rem 0 1.8rem}
  /* Tight (owner 2026-08-25): a list is read down, so the card is the row, not a box around it. */
  .q-item{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:.5rem .8rem;margin-bottom:.4rem;background:var(--paper)}
  /* Heading block and action row share the card's top line, so an ordinary
     submission is two lines tall and only real review context (photo, diff,
     rider's words) makes the card grow. */
  .q-top{display:flex;align-items:flex-start;gap:.9rem;flex-wrap:wrap}
  .q-headwrap{flex:1 1 16rem;min-width:0}
  .q-acts-wrap{flex:0 0 auto}
  /* Tag, title and age share one line: three separate rows for one heading is
     what made a queue of dozens scroll for pages. */
  .q-head{display:flex;align-items:baseline;gap:.55rem;flex-wrap:wrap}
  .q-tag{font-family:var(--mono);font-size:.57rem;letter-spacing:.07em;text-transform:uppercase;padding:.2rem .45rem;border-radius:3px;color:var(--ink);flex:0 0 auto;align-self:center}
  .q-tag--new{background:#FF5A1F}.q-tag--edit{background:#8FB6A8}.q-tag--hazard{background:#C8923A}.q-tag--photo{background:#B5532E;color:var(--paper)}
  /* Answered: the rider came back and this card is waiting on the curator. */
  .q-tag--answered{background:var(--spruce-lift);color:var(--paper)}
  /* Rider-side kinds, same chip: a route proposal, a catalog category, a country. */
  .q-tag--route{background:var(--trail)}
  .q-tag--kind{background:var(--spruce);color:var(--paper)}
  .q-tag--quiet{background:rgba(20,22,14,.1);color:#4a4d40}
  .q-when{font-family:var(--mono);font-size:.7rem;color:#8a8d7d;margin-left:auto;flex:0 0 auto}
  .q-title{font-family:var(--serif);font-weight:600;font-size:1rem;margin:0;min-width:0}
  .q-title-link{color:inherit;text-decoration:none}
  .q-title-link:hover,.q-title-link:focus-visible{text-decoration:underline;text-decoration-color:var(--trail)}
  .q-submitter{font-family:var(--mono);font-size:.72rem;color:#595c4d;margin:.1rem 0 .15rem}
  /* A far scenic view the rider overruled: the claim the curator decides on. */
  .q-bikeway{display:inline-block;margin-left:.4rem;padding:.05rem .4rem;border-radius:3px;background:#FFE0D2;color:#5a2716}
  .q-view{color:var(--clay);text-decoration:none;border-bottom:1px solid rgba(184,89,58,.35);white-space:nowrap}
  .q-view:hover{color:var(--ink);border-bottom-color:var(--ink)}
  .q-view:focus-visible{outline:2px solid var(--trail);outline-offset:2px;border-radius:2px}
  .q-body{font-size:.9rem;line-height:1.5;color:#333;margin-bottom:.6rem}
  .q-diff{background:rgba(20,22,14,.05);border-radius:5px;padding:.55rem .75rem;font-size:.86rem;margin-bottom:.7rem}
  /* pending rider photos (docs/specs/photo-uploads.md §5) */
  .q-photos{display:flex;flex-wrap:wrap;gap:.6rem;margin:.6rem 0}
  .q-photo{margin:0}
  .q-photo img{width:110px;height:82px;object-fit:cover;border-radius:5px;display:block}
  .q-photo figcaption{font-family:var(--mono);font-size:.7rem;letter-spacing:.04em;color:#595c4d;margin-top:.2rem;max-width:110px}
  .q-was{color:#8a8d7d;text-decoration:line-through}
  .q-now{color:var(--trail)}
  .q-rider-reply{font-size:.88rem;line-height:1.5;color:#4a4d40;background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.55rem .8rem;border-radius:0 5px 5px 0;margin-bottom:.7rem}
  .q-rider-reply strong{color:var(--ink);font-weight:700}
  /* A verdict already on record for this place. Clay, not glacier: it is the
     one line on the card that says "somebody already decided this", and it
     stays visible in list density (below) because it changes what the
     decision IS, not just the context it is made in. */
  .q-prior-reject{font-size:.84rem;line-height:1.5;color:#4a4d40;background:var(--paper-deep);border-left:2px solid var(--clay);padding:.45rem .8rem;border-radius:0 5px 5px 0;margin-bottom:.7rem}
  .q-prior-reject strong{color:var(--clay);font-weight:700}
  /* The Safe Browsing warning on a submission's proposed links
     (catalog-data-model.md §7). Two weights, because the two verdicts ask for
     different behaviour: `unsafe` is "do not click", `unknown` is "we could
     not ask". Neither is a rejection - the card is here to be decided. */
  .q-link-flag{font-size:.84rem;line-height:1.5;padding:.45rem .8rem;border-radius:0 5px 5px 0;margin-bottom:.7rem}
  .q-link-unsafe{color:#7d2018;background:rgba(163,52,43,.09);border-left:2px solid #a3342b}
  .q-link-unknown{color:#4a4d40;background:var(--paper-deep);border-left:2px solid var(--glacier)}
  .q-actions{margin-top:.9rem;border-top:1px solid rgba(20,22,14,.1);padding-top:.9rem}
  .q-act-form textarea{display:none}
  .q-decision-row{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem}
  .q-decision-row label{font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;margin:0}
  .q-decision-row select{max-width:220px}
  .q-act-btns{display:flex;gap:.5rem;flex-wrap:wrap}
  .q-review{display:inline-block;text-decoration:none}
  /* .btn-act + variants come from account/_shell_styles.html.twig (one orange system) */

  /* ONE action row. The <details> triggers are buttons beside the primary
     action; an OPEN panel claims the whole row (flex-basis:100%) so the form
     drops underneath instead of stretching the row it sits in — which is what
     lets four controls live on one line without the row jumping around. */
  .q-acts{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;flex:0 1 auto;max-width:100%}
  .q-act{flex:0 0 auto;min-width:0}
  /* No-JS fallback only: an open <details> claims the row so its form is not
     squeezed into a button's width. It costs the trigger its place in the
     line, which is exactly what the enhancement below removes. */
  .q-act[open]{flex:1 0 100%;order:1}
  .q-act > summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center}
  .q-act > summary::-webkit-details-marker{display:none}
  .q-act > summary::marker{content:''}
  .q-act[open] > summary{background:rgba(20,22,14,.06)}
  .q-act-panel{margin:.55rem 0 .2rem;padding:.7rem .85rem;border:1px solid rgba(20,22,14,.14);
    border-radius:6px;background:var(--paper-deep)}
  /* Enhanced disclosure: the trigger is a real button that never leaves the
     row, and its panel lives in .q-panels underneath the whole card. */
  .q-act-btn[aria-expanded="true"]{background:rgba(20,22,14,.06)}
  .q-panels .q-act-panel{margin:.6rem 0 0}
  .q-act-panel form{display:flex;flex-direction:column;gap:.5rem}
  .q-act-panel form .btn-act{align-self:flex-start}
  .q-act-panel p{font-size:.90rem;line-height:1.5;color:#4a4d40}
  .q-act-head{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay)}
  /* WHEN to reach for this verb, set apart from the how — the sentence that
     stops a curator using Trash on a merely wrong edit. */
  .q-act-when{border-left:2px solid var(--clay);padding-left:.6rem;font-weight:600}
  .q-act-ack{display:flex;align-items:flex-start;gap:.45rem;font-size:.84rem;line-height:1.45;color:#4a4d40;cursor:pointer}
  .q-act-ack input{margin-top:.2rem;flex:0 0 auto}
  .q-act-panel textarea{width:100%;min-height:80px;font-family:var(--sans);font-size:.85rem;padding:.5rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}
  .q-act-panel input[type=text]{font-family:var(--sans);font-size:.9rem;padding:.45rem .55rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper)}

  /* List density (2026-08-02): the same rows with the review context folded
     away — for triage passes, where the curator is scanning what arrived
     rather than reading each one. The decision still happens on the map, so
     nothing needed for a DECISION is hidden here; body, diff, photos and the
     rider's reply are all context that the map drawer shows again. */
  .q-density{display:flex;gap:.3rem;align-items:center;margin-left:auto}
  .q-density .dens{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;
    padding:.35rem .6rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;background:transparent;
    color:#595c4d;cursor:pointer;min-height:34px}
  .q-density .dens.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .q-list.is-list .q-item{padding:.3rem .7rem;margin-bottom:.25rem}
  .q-list.is-list .q-body,
  .q-list.is-list .q-diff,
  .q-list.is-list .q-photos,
  .q-list.is-list .q-rider-reply{display:none}
  .q-list.is-list .q-submitter{margin:0}
  .q-list.is-list .q-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  @media(min-width:900px){
    /* ONE line per submission: the card's own top block, with the heading and
       the submitter side by side instead of stacked. Nothing is capped in
       width — a cap made the four buttons wrap to a second line, and a
       two-line "list" row is barely shorter than the card it compresses. The
       title is the only elastic part and takes the ellipsis. Opening a panel
       still expands the row, which is the one time the height is wanted. */
    .q-list.is-list .q-item{padding:.35rem .7rem}
    .q-list.is-list .q-top{flex-wrap:nowrap;align-items:center}
    .q-list.is-list .q-headwrap{display:flex;align-items:baseline;gap:.6rem;flex:1 1 auto}
    .q-list.is-list .q-head{flex:0 1 auto;min-width:0;flex-wrap:nowrap}
    /* 26ch cut the country off a region with a long name ("XanderK · North
       Holland …", owner-reported 2026-08-12) — and the row had the space to
       spare. 44ch fits the longest region names we carry (North
       Rhine-Westphalia) with the country after them; the title is still the
       elastic part that takes the ellipsis first. */
    /* The who/where text truncates; the OSM chip beside it never does (owner 2026-08-25). */
    .q-list.is-list .q-submitter{flex:0 1 auto;display:inline-flex;align-items:center;min-width:0;max-width:60ch}
    .q-list.is-list .q-submitter .q-who{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;max-width:44ch}
    .q-list.is-list .q-submitter .osm-chip,.q-list.is-list .q-submitter .q-osm-chip{flex:none}
  }
  .trash-warn{color:#8b1a1a}
  .trash-type-label{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:#8b1a1a;margin:.5rem 0}
  .trash-type-input{display:block;margin-top:.3rem;font-family:var(--mono);font-size:.85rem;padding:.35rem .5rem;border:1.5px solid #8b1a1a;border-radius:5px;background:transparent;max-width:11rem}
  /* Icon-only actions: square, so a row of them reads as a toolbar rather than
     as three more sentences. The word survives as title + aria-label — shorter,
     not hidden. */
  .btn-act.btn-icon{min-width:2.2rem;text-align:center;padding-left:.5rem;padding-right:.5rem;
    font-size:.95rem;line-height:1.1}
  /* Escalate is the only button here with its own colour, and it stays an
     OUTLINE like every other action: `.btn-act` on its own is the FILLED orange
     primary, and `.btn-secondary` is what makes it transparent — dropping that
     class is what turned two quiet icons into two orange blocks
     (owner-reported 2026-08-12). Trash is untouched; it was never asked to
     change. The flag reads apart because reporting suspected illegal content to
     an administrator is not the same act as deleting spam. */
  .btn-act.btn-secondary.btn-alarm{color:#6b21a8;border-color:rgba(107,33,168,.5)}
  .btn-act.btn-secondary.btn-alarm:hover{background:rgba(107,33,168,.1);color:#6b21a8;border-color:#6b21a8}
  /* Row thumbnail: small, square, and the first thing in the row — a curator
     scanning a queue reads the picture before the title. */
  .q-thumb{position:relative;flex:0 0 44px;display:block;border-radius:5px;overflow:hidden;
    border:1px solid rgba(20,22,14,.18);background:var(--paper-deep);line-height:0}
  .q-thumb img{width:44px;height:44px;object-fit:cover;display:block}
  .q-thumb:hover{border-color:var(--trail)}
  .q-thumb-n{position:absolute;right:0;bottom:0;background:rgba(20,22,14,.78);color:var(--paper);
    font-family:var(--mono);font-size:.68rem;padding:0 .2rem;border-radius:3px 0 0 0;line-height:1.3}
  /* The OSM identity chip (catalog-data-model.md §5b): one small pill in the
     meta line, three states. Open pops the candidates + "Not in OSM". */
  .osm-chip{display:inline-flex;align-items:center;gap:.3rem;margin-left:.45rem;vertical-align:middle;
    font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;line-height:1.4;padding:.1rem .5rem;
    border-radius:999px;border:1px solid;list-style:none;text-decoration:none;white-space:nowrap}
  .osm-chip::-webkit-details-marker{display:none}
  .osm-chip--open{color:#A0472A;border-color:#A0472A;cursor:pointer}
  .osm-chip--open:hover{background:rgba(160,71,42,.08)}
  .osm-chip--linked{color:#2f6b3f;border-color:#2f6b3f}
  .osm-chip--linked:hover{background:rgba(47,107,63,.08)}
  .osm-chip--none{color:#595c4d;border-color:rgba(20,22,14,.3)}
  /* The candidates open as a popover under the chip, not inside the meta line. */
  .q-osm-chip{display:inline-block;position:relative}
  .q-osm-chip > .q-act-panel{position:absolute;left:0;top:calc(100% + .3rem);z-index:20;width:max-content;min-width:12rem;max-width:min(28rem,90vw);padding-right:1.9rem;background:var(--paper);box-shadow:0 14px 30px -16px rgba(20,22,14,.5)}
  /* Compact: this popover hangs off a .62rem meta line, so its heading and
     buttons follow that scale, not the card-panel scale (owner 2026-08-25). */
  .q-osm-chip > .q-act-panel{padding:.5rem 1.9rem .5rem .6rem}
  .q-osm-close{position:absolute;top:.2rem;right:.3rem;border:0;background:none;font-size:1rem;line-height:1;color:#595c4d;cursor:pointer;padding:.15rem .35rem;border-radius:4px}
  .q-osm-close:hover{background:rgba(20,22,14,.08);color:var(--ink)}
  .q-osm-chip .q-act-panel p.q-act-head{font-size:.7rem;margin:0 0 .4rem;line-height:1.4}
  .q-osm-chip .q-osm .btn-act{font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;padding:.22rem .55rem;
    background:transparent;color:#A0472A;border:1px solid rgba(160,71,42,.55);border-radius:999px}
  .q-osm-chip .q-osm .btn-act:hover{background:rgba(160,71,42,.08);border-color:#A0472A}
  .q-osm{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem}
  .q-osm form{display:inline}
