{#
  The reports desk (docs/specs/content-reports.md §9).

  Notice and action under DSA Article 16, for everything that can be reported,
  photos included: a report about a photo from anybody but its uploader is
  decided here, and the decision carries through to the photo. The takedowns
  desk keeps only an uploader's request about their own photo, which is not a
  report.

  Legal grounds sort above the rest, then newest first. That is the one place
  this desk orders where the bugs desk deliberately does not: an unlawfulness
  claim has a clock on it, a quality complaint has a standard.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/reports.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_reports'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }}</div>
    <h1>{{ 'report.desk.title'|trans }}</h1>
    <p class="lede">{{ 'report.desk.lede'|trans({'%takedowns%': path('moderate_takedowns')})|rich }}</p>
  </div>

  {% include 'moderate/_urgent_breaker_banner.html.twig' with {open: urgent_breaker_open|default(false)} only %}

  {# Two labelled rows (moderate/_chip_row.html.twig), each keeping the
     other's choice. status=all is how the Open default is left on purpose. #}
  {% set status_chips = [] %}
  {% for st in statuses %}
    {% set status_chips = status_chips|merge([{value: st.value, label: st.label|trans, n: counts[st.value] ?? 0}]) %}
  {% endfor %}
  {% set target_chips = [] %}
  {% for tg in targets %}
    {% set target_chips = target_chips|merge([{value: tg.value, label: tg.label|trans, n: null}]) %}
  {% endfor %}
  {% include 'moderate/_chip_row.html.twig' with {
    row_id: 'reports-f-status', label: 'moderate.filter.status'|trans, name: 'status',
    current: filter_status, all_value: 'all', all_n: count_all, chips: status_chips,
    route: 'moderate_reports', keep: {target: filter_target},
  } only %}
  {% include 'moderate/_chip_row.html.twig' with {
    row_id: 'reports-f-target', label: 'moderate.filter.category'|trans, name: 'target', extra: 'kinds',
    current: filter_target, all_value: null, all_n: null, chips: target_chips,
    route: 'moderate_reports', keep: {status: filter_status},
  } only %}

  {% if rows is empty %}
    <div class="empty">{{ 'report.desk.empty'|trans }}</div>
  {% else %}
    {# A report this curator has not opened carries the unseen bar
       (moderation-and-contribution.md §5.2f); its page opens it. #}
    {% set unseen_ids = cc_unseen('content_report', rows|map(row => row.report.id)) %}
    {% for row in rows %}
      {% set r = row.report %}
      {% set row_unseen = unseen_ids[r.id|trim] is defined %}
      <div class="rrow {{ row_unseen ? 'is-unseen' }}"{% if row_unseen %} data-unread-class="is-unseen"{% endif %}>
        <div class="rtop">
          <a href="{{ path('moderate_reports_detail', {id: r.id}) }}" data-opens>{{ row.resolved.label ?? r.targetType.label|trans ~ ' #' ~ r.targetId }}</a>
          {%- if row_unseen %}{% include 'partials/_unseen.html.twig' %}{% endif %}
          {# Plain orange text, not blocks (owner 2026-09-08). #}
          <span class="cats"><span class="{{ r.ground.isUrgent ? 'legal' : '' }}">{{ r.ground.label|trans }}</span> · {{ r.status.label|trans }} · {{ r.targetType.label|trans }}{% if not row.resolved.exists %} · <span class="gone">{{ 'report.desk.target_gone'|trans }}</span>{% endif %}{% if row.held %} · <span class="legal">{{ 'report.desk.held_row'|trans }}</span>{% endif %}</span>
        </div>
        <p class="rmeta">
          {{ r.createdAt|cc_datetime }}
        </p>
      </div>
    {% endfor %}

    {% include 'partials/_pager.html.twig' with {
      pager: pager,
      route: 'moderate_reports',
      params: {status: filter_status, target: filter_target}
    } %}
  {% endif %}
</div>
{% endblock %}

{% block body_scripts %}<script src="{{ asset('js/open-to-read.js') }}" defer></script>{% endblock %}
