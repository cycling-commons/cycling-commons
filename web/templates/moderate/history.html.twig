{#
  The settled-submission record — its own page since 2026-08-03 (owner).

  It began as a section under the queue and grew a diff, a rider reply, a
  foldable conversation and a pager. A desk about what is still to do should
  not carry an unbounded list of what is already done, so the two are separate
  pages that share only their tab strip.

  Since 2026-08-25 a settled row is the shared record card, like every other
  list in the shell: the verdict is its pill, the diff its diff, the
  conversation a folded thread under it. List density is what makes it scan.
#}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_history', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% block body %}
{# The filters this page pages through, so every link keeps them. #}
{% set hparams = {handled: history_filters.mine ? 'mine' : null, hstatus: history_filters.status, q: history_filters.q,
                  country: history_filters.country, region: history_filters.region, type: history_filters.type} %}
<div class="mh">
  <div class="wrap">
    <div class="kicker">{{ 'moderate.history.kicker'|trans }}</div>
    <h1>{{ 'moderate.history.heading'|trans }}</h1>
    <div><span class="role-badge">&#9876; {{ 'moderate.role_label'|trans }}</span></div>
  </div>
</div>

<div class="wrap" id="main">
  {# The same three selects the queue carries, plus the search — a curator who
     narrows the desk to their country narrows the record the same way, with the
     same controls (owner, 2026-08-03). The everyone/mine and status chips below
     stay chips: they are two-and-three-way switches, not lists. #}
  <div class="mod-bar">
  <form class="mod-filters" method="get" action="{{ path('moderate_history') }}">
    {% if history_filters.mine %}<input type="hidden" name="handled" value="mine">{% endif %}
    {% if history_filters.status %}<input type="hidden" name="hstatus" value="{{ history_filters.status }}">{% endif %}
    <label>{{ 'moderate.filter.country'|trans }}
      <select name="country" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for c in countries %}<option value="{{ c }}"{{ history_filters.country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.region'|trans }}
      <select name="region" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for r in regions %}<option value="{{ r }}"{{ history_filters.region == r ? ' selected' }}>{{ r }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.type'|trans }}
      <select name="type" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for t in types %}<option value="{{ t }}"{{ history_filters.type == t ? ' selected' }}>{{ ('moderate.type.' ~ t)|trans }}</option>{% endfor %}
      </select>
    </label>
    <label class="mod-search">{{ 'moderate.filter.search'|trans }}
      <input type="search" name="q" value="{{ history_filters.q }}" placeholder="{{ 'moderate.filter.search_ph'|trans }}">
    </label>
    <button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button>
  </form>
  </div>

  {# ── History ── what this desk has already settled.
     Only approved + rejected can appear: Trash hard-deletes the row and
     escalation lifts it off every desk, so there is nothing else to filter for
     (moderation-and-contribution.md §5.2). Plain links, not JS: a filter that
     survives a reload and can be linked to a colleague is worth a page load. #}
  <section class="q-history">
    <div class="hist-filters">
      <a class="hchip {{ history_filters.mine ? '' : 'on' }}" href="{{ path('moderate_history', hparams|merge({hstatus: history_filters.status})) }}">{{ 'moderate.history.everyone'|trans }}</a>
      <a class="hchip {{ history_filters.mine ? 'on' : '' }}" href="{{ path('moderate_history', hparams|merge({handled: 'mine', hstatus: history_filters.status})) }}">{{ 'moderate.history.mine'|trans }}</a>
      <span class="hsep"></span>
      <a class="hchip {{ history_filters.status ? '' : 'on' }}" href="{{ path('moderate_history', hparams|merge({handled: history_filters.mine ? 'mine' : null})) }}">{{ 'moderate.filter.all'|trans }}</a>
      <a class="hchip {{ history_filters.status == 'approved' ? 'on' : '' }}" href="{{ path('moderate_history', hparams|merge({handled: history_filters.mine ? 'mine' : null, hstatus: 'approved'})) }}">{{ 'moderate.action.approve'|trans }}</a>
      <a class="hchip {{ history_filters.status == 'rejected' ? 'on' : '' }}" href="{{ path('moderate_history', hparams|merge({handled: history_filters.mine ? 'mine' : null, hstatus: 'rejected'})) }}">{{ 'moderate.action.reject'|trans }}</a>
    </div>
    {% if history is empty %}
      <p class="hist-empty">{{ 'moderate.history.empty'|trans }}</p>
    {% else %}
      <ul class="hist-list">
        {% for h in history %}
          <li class="hist-row">
            <span class="hist-state hist-state--{{ h.status }}">{{ ('moderate.status.' ~ h.status)|trans }}</span>
            {# The picture, as in the open queue. A trashed row has none by
               design — the audit is content-free — and a rejected one may have
               lost its photos to disposal, so this is `if`, not `else`. #}
            {% if h.photos is defined and h.photos|length > 0 %}
              <a class="hist-thumb" href="{{ h.photos[0].lg }}" target="_blank" rel="noopener"
                 title="{{ 'improve.step3.open_full'|trans }}">
                <img src="{{ h.photos[0].sm }}" alt="" loading="lazy" width="28" height="28">
              </a>
            {% endif %}
            {# ?item=<id>, not ?pending=<id>: the submission is settled, so it is
               no longer in the pending payload and that link resolved nothing —
               the map just opened at the default scope with nothing selected.
               Only APPROVED rows link: a rejected item is not on the map, and a
               link that lands nowhere is worse than no link. #}
            <span class="hist-title">{% if h.itemId and h.status == 'approved' %}<a href="{{ path('map') }}?item={{ h.itemId }}" target="_blank" rel="noopener">{{ h.title }}</a>{% else %}{{ h.title }}{% endif %}{% if h.status == 'trashed' and h.type %} <span class="hist-kind">{{ ('moderate.type.' ~ h.type)|trans }}</span>{% endif %}
              {# The item's own kind. A custom title hides what a row is about;
                 an unnamed one already reads as its type, so repeating it there
                 would print "Water & food WATER & FOOD". #}
              {% if h.typeLabel is defined and h.typeLabel and (h.typeLabel|trans) != h.title %}<span class="hist-kind">{{ h.typeLabel|trans }}</span>{% endif %}</span>
            {# A trashed row carries no title and no rider: the audit is
               content-free by design, so all there is to show is who did it. #}
            <span class="hist-meta">{{ h.who }}{% if h.decidedBy %}{% if h.who %} · {% endif %}{{ 'moderate.history.by'|trans({'%who%': h.decidedBy}) }}{% endif %}</span>
            <span class="hist-when">{{ h.when }}</span>
          </li>
          {# The curator's own note, then the rider's answer. Since a needs-info
             reply is desk work rather than personal mail (§5.4), this history is
             the only place it survives once the submission is decided. #}
          {# WHAT was decided. A verdict with no subject ("Approved · Côte de la
             Redoute") tells a curator nothing they can check (owner-reported
             2026-08-03). Same before/after the queue card shows. #}
          {% if h.now %}
            {# Long values (a drawn segment's geometry) clamp to one line,
               click to expand — partials/_vclip.html.twig. #}
            {% set hlong = (h.now ~ (h.was ?? ''))|length > 110 %}
            <li class="hist-diff{% if hlong %} vclip" tabindex="0" role="button" aria-expanded="false{% endif %}">{% if h.was %}<span class="hist-was">{{ h.was }}</span> {% endif %}<span class="hist-now">{{ h.now }}</span></li>
          {% endif %}
          {% if h.note %}<li class="hist-note">{{ h.note }}</li>{% endif %}
          {# The full exchange, folded away. The row stays one line because most
             submissions never had a conversation; the ones that did are the
             only place it survives — change_history records what was APPLIED,
             not what was asked, and the reply is no longer personal mail
             (§5.4). Shown instead of the single latest reply, which is a
             subset of this. #}
          {% if h.thread is not empty %}
            <li class="hist-thread-row">
              <details class="hist-thread">
                <summary>{{ 'moderate.history.thread'|trans({'%count%': h.thread|length}) }}</summary>
                <ol class="hist-msgs">
                  {% for m in h.thread %}
                    <li class="hist-msg hist-msg--{{ m.who }}">
                      <span class="hist-msg-who">{{ ('moderate.history.said_' ~ m.who)|trans }}</span>
                      <span class="hist-msg-body">{{ m.body ?: 'moderate.history.no_text'|trans }}</span>
                      <span class="hist-msg-when">{{ m.when }}</span>
                    </li>
                  {% endfor %}
                </ol>
              </details>
            </li>
          {% elseif h.riderReply %}
            <li class="hist-note hist-reply"><strong>{{ 'moderate.rider_reply'|trans }}:</strong> {{ h.riderReply }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </section>

  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'moderate_history', params: hparams} %}
</div>
{% include 'partials/_vclip.html.twig' %}
{% endblock %}
