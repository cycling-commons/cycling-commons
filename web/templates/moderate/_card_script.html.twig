{#
  Progressive enhancements for the shared moderation card
  (moderate/_card_styles.html.twig). Include at the END of a desk's `body`
  block. Both halves are enhancements, never the markup: a curator with no JS
  keeps every verb, and keeps the cards view that carries the full context.

  Spec: moderation-and-contribution.md §5.2.
#}
<script nonce="{{ csp_nonce() }}">
/* Cancel closes the panel it sits in.

   Pressing the ⚑ or 🗑 summary again does close it, but only once a curator has
   worked out that the control is a toggle — and a panel that announces "nothing
   can delete it afterwards" is not one to feel trapped in (owner 2026-08-12).
   Delegated, because rows are re-rendered and a listener per button would leak
   one per row. */
document.addEventListener('click', function (e) {
  var btn = e.target.closest && e.target.closest('.q-act-cancel');
  if (!btn) return;
  e.preventDefault();

  /* With JS the <details> is REPLACED by a button and its panel is moved into a
     sibling `.q-panels` host (see the disclosure rewrite below) — so a panel is
     not inside a <details> at runtime and `closest('details')` finds nothing.
     That is why the first version of this did nothing at all
     (owner-reported 2026-08-12), and why it is worth saying here: the markup a
     template writes is not the markup this handler meets.

     Without JS the <details> is still real, so both shapes are handled. */
  var panel = btn.closest('.q-act-panel');
  var native = btn.closest('details.q-act');
  if (native) {
    native.open = false;
    var summary = native.querySelector('summary');
    if (summary) summary.focus();
    return;
  }
  if (!panel) return;
  panel.hidden = true;
  var h = panel.closest('.q-panels');
  if (h && !h.querySelector('.q-act-panel:not([hidden])')) h.hidden = true;
  var opener = panel.id ? document.querySelector('[aria-controls="' + panel.id + '"]') : null;
  if (opener) {
    opener.setAttribute('aria-expanded', 'false');
    opener.focus();   // back where they were, not adrift on the page
  }
});

/* A decision taken on the map removes its row here, live.

   The desk and the map are two views of one queue, and a curator moves between
   them constantly: review on the map, decide there, come back. The tab left
   behind used to keep the decided row until a reload, so the queue lied about
   what was left to do — and clicking Review on it led to a submission already
   settled.

   Removal only, never insertion: a new submission arriving while the desk is
   open is not urgent, and a row appearing under a curator's cursor mid-decision
   is worse than one arriving on the next load. */
(function () {
  if (typeof BroadcastChannel !== 'function') return;
  var ch = new BroadcastChannel('cc-moderation');
  ch.onmessage = function (e) {
    var id = e && e.data && e.data.decided;
    if (!id) return;
    var row = document.querySelector('.q-item[data-item-id="' + String(id).replace(/[^0-9]/g, '') + '"]');
    if (!row) return;
    row.remove();
    // The tab badge counts what is open; it has to agree with the list.
    document.querySelectorAll('.dtab-count').forEach(function (el) {
      var n = parseInt(el.textContent, 10);
      if (!isNaN(n) && n > 0) { el.textContent = String(n - 1); if (n - 1 === 0) el.hidden = true; }
    });
  };
})();

/* Density switch. The bar is unhidden here rather than in the markup so the
   control only exists where it can work. Every `.q-list` on the page folds
   together — the Routes desk has two (proposals and corrections) and a
   curator switching density means the desk, not one section of it. */
(function () {
  var bar = document.getElementById('qDensity');
  var lists = document.querySelectorAll('.q-list');
  if (!bar || !lists.length) return;
  var KEY = 'cc-mod-density';
  function apply(mode) {
    lists.forEach(function (list) { list.classList.toggle('is-list', mode === 'list'); });
    bar.querySelectorAll('.dens').forEach(function (b) {
      var on = b.dataset.dens === mode;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }
  var saved = 'list';
  try { saved = localStorage.getItem(KEY) === 'list' ? 'list' : 'cards'; } catch (e) { saved = 'cards'; }
  apply(saved);
  bar.hidden = false;
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('.dens');
    if (!b) return;
    apply(b.dataset.dens);
    try { localStorage.setItem(KEY, b.dataset.dens); } catch (e2) { /* private mode — the view still switched */ }
  });
})();

/* Action panels: keep the triggers on ONE line.

   A <details> cannot do this. Its panel is a descendant of the element that
   sits in the button row, so an open panel either squeezes into a button's
   width or takes the whole row and drags its own trigger onto the next line
   (`display:contents` on <details> is not a way out — Chrome then shows the
   panel while it is CLOSED). So with JS the <details> becomes the disclosure
   it was standing in for: a real button that stays put, and its panel moved to
   a host below the card. aria-expanded/aria-controls carry what <summary> was
   carrying for free.

   Without JS the markup is untouched and every verb still works — the trigger
   just moves when it opens. That is the reason this is an enhancement and not
   the server's markup: a moderator with no JS keeps Message, Escalate, Trash.

   Driven off `.q-acts` rather than off the card, because a desk may put an
   action row somewhere that is not a queue row — the routes proposal DETAIL
   page has exactly one, belonging to the page.

   One panel open at a time per action row, so a queue does not quietly turn
   into a column of expanded forms. */
(function () {
  document.querySelectorAll('.q-acts').forEach(function (acts, rowIndex) {
    var details = Array.prototype.slice.call(acts.querySelectorAll('.q-act'));
    if (!details.length) return;

    var owner = acts.closest('[data-item-id]');
    var key = (owner && owner.dataset.itemId) || ('r' + rowIndex);

    var host = document.createElement('div');
    host.className = 'q-panels';
    host.hidden = true;   // shown only while a panel is open, so it costs the row nothing
    acts.parentNode.insertBefore(host, acts.nextSibling);

    var pairs = [];
    details.forEach(function (d, i) {
      var summary = d.querySelector('summary');
      var panel = d.querySelector('.q-act-panel');
      if (!summary || !panel) return;

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = summary.className + ' q-act-btn ' + d.className.replace('q-act', '').trim();
      btn.textContent = summary.textContent;
      /* An icon-only summary carries its word in `title`/`aria-label`, and this
         rewrite used to copy neither — so ⚑ and 🗑 arrived as two unlabelled
         glyphs for anyone reading with a screen reader or hovering for a hint. */
      if (summary.title) btn.title = summary.title;
      var label = summary.getAttribute('aria-label');
      if (label) btn.setAttribute('aria-label', label);
      /* "Show details" reads "Hide details" while its panel is open: the
         trigger carries the open wording in data-label-open (owner 2026-08-25). */
      btn.dataset.labelClosed = summary.textContent;
      if (summary.dataset.labelOpen) btn.dataset.labelOpen = summary.dataset.labelOpen;
      btn.setAttribute('aria-expanded', 'false');
      var id = 'qp-' + key + '-' + i;
      panel.id = id;
      btn.setAttribute('aria-controls', id);

      panel.hidden = true;
      host.appendChild(panel);
      d.parentNode.replaceChild(btn, d);
      pairs.push({ btn: btn, panel: panel });
    });

    pairs.forEach(function (p) {
      p.btn.addEventListener('click', function () {
        var opening = p.panel.hidden;
        pairs.forEach(function (o) {
          o.panel.hidden = true;
          o.btn.setAttribute('aria-expanded', 'false');
          if (o.btn.dataset.labelOpen) o.btn.textContent = o.btn.dataset.labelClosed;
        });
        host.hidden = !opening;
        if (opening) {
          p.panel.hidden = false;
          p.btn.setAttribute('aria-expanded', 'true');
          if (p.btn.dataset.labelOpen) p.btn.textContent = p.btn.dataset.labelOpen;
          var first = p.panel.querySelector('textarea, input:not([type=hidden]), select');
          if (first) first.focus();
        }
      });
    });
  });
})();
</script>
