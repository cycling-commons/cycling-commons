{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .mh{padding:2rem 0 1.4rem}
  .mh .kicker{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  .mh h1{font-family:var(--serif);font-weight:600;font-size:clamp(1.8rem,4vw,2.4rem);line-height:1.08;margin-bottom:.4rem;color:var(--ink)}
  .mh .role-badge{display:inline-flex;align-items:center;gap:.4rem;font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;background:var(--spruce-lift);color:var(--paper);padding:.22rem .55rem;border-radius:30px;margin-top:.5rem}
  .mh .pend-count{font-family:var(--mono);font-size:.68rem;color:var(--clay);margin-left:.8rem}


  .mod-bar{display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;margin:0 0 1.4rem}
  .mod-filters{display:flex;gap:1rem;flex-wrap:wrap;align-items:end;margin:0}
  .mod-filters label{font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:flex;flex-direction:column;gap:.3rem}
  .mod-filters select{font-family:var(--sans);font-size:.9rem;padding:.5rem;min-height:34px;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);min-width:150px}

  .q-list{margin:1.8rem 0}
  .q-item{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:.8rem .9rem;margin-bottom:.6rem;background:var(--paper)}
  /* Heading block and action row share the card's top line, so an ordinary
     submission is two lines tall and only real review context (photo, diff,
     rider's words) makes the card grow. */
  .q-top{display:flex;align-items:flex-start;gap:.9rem;flex-wrap:wrap}
  .q-headwrap{flex:1 1 16rem;min-width:0}
  .q-acts-wrap{flex:0 0 auto}
  /* Tag, title and age share one line: three separate rows for one heading is
     what made a queue of dozens scroll for pages. */
  .q-head{display:flex;align-items:baseline;gap:.55rem;flex-wrap:wrap}
  .q-tag{font-family:var(--mono);font-size:.57rem;letter-spacing:.07em;text-transform:uppercase;padding:.2rem .45rem;border-radius:3px;color:var(--ink);flex:0 0 auto;align-self:center}
  .q-tag--new{background:#FF5A1F}.q-tag--edit{background:#8FB6A8}.q-tag--hazard{background:#C8923A}.q-tag--photo{background:#B5532E;color:var(--paper)}
  /* Answered: the rider came back and this card is waiting on the curator. */
  .q-tag--answered{background:var(--spruce-lift);color:var(--paper)}
  .q-when{font-family:var(--mono);font-size:.6rem;color:#8a8d7d;margin-left:auto;flex:0 0 auto}
  .q-title{font-family:var(--serif);font-weight:600;font-size:1rem;margin:0;min-width:0}
  .q-submitter{font-family:var(--mono);font-size:.62rem;color:#595c4d;margin:.15rem 0 .45rem}
  .q-view{color:var(--clay);text-decoration:none;border-bottom:1px solid rgba(184,89,58,.35);white-space:nowrap}
  .q-view:hover{color:var(--ink);border-bottom-color:var(--ink)}
  .q-view:focus-visible{outline:2px solid var(--trail);outline-offset:2px;border-radius:2px}
  .q-body{font-size:.9rem;line-height:1.5;color:#333;margin-bottom:.6rem}
  .q-diff{background:rgba(20,22,14,.05);border-radius:5px;padding:.55rem .75rem;font-size:.86rem;margin-bottom:.7rem}
  /* pending rider photos (docs/specs/photo-uploads.md §5) */
  .q-photos{display:flex;flex-wrap:wrap;gap:.6rem;margin:.6rem 0}
  .q-photo{margin:0}
  .q-photo img{width:110px;height:82px;object-fit:cover;border-radius:5px;display:block}
  .q-photo figcaption{font-family:var(--mono);font-size:.6rem;letter-spacing:.04em;color:#595c4d;margin-top:.2rem;max-width:110px}
  .q-was{color:#8a8d7d;text-decoration:line-through}
  .q-now{color:var(--trail)}
  .q-rider-reply{font-size:.88rem;line-height:1.5;color:#4a4d40;background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.55rem .8rem;border-radius:0 5px 5px 0;margin-bottom:.7rem}
  .q-rider-reply strong{color:var(--ink);font-weight:700}
  .q-actions{margin-top:.9rem;border-top:1px solid rgba(20,22,14,.1);padding-top:.9rem}
  .q-act-form textarea{display:none}
  .q-decision-row{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem}
  .q-decision-row label{font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;margin:0}
  .q-decision-row select{max-width:220px}
  .q-act-btns{display:flex;gap:.5rem;flex-wrap:wrap}
  .q-review{display:inline-block;text-decoration:none}
  /* .btn-act + variants come from account/_shell_styles.html.twig (one orange system) */

  /* ONE action row. The <details> triggers are buttons beside the primary
     action; an OPEN panel claims the whole row (flex-basis:100%) so the form
     drops underneath instead of stretching the row it sits in — which is what
     lets four controls live on one line without the row jumping around. */
  .q-acts{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;flex:0 1 auto;max-width:100%}
  .q-act{flex:0 0 auto;min-width:0}
  /* No-JS fallback only: an open <details> claims the row so its form is not
     squeezed into a button's width. It costs the trigger its place in the
     line, which is exactly what the enhancement below removes. */
  .q-act[open]{flex:1 0 100%;order:1}
  .q-act > summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center}
  .q-act > summary::-webkit-details-marker{display:none}
  .q-act > summary::marker{content:''}
  .q-act[open] > summary{background:rgba(20,22,14,.06)}
  .q-act-panel{margin:.55rem 0 .2rem;padding:.7rem .85rem;border:1px solid rgba(20,22,14,.14);
    border-radius:6px;background:var(--paper-deep)}
  /* Enhanced disclosure: the trigger is a real button that never leaves the
     row, and its panel lives in .q-panels underneath the whole card. */
  .q-act-btn[aria-expanded="true"]{background:rgba(20,22,14,.06)}
  .q-panels .q-act-panel{margin:.6rem 0 0}
  .q-act-panel form{display:flex;flex-direction:column;gap:.5rem}
  .q-act-panel form .btn-act{align-self:flex-start}
  .q-act-panel p{font-size:.86rem;line-height:1.5;color:#4a4d40}
  .q-act-head{font-family:var(--mono);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay)}
  /* WHEN to reach for this verb, set apart from the how — the sentence that
     stops a curator using Trash on a merely wrong edit. */
  .q-act-when{border-left:2px solid var(--clay);padding-left:.6rem;font-weight:600}
  .q-act-ack{display:flex;align-items:flex-start;gap:.45rem;font-size:.84rem;line-height:1.45;color:#4a4d40;cursor:pointer}
  .q-act-ack input{margin-top:.2rem;flex:0 0 auto}
  .q-act-panel textarea{width:100%;min-height:80px;font-family:var(--sans);font-size:.85rem;padding:.5rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}
  .q-act-panel input[type=text]{font-family:var(--sans);font-size:.9rem;padding:.45rem .55rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper)}

  /* List density (2026-08-02): the same rows with the review context folded
     away — for triage passes, where the curator is scanning what arrived
     rather than reading each one. The decision still happens on the map, so
     nothing needed for a DECISION is hidden here; body, diff, photos and the
     rider's reply are all context that the map drawer shows again. */
  .q-density{display:flex;gap:.3rem;align-items:center;margin-left:auto}
  .q-density .dens{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;
    padding:.35rem .6rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;background:transparent;
    color:#595c4d;cursor:pointer;min-height:34px}
  .q-density .dens.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .q-list.is-list .q-item{padding:.45rem .7rem;margin-bottom:.3rem}
  .q-list.is-list .q-body,
  .q-list.is-list .q-diff,
  .q-list.is-list .q-photos,
  .q-list.is-list .q-rider-reply{display:none}
  .q-list.is-list .q-submitter{margin:0}
  .q-list.is-list .q-title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  @media(min-width:900px){
    /* ONE line per submission: the card's own top block, with the heading and
       the submitter side by side instead of stacked. Nothing is capped in
       width — a cap made the four buttons wrap to a second line, and a
       two-line "list" row is barely shorter than the card it compresses. The
       title is the only elastic part and takes the ellipsis. Opening a panel
       still expands the row, which is the one time the height is wanted. */
    .q-list.is-list .q-item{padding:.35rem .7rem}
    .q-list.is-list .q-top{flex-wrap:nowrap;align-items:center}
    .q-list.is-list .q-headwrap{display:flex;align-items:baseline;gap:.6rem;flex:1 1 auto}
    .q-list.is-list .q-head{flex:0 1 auto;min-width:0;flex-wrap:nowrap}
    .q-list.is-list .q-submitter{flex:0 1 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:26ch}
  }
  .trash-warn{color:#8b1a1a}
  .trash-type-label{display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:#8b1a1a;margin:.5rem 0}
  .trash-type-input{display:block;margin-top:.3rem;font-family:var(--mono);font-size:.85rem;padding:.35rem .5rem;border:1.5px solid #8b1a1a;border-radius:5px;background:transparent;max-width:11rem}
  .msg-rider textarea{width:100%;min-height:80px;font-family:var(--sans);font-size:.85rem;padding:.5rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}

  /* photo takedown requests (docs/specs/photo-uploads.md §6b) */
  .q-takedowns{margin:0 0 2rem;padding:1.2rem;border:1px solid var(--clay);border-radius:8px;background:rgba(181,83,46,.05)}
  .q-takedowns h2{font-family:var(--serif);font-size:1.15rem;margin:0}
  .td-lead{font-size:.86rem;color:#4a4d40;margin:.3rem 0 1rem;line-height:1.5}
  .td-card{border-top:1px solid rgba(20,22,14,.12);padding:.9rem 0}
  .td-body{display:flex;gap:.9rem;align-items:flex-start}
  .td-body img{width:110px;height:82px;object-fit:cover;border-radius:5px;flex:0 0 auto}
  .td-reason{font-size:.9rem;line-height:1.5;margin:.3rem 0;white-space:pre-wrap}
  .td-meta{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;color:#595c4d;margin:0}
  .td-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.7rem}
  .td-actions input[type=text]{flex:1 1 14rem;font-family:inherit;font-size:.85rem;padding:.4rem .6rem;
    border:1px solid rgba(20,22,14,.2);border-radius:5px}
  .empty-queue{text-align:center;padding:4rem 1rem;color:#595c4d}
  .empty-queue .ic{font-size:2.4rem;margin-bottom:.5rem}
  .empty-queue h3{font-family:var(--serif);font-size:1.4rem}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: nav_active|default('moderate'), mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% block body %}
<div class="mh">
  <div class="wrap">
    <div class="kicker">{{ 'moderate.kicker'|trans }}</div>
    <h1>{{ 'moderate.title'|trans }}</h1>
    <div>
      <span class="role-badge">&#9876; {{ 'moderate.role_label'|trans }}</span>
      <span class="pend-count">{{ 'moderate.overview.showing'|trans({'%shown%': items|length, '%total%': matching}) }}</span>
    </div>
  </div>
</div>

<div class="wrap" id="main">
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="mod-bar">
  <form class="mod-filters" method="get" action="{{ path('moderate') }}">
    <label>{{ 'moderate.filter.country'|trans }}
      <select name="country" onchange="this.form.submit()">
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for c in countries %}<option value="{{ c }}"{{ filters.country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.region'|trans }}
      <select name="region" onchange="this.form.submit()">
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for r in regions %}<option value="{{ r }}"{{ filters.region == r ? ' selected' }}>{{ r }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.type'|trans }}
      <select name="type" onchange="this.form.submit()">
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for t in types %}<option value="{{ t }}"{{ filters.type == t ? ' selected' }}>{{ ('moderate.type.' ~ t)|trans }}</option>{% endfor %}
      </select>
    </label>
    <label class="mod-search">{{ 'moderate.filter.search'|trans }}
      <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ 'moderate.filter.search_ph'|trans }}">
    </label>
    <noscript><button type="submit" class="btn-act btn-needs-info">{{ 'moderate.filter.apply'|trans }}</button></noscript>
    <button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button>
  </form>

  {# Density switch: cards (full review context) ↔ list (one line per
     submission, for a triage pass). Rendered only when there is a queue to
     switch, and only with JS — it is a view preference, not a filter, so it
     never touches the URL or the server. The choice is remembered per browser
     because a curator picks a way of working, not a way of working *once*. #}
  {% if items is not empty %}
    <div class="q-density" id="qDensity" role="group" aria-label="{{ 'moderate.view.label'|trans }}" hidden>
      <button type="button" class="dens" data-dens="cards" aria-pressed="true">{{ 'moderate.view.cards'|trans }}</button>
      <button type="button" class="dens" data-dens="list" aria-pressed="false">{{ 'moderate.view.list'|trans }}</button>
    </div>
  {% endif %}
  </div>

  {% if items is empty %}
  <div class="empty-queue">
    <div class="ic">&#9650;</div>
    <h3>{{ 'moderate.empty.heading'|trans }}</h3>
    <p>{{ 'moderate.empty.body'|trans }}</p>
  </div>
  {% else %}
  <div class="q-list" id="qList">
    {% for item in items %}
      {% include 'moderate/_queue_item.html.twig' with {item: item} %}
    {% endfor %}
  </div>
  {% include 'moderate/_pager.html.twig' with {pager: pager, route: 'moderate', params: filters} %}
  {% endif %}

</div>

{# Density switch. Unhidden here rather than in the markup so the control only
   exists where it can work — without JS the queue stays in cards, which is the
   view that carries the full review context. #}
<script nonce="{{ csp_nonce() }}">
(function () {
  var bar = document.getElementById('qDensity');
  var list = document.getElementById('qList');
  if (!bar || !list) return;
  var KEY = 'cc-mod-density';
  function apply(mode) {
    list.classList.toggle('is-list', mode === 'list');
    bar.querySelectorAll('.dens').forEach(function (b) {
      var on = b.dataset.dens === mode;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }
  var saved = 'list';
  try { saved = localStorage.getItem(KEY) === 'list' ? 'list' : 'cards'; } catch (e) { saved = 'cards'; }
  apply(saved);
  bar.hidden = false;
  bar.addEventListener('click', function (e) {
    var b = e.target.closest('.dens');
    if (!b) return;
    apply(b.dataset.dens);
    try { localStorage.setItem(KEY, b.dataset.dens); } catch (e2) { /* private mode — the view still switched */ }
  });
})();

/* Action panels: keep the four triggers on ONE line.

   A <details> cannot do this. Its panel is a descendant of the element that
   sits in the button row, so an open panel either squeezes into a button's
   width or takes the whole row and drags its own trigger onto the next line
   (`display:contents` on <details> is not a way out — Chrome then shows the
   panel while it is CLOSED). So with JS the <details> becomes the disclosure
   it was standing in for: a real button that stays put, and its panel moved to
   a host below the card. aria-expanded/aria-controls carry what <summary> was
   carrying for free.

   Without JS the markup is untouched and every verb still works — the trigger
   just moves when it opens. That is the reason this is an enhancement and not
   the server's markup: a moderator with no JS keeps Message, Escalate, Trash.

   One panel open at a time per card, so a queue does not quietly turn into a
   column of expanded forms. */
(function () {
  document.querySelectorAll('.q-item').forEach(function (item) {
    var acts = item.querySelector('.q-acts');
    var details = Array.prototype.slice.call(item.querySelectorAll('.q-act'));
    if (!acts || !details.length) return;

    var host = document.createElement('div');
    host.className = 'q-panels';
    acts.parentNode.insertBefore(host, acts.nextSibling);

    var pairs = [];
    details.forEach(function (d, i) {
      var summary = d.querySelector('summary');
      var panel = d.querySelector('.q-act-panel');
      if (!summary || !panel) return;

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = summary.className + ' q-act-btn ' + d.className.replace('q-act', '').trim();
      btn.textContent = summary.textContent;
      btn.setAttribute('aria-expanded', 'false');
      var id = 'qp-' + (item.dataset.itemId || 'x') + '-' + i;
      panel.id = id;
      btn.setAttribute('aria-controls', id);

      panel.hidden = true;
      host.appendChild(panel);
      d.parentNode.replaceChild(btn, d);
      pairs.push({ btn: btn, panel: panel });
    });

    pairs.forEach(function (p) {
      p.btn.addEventListener('click', function () {
        var opening = p.panel.hidden;
        pairs.forEach(function (o) {
          o.panel.hidden = true;
          o.btn.setAttribute('aria-expanded', 'false');
        });
        if (opening) {
          p.panel.hidden = false;
          p.btn.setAttribute('aria-expanded', 'true');
          var first = p.panel.querySelector('textarea, input:not([type=hidden]), select');
          if (first) first.focus();
        }
      });
    });
  });
})();
</script>
{% endblock %}
