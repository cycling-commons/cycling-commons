{# The submissions desk. Page head, filter bar, record card, density switch
   and pager all come from account/_shell_styles.html.twig, the same system
   every other shell page draws, rider or curator (owner 2026-08-25). #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: nav_active|default('moderate'), mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null, mod_takedown_count: mod_takedown_count is defined ? mod_takedown_count : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.kicker'|trans }}</div>
    <h1>{{ 'moderate.title'|trans }}</h1>
  </div>

  <nav class="lfilter" aria-label="{{ 'moderate.desk_aria'|trans }}">
    <a class="lchip on" href="{{ path('moderate') }}">{{ 'moderate.desk_queue'|trans }}</a>
    <a class="lchip mod-desk-hist" href="{{ path('moderate_history') }}">{{ 'moderate.desk_history'|trans }}</a>
  </nav>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="mod-bar">
  <form class="mod-filters" method="get" action="{{ path('moderate') }}">
    <label>{{ 'moderate.filter.country'|trans }}
      <select name="country" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for c in countries %}<option value="{{ c }}"{{ filters.country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.region'|trans }}
      <select name="region" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for r in regions %}<option value="{{ r }}"{{ filters.region == r ? ' selected' }}>{{ r }}</option>{% endfor %}
      </select>
    </label>
    <label>{{ 'moderate.filter.type'|trans }}
      <select name="type" data-autosubmit>
        <option value="">{{ 'moderate.filter.all'|trans }}</option>
        {% for t in types %}<option value="{{ t }}"{{ filters.type == t ? ' selected' }}>{{ ('moderate.type.' ~ t)|trans }}</option>{% endfor %}
      </select>
    </label>
    <label class="mod-search">{{ 'moderate.filter.search'|trans }}
      <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ 'moderate.filter.search_ph'|trans }}">
    </label>
    {# ?by=<id> survives the filter form, so narrowing by country does not
       silently widen the desk back to everybody. #}
    {% if filters.by %}<input type="hidden" name="by" value="{{ filters.by }}">{% endif %}
    <noscript><button type="submit" class="btn-act btn-needs-info">{{ 'moderate.filter.apply'|trans }}</button></noscript>
    <button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button>
  </form>

  {# Density switch: cards (full review context) ↔ list (one line per
     submission, for a triage pass). Rendered only when there is a queue to
     switch, and only with JS — it is a view preference, not a filter, so it
     never touches the URL or the server. #}
  {% if items is not empty %}
    {% include 'account/_density.html.twig' %}
  {% endif %}
  </div>

  {# A queue showing one person's work has to SAY so. Without this the desk
     looks like the whole queue and a curator would reasonably conclude there
     were four things left to do (owner-linked from the applications desk). #}
  {% if filters.by %}
    <p class="mod-byuser" role="status">
      {{ 'moderate.filter.by_user'|trans }}
      <a href="{{ path('moderate', filters.country or filters.region or filters.type or filters.q
        ? {country: filters.country, region: filters.region, type: filters.type, q: filters.q}
        : {}) }}">{{ 'moderate.filter.by_user_clear'|trans }}</a>
    </p>
  {% endif %}

  {% if items is empty %}
  <div class="empty-state">
    <h3>{{ 'moderate.empty.heading'|trans }}</h3>
    <p>{{ 'moderate.empty.body'|trans }}</p>
  </div>
  {% else %}
  <div class="q-list" id="qList">
    {% for item in items %}
      {% include 'moderate/_queue_item.html.twig' with {item: item} %}
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'moderate', params: filters} %}
  {% endif %}

</div>

{% include 'moderate/_card_script.html.twig' %}
{% include 'partials/_vclip.html.twig' %}
{% endblock %}
