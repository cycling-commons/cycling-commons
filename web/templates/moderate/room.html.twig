{#
  The curator room: the in-desk board the rulebook's "ask before acting" points
  at (moderation-and-contribution.md §13).

  Plain forms first, so the strict CSP has nothing to allow and a curator
  whose scripts never loaded can still ask their question. assets/js/room.js
  turns the "about submission" box into a search over the queue; without it
  the box takes a number. The pin control is a select plus a submit button.

  The room is NOT narrowed by moderation area. That is the point of it: an item
  out of your reach is exactly what you come here to ask about (§13.6).
#}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .rm-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1.4rem}
  .rm-chip{font-family:var(--mono);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink);
    border:1px solid rgba(58,61,51,.25);border-radius:30px;padding:.32rem .7rem;text-decoration:none;background:transparent}
  .rm-chip:hover{border-color:var(--clay);color:var(--clay)}
  .rm-chip.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .rm-post{border:1px solid rgba(58,61,51,.16);border-radius:7px;padding:.9rem 1rem;margin-bottom:.7rem;background:var(--paper)}
  .rm-post.rm-pinned{border-color:var(--clay);box-shadow:inset 3px 0 0 var(--clay)}
  .rm-post.rm-direct{border-style:dashed}
  .rm-meta{display:flex;flex-wrap:wrap;align-items:baseline;gap:.45rem;margin-bottom:.45rem;
    font-family:var(--mono);font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:var(--clay)}
  .rm-who{font-weight:700;color:var(--ink);text-transform:none;letter-spacing:0;font-family:var(--serif);font-size:.9rem}
  .rm-tag{border:1px solid rgba(58,61,51,.22);border-radius:30px;padding:.1rem .45rem}
  .rm-tag-direct{border-color:var(--clay);color:var(--clay)}
  .rm-body{font-size:.95rem;line-height:1.6;color:#3a3d33;white-space:pre-wrap;margin:0 0 .5rem}
  .rm-about{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em}
  .rm-about a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
  .rm-acts{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-top:.55rem}
  .rm-acts form{display:flex;gap:.35rem;align-items:center;margin:0}
  .rm-acts select{font-family:var(--mono);font-size:.74rem;padding:.22rem .35rem;border:1px solid rgba(58,61,51,.25);border-radius:5px;background:var(--paper);color:var(--ink)}
  .rm-mini{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;padding:.28rem .6rem;
    border:1px solid rgba(58,61,51,.25);border-radius:30px;background:transparent;color:var(--ink);cursor:pointer}
  .rm-mini:hover{border-color:var(--clay);color:var(--clay)}
  .rm-compose{border:1px solid rgba(58,61,51,.22);border-radius:7px;padding:1rem;margin-top:1.8rem;background:rgba(58,61,51,.03)}
  .rm-compose h2{font-family:var(--serif);font-weight:600;font-size:1.05rem;margin-bottom:.2rem;color:var(--ink)}
  .rm-compose .rm-note{font-size:.90rem;line-height:1.5;color:#5a5d50;margin-bottom:.8rem}
  .rm-compose textarea{width:100%;min-height:6.5rem;font:inherit;font-size:.92rem;line-height:1.55;color:var(--ink);
    border:1px solid rgba(58,61,51,.28);border-radius:5px;padding:.6rem .7rem;background:var(--paper);resize:vertical}
  .rm-row{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:.7rem}
  .rm-field{display:flex;flex-direction:column;gap:.25rem}
  .rm-field label{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .rm-field select,.rm-field input{font:inherit;font-size:.85rem;padding:.35rem .45rem;border:1px solid rgba(58,61,51,.25);
    border-radius:5px;background:var(--paper);color:var(--ink)}
  .rm-send{margin-top:.9rem}
  .rm-about-wrap{position:relative}
  .rm-about-list{position:absolute;left:0;top:100%;z-index:5;margin:.2rem 0 0;padding:.2rem;list-style:none;min-width:100%;max-width:32rem;
    background:var(--paper);border:1px solid rgba(58,61,51,.3);border-radius:6px;box-shadow:0 10px 24px -8px rgba(0,0,0,.35)}
  .rm-about-list li{padding:.4rem .55rem;border-radius:4px;font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer}
  .rm-about-list li.on{background:rgba(58,61,51,.1)}
  .rm-about-list li.rm-none{color:#7a7d6c;cursor:default}
  .rm-about-pick{display:inline-flex;align-items:center;gap:.45rem;max-width:28rem;font-size:.84rem;padding:.3rem .3rem .3rem .55rem;
    border:1px solid var(--clay);border-radius:5px;background:var(--paper);color:var(--ink)}
  .rm-about-pick[hidden]{display:none}
  .rm-about-pick span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rm-about-pick button{border:0;background:none;color:var(--clay);font-size:1rem;line-height:1;cursor:pointer;padding:0 .2rem}
  .rm-field input[type=file]{font-size:.8rem;padding:.25rem 0;border:0;background:none}
  .rm-hint{font-size:.76rem;color:#7a7d6c;margin:.15rem 0 0}
  .rm-pics{margin-top:.8rem}
  .rm-drop{border:1px dashed rgba(58,61,51,.4);border-radius:7px;padding:.8rem 1rem;text-align:center;font-size:.86rem;color:#5a5d50;cursor:pointer;background:var(--paper)}
  .rm-drop:hover,.rm-drop.over{border-color:var(--clay);color:var(--clay)}
  .rm-drop:focus-visible{outline:2px solid var(--clay);outline-offset:2px}
  .rm-queue{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem}
  .rm-queue:empty{display:none}
  .rm-up{position:relative;width:132px;border:1px solid rgba(58,61,51,.2);border-radius:6px;overflow:hidden;background:var(--paper);font-size:.72rem;color:#5a5d50}
  .rm-up img{display:block;width:100%;height:90px;object-fit:cover;background:rgba(58,61,51,.08)}
  .rm-up .rm-bar{height:4px;background:rgba(58,61,51,.14)}
  .rm-up .rm-bar i{display:block;height:100%;width:0;background:var(--clay);transition:width .15s}
  .rm-up .rm-state{display:block;padding:.3rem .45rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rm-up.done .rm-state{color:#2f6b3f}
  .rm-up.failed{border-color:var(--clay)}
  .rm-up.failed .rm-state{color:var(--clay);white-space:normal}
  .rm-up .rm-x{position:absolute;top:4px;right:4px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(16,30,22,.75);color:#fff;font-size:.9rem;line-height:1;cursor:pointer}
  .rm-images{display:flex;flex-wrap:wrap;gap:.5rem;margin:.2rem 0 .5rem}
  .rm-images a{display:block;width:120px;height:90px;border-radius:5px;overflow:hidden;border:1px solid rgba(58,61,51,.2);background:rgba(58,61,51,.06)}
  .rm-images img{width:100%;height:100%;object-fit:cover;display:block}
  /* The lightbox: one picture large, prev/next when the post has more. */
  .rm-lb{position:fixed;inset:0;z-index:4000;display:flex;align-items:center;justify-content:center;background:rgba(10,14,11,.88)}
  .rm-lb[hidden]{display:none}
  .rm-lb img{max-width:calc(100vw - 8rem);max-height:calc(100vh - 6rem);border-radius:6px;box-shadow:0 24px 60px rgba(0,0,0,.6)}
  .rm-lb button{position:absolute;border:0;border-radius:50%;background:var(--paper);color:var(--ink);cursor:pointer;
    width:2.6rem;height:2.6rem;font-size:1.3rem;line-height:1;box-shadow:0 4px 14px rgba(0,0,0,.4)}
  .rm-lb button:focus-visible{outline:2px solid var(--trail);outline-offset:2px}
  .rm-lb .rm-lb-x{top:1rem;right:1rem}
  .rm-lb .rm-lb-prev{left:1rem;top:50%;transform:translateY(-50%)}
  .rm-lb .rm-lb-next{right:1rem;top:50%;transform:translateY(-50%)}
  .rm-lb button[hidden]{display:none}
  .rm-lb-n{position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;color:var(--paper)}
</style>
{% endblock %}
{% block body_scripts %}<script src="{{ asset('js/room.js') }}" defer></script>{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_room', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'room.kicker'|trans }}</div>
    <h1>{{ 'room.heading'|trans }}</h1>
  </div>

  {# The pictures' lightbox (room.js). One for the page, hidden until a thumbnail is clicked. #}
  <div class="rm-lb" id="rm-lb" role="dialog" aria-modal="true" aria-label="{{ 'room.lightbox_label'|trans }}" hidden>
    <button type="button" class="rm-lb-x" data-lb="close" aria-label="{{ 'room.lightbox_close'|trans }}">×</button>
    <button type="button" class="rm-lb-prev" data-lb="prev" aria-label="{{ 'room.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="rm-lb-next" data-lb="next" aria-label="{{ 'room.lightbox_next'|trans }}">›</button>
    <span class="rm-lb-n" aria-live="polite"></span>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <p class="sec-lead">{{ 'room.lead'|trans }}</p>

  <nav class="rm-chips" aria-label="{{ 'room.filter_label'|trans }}">
    <a class="rm-chip {{ view == 'all' ? 'on' : '' }}" href="{{ path('moderate_room') }}">{{ 'room.view.all'|trans }}</a>
    {% for cat in categories %}
      <a class="rm-chip {{ view == cat.value ? 'on' : '' }}" href="{{ path('moderate_room', {c: cat.value}) }}" title="{{ cat.hintKey|trans }}">{{ cat.labelKey|trans }}</a>
    {% endfor %}
    <a class="rm-chip {{ view == 'root' ? 'on' : '' }}" href="{{ path('moderate_room', {c: 'root'}) }}">{{ 'room.view.root'|trans }}</a>
    <a class="rm-chip {{ view == 'direct' ? 'on' : '' }}" href="{{ path('moderate_room', {c: 'direct'}) }}">{{ 'room.view.direct'|trans }}</a>
  </nav>

  {% if pinned is not empty %}
    <h2 class="sec-band">{{ 'room.pinned_heading'|trans }} <span class="sec-count">{{ pinned|length }}</span></h2>
    {% for post in pinned %}
      {% include 'moderate/_room_post.html.twig' with {post: post, view: view, pinned_block: true} %}
    {% endfor %}
  {% endif %}

  {% if posts is empty and pinned is empty %}
    <div class="empty-state">
      <h3>{{ 'room.empty_heading'|trans }}</h3>
      <p>{{ 'room.empty_body'|trans }}</p>
    </div>
  {% elseif posts is not empty %}
    <h2 class="sec-band">{{ 'room.posts_heading'|trans }} <span class="sec-count">{{ posts|length }}</span></h2>
    {% for post in posts %}
      {% include 'moderate/_room_post.html.twig' with {post: post, view: view, pinned_block: false} %}
    {% endfor %}
  {% endif %}

  <form class="rm-compose" method="post" action="{{ path('moderate_room_post') }}" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token('moderate-room-post') }}">
    <input type="hidden" name="c" value="{{ view }}">
    <h2>{{ 'room.compose.heading'|trans }}</h2>
    <p class="rm-note">{{ 'room.compose.note'|trans }}</p>
    <textarea id="rm-body" name="body" aria-label="{{ 'room.compose.body_label'|trans }}" maxlength="{{ body_max }}" required placeholder="{{ 'room.compose.placeholder'|trans }}">{{ draft }}</textarea>
    <div class="rm-row">
      <div class="rm-field">
        <label for="rm-cat">{{ 'room.compose.category_label'|trans }}</label>
        <select id="rm-cat" name="category">
          <option value="">{{ 'room.compose.category_none'|trans }}</option>
          {% for cat in categories %}
            <option value="{{ cat.value }}" {{ view == cat.value ? 'selected' : '' }}>{{ cat.labelKey|trans }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="rm-field">
        <label for="rm-to">{{ 'room.compose.to_label'|trans }}</label>
        <select id="rm-to" name="to">
          <option value="">{{ 'room.compose.to_everyone'|trans }}</option>
          {% for c in curators %}
            <option value="{{ c.id }}">{{ c.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="rm-field rm-about-wrap">
        <label for="rm-about-q">{{ 'room.compose.about_label'|trans }}</label>
        {# The search box. room.js fills the hidden id from a pick; with no
           script a number typed here is read as the id. #}
        <input id="rm-about-q" name="about_q" type="text" autocomplete="off" placeholder="{{ 'room.compose.about_placeholder'|trans }}"
               data-search-url="{{ path('moderate_room_submissions') }}"
               data-none="{{ 'room.compose.about_none'|trans }}" data-clear="{{ 'room.compose.about_clear'|trans }}">
        <input id="rm-about" name="about" type="hidden" value="">
        <div id="rm-about-pick" class="rm-about-pick" hidden></div>
        <ul id="rm-about-list" class="rm-about-list" role="listbox" hidden></ul>
      </div>
    </div>
    {# Pictures. room.js turns this into a drop zone that uploads at once, with
       the bytes' own progress; the ids land in #rm-images. Without the script
       the file input posts with the form and the server renders the files. #}
    <div class="rm-field rm-pics" id="rm-pics" data-upload-url="{{ path('moderate_room_upload') }}" data-remove-url="{{ path('moderate_room_upload_remove', {id: 0}) }}"
         data-token="{{ csrf_token('moderate-room-upload') }}" data-max="{{ images_max }}" data-max-bytes="{{ image_bytes_max }}"
         data-t-too-many="{{ 'room.error.too_many_images'|trans }}" data-t-too-big="{{ 'support.bug.error.shot_too_large'|trans }}"
         data-t-failed="{{ 'room.error.upload_failed'|trans }}" data-t-remove="{{ 'room.compose.remove_image'|trans }}" data-t-checking="{{ 'room.compose.checking'|trans }}">
      <label for="rm-image">{{ 'room.compose.images_label'|trans }}</label>
      <div class="rm-drop" id="rm-drop" role="button" tabindex="0" aria-controls="rm-image" hidden>{{ 'room.compose.drop'|trans }}</div>
      <input id="rm-image" name="image[]" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple>
      <input id="rm-images" name="images" type="hidden" value="">
      <div class="rm-queue" id="rm-queue"></div>
      <p class="rm-hint">{{ 'room.compose.images_hint'|trans({'%n%': images_max, '%mb%': (image_bytes_max / 1048576)|round}) }}</p>
    </div>
    <button class="btn-act rm-send" type="submit">{{ 'room.compose.send'|trans }}</button>
  </form>
</div>
{% endblock %}
