{#
  The curator room: the in-desk board the rulebook's "ask before acting" points
  at (moderation-and-contribution.md §13).

  Plain forms first, so the strict CSP has nothing to allow and a curator
  whose scripts never loaded can still ask their question. assets/js/room.js
  turns the "about submission" box into a search over the queue; without it
  the box takes a number. The pin control is a select plus a submit button.

  The room is NOT narrowed by moderation area. That is the point of it: an item
  out of your reach is exactly what you come here to ask about (§13.6).
#}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{% include 'moderate/_room_styles.html.twig' %}
{% endblock %}
{% block body_scripts %}<script src="{{ asset('js/room.js') }}" defer></script>{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_room', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'room.kicker'|trans }}</div>
    <h1>{{ 'room.heading'|trans }}</h1>
  </div>

  {# The pictures' lightbox (room.js). One for the page, hidden until a thumbnail is clicked. #}
  <div class="rm-lb" id="rm-lb" role="dialog" aria-modal="true" aria-label="{{ 'room.lightbox_label'|trans }}" hidden>
    <button type="button" class="rm-lb-x" data-lb="close" aria-label="{{ 'room.lightbox_close'|trans }}">×</button>
    <button type="button" class="rm-lb-prev" data-lb="prev" aria-label="{{ 'room.lightbox_prev'|trans }}">‹</button>
    <img src="" alt="">
    <button type="button" class="rm-lb-next" data-lb="next" aria-label="{{ 'room.lightbox_next'|trans }}">›</button>
    <span class="rm-lb-n" aria-live="polite"></span>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <p class="sec-lead">{{ 'room.lead'|trans }}</p>
  {# Writing happens on its own page; the board only lists (owner 2026-09-19). #}
  <p><a class="btn-act" href="{{ path('moderate_room_new', view == 'all' ? {} : {c: view}) }}">{{ 'room.compose.heading'|trans }}</a></p>

  <nav class="rm-chips" aria-label="{{ 'room.filter_label'|trans }}">
    <a class="rm-chip {{ view == 'all' ? 'on' : '' }}" href="{{ path('moderate_room') }}">{{ 'room.view.all'|trans }}</a>
    {% for cat in categories %}
      <a class="rm-chip {{ view == cat.value ? 'on' : '' }}" href="{{ path('moderate_room', {c: cat.value}) }}" title="{{ cat.hintKey|trans }}">{{ cat.labelKey|trans }}</a>
    {% endfor %}
    <a class="rm-chip {{ view == 'root' ? 'on' : '' }}" href="{{ path('moderate_room', {c: 'root'}) }}">{{ 'room.view.root'|trans }}</a>
    <a class="rm-chip {{ view == 'direct' ? 'on' : '' }}" href="{{ path('moderate_room', {c: 'direct'}) }}">{{ 'room.view.direct'|trans }}</a>
  </nav>

  {% if pinned is not empty %}
    <h2 class="sec-band">{{ 'room.pinned_heading'|trans }} <span class="sec-count">{{ pinned|length }}</span></h2>
    {% for post in pinned %}
      {% include 'moderate/_room_post.html.twig' with {post: post, view: view, pinned_block: true} %}
    {% endfor %}
  {% endif %}

  {% if posts is empty and pinned is empty %}
    <div class="empty-state">
      <h3>{{ 'room.empty_heading'|trans }}</h3>
      <p>{{ 'room.empty_body'|trans }}</p>
    </div>
  {% elseif posts is not empty %}
    <h2 class="sec-band">{{ 'room.posts_heading'|trans }} <span class="sec-count">{{ posts|length }}</span></h2>
    {% for post in posts %}
      {% include 'moderate/_room_post.html.twig' with {post: post, view: view, pinned_block: false} %}
    {% endfor %}
  {% endif %}

</div>
{% endblock %}
