{#
  A town card's text, one box per language this deployment serves
  (docs/specs/map-and-search.md §6.5; the languages from cc_languages()).
  Text stored in a language it does not serve stays stored, unseen here.

  What a reader sees on the map is fetched from Wikipedia the first time
  anybody opens the town. A curator who knows better writes over it here.
  Saving a language makes it local: the fetch never touches that row again,
  and the card says our curators wrote it. Riders reach this page through the
  card's report link, the one door every content type uses.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/town.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }}</div>
    <h1>{{ title ?? ref }}</h1>
    <p class="lede">{{ 'moderate.town.lede'|trans }}</p>
    <p class="townref">{{ ref }}</p>
  </div>

  {% for label, messages in app.flashes %}
    {% for m in messages %}<p class="flash {{ label }}">{{ m|trans }}</p>{% endfor %}
  {% endfor %}

  {% for lang, lang_name in langs %}
    {% set row = rows[lang]|default(null) %}
    <section class="langblock">
      <div class="langhead">
        <h2>{{ lang_name }}</h2>
        {% if row and row.edited %}<span class="tag local">{{ 'moderate.town.local'|trans }}</span>
        {% elseif row and row.answered and row.extract %}<span class="tag">{{ 'moderate.town.fetched'|trans({'%lang%': row.page_lang|default(lang)}) }}</span>
        {% else %}<span class="tag">{{ 'moderate.town.none'|trans }}</span>{% endif %}
      </div>
      {% if row and row.extract and not row.edited %}
        <div class="fetched">{{ row.extract }}{% if row.page_url %} <a href="{{ row.page_url }}" target="_blank" rel="noopener">Wikipedia ↗</a>{% endif %}</div>
      {% endif %}
      <form method="post" class="townform" action="{{ path('moderate_town_save', {osmType: osm_type, osmId: osm_id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
        <input type="hidden" name="lang" value="{{ lang }}">
        {% if not title %}
          <label for="title-{{ lang }}">{{ 'moderate.town.field_title'|trans }}</label>
          <input type="text" id="title-{{ lang }}" name="title" maxlength="240" value="{{ row.title|default('') }}">
        {% endif %}
        <label for="text-{{ lang }}">{{ 'moderate.town.field_text'|trans }}</label>
        <textarea id="text-{{ lang }}" name="text" maxlength="{{ text_max }}" required>{{ row.extract|default('') }}</textarea>
        <p class="hint">{{ 'moderate.town.hint'|trans({'%max%': text_max}) }}</p>
        {# The licence question, only where there is an article to credit
           (moderation-and-contribution.md §3.1b); the server checks it again. #}
        {% if row and row.page_url %}
          <label class="derived"><input type="checkbox" name="derived" value="1"{{ row.derived ? ' checked' }}> <span>{{ 'place_text.field_derived'|trans }}</span></label>
        {% endif %}
        <button type="submit">{{ 'moderate.town.save'|trans }}</button>
      </form>
    </section>
  {% endfor %}
</div>
{% endblock %}
