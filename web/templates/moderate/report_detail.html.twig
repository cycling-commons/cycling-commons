{#
  One report, and the decision a curator records about it
  (docs/specs/content-reports.md §9).

  What this page deliberately does NOT have: a delete button, a hide button, or
  anything that edits the reported content. Following `one-way-to-moderate`, the
  curator goes to the surface that already moderates that thing, does the work
  there, and comes back here to record what happened. A second delete path would
  be a second history and a second set of permissions.

  A photo is the exception: the decision carries through to the file, and the
  photo can be escalated here, the same verb as on the takedowns desk
  (photo-uploads.md §6d). A photo under legal hold shows as held, and the page
  then has no way left to decide the report.

  Three careful things:

  * The reason is escaped, in a pre-wrap block. A stranger typed it and it must
    never become markup.
  * "Tell the author" is a checkbox, not automatic. Only the curator knows
    whether the person we found is really whose words were restricted, and the
    Article 17 statement is not a message you can unsend.
  * The other open reports about the same thing are listed. Ten reports about
    one route is a different fact from one report.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/report_detail.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_reports'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_moderation'|trans }} · <a href="{{ path('moderate_reports') }}">{{ 'report.desk.title'|trans }}</a></div>
    <h1>{{ resolved.label ?? report.targetType.label|trans ~ ' #' ~ report.targetId }}</h1>
    <p class="lede mono">{{ report.id }}</p>
  </div>

  <div class="bdet">
    <dl class="facts">
      <dt>{{ 'report.desk.field_target'|trans }}</dt>
      <dd>
        {{ report.targetType.label|trans }} · <span class="mono">{{ report.targetId }}</span>
        {%- if not resolved.exists %} · {{ 'report.desk.target_gone'|trans }}{% endif -%}
        {%- if resolved.link_route %} <a class="open-target" href="{{ path(resolved.link_route, resolved.link_params) }}">{{ 'report.desk.open_target'|trans }} ↗</a>{% endif -%}
      </dd>
      {% if report.fromPath and not resolved.link_route %}
        {# Where the reporter was standing: shown only when the thing itself
           has no link of its own (owner 2026-09-08). #}
        <dt>{{ 'report.desk.field_from'|trans }}</dt>
        <dd><a href="{{ report.fromPath }}">{{ report.fromPath }}</a></dd>
      {% endif %}
      <dt>{{ 'report.desk.field_ground'|trans }}</dt>
      <dd>{{ report.ground.label|trans }}{% if report.ground.isLegal %} · {{ 'report.desk.legal_claim'|trans }}{% endif %}</dd>
      {% if not report.ground.isRule and report.ruleGround.isRule %}
        <dt>{{ 'report.desk.field_rule'|trans }}</dt>
        <dd>{{ report.ruleGround.label|trans }}</dd>
      {% endif %}
      <dt>{{ 'support.inbox.status_label'|trans }}</dt>
      <dd>{{ report.status.label|trans }}</dd>
      {% if held %}
        <dt>{{ 'report.desk.held_label'|trans }}</dt>
        <dd class="held">{{ 'report.desk.held_since'|trans({'%when%': held_since ? held_since|cc_datetime : ''}) }}
          {# DSA Art. 18 (operations.md §7): the fact and the date only; which
             authority and its reference stay on the admin's page. #}
          {% if held_notified_at %}<br>{{ 'art18.desk_notified'|trans({'%when%': held_notified_at|cc_datetime}) }}{% endif %}</dd>
      {% endif %}
      <dt>{{ 'support.inbox.received'|trans }}</dt>
      <dd>{{ report.createdAt|cc_datetime }}</dd>
      {% if report.ground.needsOwnershipProof %}
        {# A rights claim carries two things no other ground does. The claimant
           name is shown here AND to the author, unlike the reporter address,
           which is shown to nobody. #}
        <dt>{{ 'report.answer.field_claimant'|trans }}</dt>
        <dd>{{ report.claimantName ?: ('report.desk.no_author'|trans) }}</dd>
        <dt>{{ 'report.answer.field_work'|trans }}</dt>
        <dd>{{ report.workOriginal }}</dd>
      {% endif %}
      {% if report.hasCounterNotice %}
        <dt>{{ 'report.desk.field_counter'|trans }}</dt>
        <dd>{{ report.counterNotice|nl2br }}</dd>
      {% endif %}
      {# Only when somebody wrote it. A place has contributors, not an author,
         and "nobody in particular" told the curator nothing (owner 2026-09-08). #}
      {% if resolved.author %}
        <dt>{{ 'report.desk.field_author'|trans }}</dt>
        <dd>{% include 'moderate/_rider_name.html.twig' with {rider: author_rider} only %}</dd>
      {% endif %}
      {% if report.decidedAt %}
        <dt>{{ 'report.desk.field_decided'|trans }}</dt>
        <dd>{{ report.decidedAt|cc_datetime }}{% if decided_by %} · {% include 'moderate/_rider_name.html.twig' with {rider: decided_by} only %}{% endif %}</dd>
        <dt>{{ 'report.desk.field_author_told'|trans }}</dt>
        <dd>{{ report.isAuthorTold ? ('report.desk.told_yes'|trans) : ('report.desk.told_no'|trans) }}</dd>
      {% endif %}
    </dl>

    <p class="bsec">{{ 'report.desk.field_reason'|trans }}</p>
    <div class="btext">{{ report.reason }}</div>

    {% if report.decisionNote %}
      <p class="bsec">{{ 'report.desk.field_note'|trans }}</p>
      <div class="btext">{{ report.decisionNote }}</div>
    {% endif %}

    {% if siblings|length %}
      <p class="bsec">{{ 'report.desk.siblings'|trans({'%count%': siblings|length}) }}</p>
      {% for s in siblings %}
        <div class="sib">
          <a href="{{ path('moderate_reports_detail', {id: s.id}) }}">{{ s.ground.label|trans }}</a> · {{ s.status.label|trans }}
          <div class="sibmeta">{{ s.createdAt|cc_datetime }}</div>
        </div>
      {% endfor %}
    {% endif %}

    {% set status_errors = app.flashes('report_status') %}
    {% if held %}
      {# Held: an administrator decides (/admin/escalated). No form, so there
         is nothing here a curator could press by mistake. #}
      {% for msg in status_errors %}
        <p class="ferr" id="d-status-error" role="alert">{{ msg|trans }}</p>
      {% endfor %}
    {% else %}
    <form class="decide" method="post" action="{{ path('moderate_reports_decide', {id: report.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('report-desk-decide') }}">

      <p class="warn">{{ 'report.desk.act_elsewhere'|trans }}</p>
      {% if report.hasCounterNotice %}
        {# The answer reopened the report, and the author was promised the
           decision (content-reports.md §7). #}
        <p class="warn">{{ 'report.desk.counter_reopened'|trans }}</p>
      {% endif %}

      <label for="d-status">{{ 'support.inbox.set_status'|trans }}</label>
      <select id="d-status" name="status"{{ status_errors ? ' aria-describedby="d-status-error"' : '' }}>
        {# Every state, the current one selected: a fresh report reads Open
           (owner 2026-09-08). Closed is left out while a takedown waits on
           the photo (content-reports.md §9). #}
        {% for st in statuses %}
          <option value="{{ st.value }}"{{ st == report.status ? ' selected' : '' }}>{{ st.label|trans }}</option>
        {% endfor %}
      </select>
      {% for msg in status_errors %}
        <p class="ferr" id="d-status-error" role="alert">{{ msg|trans }}</p>
      {% endfor %}

      {# A "Something else" report names no rule. To uphold it the curator
         names the rule it breaks, and the author is told that rule (DSA
         Article 17; content-reports.md §4). #}
      {% if not report.ground.isRule %}
        <label for="d-rule">{{ 'report.desk.field_rule'|trans }}</label>
        <select id="d-rule" name="rule" aria-describedby="d-rule-help">
          <option value="">{{ 'report.desk.rule_none'|trans }}</option>
          {% for g in rules %}
            <option value="{{ g.value }}"{{ report.ruleGround == g ? ' selected' }}>{{ g.label|trans }}</option>
          {% endfor %}
        </select>
        <p class="warn" id="d-rule-help">{{ 'report.desk.rule_help'|trans }}</p>
      {% endif %}

      <label for="d-note">{{ 'report.desk.field_note'|trans }} <span class="req" aria-hidden="true">*</span></label>
      <textarea id="d-note" name="note" maxlength="2000" rows="10"
                placeholder="{{ 'report.desk.note_placeholder'|trans }}">{{ report.decisionNote }}</textarea>

      {# Upheld sends the author a statement of reasons with this note, every
         time there is an author (docs/specs/content-reports.md §7). #}
      {% if resolved.author and not report.isAuthorTold %}
        <p class="warn">{{ 'dsa_statement.desk.report_author_told'|trans({'%name%': author_rider.name}) }}</p>
      {% endif %}

      <p class="dact"><button type="submit" class="btn btn-p">{{ 'support.inbox.save'|trans }}</button></p>
    </form>
    {% endif %}

    {% if can_escalate %}
      {# Its own form and folded away, so it can never be a mis-click on the
         decision, as on the takedowns and submission desks
         (photo-uploads.md §6d). The tick is checked by the server too. #}
      {% set escalate_errors = app.flashes('report_escalate') %}
      <details class="escalate-panel"{{ escalate_errors ? ' open' : '' }}>
        <summary>{{ 'report.desk.escalate_summary'|trans }}</summary>
        <form class="escalate" method="post" action="{{ path('moderate_reports_escalate', {id: report.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('report-desk-escalate') }}">
          <p class="warn">{{ 'report.desk.escalate_help'|trans }}</p>
          {% for msg in escalate_errors %}
            <p class="ferr" role="alert">{{ msg|trans }}</p>
          {% endfor %}
          <label for="e-reason">{{ 'moderate.escalate.reason_placeholder'|trans }} <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="e-reason" name="reason" maxlength="2000" required>
          <div class="check">
            <input type="checkbox" id="e-confirm" name="confirm" value="1" required>
            <label for="e-confirm">{{ 'moderate.escalate.confirm_check'|trans }}</label>
          </div>
          <p class="dact"><button type="submit" class="btn btn-alarm">{{ 'moderate.escalate.submit'|trans }}</button></p>
        </form>
      </details>
    {% endif %}
  </div>
</div>
{% endblock %}
