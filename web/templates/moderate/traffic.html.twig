{#
  Declared beside measured traffic (traffic-measurements.md §4.6).

  One row per road-surface item that names an OSM way and says how busy it is,
  when that way has measured traffic that passed the disclosure rules. The
  number is cars per kilometre ridden, for the busier direction; the groups
  are the one active scheme's.
#}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate/traffic.css') }}">
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_traffic'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate.traffic.kicker'|trans }}</div>
    <h1>{{ 'moderate.traffic.heading'|trans }}</h1>
    <p class="lead">{{ 'moderate.traffic.lead'|trans }}</p>
  </div>

  {# Progress from the first ride (traffic-measurements.md section 4.6). #}
  <section class="tprog" aria-labelledby="tprog-h">
    <h2 id="tprog-h">{{ 'moderate.traffic.progress_h'|trans }}</h2>
    <p class="note">{{ 'moderate.traffic.progress_lead'|trans }}</p>
    {% if progress.countries is empty %}
      <p class="note">{{ 'moderate.traffic.progress_empty'|trans }}</p>
    {% else %}
      {% include 'moderate/_traffic_progress.html.twig' with {progress: progress, flags: flags, kind: 'progress'} only %}
    {% endif %}
    {% if progress.unplaced > 0 %}
      <p class="note">{{ 'moderate.traffic.unplaced'|trans({'%n%': progress.unplaced}) }}</p>
    {% endif %}
  </section>

  {# Felt safety, marked by hand on the map (traffic-measurements.md section
     10): roads with marks, counted like the measured ones. #}
  <section class="tprog" aria-labelledby="tfelt-h">
    <h2 id="tfelt-h">{{ 'moderate.traffic.felt_h'|trans }}</h2>
    <p class="note">{{ 'moderate.traffic.felt_lead'|trans }}</p>
    {% if felt_progress.countries is empty %}
      <p class="note">{{ 'moderate.traffic.felt_empty'|trans }}</p>
    {% else %}
      {% include 'moderate/_traffic_progress.html.twig' with {progress: felt_progress, flags: flags, kind: 'felt'} only %}
    {% endif %}
    {% if felt_progress.unplaced > 0 %}
      <p class="note">{{ 'moderate.traffic.felt_unplaced'|trans({'%n%': felt_progress.unplaced}) }}</p>
    {% endif %}
    {# Both counts above are built together, on one cadence. #}
    <p class="note">{{ 'moderate.traffic.built'|trans }} <time datetime="{{ built_at|date('c') }}" data-built-at="{{ built_at|date('c') }}">{{ built_at|cc_datetime }}</time>. {{ 'moderate.traffic.refresh'|trans }}</p>
  </section>

  <h2>{{ 'moderate.traffic.compare_h'|trans }}</h2>

  {% if rows is empty %}
    <div class="empty-state"><p>{{ 'moderate.traffic.empty'|trans }}</p></div>
  {% else %}
    <div class="tcmp-wrap">
      <table class="tcmp">
        <thead>
          <tr>
            <th scope="col">{{ 'moderate.traffic.col_road'|trans }}</th>
            <th scope="col">{{ 'moderate.traffic.col_declared'|trans }}</th>
            {% for g in groups %}<th scope="col">{{ ('moderate.traffic.group.' ~ g|replace({'|': '_'}))|trans }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for r in rows %}
            <tr data-way="{{ r.way }}">
              <td><a href="{{ path('map') }}?item={{ r.id }}" target="_blank" rel="noopener">{{ r.name }}</a></td>
              {% set declared_key = {'Quiet': 'map.traffic_quiet', 'Moderate': 'map.traffic_moderate', 'Busy': 'map.traffic_busy', 'Car-free': 'map.traffic_free'}[r.declared] ?? null %}
              <td>{{ declared_key ? declared_key|trans : r.declared }}</td>
              {% for g in groups %}
                {% set m = r.measured[g] ?? null %}
                <td data-group="{{ g }}">{{ m is null ? '' : (m.nearby ? 'moderate.traffic.level_nearby' : 'moderate.traffic.level')|trans({'%band%': ('moderate.traffic.band_' ~ m.band)|trans}) }}</td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
