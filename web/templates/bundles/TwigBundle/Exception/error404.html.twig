{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/bundles/TwigBundle/Exception/error404.css') }}">
{% endblock %}
{% block body %}
<section class="lost">
  <svg viewBox="0 0 100 130" aria-hidden="true"><path d="M50 8 C31 8 16 23 16 42 C16 68 50 124 50 124 C50 124 84 68 84 42 C84 23 69 8 50 8 Z M76 42 A26 26 0 1 0 24 42 A26 26 0 1 0 76 42 Z" fill="currentColor" fill-rule="evenodd"/><line x1="50" y1="36.5" x2="50" y2="20.5" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><line x1="54.76" y1="39.25" x2="68.62" y2="31.25" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><line x1="54.76" y1="44.75" x2="68.62" y2="52.75" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><line x1="50" y1="47.5" x2="50" y2="63.5" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><line x1="45.24" y1="44.75" x2="31.38" y2="52.75" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><line x1="45.24" y1="39.25" x2="31.38" y2="31.25" stroke="#FF5A1F" stroke-width="3.2" stroke-linecap="round"/><circle cx="50" cy="42" r="4" fill="currentColor"/></svg>
  <span class="code">{% trans %}error404.code{% endtrans %}</span>
  <h1>{% trans %}error404.heading_pre{% endtrans %} <em>{% trans %}error404.heading_em{% endtrans %}</em>{% trans %}error404.heading_post{% endtrans %}</h1>
  <p>{% trans %}error404.body{% endtrans %}</p>
  <div class="row">
    <a class="btn btn-p" href="{{ path('map') }}">{% trans %}error404.cta_map{% endtrans %}</a>
    <a class="btn btn-g" href="{{ path('home') }}">{% trans %}error404.cta_home{% endtrans %}</a>
  </div>
</section>
{% endblock %}
