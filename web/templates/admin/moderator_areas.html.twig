{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{{ 'admin.areas.title'|trans }} — {{ target.displayName }}{% endblock %}

{% block main %}
  {% set assignedRegions = assigned|filter(a => a.regionId is not null)|map(a => a.regionId) %}
  {% set assignedCountries = assigned|filter(a => a.countryCode is not null)|map(a => a.countryCode) %}
  <p>{{ 'admin.areas.help'|trans }}</p>
  <form method="post">
    <input type="hidden" name="token" value="{{ csrf_token(constant('App\\Controller\\Admin\\UserCrudController::CSRF_TOKEN_ID')) }}">
    <div class="row">
      <div class="col-md-6">
        <label class="form-label" for="areas-regions">{{ 'admin.areas.regions'|trans }}</label>
        <select class="form-select" id="areas-regions" name="regions[]" multiple size="10">
          {% for r in regions %}
            <option value="{{ r.id }}" {{ r.id in assignedRegions ? 'selected' }}>{{ r.name }} ({{ r.countryCode ?: '—' }})</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="areas-countries">{{ 'admin.areas.countries'|trans }}</label>
        <select class="form-select" id="areas-countries" name="countries[]" multiple size="10">
          {% for c in countries %}
            <option value="{{ c.iso2 }}" {{ c.iso2 in assignedCountries ? 'selected' }}>{{ c.name }} ({{ c.iso2 }})</option>
          {% endfor %}
        </select>
      </div>
    </div>
    <p class="mt-2 text-muted">{{ 'admin.areas.empty_note'|trans }}</p>
    <button type="submit" class="btn btn-primary mt-2">{{ 'admin.areas.save'|trans }}</button>
  </form>
{% endblock %}
