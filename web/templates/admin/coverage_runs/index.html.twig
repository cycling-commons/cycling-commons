{#
   Every coverage batch, newest first. Answers the morning-after questions the
   journal and the healthchecks ping cannot: did it run, how long, how many
   regions, what did it publish (coverage-runs-admin.md §2).
#}
{% extends '@EasyAdmin/page/content.html.twig' %}
{% import 'admin/coverage_runs/_format.html.twig' as fmt %}

{% block content_title %}{{ 'admin.menu.coverage_runs'|trans }}{% endblock %}

{% block main %}
  {% set statuses = ['running', 'ok', 'partial', 'failed', 'abandoned'] %}
  {% set families = ['points', 'routes', 'surface'] %}
  <div class="col-lg-10">
    <p class="text-muted">{{ 'admin.coverage_runs.lead'|trans }}</p>

    {% if runs is empty %}
      <p class="text-muted">{{ 'admin.coverage_runs.empty'|trans }}</p>
    {% else %}
      <table class="table">
        <thead>
          <tr>
            <th>{{ 'admin.col_id'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_started'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_family'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_trigger'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_status'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_regions'|trans }}</th>
            <th class="text-end">{{ 'admin.coverage_runs.col_took'|trans }}</th>
            <th>{{ 'admin.coverage_runs.col_rebuilt'|trans }}</th>
          </tr>
        </thead>
        <tbody>
          {% for run in runs %}
            <tr data-run="{{ run.id }}">
              <td>{{ run.id }}</td>
              <td>
                <a href="{{ path('admin_coverage_run', {id: run.id}) }}">
                  {{ run.started_at|cc_datetime }}
                </a>
              </td>
              <td data-family="{{ run.family }}">
                {%- for f in run.families -%}
                  {{ loop.first ? '' : ' · ' }}{{ f.family in families ? ('admin.coverage_runs.family.' ~ f.family)|trans : f.family }}
                {%- endfor -%}
              </td>
              <td>{{ run.trigger }}</td>
              {# an unknown status (a pipeline the app has not caught up with) still reads #}
              <td>{{ run.status in statuses ? ('admin.coverage_runs.status.' ~ run.status)|trans : run.status }}</td>
              <td>
                {%- if run.regions_loaded is not null -%}
                  {{ 'admin.coverage_runs.regions_of'|trans({'%loaded%': run.regions_loaded, '%requested%': run.regions_requested}) }}
                {%- else -%}
                  {{ run.regions_requested }}
                {%- endif -%}
              </td>
              <td class="text-end">{{ fmt.duration(run.seconds) }}</td>
              <td>
                {# A night holds points, routes and surface; a manual run one family. #}
                {% for f in run.families %}
                  <div data-rebuilt-family="{{ f.family }}">
                    {%- if run.families|length > 1 -%}
                      <span class="text-muted">{{ f.family in families ? ('admin.coverage_runs.family.' ~ f.family)|trans : f.family }}</span>
                    {% endif -%}
                    {%- if f.rebuilt -%}
                      {{ f.rebuilt }}
                    {%- elseif f.status == 'ok' -%}
                      <span class="text-muted">{{ 'admin.coverage_runs.nothing_changed'|trans }}</span>
                    {%- elseif f.status == 'failed' -%}
                      {{ 'admin.coverage_runs.status.failed'|trans }}
                    {%- endif -%}
                  </div>
                {% endfor %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>
{% endblock %}
