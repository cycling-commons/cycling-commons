{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block main %}
    <p>{{ 'admin.settings.intro'|trans }}</p>
    <p>{{ 'admin.settings.infra_note'|trans }}</p>

    {# One form for everything: Save submits every field, each "reset" button
       submits its own key. The reset branch runs before validation, so a row
       can always be put back to its default even when a sibling field is
       currently holding an unacceptable number. #}
    <form method="post">
        <input type="hidden" name="token" value="{{ csrf_token(constant('App\\Controller\\Admin\\DashboardController::SETTINGS_CSRF_TOKEN_ID')) }}">

        {% for group, defs in grouped %}
            <div class="card mb-4">
                <div class="card-header">{{ ('admin.settings.group.' ~ group)|trans }}</div>
                <div class="card-body">
                    {% for def in defs %}
                        {% set fieldId = 'setting-' ~ def.key|replace({'.': '-'}) %}
                        {% set invalid = errors[def.key] is defined %}
                        <div class="row align-items-start mb-3 pb-3 border-bottom">
                            <div class="col-md-7">
                                <label class="form-label mb-0" for="{{ fieldId }}">{{ def.labelKey|trans }}</label>
                                <div class="small">{{ def.helpKey|trans }}</div>
                                <div class="text-muted small"><code>{{ def.key }}</code></div>
                            </div>
                            <div class="col-md-5">
                                <div class="input-group">
                                    {# Two input types, matching the two setting types
                                       (SettingDefinition): a spinner for a threshold, a plain
                                       text box for a list of addresses. #}
                                    {% if def.isString %}
                                        <input type="text"
                                               class="form-control{{ invalid ? ' is-invalid' }}"
                                               id="{{ fieldId }}"
                                               name="settings[{{ def.key }}]"
                                               value="{{ values[def.key] }}"
                                               maxlength="{{ def.maxLength }}"
                                               {{ def.allowsEmpty ? '' : 'required' }}>
                                    {% else %}
                                        <input type="number"
                                               class="form-control{{ invalid ? ' is-invalid' }}"
                                               id="{{ fieldId }}"
                                               name="settings[{{ def.key }}]"
                                               value="{{ values[def.key] }}"
                                               min="{{ def.min }}"
                                               max="{{ def.max }}"
                                               step="1"
                                               required>
                                    {% endif %}
                                    {# Disabled rather than hidden: the row keeps its shape whether or
                                       not the key is overridden, so the column does not jump about. #}
                                    {# formnovalidate is what makes the promise above true. The
                                       server's reset branch runs before validation, but every input
                                       here is `required`, so without this the BROWSER refuses to
                                       submit while any field is empty — and the row a curator is
                                       trying to put back is usually the empty one. #}
                                    <button type="submit" name="reset" value="{{ def.key }}" formnovalidate
                                            class="btn btn-outline-secondary"
                                            {{ overridden[def.key] ? '' : 'disabled' }}>
                                        {{ 'admin.settings.reset'|trans }}
                                    </button>
                                </div>
                                {% if invalid %}
                                    <div class="invalid-feedback d-block">{{ errors[def.key] }}</div>
                                {% endif %}
                                <div class="form-text">
                                    {{ 'admin.settings.default_note'|trans({'%value%': def.default}) }}
                                    &middot;
                                    {{ 'admin.settings.range_note'|trans({'%min%': def.min, '%max%': def.max}) }}
                                    {% if overridden[def.key] %}
                                        <span class="badge bg-warning text-dark ms-1">{{ 'admin.settings.overridden'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

        <button type="submit" class="btn btn-primary">{{ 'admin.settings.save'|trans }}</button>
    </form>
{% endblock %}
