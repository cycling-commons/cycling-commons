{# Two-factor enrolment: scan the QR (or type the secret), confirm with a code, then store backup codes. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/security/2fa_setup.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'settings'} %}{% endblock %}

{% block body %}
<div class="setup-wrap">

  {% if setup_complete %}
    <a class="crumb" href="{{ path('settings', {tab: 'security'}) }}">{{ 'settings.heading'|trans }} · {{ 'settings.tab_security'|trans }}</a>
    <p class="step-no">{{ 'twofactor.setup.complete_kicker'|trans }}</p>
    <h1>{{ 'twofactor.setup.complete_h1'|trans }}</h1>
    <p class="lead">
      {{ 'twofactor.setup.complete_lead'|trans }}
    </p>

    <ul class="codes">
      {% for code in backup_codes %}
        <li>{{ code }}</li>
      {% endfor %}
    </ul>

    <p class="warn">
      {{ 'twofactor.setup.complete_warn'|trans }}
    </p>

    <a class="done-link" href="{{ path('settings', {tab: 'security'}) }}">{{ 'twofactor.setup.done'|trans }}</a>

  {% else %}
    <a class="crumb" href="{{ path('settings', {tab: 'security'}) }}">{{ 'twofactor.setup.back'|trans }}</a>
    <h1>{{ 'twofactor.setup.h1'|trans }}</h1>
    <p class="lead">
      {{ 'twofactor.setup.lead'|trans }}
    </p>

    <div class="step">
      <p class="step-no">{{ 'twofactor.setup.step1_no'|trans }}</p>
      <h2>{{ 'twofactor.setup.step1_h2'|trans }}</h2>
      <img class="qr" src="{{ qr_code_uri }}" alt="{{ 'twofactor.setup.qr_alt'|trans }}" width="220" height="220" />
      <p class="lead" style="margin-top:1rem">{{ 'twofactor.setup.manual_label'|trans }}</p>
      <code class="secret">{{ manual_secret }}</code>
    </div>

    <div class="step">
      <p class="step-no">{{ 'twofactor.setup.step2_no'|trans }}</p>
      <h2>{{ 'twofactor.setup.step2_h2'|trans }}</h2>

      {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
      {% include 'partials/_form_errors.html.twig' with {form: form} %}
        {# Replacing a second factor, or doing it from a remember-me session,
           first proves this is the account's owner (TwoFactorController). #}
        {% if form.currentPassword is defined or form.currentCode is defined %}
          <p class="lead">{{ (replacing ? 'twofactor.setup.replace_lead' : 'twofactor.setup.password_lead')|trans }}</p>
        {% endif %}
        {% for name in ['currentPassword', 'currentCode'] %}
          {% if attribute(form, name) is defined %}
            {% set field = attribute(form, name) %}
            <div class="field">
              {{ form_label(field) }}
              {{ form_widget(field) }}
              {% if not field.vars.valid %}
                <div class="alert-error" role="alert">
                  {% for error in field.vars.errors %}{{ error.message|trans }}{% endfor %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        <div class="field">
          {% if form.currentPassword is defined or form.currentCode is defined %}{{ form_label(form.code) }}{% endif %}
          {{ form_widget(form.code) }}
          {% if not form.code.vars.valid %}
            <div class="alert-error" role="alert">
              {% for error in form.code.vars.errors %}{{ error.message|trans }}{% endfor %}
            </div>
          {% endif %}
        </div>
        <button type="submit" class="btn-submit">{{ 'twofactor.setup.submit'|trans }}</button>
      {{ form_end(form) }}
    </div>
  {% endif %}

</div>
{% endblock %}
