{# Two-factor enrolment when the provider is switched off for the environment.

   `when@dev` disables TOTP for local convenience (config/packages/scheb_2fa.yaml)
   and with it the TotpAuthenticatorInterface service. The setup controller used
   to REQUIRE that service, so the page the enforcer sends elevated users to
   answered with a 500 - and a newly approved curator was locked out of every
   page on the dev stack (owner-reported 2026-08-14). This says what is actually
   true instead. Prod and staging never reach it: `when@dev` cannot leak. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .setup-wrap{max-width:560px;margin:0 auto;padding:2.4rem 1.4rem 4rem}
  .setup-wrap h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.06;letter-spacing:-.02em;color:var(--ink)}
  .setup-wrap .lead{margin-top:.8rem;color:#5a5d4d;line-height:1.55}
  .note{margin-top:1.4rem;font-size:.9rem;color:#5a5d4d;line-height:1.55;border-left:3px solid var(--glacier);padding-left:.9rem}
</style>
{% endblock %}

{% block body %}
<div class="setup-wrap">
  <h1>{{ 'twofactor.unavailable_h'|trans }}</h1>
  <p class="lead">{{ 'twofactor.unavailable_lead'|trans }}</p>
  <p class="note">{{ 'twofactor.unavailable_note'|trans }}</p>
</div>
{% endblock %}
