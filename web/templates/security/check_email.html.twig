{# Post-registration "check your email" confirmation page. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'security.check_email'} %}

  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.check_email.heading'|trans }}</p>

      {% include 'security/_check_inbox_icon.html.twig' %}

      <p>{{ 'security.check_email.body'|trans }}</p>
      {# The display-name hint for a visitor without JavaScript (account-and-auth.md §9). #}
      {% if name_in_use is defined %}
        {# Only a name in use says anything (owner 2026-10-03). #}
        {% if name_in_use %}<p class="name-hint" data-name-hint data-state="shared">{{ 'form.display_name_shared'|trans }}</p>{% endif %}
      {% endif %}
      <p style="margin-top:1rem;font-size:.9rem;color:#5a5d4d">
        {{ 'security.check_email.no_email'|trans({'%url%': path('verify_resend')})|rich }}
      </p>

      <p class="auth-alt-link">
        {{ 'security.check_email.already_verified'|trans }}
        <a href="{{ path('login') }}">{{ 'security.check_email.sign_in_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}
