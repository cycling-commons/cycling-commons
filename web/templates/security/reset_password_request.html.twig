{# Password reset request page — mirrors the two-panel auth layout used by login/register. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
<style>
  .auth{display:grid;grid-template-columns:1fr 1fr;min-height:calc(100svh - var(--nav-h,64px))}
  .panel{position:relative;overflow:hidden;color:var(--paper);display:flex;flex-direction:column;justify-content:space-between;padding:2.4rem;
    background:radial-gradient(120% 90% at 70% 20%,#27513a,var(--spruce) 45%,#0f1f16 85%,var(--ink))}
  .panel svg{position:absolute;inset:0;width:100%;height:100%;opacity:.4}
  .panel svg path{fill:none;stroke:var(--ochre);stroke-width:1.1;opacity:.5}
  .panel svg path:nth-child(even){stroke:var(--glacier);opacity:.3}
  .panel .top,.panel .mid,.panel .bot{position:relative;z-index:2}
  .panel .mid h1{font-family:var(--serif);font-weight:500;font-size:clamp(2rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.02em;max-width:14ch}
  .panel .mid p{margin-top:1rem;max-width:32ch;color:rgba(239,230,212,.85)}
  .panel .bot{font-family:var(--mono);font-size:.64rem;letter-spacing:.14em;color:rgba(239,230,212,.6);text-transform:uppercase}
  .formwrap{display:flex;align-items:center;justify-content:center;padding:2.4rem}
  .card{width:100%;max-width:380px}
  .auth-heading{font-family:var(--mono);font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:2rem;color:var(--ink)}
  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  .field input[type=email]{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none}
  .field input:focus{border-color:var(--trail)}
  .btn-submit{width:100%;background:var(--trail);color:var(--ink);font-family:var(--sans);font-weight:700;font-size:.88rem;padding:.6rem;border:none;border-radius:5px;cursor:pointer;transition:background .2s}
  .btn-submit:hover{background:#ff703d}
  .reassure{margin-top:1.6rem;font-size:.82rem;color:#5a5d4d;line-height:1.5;border-left:2px solid var(--glacier);padding-left:.8rem}
  .auth-alt-link{display:block;margin-top:1.4rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d;text-align:center}
  .auth-alt-link a{color:var(--clay)}
  .alert-error{background:rgba(181,83,46,.1);border-left:3px solid var(--clay);color:var(--clay);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .field-errors,.card form ul{list-style:none;padding:0;margin:.5rem 0 .2rem}
  .field-errors li,.card form ul li{display:flex;gap:.45rem;align-items:flex-start;font-size:.8rem;color:var(--clay);line-height:1.4;padding:.45rem .65rem;margin-top:.35rem;background:rgba(181,83,46,.09);border:1px solid rgba(181,83,46,.28);border-radius:5px}
  .field-errors li::before,.card form ul li::before{content:"\26A0";flex:none;font-size:.9em;line-height:1.4}
  input.is-invalid{border-bottom-color:var(--clay)}
  @media(max-width:780px){.auth{grid-template-columns:1fr}.panel{min-height:32svh;padding:1.6rem}}
</style>
{% endblock %}

{% block body %}
<div class="auth">

  {# ── Left decorative panel ── #}
  <div class="panel" aria-hidden="true">
    <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice">
      <path d="M-20,640 C160,580 260,680 420,620 C560,570 640,640 820,600"/>
      <path d="M-20,540 C150,490 280,580 440,520 C600,470 660,540 820,500"/>
      <path d="M-20,440 C160,400 260,470 420,420 C560,380 660,440 820,400"/>
      <path d="M-20,330 C150,300 280,370 440,320 C600,280 660,330 820,300"/>
      <path d="M-20,220 C160,190 260,250 420,210 C560,180 660,220 820,190"/>
    </svg>
    <div class="mid">
      <h1>{{ 'security.reset_request.panel_h1'|trans }}</h1>
      <p>{{ 'security.reset_request.panel_p'|trans }}</p>
    </div>
    <div class="bot">{{ 'security.reset_request.panel_bot'|trans }}</div>
  </div>

  {# ── Right form panel ── #}
  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.reset_request.heading'|trans }}</p>

      {% for flash in app.flashes('reset_password_error') %}
        <div class="alert-error" role="alert">{{ flash|trans }}</div>
      {% endfor %}

      {{ form_start(requestForm, {attr: {novalidate: 'novalidate', class: 'cc-validate'}}) }}

        <div class="field">
          {{ form_label(requestForm.email) }}
          {{ form_widget(requestForm.email) }}
          {{ form_errors(requestForm.email) }}
        </div>

        <button type="submit" class="btn-submit">{{ 'security.reset_request.submit'|trans }}</button>

      {{ form_end(requestForm) }}

      <p class="reassure">
        {{ 'security.reset_request.reassure'|trans }}
      </p>

      <p class="auth-alt-link">
        {{ 'security.reset_request.remember_password'|trans }}
        <a href="{{ path('login') }}">{{ 'security.reset_request.sign_in_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('js/auth-validate.js') }}" defer></script>
{% endblock %}
