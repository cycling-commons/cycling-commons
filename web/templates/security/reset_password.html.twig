{# Set new password page — mirrors the two-panel auth layout used by login/register. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'security.reset_password'} %}

  {# ── Right form panel ── #}
  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.reset_password.heading'|trans }}</p>

      {% for flash in app.flashes('reset_password_error') %}
        <div class="alert-error" role="alert">{{ flash|trans }}</div>
      {% endfor %}

      {{ form_start(resetForm, {attr: {novalidate: 'novalidate', class: 'cc-validate'}}) }}
      {% include 'partials/_form_errors.html.twig' with {form: resetForm} %}

        <div class="field">
          {{ form_label(resetForm.plainPassword.first) }}
          {{ form_widget(resetForm.plainPassword.first) }}
          {{ form_errors(resetForm.plainPassword.first) }}
        </div>

        <div class="field">
          {{ form_label(resetForm.plainPassword.second) }}
          {{ form_widget(resetForm.plainPassword.second) }}
          {{ form_errors(resetForm.plainPassword) }}
        </div>

        <button type="submit" class="btn-submit">{{ 'security.reset_password.submit'|trans }}</button>

      {{ form_end(resetForm) }}

      <p class="auth-alt-link">
        {{ 'security.reset_password.remember_password'|trans }}
        <a href="{{ path('login') }}">{{ 'security.reset_password.sign_in_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}

{% block body_scripts %}
{% include 'partials/_auth_i18n.html.twig' %}
<script src="{{ asset('js/password-toggle.js') }}" defer></script>
<script src="{{ asset('js/auth-validate.js') }}" defer></script>
{% endblock %}
