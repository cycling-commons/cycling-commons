{# Login page — ported from atlas/demo/login.html, Symfony form fields. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/security/login.css') }}">
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'security.login'} %}

  {# ── Right form panel ── #}
  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.login.heading'|trans }}</p>

      {% for msg in app.flashes('success') %}
        <div class="alert-success" role="status">{{ msg|trans }}</div>
      {% endfor %}

      {% if error %}
        {% if error.messageKey == constant('App\\Security\\VerifiedEmailChecker::UNVERIFIED') %}
          <div class="alert-error" role="alert">
            {{ 'security.login.error_unverified'|trans }}
            <a href="{{ path('verify_resend') }}">{{ 'security.login.resend_link'|trans }}</a>
          </div>
        {% elseif error.messageKey == constant('App\\Security\\SuspensionChecker::SUSPENDED') %}
          {# docs/specs/account-and-auth.md §6.8: until when, and where the reasons went. #}
          <div class="alert-error" role="alert">{{ error.messageKey|trans(error.messageData) }}</div>
        {% else %}
          <div class="alert-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
      {% endif %}

      <form method="post" action="{{ path('login') }}" class="cc-validate" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
        {# Where to go after signing in, carried in the link instead of a
           session so a visitor who never signs in keeps none. #}
        {% if target_path %}<input type="hidden" name="_target_path" value="{{ target_path }}" />{% endif %}

        <div class="field">
          <label for="username">{{ 'security.login.label_email'|trans }}</label>
          <input type="email" id="username" name="_username"
                 value="{{ last_username }}"
                 autocomplete="email"
                 placeholder="{{ 'form.ph_email'|trans }}"
                 required />
        </div>

        <div class="field">
          <label for="password">{{ 'security.login.label_password'|trans }}</label>
          <input type="password" id="password" name="_password"
                 autocomplete="current-password"
                 placeholder="••••••••"
                 required />
        </div>

        <div class="row-between">
          <label style="display:flex;gap:.4rem;align-items:center;font-size:.90rem">
            <input type="checkbox" name="_remember_me" style="width:auto" aria-describedby="remember-hint" />
            {{ 'security.login.remember_me'|trans }}
          </label>
          <a href="{{ path('reset_password_request') }}">{{ 'security.login.forgot'|trans }}</a>
        </div>
        <p class="remember-hint" id="remember-hint">{{ 'security.login.remember_hint'|trans }}</p>

        <button type="submit" class="btn-submit">{{ 'security.login.submit'|trans }}</button>
      </form>

      <p class="auth-alt-link">
        {{ 'security.login.no_account'|trans }}
        <a href="{{ path('register') }}">{{ 'security.login.create_account_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}

{% block body_scripts %}
{% include 'partials/_auth_i18n.html.twig' %}
<script src="{{ asset('js/password-toggle.js') }}" defer></script>
<script src="{{ asset('js/auth-validate.js') }}" defer></script>
{% endblock %}
