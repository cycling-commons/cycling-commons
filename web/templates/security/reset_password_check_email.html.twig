{# Post-reset-request "check your email" confirmation page. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'security.check_email_reset'} %}

  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.check_email_reset.heading'|trans }}</p>

      {% include 'security/_check_inbox_icon.html.twig' %}

      <p>
        {{ 'security.check_email_reset.body'|trans({'%hours%': resetToken.expiresAtIntervalInstance.h}) }}
      </p>
      <p style="margin-top:1rem;font-size:.9rem;color:#5a5d4d">
        {{ 'security.check_email_reset.no_email'|trans({'%url%': path('reset_password_request')})|rich }}
      </p>

      <p class="auth-alt-link">
        {{ 'security.check_email_reset.remember_password'|trans }}
        <a href="{{ path('login') }}">{{ 'security.check_email_reset.sign_in_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}
