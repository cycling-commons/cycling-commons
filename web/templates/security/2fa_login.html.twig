{# scheb/2fa interstitial — prompts for a TOTP code (or a backup code) after primary login. #}
{# Variables (authenticationError, authCodeParameterName, checkPathRoute/Url, csrf*, logoutPath, #}
{#  availableTwoFactorProviders, twoFactorProvider, displayTrustedOption) are supplied by scheb. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
<style>
  /* the code input reads as a code: mono, large, spaced digits */
  .field input[type=text]{font-family:var(--mono);font-size:1.3rem;letter-spacing:.3em}
</style>
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'twofactor.login'} %}

  {# ── Right form panel ── #}
  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'twofactor.login.heading'|trans }}</p>

      {% if authenticationError %}
        <div class="alert-error" role="alert">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
      {% endif %}

      <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" novalidate>
        <div class="field">
          <label for="_auth_code">{{ 'twofactor.login.label_code'|trans }}</label>
          <input
            id="_auth_code"
            type="text"
            name="{{ authCodeParameterName }}"
            autocomplete="one-time-code"
            inputmode="numeric"
            autofocus
          />
        </div>

        {% if displayTrustedOption %}
          <label style="display:flex;gap:.4rem;align-items:center;font-size:.90rem;margin-bottom:1.2rem">
            <input type="checkbox" name="{{ trustedParameterName }}" style="width:auto" />
            {{ 'twofactor.login.trust_device'|trans }}
          </label>
        {% endif %}

        {% if isCsrfProtectionEnabled %}
          <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <button type="submit" class="btn-submit">{{ 'twofactor.login.submit'|trans }}</button>
      </form>

      <p class="reassure">
        {{ 'twofactor.login.reassure'|trans|rich }}
      </p>

      <p class="auth-alt-link">
        <a href="{{ logoutPath }}">{{ 'twofactor.login.cancel'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}
