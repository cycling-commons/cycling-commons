{# Digital-inbox glyph for the "check your email" pages: a message dropping
   into an open tray. Stroke-drawn so it inherits the shell's ink colour;
   the incoming arrow takes the trail accent. #}
<div class="check-icon" aria-hidden="true">
  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 2.5v7.7" stroke="var(--trail)"/>
    <path d="m8.8 7 3.2 3.2L15.2 7" stroke="var(--trail)"/>
    <path d="M3.5 13.5v5.2a1.8 1.8 0 0 0 1.8 1.8h13.4a1.8 1.8 0 0 0 1.8-1.8v-5.2"/>
    <path d="M3.5 15h5l1.6 2.4h3.8L15.5 15h5"/>
  </svg>
</div>
