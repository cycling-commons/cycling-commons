{# Registration page — mirrors the login page's two-panel auth layout. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'security/_auth_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/security/register.css') }}">
{% endblock %}

{% block body %}
<div class="auth">

  {% include 'security/_auth_shell_panel.html.twig' with {prefix: 'security.register'} %}

  {# ── Right form panel ── #}
  <div class="formwrap">
    <div class="card">
      <p class="auth-heading">{{ 'security.register.heading'|trans }}</p>

      {% for flash in app.flashes('verify_email_error') %}
        <div class="alert-error" role="alert">{{ flash|trans }}</div>
      {% endfor %}

      {{ form_start(registrationForm, {attr: {
        novalidate: 'novalidate',
        id: 'cc-guarded-form',
        'data-challenge-url': path('form_challenge'),
        'data-pow-difficulty': pow_difficulty,
      }}) }}
      {% include 'partials/_form_errors.html.twig' with {form: registrationForm} %}
      {% include 'security/_guard_fields.html.twig' %}

        <div class="field">
          {{ form_label(registrationForm.email) }}
          {{ form_widget(registrationForm.email) }}
          {{ form_errors(registrationForm.email) }}
        </div>

        <div class="field">
          {{ form_label(registrationForm.displayName) }}
          {{ form_widget(registrationForm.displayName) }}
          {{ form_errors(registrationForm.displayName) }}
        </div>

        <div class="field">
          {{ form_label(registrationForm.plainPassword.first) }}
          {{ form_widget(registrationForm.plainPassword.first) }}
          {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div class="field">
          {{ form_label(registrationForm.plainPassword.second) }}
          {{ form_widget(registrationForm.plainPassword.second) }}
          {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="field-check">
          {{ form_widget(registrationForm.confirmAge) }}
          <label for="{{ registrationForm.confirmAge.vars.id }}">
            {{ 'security.register.confirm_age'|trans }}
          </label>
        </div>
        {{ form_errors(registrationForm.confirmAge) }}

        <div class="field-check">
          {{ form_widget(registrationForm.agreeTerms) }}
          <label for="{{ registrationForm.agreeTerms.vars.id }}">
            {{ 'security.register.agree_terms'|trans({'%url%': path('terms')})|rich }}
          </label>
        </div>
        {{ form_errors(registrationForm.agreeTerms) }}

        {% include 'security/_guard_status.html.twig' %}

        <button type="submit" class="btn-submit">{{ 'security.register.submit'|trans }}</button>

      {{ form_end(registrationForm) }}

      <p class="auth-alt-link">
        {{ 'security.register.already_account'|trans }}
        <a href="{{ path('login') }}">{{ 'security.register.sign_in_link'|trans }}</a>
      </p>
    </div>
  </div>

</div>
{% endblock %}

{% block body_scripts %}
{% include 'partials/_auth_i18n.html.twig' %}
{# Register-only validation strings, on top of the shared auth set. #}
<script nonce="{{ csp_nonce() }}">Object.assign(window.CC_I18N, {{ {
  err_name_required: 'js.err_name_required'|trans, err_name_min: 'js.err_name_min'|trans,
  err_terms: 'js.err_terms'|trans
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }});</script>
<script src="{{ asset('js/password-toggle.js') }}" defer></script>
{# Validation first: form-challenge.js leaves a submit alone once it is prevented. #}
<script src="{{ asset('js/register-validate.js') }}" defer></script>
<script src="{{ asset('support/form-challenge.js') }}" defer></script>
{% endblock %}
