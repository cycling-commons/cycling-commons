{# Messages dashboard (moderation-feedback spec M3) — decision outcomes,
   curator notes, and rider replies, newest first.
   The controller marks everything read AFTER fetching the list, so this
   render still sees which rows were new (`msg-new`) via `m.isRead`.

   The list is a THREAD, not an inbox: it carries what was sent to this
   account and what this account sent itself (MessageService::listFor). A
   rider's reply is addressed to the deciding curator, so a received-only
   list showed them the question and never their own answer — which read as
   though the reply had gone nowhere. Sent rows are marked, carry no reply
   form, and are never "new". #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .wrap{max-width:820px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2rem)}

  /* Shelf chips: the same pill vocabulary as the map rail's filters, so a
     rider who has used one recognises the other. The count is part of the
     chip, not a tooltip — "Notices 0" is the answer, and a click to find it
     out is a click wasted. */
  .msg-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 1.6rem}
  .msg-chip{display:inline-flex;align-items:center;gap:.4rem;min-height:32px;padding:.4rem .85rem;
            border:1px solid rgba(20,22,14,.2);border-radius:30px;background:var(--paper);
            font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;
            color:#595c4d;text-decoration:none}
  .msg-chip b{font-family:var(--sans);font-size:.78rem;font-weight:700;color:var(--ink);letter-spacing:0}
  .msg-chip:hover{border-color:var(--clay);color:var(--ink)}
  .msg-chip.is-on{background:var(--spruce);border-color:var(--spruce);color:var(--paper)}
  .msg-chip.is-on b{color:var(--paper)}
  .msg-chip--unread{margin-left:auto}
  .msg-chip--unread.is-on{background:var(--clay);border-color:var(--clay)}
  @media(max-width:520px){.msg-chip--unread{margin-left:0}}
  .msg-list{list-style:none;padding:0;margin:0}
  .msg-row{padding:1.1rem 1.2rem;margin-bottom:.9rem;border:1px solid rgba(20,22,14,.14);border-radius:8px;background:var(--paper-deep)}
  .msg-row.msg-new{border-color:var(--trail);box-shadow:0 0 0 1px var(--trail);border-left-width:4px;background:var(--paper)}
  .msg-row.msg-new .msg-kind{font-weight:800}
  .msg-state{display:inline-flex;align-items:center;margin-right:.4rem;vertical-align:-2px}
  .msg-state.is-unread{color:var(--trail)}
  .msg-state.is-read{color:#8c8f7d}
  .msg-state svg{display:block}
  {# The state name, for a screen reader; sighted readers get the icon and the row styling. #}
  .msg-state .vh{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  /* Sent by this account: the other half of the conversation, set back so the
     thread reads as an exchange rather than a second inbox. */
  .msg-row.msg-mine{background:var(--paper);border-style:dashed}
  .msg-from-you{color:#595c4d}
  /* Arriving from a submission row's "see the conversation" link. */
  .msg-row:target{border-color:var(--ochre);box-shadow:0 0 0 2px var(--ochre);scroll-margin-top:1.5rem}
  .msg-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:.4rem}
  .msg-kind{font-family:var(--sans);font-weight:700;font-size:.98rem}
  .msg-meta{font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;white-space:nowrap}
  .msg-ref{font-family:var(--mono);font-size:.68rem;color:#595c4d;margin-bottom:.5rem}
  .msg-body{font-size:.9rem;line-height:1.55;color:var(--ink)}
  .msg-photo{margin:.4rem 0}
  .msg-photo img{width:120px;height:90px;object-fit:cover;border-radius:5px;display:block}
  .msg-map-link{display:inline-block;margin-top:.45rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .msg-map-link:hover{color:var(--trail)}
  .msg-note{font-size:.88rem;line-height:1.55;color:#4a4d40;background:var(--paper);border-left:2px solid var(--glacier);padding:.6rem .85rem;border-radius:0 5px 5px 0;margin-top:.55rem}
  .msg-subject{color:var(--clay);text-decoration:underline;text-underline-offset:2px}
  .msg-subject:hover{color:var(--trail)}
  /* The reader's own answer, inside the card holding the question. */
  .msg-answer{border-left-color:var(--ochre)}
  .msg-answer-h{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:block}
  .msg-answer .msg-meta{display:block;margin-top:.3rem}
  .msg-from-curator{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay);margin-top:.5rem}
  /* What the contribution changed — the same was/now shape the curator's desk
     and the contributions list use, so all three read as one thing. */
  .msg-diff{margin-top:.6rem;padding:.5rem .7rem;background:rgba(20,22,14,.05);border-radius:5px;font-size:.84rem;line-height:1.5}
  .msg-diff-h{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:block;margin-bottom:.25rem}
  .msg-diff dl{display:grid;grid-template-columns:auto 1fr;gap:.15rem .7rem;margin:0}
  .msg-diff dt{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;align-self:baseline;padding-top:.15rem}
  .msg-diff dd{margin:0;min-width:0;overflow-wrap:anywhere}
  .msg-diff .was{color:#8a8d7d;text-decoration:line-through;margin-right:.4rem}
  .msg-diff .now{color:var(--trail)}
  @media(max-width:520px){.msg-diff dl{grid-template-columns:1fr;gap:0}.msg-diff dt{padding-top:.35rem}}

  .msg-reply{margin-top:.8rem;padding-top:.7rem;border-top:1px solid rgba(20,22,14,.1);display:flex;flex-direction:column;gap:.45rem}
  .msg-reply label{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d}
  .msg-reply textarea{width:100%;min-height:80px;font-family:var(--sans);font-size:.85rem;padding:.5rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}
  .msg-reply button{align-self:flex-start}

  .acct-id{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'messages'} %}{% endblock %}

{% block body %}
<h1 class="acct-id">{{ 'messages.title'|trans }} — {{ cc_user.displayName }}</h1>
<div class="wrap dmin">

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# ── Shelves (moderation-and-contribution.md §7.9) ──
     Plain links, not a form: each shelf is a place the reader can bookmark and
     come back to, and the browser's back button then means what they expect.
     Only shown once there is more than one message — a filter over a list of
     one is furniture, and the counts are what make the chips worth reading
     ("Notices 0" saves a click that "Notices" does not). #}
  {% if counts.total > 1 %}
    <nav class="msg-filters" aria-label="{{ 'messages.filter.label'|trans }}">
      <a class="msg-chip {{ filter_category is null ? 'is-on' }}"
         href="{{ path('messages', filter_unread ? {unread: 1} : {}) }}">
        {{ 'messages.filter.all'|trans }} <b>{{ counts.total }}</b>
      </a>
      {% for c in categories %}
        <a class="msg-chip {{ filter_category == c.value ? 'is-on' }}"
           href="{{ path('messages', {cat: c.value}|merge(filter_unread ? {unread: 1} : {})) }}">
          {{ c.labelKey|trans }} <b>{{ counts.byCategory[c.value] }}</b>
        </a>
      {% endfor %}
      {# Unread is a switch across whichever shelf is open, not a fourth shelf:
         "unread notices" is a real thing to want. #}
      <a class="msg-chip msg-chip--unread {{ filter_unread ? 'is-on' }}"
         href="{{ path('messages', (filter_category ? {cat: filter_category} : {})|merge(filter_unread ? {} : {unread: 1})) }}"
         aria-pressed="{{ filter_unread ? 'true' : 'false' }}">
        {{ 'messages.filter.unread'|trans }} <b>{{ counts.unread }}</b>
      </a>
    </nav>
  {% endif %}

  {% if messages is empty %}
    <div class="empty-state">
      {# A filter that hid everything is not an empty inbox, and saying so
         spares the reader wondering where their mail went. #}
      {% if filter_category or filter_unread %}
        <p>{{ 'messages.filter.no_match'|trans }}</p>
        <p><a href="{{ path('messages') }}">{{ 'messages.filter.clear'|trans }}</a></p>
      {% else %}
        <p>{{ 'messages.empty'|trans }}</p>
      {% endif %}
    </div>
  {% else %}
    <ul class="msg-list">
      {% for m in messages %}
        {% set mine = m.senderId is not null and m.senderId == cc_user.id %}
        <li class="msg-row {{ mine ? 'msg-mine' : (m.isRead ? '' : 'msg-new') }}" id="msg-{{ m.id }}">
          <div class="msg-head">
            <span class="msg-kind">
              {#- A message you sent was never unread to you, so it carries no
                 state marker at all — only received rows do. Unread is a filled
                 dot with a single tick; read is the double tick. The state is
                 also in the row's own styling, so the icon is a confirmation
                 rather than the only signal, and the label is what a screen
                 reader gets. -#}
              {%- if not mine %}
                {% set unread = not m.isRead %}
                <span class="msg-state {{ unread ? 'is-unread' : 'is-read' }}" title="{{ (unread ? 'messages.state_unread' : 'messages.state_read')|trans }}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 12.5 8 17.5 16 6.5"/>
                    {% if not unread %}<polyline points="12 17 13 18 21 7"/>{% endif %}
                  </svg>
                  <span class="vh">{{ (unread ? 'messages.state_unread' : 'messages.state_read')|trans }}</span>
                </span>
              {% endif -%}
              {{ mine ? 'messages.kind_you'|trans : ('messages.kind_' ~ m.kind.value)|trans }}
            </span>
            <time class="msg-meta" datetime="{{ m.createdAt|date('c') }}">{{ m.createdAt|cc_datetime }}</time>
          </div>
          {% set is_question = m.kind.value == 'submission_needs_info' %}
          {# NOT `answers` — assigning to the loop variable would clobber the
             whole map on the first row, and every later card would find its
             answer missing. #}
          {% set my_answers = answers[m.id] ?? [] %}
          {# The subject, as a link back to the contribution it is about. A
             reference like SUB-8 says nothing about which place this was. #}
          <div class="msg-ref">
            {{ m.refLabel }}
            {% if m.channel == 'submission' and m.bodyParams['%title%'] is defined %}
              · <a class="msg-subject" href="{{ path('profile') }}#sub-{{ m.refId }}">{{ m.bodyParams['%title%'] }}</a>
            {% endif %}
          </div>
          <div class="msg-body">
            {% if m.mediaId and message_photos[m.mediaId|trim] is defined %}
              {# The photo this message is about (docs/specs/photo-uploads.md §5b). #}
              <figure class="msg-photo">
                <img src="{{ message_photos[m.mediaId|trim] }}" alt="{{ 'messages.photo_alt'|trans }}" loading="lazy" width="120" height="90">
              </figure>
            {% endif %}
            {# The lead ("a curator needs more information about X … you can
               reply below") is scaffolding around a question. Once the question
               itself is here — and certainly once it has been answered — it
               says nothing the card does not, so it only stands in for a
               question that is missing (rows from before the note was
               required). #}
            {% if m.bodyKey and not (is_question and m.bodyText) %}{{ m.bodyKey|trans(m.bodyParams ?? {}) }}{% endif %}
            {% if m.bodyText %}<p class="msg-note">{{ m.bodyText }}</p>{% endif %}
            {# WHAT the contribution was. "Your contribution X was approved"
               names a place and stops, and a rider with two edits to the same
               climb cannot tell which one this is about (owner-reported
               2026-08-03). Only on the reader's OWN submissions — the
               controller scopes the lookup by user id. Not shown on a
               needs-info card: there the curator's question is the point, and
               the diff would push it below the fold. #}
            {% set diff = (m.channel == 'submission' and not is_question) ? (submission_changes[m.refId] ?? []) : [] %}
            {% if diff is not empty %}
              <div class="msg-diff">
                <span class="msg-diff-h">{{ 'messages.what_you_changed'|trans }}</span>
                <dl>
                  {% for row in diff %}
                    <dt>{{ row.label }}</dt>
                    {# Long values (a drawn segment's geometry) clamp to one
                       line, click to expand — partials/_vclip.html.twig. #}
                    {% set mlong = (row.now ~ (row.was ?? ''))|length > 110 %}
                    <dd{% if mlong %} class="vclip" tabindex="0" role="button" aria-expanded="false"{% endif %}>
                      {%- if row.was is not null %}<span class="was">{{ row.was }}</span>{% endif -%}
                      <span class="now">{{ row.now }}</span>
                    </dd>
                  {% endfor %}
                </dl>
              </div>
            {% endif %}
            {# The answer belongs under the question it answers, in the same
               card — not as a separate row above it. #}
            {% for a in my_answers %}
              <p class="msg-note msg-answer">
                <span class="msg-answer-h">{{ 'account.you_replied'|trans }}</span>
                {{ a.bodyText }}
                <time class="msg-meta" datetime="{{ a.createdAt|date('c') }}">{{ a.createdAt|cc_datetime }}</time>
              </p>
            {% endfor %}
            {# link to the item — only for kinds whose subject is publicly on the
               map (approved submission by name; live route by id) #}
            {% if m.kind.value == 'submission_approved' %}
              <a class="msg-map-link" href="{{ path('map') }}?feature={{ m.refLabel|url_encode }}">{{ 'messages.view_on_map'|trans }} ↗</a>
            {% elseif m.kind.value in ['route_approved', 'correction_done'] %}
              <a class="msg-map-link" href="{{ path('map') }}?route={{ m.refId }}">{{ 'messages.view_on_map'|trans }} ↗</a>
            {% endif %}
          </div>
          {% if m.sender == 'curator' and not mine %}
            <div class="msg-from-curator">{{ 'messages.from_curator'|trans }}</div>
          {% endif %}
          {% if mine %}
            <div class="msg-from-curator msg-from-you">{{ 'messages.you_sent'|trans }}</div>
          {% endif %}
          {% if not mine and is_question and my_answers is empty and m.refId in replyable_submission_ids %}
            <form class="msg-reply" method="post" action="{{ path('messages_reply', {id: m.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('message-reply') }}">
              <label for="msg-reply-{{ m.id }}">{{ 'messages.reply_label'|trans }}</label>
              <textarea id="msg-reply-{{ m.id }}" name="body" maxlength="2000" required></textarea>
              <button type="submit" class="btn-act">{{ 'messages.reply_send'|trans }}</button>
            </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% include 'partials/_pager.html.twig' with {pager: pager, route: 'messages', params: pager_params} %}
  {% endif %}

</div>
{% include 'partials/_vclip.html.twig' %}
{% endblock %}
