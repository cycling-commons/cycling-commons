{#
  The vote and follow buttons of one roadmap row, an item or an open
  proposal (docs/specs/roadmap-and-changelog.md §8.4). A signed-in rider gets
  a plain form that roadmap/marks.js posts in the background; a visitor gets
  the count and a sign-in link, and no form token, so the page stays in the
  public cache.

  item     a RoadmapItems row
  back     the page address the sign-in link returns to
  csrf_id  the form token id
#}
<div class="rmarks">
  {% if app.user %}
    <form method="post" action="{{ path('roadmap_mark') }}" class="rmark-form" data-roadmap-mark>
      <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
      <input type="hidden" name="ref" value="{{ item.ref }}">
      <button type="submit" name="do" value="vote" class="rvote" data-aria="{{ 'roadmap.vote_aria'|trans({'%count%': '%count%'}) }}" aria-pressed="{{ item.voted ? 'true' : 'false' }}"
              data-title-on="{{ 'roadmap.unvote_title'|trans }}" data-title-off="{{ 'roadmap.vote_title'|trans }}"
              title="{{ (item.voted ? 'roadmap.unvote_title' : 'roadmap.vote_title')|trans }}"
              aria-label="{{ 'roadmap.vote_aria'|trans({'%count%': item.votes}) }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
        <span class="rcount">{{ item.votes }}</span>
      </button>
      <button type="submit" name="do" value="follow" class="rfollow" aria-pressed="{{ item.followed ? 'true' : 'false' }}"
              data-on="{{ 'roadmap.following'|trans }}" data-off="{{ 'roadmap.follow'|trans }}"
              data-title-on="{{ 'roadmap.unfollow_title'|trans }}" data-title-off="{{ 'roadmap.follow_title'|trans }}"
              title="{{ (item.followed ? 'roadmap.unfollow_title' : 'roadmap.follow_title')|trans }}"
              aria-label="{{ 'roadmap.follow'|trans }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        <span class="rfollow-l">{{ (item.followed ? 'roadmap.following' : 'roadmap.follow')|trans }}</span>
      </button>
    </form>
  {% else %}
    <a class="rvote" href="{{ path('login', {_target_path: back ~ '#' ~ item.anchor}) }}" title="{{ 'roadmap.signin_to_vote'|trans }}" aria-label="{{ 'roadmap.signin_to_vote'|trans }}, {{ 'roadmap.votes_count'|trans({'%count%': item.votes}) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
      <span class="rcount">{{ item.votes }}</span>
    </a>
  {% endif %}
</div>
