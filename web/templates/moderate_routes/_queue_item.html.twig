{#
  Partial: one pending route proposal row in the Routes moderation queue.

  Parameters:
    item  array    — queue item from RouteQueue::pending()
    form  FormView — RouteDecisionType for this item
#}
<div class="q-item" data-item-id="{{ item.id }}">
  <div class="q-meta">
    <span class="q-tag q-tag--new">{{ item.km }} km</span>
    <span class="q-when">{{ item.when }}</span>
  </div>
  <h3 class="q-title">{{ item.name }}</h3>
  <div class="q-submitter">
    {{ item.who }} &middot; {{ item.region ?? 'moderate_routes.region_none'|trans }}
    &middot;
    <span data-region-cap>{{ 'moderate_routes.region_cap'|trans({'%active%': item.activeInRegion, '%cap%': item.cap}) }}</span>
    {% if item.activeInRegion >= item.cap %}
      <span class="q-tag q-tag--hazard">{{ 'moderate_routes.error.region_full'|trans }}</span>
    {% endif %}
    &middot;
    <a class="q-view" href="{{ path('moderate_routes_detail', {id: item.id}) }}">{{ 'moderate_routes.action.view'|trans }}</a>
  </div>

  <div class="q-actions">
    {{ form_start(form, {method: 'POST', attr: {class: 'q-act-form'}}) }}
      {{ form_widget(form.route_id, {value: item.id}) }}
      <div class="q-decision-row">
        {{ form_label(form.decision, 'moderate_routes.decision.approve'|trans ~ ' / ' ~ 'moderate_routes.decision.reject'|trans ~ ' / ' ~ 'moderate_routes.decision.retire'|trans) }}
        {{ form_widget(form.decision) }}
      </div>
      {{ form_widget(form.note) }}
      <div class="q-act-btns">
        <button type="submit" class="btn-act btn-decide">{{ 'moderate_routes.action.decide'|trans }}</button>
      </div>
    {{ form_end(form) }}
  </div>
</div>
