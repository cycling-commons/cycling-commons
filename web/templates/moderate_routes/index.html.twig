{# The Routes desk: proposals and corrections, on the shared page head,
   filter bar, record card and density switch (account/_shell_styles). #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  /* Route cards carry no lat/lng line, so the correction card's heading block
     can sit on the action row's baseline instead of above it. */
  .q-item--corr .q-head{align-items:center}
  .q-item--corr .q-title{font-size:.95rem}
  a.sugg-route{color:inherit;text-decoration:none}
  a.sugg-route:hover,a.sugg-route:focus-visible{color:var(--trail);text-decoration:underline;text-underline-offset:3px}
  /* Done/Dismiss are POSTs, so each is its own <form> inside the action row —
     without this they would each claim a block-level line of their own. */
  .q-acts > form{display:contents}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_routes', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate_routes.kicker'|trans }}</div>
    <h1>{{ 'moderate_routes.title'|trans }}</h1>
    <div>
      <span class="pend-count">{{ 'moderate_routes.overview.showing'|trans({'%shown%': routes|length, '%total%': total}) }}</span>
    </div>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="mod-bar">
  <form class="mod-filters" method="get" action="{{ path('moderate_routes') }}">
    {# Explicit Apply button, no onchange auto-submit (WCAG 3.2.2: changing a
       setting must not automatically change context). #}
    <label>{{ 'moderate_routes.filter.region'|trans }}
      <select name="region">
        <option value="">{{ 'moderate_routes.filter.all_regions'|trans }}</option>
        {% for r in regions %}<option value="{{ r.id }}"{{ filter_region == r.id ? ' selected' }}>{{ r.name }}</option>{% endfor %}
      </select>
    </label>
    <button type="submit" class="btn-act btn-decide">{{ 'moderate.filter.apply'|trans }}</button>
    {# Density switch: cards ↔ list, exactly as on the submissions desk, and it
       folds BOTH sections — a curator switching density means the desk.
       Unhidden by moderate/_card_script.html.twig, so without JS the desk
       stays in cards, the view that carries the full context. #}
    <div class="q-density" id="qDensity" role="group" aria-label="{{ 'moderate.view.label'|trans }}" hidden>
      <button type="button" class="dens" data-dens="cards" aria-pressed="true">{{ 'moderate.view.cards'|trans }}</button>
      <button type="button" class="dens" data-dens="list" aria-pressed="false">{{ 'moderate.view.list'|trans }}</button>
    </div>
  </form>

  {# ── New route proposals — riders' newly-uploaded routes awaiting first review ── #}
  {# The section counts are the pager's totals, not the page's length: a "12"
     over a section holding 25 of 40 would be a lie about how much work waits. #}
  <h2 class="sec-band sec-band--new">{{ 'moderate_routes.section_proposals'|trans }} <span class="sec-count">{{ pager.total }}</span></h2>
  {% if routes is empty %}
  <div class="empty-queue">
    <div class="ic">&#9650;</div>
    <h3>{{ 'moderate.empty.heading'|trans }}</h3>
    <p>{{ 'moderate_routes.overview.empty'|trans }}</p>
  </div>
  {% else %}
  <div class="q-list" id="qList">
    {% for item in routes %}
      {% include 'moderate_routes/_queue_item.html.twig' with {item: item} %}
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'moderate_routes', params: pager_params|merge({spage: suggestion_pager.page})} %}
  {% endif %}

  {# ── Route corrections — riders flagging fixes on EXISTING routes ── #}
  <h2 class="sec-band sec-band--corr">{{ 'moderate_routes.suggestions.title'|trans }} <span class="sec-count">{{ suggestion_pager.total }}</span></h2>
  {% if suggestions is empty %}
    <p class="sec-empty">{{ 'moderate_routes.suggestions.empty'|trans }}</p>
  {% else %}
  <div class="q-list sugg-list">
    {% for s in suggestions %}
      {% include 'moderate_routes/_correction_item.html.twig' with {s: s, show_route: true} %}
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: suggestion_pager, route: 'moderate_routes', params: pager_params|merge({page: pager.page}), key: 'spage'} %}
  {% endif %}
</div>

{% include 'moderate/_card_script.html.twig' %}
{% endblock %}
