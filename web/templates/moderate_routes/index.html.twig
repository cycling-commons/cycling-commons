{# The Routes desk: proposals and corrections, on the shared page head,
   filter bar, record card and density switch (account/_shell_styles). #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  /* Route cards carry no lat/lng line, so the correction card's heading block
     can sit on the action row's baseline instead of above it. */
  .q-item--corr .q-head{align-items:center}
  .q-item--corr .q-title{font-size:.95rem}
  a.sugg-route{color:inherit;text-decoration:none}
  a.sugg-route:hover,a.sugg-route:focus-visible{color:var(--trail);text-decoration:underline;text-underline-offset:3px}
  /* Done/Dismiss are POSTs, so each is its own <form> inside the action row —
     without this they would each claim a block-level line of their own. */
  .q-acts > form{display:contents}

  /* Active routes (route-domain.md §5.2): a reach list, not a queue, so the
     rows carry no action row and the whole title is the way in. */
  .q-item--active .q-head{align-items:center}
  .q-item--active .q-title{font-size:.95rem}
  .q-item--active .q-title a{color:inherit;text-decoration:none}
  .q-item--active .q-title a:hover,
  .q-item--active .q-title a:focus-visible{color:var(--trail);text-decoration:underline;text-underline-offset:3px}
  .q-tag--state{background:rgba(20,22,14,.07);color:#4a4d40}
  .active-head{font-size:.88rem;color:#595c4d;margin:.2rem 0 .8rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
  .q-active-gaps{font-size:.86rem;color:#595c4d;margin:.5rem 0 0;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}
  .q-active-full{font-size:.86rem;color:#6b6e5c;margin:.5rem 0 0}
  .q-active-gaps .cc-chip{display:inline-block;padding:.15rem .5rem;border-radius:999px;
    border:1px solid rgba(20,22,14,.2);background:var(--paper);font-size:.78rem;color:#4a4d40}
  .active-regions{list-style:none;padding:0;margin:.2rem 0 0;display:flex;flex-wrap:wrap;gap:.5rem .9rem}
  .active-regions a{color:var(--clay);text-decoration:none;border-bottom:1px solid rgba(184,89,58,.35)}
  .active-regions a:hover{color:var(--ink);border-bottom-color:var(--ink)}
  .active-regions-n{font-family:var(--mono);font-size:.72rem;color:#8a8674}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_routes', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate_routes.kicker'|trans }}</div>
    <h1>{{ 'moderate_routes.title'|trans }}</h1>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="mod-bar">
  <form class="mod-filters" method="get" action="{{ path('moderate_routes') }}">
    {# Explicit Apply button, no onchange auto-submit (WCAG 3.2.2: changing a
       setting must not automatically change context). #}
    <label>{{ 'moderate_routes.filter.region'|trans }}
      {# autocomplete=off: a reload shows the region applied, not the last one picked. #}
      <select name="region" autocomplete="off">
        <option value="">{{ (scope_global ? 'moderate_routes.filter.all_regions' : 'moderate_routes.filter.all_my_regions')|trans }}</option>
        {% for r in regions %}<option value="{{ r.id }}"{{ filter_region == r.id ? ' selected' }}>{{ cc_region_label(r.slug, r.name) }}</option>{% endfor %}
      </select>
    </label>
    <button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button>
  </form>
  {# Density switch: cards ↔ list, exactly as on the submissions desk, and it
     folds BOTH sections — a curator switching density means the desk. #}
  {% if routes is not empty or suggestions is not empty %}
    {% include 'account/_density.html.twig' %}
  {% endif %}
  </div>

  {# ── New route proposals — riders' newly-uploaded routes awaiting first review ── #}
  {# The section counts are the pager's totals, not the page's length: a "12"
     over a section holding 25 of 40 would be a lie about how much work waits. #}
  <h2 class="sec-band">{{ 'moderate_routes.section_proposals'|trans }} <span class="sec-count">{{ pager.total }}</span></h2>
  {% if routes is empty %}
  <div class="empty-state">
    <h3>{{ 'moderate.empty.heading'|trans }}</h3>
    <p>{{ 'moderate_routes.overview.empty'|trans }}</p>
  </div>
  {% else %}
  <div class="q-list" id="qList">
    {% for item in routes %}
      {% include 'moderate_routes/_queue_item.html.twig' with {item: item} %}
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: pager, route: 'moderate_routes', params: pager_params|merge({spage: suggestion_pager.page})} %}
  {% endif %}

  {# ── Route corrections — riders flagging fixes on EXISTING routes ── #}
  <h2 class="sec-band sec-band--corr">{{ 'moderate_routes.suggestions.title'|trans }} <span class="sec-count">{{ suggestion_pager.total }}</span></h2>
  {% if suggestions is empty %}
    <p class="sec-empty">{{ 'moderate_routes.suggestions.empty'|trans }}</p>
  {% else %}
  <div class="q-list sugg-list">
    {% for s in suggestions %}
      {% include 'moderate_routes/_correction_item.html.twig' with {s: s, show_route: true} %}
    {% endfor %}
  </div>
  {% include 'partials/_pager.html.twig' with {pager: suggestion_pager, route: 'moderate_routes', params: pager_params|merge({page: pager.page}), key: 'spage'} %}
  {% endif %}

  {# ── Active routes: live routes, to reach one without the map ──
     Not a queue: nothing here waits for a decision. One group per region,
     because the cap is per region and keeps each group short
     (route-domain.md §5.2). Each group's counter IS its list's length, from
     the same "active" definition the cap counts by. #}
  {% set active_total = 0 %}
  {% for g in active_groups %}{% set active_total = active_total + g.routes|length %}{% endfor %}
  <h2 class="sec-band sec-band--active">
    {{ 'moderate_routes.active.title'|trans }}
    {%- if not active_pick %} <span class="sec-count">{{ active_total }}</span>{% endif %}
  </h2>
  {% if active_pick %}
    {# A global curator: pick a region rather than be handed the world. #}
    {% if active_regions is empty %}
      <p class="sec-empty">{{ 'moderate_routes.active.none_anywhere'|trans }}</p>
    {% else %}
      <p class="sec-empty">{{ 'moderate_routes.active.pick_region'|trans }}</p>
      <ul class="active-regions">
        {% for r in active_regions %}
          <li><a href="{{ path('moderate_routes', {region: r.id}) }}">{{ cc_region_label(r.slug, r.name) }}</a>
            <span class="active-regions-n">{{ 'moderate_routes.active.n_active'|trans({'%n%': r.active}) }}</span></li>
        {% endfor %}
      </ul>
    {% endif %}
  {% else %}
    {% for g in active_groups %}
      {% set label = cc_region_label(g.region.slug, g.region.name) %}
      {% if g.routes is empty %}
        <p class="sec-empty">{{ 'moderate_routes.active.empty'|trans({'%region%': label}) }}</p>
      {% else %}
        <p class="active-head">
          {{ 'moderate_routes.active.in_region'|trans({'%region%': label}) }}
          {% include 'moderate_routes/_region_cap.html.twig' with {
            active: g.routes|length, cap: region_cap,
            region_label: label, cap_id: 'rcap-active-' ~ g.region.id
          } %}
        </p>
        <div class="q-list active-list">
          {% for a in g.routes %}
            {% include 'moderate_routes/_active_item.html.twig' with {a: a} %}
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
    {% if active_empty is not empty %}
      <p class="sec-empty">{{ 'moderate_routes.active.empty_many'|trans({'%regions%': active_empty|map(r => cc_region_label(r.slug, r.name))|join(', ')}) }}</p>
    {% elseif active_groups is empty %}
      <p class="sec-empty">{{ 'moderate_routes.active.none_anywhere'|trans }}</p>
    {% endif %}
  {% endif %}
</div>

{% include 'moderate/_card_script.html.twig' %}
{% endblock %}
