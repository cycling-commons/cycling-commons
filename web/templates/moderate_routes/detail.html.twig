{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .mh{padding:2rem 0 1.4rem}
  /* The last section keeps its distance from the footer, list or no list. */
  #main{padding-bottom:3rem}
  .mh .kicker{font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  .mh h1{font-family:var(--serif);font-weight:600;font-size:clamp(1.6rem,4vw,2.2rem);line-height:1.1;margin-bottom:.4rem;color:var(--ink)}
  .mh .stat-line{font-family:var(--mono);font-size:.72rem;color:#595c4d}

  .rd-maplink{color:var(--clay);text-decoration:none;border-bottom:1px solid rgba(184,89,58,.35);white-space:nowrap}
  .rd-maplink:hover{color:var(--ink);border-bottom-color:var(--ink)}

  .rd-meta{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1.2rem 1.4rem;margin:1.4rem 0;background:var(--paper)}
  .rd-meta table{width:100%;border-collapse:collapse;font-size:.90rem}
  .rd-meta td{padding:.4rem 0;border-bottom:1px solid rgba(20,22,14,.08)}
  .rd-meta td:last-child{white-space:pre-line}
  .rd-meta td:first-child{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;width:35%}

  .rd-edit{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1.2rem 1.4rem;margin:1.4rem 0;background:var(--paper)}
  /* the decision is the primary action on a submitted proposal — a clay accent
     sets it apart from the plain edit/retire boxes. */
  .rd-decide{border-left:3px solid var(--clay)}
  .rd-decide h2{font-family:var(--serif);font-size:1.2rem;margin:0 0 .8rem}
  .rd-decide-row{display:flex;align-items:center;gap:.7rem;margin-bottom:.8rem}
  .rd-decide-row label{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;margin:0}
  .rd-decide-row select{max-width:240px}
  .rd-edit label{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;margin-bottom:.4rem}
  .rd-edit textarea{width:100%;min-height:110px;font-family:var(--sans);font-size:.9rem;padding:.6rem;border:1px solid rgba(20,22,14,.25);border-radius:6px}
  /* .btn-act + variants come from account/_shell_styles.html.twig (one orange system);
     only the layout margin is detail-specific here. */
  .btn-act{margin-top:.8rem}


  /* The proposal's own action row is the page's, not a queue row's, so it
     needs the card's frame around it — on the overview the row inherits one
     from the .q-item it sits in. */
  .rd-acts{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1rem 1.2rem;margin:1.4rem 0;background:var(--paper)}
  .q-item--corr .q-head{align-items:center}
  .q-acts > form{display:contents}

  .rd-suggestions{margin:1.4rem 0 2.4rem}
  .rd-photos-h{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;margin:.4rem 0 0}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_routes', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null} %}{% endblock %}

{% block body %}
{% set region_label = route.regionId is null ? '' : cc_region_label(route.regionSlug, route.region) %}
<div class="mh">
  <div class="wrap">
    <div class="kicker">{{ 'moderate_routes.kicker'|trans }}</div>
    <h1>{{ route.name }}</h1>
    <div class="stat-line">
      {{ route.km|cc_km }}
      {% if route.ascent is not null %}&middot; {{ 'moderate_routes.stat_ascent'|trans({'%v%': route.ascent|cc_elev}) }}{% endif %}
      &middot; {% include 'moderate_routes/_region_cap.html.twig' with {active: active_in_region, cap: region_cap, region_label: region_label, cap_id: 'rcap-detail'} only %}
      &middot; <a class="rd-maplink" href="{{ path('map') }}?route={{ route.id }}" target="_blank" rel="noopener">{{ 'moderate_routes.map_open'|trans }} &#8599;</a>
    </div>
  </div>
</div>

<div class="wrap" id="main">
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# No embedded map here (the full interactive map + tiles + CSP live at /map);
     the header carries a compact "open on the map" link instead of a big empty
     placeholder box. #}
  <div class="rd-meta">
    <table>
      <tr><td>{{ 'moderate_routes.meta.state'|trans }}</td><td>{{ ('account.route_state_' ~ route.state)|trans }}</td></tr>
      {% if route.proposer %}
      <tr data-meta="proposer">
        <td>{{ 'moderate_routes.meta.proposed_by'|trans }}</td>
        <td>{% include 'moderate/_rider_name.html.twig' with {rider: route.proposer} only %}</td>
      </tr>
      {% endif %}
      <tr data-meta="distance"><td>{{ 'moderate_routes.meta.distance'|trans }}</td><td>{{ route.km|cc_km }}</td></tr>
      <tr data-meta="ascent"><td>{{ 'moderate_routes.meta.ascent'|trans }}</td><td>{{ route.ascent is null ? '-' : route.ascent|cc_elev }}</td></tr>
      <tr data-meta="region"><td>{{ 'moderate_routes.meta.region'|trans }}</td><td>{{ region_label ?: 'moderate_routes.region_none'|trans }}</td></tr>
      {# What the rider filled in on /propose-route, under the form's own labels;
         a field left unset is a dash (App\Moderation\RouteProposalDetails). #}
      {% for d in details %}
      <tr data-meta="{{ d.key }}">
        <td>{{ d.label|trans }}</td>
        <td>
          {%- if d.values is empty -%}
            -
          {%- elseif d.translate -%}
            {{ d.values|map(v => v|trans)|join(', ') }}
          {%- else -%}
            {{ d.values|join(', ') }}
          {%- endif -%}
          {%- if d.key == 'dominant_surface' and suggested_surface is not null and suggested_surface != route.attributes.dominantSurface|default(null) -%}
            <div class="surface-hint">{{ 'moderate_routes.surface_hint'|trans({'%surface%': suggested_surface|trans}) }}</div>
          {%- endif -%}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  {# Decision (approve / reject / retire) — the ONLY place a submitted proposal
     is decided now; the queue list no longer carries this form. #}
  {% if decision_form is not null %}
  <div class="rd-edit rd-decide">
    <h2>{{ 'moderate_routes.decision.heading'|trans }}</h2>
    {{ form_start(decision_form) }}
    {% include 'partials/_form_errors.html.twig' with {form: decision_form} %}
      {{ form_widget(decision_form.route_id, {value: route.id}) }}
      <div class="rd-decide-row">
        <label for="{{ decision_form.decision.vars.id }}">{{ 'moderate_routes.decision.label'|trans }}</label>
        {{ form_widget(decision_form.decision) }}
      </div>
      {% if proposal_photos is not empty %}
        {# Photos sent with the proposal ride this decision (docs/specs/photo-uploads.md §5i). #}
        <p class="rd-photos-h">{{ 'moderate_routes.photos.heading'|trans }}</p>
        {% include 'moderate_routes/_photos.html.twig' with {photos: proposal_photos} %}
      {% endif %}
      {# Sent to the rider who proposed the route, with the decision. #}
      <label for="{{ decision_form.note.vars.id }}">{{ 'moderate_routes.decision.note'|trans }}</label>
      {{ form_widget(decision_form.note) }}
      <button type="submit" class="btn-act btn-decide">{{ 'moderate_routes.action.decide'|trans }}</button>
    {{ form_end(decision_form) }}
  </div>
  {% endif %}

  <div class="rd-edit">
    {{ form_start(edit_form, {attr: {novalidate: 'novalidate'}}) }}
    {% include 'partials/_form_errors.html.twig' with {form: edit_form} %}
      {{ form_widget(edit_form.route_id) }}
      {# The route's public note, shown to every rider in the map drawer. #}
      <label for="{{ edit_form.note.vars.id }}">{{ 'moderate_routes.meta.rider_note'|trans }}</label>
      {{ form_widget(edit_form.note) }}
      <button type="submit" class="btn-act btn-save">{{ 'moderate_routes.action.save'|trans }}</button>
    {{ form_end(edit_form) }}
  </div>

  {% if retire_form is not null %}
  <div class="rd-edit rd-retire">
    <h2>{{ 'moderate_routes.action.retire_route'|trans }}</h2>
    {{ form_start(retire_form) }}
    {% include 'partials/_form_errors.html.twig' with {form: retire_form} %}
      {{ form_widget(retire_form.route_id) }}
      {{ form_widget(retire_form.decision) }}
      <label for="{{ retire_form.note.vars.id }}">{{ 'moderate_routes.decision.retire_note'|trans }}</label>
      {{ form_widget(retire_form.note, {attr: {required: 'required'}}) }}
      <button type="submit" class="btn-act btn-dismiss">{{ 'moderate_routes.action.retire_route'|trans }}</button>
    {{ form_end(retire_form) }}
  </div>
  {% endif %}

  {# This proposal's own verbs, in the shared card's action row
     (moderation-and-contribution.md §5.2): one line, each <details> upgraded to
     a real disclosure by moderate/_card_script.html.twig, and Trash carrying
     WHEN to use it plus a ticked acknowledgement. Escalate is absent on
     purpose — a route proposal is a GPX and a note, and the escalation path
     exists for uploaded imagery (photo-uploads.md §6d). #}
  <div class="rd-acts" data-item-id="route{{ route.id }}">
    <div class="q-acts">
      <details class="q-act q-act--message">
        <summary class="btn-act btn-secondary">{{ 'moderate.msg.summary'|trans }}</summary>
        <div class="q-act-panel">
          <form method="post" action="{{ path('moderate_message') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('moderate-message') }}">
            <input type="hidden" name="channel" value="route">
            <input type="hidden" name="id" value="{{ route.id }}">
            <textarea name="body" maxlength="2000" placeholder="{{ 'moderate.msg.placeholder'|trans }}" required></textarea>
            <button type="submit" class="btn-act btn-secondary">{{ 'moderate.msg.send'|trans }}</button>
          </form>
        </div>
      </details>

      {% if route.state in ['submitted', 'rejected'] %}
      <details class="q-act q-act--trash trash-confirm-proposal">
        <summary class="btn-act btn-secondary">{{ 'moderate.trash.button'|trans }}</summary>
        <div class="q-act-panel">
          <form method="post" action="{{ path('moderate_routes_trash') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('route-trash') }}">
            <input type="hidden" name="kind" value="proposal">
            <input type="hidden" name="id" value="{{ route.id }}">
            <p><strong class="trash-warn">{{ 'moderate.trash.confirm_head'|trans }}</strong></p>
            <p>{{ 'moderate.trash.confirm_rest'|trans }}</p>
            <p class="q-act-when">{{ 'moderate.trash.when'|trans }}</p>
            <button type="submit" class="btn-act btn-secondary">{{ 'moderate.trash.button'|trans }}</button>
          </form>
        </div>
      </details>
      {% endif %}
    </div>
  </div>

  <h2 class="sec-band sec-band--corr">{{ 'moderate_routes.suggestions.title'|trans }}</h2>
  {% if suggestions is empty %}
    <p class="sec-empty">{{ 'moderate_routes.suggestions.empty'|trans }}</p>
  {% else %}
  <div class="q-list rd-suggestions">
    {% for s in suggestions %}
      {# Same card as the overview's corrections list. This page used to render
         a leaner one with Trash but no Message and no typed confirmation —
         two cards for one thing, and the weaker of the two guarding the
         destructive verb. #}
      {% include 'moderate_routes/_correction_item.html.twig' with {s: s, show_route: false} %}
    {% endfor %}
  </div>
  {% endif %}
</div>

{% include 'moderate/_card_script.html.twig' %}
{% endblock %}
