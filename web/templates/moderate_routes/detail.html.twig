{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .mh{padding:2rem 0 1.4rem}
  .mh .kicker{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  .mh h1{font-family:var(--serif);font-weight:600;font-size:clamp(1.6rem,4vw,2.2rem);line-height:1.1;margin-bottom:.4rem;color:var(--ink)}
  .mh .stat-line{font-family:var(--mono);font-size:.72rem;color:#595c4d}

  .rd-map{height:180px;border-radius:8px;background:rgba(20,22,14,.06);margin:1.4rem 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;color:var(--clay);font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;border:1px solid rgba(184,89,58,.25);transition:background .15s,color .15s}
  .rd-map:hover{background:rgba(184,89,58,.08);color:var(--ink)}
  .rd-map .rd-map-ic{font-size:1.8rem}

  .rd-meta{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1.2rem 1.4rem;margin:1.4rem 0;background:var(--paper)}
  .rd-meta table{width:100%;border-collapse:collapse;font-size:.88rem}
  .rd-meta td{padding:.4rem 0;border-bottom:1px solid rgba(20,22,14,.08)}
  .rd-meta td:first-child{font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;width:35%}

  .rd-edit{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1.2rem 1.4rem;margin:1.4rem 0;background:var(--paper)}
  .rd-edit label{display:block;font-family:var(--mono);font-size:.64rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;margin-bottom:.4rem}
  .rd-edit textarea{width:100%;min-height:110px;font-family:var(--sans);font-size:.9rem;padding:.6rem;border:1px solid rgba(20,22,14,.25);border-radius:6px}
  /* .btn-act + variants come from account/_shell_styles.html.twig (one orange system);
     only the layout margin is detail-specific here. */
  .btn-act{margin-top:.8rem}

  .msg-rider{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1rem 1.2rem;margin:1.4rem 0;background:var(--paper)}
  .msg-rider summary{cursor:pointer;font-family:var(--mono);font-size:.64rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay)}
  .msg-rider summary:hover{color:var(--ink)}
  .msg-rider form{margin-top:.6rem;display:flex;flex-direction:column;gap:.5rem}
  /* message + trash split over two columns; buttons back to natural size */
  .mod-2col{display:grid;grid-template-columns:1fr 1fr;gap:1rem;align-items:start}
  @media(max-width:700px){.mod-2col{grid-template-columns:1fr}}
  .msg-rider form .btn-act{align-self:flex-end}
  .trash-warn{color:#8b1a1a}
  .msg-rider textarea{width:100%;min-height:90px;font-family:var(--sans);font-size:.88rem;padding:.55rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}

  .rd-suggestions{margin:1.4rem 0 2.4rem}
  .sugg-item{border:1px solid rgba(20,22,14,.12);border-radius:8px;padding:1rem 1.2rem;margin-bottom:.8rem;background:var(--paper);display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .sugg-body{flex:1 1 260px}
  .sugg-reason{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay)}
  .sugg-actions{display:flex;gap:.5rem}
  /* Nested in .sugg-item's flex row — full-width, borderless (the card border
     already frames it), unlike the standalone .msg-rider box above. */
  .sugg-item .msg-rider{flex-basis:100%;border:none;border-top:1px solid rgba(20,22,14,.1);border-radius:0;padding:.6rem 0 0;margin:.4rem 0 0;background:transparent}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_routes', mod_scope_names: mod_scope_names is defined ? mod_scope_names : null, mod_submission_count: mod_submission_count is defined ? mod_submission_count : null, mod_route_count: mod_route_count is defined ? mod_route_count : null} %}{% endblock %}

{% block body %}
<div class="mh">
  <div class="wrap">
    <div class="kicker">{{ 'moderate_routes.kicker'|trans }}</div>
    <h1>{{ route.name }}</h1>
    <div class="stat-line">
      {{ route.km }} km
      {% if route.ascent is not null %}&middot; {{ 'moderate_routes.stat_ascent'|trans({'%m%': route.ascent}) }}{% endif %}
      &middot; <span data-region-cap>{{ 'moderate_routes.region_cap'|trans({'%active%': active_in_region, '%cap%': region_cap}) }}</span>
    </div>
  </div>
</div>

<div class="wrap" id="main">
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# The full interactive map (with basemap + tiles + CSP) lives at /map; opening
     the route there via the ?route= deep-link is the reliable preview — this box
     was a dead placeholder that never rendered a map. #}
  <a class="rd-map" href="{{ path('map') }}?route={{ route.id }}" target="_blank" rel="noopener">
    <span class="rd-map-ic" aria-hidden="true">&#9906;</span>
    {{ 'moderate_routes.map_open'|trans }} &#8599;
  </a>

  <div class="rd-meta">
    <table>
      <tr><td>{{ 'moderate_routes.meta.state'|trans }}</td><td>{{ ('account.route_state_' ~ route.state)|trans }}</td></tr>
      <tr><td>{{ 'moderate_routes.meta.distance'|trans }}</td><td>{{ route.km }} km</td></tr>
      <tr><td>{{ 'moderate_routes.meta.ascent'|trans }}</td><td>{{ route.ascent ?? '—' }}</td></tr>
      <tr><td>{{ 'moderate_routes.meta.region'|trans }}</td><td>{{ route.regionId ?? '—' }}</td></tr>
      <tr>
        <td>{{ 'moderate_routes.meta.dominant_surface'|trans }}</td>
        <td>
          {{ route.attributes.dominantSurface ?? '—' }}
          {% if suggested_surface is not null and suggested_surface != route.attributes.dominantSurface %}
            <div class="surface-hint">{{ 'moderate_routes.surface_hint'|trans({'%surface%': suggested_surface}) }}</div>
          {% endif %}
        </td>
      </tr>
    </table>
  </div>

  <div class="rd-edit">
    {{ form_start(edit_form, {attr: {novalidate: 'novalidate'}}) }}
      {{ form_widget(edit_form.route_id) }}
      <label for="{{ edit_form.note.vars.id }}">{{ 'moderate_routes.meta.note'|trans }}</label>
      {{ form_widget(edit_form.note) }}
      <button type="submit" class="btn-act btn-save">{{ 'moderate_routes.action.save'|trans }}</button>
    {{ form_end(edit_form) }}
  </div>

  {% if retire_form is not null %}
  <div class="rd-edit rd-retire">
    <h2>{{ 'moderate_routes.action.retire_route'|trans }}</h2>
    {{ form_start(retire_form) }}
      {{ form_widget(retire_form.route_id) }}
      {{ form_widget(retire_form.decision) }}
      <label for="{{ retire_form.note.vars.id }}">{{ 'moderate_routes.meta.note'|trans }}</label>
      {{ form_widget(retire_form.note) }}
      <button type="submit" class="btn-act btn-dismiss">{{ 'moderate_routes.action.retire_route'|trans }}</button>
    {{ form_end(retire_form) }}
  </div>
  {% endif %}

  {# message + trash side by side (rider feedback: no full-width stack) #}
  <div class="mod-2col">
    <details class="msg-rider">
      <summary>{{ 'moderate.msg.summary'|trans }}</summary>
      <form method="post" action="{{ path('moderate_message') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('moderate-message') }}">
        <input type="hidden" name="channel" value="route">
        <input type="hidden" name="id" value="{{ route.id }}">
        <textarea name="body" maxlength="2000" placeholder="{{ 'moderate.msg.placeholder'|trans }}" required></textarea>
        <button type="submit" class="btn-act btn-secondary">{{ 'moderate.msg.send'|trans }}</button>
      </form>
    </details>

    {% if route.state in ['submitted', 'rejected'] %}
    <details class="msg-rider trash-confirm-proposal">
      <summary>{{ 'moderate.trash.button'|trans }}</summary>
      <form method="post" action="{{ path('moderate_routes_trash') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('route-trash') }}">
        <input type="hidden" name="kind" value="proposal">
        <input type="hidden" name="id" value="{{ route.id }}">
        <p><strong class="trash-warn">{{ 'moderate.trash.confirm_head'|trans }}</strong> {{ 'moderate.trash.confirm_rest'|trans }}</p>
        <button type="submit" class="btn-act btn-secondary">{{ 'moderate.trash.button'|trans }}</button>
      </form>
    </details>
    {% endif %}
  </div>

  <h2>{{ 'moderate_routes.suggestions.title'|trans }}</h2>
  {% if suggestions is empty %}
    <p>{{ 'moderate_routes.suggestions.empty'|trans }}</p>
  {% else %}
  <div class="rd-suggestions">
    {% for s in suggestions %}
      <div class="sugg-item" data-suggestion-id="{{ s.id }}">
        <div class="sugg-body">
          <div class="sugg-reason">{{ ('moderate_routes.suggestions.reason_' ~ (s.reason|replace({'-': '_'})))|trans }}</div>
          {% if s.note %}<p>{{ s.note }}</p>{% endif %}
        </div>
        <div class="sugg-actions">
          <form method="post" action="{{ path('moderate_routes_suggestion') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('route-suggestion') }}">
            <input type="hidden" name="suggestion_id" value="{{ s.id }}">
            <input type="hidden" name="status" value="done">
            <button type="submit" class="btn-act btn-done">{{ 'moderate_routes.action.done'|trans }}</button>
          </form>
          <form method="post" action="{{ path('moderate_routes_suggestion') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('route-suggestion') }}">
            <input type="hidden" name="suggestion_id" value="{{ s.id }}">
            <input type="hidden" name="status" value="dismissed">
            <button type="submit" class="btn-act btn-dismiss">{{ 'moderate_routes.action.dismiss'|trans }}</button>
          </form>
        </div>
        <details class="msg-rider trash-confirm-correction">
          <summary>{{ 'moderate.trash.button'|trans }}</summary>
          <form method="post" action="{{ path('moderate_routes_trash') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('route-trash') }}">
            <input type="hidden" name="kind" value="correction">
            <input type="hidden" name="id" value="{{ s.id }}">
            <p><strong class="trash-warn">{{ 'moderate.trash.confirm_head'|trans }}</strong> {{ 'moderate.trash.confirm_rest'|trans }}</p>
            <button type="submit" class="btn-act btn-secondary">{{ 'moderate.trash.button'|trans }}</button>
          </form>
        </details>
      </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endblock %}
