{# The Scout ride-review panel, rendered only on /scout/review.

   It sits over the real map (every layer, both bases, the surface skin) rather
   than on a map of its own, because a rider fixing a tag needs to see what is
   already mapped around it — that is the whole judgement.

   Nothing here uploads the ride. The file is read by scout-review.js in the
   browser; the panel is markup and the map is the map. #}
<aside class="scout-panel" id="scoutPanel" aria-label="{{ 'scout.review_title'|trans }}">
  <div class="scout-head">
    <h2>{{ 'scout.review_title'|trans }}</h2>
    <p class="scout-sub">{{ 'scout.review_lead'|trans }}</p>
  </div>

  <div class="scout-drop" id="scoutDrop">
    <input type="file" id="scoutFile" accept=".fit,application/octet-stream" hidden>
    <button type="button" class="scout-pick" id="scoutPick">{{ 'scout.review_pick'|trans }}</button>
    <p class="scout-hint">{{ 'scout.review_hint'|trans }}</p>
  </div>

  <p class="scout-msg" id="scoutMsg" role="status" hidden></p>

  <div class="scout-list" id="scoutList" hidden>
    <div class="scout-count"><b id="scoutDone">0</b> / <span id="scoutTotal">0</span> {{ 'scout.review_approved'|trans }}</div>
    <ol id="scoutTags"></ol>
  </div>
</aside>
