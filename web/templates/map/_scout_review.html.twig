{# The Scout ride-review panel, rendered only on /scout/review.

   It sits over the real map (every layer, both bases, the surface skin) rather
   than on a map of its own, because a rider fixing a tag needs to see what is
   already mapped around it — that is the whole judgement.

   Nothing here uploads the ride. The file is read by scout-review.js in the
   browser; the panel is markup and the map is the map. #}
<aside class="scout-panel" id="scoutPanel" aria-label="{{ 'scout.review_title'|trans }}">
  {# Closing leaves NOTHING behind (owner 2026-08-12: "this is not closed, must
     be gone" / "also remove the drawn route and point and cars") — no chip over
     the region banner, and no ride left drawn on a map that no longer has a
     panel to act on it. The review ends; the map is what is left. #}
  <button type="button" class="scout-close" id="scoutClose"
          title="{{ 'scout.review_close'|trans }}" aria-label="{{ 'scout.review_close'|trans }}">&times;</button>
  {# A small mark beside the title, nothing more (owner 2026-08-18): the lead
     paragraph explained what the panel already shows, and the privacy promise
     lives on /scout where a first-time rider actually reads it. #}
  <div class="scout-head">
    <span class="scout-markbox"><img class="scout-mark" src="{{ asset('brand/scout-logo.svg') }}" alt=""></span>
    <div class="scout-headtext">
      <h2>{{ 'scout.review_title'|trans }}</h2>
    </div>
  </div>

  <div class="scout-drop" id="scoutDrop">
    {# One ride or many (docs/specs/traffic-measurements.md §3.2): several files,
       or a .zip with several rides, go to several-rides mode, read here one file
       at a time; traffic summaries only. #}
    <input type="file" id="scoutFile" multiple accept=".fit,.zip,application/zip,application/octet-stream" hidden>
    <button type="button" class="scout-pick" id="scoutPick">{{ 'scout.review_pick'|trans }}</button>
    <p class="scout-hint">{{ 'scout.review_hint'|trans }}</p>
  </div>

  {# Two steps only when the ride has radar data: tags, then traffic. A ride
     without radar shows the tag review alone, exactly as before. #}
  <nav class="scout-steps" id="scoutSteps" hidden aria-label="{{ 'scout.review_title'|trans }}">
    <button type="button" class="scout-step" id="scoutStepTags" aria-current="step">1 · {{ 'scout.review_step_tags'|trans }}</button>
    <button type="button" class="scout-step" id="scoutStepTraffic">2 · {{ 'scout.review_step_traffic'|trans }}</button>
  </nav>

  <p class="scout-msg" id="scoutMsg" role="status" hidden></p>
  {# What the ride carries beyond its tags: an overtake count, tags with no fix,
     surface stretches. Facts about THIS file, none of them sent anywhere. #}
  <div class="scout-facts" id="scoutFacts" hidden></div>

  <div class="scout-list" id="scoutList" hidden>
    <div class="scout-count"><b id="scoutDone">0</b> / <span id="scoutTotal">0</span> {{ 'scout.review_approved'|trans }}</div>
    <ol id="scoutTags"></ol>
    {# Send everything still outstanding. Below the list, because it is the last
       thing you do — and it never sends what is already sent. #}
    <button type="button" class="scout-sendall" id="scoutSendAll">{{ 'scout.review_send_all'|trans }}</button>
    <button type="button" class="scout-next" id="scoutNextTraffic" hidden>{{ 'scout.review_next_traffic'|trans }}</button>
  </div>

  {# Step 2: the traffic summary of this ride. The rider sees every line before
     anything is sent, and the click on Send is the consent for this ride. #}
  <section class="scout-traffic" id="scoutTraffic" hidden>
    <p class="scout-fact" id="scoutTrafficFacts" role="status"></p>
    <p class="scout-fact" id="scoutTrafficUnmatched" hidden></p>
    <button type="button" class="scout-sendall" id="scoutTrafficSend" hidden>{{ 'scout.review_traffic_send'|trans }}</button>
    <p class="scout-msg" id="scoutTrafficMsg" role="status" hidden></p>
    {# Opens the map's own Key panel at the lines this step draws. #}
    <button type="button" class="scout-traffic-key" id="scoutTrafficKey"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="2"/><path d="M11.5 6H20"/><circle cx="6" cy="12" r="2"/><path d="M11.5 12H20"/><circle cx="6" cy="18" r="2"/><path d="M11.5 18H20"/></svg>{{ 'scout.review_key'|trans }}</button>
    {# What this click sends: the rule, then every line. #}
    <details class="scout-traffic-preview" id="scoutTrafficPreview" hidden>
      <summary>{{ 'scout.review_traffic_preview'|trans }}</summary>
      <p>{{ 'scout.review_traffic_intro'|trans }}</p>
      <ol id="scoutTrafficLines"></ol>
    </details>
  </section>

  {# Several rides: progress, one total, one send. #}
  <section class="scout-traffic" id="scoutBulk" hidden>
    <p class="scout-hint">{{ 'scout.review_bulk_hint'|trans }}</p>
    <p class="scout-fact" id="scoutBulkProgress" role="status"></p>
    {# What the batch holds, before anything is sent (ride-batch.js). #}
    <table class="scout-bulk-sum" id="scoutBulkSum" hidden><tbody></tbody></table>
    <details class="scout-bulk-years" id="scoutBulkYears" hidden>
      <summary>{{ 'scout.review_bulk_years'|trans }}</summary>
      <table>
        <thead><tr>
          <th scope="col">{{ 'scout.review_bulk_col_year'|trans }}</th>
          <th scope="col">{{ 'scout.review_bulk_col_rides'|trans }}</th>
          <th scope="col">{{ 'scout.review_bulk_col_distance'|trans }}</th>
          <th scope="col">{{ 'scout.review_bulk_col_passed'|trans }}</th>
          <th scope="col">{{ 'scout.review_bulk_col_nearby'|trans }}</th>
        </tr></thead>
        <tbody id="scoutBulkYearRows"></tbody>
      </table>
    </details>
    <p class="scout-fact" id="scoutBulkSkipped" hidden></p>
    <button type="button" class="scout-sendall" id="scoutBulkSend" hidden>{{ 'scout.review_bulk_send'|trans }}</button>
    <p class="scout-msg" id="scoutBulkMsg" role="status" hidden></p>
    <details class="scout-traffic-preview">
      <summary>{{ 'scout.review_traffic_preview'|trans }}</summary>
      <p>{{ 'scout.review_traffic_intro'|trans }}</p>
    </details>
  </section>

  {# The photo uploader, mounted once. media-upload.js addresses these ids
     directly, and it owns the consent gate — which is exactly why there is one
     of it and not one per tag: consent must fail closed in a single place
     (docs/specs/photo-uploads.md). A row's "add a photo" button routes the next
     completed upload to that row. #}
  <div class="scout-media" id="scoutMedia" hidden>
    <div class="consent-gate" id="media-consent"></div>
    {# multiple: one spot can be worth several pictures, and a ride is many
       spots — the wizard's single-shot input is the wrong shape here. #}
    <input type="file" id="file-photo" accept="image/jpeg,image/png,image/webp,image/heic" multiple hidden>
    <div class="drop" id="drop-photo" role="button" tabindex="0" aria-controls="file-photo">{{ 'scout.review_photo_drop'|trans }}</div>
    <div class="ulq" id="q-photo"></div>
    <input type="hidden" id="scoutMediaIds">
  </div>
</aside>
