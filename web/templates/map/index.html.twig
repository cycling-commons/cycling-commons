<!DOCTYPE html>
{# data-map-theme keys the light chrome palette in map.css. The server renders
   the logged-in rider's stored choice, so the first paint is already right.
   Anonymous visitors always arrive as "dark"; the inline head script below
   promotes their localStorage choice before first paint. #}
<html lang="{{ app.request.locale|default('en') }}" data-map-theme="{{ map_theme }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Cycling Commons — Map</title>
<meta name="description" content="Explore the Commons on one open map — climbs, water, viewpoints, bike-friendly stays and road conditions. Filter by surface, traffic and what matters to your ride." />
<link rel="canonical" href="https://cyclingcommons.org/map" />
<link type="text/plain" rel="author" href="https://cyclingcommons.org/humans.txt" />
<link rel="license" href="{{ path('licenses') }}" />
<meta name="theme-color" content="#101E16" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:site_name" content="Cycling Commons" />
<meta property="og:type" content="website" />
<meta property="og:title" content="Cycling Commons — Map" />
<meta property="og:description" content="Explore the Commons on one open map — climbs, water, viewpoints, bike-friendly stays and road conditions. Filter by surface, traffic and what matters to your ride." />
<meta property="og:url" content="https://cyclingcommons.org/map" />
<meta property="og:image" content="https://cyclingcommons.org/brand/og/map.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Cycling Commons — Map" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Cycling Commons — Map" />
<meta name="twitter:description" content="Explore the Commons on one open map — climbs, water, viewpoints, bike-friendly stays and road conditions. Filter by surface, traffic and what matters to your ride." />
<meta name="twitter:image" content="https://cyclingcommons.org/brand/og/map.jpg" />

{% if not is_granted('ROLE_USER') %}
<script nonce="{{ csp_nonce() }}">
  {# Anonymous theme boot: promote a localStorage choice onto <html> BEFORE
     the stylesheets paint, so a returning light-mode visitor never flashes
     dark. Logged-in riders skip this — the server attribute is their profile
     truth and must not be overridden by a shared device's localStorage. #}
  try{var t=localStorage.getItem('cc:mapTheme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-map-theme',t);}catch(e){}
</script>
{% endif %}
<link rel="stylesheet" href="{{ asset('lib/maplibre-gl-5.24.0.css') }}" />
<link rel="stylesheet" href="{{ asset('styles/fonts.css') }}" />
<link rel="stylesheet" href="{{ asset('styles/map.css') }}" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="{{ asset('brand/logo-favicon.svg') }}" />
{# nonce: the loader hands it to the cross-origin Umami script it injects
   (assets/js/analytics.js) - without it, script-src silently blocks analytics. #}
<script defer src="{{ asset('js/analytics.js') }}" nonce="{{ csp_nonce() }}"></script>
<script defer src="{{ asset('js/nav-menus.js') }}"></script>
</head>
<body>
<div class="app">
  <!-- ============ ICON RAIL ============ -->
  {# The rail is 48px of icons, one per rider section (map-and-search.md §4).
     Each button opens the drawer beside it on the SAME section; a second press
     on the same icon closes it. shell.js owns that behaviour, this markup only
     declares which panel a button belongs to (data-panel). #}
  <nav class="irail" aria-label="{{ 'map.rail_sections'|trans }}">
    <a class="mark" href="{{ path('home') }}" aria-label="Cycling Commons">
      <svg viewBox="0 0 100 130" width="22" height="29" aria-hidden="true"><path d="M50 8 C31 8 16 23 16 42 C16 68 50 124 50 124 C50 124 84 68 84 42 C84 23 69 8 50 8 Z" fill="var(--trail)"/><circle cx="50" cy="42" r="17" fill="var(--chrome-bg)"/></svg>
    </a>
    <button class="ib" id="ib-search" type="button" data-panel="search" data-tip="{{ 'map.rail_search'|trans }}" aria-label="{{ 'map.rail_search'|trans }}" aria-controls="dwr" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
    </button>
    <button class="ib" id="ib-layers" type="button" data-panel="layers" data-tip="{{ 'map.rail_layers'|trans }}" aria-label="{{ 'map.rail_layers'|trans }}" aria-controls="dwr" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 17.5 9 5 9-5" opacity=".45"/></svg>
      {# Filter dot: shown by shell.js whenever a chip filter is narrowing the
         map, so "where did my data go?" has an answer on the rail as well as
         in the on-map pill (Task 6). #}
      <span class="fdot" aria-hidden="true"></span>
    </button>
    <button class="ib" id="ib-tools" type="button" data-panel="tools" data-tip="{{ 'map.rail_tools'|trans }}" aria-label="{{ 'map.rail_tools'|trans }}" aria-controls="dwr" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c4 0 3-9 7-9m0 0c4 0 3 9 7 9M12 10V5"/><circle cx="12" cy="4" r="1.4"/><circle cx="5" cy="19" r="2.6"/><circle cx="19" cy="19" r="2.6"/></svg>
    </button>
    <span class="spring"></span>
    <hr />
    {# The chrome theme toggle. theme.js paints the glyph and the label, both of
       which name the theme a press will GIVE you (map-and-search.md §4.6). #}
    <button class="ib" id="ib-theme" type="button"></button>
    {# Site nav + language, one flyout behind a ≡ button, opened by the same
       initRailChrome() handler the old rail head used. #}
    <div class="irail-menu" id="railHead">
      <button class="ib" id="railBurger" type="button" aria-label="{{ 'map.menu_aria'|trans }}" data-tip="{{ 'map.menu_aria'|trans }}" aria-expanded="false" aria-controls="railNav">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <nav class="rail-nav" id="railNav"><a href="{{ path('map') }}" class="on">{{ 'nav.map'|trans }}</a><a href="{{ path('regions') }}">{{ 'nav.regions'|trans }}</a><a href="{{ path('vote') }}">{{ 'nav.vote'|trans }}</a><a href="{{ path('developers') }}">{{ 'nav.developers'|trans }}</a><a href="{{ path('about') }}">{{ 'nav.about'|trans }}</a>{% include 'partials/_lang_menu.html.twig' %}</nav>
    </div>
    {# The account avatar is its own rail slot, NOT a row inside the ≡ menu:
       the unread bulb has to be visible on the rail, and inside the flyout it
       would only appear once the rider had already opened the menu, which is
       the one moment the badge has nothing left to tell them. The chip keeps
       its shared markup; the rail only hides the name and the caret. #}
    <div class="irail-acct">
      {% if app.user %}{% include 'partials/_account_chip.html.twig' %}{% else %}<a class="ib" href="{{ path('login') }}" aria-label="{{ 'nav.account'|trans }}" data-tip="{{ 'nav.account'|trans }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg></a>{% endif %}
    </div>
  </nav>

  <!-- ============ DRAWER ============ -->
  {# One section at a time, 320px wide, closed on load: the map is the hero.
     shell.js flips .open and swaps which .panel carries .on. #}
  <aside class="dwr" id="dwr" aria-hidden="true">
    <div class="dwr-in">
      <div class="dwr-head">
        <h2 id="dwr-title"></h2>
        <button class="dwr-x" id="dwr-x" type="button" aria-label="{{ 'map.panel_close'|trans }}">✕</button>
      </div>
      <div class="dwr-body">

      <section class="panel" id="p-search">
      {# Search and region are ONE panel (owner 2026-08-20: "search is in a
         region so those 2 must be combined"). The heading names the scope,
         written by scope-header.js paint(). #}
      <div class="grp">
        <h3 id="searchTitle">{{ 'map.search_title'|trans }}</h3>
        <input class="search" id="search" placeholder="{{ 'map.search_placeholder'|trans }}" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="searchRes" aria-label="{{ 'map.search_aria'|trans }}" />
        <ul class="search-res" id="searchRes" role="listbox" hidden></ul>
        <div class="co" id="regionCoords">{{ 'map.coords'|trans }}</div>
      </div>

      {# Region scope selector (map-and-search.md §4.5 Phase 2): the area
         the map + search filter to. Sits directly above View mode. Buttons carry a
         data-scope token (region:<slug> / country:<cc> / everywhere) that map.js
         hands to window.CCScope; labels come from region.<slug>.label. #}
      {% if regions is not empty %}
      <div class="grp">
        <h3>{{ 'map.region'|trans }}</h3>
        <div class="scope-toggle" id="regionScope">
          {# My area (map-and-search.md §4.5 Phase 4): the rider's home-base
             circle, FIRST in the group. Revealed by map.js only when CCScope has a
             My-area source (logged-in base location or anonymous circle); the token is
             the bare literal 'myarea' — never coordinates. #}
          <button type="button" data-scope="myarea" id="myAreaBtn" hidden>{{ 'region.my_area.label'|trans }}</button>
          {# Region + country chips are rendered by map.js renderScopeChips() from
             the contextual home country (map-and-search.md §4.5);
             the flat all-regions wall is gone. #}
          <div id="scopeChips"></div>
          <button data-scope="everywhere">{{ 'region.everywhere.label'|trans }}</button>
        </div>
        {# "Set my area" cold-start prompt (map-and-search.md §4.5
           Phase 4): the pref-chip pattern — hidden here, revealed by map.js only
           when the rider has NO My-area source yet (no base location, no anon
           circle) and hasn't dismissed it. Tapping derives the base from the map
           centre (Komoot's suggest-home pattern); coordinates are rounded to 2
           decimals before they ever leave the page. #}
        <div class="chips cc-area-prompt" id="areaPromptRow" hidden>
          <span class="chip" id="areaPromptSet" role="button" tabindex="0">{{ 'map.set_my_area'|trans }}</span>
          <button type="button" class="cc-area-x" id="areaPromptX" aria-label="{{ 'map.area_dismiss'|trans }}">✕</button>
        </div>
      </div>
      {% endif %}

      {# Empty-scope invite (moderation-and-contribution.md
         §10.1): one link, never a form. panels.js initChips() reveals it only
         when the active scope resolves to a country and the catalog shows zero
         curated features — the page at /join/{cc} owns the form, validation
         and four-locale copy. #}
      <div id="emptyScopeInvite" class="rail-invite" hidden>
        <a href="/join">{{ 'map.empty_scope_invite'|trans }}</a>
      </div>
      </section>

      <section class="panel" id="p-layers">
      {# Layers and filters are ONE panel (owner 2026-08-20: "people will not
         understand why they are missing data. Technically view mode is also a
         filter"). Everything that can make the map show less lives here, in
         one order: what to show, then which layers, then which values. #}
      {# View mode is the primary filter (curated best-of vs the full backlog), so it sits right
         under Region. Its active button is styled bright (#mode in the CSS) so the current mode
         is obvious at a glance. #}
      <div class="grp">
        <h3>{{ 'map.view_mode'|trans }}</h3>
        {# Everything carries the server-rendered `on`, because it is the GLOBAL
           default and so the
           common case. panels.js initViewMode() repaints this only when the
           precedence resolves to Curated — a saved profile mode, an anonymous
           visitor's earlier choice, or a region a moderator has flipped. #}
        <div class="toggle" id="mode">
          <button data-m="curated">{{ 'map.curated'|trans }}</button>
          {# The middle rung (owner 2026-08-12): everything a human has vouched
             for. Between the editor's best-of and the raw import, and a true
             superset of the first - a curated place counts as vouched for even
             before a rider has stood at it. #}
          <button data-m="confirmed">{{ 'map.confirmed'|trans }}</button>
          <button class="on" data-m="all">{{ 'map.everything'|trans }}</button>
        </div>
        <div class="hint">{{ 'map.curated_hint'|trans }}</div>
      </div>

      {# Data layers. The rows are rendered by panels.js initLayerList() in
         catalog reading order, grouped into the utilities that aim for full
         coverage and the layers riders vote into a best-of. #}
      <div class="grp">
        <h3 class="dl-head">{{ 'map.data_layers'|trans }} <button class="dl-all" id="layersAll" type="button">{{ 'map.deselect_all'|trans }}</button></h3>
        <div id="layers"></div>
      </div>

      {# Map overlays. These two used to sit in the top-right corner as if they
         were a different kind of thing; they are layers, and a rider looking
         for "why can I not see surfaces" looks at the layers. Both rows stay
         hidden until their tile artifact exists (panels.js): a control for
         tiles nobody built reads as broken, not absent. #}
      <div class="grp">
        <h3>{{ 'map.map_overlays'|trans }}</h3>
        <button class="layer ov-row" id="ovSurface" type="button" hidden aria-pressed="false"><span class="sw" style="--c:#C8923A;--ic:#101E16"><i class="sw-g">▰</i></span><span class="nm">{{ 'map.surfaces'|trans }}</span><span class="ct">{{ 'map.overlay_off'|trans }}</span></button>
        <button class="layer ov-row" id="ovRoutes" type="button" hidden aria-pressed="false"><span class="sw" style="--c:#7A4FCF;--ic:#EFE6D4"><i class="sw-g">⤳</i></span><span class="nm">{{ 'map.route_network'|trans }}</span><span class="ct">{{ 'map.overlay_off'|trans }}</span></button>
      </div>

      {# Filters. Every group in here can make the map show LESS, which is why
         they are gathered under one heading with one explanation, and why the
         on-map pill exists (Task 6): a rider must never have to guess that a
         chip three scrolls up is the reason a place is missing.

         f-match / f-optin say which way a group narrows, and the pill's reset
         reads those classes. All four chip facets share attrMatch()'s rule
         (render.js): every chip on hides nothing, and deselecting one hides
         items that cannot be confirmed to match. The preference chip is the
         other kind - it narrows only while it is ON.

         The Discipline chips (#disc) were RETIRED on 2026-08-03, the same call
         that removed the loop planner and the Freshness chips the day before
         (map-and-search.md §4.3): they toggled, they looked like a filter, and
         they filtered nothing, because no server path tags an item with a
         riding style. A control that does nothing is not a placeholder for the
         real one, it is a lie about what the map can do. RidingStyle stays the
         vocabulary a rider saves in their profile and stays the contract they
         will be rebuilt on - when the DATA carries style tags, not before. #}
      <div class="grp" id="filters">
        <h3>{{ 'map.filters_head'|trans }}</h3>

        {# The Best-of facets. They were in the View mode band, which is where
           they belong logically and NOT where a rider looks: the map subtitle
           said "Best of · Summer · Road" and the only bike control anybody
           could find was the profile chip below (owner-reported 2026-08-20).
           They narrow what shows, so they are filters, and they sit first
           because they narrow harder than any chip under them.

           Hidden outside Best of by initViewMode()/initBestOf(), because that
           is the only mode they change anything in. The hint says where the
           season came from: nothing chose it, it is simply today's. #}
        <div class="best-facets" id="bestFacets" hidden>
          <h4 class="fh">{{ 'map.best_season'|trans }}</h4>
          <div class="chips f-optin" id="boSeason">
            <span class="chip" data-v="spring">{{ 'map.season_spring'|trans }}</span><span class="chip" data-v="summer">{{ 'map.season_summer'|trans }}</span>
            <span class="chip" data-v="autumn">{{ 'map.season_autumn'|trans }}</span><span class="chip" data-v="winter">{{ 'map.season_winter'|trans }}</span>
          </div>
          <h4 class="fh">{{ 'map.best_bike'|trans }}</h4>
          <div class="chips f-optin" id="boBike">
            <span class="chip" data-v="Road">{{ 'map.bike_road'|trans }}</span><span class="chip" data-v="Gravel">{{ 'map.bike_gravel'|trans }}</span>
            <span class="chip" data-v="MTB">{{ 'map.bike_mtb'|trans }}</span><span class="chip" data-v="E-bike">{{ 'map.bike_ebike'|trans }}</span>
            <span class="chip" data-v="Handbike">{{ 'map.bike_handbike'|trans }}</span><span class="chip" data-v="Recumbent">{{ 'map.bike_recumbent'|trans }}</span>
            <span class="chip" data-v="Trike">{{ 'map.bike_trike'|trans }}</span><span class="chip" data-v="Tandem">{{ 'map.bike_tandem'|trans }}</span>
          </div>
        </div>

        {# A filter for a layer that is not on the map explains nothing and
           makes the block longer for everyone (owner 2026-08-20: "still find
           the filter too crowded"). data-layer names the layer this facet
           describes; panels.js syncFilterGroups() hides the pair whenever that
           layer is switched off or holds nothing in the current scope. The
           same rule the legend and the overlay rows already follow. #}
        <div class="fsub" data-layer="climbs" hidden>
        <h4 class="fh">{{ 'map.climb_surface'|trans }}</h4>
        <div class="chips f-match" id="sqf">
          <span class="chip on" data-v="Smooth">{{ 'map.surf_smooth'|trans }}</span><span class="chip on" data-v="Good">{{ 'map.surf_good'|trans }}</span>
          <span class="chip on" data-v="Worn">{{ 'map.surf_worn'|trans }}</span><span class="chip on" data-v="Rough">{{ 'map.surf_rough'|trans }}</span>
          {# The fifth value. Missing here, it was a climb-eating hole: see ALL_SURF in render.js. #}
          <span class="chip on" data-v="Broken / loose">{{ 'map.surf_broken'|trans }}</span>
        </div>

        <h4 class="fh">{{ 'map.climb_traffic'|trans }}</h4>
        <div class="chips f-match" id="trf">
          <span class="chip on" data-v="Traffic-free">{{ 'map.traffic_free'|trans }}</span><span class="chip on" data-v="Quiet">{{ 'map.traffic_quiet'|trans }}</span>
          <span class="chip on" data-v="Moderate">{{ 'map.traffic_moderate'|trans }}</span><span class="chip on" data-v="Busy">{{ 'map.traffic_busy'|trans }}</span>
        </div>

        <h4 class="fh">{{ 'map.climb_effort'|trans }}</h4>
        <div class="chips f-match" id="effortf">
          <span class="chip on" data-v="Steady">{{ 'map.effort_steady'|trans }}</span><span class="chip on" data-v="Challenging">{{ 'map.effort_challenging'|trans }}</span>
          <span class="chip on" data-v="Tough">{{ 'map.effort_tough'|trans }}</span><span class="chip on" data-v="Very steep">{{ 'map.effort_very_steep'|trans }}</span>
        </div>
        </div>

        <div class="fsub" data-layer="stays" hidden>
        <h4 class="fh">{{ 'map.stay_access'|trans }}</h4>
        <div class="chips f-match" id="accessf">
          <span class="chip on" data-v="Step-free access">{{ 'map.access_step_free'|trans }}</span><span class="chip on" data-v="Handbike-friendly">{{ 'map.access_handbike'|trans }}</span>
          <span class="chip on" data-v="Wheelchair-accessible">{{ 'map.access_wheelchair'|trans }}</span>
        </div>
        </div>

        {# Preference prefilter chip (spec 2026-07-14): revealed by panels.js
           only when the logged-in rider has saved bike types. Never silent -
           the chip is the visible "your prefs are filtering routes"
           affordance and its own opt-out. #}
        <div id="prefGrp" hidden>
          <h4 class="fh">{{ 'map.pref_filter_head'|trans }}</h4>
          <div class="chips f-optin"><span class="chip" id="prefFilter" role="button" tabindex="0" aria-pressed="false">{{ 'map.pref_filter'|trans }}</span></div>
        </div>

        <h4 class="fh">{{ 'map.heatmap_title'|trans }} <span class="fh-note">{{ 'map.heatmap_derived'|trans }}</span></h4>
        <div class="toggle" id="heattoggle">
          <button class="on" data-h="off">{{ 'map.heat_off'|trans }}</button>
          <button data-h="on">{{ 'map.heat_on'|trans }}</button>
        </div>
        <div class="chips" id="season" style="margin-top:.6rem">
          <span class="chip on" data-s="all">{{ 'map.season_all'|trans }}</span><span class="chip" data-s="spring">{{ 'map.season_spring'|trans }}</span><span class="chip" data-s="summer">{{ 'map.season_summer'|trans }}</span><span class="chip" data-s="autumn">{{ 'map.season_autumn'|trans }}</span><span class="chip" data-s="winter">{{ 'map.season_winter'|trans }}</span>
        </div>
      </div>
      </section>

      <section class="panel" id="p-tools">
      {# Every tool below is shown to everyone. Riders-only ones render locked
         when logged out — same heading, same description, with the control
         replaced by a link to log in. #}
      {# Ride-check: open to anyone. The file is posted to /map/ride-check,
         answered, and discarded; the notice below is a user requirement and
         must stay visible. Anonymous callers get 5 a day, keyed on a salted
         hash of their address. #}
      <div class="grp cc-ridecheck">
        <h3>{{ 'ride_check.title'|trans }}</h3>
        {# What the tool IS, before what it costs. The notice below is a
           requirement and stays; it answers a question a rider only asks once
           they already know what they would be uploading. #}
        <div class="hint" style="margin-top:0">{{ 'map.ride_check_intro'|trans }}</div>
        <div class="hint">{{ 'ride_check.hint'|trans }}</div>
        <input type="file" id="rcFile" accept=".gpx" hidden>
        <div class="cc-ride-row">
          <button class="cc-ride-btn" id="rcPick" type="button">{{ 'ride_check.button'|trans }}</button>
          <label class="cc-ride-radius">{{ 'ride_check.within'|trans }}
            {# The values stay metres — the server only accepts its own fixed
               set (RideCheckService::ALLOWED_RADII) — while the labels follow
               the rider's unit. #}
            <select id="rcRadius" aria-label="{{ 'ride_check.radius'|trans }}">
              <option value="100">{{ 100|cc_m }}</option>
              <option value="250" selected>{{ 250|cc_m }}</option>
              <option value="500">{{ 500|cc_m }}</option>
              <option value="1000">{{ 1000|cc_m }}</option>
            </select>
          </label>
        </div>
        <div class="cc-ride-status" id="rcStatus" role="status" hidden></div>
        {# The notice stays in both states: it answers what would happen to a
           file, which is worth knowing before deciding to sign up. #}
        <p class="cc-ride-note">{{ 'ride_check.notice'|trans }}</p>
      </div>

      {# Scout: the same ride file, read the other way round. Ride check asks
         what is already near a route; scout turns what a rider SAW on it into
         submissions. /scout/review is ROLE_USER, so logged out this renders
         locked rather than as a link that would land on a login wall. #}
      <div class="grp">
        <h3>{{ 'map.scout_heading'|trans }}</h3>
        {% if is_granted('ROLE_USER') %}
        <a class="cc-addclimb-go" href="{{ path('scout_review') }}">{{ 'map.scout_review'|trans }}</a>
        {% else %}
        {% include 'map/_locked_tool.html.twig' with {label: 'map.scout_review'|trans} only %}
        {% endif %}
        <p class="cc-addclimb-note">{{ 'map.scout_hint'|trans }}</p>
      </div>

      {# "Add a climb here" (owner asked 2026-08-14: "how do we add a new climb
         via the map as a normal user"). Until now the answer was that you
         cannot: the map's only contribution affordance is the /contribute link
         in the map-top box, so a rider had to leave, find the climb wizard, and
         then re-locate the climb from scratch in its own small map while having
         been looking straight at it.

         /add-climb is ROLE_USER, so logged out this renders locked. Anonymous
         riders also reach it through /contribute, which lists it.

         The href is rewritten by panels.js initAddClimbHere() on every map
         move, so what the wizard opens on is what the rider was looking at. #}
      <div class="grp cc-addclimb">
        <h3>{{ 'map.add_climb_heading'|trans }}</h3>
        {% if is_granted('ROLE_USER') %}
        <a class="cc-addclimb-go" id="addClimbHere" href="{{ path('add_climb') }}">{{ 'map.add_climb_here'|trans }}</a>
        {% else %}
        {% include 'map/_locked_tool.html.twig' with {label: 'map.add_climb_here'|trans} only %}
        {% endif %}
        <p class="cc-addclimb-note">{{ 'map.add_climb_note'|trans }}</p>
      </div>

      {# Anything that is not a climb goes through the wizard, which the map's
         own orange Contribute button opens. Said here because this is the
         panel a rider opens looking for "how do I add something". #}
      <div class="grp">
        <h3>{{ 'map.contribute'|trans }}</h3>
        <a class="cc-addclimb-go" href="{{ path('contribute') }}">{{ 'map.contribute'|trans }}</a>
        <p class="cc-addclimb-note">{{ 'map.contribute_hint'|trans }}</p>
      </div>

      {# What the map is drawing right now. render.js rewrites #count on every
         pass, so the id travels with the element. #}
      <div class="grp">
        <h3>{{ 'map.on_the_map'|trans }}</h3>
        <div class="res"><b id="count">0</b> {{ 'map.places_shown'|trans }}</div>
      </div>
      </section>

      </div>
    {# Drawer foot: which data build THIS page is drawing, plus the build stamp
       version.js appends here. Outside the panels on purpose - it answers the
       same question whichever section is open, and it is a diagnostic rather
       than something a rider reads. #}
    <div class="dwr-foot">
      <div class="data-versions" id="dataVersions" title="{{ 'map.data_versions_title'|trans }}"></div>
    </div>
    </div>
  </aside>

  <!-- ============ MAP ============ -->
  <div class="mapcol">
  <main class="map-wrap">
    <div id="map"></div>
    <div class="map-top">
      <div class="rg" id="regionLine">{{ 'map.region_line'|trans }}</div>
      <div class="sub">{{ 'map.curated'|trans }}</div>
      <a class="add-climb" href="{{ path('contribute') }}">{{ 'map.contribute'|trans }}</a>
    </div>
    <div class="legend">
      {# Collapsible on every screen, not just phones (owner 2026-08-16). The
         key is a reference, not a permanent fixture: a rider who has learnt
         the colours wants the map back, and on a laptop the panel covers a
         real corner of it. One class does it everywhere - `collapsed` on the
         panel, `#lgBody` hidden - so a new key section can never be forgotten
         out of the hide list the way `.rkey` just was. #}
      <button class="lg-toggle" id="lgToggle" type="button" aria-controls="lgBody"
              aria-label="{{ 'map.legend_aria'|trans }}" aria-expanded="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="lg-body" id="lgBody">
      {# The key serves BOTH the curated A layer and the Surfaces tile skin —
         same seven classes, same colours, deliberately (SURFACE_STYLE is
         shared). Dropping the "· A" because it is no longer only A's key.

         Wrapped and hidden by panels.js when NEITHER is on screen (owner
         2026-08-16): with the skin off and the Road-surface layer empty or
         switched off, six colours were being explained for a map that had none
         of them on it. #}
      <div class="skey-block" id="surfaceKey">
      <h4>{{ 'item_type.road-surface.label'|trans }}</h4>
      <div class="skey">
        <button type="button" class="skey-row" data-surf-cls="paved" aria-pressed="true"><span class="skey-ln" style="--sc:#4E6E66"></span>{{ 'map.legend_paved'|trans }}</button>
        <button type="button" class="skey-row" data-surf-cls="gravel" aria-pressed="true"><span class="skey-ln" style="--sc:#C8923A"></span>{{ 'map.legend_gravel'|trans }}</button>
        <button type="button" class="skey-row" data-surf-cls="pave" aria-pressed="true"><span class="skey-ln" style="--sc:#6E7B96"></span>{{ 'map.legend_cobbles'|trans }}</button>
        <button type="button" class="skey-row" data-surf-cls="dirt" aria-pressed="true"><span class="skey-ln" style="--sc:#6E5849"></span>{{ 'map.legend_dirt'|trans }}</button>
        <button type="button" class="skey-row" data-surf-cls="rock" aria-pressed="true"><span class="skey-ln" style="--sc:#5F5A54"></span>{{ 'map.legend_rock'|trans }}</button>
        <button type="button" class="skey-row" data-surf-cls="unverified" aria-pressed="true"><span class="skey-ln dash" style="--sc:#D92D20"></span>{{ 'map.legend_unverified'|trans }}</button>
      </div>
      {# Quality ticks are an ANNOTATION on the class lines, not an eighth
         class: this row explains, it does not filter (surface-tiles.js draws
         ticks only where OSM smoothness exists, z13+). #}
      <div class="skey-note"><span class="skey-ticks" aria-hidden="true"></span>{{ 'map.legend_quality'|trans }}</div>
      {# Study mode belongs with the key: it is about reading these classes. #}
      <button type="button" class="skey-study" id="skeyStudy" aria-pressed="false">{{ 'map.study_mode'|trans }}</button>
      {# The gaps grid, opt-in (owner 2026-08-14): at planning zoom the red
         squares tinted whole regions pink (purple over water) and read as
         somebody else's basemap. Off by default; the label says what the
         squares MEAN, so the toggle is its own legend. Revealed by panels.js
         only while the surface skin is on. #}
      <button type="button" class="skey-study" id="skeyGaps" aria-pressed="false" hidden
        title="{{ 'map.gaps_grid_title'|trans }}">{{ 'map.gaps_grid'|trans }}</button>
      </div>
      {# Cycle-route key. Revealed by panels.js only while the routes overlay is
         on, the same rule the gaps toggle follows: a key for an absent layer
         explains nothing and makes the legend longer for everyone.

         THREE rows, not six networks. A rider plans against "national route",
         "regional network", "mountain bike"; icn/ncn and rcn/lcn/other merge in
         routes-tiles.js GROUPS and the key has to say what the map draws, not
         what the extractor stored. The colours here are pinned against that
         file by routes-legend.test.cjs - a key that drifts from the map is
         worse than none.

         These rows do NOT filter, unlike the surface rows above. They carry no
         checkmark and no press state for exactly that reason. #}
      <div class="rkey" id="routesKey" hidden>
        <h4>{{ 'map.route_network'|trans }}</h4>
        <div class="skey">
          <div class="rkey-row"><span class="skey-ln" style="--sc:#C84E64"></span>{{ 'map.legend_route_national'|trans }}</div>
          <div class="rkey-row"><span class="skey-ln" style="--sc:#7A4FCF"></span>{{ 'map.legend_route_regional'|trans }}</div>
          <div class="rkey-row"><span class="skey-ln" style="--sc:#8A5A32"></span>{{ 'map.legend_route_mtb'|trans }}</div>
        </div>
        {# The numbered badges are what the node network IS - most of a Dutch or
           Belgian screen is these - so the key names them rather than leaving a
           rider to work out that the circles are junctions. An explanation, in
           the quality-note style. #}
        <div class="skey-note"><span class="rkey-node" aria-hidden="true">7</span>{{ 'map.legend_route_node'|trans }}</div>
      </div>
      </div>
    </div>
    {# Top-right: two glass icon buttons and nothing else. The base picker is
       a flyout rather than an always-open segment, because a rider changes
       base map rarely and looks at the map constantly. The flyout is a SIBLING
       of its button, never a child: a <button> inside a <button> is un-nested
       by the browser and the menu ends up outside the control. #}
    <div class="tr" aria-label="{{ 'map.base_aria'|trans }}">
      <div class="trw">
        <button class="trb" id="tr-base" type="button" aria-label="{{ 'map.base_layers_aria'|trans }}" aria-haspopup="menu" aria-expanded="false" aria-controls="fly-base">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
        </button>
        {# #baseSeg keeps its id and its data-b buttons: panels.js binds them
           and hides the whole picker when there is no satellite layer. #}
        <div class="fly" id="fly-base" role="menu">
          <div id="baseSeg">
            <button class="on" type="button" role="menuitem" data-b="map">{{ 'map.base_map'|trans }}</button>
            <button type="button" role="menuitem" data-b="satellite">{{ 'map.base_satellite'|trans }}</button>
          </div>
        </div>
      </div>
      {# #ovStreet keeps its id: mapillary.js initStreetToggle() binds it, and
         marks it .mc-off when there is no Mapillary token. #}
      <button class="trb" id="ovStreet" type="button" aria-label="{{ 'map.street_level'|trans }}" data-tip="{{ 'map.street_level'|trans }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="2.6"/><path d="M12 10v5m0 0-3 6m3-6 3 6M6 12l6-1.5L18 12"/></svg>
      </button>
    </div>
    {# "Where did my data go?", answered ON the map (owner 2026-08-20). Any chip
       filter that narrows the catalog raises this pill with a one-tap reset,
       and the Layers icon in the rail wears a dot at the same time - so the
       answer is visible whether or not the drawer is open. panels.js fills it
       from render.js's cc:filters event; the count is a real tally from the
       render pass, never an estimate. #}
    {# Why the map can be empty at low zoom (owner-reported 2026-08-14, twice,
       once for South Africa and once for Northern Cape). The coverage TILESET
       starts at z6 and its individual icons at z9, so below those the map
       draws nothing at all - correctly, and silently, which is
       indistinguishable from missing data. It sits ON the map, beside the zoom
       controls, because it has to be readable WHILE a rider is zooming; the
       drawer is closed by default and would never be. Filled by render.js on
       every zoom. #}
    <div class="zoom-hint" id="zoomHint" hidden></div>
    <div class="fpill" id="fpill" role="status" hidden>
      <span id="fpillMsg"></span>
      <button type="button" id="fpillReset">{{ 'map.filters_show_all'|trans }}</button>
    </div>
    <a class="contrib-fab" href="{{ path('contribute') }}" aria-label="{{ 'map.contribute_aria'|trans }}"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></a>
    <aside class="cc-drawer" id="drawer" tabindex="-1" aria-hidden="true" aria-label="{{ 'map.drawer_aria'|trans }}">
      <button class="cc-d-grab" id="drawerGrab" type="button" aria-label="{{ 'map.drawer_grab'|trans }}"><span></span></button>
      <button class="cc-drawer-x" id="drawerClose" aria-label="{{ 'map.drawer_close'|trans }}">✕</button>
      <div class="cc-drawer-body" id="drawerBody"></div>
    </aside>
    <div class="cc-d-scrim" id="drawerScrim"></div>
    <div class="cc-tooltip" id="tip" hidden></div>
    <div class="cc-lightbox" id="lightbox" aria-hidden="true">
      <button class="cc-lb-x" aria-label="{{ 'map.lb_close'|trans }}">✕</button>
      <button class="cc-lb-nav cc-lb-prev" aria-label="{{ 'map.lb_prev'|trans }}" hidden>‹</button>
      <div class="cc-lb-stage"><img alt="" /><div class="cc-lb-cap"></div></div>
      <button class="cc-lb-nav cc-lb-next" aria-label="{{ 'map.lb_next'|trans }}" hidden>›</button>
    </div>
    {# The full climb profile (assets/map/climb-profile.js), opened by clicking
       the drawer's gradient strip. Its own overlay rather than the photo
       lightbox: that one is a slideshow with prev/next and a credit line. #}
    <div class="cc-cp" id="climbProfile" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'map.profile_title'|trans }}">
      <div class="cc-cp-panel">
        <button class="cc-cp-x" aria-label="{{ 'map.lb_close'|trans }}">✕</button>
        <div class="cc-cp-head">
          <div class="cc-cp-title"></div>
          <div class="cc-cp-sub"></div>
        </div>
        <div class="cc-cp-stage"></div>
      </div>
    </div>
    {% if scout_review|default(false) %}{% include 'map/_scout_review.html.twig' %}{% endif %}
    <section class="mly-dock" id="mlyDock" aria-hidden="true" aria-label="{{ 'map.mly_title'|trans }}">
      <div class="mly-grip" id="mlyGrip" role="separator" aria-orientation="horizontal" tabindex="0"
           aria-label="{{ 'map.mly_resize'|trans }}" title="{{ 'map.mly_resize_hint'|trans }}"></div>
      <div class="mly-bar">
        <span class="mly-t" id="mlyTitle">{{ 'map.mly_title'|trans }}</span>
        <button id="mlyFull" title="{{ 'map.mly_expand'|trans }}" aria-label="{{ 'map.mly_expand'|trans }}">⤢</button>
        <button id="mlyClose" title="{{ 'map.mly_close'|trans }}" aria-label="{{ 'map.mly_close'|trans }}">✕</button>
      </div>
      <div class="mly-view" id="mlyView"></div>
      <div class="mly-loading" id="mlyLoad"><span class="mly-spin"></span>{{ 'map.mly_loading'|trans }}</div>
    </section>
  </main>
  </div>
</div>
<script src="{{ asset('lib/maplibre-gl-5.24.0.js') }}"></script>
{# pmtiles protocol adapter for the coverage vector source
   (coverage-provider.md §4/§6) — vendored same-origin (self-hosted 2026-08-09)
   exactly like maplibre-gl above. map.js only registers the protocol when
   window.CC_COVERAGE_URL is set (the COVERAGE_TILES manifest injection), so
   with the flag off this script is inert. #}
<script src="{{ asset('lib/pmtiles-4.4.1.js') }}"></script>
<script nonce="{{ csp_nonce() }}">window.MAPILLARY_TOKEN = {{ mapillary_token|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
{# The satellite layer's Esri key. Public by design — it ships to the browser,
   like MAPILLARY_TOKEN — and restricted at Esri to our referrers. Empty means
   no satellite layer, which is how a missing OR lapsed key behaves. #}
window.CC_ESRI_KEY = {{ esri_api_key|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
{# The lazily-injected street-view library is vendored (self-hosted 2026-08-09)
   and its digested URLs only exist in Twig, so they cross to mapillary.js
   here. #}
window.CC_VENDOR = {{ {
  mapillaryJs: asset('lib/mapillary-js-4.1.2.js'),
  mapillaryCss: asset('lib/mapillary-js-4.1.2.css')
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
{% if pending is defined %}
<script nonce="{{ csp_nonce() }}">
  {# CC_IS_CURATOR is the moderation-chrome switch; a rider gets their OWN
     pending rows (MapController) but never this flag, so the pending pins
     render without any decide controls. The flag comes from the CONTROLLER,
     never is_granted() here: a setup-pending curator holds the role but not
     the capability (the 2FA policy applies in exactly one place). #}
  {% if pending_is_curator|default(false) %}window.CC_IS_CURATOR = true;{% endif %}
  window.CC_PENDING = {{ pending|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# Places approved as "Not there anymore" — the curator ghost layer, so a
     rebuilt place can be found and reactivated via the ordinary edit form.
     Riders never receive this: the public payload hides gone items for good. #}
  window.CC_GONE = {{ gone|default([])|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# The map drawer is now the ONLY place a submission is approved/rejected
     (the queue list carries no decision form anymore) — so the decision CSRF
     token is emitted here directly, not scraped from the /moderate page.
     Forms use the global stateless token id 'submit' (config/packages/csrf.yaml
     → framework.form.csrf_protection.token_id), so that is the id to mint. #}
  window.CC_MOD_TOKEN = {{ csrf_token('submit')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
</script>
{% endif %}
{# Ride-check is open to everyone, so its URL and token sit outside the riders
   block below. A token shipped only to signed-in visitors would leave the
   control on the page unable to post. #}
  window.CC_RIDECHECK = {
    url: {{ path('map_ride_check')|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }},
    token: {{ csrf_token('ride-check')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
  };

{% if is_granted('ROLE_USER') %}
<script nonce="{{ csp_nonce() }}">
  {# Ride-check (spec 2026-07-14 §4.3): endpoint + stateless CSRF token for the
     logged-in GPX upload. Riders-only block — anonymous visitors get no control. #}

  {# Confirming an OSM place has no item to fetch a token from — the point is
     that it is not one of ours yet — so the page carries it, the way the
     ride-check token below is carried. Same id as the item panel's
     ('item-confirm'): one token id, one meaning.

     It lives in the RIDERS block, not the curator one: every signed-in rider
     may answer, and its ABSENCE is the auth signal the drawer reads to show
     "log in to confirm" instead of a button that cannot work. #}
  window.CC_CONFIRM_TOKEN = {{ csrf_token('item-confirm')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# "My area" base location (map-and-search.md §4.5): the stored
     coarse point + derived region/country set from MapController::map's
     `my_area` param, merged with the set-my-area endpoint + stateless CSRF
     token. null lat/lng/place and empty arrays when no base location is
     set — riders-only block, same as CC_RIDECHECK above. Unlike
     CC_RIDECHECK, `url` rides the single merged json_encode() with the
     HEX_* flags (not a separate JSON_UNESCAPED_SLASHES call) — deliberate,
     not drift: merge() has to produce one PHP array before encoding, so
     every key shares one flag set. HEX-escaped "\/" and unescaped "/"
     decode to the identical JS string either way. #}
  window.CC_MY_AREA = {{ (my_area ?? {})|merge({url: path('map_my_area_set'), token: csrf_token('my-area')})|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# View-mode persistence: a
     logged-in rider's view-mode choice is saved to their PROFILE, not
     to localStorage, so a shared device never leaks it to the next person.
     Riders-only block — an anonymous visitor gets no endpoint, and panels.js
     falls back to localStorage when this is absent. #}
  window.CC_MAP_MODE = {
    url: {{ path('map_view_mode')|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }},
    token: {{ csrf_token('map-view-mode')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
  };
  {# Chrome-theme persistence: same profile-over-localStorage rule as
     CC_MAP_MODE above. Riders-only block — theme.js falls back to
     localStorage when this is absent. #}
  window.CC_MAP_THEME = {
    url: {{ path('map_theme')|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }},
    token: {{ csrf_token('map-theme')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
  };
</script>
{% endif %}
<script nonce="{{ csp_nonce() }}">
  {# Non-prod only: lets map.js publish window.__ccMap, the handle the browser
     smoke sweep (web/tests/browser/map-smoke.js) needs to assert on layers and
     sources. Production ships neither the flag nor the handle. #}
  {% if app.environment != 'prod' %}window.CC_DEBUG = true;{% endif %}
  {# ?v= busts the browser's hour-long catalog cache the moment the catalog
     changes (CatalogProvider::versionTag) — without it, a rider whose
     submission was just approved reloads into the pre-approval payload and
     watches their contribution "disappear" until the max-age runs out. #}
  window.CC_CATALOG_URL = {{ (path('map_catalog') ~ '?v=' ~ catalog_version)|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }};
  {# The heat points live off the critical payload; fetched on the first heatmap-On only. #}
  window.CC_HEAT_URL = {{ path('map_heat')|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }};
  {# Seasonal voting go-live (community.voting_live): false hides every vote
     call-to-action on the map. #}
  window.CC_VOTING_LIVE = {{ voting_live|default(false) ? 'true' : 'false' }};
  window.CC_MAP_SRC = {{ asset('map/map.js')|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }};
  window.CC_FIELD_SCHEMA = {{ field_schema|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# Locale bundle for the strings map.js renders itself (layer list, subtitle,
     drawer, toasts) — built by MapController::mapI18n, one source of truth. #}
  window.CC_I18N = {{ map_i18n|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  window.CC_PREFS = {{ rider_prefs|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# Region registry (map-and-search.md §4.5 Phase 2): id/slug/cc/bbox
     per region, consumed by window.CCScope for the scope selector + viewport. #}
  window.CC_REGIONS = {{ regions|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% if coverage_url %}
  {# Coverage tiles (coverage-provider.md §4): the versioned
     PMTiles artifact URL — emitted only when COVERAGE_TILES is on AND the
     manifest resolved; map.js keys the whole coverage source on its presence.
     HEX-escaped like MAPILLARY_TOKEN: the value originates outside the app. #}
  window.CC_COVERAGE_URL = {{ coverage_url|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# Country codes the tile artifact was built for: map.js turns each into a per-(letter, country)
     coverage layer; an empty/absent array falls back to one unsplit layer per
     letter, so an old manifest still renders. #}
  window.CC_COVERAGE_COUNTRIES = {{ coverage_countries|default([])|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% endif %}
  {# Road-surface LINE tiles: a SEPARATE artifact from the coverage points
     (docs/specs/coverage-provider.md §4), so it has its own URL and
     its own gate. Absent/empty means the Surfaces toggle never renders — a
     control for a layer whose tiles do not exist is worse than no control,
     which is the toilets lesson (a rail row for a layer that was never built).
     HEX-escaped like the others: the value originates outside the app. #}
  {% if surface_tiles_url %}
  window.CC_SURFACE_URL = {{ surface_tiles_url|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% endif %}
  {# Each arm gates on ITSELF. They are separate artifacts and a build can
     legitimately publish one without the others (a pinned classified URL for a
     bisect, a gaps-only experiment), so nesting them under the classified gate
     would hide a layer that exists. #}
  {% if surface_todo_url %}
  window.CC_SURFACE_TODO_URL = {{ surface_todo_url|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% endif %}
  {% if surface_gaps_url %}
  window.CC_SURFACE_GAPS_URL = {{ surface_gaps_url|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% endif %}
  {# Cycle-route network tiles (routes-tiles.js): corridors + knooppunt
     numbers, one artifact. Absent/empty means the Routes toggle never renders
     — the same no-control-for-missing-tiles rule as the surface skin. #}
  {% if routes_tiles_url %}
  window.CC_ROUTES_URL = {{ routes_tiles_url|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {% endif %}
  {# Scout review: the tag vocabulary with the letters each tag may resolve to,
     from ScoutTag::LETTERS — the same list the intake endpoint validates
     against, so the panel can never offer a choice the server refuses.

     NOT gated on the surface tiles, though it used to be — it sat inside that
     block, so an instance with no surface artifact shipped no tag vocabulary
     and the ride-review panel lost the list it validates against. Scout reads
     rides; it does not need a tile artifact to exist. #}
  window.CC_SCOUT_TAGS = {{ scout_tags|default({})|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  window.CC_SCOUT_DETAILS = {{ scout_details|default({})|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
  {# The stateless 'scout-tags' CSRF token scout-review.js sends as X-CC-Token
     (config/packages/csrf.yaml stateless_token_ids). #}
  window.CC_SCOUT_TOKEN = {{ csrf_token('scout-tags')|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
</script>
