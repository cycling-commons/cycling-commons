{# And the catalog itself: catalog-load.js starts this ~1 MB fetch only after
   the vendor scripts execute; the preload puts it in flight from the preamble,
   overlapping the maplibre/pmtiles downloads. crossorigin IS required even
   same-origin: fetch() runs mode=cors + credentials=same-origin, and a bare
   preload runs credentials=include — Chrome reports the mismatch and refetches
   (verified in the console, 2026-08-09). crossorigin(=anonymous) makes the
   preload's credentials mode match fetch()'s. #}
<link rel="preload" as="fetch" href="{{ path('map_catalog') }}" crossorigin>
{# The rider's units (account-and-auth.md §9). This page does NOT extend
   base.html.twig, so it carries its own copy of the bridge — without it every
   distance the map draws would stay metric while the same rider's moderation
   tables and settings page read miles, which is the disagreement the whole
   preference exists to prevent. Loaded before scope-header.js (it writes the
   "Near X · 30 mi" line synchronously) and before the module graph below. #}
<script nonce="{{ csp_nonce() }}">
  window.CC_UNITS = {{ {
    distance: cc_user_distance_unit(),
    elevation: cc_user_elevation_unit()
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
</script>
<script src="{{ asset('js/cc-units.js') }}"></script>
