{# A tool a visitor cannot use yet: named, and offering the one action that
   unlocks it. Hiding it instead teaches nobody that it exists. #}
<a class="cc-locked" href="{{ path('login') }}">{{ label }}</a>
<p class="cc-locked-hint">{{ 'map.locked_hint'|trans }}</p>
