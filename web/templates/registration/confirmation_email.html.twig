{# Email verification confirmation email — branded shell from emails/_base. #}
{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'registration.email.title'|trans }}{% endblock %}

{% block content %}
  <h1 style="font-size:24px;font-weight:600;margin:0 0 14px">
    {# No display name: the address may belong to someone who never signed up,
       and the name is whatever the sender typed. #}
    {{ 'registration.email.welcome_pre'|trans }}!
  </h1>

  <p style="margin:0 0 8px">{{ 'registration.email.body'|trans }}</p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:26px 0;border-collapse:collapse">
    <tr>
      <td align="center" style="background:#e85d26;border-radius:6px">
        <a href="{{ signedUrl }}"
           style="display:inline-block;color:#ffffff;font-weight:700;font-size:16px;padding:14px 28px;text-decoration:none">
          {{ 'registration.email.confirm_btn'|trans }}
        </a>
      </td>
    </tr>
  </table>

  <p style="font-size:13px;color:#5a5d4d;line-height:1.5;word-break:break-all;margin:0 0 14px">
    {{ 'registration.email.link_fallback'|trans }}<br>
    <a href="{{ signedUrl }}" style="color:#c2551f">{{ signedUrl }}</a>
  </p>

  <p style="font-size:13px;color:#5a5d4d;margin:0">
    {{ 'registration.email.expires'|trans }}
    {{ 'registration.email.ignore_notice'|trans }}
  </p>
{% endblock %}

{% block footer %}{{ 'registration.email.footer'|trans|rich }}{% endblock %}
