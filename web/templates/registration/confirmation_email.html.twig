{# Email verification confirmation email — plain HTML, no base layout. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ 'registration.email.title'|trans }}</title>
</head>
<body style="font-family:sans-serif;max-width:600px;margin:0 auto;padding:2rem;color:#14160e">
  <p style="margin:0 0 1.25rem">
    <img src="{{ absolute_url(asset('brand/logo-square.png')) }}" alt="{{ 'registration.email.sender'|trans }}"
         width="56" height="56" style="display:block;width:56px;height:56px;border:0;outline:none">
  </p>

  <h1 style="font-size:1.6rem;font-weight:600;margin:.5rem 0 1rem">
    {{ 'registration.email.welcome_pre'|trans }}{% if displayName is defined and displayName %}, {{ displayName }}{% endif %}!
  </h1>

  <p>{{ 'registration.email.body'|trans }}</p>

  <p style="margin:2rem 0">
    <a href="{{ signedUrl }}"
       style="display:inline-block;background:#e85d26;color:#fff;font-weight:700;font-size:1rem;padding:.8rem 1.6rem;border-radius:5px;text-decoration:none">
      {{ 'registration.email.confirm_btn'|trans }}
    </a>
  </p>

  <p style="font-size:.82rem;color:#5a5d4d;line-height:1.5;word-break:break-all">
    {{ 'registration.email.link_fallback'|trans }}<br>
    <a href="{{ signedUrl }}" style="color:#c2551f">{{ signedUrl }}</a>
  </p>

  <p style="font-size:.85rem;color:#5a5d4d">
    This link expires {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
    {{ 'registration.email.ignore_notice'|trans }}
  </p>

  <hr style="border:none;border-top:1px solid #ddd;margin:2rem 0">
  <p style="font-size:.75rem;color:#8a8d7a">
    {{ 'registration.email.footer'|trans|raw }}
  </p>
</body>
</html>
