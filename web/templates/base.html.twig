<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
{% include 'partials/_head.html.twig' %}
{% block head_styles %}{% endblock %}
</head>
<body>
{% block chrome %}{% include 'partials/_nav.html.twig' %}{% endblock %}
{# Site-wide notices, for controllers that redirect somewhere they cannot know
   the template of. Deliberately its OWN flash type: `success`/`error` are
   rendered by individual pages, and a global renderer sharing those types
   would print them twice wherever both exist. Nothing else uses `notice`, so
   nothing else can double up. #}
{% for msg in app.flashes('notice') %}
  <div class="cc-notice" role="status"><div class="wrap">{{ msg|trans }}</div></div>
{% endfor %}
{% block body %}{% endblock %}
{% block footer %}{% include 'partials/_footer.html.twig' %}{% endblock %}
{# The floating bug button (contact-and-support.md §5), on every page that uses
   this layout. The MAP does not: templates/map/index.html.twig is a standalone
   document and includes the partial itself, as the circle alone
   (owner 2026-08-27: "why can't we have the popup on the map as only the little
   circle with the bug in it?"). `bug_fab_context()` is a function rather than a
   global so the challenge is only issued where the partial renders. #}
{% include 'partials/_bug_fab.html.twig' with {
  bug_fab: bug_fab_context(),
  on_map: nav_active|default('') == 'map'
} only %}
<script nonce="{{ csp_nonce() }}">
{# Only truly site-wide strings ship here (a11y.js, nav.js, version.js). Pages
   that need more merge their own via Object.assign(window.CC_I18N, {...}) in
   body_scripts — see partials/_auth_i18n.html.twig for the auth-form set. #}
window.CC_I18N = {{ {
  skip: 'js.skip'|trans,
  nav_open: 'js.nav_open'|trans, nav_menu: 'js.nav_menu'|trans, nav_close: 'js.nav_close'|trans,
  build: 'js.build'|trans
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
window.ccT = function (k, fb, vars) { var s = (window.CC_I18N && window.CC_I18N[k]) || fb; if (vars) { for (var p in vars) { s = s.replace('%' + p + '%', vars[p]); } } return s; };
{# The rider's date preference, and one formatter for every client-rendered
   date (account-and-auth.md §9). Server-rendered dates go through the cc_date
   Twig filters; without this the two would disagree on the same page, which is
   the failure a preference is supposed to prevent. Anonymous visitors get
   'auto', which is what the filters give them too. #}
window.CC_DATE = {{ {
  format: cc_user_date_format(),
  time: cc_user_time_format(),
  locale: app.request.locale|default('en')
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
{# Same contract for kilometres/miles and metres/feet: the map draws a route's
   length in JS while the page beside it renders one in Twig, and a rider who
   asked for miles must not read both. Values crossing to the client stay
   metric — cc-units.js converts at the point of writing, exactly as the Twig
   filters do. Anonymous visitors get metric, as they always have. #}
window.CC_UNITS = {{ {
  distance: cc_user_distance_unit(),
  elevation: cc_user_elevation_unit()
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
</script>
{# races.js paints the live event coordinate into every .cc-coord brandsub
   (topnav + account shell); not deferred — the homepage hero reads window.CC
   from an inline script. Idempotent, no-ops when .cc-coord is absent. #}
<script src="{{ asset('data/races.js') }}"></script>
{# Not deferred: drawer.js and media-upload.js call window.ccDate synchronously,
   and the map's modules call window.ccKm the same way. #}
<script src="{{ asset('js/cc-dates.js') }}"></script>
<script src="{{ asset('js/cc-units.js') }}"></script>
<script src="{{ asset('js/a11y.js') }}"></script>
{# Filter dropdowns and the pager's page-length select submit on change. Must
   be a FILE, not an onchange= attribute: the CSP blocks inline handlers and
   does it silently. See the script's own header. #}
<script src="{{ asset('js/form-autosubmit.js') }}" defer></script>
<script src="{{ asset('js/nav.js') }}" defer></script>
<script src="{{ asset('js/nav-menus.js') }}" defer></script>
<script nonce="{{ csp_nonce() }}">window.CC_VERSION = {{ cc_build()|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};</script>
<script src="{{ asset('js/version.js') }}"></script>
{# The proof-of-work solver, then the button that uses it. Not deferred past
   each other: bug-fab.js reads window.ccPow at load and bails without it. #}
<script src="{{ asset('support/pow.js') }}"></script>
<script src="{{ asset('support/bug-fab.js') }}" defer></script>
{% block body_scripts %}{% endblock %}
</body>
</html>
