{# Settings = the account "Settings" tab. Uses the same account shell (dark top
   bar + tabs) as the dashboard so the logged-in area is one continuous
   environment; the account status + editable forms live here, in place. #}
{% extends 'base.html.twig' %}

{% set cc_words = cc_user.displayName|trim|split(' ') %}
{% set cc_initials = (cc_words|length > 1 ? cc_words|first|first ~ cc_words|last|first : cc_user.displayName|trim|slice(0, 2))|upper %}

{% block head_styles %}
<style>
  /* ── account shell (shared look with the dashboard) ── */
  .demo-banner{background:rgba(200,146,58,.16);border-bottom:1px solid rgba(200,146,58,.55);color:#6b5320;text-align:center;padding:.6rem 1rem;font-size:.82rem;line-height:1.4}
  .demo-banner b{color:var(--clay)}
  .dtop{background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem clamp(1.25rem,4vw,2rem)}
  .dtop .brandblock{display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none}
  .dtop .brand img{height:1.8rem;display:block}
  .dtop .brandsub{font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap}
  .dtop .who{display:flex;align-items:center;gap:.8rem;font-size:.9rem}
  .dtop .who .uname{color:var(--paper)}
  .dtop .av{width:34px;height:34px;border-radius:50%;background:var(--trail);color:var(--ink);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:600;flex:none}
  .dtop .out{background:none;border:0;font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(239,230,212,.6);cursor:pointer;padding:0}
  .dtop .out:hover{color:var(--trail)}
  .dtabs{display:flex;gap:1.6rem;padding:0 clamp(1.25rem,4vw,2rem);background:var(--paper-deep);border-bottom:1px solid rgba(20,22,14,.12);overflow-x:auto}
  .dtabs a{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:1rem .2rem;color:#595c4d;border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;text-decoration:none}
  .dtabs a.on{color:var(--ink);border-color:var(--trail)}

  .wrap{max-width:720px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2rem)}

  /* ── account status ── */
  .status-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.9rem}
  .status-row .label{color:#595c4d;font-size:.85rem}
  .pill{font-family:var(--mono);font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;padding:.25rem .5rem;border-radius:30px}
  .pill.yes{color:var(--paper);background:var(--spruce-lift)} .pill.no{color:#5a4410;background:rgba(200,146,58,.22)} .pill.role{color:var(--paper);background:var(--ink);margin-left:.2rem}

  h2.sec{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);
    margin:2.2rem 0 1.1rem;padding-bottom:.5rem;border-bottom:1px solid rgba(20,22,14,.14)}

  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  .field input[type=text],
  .field input[type=email],
  .field input[type=password]{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none;color:var(--ink)}
  .field input[readonly]{opacity:.55;cursor:default}
  .field input:focus:not([readonly]){border-color:var(--trail)}
  .field .hint{font-size:.78rem;color:#595c4d;margin-top:.35rem}
  .field-errors,.wrap form ul{list-style:none;padding:0;margin:.5rem 0 .2rem}
  .field-errors li,.wrap form ul li{display:flex;gap:.45rem;align-items:flex-start;font-size:.8rem;color:var(--clay);line-height:1.4;padding:.45rem .65rem;margin-top:.35rem;background:rgba(181,83,46,.09);border:1px solid rgba(181,83,46,.28);border-radius:5px}
  .field-errors li::before,.wrap form ul li::before{content:"\26A0";flex:none;font-size:.9em;line-height:1.4}
  input.is-invalid{border-bottom-color:var(--clay)}

  /* toggle switch */
  .toggle{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .toggle:last-child{border-bottom:none}
  .toggle .lab b{display:block;font-size:.95rem}
  .toggle .lab small{color:#595c4d;font-size:.82rem}
  .sw{position:relative;flex:none;width:42px;height:24px}
  .sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .sw .track{position:absolute;inset:0;background:rgba(20,22,14,.22);border-radius:99px;transition:background .18s}
  .sw .knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--paper);transition:transform .18s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
  .sw input:checked ~ .track{background:var(--spruce-lift)}
  .sw input:checked ~ .knob{transform:translateX(18px)}
  .sw input:focus-visible ~ .track{outline:2px solid var(--trail);outline-offset:2px}

  .submit-row{display:flex;align-items:center;gap:1rem;margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid rgba(20,22,14,.12);flex-wrap:wrap}
  .btn{background:var(--trail);color:var(--ink);font-family:var(--sans);font-weight:700;font-size:1rem;padding:.85rem 1.6rem;border:none;border-radius:5px;cursor:pointer}
  .btn:hover{background:#ff703d}
  .btn-ghost{font-family:var(--sans);font-weight:700;font-size:1rem;padding:.85rem 1.4rem;border-radius:5px;
    border:1.5px solid rgba(20,22,14,.25);color:var(--ink);background:none;text-decoration:none;display:inline-block}
  .btn-ghost:hover{border-color:var(--ink)}
  .btn-danger{background:rgba(181,83,46,.1);color:var(--clay);font-family:var(--sans);font-weight:700;font-size:1rem;
    padding:.85rem 1.4rem;border-radius:5px;border:1.5px solid rgba(181,83,46,.35);cursor:pointer}
  .btn-danger:hover{background:rgba(181,83,46,.18)}

  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.84rem;color:#4a4d40;border-radius:0 6px 6px 0;margin-top:1.6rem;line-height:1.55}

  /* flash messages */
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);
    padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(181,83,46,.1);border-left:3px solid var(--clay);color:var(--clay);
    padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}

  /* danger zone */
  .danger-zone{border:1px solid rgba(181,83,46,.35);border-radius:8px;padding:1.2rem 1.4rem;margin-top:2.4rem}
  .danger-zone h2.sec{color:var(--clay);margin-top:0}
</style>
{% endblock %}

{% block chrome %}
  <div class="demo-banner"><b>Demo</b> — {{ 'account.demo_banner'|trans }}</div>
  <header class="dtop">
    <div class="brandblock">
      <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons"></a>
      <div class="brandsub"><span class="cc-coord">N 48.87° · E 2.29°</span><br>{{ 'account.brandsub'|trans }}</div>
    </div>
    <div class="who">
      <span class="uname">{{ cc_user.displayName }}</span>
      <span class="av" aria-hidden="true">{{ cc_initials }}</span>
      <form method="post" action="{{ path('logout') }}" style="display:inline">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="out">{{ 'account.sign_out'|trans }}</button>
      </form>
    </div>
  </header>
  <nav class="dtabs" aria-label="{{ 'account.sections'|trans }}">
    <a href="{{ path('profile') }}">{{ 'account.tab_contributions'|trans }}</a>
    <a href="{{ path('profile') }}?tab=votes">{{ 'account.tab_votes'|trans }}</a>
    <a href="{{ path('profile') }}?tab=saved">{{ 'account.tab_saved'|trans }}</a>
    <a href="{{ path('settings') }}" class="on" aria-current="page">{{ 'account.tab_settings'|trans }}</a>
  </nav>
{% endblock %}

{% block body %}
<h1 class="acct-id" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">{{ 'settings.heading'|trans }} — {{ cc_user.displayName }}</h1>
<div class="wrap">

  {% for msg in app.flashes('success') %}
    <div class="flash-success" role="alert">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('password_error') %}
    <div class="flash-error" role="alert">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash-error" role="alert">{{ msg }}</div>
  {% endfor %}

  {# ── Account status ── #}
  <h2 class="sec">{{ 'profile.section_status'|trans }}</h2>
  <div class="status-row">
    <span class="label">{{ 'profile.status_email_verified'|trans }}</span>
    {% if cc_user.emailVerified %}<span class="pill yes">{{ 'profile.pill_verified'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_pending'|trans }}</span>{% endif %}
  </div>
  <div class="status-row">
    <span class="label">{{ 'profile.status_2fa'|trans }}</span>
    {% if cc_user.twoFaEnabled and cc_user.totpSecret %}<span class="pill yes">{{ 'profile.pill_2fa_enabled'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_2fa_not_enabled'|trans }}</span>{% endif %}
  </div>
  <div class="status-row">
    <span class="label">{{ 'profile.status_public_profile'|trans }}</span>
    {% if cc_user.publicProfile %}<span class="pill yes">{{ 'profile.pill_public_yes'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_public_no'|trans }}</span>{% endif %}
  </div>
  <div class="status-row">
    <span class="label">{{ 'profile.status_roles'|trans }}</span>
    <span>{% for role in cc_user.roles %}<span class="pill role">{{ role }}</span>{% endfor %}</span>
  </div>

  {# ── Profile settings (display name + public profile toggle) ── #}
  <h2 class="sec">{{ 'settings.section_identity'|trans }}</h2>

  {{ form_start(profileForm, {attr: {novalidate: 'novalidate', class: 'cc-validate'}}) }}

    <div class="field">
      {{ form_label(profileForm.displayName) }}
      {{ form_widget(profileForm.displayName) }}
      {{ form_errors(profileForm.displayName) }}
    </div>

    <div class="field">
      <label>{{ 'settings.label_email'|trans }}</label>
      <input type="email" value="{{ cc_user.email }}" readonly aria-label="Email address (read-only)" />
      <div class="hint">{{ 'settings.email_hint'|trans|raw }}</div>
    </div>

    <div class="toggle">
      <span class="lab">
        <b>{{ 'settings.toggle_public_b'|trans }}</b>
        <small>{{ 'settings.toggle_public_small'|trans }}</small>
      </span>
      <label class="sw">
        {{ form_widget(profileForm.publicProfile, {attr: {class: ''}}) }}
        <span class="track"></span><span class="knob"></span>
      </label>
    </div>
    {{ form_errors(profileForm.publicProfile) }}

    <div class="submit-row">
      <button type="submit" class="btn">{{ 'settings.submit_profile'|trans }}</button>
      <a class="btn-ghost" href="{{ path('profile') }}">{{ 'settings.cancel'|trans }}</a>
    </div>

  {{ form_end(profileForm) }}

  {# ── Security ── #}
  <h2 class="sec">{{ 'settings.section_security'|trans }}</h2>

  {{ form_start(passwordForm, {attr: {novalidate: 'novalidate', id: 'password-form', class: 'cc-validate'}}) }}

    <div class="field">
      {{ form_label(passwordForm.currentPassword) }}
      {{ form_widget(passwordForm.currentPassword) }}
      {{ form_errors(passwordForm.currentPassword) }}
    </div>

    <div class="field">
      {{ form_label(passwordForm.newPassword.first) }}
      {{ form_widget(passwordForm.newPassword.first) }}
      {{ form_errors(passwordForm.newPassword.first) }}
    </div>

    <div class="field">
      {{ form_label(passwordForm.newPassword.second) }}
      {{ form_widget(passwordForm.newPassword.second) }}
      {{ form_errors(passwordForm.newPassword) }}
    </div>

    <div class="submit-row">
      <button type="submit" class="btn">{{ 'settings.submit_password'|trans }}</button>
    </div>

  {{ form_end(passwordForm) }}

  {# 2FA #}
  <div style="margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.1)">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 0">
      <span>
        <b style="display:block;font-size:.95rem">{{ 'settings.twofa_label'|trans }}</b>
        <small style="color:#595c4d;font-size:.82rem">
          {% if cc_user.twoFaEnabled and cc_user.totpSecret %}{{ 'settings.twofa_enabled'|trans }}{% else %}{{ 'settings.twofa_disabled'|trans }}{% endif %}
        </small>
      </span>
      <a href="{{ path('2fa_setup') }}" style="font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)">
        {% if cc_user.twoFaEnabled and cc_user.totpSecret %}{{ 'settings.twofa_manage'|trans }}{% else %}{{ 'settings.twofa_setup'|trans }}{% endif %}
      </a>
    </div>
  </div>

  <div class="notice">
    {{ 'settings.notice'|trans|raw }}
  </div>

  {# ── Danger zone ── #}
  <div class="danger-zone" id="delete">
    <h2 class="sec">{{ 'settings.section_danger'|trans }}</h2>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem">
      <div>
        <b style="display:block;font-size:.95rem">{{ 'settings.delete_account_b'|trans }}</b>
        <small style="color:#595c4d;font-size:.82rem">{{ 'settings.delete_account_small'|trans }}</small>
      </div>
      <form method="post" action="{{ path('settings_delete_request') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_request') }}">
        <button type="submit" class="btn-danger">{{ 'settings.submit_delete_request'|trans }}</button>
      </form>
    </div>

    <details style="margin-top:.6rem">
      <summary style="font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay);cursor:pointer">
        {{ 'settings.delete_summary'|trans }}
      </summary>
      <form method="post" action="{{ path('settings_delete_confirm') }}" style="margin-top:1rem">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_confirm') }}">
        <div class="field" style="margin-bottom:.8rem">
          <label for="deletion_code">{{ 'settings.label_deletion_code'|trans }}</label>
          <input type="text" id="deletion_code" name="deletion_code" maxlength="8" autocomplete="off"
                 placeholder="XXXXXXXX" style="letter-spacing:.16em;text-transform:uppercase;max-width:180px">
        </div>
        <button type="submit" class="btn-danger">{{ 'settings.submit_delete_confirm'|trans }}</button>
      </form>
    </details>
  </div>

</div>
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('js/auth-validate.js') }}" defer></script>
{% endblock %}
