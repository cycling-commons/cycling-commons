{# Settings = the account "Settings" tab, inside the shared account shell. Fields
   are laid out in two columns; each form has a single compact save button. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .wrap{max-width:980px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2rem)}

  h2.sec{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);
    margin:2.2rem 0 1.1rem;padding-bottom:.5rem;border-bottom:1px solid rgba(20,22,14,.14)}

  /* two-column grids (fields + status), collapse on narrow screens */
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:0 2.5rem}
  @media(max-width:700px){.grid-2{grid-template-columns:1fr}}

  .status-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.9rem}
  .status-row .label{color:#595c4d;font-size:.85rem}

  /* Every explanatory line on this page reads in ONE secondary style. The
     class was referenced but never defined, so half the help text rendered at
     full body size while .hint/.help-text rendered small — three body styles
     on one page (owner feedback 2026-08-13). */
  .fhelp{font-size:.82rem;color:#595c4d;line-height:1.5}

  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  .field input[type=text],
  .field input[type=email],
  .field input[type=password]{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none;color:var(--ink)}
  .field input[readonly]{opacity:.55;cursor:default}
  .field input:focus:not([readonly]){border-color:var(--trail)}
  /* select look is global (atlas.css); here just the layout width */
  .field select{width:100%;max-width:22rem}
  .field .hint{font-size:.78rem;color:#595c4d;margin-top:.35rem}
  /* Was an inline style in the translated string; the sanitizer no longer
     passes `style` through (html_sanitizer.yaml), so the colour lives here. */
  .hint a{color:var(--clay)}
  .field .help-text{font-size:.78rem;color:#595c4d;margin-top:.35rem}

  /* base-location field (map-and-search.md §4.5): Photon town typeahead
     + radius slider. Map-free — no MapLibre/PMTiles on this page. */
  .base-loc-wrap{position:relative;max-width:26rem}
  .base-loc-res{list-style:none;margin:.3rem 0 0;padding:0;max-height:260px;overflow-y:auto;
    border:1px solid rgba(20,22,14,.18);border-radius:8px;background:var(--paper);
    position:absolute;left:0;right:0;z-index:5;box-shadow:0 6px 18px rgba(20,22,14,.14)}
  .base-loc-res li{margin:0}
  .base-loc-res button{display:flex;align-items:baseline;gap:.5rem;width:100%;text-align:left;
    background:none;border:none;border-bottom:1px solid rgba(20,22,14,.08);color:var(--ink);
    font-family:var(--sans);font-size:.88rem;padding:.5rem .6rem;cursor:pointer}
  .base-loc-res li:last-child button{border-bottom:none}
  .base-loc-res button:hover,.base-loc-res button:focus-visible{background:rgba(255,90,31,.1)}
  .base-loc-res .sub{flex:0 0 auto;font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;
    text-transform:uppercase;color:#8a8d7d}
  /* derived-area remark: second grid column, palette green; top margin lines it
     up with the neighbouring column's input (label row above it), collapses
     with the grid on narrow screens */
  .base-loc-current{font-size:.82rem;color:var(--spruce-lift);margin:1.45rem 0 0;line-height:1.55}
  @media(max-width:700px){.base-loc-current{margin:.5rem 0 0}}
  .radius-row{display:flex;align-items:center;gap:.9rem;max-width:26rem}
  /* green track (filled portion darker via --fill, kept current by base-location.js)
     + orange (--trail) knob; custom appearance drops the browser's default blue.
     The INPUT is 32px tall with a transparent box and the 6px bar is painted on
     the track pseudo-elements: styling height on the input itself gave the
     slider a 6px touch target, unusable on a phone (mobile audit 2026-07-27). */
  .radius-row input[type=range]{flex:1;-webkit-appearance:none;appearance:none;
    height:32px;border:none;margin:0;padding:0;background:transparent;cursor:pointer}
  .radius-row input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;
    background:linear-gradient(to right,var(--spruce) var(--fill,20%),rgba(28,58,42,.25) var(--fill,20%))}
  .radius-row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
    width:20px;height:20px;border-radius:50%;background:var(--trail);
    border:2px solid var(--paper);box-shadow:0 1px 4px rgba(20,22,14,.35);cursor:pointer;
    margin-top:-7px}   /* centre the 20px knob on the 6px track */
  .radius-row input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;
    background:var(--trail);border:2px solid var(--paper);box-shadow:0 1px 4px rgba(20,22,14,.35);cursor:pointer}
  .radius-row input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:rgba(28,58,42,.25)}
  .radius-row input[type=range]::-moz-range-progress{height:6px;border-radius:3px;background:var(--spruce)}
  .radius-row input[type=range]:focus-visible{outline:2px solid var(--trail);outline-offset:2px}
  .radius-row output{font-family:var(--mono);font-size:.78rem;color:var(--ink);min-width:4.5em;text-align:right}
  .base-clear-row{margin-top:.7rem;display:flex;align-items:center;gap:.5rem}
  /* min-height 32px: the label IS the target (it wraps the box), so it carries
     the touch height the 13px checkbox can't. */
  .base-clear-row label{display:flex;align-items:center;gap:.5rem;font-family:var(--sans);
    font-size:.85rem;color:var(--ink);text-transform:none;letter-spacing:normal;cursor:pointer;
    min-height:32px}
  .base-clear-row input{margin:0;width:18px;height:18px;flex:0 0 18px;accent-color:var(--trail)}

  /* bike-type/riding-style checkbox chips: same pattern as propose_route.html.twig */
  .chip-list{display:flex;flex-wrap:wrap;gap:.5rem}
  .chip-check{display:inline-flex;margin:0}
  .chip-check input{position:absolute;opacity:0;width:1px;height:1px}
  .chip-check span{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;padding:.4rem .8rem;border:1px solid rgba(20,22,14,.25);border-radius:30px;cursor:pointer;transition:all .18s;user-select:none;display:inline-block}
  .chip-check:hover span{border-color:var(--ink)}
  .chip-check:has(input:checked) span{background:var(--trail);border-color:var(--trail);color:var(--ink)}
  .chip-check input:focus-visible + span{outline:2px solid var(--trail);outline-offset:2px}
  /* .field label has higher specificity than .chip-check alone; force the override explicitly */
  .field label.chip-check{display:inline-flex;margin:0}
  .field-errors,.wrap form ul{list-style:none;padding:0;margin:.5rem 0 .2rem}
  .field-errors li,.wrap form ul li{display:flex;gap:.45rem;align-items:flex-start;font-size:.8rem;color:var(--clay);line-height:1.4;padding:.45rem .65rem;margin-top:.35rem;background:rgba(181,83,46,.09);border:1px solid rgba(181,83,46,.28);border-radius:5px}
  .field-errors li::before,.wrap form ul li::before{content:"\26A0";flex:none;font-size:.9em;line-height:1.4}
  input.is-invalid{border-bottom-color:var(--clay)}

  /* toggle switch */
  /* The only toggle row sits directly under its own .sec header, which already
     carries 1.1rem of bottom margin — a matching .85rem of padding on top of
     that read as a gap, so the row hugs the header and keeps its breathing
     room below. The neighbouring column's hint uses the same top offset. */
  .toggle{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.1rem 0 .85rem;border-bottom:1px solid rgba(20,22,14,.1);max-width:420px}
  .toggle .lab b{display:block;font-size:.95rem}
  .toggle .lab small{color:#595c4d;font-size:.82rem}
  .sw{position:relative;flex:none;width:42px;height:24px}
  .sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .sw .track{position:absolute;inset:0;background:rgba(20,22,14,.22);border-radius:99px;transition:background .18s}
  .sw .knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--paper);transition:transform .18s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
  .sw input:checked ~ .track{background:var(--spruce-lift)}
  .sw input:checked ~ .knob{transform:translateX(18px)}
  .sw input:focus-visible ~ .track{outline:2px solid var(--trail);outline-offset:2px}

  /* one compact save button per form */
  .submit-row{margin-top:1.2rem;display:flex;justify-content:flex-end}
  .btn{background:var(--trail);color:var(--ink);font-family:var(--sans);font-weight:700;font-size:.88rem;padding:.55rem 1.15rem;border:none;border-radius:5px;cursor:pointer}
  .btn:hover{background:#ff703d}
  .btn-danger{background:rgba(181,83,46,.1);color:var(--clay);font-family:var(--sans);font-weight:700;font-size:.88rem;
    padding:.55rem 1.1rem;border-radius:5px;border:1.5px solid rgba(181,83,46,.35);cursor:pointer}
  .btn-danger:hover{background:rgba(181,83,46,.18)}

  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.84rem;color:#4a4d40;border-radius:0 6px 6px 0;margin-top:1.6rem;line-height:1.55}
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(179,38,30,.1);border-left:3px solid var(--danger);color:var(--danger-ink);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}

  .danger-zone{border:1px solid rgba(181,83,46,.35);border-radius:8px;padding:1.2rem 1.4rem;margin-top:2.4rem}
  .danger-zone h2.sec{color:var(--clay);margin-top:0}
  .acct-id{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  /* Profile / Security tabs (spec 2026-07-14) */
  .dpane{display:none} .dpane.on{display:block}
  .tabs{display:flex;gap:.4rem;margin:1.2rem 0 1.8rem;border-bottom:1px solid rgba(20,22,14,.14)}
  .tabs [role=tab]{background:none;border:none;border-bottom:2px solid transparent;padding:.55rem 1rem;cursor:pointer;
    font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d}
  .tabs [role=tab][aria-selected="true"]{color:var(--trail);border-bottom-color:var(--trail)}
  .tabs [role=tab]:focus-visible{outline:2px solid var(--trail);outline-offset:2px}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'settings'} %}{% endblock %}

{% block body %}
<h1 class="acct-id">{{ 'settings.heading'|trans }} — {{ cc_user.displayName }}</h1>
<div class="wrap">

  <div class="tabs" role="tablist" aria-label="{{ 'settings.heading'|trans }}">
    <button type="button" role="tab" id="tabbtn-profile" aria-controls="tab-profile"
            aria-selected="{{ active_tab == 'profile' ? 'true' : 'false' }}"
            tabindex="{{ active_tab == 'profile' ? '0' : '-1' }}">{{ 'settings.tab_profile'|trans }}</button>
    <button type="button" role="tab" id="tabbtn-security" aria-controls="tab-security"
            aria-selected="{{ active_tab == 'security' ? 'true' : 'false' }}"
            tabindex="{{ active_tab == 'security' ? '0' : '-1' }}">{{ 'settings.tab_security'|trans }}</button>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('password_error') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('export_error') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('error') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <div class="dpane {{ active_tab == 'profile' ? 'on' }}" id="tab-profile" role="tabpanel" aria-labelledby="tabbtn-profile">

  {# ── Account status (two columns) ── #}
  <h2 class="sec">{{ 'profile.section_status'|trans }}</h2>
  <div class="grid-2">
    <div class="status-row">
      <span class="label">{{ 'profile.status_email_verified'|trans }}</span>
      {% if cc_user.emailVerified %}<span class="pill yes">{{ 'profile.pill_verified'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_pending'|trans }}</span>{% endif %}
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_2fa'|trans }}</span>
      {% if cc_user.twoFaEnabled and cc_user.totpSecret %}<span class="pill yes">{{ 'profile.pill_2fa_enabled'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_2fa_not_enabled'|trans }}</span>{% endif %}
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_public_profile'|trans }}</span>
      {% if cc_user.publicProfile %}<span class="pill yes">{{ 'profile.pill_public_yes'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_public_no'|trans }}</span>{% endif %}
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_roles'|trans }}</span>
      <span>{% for role in cc_user.roles %}<span class="pill role">{{ role }}</span>{% endfor %}</span>
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_country'|trans }}</span>
      <span>{% if cc_user.country %}<img src="{{ asset(cc_user.country.flagAsset) }}" alt="" width="20" height="15" style="vertical-align:-2px;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08)"> {{ cc_user.country.name }}{% else %}<span class="pill no">{{ 'profile.pill_not_set'|trans }}</span>{% endif %}</span>
    </div>
  </div>

  {# ── Identity ── #}
  <h2 class="sec">{{ 'settings.section_identity'|trans }}</h2>
  {{ form_start(profileForm, {attr: {novalidate: 'novalidate', class: 'cc-validate'}}) }}
    <div class="grid-2">
      <div class="field">
        {{ form_label(profileForm.displayName) }}
        {{ form_widget(profileForm.displayName) }}
        {{ form_errors(profileForm.displayName) }}
      </div>
      <div class="field">
        <label for="settings-email">{{ 'settings.label_email'|trans }}</label>
        <input type="email" id="settings-email" value="{{ cc_user.email }}" readonly />
        <div class="hint">{{ 'settings.email_hint'|trans|rich }}</div>
      </div>
      <div class="field">
        {{ form_label(profileForm.country) }}
        {{ form_widget(profileForm.country) }}
        {{ form_errors(profileForm.country) }}
        {% if cc_user.country %}
          <div class="hint"><img src="{{ asset(cc_user.country.flagAsset) }}" alt="" width="20" height="15" style="vertical-align:-2px;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08)"> {{ cc_user.country.name }}</div>
        {% endif %}
      </div>
      <div class="field">
        {{ form_label(profileForm.locale) }}
        {{ form_widget(profileForm.locale) }}
        {{ form_errors(profileForm.locale) }}
      </div>
    </div>

    {# ── Base location (map-and-search.md §4.5): Photon town pick + radius.
       The pin-drop path lives on the map page's "Set my area" — this page stays
       map-free, so it's a plain text search, not a map click. Same two-column
       grid as the identity rows above: inputs left, derived-area remark right. #}
    <div class="grid-2">
      <div class="field">
        {{ form_label(profileForm.baseQuery) }}
        <div class="base-loc-wrap">
          {# Prefill with the stored place so a saved base ("Hoorn") is visible on
             reload — same attr.value trick as the radius slider below: baseQuery is
             unmapped, so the widget's own view value is always empty and never
             collides with this override. Editing the text without picking a new
             town changes nothing (only a Photon pick fills baseLat/baseLng). #}
          {{ form_widget(profileForm.baseQuery, {attr: {
            role: 'combobox', 'aria-expanded': 'false', 'aria-controls': 'baseLocRes', autocomplete: 'off',
            value: cc_user.hasBaseLocation and cc_user.basePlace ? cc_user.basePlace : '',
          }}) }}
          <ul class="base-loc-res" id="baseLocRes" role="listbox" hidden></ul>
        </div>
        {{ form_widget(profileForm.baseLat) }}
        {{ form_widget(profileForm.baseLng) }}
        {{ form_widget(profileForm.basePlace) }}
        {{ form_help(profileForm.baseQuery) }}
        {{ form_errors(profileForm.baseQuery) }}

        <div style="margin-top:.9rem">
          {{ form_label(profileForm.baseRadiusKm) }}
        </div>
        <div class="radius-row">
          {# baseRadiusKm is unmapped, so the form view's own `value` is always
             empty on render — Symfony's range widget only emits its own
             value="..." when that's non-empty (form_div_layout.html.twig
             form_widget_simple), so this attr.value is the sole one rendered
             and there is no competing/duplicate value attribute. #}
          {{ form_widget(profileForm.baseRadiusKm, {attr: {value: cc_user.baseRadiusKm}}) }}
          {# The slider itself stays in kilometres (that is what is stored and
             what the controller reads); only the read-out follows the rider's
             unit, so a mile-reading rider drags to "47 mi" and we keep 75. #}
          <output for="settings_baseRadiusKm" data-radius-output>{{ cc_user.baseRadiusKm|cc_km(0) }}</output>
        </div>

        <div class="base-clear-row">
          <label>
            {{ form_widget(profileForm.baseClear) }}
            {{ 'form.label_base_clear'|trans }}
          </label>
        </div>
      </div>

      {% if cc_user.hasBaseLocation %}
        <div class="field">
          <div class="base-loc-current" data-base-current>
            {% if base_region_slugs is not empty %}
              {%- set region_labels = base_region_slugs|map(s => ('region.' ~ s ~ '.label')|trans) -%}
              {{ 'form.base_current'|trans({'%regions%': region_labels|join(' · ')}) }}
            {% else %}
              {# Empty derived set (base outside every seeded region — e.g. a Dutch
                 base today): say so instead of rendering a bare "Your area:".
                 The map-side default for this state is the recorded Phase 5
                 follow-up (map-and-search.md §4.5 Phase 4 review round). #}
              {{ 'form.base_current_none'|trans }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {# ── Riding preferences (bike types + type of riding, spec 2026-07-14) ── #}
    <h2 class="sec">{{ 'settings.section_preferences'|trans }}</h2>
    <div class="grid-2">
      <div class="field">
        {{ form_label(profileForm.bikeTypes) }}
        <div class="chip-list">
          {% for child in profileForm.bikeTypes %}
            <label class="chip-check">
              {{ form_widget(child) }}
              <span>{{ child.vars.label|trans }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_help(profileForm.bikeTypes) }}
        {{ form_errors(profileForm.bikeTypes) }}
      </div>
      <div class="field">
        {{ form_label(profileForm.ridingStyles) }}
        <div class="chip-list">
          {% for child in profileForm.ridingStyles %}
            <label class="chip-check">
              {{ form_widget(child) }}
              <span>{{ child.vars.label|trans }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_help(profileForm.ridingStyles) }}
        {{ form_errors(profileForm.ridingStyles) }}
      </div>
      {# Which view mode the map opens in
. Lives on the profile,
         not in the browser, so it follows the rider across devices and a shared
         computer never hands one person's choice to the next. #}
      <div class="field">
        {{ form_label(profileForm.defaultMapMode) }}
        {{ form_widget(profileForm.defaultMapMode) }}
        {{ form_help(profileForm.defaultMapMode) }}
        {{ form_errors(profileForm.defaultMapMode) }}
      </div>
      {# The map chrome theme (rail/drawer/legend). Same profile-not-browser
         rule as the map mode above; the map's own sun/moon toggle writes the
         same field. #}
      <div class="field">
        {{ form_label(profileForm.mapTheme) }}
        {{ form_widget(profileForm.mapTheme) }}
        {{ form_help(profileForm.mapTheme) }}
        {{ form_errors(profileForm.mapTheme) }}
      </div>
      {# Separate from the language choice on purpose: reading the site in
         English says nothing about wanting 2026-08-01 over 01-08-2026. #}
      <div class="field">
        {{ form_label(profileForm.dateFormat) }}
        {{ form_widget(profileForm.dateFormat) }}
        {{ form_help(profileForm.dateFormat) }}
        {{ form_errors(profileForm.dateFormat) }}
      </div>
      <div class="field">
        {{ form_label(profileForm.timeFormat) }}
        {{ form_widget(profileForm.timeFormat) }}
        {{ form_help(profileForm.timeFormat) }}
        {{ form_errors(profileForm.timeFormat) }}
      </div>
      {# Distance and climbing are asked separately because miles-with-metres is
         a real combination (most of Britain rides it) — see DistanceUnit. Both
         are display-only: nothing the Commons stores leaves metric. #}
      <div class="field">
        {{ form_label(profileForm.distanceUnit) }}
        {{ form_widget(profileForm.distanceUnit) }}
        {{ form_help(profileForm.distanceUnit) }}
        {{ form_errors(profileForm.distanceUnit) }}
      </div>
      <div class="field">
        {{ form_label(profileForm.elevationUnit) }}
        {{ form_widget(profileForm.elevationUnit) }}
        {{ form_help(profileForm.elevationUnit) }}
        {{ form_errors(profileForm.elevationUnit) }}
      </div>
      {# One setting for every paged list — messages, contributions, the
         moderation desks, the contributors wall. Also settable from any pager
         itself, which writes back here; this is the one that stores it. #}
      <div class="field">
        {{ form_label(profileForm.rowsPerPage) }}
        {{ form_widget(profileForm.rowsPerPage) }}
        {{ form_help(profileForm.rowsPerPage) }}
        {{ form_errors(profileForm.rowsPerPage) }}
      </div>
    </div>

    {# Section header like the other .sec headers; the toggle's old bold label
       is redundant under it, so the row keeps only the description + switch.
       Two-column split per the rest of the page: toggle left, view-link right. #}
    <h2 class="sec">{{ 'settings.toggle_public_b'|trans }}</h2>
    <div class="grid-2">
      <div class="field">
        <div class="toggle">
          <span class="lab">
            <small>{{ 'settings.toggle_public_small'|trans }}</small>
          </span>
          <label class="sw">
            {{ form_widget(profileForm.publicProfile, {attr: {class: ''}}) }}
            <span class="track"></span><span class="knob"></span>
          </label>
        </div>
        {{ form_errors(profileForm.publicProfile) }}
      </div>
      <div class="field">
        <div class="hint" style="margin:.1rem 0 0">
          {% if cc_user.publicProfile %}
            <a href="{{ path('rider_profile', {uuid: cc_user.uuid}) }}" target="_blank" rel="noopener">{{ 'settings.view_public'|trans }} ↗</a>
          {% else %}
            <span data-view-public-off>{{ 'settings.view_public_off'|trans }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="submit-row"><button type="submit" class="btn">{{ 'settings.submit_profile'|trans }}</button></div>
  {{ form_end(profileForm) }}

  <div class="notice">{{ 'settings.notice'|trans|rich }}</div>

  </div>{# /#tab-profile #}

  <div class="dpane {{ active_tab == 'security' ? 'on' }}" id="tab-security" role="tabpanel" aria-labelledby="tabbtn-security">

  {# ── Security ── #}
  <h2 class="sec">{{ 'settings.section_security'|trans }}</h2>
  {{ form_start(passwordForm, {attr: {novalidate: 'novalidate', id: 'password-form', class: 'cc-validate'}}) }}
    <div class="grid-2">
      <div class="field">
        {{ form_label(passwordForm.currentPassword) }}
        {{ form_widget(passwordForm.currentPassword) }}
        {{ form_errors(passwordForm.currentPassword) }}
      </div>
      <div></div>{# empty cell to the right of current password #}
      <div class="field">
        {{ form_label(passwordForm.newPassword.first) }}
        {{ form_widget(passwordForm.newPassword.first) }}
        {{ form_errors(passwordForm.newPassword.first) }}
      </div>
      <div class="field">
        {{ form_label(passwordForm.newPassword.second) }}
        {{ form_widget(passwordForm.newPassword.second) }}
        {{ form_errors(passwordForm.newPassword) }}
      </div>
    </div>
    <div class="submit-row"><button type="submit" class="btn">{{ 'settings.submit_password'|trans }}</button></div>
  {{ form_end(passwordForm) }}

  {# 2FA. Same shape as the export section below — mono section heading, one
     .fhelp line, a left-aligned button — instead of the bold/small flex row
     with a small-caps link floating right, which was both a third text style
     on one page and a control nobody's eye landed on (owner feedback
     2026-08-13). #}
  <div style="margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.1)" id="twofa">
    <h2 class="sec">{{ 'settings.twofa_label'|trans }}</h2>
    <p class="fhelp" style="margin:0 0 1rem">
      {% if cc_user.twoFaEnabled and cc_user.totpSecret %}{{ 'settings.twofa_enabled'|trans }}{% else %}{{ 'settings.twofa_disabled'|trans }}{% endif %}
    </p>
    <a href="{{ path('2fa_setup') }}" class="btn" style="display:inline-block;text-decoration:none">
      {% if cc_user.twoFaEnabled and cc_user.totpSecret %}{{ 'settings.twofa_manage'|trans }}{% else %}{{ 'settings.twofa_setup'|trans }}{% endif %}
    </a>
  </div>

  {# ── Download my data (docs/specs/account-and-auth.md §11) ──
     Sits directly above the danger zone on purpose: the last thing a rider
     reads before closing an account should be that they can take a copy with
     them first. #}
  <div style="margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.1)" id="export">
    <h2 class="sec">{{ 'settings.section_export'|trans }}</h2>
    <p class="fhelp" style="margin:0 0 1rem">{{ 'settings.export_help'|trans }}</p>
    <form method="post" action="{{ path('settings_export') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('data_export') }}">
      <div class="field" style="margin-bottom:.8rem;max-width:320px">
        <label for="export_password">{{ 'settings.label_export_password'|trans }}</label>
        <input type="password" id="export_password" name="current_password" autocomplete="current-password" required>
        <p class="fhelp">{{ 'settings.export_password_help'|trans }}</p>
      </div>
      <button type="submit" class="btn">{{ 'settings.submit_export'|trans }}</button>
    </form>
  </div>

  {# ── Danger zone ── #}
  <div class="danger-zone" id="delete">
    <h2 class="sec">{{ 'settings.section_danger'|trans }}</h2>
    <div style="margin-bottom:1.2rem">
      <b style="display:block;font-size:.95rem">{{ 'settings.delete_account_b'|trans }}</b>
      <p class="fhelp" style="margin:.2rem 0 .9rem">{{ 'settings.delete_account_small'|trans }}</p>
      {# The password comes BEFORE the code (owner 2026-08-13): requesting a
         deletion code starts destroying an account, and an open session on a
         shared machine must not be enough — same gate as the data export. #}
      <form method="post" action="{{ path('settings_delete_request') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_request') }}">
        <div class="field" style="margin-bottom:.8rem;max-width:320px">
          <label for="delete_password">{{ 'settings.label_export_password'|trans }}</label>
          <input type="password" id="delete_password" name="current_password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn-danger">{{ 'settings.submit_delete_request'|trans }}</button>
      </form>
    </div>

    <details style="margin-top:.6rem">
      <summary style="font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay);cursor:pointer">
        {{ 'settings.delete_summary'|trans }}
      </summary>
      <form method="post" action="{{ path('settings_delete_confirm') }}" style="margin-top:1rem">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_confirm') }}">
        <div class="field" style="margin-bottom:.8rem;max-width:220px">
          <label for="deletion_code">{{ 'settings.label_deletion_code'|trans }}</label>
          <input type="text" id="deletion_code" name="deletion_code" maxlength="8" autocomplete="off"
                 placeholder="XXXXXXXX" style="letter-spacing:.16em;text-transform:uppercase">
        </div>
        {% if has_approved_photos %}
          {# docs/specs/photo-uploads.md §6. Offered only to a rider who actually
             has approved photos AND a public profile — anyone else would be
             answering a question that means nothing for them. An EXPLICIT
             yes/no pair with no default (owner 2026-08-13): attribution on
             deletion is a real decision, and a pre-unticked checkbox let it be
             made by not noticing. `required` blocks the submit until one is
             chosen; the server still fails closed to anonymize if the field is
             absent (consent-fail-closed). #}
          <fieldset class="field" style="margin-bottom:.8rem;border:none;padding:0">
            <legend style="font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem">{{ 'settings.delete.keep_media_credit'|trans }}</legend>
            <label style="display:flex;gap:.5rem;align-items:flex-start;margin-bottom:.35rem">
              <input type="radio" name="keep_media_credit" value="1" required>
              <span>{{ 'settings.delete.keep_media_credit_yes'|trans }}</span>
            </label>
            <label style="display:flex;gap:.5rem;align-items:flex-start">
              <input type="radio" name="keep_media_credit" value="0" required>
              <span>{{ 'settings.delete.keep_media_credit_no'|trans }}</span>
            </label>
            <p class="fhelp">{{ 'settings.delete.keep_media_credit_help'|trans }}</p>
          </fieldset>
        {% endif %}
        <button type="submit" class="btn-danger">{{ 'settings.submit_delete_confirm'|trans }}</button>
      </form>
    </details>
  </div>

  </div>{# /#tab-security #}

</div>

<script nonce="{{ csp_nonce() }}">
  (() => {
    const tabs = Array.from(document.querySelectorAll('.tabs [role=tab]'));
    const activate = (btn, focus) => {
      tabs.forEach(b => {
        const on = b === btn;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      document.querySelectorAll('.dpane[role=tabpanel]').forEach(p => p.classList.toggle('on', p.id === btn.getAttribute('aria-controls')));
      history.replaceState(null, '', btn.id === 'tabbtn-security' ? '?tab=security' : location.pathname);
      if (focus) btn.focus();
    };
    tabs.forEach((btn, i) => {
      btn.addEventListener('click', () => activate(btn, false));
      btn.addEventListener('keydown', e => {
        let idx;
        if (e.key === 'ArrowRight') idx = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') idx = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') idx = 0;
        else if (e.key === 'End') idx = tabs.length - 1;
        else return;
        e.preventDefault();
        activate(tabs[idx], true);
      });
    });
  })();
</script>
{% endblock %}

{% block body_scripts %}
{% include 'partials/_auth_i18n.html.twig' %}
<script src="{{ asset('js/password-toggle.js') }}" defer></script>
<script src="{{ asset('js/auth-validate.js') }}" defer></script>
<script src="{{ asset('settings/base-location.js') }}" defer></script>
{% endblock %}
