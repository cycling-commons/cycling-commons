{# Settings page — ported from atlas/demo/settings.html, Symfony forms. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
<style>
  .wrap{max-width:720px;margin:0 auto;padding:2.4rem 2rem}
  @media(max-width:560px){.wrap{padding:1.6rem 1.25rem}}

  .head{display:flex;gap:1.1rem;align-items:center;margin-bottom:.5rem}
  .ava{width:64px;height:64px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-weight:600;font-size:1.5rem;color:var(--paper);background:var(--spruce-lift);border:2px solid rgba(20,22,14,.15)}
  .head h1{font-family:var(--serif);font-weight:600;font-size:1.7rem;line-height:1.05}
  .head .ey{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--clay);margin-bottom:.2rem}

  h2.sec{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);
    margin:2.2rem 0 1.1rem;padding-bottom:.5rem;border-bottom:1px solid rgba(20,22,14,.14)}

  .field{margin-bottom:1.3rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin-bottom:.4rem}
  .field input[type=text],
  .field input[type=email],
  .field input[type=password]{width:100%;background:transparent;border:none;border-bottom:1.5px solid rgba(20,22,14,.25);font-family:var(--sans);font-size:1rem;padding:.45rem 0;outline:none;color:var(--ink)}
  .field input[readonly]{opacity:.55;cursor:default}
  .field input:focus:not([readonly]){border-color:var(--trail)}
  .field .hint{font-size:.78rem;color:#595c4d;margin-top:.35rem}
  .field-errors{list-style:none;padding:0;margin:.3rem 0 0;font-size:.8rem;color:var(--clay)}

  /* toggle switch */
  .toggle{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .toggle:last-child{border-bottom:none}
  .toggle .lab b{display:block;font-size:.95rem}
  .toggle .lab small{color:#595c4d;font-size:.82rem}
  .sw{position:relative;flex:none;width:42px;height:24px}
  .sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
  .sw .track{position:absolute;inset:0;background:rgba(20,22,14,.22);border-radius:99px;transition:background .18s}
  .sw .knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--paper);transition:transform .18s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
  .sw input:checked ~ .track{background:var(--spruce-lift)}
  .sw input:checked ~ .knob{transform:translateX(18px)}
  .sw input:focus-visible ~ .track{outline:2px solid var(--trail);outline-offset:2px}

  .submit-row{display:flex;align-items:center;gap:1rem;margin-top:1.6rem;padding-top:1.4rem;border-top:1px solid rgba(20,22,14,.12);flex-wrap:wrap}
  .btn{background:var(--trail);color:var(--ink);font-family:var(--sans);font-weight:700;font-size:1rem;padding:.85rem 1.6rem;border:none;border-radius:5px;cursor:pointer}
  .btn:hover{background:#ff703d}
  .btn-ghost{font-family:var(--sans);font-weight:700;font-size:1rem;padding:.85rem 1.4rem;border-radius:5px;
    border:1.5px solid rgba(20,22,14,.25);color:var(--ink);background:none;text-decoration:none;display:inline-block}
  .btn-ghost:hover{border-color:var(--ink)}
  .btn-danger{background:rgba(181,83,46,.1);color:var(--clay);font-family:var(--sans);font-weight:700;font-size:1rem;
    padding:.85rem 1.4rem;border-radius:5px;border:1.5px solid rgba(181,83,46,.35);cursor:pointer}
  .btn-danger:hover{background:rgba(181,83,46,.18)}

  .notice{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.84rem;color:#4a4d40;border-radius:0 6px 6px 0;margin-top:1.6rem;line-height:1.55}

  /* flash messages */
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);
    padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(181,83,46,.1);border-left:3px solid var(--clay);color:var(--clay);
    padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}

  /* danger zone */
  .danger-zone{border:1px solid rgba(181,83,46,.35);border-radius:8px;padding:1.2rem 1.4rem;margin-top:2.4rem}
  .danger-zone h2.sec{color:var(--clay);margin-top:0}
</style>
{% endblock %}

{% block body %}
<div class="wrap">

  {% for msg in app.flashes('success') %}
    <div class="flash-success" role="alert">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('password_error') %}
    <div class="flash-error" role="alert">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash-error" role="alert">{{ msg }}</div>
  {% endfor %}

  <div class="head">
    <div class="ava" aria-hidden="true">
      {{- cc_user.displayName|upper|slice(0,2) -}}
    </div>
    <div>
      <div class="ey">Your profile</div>
      <h1>Settings</h1>
    </div>
  </div>

  {# ── Profile settings (display name + public profile toggle) ── #}
  <h2 class="sec">Identity &amp; privacy</h2>

  {{ form_start(profileForm, {attr: {novalidate: 'novalidate'}}) }}

    <div class="field">
      {{ form_label(profileForm.displayName) }}
      {{ form_widget(profileForm.displayName) }}
      {{ form_errors(profileForm.displayName) }}
    </div>

    <div class="field">
      <label>Email</label>
      <input type="email" value="{{ cc_user.email }}" readonly aria-label="Email address (read-only)" />
      <div class="hint">To change your email address, <a href="mailto:info@cyclingcommons.org" style="color:var(--clay)">contact support</a>.</div>
    </div>

    <div class="toggle">
      <span class="lab">
        <b>Public profile</b>
        <small>When off, your profile is hidden and contributions stay anonymous.</small>
      </span>
      <label class="sw">
        {{ form_widget(profileForm.publicProfile, {attr: {class: ''}}) }}
        <span class="track"></span><span class="knob"></span>
      </label>
    </div>
    {{ form_errors(profileForm.publicProfile) }}

    <div class="submit-row">
      <button type="submit" class="btn">Save profile</button>
      <a class="btn-ghost" href="{{ path('profile') }}">Cancel</a>
    </div>

  {{ form_end(profileForm) }}

  {# ── Security ── #}
  <h2 class="sec">Security</h2>

  {# Password change form #}
  {{ form_start(passwordForm, {attr: {novalidate: 'novalidate', id: 'password-form'}}) }}

    <div class="field">
      {{ form_label(passwordForm.currentPassword) }}
      {{ form_widget(passwordForm.currentPassword) }}
      {{ form_errors(passwordForm.currentPassword) }}
    </div>

    <div class="field">
      {{ form_label(passwordForm.newPassword.first) }}
      {{ form_widget(passwordForm.newPassword.first) }}
      {{ form_errors(passwordForm.newPassword.first) }}
    </div>

    <div class="field">
      {{ form_label(passwordForm.newPassword.second) }}
      {{ form_widget(passwordForm.newPassword.second) }}
      {{ form_errors(passwordForm.newPassword) }}
    </div>

    <div class="submit-row">
      <button type="submit" class="btn">Change password</button>
    </div>

  {{ form_end(passwordForm) }}

  {# 2FA link #}
  <div style="margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.1)">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 0">
      <span>
        <b style="display:block;font-size:.95rem">Two-factor authentication (2FA)</b>
        <small style="color:#595c4d;font-size:.82rem">
          {% if cc_user.twoFaEnabled and cc_user.totpSecret %}
            2FA is enabled on your account.
          {% else %}
            Add an extra layer of security to your account.
          {% endif %}
        </small>
      </span>
      <a href="{{ path('2fa_setup') }}" style="font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)">
        {% if cc_user.twoFaEnabled and cc_user.totpSecret %}Manage 2FA ↗{% else %}Set up 2FA ↗{% endif %}
      </a>
    </div>
  </div>

  <div class="notice">
    <b>Profiles are opt-in.</b> Only contributions you choose to show appear publicly — anonymous edits
    are never attributed. Data joins the Commons under <b>ODbL 1.0</b>, media under <b>CC BY-SA 4.0</b>.
  </div>

  {# ── Danger zone ── #}
  <div class="danger-zone" id="delete">
    <h2 class="sec">Danger zone</h2>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem">
      <div>
        <b style="display:block;font-size:.95rem">Delete account</b>
        <small style="color:#595c4d;font-size:.82rem">Permanently remove your account and all personal data. This cannot be undone.</small>
      </div>
      {# Step 1: request a deletion code by email #}
      <form method="post" action="{{ path('settings_delete_request') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_request') }}">
        <button type="submit" class="btn-danger">Send deletion code</button>
      </form>
    </div>

    {# Step 2: enter the code to confirm deletion #}
    <details style="margin-top:.6rem">
      <summary style="font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay);cursor:pointer">
        I have a code — confirm deletion
      </summary>
      <form method="post" action="{{ path('settings_delete_confirm') }}" style="margin-top:1rem">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_confirm') }}">
        <div class="field" style="margin-bottom:.8rem">
          <label for="deletion_code">Deletion code (from email)</label>
          <input type="text" id="deletion_code" name="deletion_code" maxlength="8" autocomplete="off"
                 placeholder="XXXXXXXX" style="letter-spacing:.16em;text-transform:uppercase;max-width:180px">
        </div>
        <button type="submit" class="btn-danger">Permanently delete my account</button>
      </form>
    </details>
  </div>

</div>
{% endblock %}
