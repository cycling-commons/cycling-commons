{% extends 'base.html.twig' %}

{% block head_styles %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<style>
  .rp-wrap{max-width:44rem;margin:0 auto;padding:3rem 1.2rem 4rem}
  .rp-head{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .rp-head h1{font-family:var(--serif);font-weight:600;font-size:2rem;margin:0}
  .rp-head img{border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
  .rp-since{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d;margin:.4rem 0 2rem}
  .rp-sec{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--trail);margin:2.2rem 0 .8rem}
  .rp-chips{display:flex;flex-wrap:wrap;gap:.5rem}
  .rp-chip{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .75rem;border:1px solid rgba(20,22,14,.25);border-radius:30px}
  .rp-routes li{margin:.35rem 0}
  .rp-empty{font-size:.9rem;color:#595c4d}
  .rp-report{margin:2rem 0 0;padding-top:1rem;border-top:1px solid rgba(20,22,14,.12);font-size:.82rem}
  .rp-report a{color:#595c4d}
  .rp-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));gap:.6rem}
  .rp-stat{border:1px solid rgba(20,22,14,.14);border-radius:8px;padding:.7rem .8rem}
  .rp-stat-n{display:block;font-family:var(--serif);font-size:1.6rem;font-weight:600;line-height:1.1}
  .rp-stat-l{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#5a5d4d}
</style>
{% endblock %}

{% block body %}
<div class="rp-wrap">
  <div class="rp-head">
    <h1>{{ rider.displayName }}</h1>
    {% if rider.country %}
      <img src="{{ asset(rider.country.flagAsset) }}" alt="{{ rider.country.name }}" width="24" height="18">
    {% endif %}
  </div>
  <p class="rp-since">{{ 'profile.public_member_since'|trans }} {{ rider.createdAt|cc_month }} · {{ (contrib_count == 1 ? 'profile.public_contributions_one' : 'profile.public_contributions_many')|trans({'%count%': contrib_count}) }}</p>

  {% if rider.bikeTypes is not empty or rider.ridingStyles is not empty %}
    <h2 class="rp-sec">{{ 'profile.public_preferences'|trans }}</h2>
    <div class="rp-chips">
      {% for bt in rider.bikeTypes %}<span class="rp-chip">{{ ('map.bike_' ~ (bt.value|lower|replace({'-': ''})))|trans }}</span>{% endfor %}
      {% for rs in rider.ridingStyles %}<span class="rp-chip">{{ ('form.riding_' ~ rs.value|lower)|trans }}</span>{% endfor %}
    </div>
  {% endif %}

  {# Approved work only, deliberately (owner 2026-08-13): pending submissions
     never score, votes stay private, moderation counts stay admin-only. All
     four render even at zero - a visible zero says what CAN be contributed. #}
  <h2 class="rp-sec">{{ 'profile.counters_h'|trans }}</h2>
  <div class="rp-stats">
    <div class="rp-stat"><span class="rp-stat-n">{{ counters.places }}</span><span class="rp-stat-l">{{ 'profile.counter_places'|trans }}</span></div>
    <div class="rp-stat"><span class="rp-stat-n">{{ counters.edits }}</span><span class="rp-stat-l">{{ 'profile.counter_edits'|trans }}</span></div>
    <div class="rp-stat"><span class="rp-stat-n">{{ counters.photos }}</span><span class="rp-stat-l">{{ 'profile.counter_photos'|trans }}</span></div>
    <div class="rp-stat"><span class="rp-stat-n">{{ counters.checks }}</span><span class="rp-stat-l">{{ 'profile.counter_checks'|trans }}</span></div>
    <div class="rp-stat"><span class="rp-stat-n">{{ counters.translations }}</span><span class="rp-stat-l">{{ 'profile.counter_translations'|trans }}</span></div>
  </div>

  <h2 class="rp-sec">{{ 'profile.public_routes'|trans }}</h2>
  {% if routes is not empty %}
    <ul class="rp-routes">
      {% for r in routes %}
        <li><a href="{{ path('map') }}?route={{ r.id }}">{{ r.name }}</a></li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="rp-empty">{{ 'profile.public_no_routes'|trans }}</p>
  {% endif %}
  {% if pending_count > 0 %}
    <p class="rp-empty">{{ (pending_count == 1 ? 'profile.public_pending_one' : 'profile.public_pending_many')|trans({'%count%': pending_count}) }}</p>
  {% endif %}

  {# Notice and action, DSA Article 16. A display name is content like any
     other, and the person it is aimed at is very often not a member here, so
     this link takes no account (docs/specs/content-reports.md §5). #}
  <p class="rp-report">
    <a href="{{ path('content_report', {type: 'rider', id: rider.uuid, from: app.request.pathInfo}) }}"><span class="rep-bang" aria-hidden="true">!</span>{{ 'report.link_page'|trans }}</a>
  </p>
</div>
{% endblock %}
