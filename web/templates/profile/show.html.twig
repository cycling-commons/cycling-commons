{# SPDX-License-Identifier: AGPL-3.0-only #}
{# Account dashboard — the logged-in "user environment" (post-login landing).
   Uses the shared account shell (account/_shell_*). Every pane renders REAL
   rows only: submissions + route proposals, the user's own route ballots, and
   their curator applications. Saved regions has no backend yet and says so.

   Every row is the shared record card (moderation-and-contribution.md §5.2,
   account/_shell_styles.html.twig): the same card a curator meets on the desk,
   so a rider reading their own contribution and a curator deciding it are
   looking at one thing (owner 2026-08-25). #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/profile/show.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'contrib'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">

  {# ── Contributions — real data only (submissions + route proposals). #}
  <section class="dpane on" id="p-contrib">
    {% set sub_pill = {'approved': 'ok', 'pending': 'pend', 'needs_info': 'pend', 'rejected': 'rej', 'withdrawn': 'rej', 'trashed': 'rej'} %}
    <div class="mh">
      <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ cc_user.displayName }}</div>
      <h1>{{ 'account.contributions_title'|trans }}</h1>
    </div>
    {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
    {% for msg in app.flashes('notice') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
    <div class="mod-bar">
      {# Category filter (owner 2026-08-16): plain GET links so a filtered list
         can be bookmarked; chips render only for letters this rider has, and
         only when there is more than one - a filter with one option is noise.
         The Routes chip (letter R) lists the rider's route proposals with any
         route correction. #}
      {% if letter_chips|length > 1 or status_filter %}
        {# Category chips and the withdrawn toggle COMBINE: every chip's href
           carries the other filter along, so switching one never resets the
           other (owner 2026-08-16). #}
        {% set st = status_filter ? {status: status_filter} : {} %}
        <nav class="lfilter" aria-label="{{ 'account.filter_kind_aria'|trans }}">
          <a class="lchip {{ letter_filter == '' ? 'on' }}" href="{{ path('profile', st) }}">{{ 'account.filter_all'|trans }}</a>
          {% for c in letter_chips %}
            <a class="lchip {{ letter_filter == c.letter ? 'on' }}" href="{{ path('profile', {letter: c.letter}|merge(st)) }}">{{ c.labelKey|trans }}</a>
          {% endfor %}
          {% set lt = letter_filter ? {letter: letter_filter} : {} %}
          <a class="lchip lchip-status {{ status_filter ? 'on' }}"
             href="{{ path('profile', status_filter ? lt : {status: 'withdrawn'}|merge(lt)) }}">{{ 'account.sub_status_withdrawn'|trans }}</a>
        </nav>
      {% endif %}
      {% if entries is not empty %}
        {% include 'account/_density.html.twig' %}
      {% endif %}
    </div>
    {# One list of everything the rider contributed, places and route
       proposals together, newest first, under one pager: the controller pages
       the union of both in SQL (docs/specs/account-and-auth.md). #}
    {% if entries is empty %}
      <div class="empty-state">
        <p>{{ 'account.contributions_empty'|trans }}</p>
        <a class="door" href="{{ path('map') }}">{{ 'account.votes_cta'|trans }}</a>
      </div>
    {% else %}
      {% set route_pill = {'verified': 'ok', 'unverified': 'conf', 'submitted': 'pend', 'rejected': 'rej', 'retired': 'ret', 'trashed': 'rej'} %}
      <div class="q-list" id="qList">
      {% for e in entries %}
      {% if e.route %}
        {% set p = e.route %}
        {# A route proposal, in the same card shape as a place. Anchor for the
           propose-route receipt, whose reference links here; the shared
           :target outline marks the card it lands on. Map shows the route to
           its proposer while it waits (map-and-search.md §8); Edit reopens
           the proposal form until a curator decides (route-domain.md §4). #}
        {# A route a curator moved to Trash stays here greyed, tagged Removed,
           with no links, until the purge deletes it 30 days later. #}
        <div class="q-item{{ p.state.value == 'trashed' ? ' is-removed' }}" id="route-{{ p.id }}">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                {% include 'partials/_type_icon.html.twig' with {letter: 'R'} %}
                <span class="q-tag q-tag--route">{{ 'account.route_tag'|trans }}</span>
                <h3 class="q-title">{{ p.name }}</h3>
              </div>
              {% set rname = p.regionId ? region_names[p.regionId] ?? null : null %}
              {% if rname %}<div class="q-submitter">{{ rname }}</div>{% endif %}
            </div>
            <div class="q-acts">
              <time class="q-when" datetime="{{ p.createdAt|date('c') }}">{{ p.createdAt|cc_date }}</time>
              {% if p.state.value in ['submitted', 'verified', 'unverified'] %}
                <span class="q-links">
                  <a class="q-link" href="{{ path('map') }}?route={{ p.id }}"
                     target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a>
                  {% if p.state.value == 'submitted' %}
                    <a class="q-link" href="{{ path('propose_route_edit', {id: p.id}) }}">{{ 'account.link_edit'|trans }}</a>
                  {% endif %}
                </span>
              {% endif %}
              <span class="q-pill q-pill--{{ route_pill[p.state.value] ?? 'pend' }}">{{ ('account.route_state_' ~ p.state.value)|trans }}</span>
            </div>
          </div>
        </div>
      {% else %}
        {% set sub = e.sub %}
        {# Map + Edit render for every item-bound row, PENDING included (owner
           2026-08-16: "while an item is waiting for review I should be able
           to edit it"). A pending new item is not served by name, so its map
           link is the pending deep-link the desk uses; the edit wizard binds
           the submitter's own Submitted item. A route correction (letter R)
           has no item-edit binding. #}
        {# A submission a curator moved to Trash stays on its rider's list,
           greyed and tagged Removed, with no map or edit link and no
           conversation, until the purge deletes it 30 days later (owner
           2026-10-01). #}
        {% set sub_removed = sub.status.value == 'trashed' %}
        {% set sub_live = sub.itemId is not null and sub.letter != 'R' and not sub_removed %}
        {% set sub_pending_new = sub.type.value == 'new' and sub.status.value in ['pending', 'needs_info'] %}
        {# Anchor for the messages page, whose cards link back to the
           contribution they are about. No data-item-id: that attribute is the
           desk's live-removal hook for a decided submission, and this row is
           the rider's own record of it. #}
        <div class="q-item{{ sub_removed ? ' is-removed' }}" id="sub-{{ sub.id }}">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                {# The type's own icon first (owner 2026-08-25), drawn, never an
                   emoji: partials/_type_icon.html.twig. #}
                {% include 'partials/_type_icon.html.twig' with {letter: sub.letter} %}
                <span class="q-tag q-tag--{{ sub.type.value }}">{{ ('account.sub_type_' ~ sub.type.value)|trans }}</span>
                <h3 class="q-title">{{ sub.title }}
                  {# WHAT KIND of place: "New item · Thier Antoine" said nothing
                     about climbs (owner 2026-08-25). Same small kind label the
                     History desk prints after a title. #}
                  {% if letter_labels[sub.letter] is defined %}<span class="q-kind">{{ letter_labels[sub.letter]|trans }}</span>{% endif %}</h3>
              </div>
              {# WHERE it is, as words: Scout rows all read "Scenery" and
                 nothing else (owner 2026-08-16). Region + country come from
                 the row's own stamps; town-level needs the gazetteer
                 (docs/TODO.md "Nearby town on a queue row"). #}
              {% set rname = sub.regionId ? region_names[sub.regionId] ?? null : null %}
              {% if rname or sub.countryCode %}
                <div class="q-submitter">{{ [rname, sub.countryCode]|filter(v => v)|join(' · ') }}</div>
              {% endif %}
            </div>
            {# One line: date · Map · Edit · status · Withdraw · Show details
               (owner 2026-08-25). #}
            <div class="q-acts">
              <time class="q-when" datetime="{{ sub.createdAt|date('c') }}">{{ sub.createdAt|cc_date }}</time>
              {% if sub_live %}
                <span class="q-links">
                  {# The map opens in its own tab: this list is a work queue, and a
                     rider checking one row should come back to it, not to a fresh
                     /profile. Same convention as the desk (moderate/_queue_item). #}
                  {% if sub_pending_new %}
                    <a class="q-link" href="{{ path('map') }}?pending={{ sub.id }}"
                       target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a>
                  {% else %}
                    <a class="q-link" href="{{ path('map') }}?item={{ sub.itemId }}"
                       target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a>
                  {% endif %}
                  <a class="q-link" href="{{ path('improve') }}?item={{ sub.itemId }}&amp;type={{ sub.letter }}">{{ 'account.link_edit'|trans }}</a>
                </span>
              {% endif %}
              <span class="q-pill q-pill--{{ sub_pill[sub.status.value] ?? 'pend' }}">{{ ('account.sub_status_' ~ sub.status.value)|trans }}</span>
              {# The rider's own exit, only while nobody has decided (owner
                 2026-08-16), and never on a submission under legal hold. The
                 service re-checks both under a row lock, so a race with a
                 curator ends in a flash, never a half-withdrawal. #}
              {% if sub.status.value in ['pending', 'needs_info'] and not sub.escalated %}
                <form class="withdraw-form" method="post" action="{{ path('profile_withdraw', {id: sub.id}) }}"
                      data-confirm="{{ 'account.withdraw_confirm'|trans }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('withdraw' ~ sub.id) }}">
                  {# The active filters travel with the POST, so the redirect
                     lands back on the same filtered view. #}
                  {% if letter_filter %}<input type="hidden" name="letter" value="{{ letter_filter }}">{% endif %}
                  {% if status_filter %}<input type="hidden" name="status" value="{{ status_filter }}">{% endif %}
                  <button type="submit" class="withdraw-btn">{{ 'account.withdraw'|trans }}</button>
                </form>
              {% endif %}
              {# WHAT was contributed: the was → now list, folded behind a link
                 that sits UNDER Map · Edit · status in this same column (owner
                 2026-08-25: no extra line, no extra space). The break forces
                 the wrap; with JS the script turns the <details> into a button
                 whose panel drops under the whole card. Field names come from
                 the registry, so they read as the form asked them: "Road
                 quality", not `sq` (owner-reported 2026-08-03). #}
              {% set diff = submission_changes[sub.id] ?? [] %}
              {% if diff is not empty %}
                <span class="q-acts-break"></span>
                <details class="q-act q-act--diff">
                  <summary class="q-link" data-label-open="{{ 'messages.hide_details'|trans }}">{{ 'messages.show_details'|trans }}</summary>
                  <div class="q-act-panel q-diff">
                    <span class="q-diff-h">{{ 'messages.what_you_changed'|trans }}</span>
                    <dl>
                      {% for row in diff %}
                        <dt>{{ row.label }}</dt>
                        {# Long values (a drawn segment's geometry) clamp to one line,
                           click to expand: partials/_vclip.html.twig. #}
                        {% set long = (row.now ~ (row.was ?? ''))|length > 110 %}
                        <dd{% if long %} class="vclip" tabindex="0" role="button" aria-expanded="false"{% endif %}>
                          {%- if row.was is not null %}<span class="was">{{ row.was }}</span>{% endif -%}
                          <span class="now">{{ row.now }}</span>
                        </dd>
                      {% endfor %}
                    </dl>
                  </div>
                </details>
              {% endif %}
            </div>
          </div>
          {% if sub.decisionNote %}<p class="q-note">{{ sub.decisionNote }}</p>{% endif %}
          {# The conversation, the way the curator's desk shows it. A status
             chip on its own left a rider who had been asked something with no
             sign of the question, and no sign that their answer had landed. #}
          {% set thread = submission_threads[sub.id] ?? null %}
          {% if thread and thread.reply %}
            <p class="q-note q-note--answer"><b>{{ 'account.you_replied'|trans }}</b> {{ thread.reply }}</p>
          {% endif %}
          {% if sub.status.value == 'needs_info' %}
            <p class="q-links q-map">
              <a class="q-link q-link--act" href="{{ path('messages') }}{% if thread and thread.askedId %}#msg-{{ thread.askedId }}{% endif %}">{{ 'account.answer_curator'|trans }} →</a>
            </p>
          {% elseif thread and (thread.reply or thread.askedId) %}
            <p class="q-links q-map">
              <a class="q-link" href="{{ path('messages') }}{% if thread.askedId %}#msg-{{ thread.askedId }}{% endif %}">{{ 'account.see_conversation'|trans }}</a>
            </p>
          {% endif %}
        </div>
      {% endif %}
      {% endfor %}
      </div>
      {% include 'partials/_pager.html.twig' with {pager: pager, route: 'profile', params: (letter_filter ? {letter: letter_filter} : {})|merge(status_filter ? {status: status_filter} : {})} %}
    {% endif %}

    {# ── Curating.
       With an application in flight this is the "where is my request?" answer.
       Without one, the reader is a rider, not a curator — telling them they
       have no application in progress states the obvious in somebody else's
       vocabulary. What is worth their while is whether their OWN area has
       anyone looking after it, and an invitation either way. #}
    {% if curator_applications is empty %}
      <h2 class="sec-band">{{ 'account.curating_invite_title'|trans }}</h2>
      <p class="curating">
        {% set region = curating.slug ? cc_region_label(curating.slug) : '' %}
        {% if curating.state == 'region_local' %}
          {{ 'account.curating_region_local'|trans({'%region%': region}) }}
        {% elseif curating.state == 'region_national' %}
          {{ 'account.curating_region_national'|trans({'%region%': region}) }}
        {% elseif curating.state == 'region_none' %}
          {{ 'account.curating_region_none'|trans({'%region%': region}) }}
        {% elseif curating.state == 'country_some' %}
          {{ 'account.curating_country_some'|trans({'%country%': curating.country}) }}
        {% elseif curating.state == 'country_none' %}
          {{ 'account.curating_country_none'|trans({'%country%': curating.country}) }}
        {% else %}
          {{ 'account.curating_no_area'|trans({'%url%': path('settings')})|rich }}
        {% endif %}
        {# A way in, always — whether or not their own patch already has
           somebody. A region can have several curators alongside a country-wide
           one, and there is more to do here than curating. #}
        <a class="cta" href="{{ path('regions') }}">{{ 'account.curating_apply'|trans }}</a>
      </p>
    {% else %}
      <h2 class="sec-band">{{ 'account.curating_title'|trans }} <span class="sec-count">{{ curator_applications|length }}</span></h2>
      {% set app_pill = {'pending': 'pend', 'approved': 'ok', 'declined': 'rej', 'withdrawn': 'ret'} %}
      <div class="q-list">
      {% for app in curator_applications %}
        <div class="q-item">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                <span class="q-tag q-tag--kind">{{ app.country_code }}</span>
                <h3 class="q-title">{% if app.region_slug %}{{ cc_region_label(app.region_slug) }}{% else %}{{ 'account.curating_whole_country'|trans }}{% endif %}</h3>
              </div>
            </div>
            <div class="q-acts">
                <time class="q-when" datetime="{{ app.created_at|date('c') }}">{{ app.created_at|cc_date }}</time>
              <span class="q-pill q-pill--{{ app_pill[app.status] ?? 'pend' }}">{{ ('account.app_status_' ~ app.status)|trans }}</span>
            </div>
          </div>
          {% if app.decision_note %}<p class="q-note">{{ app.decision_note }}</p>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% endif %}
  </section>

  {# VOTES: the rider's own season votes (the only surface that shows WHAT was
     voted for, voter-only, route-domain.md §8d). Place confirmations have
     their own pane below: they say a place is real, not that it is the best. #}
  <section class="dpane" id="p-votes">
    <div class="mh">
      <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ cc_user.displayName }}</div>
      <h1>{{ 'account.tab_votes'|trans }}</h1>
    </div>
    {# The ballot itself lives on /vote; this tab lists what was cast (owner 2026-10-02: "I can't vote"). #}
    <p><a class="door" href="{{ path('vote') }}">{{ 'account.votes_ballot'|trans }}</a></p>
    {% if votes is empty %}
      <div class="empty-state">
        <p>{{ 'account.votes_empty'|trans }}</p>
      </div>
    {% else %}
      {% if votes is not empty %}
        <h2 class="sec-band">{{ 'account.votes_season_h'|trans }} <span class="sec-count">{{ votes|length }}</span></h2>
        <div class="q-list">
        {% for v in votes %}
          <div class="q-item">
            <div class="q-top">
              <div class="q-headwrap">
                <div class="q-head">
                  {% include 'partials/_type_icon.html.twig' with {letter: v.letter} %}
                  <span class="q-tag q-tag--kind">{{ v.label_key|trans }}</span>
                  <h3 class="q-title">{{ v.name }}</h3>
                </div>
                <div class="q-submitter">{% include 'vote/_hemisphere.html.twig' with {hemisphere: v.hemisphere} only %} {{ 'vote.round_label'|trans({'%season%': v.season_label_key|trans, '%year%': v.year_label}) }} · {{ 'account.votes_choice'|trans({'%n%': v.slot}) }}{% if v.submitted_at is null %} · <b>{{ 'account.votes_draft'|trans }}</b>{% endif %}{% if v.bike_label_key %} · {{ v.bike_label_key|trans }}{% endif %}</div>
              </div>
              <div class="q-acts">
                <time class="q-when" datetime="{{ v.created_at|date('c') }}">{{ v.created_at|cc_date }}</time>
                <span class="q-links"><a class="q-link" href="{{ path('map') }}?{{ v.letter == 'R' ? 'route' : 'item' }}={{ v.subject_id }}"
                  target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a></span>
              </div>
            </div>
          </div>
        {% endfor %}
        </div>
      {% endif %}
    {% endif %}
    <div class="note">{{ 'account.votes_note'|trans|rich }}</div>
  </section>

  {# CONFIRMATIONS: what the rider has vouched for on the map ("still there",
     "potable", moderation-and-contribution.md §1.6), and the places near them
     worth a look again. Not votes (owner 2026-10-03). #}
  <section class="dpane" id="p-confirmations">
    <div class="mh">
      <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ cc_user.displayName }}</div>
      <h1>{{ 'account.tab_confirmations'|trans }}</h1>
    </div>
    {% if confirmations_pager.total == 0 and stale_nearby is empty %}
      <div class="empty-state">
        <p>{{ 'account.confirmations_empty'|trans }}</p>
        <a class="door" href="{{ path('map') }}">{{ 'account.votes_cta'|trans }}</a>
      </div>
    {% endif %}
    {# PLACES NEAR YOU WORTH A LOOK (owner 2026-08-12). The map's orange ring
       is a passive colour; this is the half a rider can act on deliberately.
       Above their own confirmations on purpose: this is a thing to DO, and
       the list below it is a record of things already done.
       Absent entirely without a base location - there is no "near you" to
       answer, and a national list of old taps is a chore, which is what this
       nudge must never become. #}
    {% if stale_nearby is not empty %}
      <h2 class="sec-band">{{ 'account.stale_nearby_h'|trans }} <span class="sec-count">{{ stale_nearby|length }}</span></h2>
      <p class="note">{{ 'account.stale_nearby_body'|trans }}</p>
      <div class="q-list">
      {% for s in stale_nearby %}
        <div class="q-item">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                {% if s.letter is defined %}{% include 'partials/_type_icon.html.twig' with {letter: s.letter} %}{% endif %}
                <span class="q-tag q-tag--kind">{{ s.typeLabelKey|trans }}</span>
                <h3 class="q-title">{{ s.name }}</h3>
              </div>
              <div class="q-submitter">{{ 'account.stale_nearby_km'|trans({'%km%': s.km}) }}</div>
            </div>
            <div class="q-acts">
              <time class="q-when" datetime="{{ s.last_confirmed|date('c') }}">{{ 'account.stale_nearby_last'|trans }} {{ s.last_confirmed|cc_date }}</time>
              <span class="q-links"><a class="q-link" href="{{ path('map') }}?item={{ s.id }}"
                target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a></span>
            </div>
          </div>
        </div>
      {% endfor %}
      </div>
    {% endif %}
    {% if confirmations is not empty %}
      <h2 class="sec-band">{{ 'account.votes_places_h'|trans }} <span class="sec-count">{{ confirmations_pager.total }}</span></h2>
      <div class="q-list">
      {% for c in confirmations %}
        <div class="q-item">
          <div class="q-top">
            <div class="q-headwrap">
              <div class="q-head">
                {% if c.letter is defined %}{% include 'partials/_type_icon.html.twig' with {letter: c.letter} %}{% endif %}
                <span class="q-tag q-tag--kind">{{ c.typeLabelKey|trans }}</span>
                <h3 class="q-title">{{ c.name }}</h3>
              </div>
            </div>
            <div class="q-acts">
              <time class="q-when" datetime="{{ c.created_at|date('c') }}">{{ c.created_at|cc_date }}</time>
              <span class="q-links"><a class="q-link" href="{{ path('map') }}?item={{ c.item_id }}"
                target="_blank" rel="noopener">{{ 'account.link_map'|trans }} &#8599;</a></span>
              <span class="q-pill q-pill--{{ c.stance == 'not_potable' ? 'rej' : 'ok' }}">{{ ('account.stance_' ~ c.stance)|trans }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
      </div>
      {# Its own page key (`cpage`), and `tab` so a page link lands on this tab. #}
      {% include 'partials/_pager.html.twig' with {pager: confirmations_pager, route: 'profile', key: 'cpage', params: {tab: 'confirmations'}} %}
    {% endif %}
  </section>

  {# ── Saved regions: hidden until there is persistence behind it (owner,
     2026-08-26). A tab that only ever says "nothing here yet" teaches riders
     the section is broken. Its tab in account/_shell_chrome.html.twig is
     commented out with it, and its account.saved_* keys stay in the catalogs
     so the pane can come back unchanged. See "Saved regions" in docs/TODO.md.
  <section class="dpane" id="p-saved">
    <div class="mh">
      <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ cc_user.displayName }}</div>
      <h1>{{ 'account.tab_saved'|trans }}</h1>
    </div>
    <div class="empty-state">
      <p>{{ 'account.saved_empty'|trans }}</p>
      <a class="door" href="{{ path('regions') }}">{{ 'account.saved_browse'|trans }}</a>
    </div>
  </section>
  #}

</div>
{% include 'partials/_vclip.html.twig' %}
{% include 'moderate/_card_script.html.twig' %}
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('js/account.js') }}" defer></script>
{% endblock %}
