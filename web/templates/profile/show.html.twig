{# Account dashboard — the logged-in "user environment" (the post-login landing).
   Ported from the demo login.html post-login view. The contribution / vote /
   saved-region figures are PREVIEW sample data (persistence is stubbed — see the
   Demo banner); the real bits are the user identity, sign-out, the moderation
   gate, and the Settings links to the real /settings page. When the data-API
   lands (Plan 5), the controller feeds these panes real rows. #}
{% extends 'base.html.twig' %}

{% set cc_words = cc_user.displayName|trim|split(' ') %}
{% set cc_initials = (cc_words|length > 1 ? cc_words|first|first ~ cc_words|last|first : cc_user.displayName|trim|slice(0, 2))|upper %}

{% block head_styles %}
<style>
  .demo-banner{background:rgba(200,146,58,.16);border-bottom:1px solid rgba(200,146,58,.55);color:#6b5320;text-align:center;padding:.6rem 1rem;font-size:.82rem;line-height:1.4}
  .demo-banner b{color:var(--clay)}

  .dtop{background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem clamp(1.25rem,4vw,2rem)}
  .dtop .brandblock{display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none}
  .dtop .brand img{height:1.8rem;display:block}
  .dtop .brandsub{font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap}
  .dtop .who{display:flex;align-items:center;gap:.8rem;font-size:.9rem}
  .dtop .who .uname{color:var(--paper)}
  .dtop .av{width:34px;height:34px;border-radius:50%;background:var(--trail);color:var(--ink);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:600;flex:none}
  .dtop .out{background:none;border:0;font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(239,230,212,.6);cursor:pointer;padding:0}
  .dtop .out:hover{color:var(--trail)}

  .dtabs{display:flex;gap:1.6rem;padding:0 clamp(1.25rem,4vw,2rem);background:var(--paper-deep);border-bottom:1px solid rgba(20,22,14,.12);overflow-x:auto}
  .dtabs button{background:none;border:none;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:1rem .2rem;cursor:pointer;color:#595c4d;border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap}
  .dtabs button.on{color:var(--ink);border-color:var(--trail)}

  .dbody{padding:2.2rem clamp(1.25rem,4vw,2rem);max-width:880px;width:100%;margin:0 auto}
  .dpane{display:none} .dpane.on{display:block}

  .stats{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem;padding-bottom:1.6rem;border-bottom:1px solid rgba(20,22,14,.12)}
  .stat .n{font-family:var(--serif);font-size:2rem;font-weight:600}
  .stat .n.t{color:var(--trail)}
  .stat .l{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d}

  .item{display:flex;align-items:center;gap:1rem;padding:.9rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .item .tag{font-family:var(--mono);font-size:.58rem;padding:.25rem .45rem;border-radius:3px;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em}
  .item h4{flex:1;font-size:1rem;font-weight:500}
  .item .co{font-family:var(--mono);font-size:.62rem;color:#595c4d}
  .pill{font-family:var(--mono);font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;padding:.25rem .5rem;border-radius:30px}
  .pill.ok{background:#3e7d4f;color:#fff} .pill.pend{background:var(--ochre);color:var(--ink)} .pill.conf{background:var(--spruce);color:var(--paper)}
  .pill.yes{color:var(--paper);background:var(--spruce-lift)} .pill.no{color:#5a4410;background:rgba(200,146,58,.22)} .pill.role{color:var(--paper);background:var(--ink);margin-left:.2rem}

  .setsec{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin:1.8rem 0 .8rem;padding-bottom:.5rem;border-bottom:1px solid rgba(20,22,14,.14)}
  .status-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 0;border-bottom:1px solid rgba(20,22,14,.1);font-size:.9rem}
  .status-row .label{color:#595c4d;font-size:.85rem}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem}
  .rc{background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:6px;padding:1.1rem;display:block}
  .rc h4{font-family:var(--serif);font-weight:600;font-size:1.15rem} .rc .co{font-family:var(--mono);font-size:.62rem;color:#595c4d;margin-top:.3rem}

  .setrow{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .setrow .val{font-size:.85rem;color:#595c4d;margin-top:.2rem}
  .note{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.88rem;color:#4a4d40;margin:1.4rem 0;border-radius:0 6px 6px 0}
  .manage{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);white-space:nowrap}

  .rounding{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);margin-bottom:1rem}
  .actions{display:flex;gap:.8rem;margin-top:2rem;flex-wrap:wrap}
  .lnk{font-family:var(--sans);font-weight:700;font-size:.9rem;padding:.7rem 1.2rem;border-radius:5px;cursor:pointer;display:inline-block}
  .lnk.p{background:var(--trail);color:var(--ink)} .lnk.g{border:1.5px solid var(--ink)}

  /* visually-hidden page heading (a11y; the visible identity lives in .dtop) */
  .acct-id{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
{% endblock %}

{% block chrome %}
  <div class="demo-banner"><b>Demo</b> — {{ 'account.demo_banner'|trans }}</div>

  <header class="dtop">
    <div class="brandblock">
      <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons"></a>
      <div class="brandsub"><span class="cc-coord">N 48.87° · E 2.29°</span><br>{{ 'account.brandsub'|trans }}</div>
    </div>
    <div class="who">
      <span class="uname">{{ cc_user.displayName }}</span>
      <span class="av" aria-hidden="true">{{ cc_initials }}</span>
      <form method="post" action="{{ path('logout') }}" style="display:inline">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="out">{{ 'account.sign_out'|trans }}</button>
      </form>
    </div>
  </header>

  <nav class="dtabs" aria-label="{{ 'account.sections'|trans }}">
    <button class="on" data-pane="contrib" role="tab" aria-selected="true">{{ 'account.tab_contributions'|trans }}</button>
    <button data-pane="votes" role="tab" aria-selected="false">{{ 'account.tab_votes'|trans }}</button>
    <button data-pane="saved" role="tab" aria-selected="false">{{ 'account.tab_saved'|trans }}</button>
    <button data-pane="settings" role="tab" aria-selected="false">{{ 'account.tab_settings'|trans }}</button>
  </nav>
{% endblock %}

{% block body %}
<h1 class="acct-id">{{ 'account.heading'|trans }} — {{ cc_user.displayName }}</h1>

<div class="dbody">

  {# ── Contributions (PREVIEW data — data-API/Plan 5 replaces the figures) ── #}
  <section class="dpane on" id="p-contrib" role="tabpanel">
    <div class="stats">
      <div class="stat"><div class="n">142</div><div class="l">{{ 'account.stat_facts'|trans }}</div></div>
      <div class="stat"><div class="n t">38</div><div class="l">{{ 'account.stat_confirmed'|trans }}</div></div>
      <div class="stat"><div class="n">9</div><div class="l">{{ 'account.stat_osm'|trans }}</div></div>
    </div>

    <div class="item"><span class="tag" style="background:var(--glacier)">water</span><h4>Fountain · Spa centre</h4><span class="co">50.49°N 5.86°E</span><span class="pill ok">{{ 'account.status_approved'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--trail);color:#fff">climb</span><h4>Côte de Stockeu · gradient edit</h4><span class="co">50.39°N 5.77°E</span><span class="pill pend">{{ 'account.status_pending'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--ochre)">hazard</span><h4>Road closure · N66</h4><span class="co">50.42°N 5.80°E</span><span class="pill conf">{{ 'account.status_confirmed'|trans }} ×3</span></div>
    <div class="item"><span class="tag" style="background:var(--clay);color:#fff">stay</span><h4>B&amp;B Vallée de l'Amblève</h4><span class="co">50.45°N 5.62°E</span><span class="pill ok">{{ 'account.status_approved'|trans }}</span></div>

    <div class="actions">
      <a class="lnk p" href="{{ path('map') }}">{{ 'account.explore_map'|trans }} →</a>
      {% if is_granted('ROLE_CURATOR') %}
        <a class="lnk g" href="{{ path('moderate') }}">{{ 'account.open_moderation'|trans }} →</a>
      {% endif %}
    </div>
  </section>

  {# ── Votes (PREVIEW) ── #}
  <section class="dpane" id="p-votes" role="tabpanel">
    <div class="rounding">◷ {{ 'account.vote_round'|trans }}</div>
    <div class="item"><span class="tag" style="background:var(--spruce);color:#fff">region</span><h4>Wallonia — best climbs</h4><span class="co">4 / 10 ranked</span><span class="pill conf">{{ 'account.status_voting'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--spruce);color:#fff">region</span><h4>Dolomites — best views</h4><span class="co">7 / 10 ranked</span><span class="pill conf">{{ 'account.status_voting'|trans }}</span></div>
    <div class="note">{{ 'account.votes_note'|trans|raw }}</div>
  </section>

  {# ── Saved regions (PREVIEW) ── #}
  <section class="dpane" id="p-saved" role="tabpanel">
    <div class="cards">
      <a class="rc" href="{{ path('regions') }}"><h4>Wallonia</h4><div class="co">BE · 18 climbs · 42 water</div></a>
      <a class="rc" href="{{ path('regions') }}"><h4>Dolomites</h4><div class="co">IT · 31 climbs · 12 views</div></a>
      <a class="rc" href="{{ path('regions') }}"><h4>Peak District</h4><div class="co">UK · gravel · 9 stays</div></a>
    </div>
  </section>

  {# ── Settings (real identity + account status; edit forms live at /settings) ── #}
  <section class="dpane" id="p-settings" role="tabpanel">
    <div class="setrow"><div><b>{{ 'account.set_display_name'|trans }}</b><div class="val">{{ cc_user.displayName }}</div></div><a class="manage" href="{{ path('settings') }}">{{ 'account.manage'|trans }} →</a></div>
    <div class="setrow"><div><b>{{ 'account.set_email'|trans }}</b><div class="val">{{ cc_user.email }}</div></div><a class="manage" href="{{ path('settings') }}">{{ 'account.manage'|trans }} →</a></div>

    <h2 class="setsec">{{ 'profile.section_status'|trans }}</h2>
    <div class="status-row">
      <span class="label">{{ 'profile.status_email_verified'|trans }}</span>
      {% if cc_user.emailVerified %}<span class="pill yes">{{ 'profile.pill_verified'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_pending'|trans }}</span>{% endif %}
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_2fa'|trans }}</span>
      <span>{% if cc_user.twoFaEnabled and cc_user.totpSecret %}<span class="pill yes">{{ 'profile.pill_2fa_enabled'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_2fa_not_enabled'|trans }}</span>{% endif %} <a class="manage" href="{{ path('2fa_setup') }}">{{ 'account.manage'|trans }} →</a></span>
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_public_profile'|trans }}</span>
      <span>{% if cc_user.publicProfile %}<span class="pill yes">{{ 'profile.pill_public_yes'|trans }}</span>{% else %}<span class="pill no">{{ 'profile.pill_public_no'|trans }}</span>{% endif %} <a class="manage" href="{{ path('settings') }}">{{ 'account.manage'|trans }} →</a></span>
    </div>
    <div class="status-row">
      <span class="label">{{ 'profile.status_roles'|trans }}</span>
      <span>{% for role in cc_user.roles %}<span class="pill role">{{ role }}</span>{% endfor %}</span>
    </div>

    <div class="note">{{ 'account.privacy_note'|trans|raw }}</div>

    <div class="setrow" style="border:none"><div><b>{{ 'account.delete_account'|trans }}</b><div class="val">{{ 'account.delete_note'|trans }}</div></div><a class="manage" href="{{ path('settings') }}#delete">{{ 'account.manage'|trans }} →</a></div>
  </section>

</div>
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('js/account.js') }}" defer></script>
{% endblock %}
