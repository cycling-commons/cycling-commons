{# Account dashboard — the logged-in "user environment" (post-login landing).
   Uses the shared account shell (partials/account/_shell_*). The contribution /
   vote / saved-region figures are PREVIEW sample data behind the Demo banner
   (persistence is stubbed); the data-API (Plan 5) feeds these panes real rows.
   Real bits: identity + sign-out (shell) and the moderation gate below. #}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .dbody{padding:2.2rem clamp(1.25rem,4vw,2rem);max-width:880px;width:100%;margin:0 auto}
  .dpane{display:none} .dpane.on{display:block}

  .stats{display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:2rem;padding-bottom:1.6rem;border-bottom:1px solid rgba(20,22,14,.12)}
  .stat .n{font-family:var(--serif);font-size:2rem;font-weight:600}
  .stat .n.t{color:var(--trail)}
  .stat .l{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d}

  .item{display:flex;align-items:center;gap:1rem;padding:.9rem 0;border-bottom:1px solid rgba(20,22,14,.1)}
  .item .tag{font-family:var(--mono);font-size:.58rem;padding:.25rem .45rem;border-radius:3px;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em}
  .item h4{flex:1;font-size:1rem;font-weight:500}
  .item .co{font-family:var(--mono);font-size:.62rem;color:#595c4d}
  .pill{font-family:var(--mono);font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;padding:.25rem .5rem;border-radius:30px}
  .pill.ok{background:#3e7d4f;color:#fff} .pill.pend{background:var(--ochre);color:var(--ink)} .pill.conf{background:var(--spruce);color:var(--paper)}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem}
  .rc{background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:6px;padding:1.1rem;display:block}
  .rc h4{font-family:var(--serif);font-weight:600;font-size:1.15rem} .rc .co{font-family:var(--mono);font-size:.62rem;color:#595c4d;margin-top:.3rem}

  .note{background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.9rem 1.1rem;font-size:.88rem;color:#4a4d40;margin:1.4rem 0;border-radius:0 6px 6px 0}
  .rounding{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);margin-bottom:1rem}
  .actions{display:flex;gap:.8rem;margin-top:2rem;flex-wrap:wrap}
  .lnk{font-family:var(--sans);font-weight:700;font-size:.9rem;padding:.7rem 1.2rem;border-radius:5px;cursor:pointer;display:inline-block}
  .lnk.p{background:var(--trail);color:var(--ink)} .lnk.g{border:1.5px solid var(--ink)}

  .acct-id{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'contrib'} %}{% endblock %}

{% block body %}
<h1 class="acct-id">{{ 'account.heading'|trans }} — {{ cc_user.displayName }}</h1>

<div class="dbody">

  {# ── Contributions (PREVIEW data — data-API/Plan 5 replaces the figures) ── #}
  <section class="dpane on" id="p-contrib" role="tabpanel">
    <div class="stats">
      <div class="stat"><div class="n">142</div><div class="l">{{ 'account.stat_facts'|trans }}</div></div>
      <div class="stat"><div class="n t">38</div><div class="l">{{ 'account.stat_confirmed'|trans }}</div></div>
      <div class="stat"><div class="n">9</div><div class="l">{{ 'account.stat_osm'|trans }}</div></div>
    </div>

    <div class="item"><span class="tag" style="background:var(--glacier)">water</span><h4>Fountain · Spa centre</h4><span class="co">50.49°N 5.86°E</span><span class="pill ok">{{ 'account.status_approved'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--trail);color:#fff">climb</span><h4>Côte de Stockeu · gradient edit</h4><span class="co">50.39°N 5.77°E</span><span class="pill pend">{{ 'account.status_pending'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--ochre)">hazard</span><h4>Road closure · N66</h4><span class="co">50.42°N 5.80°E</span><span class="pill conf">{{ 'account.status_confirmed'|trans }} ×3</span></div>
    <div class="item"><span class="tag" style="background:var(--clay);color:#fff">stay</span><h4>B&amp;B Vallée de l'Amblève</h4><span class="co">50.45°N 5.62°E</span><span class="pill ok">{{ 'account.status_approved'|trans }}</span></div>

    {# ── Real contributions (this plan's data-API) ── #}
    <section class="acct-contributions">
      <h2>{{ 'account.contributions_title'|trans }}</h2>
      {% if contributions is empty %}
        <p class="acct-empty">{{ 'account.contributions_empty'|trans }}</p>
      {% else %}
        <ul class="acct-sub-list">
          {% for sub in contributions %}
            <li>
              <span class="acct-sub-title">{{ sub.title }}</span>
              <span class="acct-sub-type">{{ ('account.sub_type_' ~ sub.type.value)|trans }}</span>
              <span class="acct-sub-status acct-sub-status--{{ sub.status.value }}">{{ ('account.sub_status_' ~ sub.status.value)|trans }}</span>
              <time datetime="{{ sub.createdAt|date('c') }}">{{ sub.createdAt|date('Y-m-d') }}</time>
              {% if sub.decisionNote %}<p class="acct-sub-note">{{ sub.decisionNote }}</p>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    {# ── Route proposals (route-domain v1 phase 1) ── #}
    {% if route_proposals is not empty %}
    <section class="acct-contributions">
      <h2>{{ 'account.route_proposals_title'|trans }}</h2>
      <ul class="acct-sub-list acct-route-list">
        {% for p in route_proposals %}
          <li>
            <span class="acct-sub-title">{{ p.name }}</span>
            <span class="acct-sub-status acct-sub-status--{{ p.state.value }}">{{ ('account.route_state_' ~ p.state.value)|trans }}</span>
            <time datetime="{{ p.createdAt|date('c') }}">{{ p.createdAt|date('Y-m-d') }}</time>
          </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <div class="actions">
      <a class="lnk p" href="{{ path('map') }}">{{ 'account.explore_map'|trans }} →</a>
      {% if is_granted('ROLE_CURATOR') %}
        <a class="lnk g" href="{{ path('moderate') }}">{{ 'account.open_moderation'|trans }} →</a>
      {% endif %}
    </div>
  </section>

  {# ── Votes (PREVIEW) ── #}
  <section class="dpane" id="p-votes" role="tabpanel">
    <div class="rounding">◷ {{ 'account.vote_round'|trans }}</div>
    <div class="item"><span class="tag" style="background:var(--spruce);color:#fff">region</span><h4>Wallonia — best climbs</h4><span class="co">4 / 10 ranked</span><span class="pill conf">{{ 'account.status_voting'|trans }}</span></div>
    <div class="item"><span class="tag" style="background:var(--spruce);color:#fff">region</span><h4>Dolomites — best views</h4><span class="co">7 / 10 ranked</span><span class="pill conf">{{ 'account.status_voting'|trans }}</span></div>
    <div class="note">{{ 'account.votes_note'|trans|raw }}</div>
  </section>

  {# ── Saved regions (PREVIEW) ── #}
  <section class="dpane" id="p-saved" role="tabpanel">
    <div class="cards">
      <a class="rc" href="{{ path('regions') }}"><h4>Wallonia</h4><div class="co">BE · 18 climbs · 42 water</div></a>
      <a class="rc" href="{{ path('regions') }}"><h4>Dolomites</h4><div class="co">IT · 31 climbs · 12 views</div></a>
      <a class="rc" href="{{ path('regions') }}"><h4>Peak District</h4><div class="co">UK · gravel · 9 stays</div></a>
    </div>
  </section>

</div>
{% endblock %}

{% block body_scripts %}
<script src="{{ asset('js/account.js') }}" defer></script>
{% endblock %}
