{#
  One post (docs/specs/blog.md §5).

  The body goes through `|bug_markdown`, which is the SAME restricted markdown
  the bug desk renders: escape first, six rules, sanitise after. Deliberately
  not a second profile. It also means a post cannot embed an image or an
  external link, which for a first blog is a feature rather than a limit: the
  posts worth writing are prose.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<link rel="stylesheet" href="{{ asset('styles/page/blog/post.css') }}">
{% endblock %}

{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'blog.kicker'|trans }}</div>
  <h1 class="disp">{{ post.title }}</h1>
</div></div>

<section class="pad"><div class="wrap">
  <div class="blogwrap">
  <div class="blogpage">
    <p class="bmeta">
      <time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|cc_date }}</time>
      {# The language it was WRITTEN in, which is not always the one the reader
         asked for. #}
      · {{ post.locale|upper }}
    </p>

    {% if post.lede %}<p class="blede">{{ post.lede }}</p>{% endif %}

    <div class="bbody">{{ post.body|bug_markdown(constant('App\\Blog\\Entity\\BlogPost::BODY_MAX')) }}</div>

    {% if siblings is not empty %}
      <p class="bother">{{ 'blog.also_in'|trans }}
        {% for other in siblings %}
          <a href="{{ path('blog_post', {slug: other.slug, _locale: other.locale}) }}">{{ other.locale|upper }}</a>{% if not loop.last %} · {% endif %}
        {% endfor %}
      </p>
    {% endif %}

    <p class="bback"><a href="{{ path('blog') }}">{{ 'blog.back'|trans }}</a></p>
  </div>

  {# The archive, beside the post. Somebody who has just finished one is the
     likeliest person on the site to read a second, and the index is a click
     they mostly will not make. #}
  {% if others is not empty %}
    <aside class="blogside">
      <h2>{{ 'blog.archive'|trans }}</h2>
      <ol>
        {% for other in others %}
          <li>
            <a href="{{ path('blog_post', {slug: other.slug}) }}">{{ other.title }}
              <span class="swhen"><time datetime="{{ other.publishedAt|date('Y-m-d') }}">{{ other.publishedAt|cc_date }}</time></span>
            </a>
          </li>
        {% endfor %}
      </ol>
      <p class="sall"><a href="{{ path('blog') }}">{{ 'blog.back'|trans }}</a></p>
    </aside>
  {% endif %}
  </div>
</div></section>
{% endblock %}
