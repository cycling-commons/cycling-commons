{#
  The blog index (docs/specs/blog.md §5).

  Posts are written in English and Dutch. A reader in another language gets the
  English ones here rather than an empty page, and the notice says so once. A
  blog that costs five translations per post is a blog with four posts in it.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
<style nonce="{{ csp_nonce() }}">
  .blogpage{max-width:760px}
  .bp{border-bottom:1px solid rgba(20,22,14,.12);padding:1.4rem 0}
  .bp:last-of-type{border-bottom:0}
  .bp h2{font-family:var(--serif);font-weight:600;font-size:1.3rem;margin:0 0 .35rem;line-height:1.3}
  .bp h2 a{color:var(--ink);text-decoration:none}
  .bp h2 a:hover{color:var(--clay);text-decoration:underline}
  .bp .when{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;color:#6d7060}
  .bp p{font-size:.96rem;color:#3a3d30;line-height:1.65;margin:.4rem 0 0}
  .bp .more{font-size:.9rem;color:var(--clay)}
  .blang{background:var(--paper-deep);border-left:3px solid var(--glacier);padding:.9rem 1.1rem;
    border-radius:0 8px 8px 0;font-size:.9rem;color:#4a4d40;margin:0 0 1.4rem}
  .blang-pick{display:block;margin-top:.5rem;font-family:var(--mono);font-size:.78rem;letter-spacing:.04em}
  .blang-pick a{color:var(--clay);text-decoration:underline;text-underline-offset:3px}
  /* The one being read is not a link to itself. */
  .blang-pick a[aria-current]{color:#4a4d40;text-decoration:none;font-weight:700}
  .bempty{background:var(--paper-deep);border-left:2px solid var(--ochre);padding:1.1rem 1.3rem;
    border-radius:0 8px 8px 0;font-size:.95rem;color:#4a4d40}
  .bfeed{margin-top:2rem;font-size:.88rem}
  .bfeed a{color:var(--clay)}
</style>
{% endblock %}

{% block head_extra %}
<link rel="alternate" type="application/atom+xml" title="{{ 'blog.title'|trans }}" href="{{ path('blog_atom') }}">
{% endblock %}

{% block body %}
<div class="lhero"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ 'blog.kicker'|trans }}</div>
  <h1 class="disp">{{ 'blog.title'|trans }}</h1>
  <p class="lead" style="color:rgba(239,230,212,.85);margin-top:.8rem">{{ 'blog.lead'|trans|rich }}</p>
</div></div>

<section class="pad"><div class="wrap">
  <div class="blogpage">
    {% if fallback_from %}
      {# Said once, at the top, never repeated on each post, and always in the
         reader's OWN language: a notice about language that a reader cannot
         read is the one notice that has to work. #}
      <p class="blang">
        {{ 'blog.fallback_note'|trans }}
        <span class="blang-pick">
          {% for code in written_locales %}
            <a href="{{ path('blog', {_locale: code}) }}" lang="{{ code }}"
               {{ code == written_locale ? 'aria-current="page"' : '' }}>{{ ('lang.' ~ code)|trans }}</a>{% if not loop.last %} · {% endif %}
          {% endfor %}
        </span>
      </p>
    {% endif %}

    {% if posts is empty %}
      <div class="bempty">{{ 'blog.empty'|trans }}</div>
    {% else %}
      {% for post in posts %}
        <article class="bp">
          <h2><a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a></h2>
          <div class="when"><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|cc_date }}</time></div>
          {% if post.lede %}<p>{{ post.lede }}</p>{% endif %}
          <p class="more"><a href="{{ path('blog_post', {slug: post.slug}) }}">{{ 'blog.read'|trans }}</a></p>
        </article>
      {% endfor %}

      {% include 'partials/_pager.html.twig' with {pager: pager, route: 'blog', params: {}} %}
    {% endif %}

    <p class="bfeed"><a href="{{ path('blog_atom') }}">{{ 'blog.feed_link'|trans }}</a></p>
  </div>
</div></section>
{% endblock %}
