{# SPDX-License-Identifier: LicenseRef-PolyForm-Shield-1.0.0 #}
{# The one proposal form (translations.md §4, §4.1, §4.2): the full page
   (translate/edit.html.twig) and the chrome-less drawer frame
   (translate/embed.html.twig) both include this, unchanged. There is no
   second form.

   Expects: entry, locale, open, live, yaml_default, has_markup, form, change,
   proposed_preview, standing, is_english, embed, stale, english_version,
   made_against, source_drift, is_dev, deepl_on, dev_submit.

   deepl_on and dev_submit are the dev-only DeepL tool (translations.md §7):
   deepl_on (DeepLAvailability::isOn(), plus "not English" below) gates the
   two draft buttons; dev_submit (kernel environment is "dev", plus "not
   English") is broader on purpose: a developer with no DeepL key configured
   still gets the direct-write submit path and the no-consent note below, just
   no buttons to draft with. #}

{% macro worddiff(segments) %}{%- for s in segments -%}
  {%- if s.type == 'del' -%}<span class="q-was">{{ s.text }}</span>
  {%- elseif s.type == 'ins' -%}<span class="q-now">{{ s.text }}</span>
  {%- else -%}{{ s.text }}{%- endif -%}
  {%- if not loop.last %} {% endif -%}
{%- endfor -%}{% endmacro %}

{% if stale %}
  <p class="tr-warn" role="status">{{ 'translate.stale.notice'|trans({'%from%': made_against, '%to%': english_version}) }}</p>
{% endif %}

{% if source_drift %}
  <p class="tr-warn" role="status">{{ (is_dev ? 'translate.source_drift.dev' : 'translate.source_drift.other')|trans }}</p>
{% endif %}

{% if open %}
    {% if open.englishAtSubmit != entry.english %}
      <p class="tr-warn" role="status">{{ 'moderate.translation.english_changed'|trans }}</p>
    {% endif %}
    <div class="q-diff tr-diff">
      <dl>
        <dt>{{ 'moderate.translation.english_at_submit'|trans }}</dt>
        <dd>{{ open.englishAtSubmit }}</dd>
        <dt>{{ 'moderate.translation.english_now'|trans }}</dt>
        <dd>{{ entry.english }}</dd>
        <dt>{{ 'moderate.translation.live'|trans }}</dt>
        <dd>{{ live }}</dd>
      </dl>
      <div class="tr-change">
        <span class="tr-change-k">{{ 'moderate.translation.change'|trans }}</span>
        <div class="q-diff">{{ _self.worddiff(change) }}</div>
      </div>
    {% else %}
    {% if is_english %}
  <div class="tr-panel">
    <div class="tr-lab">{{ 'translate.field.english_yaml'|trans }}</div>
    <div class="tr-val">{{ yaml_default }}</div>
  </div>
  <div class="tr-panel">
    <div class="tr-lab">{{ 'translate.field.english_live'|trans }} v{{ english_version }}</div>
    <div class="tr-val">{{ live }}</div>
  </div>
    {% else %}
  <div class="tr-panel">
    <div class="tr-lab">{{ 'translate.field.english'|trans }}</div>
    <div class="tr-val">{{ entry.english }}</div>
  </div>
  <div class="tr-panel">
    <div class="tr-lab">{{ 'translate.field.yaml'|trans }}</div>
    <div class="tr-val">{{ yaml_default }}</div>
  </div>
  <div class="tr-panel">
    <div class="tr-lab">{{ 'translate.field.live'|trans }}</div>
    <div class="tr-val">{{ live }}</div>
  </div>
    {% endif %}
    {% endif %}

  {% if has_markup %}
    <p class="tr-note note">{{ 'translate.markup_note'|trans }}</p>
  {% endif %}

  {{ form_start(form, {attr: {class: 'tr-form'}, action: path('translate_edit', {id: entry.id, embed: embed ? 1 : null})}) }}
    {% if deepl_on and not is_english %}
      {# Dev-only DeepL controls (translations.md §7.2). The %%LOCALES%%
         %%DETAILS%% and %%MESSAGE%% placeholders are the same substitute-after-escape
         trick the consent block below uses for %date%: the translated
         template is rendered once here, and deepl-draft.js fills in the
         technical (locale codes, a DeepL error string) part client-side,
         via textContent, never innerHTML: nothing here is HTML. #}
      <div class="tr-deepl" data-deepl
           data-draft-url="{{ path('translate_deepl_draft', {id: entry.id}) }}"
           data-csrf="{{ csrf_token('deepl_draft') }}"
           data-drafting-label="{{ 'translate.deepl.drafting'|trans }}"
           data-error-tpl="{{ 'translate.deepl.error'|trans({'%message%': '%%MESSAGE%%'}) }}">
        {# One tick box per language DeepL may be asked for. They exist only
           on the dev catalogue form, which is the only form carrying a field
           per language for the answers to land in; with a DeepL key but no
           CC_CATALOGUE_WRITE opt-in there is one textarea, so the endpoint's
           own default (the locale being edited) is the whole choice. #}
        {% if dev_locales is not empty %}
          <fieldset class="tr-deepl-pick">
            <legend>{{ 'translate.deepl.draft_pick'|trans }}</legend>
            {% for locale in dev_locales %}
              <label>
                <input type="checkbox" data-deepl-locale="{{ locale }}"{{ locale == app.request.locale ? ' checked' : '' }}>
                {{ ('lang.' ~ locale)|trans }}
              </label>
            {% endfor %}
          </fieldset>
        {% endif %}
        <div class="tr-deepl-actions">
          <button type="button" class="tr-deepl-draft">{{ 'translate.deepl.draft_selected'|trans }}</button>
        </div>
        <p class="tr-deepl-status" data-deepl-status hidden></p>
      </div>
    {% endif %}
    {# The dev catalogue form edits every rider locale at once: one field per
       language, each with the tick box that decides whether it is written
       (translations.md §7.3). Every other form carries the single "value"
       field, for the one locale being proposed. #}
    {% if dev_locales is not empty %}
      {% for locale in dev_locales %}
        {# data-initial is the wording this field arrived holding. The
           browser compares against it to mark a field the developer has
           edited, and to ask before dropping an edit that is not ticked to
           be written (assets/js/catalogue-form.js). #}
        <div class="field tr-locale" data-locale-row="{{ locale }}">
          {{ form_label(attribute(form, locale)) }}
          {{ form_widget(attribute(form, locale), {attr: {'data-initial': attribute(form, locale).vars.value}}) }}
          {{ form_errors(attribute(form, locale)) }}
        </div>
      {% endfor %}
    {% else %}
      <div class="field">
        {{ form_label(form.value) }}
        {{ form_widget(form.value) }}
        {{ form_errors(form.value) }}
      </div>
    {% endif %}

    {% if proposed_preview is not empty %}
      <div class="tr-panel">
        <div class="tr-lab">{{ 'translate.field.preview'|trans }}</div>
        <div class="preview">{{ proposed_preview|rich }}</div>
      </div>
    {% endif %}

    {# The consent block never applies to a dev submit (translations.md
       §7.3): no CC BY-SA grant is being created, so a tick asking for one,
       or a line saying one was already given, would be actively misleading
       for output headed into PolyForm source instead. dev_submit already
       makes `form.consent is defined` false via the createForm() options
       above and $standing null in the controller, so this `not dev_submit`
       is belt and suspenders, not the only thing doing the hiding, but it
       is the one place that says so in one look. #}
    {% if not is_english and not dev_submit %}
      {% if standing %}
        {% set when %}<time class="consent-when" datetime="{{ standing.consentedAt|date('c') }}">{{ standing.consentedAt|cc_date }}</time>{% endset %}
        {# translate.consent.standing is an overlayable key: a curator-approved translation is
           untrusted HTML at render (translations.md §3, §8), same as any other catalogue string.
           Escape the catalogue text FIRST, substituting a placeholder no translator would type in
           place of %date%, THEN swap that placeholder for our own trusted <time> markup and |raw only
           the result we built ourselves. Doing it the other way round, interpolating %date% before
           escaping, lets the catalogue text carry live HTML again - do not "simplify" it back to that. #}
        {% set standing_text = 'translate.consent.standing'|trans({'%date%': '%%DATE%%'})|escape('html') %}
        <div class="consent-ok">✓ {{ standing_text|replace({'%%DATE%%': when})|raw }}
          <details class="consent-more">
            <summary>{{ 'translate.consent.read_contract'|trans }}</summary>
            <p>{{ 'translate.consent.contract'|trans }}</p>
          </details>
          <a href="{{ path('terms') }}">{{ 'translate.consent.site_terms'|trans }}</a>
        </div>
      {% elseif form.consent is defined %}
    <div class="consent">
      {{ form_widget(form.consent) }}
      {{ form_label(form.consent) }}
    </div>
    {{ form_errors(form.consent) }}
      {% endif %}
    {% endif %}
    {{ form_errors(form) }}

    {# What gets written, decided in one place, at the point of writing, with
       the note about what that write means beside it rather than paragraphs
       up the page. A field that was edited and is NOT ticked here has its
       change dropped, which catalogue-form.js asks about before letting the
       form go. #}
    {% if dev_locales is not empty %}
      <fieldset class="tr-save-pick" data-save-pick
                data-discard-tpl="{{ 'translate.deepl.discard_confirm'|trans({'%locales%': '%%LOCALES%%'}) }}">
        <legend>{{ 'translate.deepl.save'|trans }}</legend>
        {% for locale in dev_locales %}
          <label>
            {{ form_widget(attribute(form, 'save_' ~ locale)) }}
            {{ ('lang.' ~ locale)|trans }}
          </label>
        {% endfor %}
      </fieldset>
    {% endif %}

    {% if dev_submit %}
      <p class="tr-deepl-note">{{ 'translate.deepl.no_consent_note'|trans }}</p>
    {% endif %}
    <div class="tr-actions">
      {# The button is the last thing read before acting, so on the dev
         write path it has to name the act: this submit does not propose
         anything to anybody, it edits a source file in the working tree
         (translations.md §7.3). #}
      <button type="submit">{{ (dev_submit ? 'translate.deepl.submit' : 'translate.submit')|trans }}</button>
      <a href="{{ path('translate') }}">{{ 'translate.cancel'|trans }}</a>
    </div>
  {{ form_end(form) }}
  {% if open %}
    </div>
  {% endif %}
