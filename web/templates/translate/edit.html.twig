{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/translate/edit.css') }}">
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'translate'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ 'translate.kicker'|trans }}</div>
    <h1>{{ entry.messageKey }}{% if open %} <span class="tr-status">{{ ('translate.mine.status.' ~ open.status.value)|trans }}</span>{% endif %}</h1>
    <p class="lead">{{ 'moderate.translation.locale'|trans({'%locale%': locale}) }}
      · {{ cc_languages(built: true)[locale]|default(locale) }}</p>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <nav class="lfilter" aria-label="{{ 'translate.section_aria'|trans }}">
    <a class="lchip {{ open ? '' : 'on' }}" href="{{ path('translate') }}">{{ 'translate.catalogue'|trans }}</a>
    <a class="lchip tr-yours {{ open ? 'on' }}" href="{{ path('translate_mine') }}">{{ 'translate.mine.yours'|trans }}</a>
  </nav>

  {% include 'translate/_form.html.twig' %}
</div>
{% endblock %}
