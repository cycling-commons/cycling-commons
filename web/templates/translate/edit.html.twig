{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .wrap{max-width:720px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2rem)}
  .ey{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  h1{font-family:var(--serif);font-weight:600;font-size:1.75rem;line-height:1.1;word-break:break-word}
  .back{display:inline-block;margin-bottom:1.2rem;font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay);text-decoration:none}
  .back:hover{color:var(--trail)}
  .panel{margin-top:1.4rem;padding:1.1rem 1.2rem;background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:8px}
  .panel + .panel{margin-top:.9rem}
  .lab{font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:#595c4d;margin-bottom:.35rem}
  .val{font-size:.95rem;line-height:1.55;color:var(--ink);white-space:pre-wrap;overflow-wrap:anywhere}
  .note{margin-top:1rem;padding:.75rem .9rem;background:var(--paper);border-left:2px solid var(--glacier);border-radius:0 6px 6px 0;font-size:.84rem;line-height:1.55;color:#4a4d40}
  .preview{margin-top:.8rem;padding:.7rem .85rem;background:var(--paper);border-radius:6px;font-size:.9rem;line-height:1.5}
  form{margin-top:1.4rem}
  .field{margin-bottom:1.1rem}
  .field label{display:block;font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;margin-bottom:.4rem}
  .field textarea{width:100%;min-height:8rem;padding:.7rem .85rem;border:1px solid rgba(20,22,14,.22);border-radius:6px;background:var(--paper);font:inherit;line-height:1.5}
  .consent{display:flex;gap:.7rem;align-items:flex-start;margin:1.2rem 0}
  .consent input{margin-top:.25rem}
  .consent label{font-size:.9rem;line-height:1.5}
  .actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.2rem}
  .actions button{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;padding:.75rem 1.1rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:6px;cursor:pointer}
  .actions a{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;padding:.75rem 1.1rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;color:var(--ink);text-decoration:none}
  .err{color:#8b2e2e;font-size:.84rem;margin-top:.35rem}
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(179,38,30,.1);border-left:3px solid var(--danger);color:var(--danger-ink);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
</style>
{% endblock %}
{% block body %}
<div class="wrap" id="main">
  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <a class="back" href="{{ path('translate') }}">← {{ 'translate.back'|trans }}</a>
  <div class="ey">{{ 'translate.kicker'|trans }}</div>
  <h1>{{ entry.messageKey }}</h1>

  <div class="panel">
    <div class="lab">{{ 'translate.field.english'|trans }}</div>
    <div class="val">{{ entry.english }}</div>
  </div>
  <div class="panel">
    <div class="lab">{{ 'translate.field.yaml'|trans }}</div>
    <div class="val">{{ yaml_default }}</div>
  </div>
  <div class="panel">
    <div class="lab">{{ 'translate.field.live'|trans }}</div>
    <div class="val">{{ live }}</div>
  </div>

  {% if has_markup %}
    <p class="note">{{ 'translate.markup_note'|trans }}</p>
  {% endif %}

  {{ form_start(form) }}
    <div class="field">
      {{ form_label(form.value) }}
      {{ form_widget(form.value) }}
      {{ form_errors(form.value) }}
    </div>

    {% if proposed_preview is not empty %}
      <div class="panel">
        <div class="lab">{{ 'translate.field.preview'|trans }}</div>
        <div class="preview">{{ proposed_preview|rich }}</div>
      </div>
    {% endif %}

    <div class="consent">
      {{ form_widget(form.consent) }}
      {{ form_label(form.consent) }}
    </div>
    {{ form_errors(form.consent) }}
    {{ form_errors(form) }}

    <div class="actions">
      <button type="submit">{{ 'translate.submit'|trans }}</button>
      <a href="{{ path('translate') }}">{{ 'translate.cancel'|trans }}</a>
    </div>
  {{ form_end(form) }}
</div>
{% endblock %}
