{% extends 'base.html.twig' %}
{% block head_styles %}
<style>
  .wrap{max-width:820px;margin:0 auto;padding:2.2rem clamp(1.25rem,4vw,2rem)}
  .ey{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  h1{font-family:var(--serif);font-weight:600;font-size:2rem;line-height:1.05}
  .sub{color:#4a4d40;margin-top:.6rem;max-width:74ch;line-height:1.65}
  .chooser{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;gap:.8rem}
  .chooser a{display:block;padding:1.1rem 1.2rem;background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:8px;text-decoration:none;color:var(--ink);transition:all .2s}
  .chooser a:hover{border-color:var(--trail);transform:translateY(-2px);box-shadow:0 10px 24px -16px rgba(20,22,14,.45)}
  .chooser .loc{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .chooser .nm{font-family:var(--serif);font-weight:600;font-size:1.15rem;margin-top:.2rem}
  .search{display:flex;gap:.6rem;margin:1.6rem 0 1.2rem;flex-wrap:wrap}
  .search input[type=search]{flex:1;min-width:12rem;padding:.65rem .85rem;border:1px solid rgba(20,22,14,.22);border-radius:6px;background:var(--paper);font:inherit}
  .search button{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;padding:.7rem 1rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:6px;cursor:pointer}
  .rows{list-style:none;padding:0;margin:0}
  .row{display:block;padding:1rem 1.1rem;margin-bottom:.75rem;border:1px solid rgba(20,22,14,.14);border-radius:8px;background:var(--paper-deep);text-decoration:none;color:inherit;transition:border-color .2s}
  .row:hover{border-color:var(--trail)}
  .row-key{font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;color:var(--clay)}
  .row-en{font-size:.95rem;margin-top:.25rem;line-height:1.45}
  .row-live{font-size:.84rem;color:#4a4d40;margin-top:.35rem;line-height:1.45}
  .row-meta{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#7a7d6d;margin-top:.45rem}
  .row-meta.is-pending{color:var(--ochre)}
  .empty{color:#4a4d40;margin-top:1.2rem}
</style>
{% endblock %}
{% block body %}
<div class="wrap" id="main">
  <div class="ey">{{ 'translate.kicker'|trans }}</div>
  <h1>{{ 'translate.title'|trans }}</h1>

  {% if chooser %}
    <p class="sub">{{ 'translate.chooser_lead'|trans }}</p>
    <ul class="chooser">
      {% for loc in locales %}
        <li>
          <a href="{{ path('translate', {_locale: loc}) }}">
            <div class="loc">{{ loc }}</div>
            <div class="nm">{{ ('translate.locale.' ~ loc)|trans }}</div>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="sub">{{ 'translate.list_lead'|trans }}</p>
    <form class="search" method="get" action="{{ path('translate') }}">
      <input type="search" name="q" value="{{ q }}" placeholder="{{ 'translate.search_ph'|trans }}" aria-label="{{ 'translate.search_ph'|trans }}">
      <button type="submit">{{ 'translate.search'|trans }}</button>
    </form>

    {% if rows is empty %}
      <p class="empty">{{ 'translate.empty'|trans }}</p>
    {% else %}
      <ul class="rows">
        {% for row in rows %}
          <li>
            <a class="row" href="{{ path('translate_edit', {id: row.id}) }}">
              <div class="row-key">{{ row.message_key }}</div>
              <div class="row-en">{{ row.english }}</div>
              <div class="row-live">{{ row.live }}</div>
              {% if row.has_pending %}
                <div class="row-meta is-pending">{{ 'translate.pending'|trans }}</div>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
      {% include 'partials/_pager.html.twig' with {pager: pager, route: 'translate', params: pager_params} %}
    {% endif %}
  {% endif %}
</div>
{% endblock %}
