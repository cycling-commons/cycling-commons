{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<style>
  .chooser{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;gap:.8rem}
  .chooser li{padding:1.1rem 1.2rem;background:var(--paper-deep);border:1px solid rgba(20,22,14,.14);border-radius:8px;transition:border-color .2s,transform .2s,box-shadow .2s}
  .chooser li:hover{border-color:var(--trail);transform:translateY(-2px);box-shadow:0 10px 24px -16px rgba(20,22,14,.45)}
  .chooser .loc{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--clay)}
  .chooser .nm{font-family:var(--serif);font-weight:600;font-size:1.15rem;margin-top:.2rem}
  {# Two doors per card (translations.md §4.1): a plain link to that locale's
     catalogue list, and a POST that turns translate mode on and lands on
     that locale's home page. A single <a> can only carry one destination,
     so the card itself is not the link; the two actions below are. #}
  .chooser-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.85rem}
  .chooser-actions form{margin:0}
  .chooser-actions a,.chooser-actions button{font:inherit;font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;padding:.55rem .8rem;border-radius:6px;cursor:pointer;text-decoration:none;line-height:1.2}
  .chooser-actions a{border:1px solid rgba(20,22,14,.25);background:var(--paper);color:var(--ink)}
  .chooser-actions a:hover{border-color:var(--trail)}
  .chooser-actions button{border:1px solid var(--ink);background:var(--ink);color:var(--paper)}
  .tr-search{display:flex;gap:.6rem;margin:0 0 1.2rem;flex-wrap:wrap}
  .tr-search input[type=search]{flex:1;min-width:12rem;padding:.65rem .85rem;border:1px solid rgba(20,22,14,.22);border-radius:6px;background:var(--paper);font:inherit}
  .tr-search button{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;padding:.7rem 1rem;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:6px;cursor:pointer}
  .tr-rows{list-style:none;padding:0;margin:0}
  .tr-row{display:block;padding:1rem 1.1rem;margin-bottom:.75rem;border:1px solid rgba(20,22,14,.14);border-radius:8px;background:var(--paper-deep);text-decoration:none;color:inherit;transition:border-color .2s}
  .tr-row:hover{border-color:var(--trail)}
  .row-key{font-family:var(--mono);font-size:.68rem;letter-spacing:.04em;color:var(--clay)}
  .row-en{font-size:.95rem;margin-top:.25rem;line-height:1.45}
  .row-live{font-size:.84rem;color:#4a4d40;margin-top:.35rem;line-height:1.45}
  .row-meta{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:#7a7d6d;margin-top:.45rem}
  .row-meta.is-pending{color:var(--ochre)}
  .row-meta.is-stale{color:#8a5a00}
  .tr-mode-toggle{margin:0 0 1.2rem}
  .tr-mode-toggle button{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;padding:.6rem .9rem;border:1px solid rgba(20,22,14,.25);background:var(--paper);color:var(--ink);border-radius:6px;cursor:pointer}
</style>
{% endblock %}
{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'translate'} %}{% endblock %}
{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ 'translate.kicker'|trans }}</div>
    <h1>{{ 'translate.title'|trans }}</h1>
    <p class="lead">
      {%- if chooser %}{{ 'translate.chooser_lead'|trans }}
      {%- elseif is_english|default(false) %}{{ 'translate.english.list_lead'|trans }}
      {%- else %}{{ 'translate.list_lead'|trans }}
      {%- endif %}
    </p>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('danger') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  <nav class="lfilter" aria-label="{{ 'translate.section_aria'|trans }}">
    <a class="lchip on" href="{{ path('translate') }}">{{ 'translate.catalogue'|trans }}</a>
    <a class="lchip tr-yours" href="{{ path('translate_mine') }}">{{ 'translate.mine.yours'|trans }}</a>
    {% if not chooser and not is_english|default(false) %}
      <a class="lchip tr-stale{{ stale_only ? ' on' }}" href="{{ path('translate', {stale: 1}) }}">{{ 'translate.stale.chip'|trans }}</a>
    {% endif %}
  </nav>

  {% if chooser %}
    <ul class="chooser">
      {% for loc in locales %}
        <li>
          <div class="loc">{{ loc }}</div>
          <div class="nm">{{ ('translate.locale.' ~ loc)|trans }}</div>
          <div class="chooser-actions">
            <a href="{{ path('translate', {_locale: loc}) }}">{{ 'translate.chooser.browse'|trans }}</a>
            {# Turns translate mode on and sends the reader to that locale's
               home page (translations.md §4.1). A form, not a link: it
               carries the CSRF token that /translate/mode requires. #}
            <form method="post" action="{{ path('translate_mode') }}">
              {# "_csrf_token", not Symfony's default "_token": this page
                 renders the on-page bar's own toggle form further down with
                 the same name, and a bare "_token" here would be the first
                 match a scraper reading raw HTML finds. #}
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('translate_mode') }}">
              <input type="hidden" name="on" value="1">
              <input type="hidden" name="locale" value="{{ loc }}">
              <button type="submit">{{ 'translate.mode.on'|trans }}</button>
            </form>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <form class="tr-search" method="get" action="{{ path('translate') }}">
      <input type="search" name="q" value="{{ q }}" placeholder="{{ 'translate.search_ph'|trans }}" aria-label="{{ 'translate.search_ph'|trans }}">
      <button type="submit">{{ 'translate.search'|trans }}</button>
    </form>

    {# Translate mode (translations.md §4.1): opens the same form from the
       page a string is on. `translate_mode()` reports what
       `App\Translation\TranslateMode` decided for this request, so the button
       is a toggle: it posts the opposite of what is showing. #}
    <form method="post" action="{{ path('translate_mode') }}" class="tr-mode-toggle">
      {# Field name is "_csrf_token", not Symfony's default "_token": this
         page has other forms with their own tokens further down, and the
         first "_token" in the document is what a test (or any scraper)
         reading raw HTML would grab. #}
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('translate_mode') }}">
      <input type="hidden" name="on" value="{{ translate_mode() ? 0 : 1 }}">
      <button type="submit">{{ (translate_mode() ? 'translate.mode.off' : 'translate.mode.on')|trans }}</button>
    </form>

    {% if rows is empty %}
      <div class="empty-state">
        <p>{{ 'translate.empty'|trans }}</p>
      </div>
    {% else %}
      <ul class="tr-rows">
        {% for row in rows %}
          <li>
            <a class="tr-row row" href="{{ path('translate_edit', {id: row.id}) }}">
              <div class="row-key">{{ row.message_key }}</div>
              {% if is_english|default(false) %}
                <div class="row-en">{{ row.yaml_default }}</div>
                <div class="row-live">{{ row.live }} v{{ row.english_version }}</div>
              {% else %}
                <div class="row-en">{{ row.english }}</div>
                <div class="row-live">{{ row.live }}</div>
              {% endif %}
              {% if row.has_pending %}
                <div class="row-meta is-pending">{{ 'translate.pending'|trans }}</div>
              {% endif %}
              {% if row.stale %}
                <div class="row-meta is-stale">{{ 'translate.stale.tag'|trans({'%from%': row.made_against, '%to%': row.english_version}) }}</div>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
      {% include 'partials/_pager.html.twig' with {pager: pager, route: 'translate', params: pager_params} %}
    {% endif %}
  {% endif %}
</div>
{% endblock %}
