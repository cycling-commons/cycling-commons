{#
  The rides a rider planned on the map and saved (docs/specs/route-planner.md
  section 6.2). Their own rows and nothing else: the controller hands the
  service the signed-in rider, never an id from the request alone.

  A ride opens on the map by its link, where it can be changed, saved again
  and taken along as a GPX; this page lists and deletes.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/account/rides.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'rides'} %}{% endblock %}

{% block body %}
<div class="dbody dmin" id="main">
  <div class="mh">
    <div class="kicker">{{ 'account.menu_personal'|trans }} · {{ cc_user.displayName }}</div>
    <h1>{{ 'account.tab_rides'|trans }}</h1>
    <p class="lede">{{ 'account.rides_lede'|trans }}</p>
  </div>

  {% if rides is empty %}
    <div class="empty">
      {{ 'account.rides_empty'|trans }}
      <a href="{{ path('map') }}?panel=plan">{{ 'account.rides_empty_link'|trans }}</a>
    </div>
  {% else %}
    {% for r in rides %}
      <div class="ride-row">
        <div class="ride-top">
          <h2>{{ r.name }}</h2>
          <span class="tag">{{ ('map.bike_' ~ (r.bike.value|lower|replace({'-': ''})))|trans }}</span>
        </div>
        <p class="ride-meta">
          {{ (r.distanceM / 1000)|cc_km }} · {{ r.ascentM|cc_elev }} ↑ · {{ 'account.rides_stops'|trans({'{n}': r.stops|length}) }} · {{ 'account.rides_saved'|trans({'{date}': r.updatedAt|cc_date}) }}
        </p>
        <div class="ride-acts">
          <a class="ride-go" href="{{ path('map') }}?ride={{ r.id }}">{{ 'account.rides_open'|trans }}</a>
          <form method="post" action="{{ path('account_rides_delete', {id: r.id}) }}" data-confirm="{{ 'account.rides_delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('plan-delete') }}">
            <button type="submit" class="ride-del">{{ 'account.rides_delete'|trans }}</button>
          </form>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>
<script nonce="{{ csp_nonce() }}">
  document.querySelectorAll('form[data-confirm]').forEach(function (f) {
    f.addEventListener('submit', function (e) { if (!window.confirm(f.dataset.confirm)) e.preventDefault(); });
  });
</script>
{% endblock %}
