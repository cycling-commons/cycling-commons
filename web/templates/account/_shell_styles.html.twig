{# Shared styles for the account shell (dark identity bar + tabs).
   Included in the head_styles of every logged-in account page so they share one
   look: the dashboard, settings, and 2FA setup. #}
<style>
  .dtop{background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem clamp(1.25rem,4vw,2rem)}
  .dtop .brandblock{display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none}
  .dtop .brand img{height:1.8rem;display:block}
  .dtop .brandsub{font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap}
  /* the account chip (global styles) sits in the dtop's right slot, next to the
     shared language switcher (scoped copies of the .topnav lang styles — the
     shell header is its own dark bar, not .topnav). */
  .dtop-right{display:flex;align-items:center;gap:.8rem}
  .dtop .lang-menu{position:relative}
  .dtop .lang-chip{display:inline-flex;align-items:center;gap:.32rem;background:none;border:1.5px solid rgba(239,230,212,.4);border-radius:999px;padding:.34rem .55rem;color:var(--paper);cursor:pointer;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;line-height:1;transition:border-color .2s}
  .dtop .lang-chip:hover{border-color:var(--trail)}
  .dtop .lang-caret{transition:transform .2s}
  .dtop [aria-expanded="true"] .lang-caret{transform:rotate(180deg)}
  .dtop .lang-dropdown{right:0;left:auto}
  /* Shared account-page presence: content areas keep vertical height even when
     empty, and empty panes render a centred block with a real door — never a
     lone floating line. */
  .dbody,.dmin{min-height:46vh}
  .empty-state{text-align:center;padding:4rem 1.5rem 4.5rem;color:#595c4d}
  .empty-state p{max-width:46ch;margin:0 auto 1.3rem;font-size:.95rem;line-height:1.6}
  .empty-state .door{display:inline-block;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;border:1.5px solid var(--ink);border-radius:5px;padding:.6rem 1rem;color:var(--ink);text-decoration:none;transition:background .2s}
  .empty-state .door:hover{background:var(--trail)}
  .dtabs{display:flex;gap:.5rem;padding:0 clamp(1.25rem,4vw,2rem);background:var(--paper-deep);border-bottom:1px solid rgba(20,22,14,.12);overflow-x:auto}
  .dtabs a{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:1rem .9rem;cursor:pointer;color:#595c4d;border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;text-decoration:none}
  /* the selected section must be unmistakable: ink text + orange underline + a
     clear tint box (with side padding so the tint doesn't hug the label). */
  .dtabs a.on{color:var(--ink);border-color:var(--trail);background:rgba(255,90,31,.16)}
  /* moderator mode: the WHOLE bar switches colour and carries only the
     moderation tabs — no user items; unmistakably a different area. */
  .dtabs.dtabs-modmode{background:#D8CBB1;border-bottom-color:rgba(20,22,14,.22)}
  /* the MODERATION label is a solid full-height block bleeding to the bar's
     left edge — you cannot miss whose bar this is. */
  .dtabs-modlabel{display:flex;align-items:center;align-self:stretch;background:var(--clay);color:var(--paper);font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;margin-left:calc(-1 * clamp(1.25rem,4vw,2rem));padding:0 1rem 0 clamp(1.25rem,4vw,2rem)}
  /* the personal (default) area gets the same bleeding block, in the site's
     spruce — a clear, calm counterpart to moderation's clay so you always
     know which mode you are in. */
  .dtabs-personallabel{background:var(--spruce)}
  .dtabs.dtabs-modmode a.on{background:rgba(255,90,31,.2)}
  /* per-tab open-count badge (scoped to the moderator's jurisdiction) */
  .dtab-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.15rem;height:1.15rem;margin-left:.45rem;padding:0 .35rem;border-radius:999px;background:var(--clay);color:var(--paper);font-size:.62rem;font-weight:700;line-height:1;vertical-align:middle}
  /* ONE button system for the account/moderation desks — the site's brand orange
     (--trail), matching .export/.cc-d-act. Primary actions = orange fill; the
     less-prominent / destructive ones (reject, dismiss, retire, needs-info) keep
     the same shape but read as orange-text-on-transparent. No more green/clay mix. */
  .btn-act{font-family:var(--sans);font-weight:700;font-size:.82rem;padding:.6rem 1rem;border-radius:5px;border:1.5px solid var(--trail);background:var(--trail);color:var(--ink);cursor:pointer;transition:background .15s,color .15s,box-shadow .15s}
  .btn-act:hover{background:#ff703d;border-color:#ff703d}
  .btn-act:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(255,90,31,.35)}
  .btn-act.btn-secondary,.btn-reject,.btn-dismiss,.btn-needs-info{background:transparent;color:var(--trail)}
  .btn-act.btn-secondary:hover,.btn-reject:hover,.btn-dismiss:hover,.btn-needs-info:hover{background:var(--trail);color:var(--ink)}
  /* Flash feedback — shared by every shell page (the desks set success/danger
     flashes; without these render styles + the loops in the templates the
     feedback was invisible). Same look as settings' local rules. */
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(181,83,46,.1);border-left:3px solid var(--clay);color:var(--clay);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
</style>
