{# SPDX-License-Identifier: LicenseRef-PolyForm-Shield-1.0.0 #}
{# Shared styles for the account shell (dark identity bar + tabs) AND the one
   list system every shell page renders with: the page head, the container, the
   filter bar, the record card, the pill, the note, the diff and the density
   switch. Included in the head_styles of every logged-in page so a rider's
   contributions, their messages and a curator's queue are the same page with
   different rows (owner 2026-08-25: "same look and feel for users and
   moderators"). A page's own <style> block keeps only what is truly its own.
   Spec: account-and-auth.md §8, moderation-and-contribution.md §5.2. #}
<style>
  .dtop{background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem clamp(1.25rem,4vw,2rem)}
  .dtop .brandblock{display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none}
  .dtop .brand img{height:1.8rem;display:block}
  .dtop .brandsub{font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap}
  /* the account chip (global styles) sits in the dtop's right slot, next to the
     shared language switcher (scoped copies of the .topnav lang styles — the
     shell header is its own dark bar, not .topnav). */
  .dtop-right{display:flex;align-items:center;gap:.8rem}
  .dtop .lang-menu{position:relative}
  .dtop .lang-chip{display:inline-flex;align-items:center;gap:.32rem;background:none;border:1.5px solid rgba(239,230,212,.4);border-radius:999px;padding:.34rem .55rem;color:var(--paper);cursor:pointer;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;line-height:1;transition:border-color .2s}
  .dtop .lang-chip:hover{border-color:var(--trail)}
  .dtop .lang-caret{transition:transform .2s}
  .dtop [aria-expanded="true"] .lang-caret{transform:rotate(180deg)}
  .dtop .lang-dropdown{right:0;left:auto}
  /* Shared account-page presence: content areas keep vertical height even when
     empty, so sparse pages keep their shape. */
  .dbody,.dmin{min-height:46vh}
  /* overflow-y MUST be pinned. Setting only overflow-x:auto makes the other axis
     compute to `auto` too (CSS overflow §), and `.dtabs a` carries
     margin-bottom:-1px to pull the active tab's border over the bar's — one
     pixel of overflow, which is all a scrollbar track needs. The result was a
     little vertical scrollbar beside the moderation tabs, which read as the
     account menu having one (owner-reported 2026-08-03). This strip scrolls
     sideways or not at all. */
  .dtabs{display:flex;gap:.5rem;padding:0 clamp(1.25rem,4vw,2rem);background:var(--paper-deep);border-bottom:1px solid rgba(20,22,14,.12);overflow-x:auto;overflow-y:hidden}
  .dtabs a{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:1rem .9rem;cursor:pointer;color:#595c4d;border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;text-decoration:none}
  /* the selected section must be unmistakable: ink text + orange underline + a
     clear tint box (with side padding so the tint doesn't hug the label). */
  .dtabs a.on{color:var(--ink);border-color:var(--trail);background:rgba(255,90,31,.16)}
  /* moderator mode: the WHOLE bar switches colour and carries only the
     moderation tabs — no user items; unmistakably a different area. */
  .dtabs.dtabs-modmode{background:#D8CBB1;border-bottom-color:rgba(20,22,14,.22)}
  /* the MODERATION label is a solid full-height block bleeding to the bar's
     left edge — you cannot miss whose bar this is. */
  .dtabs-modlabel{display:flex;align-items:center;align-self:stretch;background:var(--clay);color:var(--paper);font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;margin-left:calc(-1 * clamp(1.25rem,4vw,2rem));padding:0 1rem 0 clamp(1.25rem,4vw,2rem)}
  /* the personal (default) area gets the same bleeding block, in the site's
     spruce — a clear, calm counterpart to moderation's clay so you always
     know which mode you are in. */
  .dtabs-personallabel{background:var(--spruce)}
  .dtabs.dtabs-modmode a.on{background:rgba(255,90,31,.2)}
  /* per-tab open-count badge (scoped to the moderator's jurisdiction) */
  .dtab-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.15rem;height:1.15rem;margin-left:.45rem;padding:0 .35rem;border-radius:999px;background:var(--clay);color:var(--paper);font-size:.62rem;font-weight:700;line-height:1;vertical-align:middle}

  /* ── The page: one container, one head ──────────────────────────────────
     `.dbody` is the content column of every shell page, rider or curator; it
     carries id="main" for the skip link. `.mh` is the head: an eyebrow, the
     title, and either a count line or a lead. Rider pages used to have a
     small mono label and no title while the desks had both, which is one of
     the things that made the two areas read as two products. */
  .dbody{max-width:1120px;width:100%;margin:0 auto;padding:1.2rem clamp(1.25rem,4vw,2.5rem) 2.6rem}
  .mh{padding:.4rem 0 1rem}
  .mh .kicker{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:.6rem}
  .mh h1{font-family:var(--serif);font-weight:600;font-size:clamp(1.8rem,4vw,2.4rem);line-height:1.08;margin:0 0 .4rem;color:var(--ink)}
  .mh .pend-count{font-family:var(--mono);font-size:.68rem;color:var(--clay);margin-top:.5rem;display:inline-block}
  .mh .lead{color:#4a4d40;max-width:56ch;font-size:.94rem;line-height:1.55;margin:0}
  .mh .lead a{color:var(--clay);text-decoration:underline;text-underline-offset:2px}
  /* A section inside a page: a coloured label on a thin rule, with an optional
     count. The same band whether it says "Route proposals" to a rider or
     "Pending corrections" to a curator. */
  .sec-band{display:flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.66rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--clay);padding:0 0 .5rem;margin:1.6rem 0 .8rem;border-bottom:1.5px solid rgba(184,89,58,.4)}
  .sec-band:first-child{margin-top:0}
  .sec-band--corr{color:var(--spruce);border-color:rgba(28,58,42,.35)}
  .sec-band--quiet{color:#8a8d7d;border-color:rgba(20,22,14,.14);font-weight:600}
  .sec-band .sec-count{display:inline-flex;align-items:center;justify-content:center;min-width:1.2rem;height:1.2rem;padding:0 .35rem;border-radius:999px;background:rgba(20,22,14,.08);color:#595c4d;font-size:.62rem}
  .sec-empty{color:#595c4d;font-size:.9rem;padding:.4rem 0 1.5rem}
  .sec-lead{font-size:.86rem;color:#4a4d40;margin:0 0 1rem;line-height:1.5;max-width:70ch}
  .sec-lead a{color:var(--clay);text-decoration:underline;text-underline-offset:2px}

  /* ── The filter bar ──────────────────────────────────────────────────────
     Selects + search with an Apply, and/or a row of chips. Every list page
     draws its filters from these two shapes and nothing else. */
  .mod-bar{display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;margin:0 0 1.2rem}
  .mod-filters{display:flex;gap:1rem;flex-wrap:wrap;align-items:end;margin:0}
  .mod-filters label{font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:flex;flex-direction:column;gap:.3rem}
  .mod-filters select{font-family:var(--sans);font-size:.9rem;padding:.5rem;min-height:34px;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);min-width:150px}
  .mod-search{font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:flex;flex-direction:column;gap:.3rem}
  .mod-search input{font-family:var(--sans);font-size:.9rem;padding:.5rem;min-height:34px;border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);min-width:16rem}
  .mod-go{align-self:flex-end}
  /* A queue narrowed to one person's work has to say so. */
  .mod-byuser{font-size:.86rem;color:#4a4d40;margin:0 0 1rem}
  .mod-byuser a{color:var(--clay);text-decoration:underline;text-underline-offset:2px}
  /* Chips: the quiet bordered family. The active one wears the ink; a count,
     when the chip carries one, is part of the chip and not a tooltip. */
  .lfilter{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:0 0 1rem}
  .lfilter .lsep{width:1px;height:20px;background:rgba(20,22,14,.18);margin:0 .4rem}
  .lchip{display:inline-flex;align-items:center;gap:.3rem;border:1px solid rgba(20,22,14,.3);border-radius:30px;padding:.3rem .7rem;min-height:30px;
    font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;
    color:#595c4d;text-decoration:none;background:transparent;cursor:pointer}
  .lchip:hover{border-color:var(--clay);color:var(--clay)}
  .lchip.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .lchip b{font-family:var(--sans);font-size:.74rem;font-weight:700;color:var(--ink);letter-spacing:0}
  .lchip.on b{color:var(--paper)}
  .lchip--push{margin-left:auto}
  @media(max-width:520px){.lchip--push{margin-left:0}}

  /* ── Pills, links, notes: the small vocabulary every card shares ──────── */
  .q-pill{font-family:var(--mono);font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;padding:.25rem .5rem;border-radius:30px;white-space:nowrap;flex:0 0 auto;line-height:1.3}
  .q-pill--ok{background:#3e7d4f;color:#fff}
  .q-pill--pend{background:var(--ochre);color:var(--ink)}
  .q-pill--conf{background:var(--spruce);color:var(--paper)}
  .q-pill--rej{background:var(--clay);color:#fff}
  .q-pill--ret{background:rgba(20,22,14,.12);color:#595c4d}
  .q-pill--danger{background:#8b1a1a;color:#fff}
  /* Small mono links on a row: Map ↗, Edit, View on map. The one a reader has
     to act on (answer the curator) is orange and bold. */
  /* The type's icon, first on a row: a drawn SVG in the text colour (partials/_type_icon). */
  .q-icon{display:inline-flex;flex:0 0 auto;align-self:center;color:#4a4d40}
  .q-icon svg{display:block;width:18px;height:18px}
  /* A glyph icon: the emoji stack map.css declares as --emoji (the shell does
     not load map.css), flattened to the same dark mark as the drawn ones. */
  .q-icon--glyph{width:18px;height:18px;justify-content:center;font-size:1rem;line-height:1;font-style:normal;font-family:"Apple Color Emoji","Noto Color Emoji","Segoe UI Emoji","Noto Sans Symbols2",system-ui,sans-serif;filter:grayscale(1) brightness(.35) contrast(1.4)}
  /* The item's own kind, small, after a title ("Thier Antoine CLIMBS"). */
  .q-kind{font-family:var(--mono);font-size:.58rem;letter-spacing:.06em;text-transform:uppercase;color:#8a8d7d;margin-left:.4rem;font-weight:400;white-space:nowrap}
  .q-links{display:inline-flex;gap:.9rem;align-items:center;flex-wrap:wrap}
  .q-link{font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay);white-space:nowrap;text-decoration:none}
  .q-link:hover{color:var(--trail)}
  .q-link--act{color:var(--trail)!important;font-weight:700}
  /* A link-styled trigger: the "Show details" button in an action row. */
  button.q-link,summary.q-link{border:0;background:none;padding:0;cursor:pointer;font-family:var(--mono);font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;color:var(--trail);text-decoration:underline;text-underline-offset:2px;list-style:none;display:inline-flex;align-items:center}
  summary.q-link::-webkit-details-marker{display:none}
  button.q-link[aria-expanded="true"],summary.q-link:hover,button.q-link:hover{background:none;color:var(--ink)}
  /* The date sits in the action row on a rider's card, on one line with the
     links and the pill (owner 2026-08-25): no auto margin there. */
  .q-acts .q-when{margin-left:0}
  /* The panel host the card script adds after an action row takes the whole
     row, so an open panel drops UNDER the card, never beside the buttons. */
  .q-top > .q-panels{flex:1 0 100%}
  /* An empty host must not cost the row its flex gap: hidden until a panel opens. */
  .q-panels[hidden]{display:none}
  /* The action column is right-aligned, and a break inside it starts a
     second line (the rider's Show details under Map · Edit · status). */
  .q-acts{justify-content:flex-end}
  .q-acts-break{flex:1 0 100%;height:0}
  /* A diff that opens as an action panel under the card. */
  .q-act-panel.q-diff{background:rgba(20,22,14,.05);border:0}
  /* A quoted line under a row: a curator's note, a rider's reply, the previous
     verdict. One shape, three accent colours. */
  .q-note{font-size:.88rem;line-height:1.55;color:#4a4d40;background:var(--paper-deep);border-left:2px solid var(--glacier);padding:.55rem .8rem;border-radius:0 5px 5px 0;margin:.6rem 0 0;white-space:pre-line}
  .q-note strong,.q-note b{color:var(--ink);font-weight:700}
  .q-note--answer{border-left-color:var(--ochre)}
  .q-note--prior{border-left-color:var(--clay)}
  .q-note--prior strong{color:var(--clay)}
  .q-note-h{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:block}
  .q-note .q-when{display:block;margin:.3rem 0 0}
  /* The was → now diff as a label/value grid (a rider's contribution, a
     message). The desk's two-line was/now inside .q-diff keeps its shape. */
  .q-diff dl{display:grid;grid-template-columns:auto 1fr;gap:.15rem .7rem;margin:0}
  .q-diff dt{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d;align-self:baseline;padding-top:.15rem}
  .q-diff dd{margin:0;min-width:0;overflow-wrap:anywhere}
  .q-diff .was,.q-diff .q-was{color:#8a8d7d;text-decoration:line-through;margin-right:.4rem}
  .q-diff .now,.q-diff .q-now{color:var(--trail)}
  .q-diff-h{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:#595c4d;display:block;margin-bottom:.25rem}
  @media(max-width:520px){.q-diff dl{grid-template-columns:1fr;gap:0}.q-diff dt{padding-top:.35rem}}
  /* Folded diff: a small link, the grid opens under it. Native <details>, no
     script (owner 2026-08-25). */
  /* Tight under the meta line: the link is part of the row, not a new block (owner 2026-08-25). */
  details.q-diff{background:none;padding:0;margin:.1rem 0 0}
  details.q-diff summary{display:inline;cursor:pointer;font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--trail);text-decoration:underline;text-underline-offset:2px;list-style:none}
  details.q-diff summary::-webkit-details-marker{display:none}
  details.q-diff summary:focus-visible{outline:2px solid var(--ochre);outline-offset:2px}
  details.q-diff .q-diff-show{display:inline}details.q-diff .q-diff-hide{display:none}
  details.q-diff[open] .q-diff-show{display:none}details.q-diff[open] .q-diff-hide{display:inline}
  details.q-diff .q-diff-body{margin-top:.5rem;padding:.5rem .7rem;background:rgba(20,22,14,.05);border-radius:5px}
  /* A folded conversation under a settled row. */
  .q-thread{margin:.4rem 0 0}
  .q-thread summary{cursor:pointer;font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:var(--clay);padding:.2rem 0;list-style:none}
  .q-thread summary::-webkit-details-marker{display:none}
  .q-thread summary:hover{color:var(--ink)}
  .q-msgs{list-style:none;margin:.35rem 0 .2rem;padding:0;border-left:2px solid rgba(20,22,14,.14)}
  .q-msg{display:flex;gap:.6rem;align-items:baseline;padding:.25rem 0 .25rem .7rem;font-size:.84rem;color:#3a3d33}
  .q-msg-who{font-family:var(--mono);font-size:.55rem;letter-spacing:.08em;text-transform:uppercase;flex:0 0 4.2rem;color:#595c4d}
  .q-msg--rider .q-msg-who{color:var(--clay)}
  .q-msg-body{flex:1 1 auto;min-width:0}
  .q-msg-when{font-family:var(--mono);font-size:.6rem;color:#8a8d7d;flex:0 0 auto}
  /* A quiet map pointer under a card ("see both on the map"). */
  .q-map{margin:.7rem 0 0;font-size:.82rem;color:#5c5f50}
  .q-map a{color:var(--spruce-lift);font-weight:600}
  .q-map span{margin-left:.4rem}
  /* A reply box inside a card. */
  .q-reply{margin-top:.8rem;padding-top:.7rem;border-top:1px solid rgba(20,22,14,.1);display:flex;flex-direction:column;gap:.45rem}
  .q-reply label{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:#595c4d}
  .q-reply textarea{width:100%;min-height:80px;font-family:var(--sans);font-size:.85rem;padding:.5rem;border:1px solid rgba(20,22,14,.25);border-radius:6px;resize:vertical}
  .q-reply button{align-self:flex-start}
  /* Arriving from a link that names one row. */
  .q-item:target{border-color:var(--ochre);box-shadow:0 0 0 2px var(--ochre);scroll-margin-top:1.5rem}
  /* A row a reader has to act on, or has not seen: outlined in the brand
     orange. Their own sent row: dashed, set back. */
  .q-item--new{border-color:var(--trail);box-shadow:0 0 0 1px var(--trail)}
  .q-item--new .q-title{font-weight:800}
  .q-item--mine{border-style:dashed;background:var(--paper-deep)}
  .q-photo-lg{margin:.4rem 0}
  .q-photo-lg img{width:120px;height:90px;object-fit:cover;border-radius:5px;display:block}
  /* Nothing here: left-aligned, in the same voice as a page lead, with a door
     when there is one to open (owner 2026-08-25: the centred block and the ▲
     ornament are gone). */
  .empty-state{text-align:left;padding:.6rem 0 1.5rem;color:#4a4d40;max-width:60ch}
  .empty-state h3{font-family:var(--serif);font-weight:600;font-size:1.15rem;margin:0 0 .3rem;color:var(--ink)}
  .empty-state p{font-size:.94rem;line-height:1.55;margin:0 0 .9rem}
  .empty-state p:last-child{margin-bottom:0}
  .empty-state .door{display:inline-block;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;border:1.5px solid var(--ink);border-radius:5px;padding:.6rem 1rem;color:var(--ink);text-decoration:none;transition:background .2s}
  .empty-state .door:hover{background:var(--trail)}
  .empty-state a{color:var(--clay)}

  /* The pager reads as a footer to the list it closes, not as three stray
     controls floating after it: a hairline rule above, a tinted strip, and
     enough space below that the page's own footer never crowds it (owner,
     2026-08-09). */
  .pager{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem 1.2rem;
         margin:2rem 0 3.5rem;padding:.9rem 1.1rem;
         border:1px solid rgba(20,22,14,.18);border-top:2px solid var(--clay);border-radius:0 0 8px 8px;
         background:var(--paper-deep);font-family:var(--mono);font-size:.66rem}
  .pager-steps{display:flex;gap:.5rem;flex:none}
  .pager-step{color:var(--clay);text-decoration:none;border:1px solid rgba(20,22,14,.25);border-radius:30px;
              padding:.45rem .9rem;min-height:32px;display:inline-flex;align-items:center;
              letter-spacing:.06em;text-transform:uppercase;background:var(--paper)}
  .pager-step:hover{border-color:var(--clay);background:var(--clay);color:var(--paper)}
  .pager-step.is-off{opacity:.32;border-style:dashed;background:none;pointer-events:none}
  /* The range is the headline — "26–50 of 213" answers the question a reader
     actually has; the page number is the supporting detail, so it is quieter
     and sits under it. */
  .pager-at{margin:0 auto 0 0;display:flex;flex-direction:column;gap:.15rem;line-height:1.35}
  .pager-range{color:var(--ink);font-size:.72rem}
  .pager-of{color:#595c4d;font-size:.6rem;letter-spacing:.06em;text-transform:uppercase}
  /* Withdraw: the rider's own exit on an undecided contribution row. Styled
     as a quiet bordered chip beside the status pill, never a primary action. */
  .withdraw-form{display:inline;margin-left:.4rem}
  .withdraw-btn{background:none;border:1px solid rgba(20,22,14,.3);border-radius:30px;
    padding:.25rem .65rem;min-height:26px;font-family:var(--mono);font-size:.6rem;
    letter-spacing:.08em;text-transform:uppercase;color:#595c4d;cursor:pointer}
  .withdraw-btn:hover{border-color:var(--clay);color:var(--clay)}
  .pager-size{display:flex;align-items:center;gap:.5rem;flex:none}
  .pager-size label{color:#595c4d;letter-spacing:.08em;text-transform:uppercase}
  .pager-size select{font-family:var(--mono);font-size:.66rem;padding:.35rem .5rem;min-height:32px;
                     border:1px solid rgba(20,22,14,.25);border-radius:6px;background:var(--paper);color:var(--ink)}
  /* On a phone the range leads, the steps sit under it full-width, and the
     page-length control keeps its own row rather than being squeezed to a
     sliver beside them. */
  @media(max-width:640px){
    .pager{flex-direction:column;align-items:stretch;gap:.8rem}
    .pager-steps{order:2}
    .pager-steps .pager-step{flex:1;justify-content:center}
    .pager-at{order:1;margin:0}
    .pager-size{order:3;justify-content:space-between}
  }

  /* ONE button system for the account/moderation desks — the site's brand orange
     (--trail), matching .export/.cc-d-act. Primary actions = orange fill; the
     less-prominent / destructive ones (reject, dismiss, retire, needs-info) keep
     the same shape but read as orange-text-on-transparent. No more green/clay mix. */
  .btn-act{font-family:var(--sans);font-weight:700;font-size:.82rem;padding:.6rem 1rem;border-radius:5px;border:1.5px solid var(--trail);background:var(--trail);color:var(--ink);cursor:pointer;transition:background .15s,color .15s,box-shadow .15s;text-decoration:none}
  .btn-act:hover{background:#ff703d;border-color:#ff703d}
  .btn-act:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(255,90,31,.35)}
  .btn-act.btn-secondary,.btn-reject,.btn-dismiss,.btn-needs-info{background:transparent;color:var(--trail)}
  .btn-act.btn-secondary:hover,.btn-reject:hover,.btn-dismiss:hover,.btn-needs-info:hover{background:var(--trail);color:var(--ink)}
  /* A smaller button for a row that carries a text field beside it. */
  .btn-act.btn-sm{font-size:.74rem;padding:.45rem .75rem}
  /* Flash feedback — shared by every shell page (the desks set success/danger
     flashes; without these render styles + the loops in the templates the
     feedback was invisible). Same look as settings' local rules. */
  .flash-success{background:rgba(44,84,64,.12);border-left:3px solid var(--spruce-lift);color:var(--spruce-lift);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}
  .flash-error{background:rgba(179,38,30,.1);border-left:3px solid var(--danger);color:var(--danger-ink);padding:.7rem 1rem;border-radius:0 5px 5px 0;font-size:.9rem;margin-bottom:1.4rem}

