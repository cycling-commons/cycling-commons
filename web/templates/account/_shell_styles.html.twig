{# Shared styles for the account shell (demo banner + dark identity bar + tabs).
   Included in the head_styles of every logged-in account page so they share one
   look: the dashboard, settings, and 2FA setup. #}
<style>
  .demo-banner{background:rgba(200,146,58,.16);border-bottom:1px solid rgba(200,146,58,.55);color:#6b5320;text-align:center;padding:.6rem 1rem;font-size:.82rem;line-height:1.4}
  .demo-banner b{color:var(--clay)}
  .dtop{background:var(--ink);color:var(--paper);display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem clamp(1.25rem,4vw,2rem)}
  .dtop .brandblock{display:flex;flex-direction:column;gap:.28rem;align-items:flex-start;flex:none}
  .dtop .brand img{height:1.8rem;display:block}
  .dtop .brandsub{font-family:var(--mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(239,230,212,.55);line-height:1.6;white-space:nowrap}
  /* the account chip (global styles) sits in the dtop's right slot */
  .dtabs{display:flex;gap:1.6rem;padding:0 clamp(1.25rem,4vw,2rem);background:var(--paper-deep);border-bottom:1px solid rgba(20,22,14,.12);overflow-x:auto}
  .dtabs a{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;padding:1rem .2rem;cursor:pointer;color:#595c4d;border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;text-decoration:none}
  .dtabs a.on{color:var(--ink);border-color:var(--trail)}
  /* moderation is a "work" area — set apart from the personal tabs by a divider
     and a slightly darker background that fills the rest of the bar. */
  .dtabs a.dtab-mod{flex:1;padding-left:1.6rem;background:#D8CBB1;border-left:1px solid rgba(20,22,14,.15)}
</style>
