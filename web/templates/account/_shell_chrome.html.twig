{# Shared account-shell chrome: dark identity bar + section tabs.
   Included by the dashboard (/profile), settings (/settings), 2FA setup, and the
   moderation queue (/moderate) so the logged-in area is one continuous
   environment with the same account chip used in the public nav.
   Param: `active` = contrib | votes | saved | scout | translate | messages | settings | moderate | moderate_routes | moderate_data | moderate_takedowns | moderate_translations | moderate_regions | moderate_room | moderate_rulebook | moderate_reports. Submission history lives under the Submissions tab as Queue/History chips, so it keeps `active: moderate`.
   Param: `mod_scope_names` (moderator-areas spec 2026-07-14) = the curator's
   assigned area names (ModerationScopeProvider::describe()) — [] for global,
   omitted/null for pages that don't pass it. Only rendered in moderator mode.
   Moderator tabs render ONLY inside the moderator section itself (curators
   reach it via the account-chip dropdown) — user pages show user tabs only,
   and on moderator pages the labelled group makes the section unmistakable. #}
{% set active = active|default('contrib') %}
{% set in_moderation = active in ['moderate', 'moderate_routes', 'moderate_regions', 'moderate_data', 'moderate_takedowns', 'moderate_translations', 'moderate_room', 'moderate_rulebook', 'moderate_history', 'moderate_bugs', 'moderate_reports'] %}
<header class="dtop">
  <div class="brandblock">
    <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons"></a>
    <div class="brandsub"><span class="cc-coord">N 41.39° · E 2.16°</span><br>{{ 'account.brandsub'|trans }}</div>
  </div>
  <div class="dtop-right">
    <a class="acct fill" href="{{ path('map') }}">{{ 'nav.explore_map'|trans }}</a>
    {% include 'partials/_lang_menu.html.twig' %}
    {% include 'partials/_account_chip.html.twig' %}
  </div>
</header>
{% if in_moderation and is_granted('ROLE_CURATOR') %}
{# Moderator mode: the bar carries ONLY the moderation tabs, on its own darker
   colour — no user items. Back to the personal area via the account chip. #}
{% set mod_translation_count = pending_translation_count() %}
{% set mod_bug_count = open_bug_count() %}
{% set mod_report_count = open_report_count() %}
{% set mod_room_count = curator_room_unread() %}
<nav class="dtabs dtabs-modmode" aria-label="{{ 'account.menu_moderation'|trans }}">
  <span class="dtabs-modlabel" aria-hidden="true">{{ 'account.menu_moderation'|trans }}{% if mod_scope_names is defined and mod_scope_names is not null %} · {{ mod_scope_names is empty ? 'account.mod_scope_all'|trans : mod_scope_names|join(' · ') }}{% endif %}</span>
  <a href="{{ path('moderate') }}" class="dtab-mod {{ active == 'moderate' ? 'on' : '' }}">{{ 'nav.moderate'|trans }}{% if mod_submission_count is defined and mod_submission_count %}<span class="dtab-count" title="{{ 'account.mod_open_in_area'|trans }}">{{ mod_submission_count }}</span>{% endif %}</a>
  <a href="{{ path('moderate_routes') }}" class="dtab-mod {{ active == 'moderate_routes' ? 'on' : '' }}">{{ 'nav.routes'|trans }}{% if mod_route_count is defined and mod_route_count %}<span class="dtab-count" title="{{ 'account.mod_open_in_area'|trans }}">{{ mod_route_count }}</span>{% endif %}</a>
  {# Data desk, right after Routes (owner 2026-08-25): machine-raised findings about catalog rows. Badged, because
     unlike Regions this one does queue — and it was invisible console output
     before it had a tab. #}
  <a href="{{ path('moderate_data') }}" class="dtab-mod {{ active == 'moderate_data' ? 'on' : '' }}">{{ 'nav.data'|trans }}{% if mod_data_count is defined and mod_data_count %}<span class="dtab-count" title="{{ 'account.mod_open_in_area'|trans }}">{{ mod_data_count }}</span>{% endif %}</a>
  {# Takedowns: their own desk since 2026-08-03. A rights request on a legal
     clock does not belong at the bottom of an editorial backlog. Badge counts
     every open request, unscoped — these are not shared out by jurisdiction. #}
  <a href="{{ path('moderate_takedowns') }}" class="dtab-mod {{ active == 'moderate_takedowns' ? 'on' : '' }}">{{ 'nav.takedowns'|trans }}{% if mod_takedown_count is defined and mod_takedown_count %}<span class="dtab-count" title="{{ 'account.mod_takedowns_open'|trans }}">{{ mod_takedown_count }}</span>{% endif %}</a>
  {# Reports: notice and action under DSA Article 16, for everything that is
     not a photo. Next to takedowns because both run on a legal clock, and
     unscoped for the same reason (content-reports.md §9). #}
  <a href="{{ path('moderate_reports') }}" class="dtab-mod {{ active == 'moderate_reports' ? 'on' : '' }}">{{ 'report.desk.title'|trans }}{% if mod_report_count %}<span class="dtab-count" title="{{ 'report.desk.title'|trans }}">{{ mod_report_count }}</span>{% endif %}</a>
  {# Inbox: GONE from here on 2026-08-28, and its routes answer 404.
     It could show a message but not answer one, so it held half of every
     conversation and a curator could not tell an answered one from an
     unanswered one. Contact messages are still stored AND mailed to the
     support address, so ordinary mail is the whole channel until the desk can
     hold a thread. See App\Controller\ModerateInboxController::ENABLED. #}
  {# Bugs: its own desk, not a queue inside the inbox. A message is finished
     when somebody has an answer; a bug is a fact about the software that
     outlives its reporter (contact-and-support.md §9). #}
  <a href="{{ path('moderate_bugs') }}" class="dtab-mod {{ active == 'moderate_bugs' ? 'on' : '' }}">{{ 'support.bugs.title'|trans }}{% if mod_bug_count %}<span class="dtab-count" title="{{ 'support.bugs.title'|trans }}">{{ mod_bug_count }}</span>{% endif %}</a>
  {# Translations: site-wide overlays, unscoped like takedowns (translations.md §5). #}
  <a href="{{ path('moderate_translations') }}" class="dtab-mod {{ active == 'moderate_translations' ? 'on' : '' }}">{{ 'nav.translations'|trans }}{% if mod_translation_count %}<span class="dtab-count" title="{{ 'account.mod_translations_open'|trans }}">{{ mod_translation_count }}</span>{% endif %}</a>
  {# Regions desk: the gated
     curated-by-default flag. No badge — nothing queues here. #}
  <a href="{{ path('moderate_regions') }}" class="dtab-mod {{ active == 'moderate_regions' ? 'on' : '' }}">{{ 'nav.regions'|trans }}</a>
  {# The curator room: the in-desk board the rulebook's "ask before acting"
     points at (moderation-and-contribution.md §13). Badge counts posts since
     this curator last had the room open, so it reads zero while you are in it. #}
  <a href="{{ path('moderate_room') }}" class="dtab-mod {{ active == 'moderate_room' ? 'on' : '' }}">{{ 'nav.room'|trans }}{% if mod_room_count %}<span class="dtab-count" title="{{ 'account.mod_room_new'|trans }}">{{ mod_room_count }}</span>{% endif %}</a>
  {# The rulebook, moderators-only (it used to be a public wiki page). #}
  <a href="{{ path('moderate_rulebook') }}" class="dtab-mod {{ active == 'moderate_rulebook' ? 'on' : '' }}">{{ 'nav.rulebook'|trans }}</a>
</nav>
{% else %}
<nav class="dtabs" aria-label="{{ 'account.sections'|trans }}">
  <span class="dtabs-modlabel dtabs-personallabel" aria-hidden="true">{{ 'account.menu_personal'|trans }}</span>
  <a href="{{ path('profile') }}" data-pane="contrib" class="{{ active == 'contrib' ? 'on' : '' }}">{{ 'account.tab_contributions'|trans }}</a>
  <a href="{{ path('profile') }}?tab=votes" data-pane="votes" class="{{ active == 'votes' ? 'on' : '' }}">{{ 'account.tab_votes'|trans }}</a>
  {# Saved regions is hidden until it has a backend (owner, 2026-08-26). The
     pane in profile/show.html.twig is commented out with it, and account.js
     already guards every tab on its pane existing, so ?tab=saved is inert
     rather than broken. See "Saved regions" in docs/TODO.md.
  <a href="{{ path('profile') }}?tab=saved" data-pane="saved" class="{{ active == 'saved' ? 'on' : '' }}">{{ 'account.tab_saved'|trans }}</a>
  #}
  {# Scout lives in the personal area because reviewing a ride is a private
     act: the file is read in this browser and nothing about it exists anywhere
     else until the rider approves a tag. #}
  <a href="{{ path('scout_review') }}" class="{{ active == 'scout' ? 'on' : '' }}">{{ 'account.tab_scout'|trans }}</a>
  <a href="{{ path('translate') }}" class="{{ active == 'translate' ? 'on' : '' }}">{{ 'account.tab_translate'|trans }}</a>
  <a href="{{ path('messages') }}" class="{{ active == 'messages' ? 'on' : '' }}">{{ 'account.tab_messages'|trans }}</a>
  {# A rider who reports a bug and never hears anything learns not to bother a
     second time. This is where they find out (contact-and-support.md §10). #}
  <a href="{{ path('my_reports') }}" class="{{ active == 'reports' ? 'on' : '' }}">{{ 'support.mine.title'|trans }}</a>
  <a href="{{ path('settings') }}" class="{{ active == 'settings' ? 'on' : '' }}">{{ 'nav.settings'|trans }}</a>
</nav>
{% endif %}
