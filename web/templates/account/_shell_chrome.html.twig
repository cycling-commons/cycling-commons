{# Shared account-shell chrome: demo banner + dark identity bar + account tabs.
   Included by the dashboard (/profile), settings (/settings) and 2FA setup so
   the logged-in account area is one continuous environment.
   Param: `active` = contrib | votes | saved | settings. Needs `cc_user`. #}
{# Works whether the page passes `cc_user` (dashboard/settings) or not (2FA). #}
{% set _u = cc_user|default(app.user) %}
{% set _words = _u.displayName|trim|split(' ') %}
{% set _initials = (_words|length > 1 ? _words|first|first ~ _words|last|first : _u.displayName|trim|slice(0, 2))|upper %}
{% set active = active|default('contrib') %}
<div class="demo-banner"><b>Demo</b> — {{ 'account.demo_banner'|trans }}</div>
<header class="dtop">
  <div class="brandblock">
    <a class="brand" href="{{ path('home') }}"><img src="{{ asset('brand/logo-nav.svg') }}" alt="Cycling Commons"></a>
    <div class="brandsub"><span class="cc-coord">N 48.87° · E 2.29°</span><br>{{ 'account.brandsub'|trans }}</div>
  </div>
  <div class="who">
    <span class="uname">{{ _u.displayName }}</span>
    <span class="av" aria-hidden="true">{{ _initials }}</span>
    <form method="post" action="{{ path('logout') }}" style="display:inline">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
      <button type="submit" class="out">{{ 'account.sign_out'|trans }}</button>
    </form>
  </div>
</header>
<nav class="dtabs" aria-label="{{ 'account.sections'|trans }}">
  <a href="{{ path('profile') }}" data-pane="contrib" class="{{ active == 'contrib' ? 'on' : '' }}">{{ 'account.tab_contributions'|trans }}</a>
  <a href="{{ path('profile') }}?tab=votes" data-pane="votes" class="{{ active == 'votes' ? 'on' : '' }}">{{ 'account.tab_votes'|trans }}</a>
  <a href="{{ path('profile') }}?tab=saved" data-pane="saved" class="{{ active == 'saved' ? 'on' : '' }}">{{ 'account.tab_saved'|trans }}</a>
  <a href="{{ path('settings') }}" data-pane="settings" class="{{ active == 'settings' ? 'on' : '' }}">{{ 'account.tab_settings'|trans }}</a>
</nav>
