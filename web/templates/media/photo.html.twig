{#
  The landing page for the link embedded in every stored photo
  (docs/specs/photo-uploads.md §5d). Everything here is resolved per request —
  the attribution especially — because this page is the ONE place a rider's
  identity is stated, and changing it has to reach copies of the file that left
  this site long ago.
#}
{% extends 'base.html.twig' %}

{% block head_styles %}
{# No nonce: style-src is 'self' + 'unsafe-inline', so one does nothing here
   except tie the page to a per-request value (docs/specs/page-caching.md §3.2). #}
<style>
  .photo-page{max-width:880px;margin:0 auto}
  .photo-page img{display:block;width:100%;height:auto;border-radius:8px;background:var(--paper-deep)}
  .photo-page figcaption{font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;color:#595c4d;margin-top:.6rem}
  .photo-licence{max-width:880px;margin:1rem auto;font-size:.9rem;line-height:1.6}
  .photo-licence code{font-family:var(--mono);font-size:.78rem;word-break:break-all}
  .photo-links{max-width:880px;margin:1rem auto;font-size:.9rem;display:flex;flex-wrap:wrap;gap:1.2rem}
  .photo-links a{text-decoration:underline}
  /* Takedown (docs/specs/photo-uploads.md §6b) — folded away by default. It is
     the uploader's own page furniture, not a call to action. */
  .photo-takedown{max-width:880px;margin:2rem auto 0;padding-top:1.2rem;border-top:1px solid rgba(20,22,14,.12)}
  .photo-takedown summary{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay);cursor:pointer}
  .photo-takedown p{font-size:.90rem;line-height:1.6;color:#4a4d40;margin:.8rem 0}
  .photo-takedown textarea{width:100%;min-height:5.5rem;font-family:inherit;font-size:.9rem;padding:.6rem;
    border:1px solid rgba(20,22,14,.2);border-radius:5px;background:var(--paper)}
  .photo-note{max-width:880px;margin:1rem auto;padding:1rem 1.2rem;background:var(--paper-deep);
    border-left:2px solid var(--ochre);border-radius:0 8px 8px 0;font-size:.9rem;line-height:1.6}
</style>
{% endblock %}

{% block body %}
<div class="wrap dmin" style="padding-top:2rem;padding-bottom:3rem">
  {% for msg in app.flashes('success') %}<div class="photo-note" role="status">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('error') %}<div class="photo-note" role="alert">{{ msg|trans }}</div>{% endfor %}

  {% if photo is null %}
    <h1>{{ 'media.page.unpublished_title'|trans }}</h1>
    {% if takedown_pending|default(false) %}
      {# Only the uploader ever reaches this branch — see PhotoPageController. #}
      <p>{{ 'media.takedown.pending_body'|trans }}</p>
    {% else %}
      <p>{{ 'media.page.unpublished_body'|trans }}</p>
    {% endif %}
    <p><a href="{{ path('map') }}">{{ 'media.page.to_map'|trans }}</a></p>
  {% else %}
    <figure class="photo-page">
      <img src="{{ photo.sm }}" srcset="{{ photo.sm }} 520w, {{ photo.lg }} 1400w"
           sizes="(max-width: 900px) 100vw, 880px"
           width="{{ photo.width }}" height="{{ photo.height }}"
           {# The uploader's description, then the item this photo belongs to,
              then a generic string. A name read aloud beside a photo is real
              information; "image" is not. #}
           alt="{{ photo.alt ?? photo.item.name ?? 'media.page.alt'|trans }}" />
      <figcaption>
        {# Four attribution states here; the two external ones
           (docs/specs/photo-uploads.md §5d) arrive with the phase-2 write API
           and add a "· via app X" clause plus its own anonymous variant.
           Deliberately NOT stubbed — that would mean four locales of copy for
           wording nobody has agreed yet. `photo.viaApp` is in the context and
           always null. #}
        {% if photo.credit %}
          {% if photo.profileUuid %}
            {{ 'media.page.by'|trans }} <a href="{{ path('rider_profile', {uuid: photo.profileUuid}) }}">{{ photo.credit }}</a>
          {% else %}
            {{ 'media.page.by'|trans }} {{ photo.credit }}
          {% endif %}
        {% else %}
          {{ 'media.page.by_anonymous'|trans }}
        {% endif %}
        {% if photo.takenAt %} &middot; {{ photo.takenAt }}{% endif %}
      </figcaption>
    </figure>

    <p class="photo-licence">
      {{ 'media.page.licensed_under'|trans }}
      <a href="{{ photo.licenseUrl }}" rel="license noopener" target="_blank">{{ photo.license }}</a>
      &middot; {{ 'media.page.reuse_hint'|trans({'%url%': app.request.uri})|rich }}
    </p>

    <p class="photo-links">
      <a href="{{ photo.orig }}" download>{{ 'media.page.download_original'|trans }}</a>
      {% if photo.item %}
        <a href="{{ path('map') }}?feature={{ photo.item.name|url_encode }}">{{ 'media.page.see_place'|trans({'%name%': photo.item.name}) }}</a>
      {% endif %}
    </p>

    {# The third-party route (docs/specs/photo-uploads.md §6c) is for everyone —
       most of the people it protects have no account and are not the uploader. #}
    <p class="photo-links">
      <a href="{{ path('content_report', {type: 'photo', id: photo_uuid}) }}">{{ 'media.report.link'|trans }}</a>
    </p>

    {% if can_request_takedown|default(false) %}
      <details class="photo-takedown">
        <summary>{{ 'media.takedown.summary'|trans }}</summary>
        <p>{{ 'media.takedown.intro'|trans }}</p>
        <p>{{ 'media.takedown.licence_note'|trans }}</p>
        <form method="post" action="{{ path('photo_takedown', {uuid: photo_uuid}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('photo_takedown') }}">
          <label for="takedown_reason">{{ 'media.takedown.label_reason'|trans }}</label>
          <textarea id="takedown_reason" name="reason" maxlength="2000" required
                    placeholder="{{ 'media.takedown.placeholder_reason'|trans }}"></textarea>
          <p><button type="submit" class="btn">{{ 'media.takedown.submit'|trans }}</button></p>
        </form>
      </details>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
