{% extends 'base.html.twig' %}
{% block head_styles %}
<link rel="stylesheet" href="{{ asset('styles/page/contribute/vote.css') }}">
{% endblock %}
{% block body %}
<div class="vhead"><div class="wrap">
  <div class="kicker" style="color:var(--trail)">{{ region ? cc_region_label(region.slug, region.name) ~ (region_country ? ', ' ~ region_country) : 'vote.kicker'|trans }}</div>
  <h1 class="disp">{{ 'vote.title'|trans }}</h1>
  {% if round %}
    <div class="round">{{ 'vote.round'|trans({
      '%round%': 'vote.round_label'|trans({'%season%': round.season.labelKey|trans, '%year%': round.yearLabel}),
      '%date%': round.lastDay|cc_date,
    }) }}</div>
  {% endif %}
  {# In the header, so the tabs stay right under it. A plain GET form:
     choosing a region needs no script. #}
  <form class="vregion" method="get" action="{{ path('vote') }}">
    <input type="hidden" name="cat" value="{{ category.value }}">
    <label for="v-region">{{ 'vote.region_label'|trans }}</label>
    <select id="v-region" name="region">
      <option value="">{{ 'vote.region_none'|trans }}</option>
      {% for country, list in regions %}
        <optgroup label="{{ country }}">
          {% for r in list %}<option value="{{ r.slug }}"{{ region and r.slug == region.slug ? ' selected' }}>{{ cc_region_label(r.slug, r.name) }}</option>{% endfor %}
        </optgroup>
      {% endfor %}
    </select>
    <button type="submit" class="add">{{ 'vote.show'|trans }}</button>
  </form>
</div></div>

<div class="wrap" id="main">
  {# The tabs open the MAIN CONTENT and are not part of the header (owner,
     2026-08-29). They choose what you are voting on, so they belong to the
     thing they change, not to the title above it. Each tab is a link: the
     list is chosen by the server, no script. #}
  <nav class="vtabs" aria-label="{{ 'vote.title'|trans|e('html_attr') }}">
    {% for c in categories %}
      <a class="{{ c == category ? 'on' }}"{{ c == category ? ' aria-current="page"' }}
         href="{{ path('vote', region ? {region: region.slug, cat: c.value} : {cat: c.value}) }}">{{ c.labelKey|trans }}</a>
    {% endfor %}
  </nav>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="status">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('error') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {% if not open %}
    <p class="vnote vclosed">{{ 'vote.closed_body'|trans }}</p>
  {% elseif missing is not empty %}
    <div class="vnote vneeds">
      <h2>{{ 'vote.not_eligible_h'|trans }}</h2>
      <ul>
        {% if 'email' in missing %}<li>{{ 'vote.need_email'|trans }}</li>{% endif %}
        {% if 'age' in missing and votes_from %}<li>{{ 'vote.need_age'|trans({'%date%': votes_from|cc_date, '%days%': min_age_days}) }}</li>{% endif %}
        {% if 'activity' in missing %}<li>{{ 'vote.need_activity'|trans }}</li>{% endif %}
      </ul>
    </div>
  {% endif %}

  {% if region %}
    {% set is_route = category.value == 'quality-rides' %}
    {% set can_vote = open and missing is empty %}
    {% set left = per_list - mine|length %}
    {% set verb = category.value in ['climbs', 'quality-rides'] ? 'vote.confirmed_rode' : (category.value == 'where-to-sleep' ? 'vote.confirmed_stayed' : 'vote.confirmed_been') %}
    <div class="vgrid">
      <div id="cands">
        {% for c in candidates %}
          {% set voted = c.id in mine|keys %}
          <div class="cand{{ pick == c.id ? ' picked' }}" id="c-{{ c.id }}">
            <div class="nm">
              <h4><a href="{{ path('map') }}?{{ is_route ? 'route' : 'item' }}={{ c.id }}">{{ c.name }}</a></h4>
              <div class="m">{{ verb|trans({'%n%': c.confirmations}) }}</div>
            </div>
            {% if can_vote and (voted or left > 0) %}
              <form method="post" action="{{ path('vote') }}">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <input type="hidden" name="region" value="{{ region.slug }}">
                <input type="hidden" name="cat" value="{{ category.value }}">
                <input type="hidden" name="id" value="{{ c.id }}">
                {% if voted %}
                  <button class="add in" name="do" value="remove">{{ 'vote.on_ballot'|trans }}<span class="vh">, {{ 'vote.remove'|trans }} {{ c.name }}</span></button>
                {% else %}
                  {% if is_route %}
                    <label class="vh" for="b-{{ c.id }}">{{ 'vote.bike_label'|trans }}</label>
                    <select id="b-{{ c.id }}" name="bike" required>
                      <option value="">{{ 'vote.bike_ph'|trans }}</option>
                      {% for b in bikes %}<option value="{{ b.value }}">{{ b.labelKey|trans }}</option>{% endfor %}
                    </select>
                  {% endif %}
                  <button class="add" name="do" value="cast">{{ 'vote.add'|trans }}</button>
                {% endif %}
              </form>
            {% elseif voted %}
              <span class="add in mark">{{ 'vote.on_ballot'|trans }}</span>
            {% endif %}
          </div>
        {% else %}
          <div class="bempty">{{ 'vote.empty'|trans }}</div>
        {% endfor %}
      </div>
      <div class="ballot">
        <h3>{{ 'vote.ballot_heading'|trans }} · {{ category.labelKey|trans }}</h3>
        <div id="ballot">
          {% for b in ballot %}
            <div class="bitem">
              <span>{{ b.name }}{% if b.bike %} · {{ b.bike|trans }}{% endif %}</span>
              {% if can_vote %}
                <form method="post" action="{{ path('vote') }}">
                  <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                  <input type="hidden" name="region" value="{{ region.slug }}">
                  <input type="hidden" name="cat" value="{{ category.value }}">
                  <input type="hidden" name="id" value="{{ b.id }}">
                  <button class="x" name="do" value="remove">{{ 'vote.remove'|trans }} ×<span class="vh"> {{ b.name }}</span></button>
                </form>
              {% endif %}
            </div>
          {% else %}
            <div class="bempty">{{ 'vote.empty_ballot'|trans({'%m%': per_list}) }}</div>
          {% endfor %}
        </div>
        <p class="vleft">
          {{ (left <= 0 ? 'vote.left_none' : (left == 1 ? 'vote.left_one' : 'vote.left_many'))|trans({'%count%': left, '%m%': per_list}) }}
          · {{ (voters >= threshold ? 'vote.voters_count' : 'vote.voters_needed')|trans({'%n%': voters, '%m%': threshold}) }}
        </p>
        <div class="vnote">{{ 'vote.threshold_note'|trans({'%m%': threshold}) }} <a href="{{ best_of_path({cat: category.value, cc: region.countryCode}) }}">{{ 'vote.see_results'|trans }}</a></div>
        <div class="vnote">{{ 'vote.privacy_note'|trans }}</div>
      </div>
    </div>
  {% else %}
    <div class="vnote">{{ 'vote.privacy_note'|trans }}</div>
  {% endif %}
</div>
{% endblock %}
