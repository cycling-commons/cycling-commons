{# Password reset email, in the branded shell from emails/_base. Rendered in the
   rider's page language (the request is locale-prefixed and the mail is sent
   in that request); the expiry comes from the token itself, worded by the
   reset bundle's own catalogue. #}
{% extends 'emails/_base.html.twig' %}

{% block title %}{{ 'security.reset_email.subject'|trans }}{% endblock %}

{% block content %}
  {% set resetUrl = url('reset_password', {token: resetToken.token}) %}
  <h1 style="font-size:24px;font-weight:600;margin:0 0 14px">
    {{ 'security.reset_email.heading'|trans }}
  </h1>

  <p style="margin:0 0 8px">{{ 'security.reset_email.body'|trans }}</p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:26px 0;border-collapse:collapse">
    <tr>
      <td align="center" style="background:#e85d26;border-radius:6px">
        <a href="{{ resetUrl }}"
           style="display:inline-block;color:#ffffff;font-weight:700;font-size:16px;padding:14px 28px;text-decoration:none">
          {{ 'security.reset_email.button'|trans }}
        </a>
      </td>
    </tr>
  </table>

  {# The link as text too, for mail clients that drop or block the button
     (the verification email does the same). #}
  <p style="font-size:13px;color:#5a5d4d;line-height:1.5;word-break:break-all;margin:0 0 14px">
    {{ 'security.reset_email.link_fallback'|trans }}<br>
    <a href="{{ resetUrl }}" style="color:#c2551f">{{ resetUrl }}</a>
  </p>

  <p style="font-size:13px;color:#5a5d4d;margin:0">
    {{ 'security.reset_email.expiry'|trans({'%duration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
  </p>
{% endblock %}
