{# Password reset email — branded shell from emails/_base. #}
{% extends 'emails/_base.html.twig' %}

{% block title %}Reset your Cycling Commons password{% endblock %}

{% block content %}
  <h1 style="font-size:24px;font-weight:600;margin:0 0 14px">
    Reset your password
  </h1>

  <p style="margin:0 0 8px">You requested a password reset for your Cycling Commons account. Click the button below to set a new password.</p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:26px 0;border-collapse:collapse">
    <tr>
      <td align="center" style="background:#e85d26;border-radius:6px">
        <a href="{{ url('reset_password', {token: resetToken.token}) }}"
           style="display:inline-block;color:#ffffff;font-weight:700;font-size:16px;padding:14px 28px;text-decoration:none">
          Reset my password
        </a>
      </td>
    </tr>
  </table>

  <p style="font-size:13px;color:#5a5d4d;margin:0">
    This link expires in 1 hour. If you didn't request a password reset, you can safely ignore this email.
  </p>
{% endblock %}
