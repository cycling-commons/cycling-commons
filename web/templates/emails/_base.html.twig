{# Shared transactional-email shell: paper background, ink header band with
   the square brand mark, warm card body. Email-client-safe markup only —
   presentation tables + inline styles, no external CSS, absolute image URL. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Cycling Commons{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#efe6d4">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#efe6d4">
  <tr>
    <td align="center" style="padding:32px 16px">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;border-collapse:collapse">
        <tr>
          <td align="center" style="background:#14160e;border-radius:12px 12px 0 0;padding:30px 24px 26px">
            <img src="{{ absolute_url(asset('brand/logo-square.png')) }}" alt="Cycling Commons"
                 width="104" height="104" style="display:block;width:104px;height:104px;border:0;outline:none">
          </td>
        </tr>
        <tr>
          <td style="background:#fdfaf1;border-radius:0 0 12px 12px;padding:36px 40px 32px;font-family:Helvetica,Arial,sans-serif;color:#14160e;font-size:16px;line-height:1.55">
            {% block content %}{% endblock %}
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:22px 24px 6px;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#8a8d7a">
            {% block footer %}Cycling Commons · open cycling atlas · <a href="https://cyclingcommons.org" style="color:#8a8d7a">cyclingcommons.org</a>{% endblock %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
