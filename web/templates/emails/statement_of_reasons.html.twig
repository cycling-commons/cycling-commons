{#
  DSA Article 17, the statement of reasons, by email. One template for every
  decision that owes one: a rejection, a removal, a hidden photo, a retired
  place, an upheld report, a suspended or removed account.

  Every line arrives translated in the recipient's language
  (App\Moderation\StatementOfReasons::lines()), so nothing here calls |trans:
  this renders outside a request too. The lines are plain text; Twig escapes
  them, the curator's words included.

  Article 17(3), one heading each: what was decided and its scope, why (the
  facts, and whether a report started it), the rule (law or our terms), how it
  was decided (automated or not), and how to contest it.

  @see docs/specs/content-reports.md §7
#}
{% extends 'emails/_base.html.twig' %}

{% block title %}{{ s.headline }}{% endblock %}

{% block content %}
  <h1 style="margin:0 0 14px;font-size:21px;line-height:1.25;font-weight:700;color:#14160e">{{ s.headline }}</h1>

  <p style="margin:0 0 8px">{{ greeting }}</p>
  <p style="margin:0 0 18px;color:#3f4235">{{ intro }}</p>

  <p style="margin:0 0 4px;color:#595c4d;font-size:13px;font-weight:700">{{ labels['what'] }}</p>
  <p style="margin:0 0 14px">{{ s.decision }} {{ s.scope }}</p>

  <p style="margin:0 0 4px;color:#595c4d;font-size:13px;font-weight:700">{{ labels.why }}</p>
  {% if s.facts_system %}<p style="margin:0 0 8px">{{ s.facts_system }}</p>{% endif %}
  {% if s.facts %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 8px">
      <tr>
        <td style="border-left:3px solid #9FC6C0;background:#f4efe2;padding:12px 16px;color:#3f4235;font-size:15px;line-height:1.55">{{ s.facts|nl2br }}</td>
      </tr>
    </table>
  {% endif %}
  <p style="margin:0 0 14px">{{ s.source }}</p>

  <p style="margin:0 0 4px;color:#595c4d;font-size:13px;font-weight:700">{{ labels.rule }}</p>
  <p style="margin:0 0 14px">{{ s.ground }} {{ s.basis }} <a href="{{ terms_url }}" style="color:#c2551f">{{ labels.terms_link }}</a></p>

  <p style="margin:0 0 4px;color:#595c4d;font-size:13px;font-weight:700">{{ labels.how }}</p>
  <p style="margin:0 0 14px">{{ s.automated }}</p>

  <p style="margin:0 0 4px;color:#595c4d;font-size:13px;font-weight:700">{{ labels.contest }}</p>
  <p style="margin:0 0 8px">{{ s.redress }}{% if not can_reply %} <a href="{{ contact_url }}" style="color:#c2551f">{{ labels.contact_link }}</a>{% endif %}</p>
  {% if s.answer and answer_url %}
    <p style="margin:0 0 8px">{{ s.answer }} <a href="{{ answer_url }}" style="color:#c2551f">{{ labels.answer_link }}</a></p>
  {% endif %}

  <p style="margin:18px 0 0;font-size:13px;line-height:1.5;color:#8a8d7a">
    {{ labels.reference }}: <span style="font-family:monospace;font-size:12px">{{ s.reference }}</span>
  </p>

  <p style="color:#595c4d;font-size:13px;margin:14px 0 0">{{ signoff }}</p>
{% endblock %}
