{# Account-deletion confirmation code email — branded shell from emails/_base. #}
{% extends 'emails/_base.html.twig' %}

{% block title %}Your Cycling Commons deletion code{% endblock %}

{% block content %}
  <p style="margin:0 0 8px">Hello {{ user.displayName }},</p>
  <p style="margin:0 0 8px">Your account deletion code is:</p>

  <p style="margin:22px 0;text-align:center">
    <strong style="display:inline-block;font-family:monospace;font-size:22px;letter-spacing:.14em;background:#efe6d4;border-radius:6px;padding:12px 22px">{{ code }}</strong>
  </p>

  <p style="margin:0 0 8px">This code expires in 1 hour. Enter it on the <a href="https://cyclingcommons.org/settings#delete" style="color:#c2551f">settings page</a> to confirm deletion.</p>
  <p style="margin:0 0 14px">If you did not request this, you can safely ignore this email.</p>
  <p style="color:#595c4d;font-size:13px;margin:0">— The Cycling Commons team</p>
{% endblock %}
