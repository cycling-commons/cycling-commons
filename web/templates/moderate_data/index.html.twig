{# The data desk: machine-raised findings, each a record card with a question
   in its title and the answer as the card's buttons. Head, chips, card and
   buttons come from account/_shell_styles.html.twig; only the side-by-side
   pair is this page's own. #}
{% extends 'base.html.twig' %}
{% block head_styles %}
{% include 'account/_shell_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('styles/page/moderate_data/index.css') }}">
{% endblock %}

{% block chrome %}{% include 'account/_shell_chrome.html.twig' with {active: 'moderate_data'} %}{% endblock %}

{% block body %}
<div class="dbody" id="main">
  <div class="mh">
    <div class="kicker">{{ 'moderate_data.kicker'|trans }}</div>
    <h1>{{ 'moderate_data.title'|trans }}</h1>
    <p class="lead">{{ 'moderate_data.lead'|trans }}</p>
  </div>

  {% for msg in app.flashes('success') %}<div class="flash-success" role="alert">{{ msg|trans }}</div>{% endfor %}
  {% for msg in app.flashes('warning') %}<div class="flash-error" role="alert">{{ msg|trans }}</div>{% endfor %}

  {# The kind chips and the country/region filter COMBINE: each chip carries
     the place filter along, and the form carries the kind, so switching one
     never resets the other. The same selects as the submissions queue. #}
  {% set place = {country: filters.country, region: filters.region}|filter(v => v) %}
  <nav class="lfilter" aria-label="{{ 'moderate_data.title'|trans }}">
    <a href="{{ path('moderate_data', place) }}" class="lchip {{ kind is null ? 'on' : '' }}">{{ 'moderate_data.all'|trans }}</a>
    {% for k in kinds %}
      <a href="{{ path('moderate_data', {kind: k.value}|merge(place)) }}" class="lchip {{ kind is not null and kind.value == k.value ? 'on' : '' }}">{{ k.labelKey|trans }}</a>
    {% endfor %}
  </nav>

  <div class="mod-bar">
    <form class="mod-filters" method="get" action="{{ path('moderate_data') }}">
      <label>{{ 'moderate.filter.country'|trans }}
        <select name="country" class="sel-chip" data-autosubmit>
          <option value="">{{ 'moderate.filter.all'|trans }}</option>
          {% for c in countries %}<option value="{{ c }}"{{ filters.country == c ? ' selected' }}>{{ c }}</option>{% endfor %}
        </select>
      </label>
      <label>{{ 'moderate.filter.region'|trans }}
        <select name="region" class="sel-chip" data-autosubmit>
          <option value="">{{ 'moderate.filter.all'|trans }}</option>
          {% for r in regions %}<option value="{{ r }}"{{ filters.region == r ? ' selected' }}>{{ r }}</option>{% endfor %}
        </select>
      </label>
      {% if kind is not null %}<input type="hidden" name="kind" value="{{ kind.value }}">{% endif %}
      <noscript><button type="submit" class="btn-act btn-needs-info">{{ 'moderate.filter.apply'|trans }}</button></noscript>
      <button type="submit" class="btn-act btn-secondary mod-go">{{ 'moderate.filter.apply'|trans }}</button>
    </form>
    {% if findings is not empty %}
      {% include 'account/_density.html.twig' %}
    {% endif %}
  </div>

  {% if findings is empty %}
    <div class="empty-state"><p>{{ 'moderate_data.empty'|trans }}</p></div>
  {% else %}
  <div class="q-list" id="qList">
    {# A finding this curator has not opened carries the unseen bar
       (moderation-and-contribution.md §5.2f). Opening it on the map, or
       answering it here, opens it. #}
    {% set unseen_ids = cc_unseen('catalog_finding', findings|map(f => f.id)) %}
    {% for f in findings %}
      {% set d = f.detail %}
      {% set row_unseen = unseen_ids[f.id] is defined %}
      <div class="q-item {{ row_unseen ? 'is-unseen' }}" data-finding-id="{{ f.id }}"{% if row_unseen %} data-unread-class="is-unseen"{% endif %}>
        <div class="q-top">
          <div class="q-headwrap">
            <div class="q-head">
              <span class="q-tag q-tag--quiet">{{ ('finding.kind.' ~ f.kind)|trans }}</span>
              {# The question, as the title. The buttons below answer it. #}
              <h3 class="q-title">{{ (f.kind == 'duplicate' ? 'moderate_data.q_duplicate' : 'moderate_data.q_osm_link')|trans }}
                {%- if row_unseen %}{% include 'partials/_unseen.html.twig' %}{% endif %}</h3>
            </div>
            <div class="q-submitter">{{ f.letter }} &middot; {{ f.country_code }}</div>
          </div>
        </div>

        {% if f.kind == 'duplicate' %}
          <div class="fd-pair">
            <div class="fd-side">
              <h4>{{ 'moderate_data.keeps'|trans }}</h4>
              <div class="nm">{{ f.rel_name }}</div>
              <div class="meta">#{{ f.rel_id }} &middot; {{ f.rel_source }}</div>
            </div>
            <div class="fd-side loses">
              <h4>{{ 'moderate_data.retires'|trans }}</h4>
              <div class="nm">{{ f.item_name }}</div>
              <div class="meta">#{{ f.item_id }} &middot; {{ f.item_source }}</div>
            </div>
          </div>
          {% if d.blocked is defined and d.blocked %}
            <div class="fd-facts">{{ 'moderate_data.has_edits'|trans }}</div>
          {% endif %}
        {% else %}
          <div class="fd-pair">
            <div class="fd-side">
              <h4>{{ 'moderate_data.our_row'|trans }}</h4>
              <div class="nm">{{ f.item_name }}</div>
              <div class="meta">#{{ f.item_id }} &middot; {{ f.item_source }}</div>
            </div>
            <div class="fd-side">
              <h4>{{ 'moderate_data.osm_object'|trans }}</h4>
              <div class="nm">{{ d.osmName|default(f.osm_ref) }}</div>
              <div class="meta">{{ f.osm_ref }}</div>
            </div>
          </div>
          {# The distance is the whole reason this is a question and not an
             automatic link, so it is stated, not implied. #}
          <div class="fd-facts">{{ 'moderate_data.apart'|trans({'%m%': d.distanceM|default('?')}) }}</div>
        {% endif %}

        {# The buttons answer the question in the heading. "Accept" described
           what the software would do next, which is not an answer to "are
           these the same place?" and left the curator translating. Same
           orange system as every other desk: Yes is the primary, No the
           outline (owner 2026-08-25, was a green of its own). #}
        <form method="post" action="{{ path('moderate_data_decide') }}" class="fd-actions">
          <input type="hidden" name="_token" value="{{ csrf_token('catalog-finding-decide') }}">
          <input type="hidden" name="finding" value="{{ f.id }}">
          <input type="hidden" name="kind" value="{{ kind is not null ? kind.value : '' }}">
          <input type="hidden" name="country" value="{{ filters.country }}">
          <input type="hidden" name="region" value="{{ filters.region }}">
          <input type="text" name="note" maxlength="500" placeholder="{{ 'moderate_data.note_placeholder'|trans }}" aria-label="{{ 'moderate_data.note_placeholder'|trans }}">
          <button type="submit" name="verdict" value="yes" class="btn-act">{{ 'moderate_data.yes'|trans }}</button>
          <button type="submit" name="verdict" value="no" class="btn-act btn-secondary">{{ 'moderate_data.no'|trans }}</button>
        </form>
        {% if f.kind == 'duplicate' %}
          {# Yes/No above answers with the ranked keeper. The map is where the
             curator can see both pins in place and choose a different one, or
             keep both. #}
          <p class="q-map"><a href="{{ path('map') }}?finding={{ f.id }}" data-opens>{{ 'moderate_data.on_map'|trans }}</a>
            <span>{{ 'moderate_data.resolve_hint'|trans }}</span></p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% include 'moderate/_card_script.html.twig' %}
{% endblock %}

{% block body_scripts %}<script src="{{ asset('js/open-to-read.js') }}" defer></script>{% endblock %}
