# Dependencies
node_modules/

# Docker dev stack — local env override + downloaded heavy data (DEM, Valhalla tiles)
developers/docker/.env
developers/docker/data/

# PHP / Symfony web app
web/vendor/
web/var/

# Python pipeline
__pycache__/
*.pyc
.venv/

# Build output
dist/
build/
.astro/
.docusaurus/
.cache/

# MkDocs wiki — local build venv + generated output
.venv-wiki/
wiki-dist/

# Local env (never commit secrets)
.env
!web/.env
.env.local
*.local

# Per-deploy runtime config (Mapillary token etc.) — added manually on the server, never committed
atlas/demo/config.js

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Affinity Designer lock files + Dropbox ignored-file markers
*~lock~*
*com.dropbox.ignored

# Claude session buffer — never commit
.remember/

# Local editor todo scratch
.todo/

# Local browser-test artifacts
.playwright-mcp/
# Catch-all for stray screenshots dropped at the repo root (any raster format) —
# they belong in .playwright-mcp/ or the scratchpad, never here. Legit images
# (brand/og/media) all live in subdirs, so root-only rules don't touch them.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
atlas/demo/media/*.gpx

# Maintainer-only data-prep — couples to a private upstream DB, not shareable.
# The generated output (atlas/demo/regions-data.js) is committed; the generator is not.
tools/regions/

# Catalog import artifacts (generated by `make wallonia-export` / `make divisions-data`) — regenerated on demand, never committed.
tools/wallonia/out/
tools/divisions/out/

# Internal planning notes — kept local, not part of the public repo. Only docs/specs/ ships.
docs/*.md
docs/plans/
docs/superpowers/

# Dated working specs — consolidated into the canonical set, then kept local for
# reference. Only the date-less canonical specs ship (docs/specs/README.md).
docs/specs/Dated/

# Agent scratch (worktrees, SDD ledger) — local only, never committed.
.claude/
.superpowers/

# Understand-Anything knowledge graph — generated analysis artifacts, regenerated
# on demand (auto-update on commit); never committed.
.understand-anything/

# Lavish review artifacts (lavish-axi) — generated HTML review surfaces, local only.
.lavish/

# Local dev-DB backups (pg_dump snapshots) — never committed, machine-local safety net.
developers/docker/backups/
