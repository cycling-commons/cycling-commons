# Dependencies
node_modules/

# Docker dev stack — local env override + downloaded heavy data (DEM, Valhalla tiles)
developers/docker/.env
developers/docker/data/

# PHP / Symfony web app
web/vendor/
web/var/

# Python pipeline
__pycache__/
*.pyc
.venv/

# Build output
dist/
build/
.astro/
.docusaurus/
.cache/

# MkDocs wiki — local build venv + generated output
.venv-wiki/
wiki-dist/

# Local env (never commit secrets)
.env
!web/.env
.env.local
*.local

web/bin/.phpunit.result.cache
web/.phpunit.cache/

# Per-deploy runtime config (Mapillary token etc.) — added manually on the server, never committed
atlas/demo/config.js

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Affinity Designer lock files + Dropbox ignored-file markers
*~lock~*
*com.dropbox.ignored

# Claude session buffer — never commit
.remember/

# Local editor todo scratch
.todo/

# Local browser-test artifacts
.playwright-mcp/
# Catch-all for stray screenshots dropped at the repo root (any raster format) —
# they belong in .playwright-mcp/ or the scratchpad, never here. Legit images
# (brand/og/media) all live in subdirs, so root-only rules don't touch them.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
atlas/demo/media/*.gpx

# Maintainer-only data-prep — couples to a private upstream DB, not shareable.
# The generated output (atlas/demo/regions-data.js) is committed; the generator is not.
tools/regions/

# Catalog import artifacts (generated by `make wallonia-export` / `make divisions-data`) — regenerated on demand, never committed.
tools/wallonia/out/
tools/divisions/out/

# Internal planning notes — kept local, not part of the public repo. Only docs/specs/ ships.
docs/*.md
docs/plans/
docs/superpowers/

# Dated working specs — consolidated into the canonical set, then kept local for
# reference. Only the date-less canonical specs ship (docs/specs/README.md).
docs/specs/Dated/

# The operations spec — local only (owner, 2026-09-20). It is the one spec that
# is mostly about the hosts rather than the software: the production topology,
# which tenant shares the database, how deploys reach each frontend, the timer
# schedule, the log windows. None of that is a secret on its own and none of it
# carries a hostname or a credential, but together it is a shape, and it is of
# no use to somebody reading the code. What a reader is owed about retention and
# personal data is in `/privacy` and in privacy-notice.md, both of which ship.
# Revisit when there is a separate infrastructure repository to hold it.
docs/specs/operations.md

# Agent scratch (worktrees, SDD ledger) — local only, never committed.
.claude/
.superpowers/
.worktrees/

# Understand-Anything knowledge graph — generated analysis artifacts, regenerated
# on demand (auto-update on commit); never committed.
.understand-anything/

# Lavish review artifacts (lavish-axi) — generated HTML review surfaces, local only.
.lavish/

# Kilo local config, agents, skills, review artifacts
.kilocode/

# Local dev-DB backups (pg_dump snapshots) — never committed, machine-local safety net.
developers/docker/backups/

# Elevation rasters staged by tools/elevation (GLO-30 GeoTIFF + generated .hgt).
# Tens of GB, re-downloadable from the AWS Open Data bucket — never committed.
data/dem/
# Valhalla tile + elevation trees. developers/docker/data/ (line 6) already
# covers where the dev stack actually mounts them; this catches a repo-root
# ./data/valhalla, which is what you get by pointing dem-install.sh's
# VALHALLA_DATA at ./data — a plausible mistake worth ~300 MB of binary per
# small country, and the reason a checked-in .hgt is a near miss rather than
# an unimaginable one.
data/valhalla/
