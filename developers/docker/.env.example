# Cycling Commons — dev stack config.
# Copy to `.env` (which is gitignored) and adjust as needed:
#   cp developers/docker/.env.example developers/docker/.env

# ---- host ports ----
ATLAS_PORT=8099
WIKI_PORT=8013
API_PORT=8001
PIPELINE_PORT=8012
VALHALLA_PORT=8003
# Bundled Mailpit web inbox. Change this if you already run a Mailpit on 8025
# (e.g. a shared dev instance) so the two don't collide.
MAILPIT_UI_PORT=8025
# Host-side ports only (the container always serves on 9000/9001 internally).
# Off MinIO's defaults (9000/9001) to avoid clashing with another MinIO/S3 mock.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ---- Postgres / PostGIS ----
POSTGRES_DB=cyclingcommons
POSTGRES_USER=cc
POSTGRES_PASSWORD=cc
# Host-side port only (the container always listens on 5432, and the app
# services reach it as `db:5432`). Defaults to 5433 to avoid clashing with a
# PostgreSQL you may already run locally on 5432.
POSTGRES_PORT=5433

# ---- Symfony API ----
APP_SECRET=dev-not-secret-change-me

# ---- downloaded heavy data (opt-in profiles; kept out of git) ----
# DEM directory mounted into the pipeline at /data/dem.
DEM_DIR=./data/dem
# Prebuilt Valhalla tiles (profile: routing) mounted at /custom_files.
VALHALLA_TILES=./data/valhalla

# ---- MinIO (profile: storage) ----
MINIO_ROOT_USER=ccadmin
MINIO_ROOT_PASSWORD=ccadminsecret

# ---- Coverage pipeline (docs/specs/coverage-provider.md) ----
# Geofabrik regions the weekly coverage batch processes (comma-separated).
COVERAGE_REGIONS=europe/belgium
# Optional: skip the Geofabrik download and read a local PBF instead
# (dev/fixture runs). Path as seen inside the pipeline container.
#COVERAGE_PBF_PATH=/data/work/belgium-latest.osm.pbf
# S3 target for the PMTiles artifact — defaults hit the bundled MinIO
# (profile: storage; create the cc-maps bucket via the console on :9101).
COVERAGE_S3_ENDPOINT=http://minio:9000
COVERAGE_S3_BUCKET=cc-maps
COVERAGE_S3_KEY=ccadmin
COVERAGE_S3_SECRET=ccadminsecret
# Public base URL browsers read tiles from (host-side MinIO port).
COVERAGE_PUBLIC_BASE_URL=http://localhost:9100/cc-maps

# ---- coverage tiles (Symfony flag; needs the storage profile's MinIO) ----
# Flip COVERAGE_TILES to 1 once `make coverage-refresh` has published an
# artifact. The manifest is fetched by the app CONTAINER (minio:9000); the
# CSP host is what the BROWSER range-reads (localhost:${MINIO_PORT}).
COVERAGE_TILES=0
COVERAGE_MANIFEST_URL=http://minio:9000/cc-maps/coverage/manifest.json
COVERAGE_CSP_HOST=http://localhost:9100
