# Cycling Commons — dev stack config.
# Copy to `.env` (which is gitignored) and adjust as needed:
#   cp developers/docker/.env.example developers/docker/.env

# ---- host ports ----
# Which host address the published ports listen on. Loopback by default, so the
# dev stack is reachable from THIS machine only. It used to bind 0.0.0.0, which
# handed the whole network a PostgreSQL with a two-letter password, a MinIO with
# its console, and an unauthenticated pipeline API (security scan 2026-08-25).
# Set BIND_ADDR=0.0.0.0 only if you deliberately want a phone or a colleague on
# the same network to reach the stack, and change the passwords below first.
BIND_ADDR=127.0.0.1
ATLAS_PORT=8099
WIKI_PORT=8013
API_PORT=8001
PIPELINE_PORT=8012
VALHALLA_PORT=8003
# Bundled Mailpit web inbox. Change this if you already run a Mailpit on 8025
# (e.g. a shared dev instance) so the two don't collide.
MAILPIT_UI_PORT=8025
# Host-side ports only (the container always serves on 9000/9001 internally).
# Off MinIO's defaults (9000/9001) to avoid clashing with another MinIO/S3 mock.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
# The nginx fronts that mirror how staging serves media and tiles.
MEDIA_PROXY_PORT=9102
TILES_PROXY_PORT=9103

# ---- Postgres / PostGIS ----
POSTGRES_DB=cyclingcommons
POSTGRES_USER=cc
# Dev-only value, and only ever reachable over loopback (see BIND_ADDR).
# compose.yaml now REFUSES to start without it rather than falling back to a
# built-in default, so a stack running with a guessable password is a choice
# somebody made in this file, never an accident.
POSTGRES_PASSWORD=cc
# Host-side port only (the container always listens on 5432, and the app
# services reach it as `db:5432`). Defaults to 5433 to avoid clashing with a
# PostgreSQL you may already run locally on 5432.
POSTGRES_PORT=5433

# ---- Symfony API ----
APP_SECRET=dev-not-secret-change-me

# At-rest encryption key for TOTP secrets (account-and-auth.md §4). Optional:
# unset, it falls back to APP_SECRET, which is what every deployment did before
# 2026-08-25. Set it to the CURRENT value of APP_SECRET and only then is
# APP_SECRET free to rotate: they used to be the same value with no way to
# separate them, so rotating APP_SECRET silently made every stored TOTP secret
# undecryptable and locked every curator out of 2FA with nothing in the logs.
# `app:security:encryption-audit` is the before-and-after check.
ENCRYPTION_SECRET=

# ---- downloaded heavy data (opt-in profiles; kept out of git) ----
# DEM directory mounted into the pipeline at /data/dem.
DEM_DIR=./data/dem
# Prebuilt Valhalla tiles (profile: routing) mounted at /custom_files.
VALHALLA_TILES=./data/valhalla

# ---- MinIO (profile: storage) ----
MINIO_ROOT_USER=ccadmin
MINIO_ROOT_PASSWORD=ccadminsecret

# ---- Coverage pipeline (docs/specs/coverage-provider.md) ----
# Geofabrik regions the weekly coverage batch processes (comma-separated).
#
# LEAVE THIS UNSET. compose.yaml already defaults it to every onboarded region,
# so an unset value stays correct as countries are added; a value here is a
# second copy of that list which goes stale silently. It has bitten twice: on
# 2026-08-06 a local .env pinned to `europe/belgium` turned a 13-region harvest
# into a one-region one with no warning, and this file itself still named three
# regions when thirteen were onboarded.
#
# To narrow a run, do it explicitly on the command line instead, where it is
# visible in what you typed:
#     make coverage-refresh regions=europe/belgium
#     make coverage-refresh regions=dev/fixture pbf=tests/fixtures/mini.osm.pbf
# COVERAGE_REGIONS=
# Optional: skip the Geofabrik download and read a local PBF instead
# (dev/fixture runs). Path as seen inside the pipeline container.
#COVERAGE_PBF_PATH=/data/work/belgium-latest.osm.pbf
# S3 target for the PMTiles artifact — defaults hit the bundled MinIO
# (profile: storage; create the cc-maps bucket via the console on :9101).
COVERAGE_S3_ENDPOINT=http://minio:9000
COVERAGE_S3_BUCKET=cc-maps
COVERAGE_S3_KEY=ccadmin
COVERAGE_S3_SECRET=ccadminsecret
# Public base URL browsers read tiles from (host-side MinIO port).
COVERAGE_PUBLIC_BASE_URL=http://localhost:9100/cc-maps

# ---- coverage tiles (Symfony flag; needs the storage profile's MinIO) ----
# Flip COVERAGE_TILES to 1 once `make coverage-refresh` has published an
# artifact. The manifest is fetched by the app CONTAINER (minio:9000); the
# CSP host is what the BROWSER range-reads (localhost:${MINIO_PORT}).
COVERAGE_TILES=1
COVERAGE_MANIFEST_URL=http://minio:9000/cc-maps/coverage/manifest.json
COVERAGE_CSP_HOST=http://localhost:9100
